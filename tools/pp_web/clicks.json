{
  "thermo8": {
    "name": "Thermo 8 Click",
    "vendor": "MikroElektronika",
    "chip": "MCP9808",
    "bus": "I2C 0x18",
    "description": "Digital temperature sensor, +/-0.25 C typical; ALERT on the INT pin",
    "color": "#c62828",
    "controls": [
      {"id": "temperature", "label": "Temperature", "property": "temperature",
       "unit": "°C", "min": -40, "max": 125, "step": 0.25, "scale": 1000,
       "default": 25}
    ],
    "signals": [
      {"id": "ALERT", "pin": "int", "active_low": true}
    ]
  }
}
