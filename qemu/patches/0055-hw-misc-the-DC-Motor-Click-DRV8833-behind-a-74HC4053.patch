diff --git a/include/hw/misc/click_dcmotor.h b/include/hw/misc/click_dcmotor.h
new file mode 100644
index 0000000..ee6bebf
--- /dev/null
+++ b/include/hw/misc/click_dcmotor.h
@@ -0,0 +1,28 @@
+/*
+ * DC Motor Click: DRV8833 H-bridge behind a 74HC4053, with a motor on it
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * GPIO inputs "pwm", "sel1", "sel2" and "nsleep" (the socket's PWM, RST,
+ * CS and AN pins); GPIO output "nfault" (open drain: 0 while driven low,
+ * -1 while released). QOM properties: "rpm" (signed, read-only), "drive"
+ * (signed per mille, read-only), "state" (sleep, coast, brake, forward
+ * or reverse), "angle" (the shaft, degrees, for front ends), "max-rpm"
+ * (default 3000), "tau-ms" (150, the driven time constant) and "fault"
+ * (set: nFAULT low, the bridge off).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_CLICK_DCMOTOR_H
+#define HW_MISC_CLICK_DCMOTOR_H
+
+#define TYPE_CLICK_DCMOTOR "click-dcmotor"
+#define CLICK_DCMOTOR_PWM "pwm"
+#define CLICK_DCMOTOR_SEL1 "sel1"
+#define CLICK_DCMOTOR_SEL2 "sel2"
+#define CLICK_DCMOTOR_NSLEEP "nsleep"
+#define CLICK_DCMOTOR_NFAULT "nfault"
+
+#endif /* HW_MISC_CLICK_DCMOTOR_H */
diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index 77f3624..ad3af0d 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -1236,6 +1236,62 @@ static void test_fan(void)
     qtest_quit(qts);
 }
 
+/*
+ * DC Motor Click on EXT1: PWM PB10, SELECT1 on RST (PA20), SELECT2 on CS
+ * (PA17), nSLEEP on AN (PB08, R3 pull-up), nFAULT on INT (PB02)
+ */
+static char *dcm_state(QTestState *qts)
+{
+    return qom_str(qts, CLICK1, "state");
+}
+
+static void test_dcmotor(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=dcmotor ");
+    g_autofree char *st0 = NULL, *st1 = NULL, *st2 = NULL, *st3 = NULL;
+    g_autofree char *st4 = NULL;
+
+    qtest_clock_step(qts, 20 * SCALE_MS);
+    st0 = dcm_state(qts);
+    g_assert_cmpstr(st0, ==, "coast");          /* awake, PWM low */
+    g_assert_true(pin_high(qts, PB, INT1_PIN));
+
+    /* PWM steady high, SEL1 = SEL2 = 0: forward, full speed */
+    qtest_writel(qts, PA + P_DIRSET, BIT(17) | BIT(20));
+    qtest_writel(qts, PA + P_OUTCLR, BIT(17) | BIT(20));
+    qtest_writel(qts, PB + P_DIRSET, BIT(10));
+    qtest_writel(qts, PB + P_OUTSET, BIT(10));
+    qtest_clock_step(qts, 2 * NANOSECONDS_PER_SECOND);
+    st1 = dcm_state(qts);
+    g_assert_cmpstr(st1, ==, "forward");
+    g_assert_cmpint(qom_int(qts, CLICK1, "rpm"), >, 2950);
+
+    /* SEL1 = SEL2 = 1, PWM high: slow decay at 100 %, a brake */
+    qtest_writel(qts, PA + P_OUTSET, BIT(17) | BIT(20));
+    qtest_clock_step(qts, 600 * SCALE_MS);
+    st2 = dcm_state(qts);
+    g_assert_cmpstr(st2, ==, "brake");
+    g_assert_cmpint(qom_int(qts, CLICK1, "rpm"), ==, 0);
+
+    /* SEL1 = 0, SEL2 = 1: reverse, fast decay, 75 % at 5 kHz */
+    qtest_writel(qts, PA + P_OUTCLR, BIT(20));
