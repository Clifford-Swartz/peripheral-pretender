@@ -226,6 +226,17 @@ headers, so one UART Click at a time; it then takes SERCOM3's place in
   other radio are properties: ``join-accept``, ``downlink`` (text, sent
   once on port 1), ``peer-send`` (text), ``air`` (what went over the air).
 
+``dcmotor``
+  DC Motor Click (v101, ``click-dcmotor``): a 74HC4053 routes PWM and
+  SELECT1 (RST) to one of the DRV8833's bridges by SELECT2 (CS); both
+  drive the motor. SEL1/SEL2 0/0 forward and 0/1 reverse with fast decay
+  (drive = duty), 1/1 forward and 1/0 reverse with slow decay (drive = 1 -
+  duty, 100 % brakes). nSLEEP on AN (R3 47k pull-up), nFAULT on INT (R4
+  2k2, the FAULT LED) while ``fault`` is set. The duty is timed on the
+  virtual clock; the motor follows drive times ``max-rpm`` (3000) with a
+  ``tau-ms`` (150) lag, 50 ms braking, 1 s coasting. ``rpm``, ``drive``,
+  ``state`` and ``angle`` read it. EXT2's AN is PA08, EXT1's PB08.
+
 ``oledw``
   OLED W Click (v100): an SSD1306 (``ssd1306``) with a 96x39 white OLED
   (MI9639BO-W) on SPI (jumpers J1-J3 on SPI), CS# on CS, D/C# on PWM, RES#
diff --git a/hw/misc/click_dcmotor.c b/hw/misc/click_dcmotor.c
new file mode 100644
index 0000000..a171c5b
--- /dev/null
+++ b/hw/misc/click_dcmotor.c
@@ -0,0 +1,362 @@
+/*
+ * DC Motor Click: DRV8833 H-bridge behind a 74HC4053, with a motor on it
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * DC Motor Click (MikroElektronika, schematic v101): a 74HC4053 routes
+ * the PWM pin and SELECT1 (RST) to bridge A (AIN1, AIN2) while SELECT2
+ * (CS) is low, to bridge B (BIN2, BIN1) while it is high; the two
+ * bridges' outputs are tied together onto the motor terminals, and the
+ * unselected bridge's inputs fall to the DRV8833's pull-downs (coast).
+ * With the DRV8833 truth table (TI SLVSAR1), PWM duty d:
+ *
+ *   SEL1 SEL2   OUT1/OUT2        drive
+ *    0    0     forward, fast    +d       (off time: coast)
+ *    0    1     reverse, fast    -d
+ *    1    1     forward, slow    +(1 - d) (off time: brake)
+ *    1    0     reverse, slow    -(1 - d)
+ *
+ * nSLEEP (AN, R3 47k pull-up) low puts the bridges to sleep (coast);
+ * they drive again 1 ms after it rises. nFAULT (INT, R4 2k2 pull-up, the
+ * FAULT LED) goes low while "fault" is set, the bridge off meanwhile;
+ * overcurrent, thermal and undervoltage protection are not modelled.
+ *
+ * The PWM duty is timed on the virtual clock as the Buzz Click's: the
+ * last full period's high time; a constant level (no edge for two
+ * periods plus 1 ms) is 0 or 100 %. Every 10 ms the motor's speed moves
+ * toward drive times max-rpm with a time constant of tau-ms while
+ * driven, 50 ms while braking (drive 0 in slow decay) and 1 s while
+ * coasting. No physical Click or motor checked it.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/visitor.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "system/reset.h"
+#include "hw/misc/click_dcmotor.h"
+#include "migration/vmstate.h"
+#include <math.h>
+
+#define TICK_NS             (10 * SCALE_MS)
+#define WAKE_NS             SCALE_MS
+#define TAU_BRAKE_MS        50
+#define TAU_COAST_MS        1000
+
+typedef enum {
+    MOTOR_SLEEP,
+    MOTOR_COAST,
+    MOTOR_BRAKE,
+    MOTOR_FORWARD,
+    MOTOR_REVERSE,
+} MotorState;
+
+static const char *const state_names[] = {
+    "sleep", "coast", "brake", "forward", "reverse",
+};
+
+OBJECT_DECLARE_SIMPLE_TYPE(ClickDcmotorState, CLICK_DCMOTOR)
+
+struct ClickDcmotorState {
+    DeviceState parent_obj;
+
+    /* Pins */
+    bool pwm, sel1, sel2, nsleep;
+    int64_t wake_ns;            /* nSLEEP rose */
+
+    /* PWM timing, as the Buzz Click */
+    int64_t rise_ns;
+    int64_t edge_ns;
+    int64_t period_ns;
+    int64_t high_ns;
+    int64_t pending_high_ns;
+
+    /* The motor */
+    uint32_t max_rpm;
+    uint32_t tau_ms;
+    bool fault;
+    int32_t drive;              /* per mille, signed */
+    uint8_t state;
+    int64_t rpm_milli;          /* signed */
+    int64_t angle_milli;        /* millidegrees, 0..360000 */
+    int64_t last_ns;
+
+    QEMUTimer *tick;
+    qemu_irq nfault;
+};
+
+/* Per mille high: the last period, or the constant level */
+static int32_t pwm_duty(ClickDcmotorState *s, int64_t now)
+{
+    if (s->period_ns > 0 && now - s->edge_ns <= 2 * s->period_ns + SCALE_MS) {
+        return MIN(1000, (s->high_ns * 1000 + s->period_ns / 2) /
+                         s->period_ns);
+    }
+    return s->pwm ? 1000 : 0;
+}
+
+static void evaluate(ClickDcmotorState *s, int64_t now)
+{
+    int32_t d = pwm_duty(s, now);
+    bool slow = s->sel1;                /* the table above */
+    bool fwd = s->sel1 == s->sel2;
+
+    if (!s->nsleep) {
+        s->drive = 0;
+        s->state = MOTOR_SLEEP;
+        return;
+    }
+    if (now - s->wake_ns < WAKE_NS || s->fault) {
+        s->drive = 0;
+        s->state = MOTOR_COAST;         /* waking, or the bridge off */
+        return;
+    }
+    if (slow) {
+        d = 1000 - d;                   /* PWM low drives, high brakes */
+    }
+    s->drive = fwd ? d : -d;
+    if (d == 0) {
+        s->state = slow ? MOTOR_BRAKE : MOTOR_COAST;
+    } else {
+        s->state = fwd ? MOTOR_FORWARD : MOTOR_REVERSE;
+    }
+}
+
+static void advance(ClickDcmotorState *s, int64_t now)
+{
+    double dt = (now - s->last_ns) / 1e6;       /* ms */
+    double tgt = (double)s->drive * s->max_rpm / 1000;
+    double rpm = s->rpm_milli / 1000.0;
+    double tau = s->state == MOTOR_BRAKE ? TAU_BRAKE_MS :
+                 s->drive == 0 ? TAU_COAST_MS : MAX(s->tau_ms, 1);
+    double next;
+
+    if (dt <= 0) {
+        return;
+    }
+    next = tgt + (rpm - tgt) * exp(-dt / tau);
+    s->angle_milli += llround((rpm + next) / 2 * 6.0 * dt);  /* deg/ms */
+    s->angle_milli %= 360000;
+    if (s->angle_milli < 0) {
+        s->angle_milli += 360000;
+    }
+    s->rpm_milli = llround(next * 1000);
+    if (llabs(s->rpm_milli) < 500 && s->drive == 0) {
+        s->rpm_milli = 0;
+    }
+    s->last_ns = now;
+}
+
+static void dcm_tick(void *opaque)
+{
+    ClickDcmotorState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    advance(s, now);
+    evaluate(s, now);
+    qemu_set_irq(s->nfault, s->fault ? 0 : -1);
+    timer_mod(s->tick, now + TICK_NS);
+}
+
+static void dcm_set_pwm(void *opaque, int n, int level)
+{
+    ClickDcmotorState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    bool high = level > 0;
+    int64_t last = s->edge_ns;
+
+    if (high == s->pwm) {
+        return;
+    }
+    s->pwm = high;
+    s->edge_ns = now;
+    if (high) {
+        if (s->rise_ns >= 0 && (!s->period_ns ||
+                                now - last <= 2 * s->period_ns + SCALE_MS)) {
+            s->period_ns = now - s->rise_ns;
+            s->high_ns = s->pending_high_ns;
+        } else {
+            s->period_ns = 0;
+        }
+        s->rise_ns = now;
+    } else if (s->rise_ns >= 0) {
+        s->pending_high_ns = now - s->rise_ns;
+    }
+}
+
+static void dcm_set_sel1(void *opaque, int n, int level)
+{
+    CLICK_DCMOTOR(opaque)->sel1 = level > 0;
+}
+
+static void dcm_set_sel2(void *opaque, int n, int level)
+{
+    CLICK_DCMOTOR(opaque)->sel2 = level > 0;
+}
+
+static void dcm_set_nsleep(void *opaque, int n, int level)
+{
+    ClickDcmotorState *s = opaque;
+    bool high = level > 0;
+
+    if (high && !s->nsleep) {
+        s->wake_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    }
+    s->nsleep = high;
+}
+
+static void dcm_get_rpm(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    int32_t rpm = CLICK_DCMOTOR(obj)->rpm_milli / 1000;
+
+    visit_type_int32(v, name, &rpm, errp);
+}
+
+static void dcm_get_drive(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, &CLICK_DCMOTOR(obj)->drive, errp);
+}
+
+static void dcm_get_angle(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    uint32_t deg = CLICK_DCMOTOR(obj)->angle_milli / 1000;
+
+    visit_type_uint32(v, name, &deg, errp);
+}
+
+static char *dcm_get_state(Object *obj, Error **errp)
+{
+    return g_strdup(state_names[CLICK_DCMOTOR(obj)->state]);
+}
+
+static bool dcm_get_fault(Object *obj, Error **errp)
+{
+    return CLICK_DCMOTOR(obj)->fault;
+}
+
+static void dcm_set_fault(Object *obj, bool value, Error **errp)
+{
+    ClickDcmotorState *s = CLICK_DCMOTOR(obj);
+
+    s->fault = value;
+    qemu_set_irq(s->nfault, value ? 0 : -1);
+}
+
+static void dcm_reset(void *opaque)
+{
+    ClickDcmotorState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    s->rise_ns = -1;
+    s->edge_ns = 0;
+    s->period_ns = 0;
+    s->high_ns = 0;
+    s->pending_high_ns = 0;
+    s->rpm_milli = 0;
+    s->drive = 0;
+    s->state = MOTOR_SLEEP;
+    s->last_ns = now;
+    s->fault = false;
+    qemu_set_irq(s->nfault, -1);
+    timer_mod(s->tick, now + TICK_NS);
+}
+
+static void dcm_realize(DeviceState *dev, Error **errp)
+{
+    /* Not on a bus: no device reset of its own */
+    qemu_register_reset(dcm_reset, dev);
+    dcm_reset(dev);
+}
+
+static void dcm_init(Object *obj)
+{
+    ClickDcmotorState *s = CLICK_DCMOTOR(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    s->tick = timer_new_ns(QEMU_CLOCK_VIRTUAL, dcm_tick, s);
+    qdev_init_gpio_in_named(dev, dcm_set_pwm, CLICK_DCMOTOR_PWM, 1);
+    qdev_init_gpio_in_named(dev, dcm_set_sel1, CLICK_DCMOTOR_SEL1, 1);
+    qdev_init_gpio_in_named(dev, dcm_set_sel2, CLICK_DCMOTOR_SEL2, 1);
+    qdev_init_gpio_in_named(dev, dcm_set_nsleep, CLICK_DCMOTOR_NSLEEP, 1);
+    qdev_init_gpio_out_named(dev, &s->nfault, CLICK_DCMOTOR_NFAULT, 1);
+    s->max_rpm = 3000;
+    s->tau_ms = 150;
+    s->nsleep = true;                   /* R3 pulls it up */
+    object_property_add_uint32_ptr(obj, "max-rpm", &s->max_rpm,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "tau-ms", &s->tau_ms,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add(obj, "rpm", "int32", dcm_get_rpm, NULL, NULL, NULL);
+    object_property_add(obj, "drive", "int32", dcm_get_drive, NULL, NULL,
+                        NULL);
+    object_property_add(obj, "angle", "uint32", dcm_get_angle, NULL, NULL,
+                        NULL);
+    object_property_add_str(obj, "state", dcm_get_state, NULL);
+    object_property_add_bool(obj, "fault", dcm_get_fault, dcm_set_fault);
+}
+
+static void dcm_unrealize(DeviceState *dev)
+{
+    qemu_unregister_reset(dcm_reset, dev);
+}
+
+static void dcm_finalize(Object *obj)
+{
+    timer_free(CLICK_DCMOTOR(obj)->tick);
+}
+
+static const VMStateDescription vmstate_dcm = {
+    .name = TYPE_CLICK_DCMOTOR,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(pwm, ClickDcmotorState),
+        VMSTATE_BOOL(sel1, ClickDcmotorState),
+        VMSTATE_BOOL(sel2, ClickDcmotorState),
+        VMSTATE_BOOL(nsleep, ClickDcmotorState),
+        VMSTATE_INT64(wake_ns, ClickDcmotorState),
+        VMSTATE_INT64(rise_ns, ClickDcmotorState),
+        VMSTATE_INT64(edge_ns, ClickDcmotorState),
+        VMSTATE_INT64(period_ns, ClickDcmotorState),
+        VMSTATE_INT64(high_ns, ClickDcmotorState),
+        VMSTATE_INT64(pending_high_ns, ClickDcmotorState),
+        VMSTATE_BOOL(fault, ClickDcmotorState),
+        VMSTATE_INT32(drive, ClickDcmotorState),
+        VMSTATE_UINT8(state, ClickDcmotorState),
+        VMSTATE_INT64(rpm_milli, ClickDcmotorState),
+        VMSTATE_INT64(angle_milli, ClickDcmotorState),
+        VMSTATE_INT64(last_ns, ClickDcmotorState),
+        VMSTATE_TIMER_PTR(tick, ClickDcmotorState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void dcm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "DC Motor Click (DRV8833, 74HC4053) with a motor";
+    dc->vmsd = &vmstate_dcm;
+    dc->realize = dcm_realize;
+    dc->unrealize = dcm_unrealize;
+}
+
+static const TypeInfo dcm_types[] = {
+    {
+        .name = TYPE_CLICK_DCMOTOR,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(ClickDcmotorState),
+        .instance_init = dcm_init,
+        .instance_finalize = dcm_finalize,
+        .class_init = dcm_class_init,
+    },
+};
+
+DEFINE_TYPES(dcm_types)
