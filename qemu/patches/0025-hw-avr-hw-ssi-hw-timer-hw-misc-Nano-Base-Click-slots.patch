diff --git a/include/hw/misc/mikrobus.h b/include/hw/misc/mikrobus.h
new file mode 100644
index 0000000..1abf89a
--- /dev/null
+++ b/include/hw/misc/mikrobus.h
@@ -0,0 +1,48 @@
+/*
+ * mikroBUS sockets and the Click boards that plug into them
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A board describes each socket (MikrobusSocket): the MCU pads behind its
+ * RST, PWM, INT and CS pins (inputs that external drivers set, outputs that
+ * show the pad levels) and its I2C and SPI buses. mikrobus_plug() creates
+ * the Click named by a machine option on it, from the shared catalog
+ * mikrobus_clicks[]: its device (at /machine/<socket>-click), the lines
+ * between the device and the pins, and every pull resistor on the Click.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MIKROBUS_H
+#define HW_MISC_MIKROBUS_H
+
+#include "hw/i2c/i2c.h"
+#include "hw/ssi/ssi.h"
+
+/* GPIO pins of a socket the Clicks use */
+enum { MIKROBUS_RST, MIKROBUS_PWM, MIKROBUS_INT, MIKROBUS_CS,
+       MIKROBUS_ROLES };
+
+typedef struct MikrobusSocket {
+    const char *name;           /* machine option, e.g. "ext1" or "mb1" */
+    DeviceState *port;          /* the GPIO controller with the pads */
+    const char *port_in;        /* its GPIO input array: external drivers */
+    const char *port_pad;       /* its GPIO output array: pad levels */
+    int pins[MIKROBUS_ROLES];   /* index into both arrays, -1: not wired */
+    I2CBus *i2c;                /* NULL: none on this socket */
+    SSIBus *spi;
+} MikrobusSocket;
+
+/* Comma-separated names of the catalog, for option descriptions */
+const char *mikrobus_click_names(void);
+
+/*
+ * Plug the Click @click (a catalog name; NULL, "" or "none": nothing)
+ * into each of @n sockets; exits with an error for unknown Clicks, a bus
+ * the socket lacks or an I2C address two sockets share.
+ */
+void mikrobus_plug(Object *machine, const MikrobusSocket *sockets,
+                   char *const *clicks, unsigned n);
+
+#endif /* HW_MISC_MIKROBUS_H */
