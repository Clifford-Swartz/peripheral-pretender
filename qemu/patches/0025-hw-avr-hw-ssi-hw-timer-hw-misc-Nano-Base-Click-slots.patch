diff --git a/hw/misc/mikrobus.c b/hw/misc/mikrobus.c
new file mode 100644
index 0000000..671ddf5
--- /dev/null
+++ b/hw/misc/mikrobus.c
@@ -0,0 +1,219 @@
+/*
+ * mikroBUS sockets and the Click boards that plug into them
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The catalog follows MikroElektronika's schematics of each Click (v100):
+ * its device and bus, device outputs onto socket pins, socket pins into
+ * device inputs, and the pull resistors on the Click. A device output
+ * behind a pull resistor lets go with -1 and the resistor sets the pin.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/misc/click_button.h"
+#include "hw/misc/mikrobus.h"
+#include "hw/sensor/mchp_mcp9808.h"
+#include "hw/ssi/max7219.h"
+#include "hw/ssi/ti_74hc595.h"
+
+typedef enum { CLICK_GPIO, CLICK_I2C, CLICK_SPI } ClickBus;
+
+/* A GPIO line between the Click's device and a socket pin */
+typedef struct ClickLine {
+    const char *gpio;           /* NULL: unused */
+    unsigned role;
+} ClickLine;
+
+/* A resistor on the Click pulling a socket pin up (1) or down (0) */
+typedef struct ClickPull {
+    bool used;
+    unsigned role;
+    int level;
+} ClickPull;
+
+typedef struct ClickInfo {
+    const char *name;
+    const char *desc;
+    const char *type;           /* its device, NULL for none */
+    ClickBus bus;
+    uint8_t addr;               /* on the I2C bus */
+    uint32_t length;            /* "length" property, 0 for none */
+    ClickLine outs[2];          /* device output onto a socket pin */
+    ClickLine ins[2];           /* socket pin into a device input */
+    ClickPull pulls[3];
+} ClickInfo;
+
+static const ClickInfo mikrobus_clicks[] = {
+    { "thermo8", "Thermo 8 Click: MCP9808 temperature sensor, ALERT on INT",
+      TYPE_MCHP_MCP9808, CLICK_I2C, 0x18, 0,
+      .outs = { { MCHP_MCP9808_ALERT, MIKROBUS_INT } },
+      .pulls = { { true, MIKROBUS_INT, 1 } } },           /* R3 4.7k */
+    { "buttong", "Button G Click: pushbutton on INT, its LED on PWM",
+      TYPE_CLICK_BUTTON, CLICK_GPIO, 0, 0,
+      .outs = { { CLICK_BUTTON_OUT, MIKROBUS_INT } },
+      .pulls = { { true, MIKROBUS_INT, 0 } } },           /* R2/R3 10k */
+    { "7seg", "7seg Click: two digits on two 74HC595, LATCH on CS, "
+      "MR# on RST, digits enabled by PWM",
+      TYPE_TI_74HC595, CLICK_SPI, 0, 2,
+      .ins = { { TI_74HC595_LATCH, MIKROBUS_CS },
+               { TI_74HC595_MR, MIKROBUS_RST } },
+      .pulls = { { true, MIKROBUS_RST, 1 },               /* R19 4.7k */
+                 { true, MIKROBUS_PWM, 1 } } },           /* R22/R23 4.7k */
+    { "relay", "Relay Click: relay 1 on PWM, relay 2 on CS",
+      NULL, CLICK_GPIO, 0, 0,
+      .pulls = { { true, MIKROBUS_PWM, 0 },               /* Q1/Q2 base */
+                 { true, MIKROBUS_CS, 0 } } },            /* resistors */
+    { "8x8g", "8x8 G Click: 8x8 green LED matrix on a MAX7219, LOAD on CS "
+      "(no pull resistors)",
+      TYPE_MAX7219, CLICK_SPI, 0, 1,
+      .ins = { { MAX7219_LOAD, MIKROBUS_CS } } },
+};
+
+const char *mikrobus_click_names(void)
+{
+    static char *names;
+
+    if (!names) {
+        GString *s = g_string_new(NULL);
+
+        for (unsigned i = 0; i < ARRAY_SIZE(mikrobus_clicks); i++) {
+            g_string_append_printf(s, "%s, ", mikrobus_clicks[i].name);
+        }
+        g_string_append(s, "none");
+        names = g_string_free(s, false);
+    }
+    return names;
+}
+
+static void mikrobus_pull_up(void *opaque, int n, int level)
+{
+    qemu_set_irq(opaque, level < 0 ? 1 : level);
+}
+
+static void mikrobus_pull_down(void *opaque, int n, int level)
+{
+    qemu_set_irq(opaque, level < 0 ? 0 : level);
+}
+
+static const ClickInfo *mikrobus_find(const char *socket, const char *name)
+{
+    for (unsigned i = 0; i < ARRAY_SIZE(mikrobus_clicks); i++) {
+        if (!strcmp(name, mikrobus_clicks[i].name)) {
+            return &mikrobus_clicks[i];
+        }
+    }
+    error_report("%s: unknown Click board '%s' (known: %s)", socket, name,
+                 mikrobus_click_names());
+    exit(1);
+}
+
+/* The socket pin of @role, or exit when the board does not wire it */
+static unsigned mikrobus_pin(const MikrobusSocket *sock, const ClickInfo *c,
+                             unsigned role)
+{
+    static const char *const names[] = { "RST", "PWM", "INT", "CS" };
+
+    if (sock->pins[role] < 0) {
+        error_report("%s: %s needs %s, which this board does not wire",
+                     sock->name, c->name, names[role]);
+        exit(1);
+    }
+    return sock->pins[role];
+}
+
+static void mikrobus_plug_one(Object *machine, const MikrobusSocket *sock,
+                              const ClickInfo *c)
+{
+    DeviceState *dev = NULL;
+
+    if (c->type) {
+        g_autofree char *child = g_strdup_printf("%s-click", sock->name);
+
+        if ((c->bus == CLICK_I2C && !sock->i2c) ||
+            (c->bus == CLICK_SPI && !sock->spi)) {
+            error_report("%s: %s needs %s, which this socket lacks",
+                         sock->name, c->name,
+                         c->bus == CLICK_I2C ? "I2C" : "SPI");
+            exit(1);
+        }
+        dev = qdev_new(c->type);
+        if (c->bus == CLICK_I2C) {
+            qdev_prop_set_uint8(dev, "address", c->addr);
+        }
+        if (c->length) {
+            qdev_prop_set_uint32(dev, "length", c->length);
+        }
+        object_property_add_child(machine, child, OBJECT(dev));
+        switch (c->bus) {
+        case CLICK_I2C:
+            i2c_slave_realize_and_unref(I2C_SLAVE(dev), sock->i2c,
+                                        &error_fatal);
+            break;
+        case CLICK_SPI:
+            ssi_realize_and_unref(dev, sock->spi, &error_fatal);
+            break;
+        default:
+            qdev_realize_and_unref(dev, NULL, &error_fatal);
+        }
+    }
+    /* Resistors first: an output behind one goes through it */
+    for (unsigned i = 0; i < ARRAY_SIZE(c->pulls) && c->pulls[i].used; i++) {
+        qemu_set_irq(qdev_get_gpio_in_named(sock->port, sock->port_in,
+                                            mikrobus_pin(sock, c,
+                                                         c->pulls[i].role)),
+                     c->pulls[i].level);
+    }
+    for (unsigned i = 0; i < ARRAY_SIZE(c->outs) && c->outs[i].gpio; i++) {
+        unsigned role = c->outs[i].role;
+        qemu_irq pad = qdev_get_gpio_in_named(sock->port, sock->port_in,
+                                              mikrobus_pin(sock, c, role));
+
+        for (unsigned j = 0; j < ARRAY_SIZE(c->pulls); j++) {
+            if (c->pulls[j].used && c->pulls[j].role == role) {
+                pad = qemu_allocate_irq(c->pulls[j].level ? mikrobus_pull_up
+                                                          : mikrobus_pull_down,
+                                        pad, 0);
+            }
+        }
+        qdev_connect_gpio_out_named(dev, c->outs[i].gpio, 0, pad);
+    }
+    for (unsigned i = 0; i < ARRAY_SIZE(c->ins) && c->ins[i].gpio; i++) {
+        qdev_connect_gpio_out_named(sock->port, sock->port_pad,
+                                    mikrobus_pin(sock, c, c->ins[i].role),
+                                    qdev_get_gpio_in_named(dev,
+                                                           c->ins[i].gpio, 0));
+    }
+}
+
+void mikrobus_plug(Object *machine, const MikrobusSocket *sockets,
+                   char *const *clicks, unsigned n)
+{
+    g_autofree const ClickInfo **plugged = g_new0(const ClickInfo *, n);
+
+    for (unsigned i = 0; i < n; i++) {
+        const ClickInfo *c;
+
+        if (!clicks[i] || !*clicks[i] || !strcmp(clicks[i], "none")) {
+            continue;
+        }
+        c = mikrobus_find(sockets[i].name, clicks[i]);
+        for (unsigned m = 0; m < i && c->bus == CLICK_I2C; m++) {
+            if (plugged[m] && plugged[m]->bus == CLICK_I2C &&
+                plugged[m]->addr == c->addr &&
+                sockets[m].i2c == sockets[i].i2c) {
+                error_report("%s: I2C address 0x%02x is taken by %s",
+                             sockets[i].name, c->addr, sockets[m].name);
+                exit(1);
+            }
+        }
+        plugged[i] = c;
+        mikrobus_plug_one(machine, &sockets[i], c);
+    }
+}
