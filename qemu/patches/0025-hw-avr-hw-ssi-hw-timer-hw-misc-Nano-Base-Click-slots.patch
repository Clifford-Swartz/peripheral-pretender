@@ -26,6 +26,9 @@
 #define SYSCFG          (DATA + 0x0F00)
 #define NVMCTRL         (DATA + 0x1000)
 #define SIGROW          (DATA + 0x1100)
+#define PORTA           (DATA + 0x0400)
+#define SPI0            (DATA + 0x0940)
+#define TCB0            (DATA + 0x0B00)
 #define EEPROM          (DATA + 0x1400)
 #define SRAM            (DATA + 0x6800)
 #define FLASH_MAP       (DATA + 0x8000)
@@ -164,6 +167,69 @@ static void test_usart_cpuint(const void *fw)
     qtest_quit(qts);
 }
 
+static char *qom_str(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': %s, 'property': %s } }", path, prop);
+    char *value = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return value;
+}
+
+/* One MAX7219 frame through SPI0, LOAD on PA7 (mikroBUS 1 CS) */
+static void max7219_frame(QTestState *qts, uint8_t reg, uint8_t data)
+{
+    qtest_writeb(qts, PORTA + 0x06, BIT(7));                    /* OUTCLR */
+    qtest_writeb(qts, SPI0 + 4, reg);
+    g_assert_cmphex(qtest_readb(qts, SPI0 + 3) & 0x80, ==, 0x80);  /* IF */
+    qtest_writeb(qts, SPI0 + 4, data);
+    qtest_writeb(qts, PORTA + 0x05, BIT(7));                    /* OUTSET */
+}
+
+static void test_spi_8x8g(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb1=8x8g -kernel %s",
+                                  (const char *)fw);
+    g_autofree char *blank = NULL, *test = NULL, *digits = NULL;
+
+    qtest_writeb(qts, PORTA + 0x05, BIT(7));
+    qtest_writeb(qts, PORTA + 0x01, BIT(4) | BIT(6) | BIT(7));
+    qtest_writeb(qts, SPI0 + 0, 0x21);                  /* MASTER, ENABLE */
+    blank = qom_str(qts, "/machine/mb1-click", "display");
+    g_assert_cmpstr(blank, ==, "00 00 00 00 00 00 00 00");  /* shutdown */
+    max7219_frame(qts, 0x0F, 0x01);                     /* display test */
+    test = qom_str(qts, "/machine/mb1-click", "display");
+    g_assert_cmpstr(test, ==, "ff ff ff ff ff ff ff ff");
+    max7219_frame(qts, 0x0F, 0x00);
+    max7219_frame(qts, 0x0B, 0x07);                     /* scan all */
+    max7219_frame(qts, 0x0C, 0x01);                     /* normal operation */
+    max7219_frame(qts, 0x01, 0x3C);
+    max7219_frame(qts, 0x08, 0x81);
+    digits = qom_str(qts, "/machine/mb1-click", "display");
+    g_assert_cmpstr(digits, ==, "3c 00 00 00 00 00 00 81");
+    qtest_quit(qts);
+}
+
+static void test_tcb(const void *fw)
+{
+    QTestState *qts = start(fw);
+
+    /* Periodic interrupt mode, CLK_PER 3.333 MHz, CCMP 3332: 1 ms */
+    qtest_writeb(qts, TCB0 + 0x0C, 3332 & 0xff);
+    qtest_writeb(qts, TCB0 + 0x0D, 3332 >> 8);
+    qtest_writeb(qts, TCB0 + 0x05, 0x01);                       /* CAPT */
+    qtest_writeb(qts, TCB0 + 0x00, 0x01);                       /* ENABLE */
+    g_assert_cmphex(qtest_readb(qts, TCB0 + 0x07), ==, 0x01);   /* RUN */
+    qtest_clock_step(qts, 500 * 1000);
+    g_assert_cmphex(qtest_readb(qts, TCB0 + 0x06), ==, 0);
+    qtest_clock_step(qts, 600 * 1000);
+    g_assert_cmphex(qtest_readb(qts, TCB0 + 0x06), ==, 0x01);
+    qtest_writeb(qts, TCB0 + 0x06, 0x01);                       /* W1C */
+    g_assert_cmphex(qtest_readb(qts, TCB0 + 0x06), ==, 0);
+    qtest_quit(qts);
+}
