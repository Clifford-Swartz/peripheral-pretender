diff --git a/hw/ssi/avr8x_spi.c b/hw/ssi/avr8x_spi.c
new file mode 100644
index 0000000..f9e9238
--- /dev/null
+++ b/hw/ssi/avr8x_spi.c
@@ -0,0 +1,257 @@
+/*
+ * Microchip AVR8X SPI (spi_8bit_v2: AVR Dx, AVR Ex), host mode
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Behaviour from DS40002324 (AVR64EA48), chapter SPI. A byte written to
+ * DATA while CTRLA.ENABLE and MASTER are set is clocked out on the "spi"
+ * SSI bus at once (DORD 1: LSB first); the byte clocked in is what DATA
+ * reads. Normal mode: INTFLAGS.IF when the transfer ends, cleared by
+ * writing 1 or by reading INTFLAGS with IF set and then accessing DATA.
+ * Buffered mode (CTRLB.BUFEN): DREIF (the transmit buffer has room: always
+ * here), TXCIF (shift register and buffer empty, write 1 to clear), RXCIF
+ * while the 2-byte receive FIFO holds data, BUFOVF when it overflows.
+ * One interrupt vector (sysbus IRQ 0). Chip selects are GPIOs of the
+ * board. Not modelled: client mode, the SS pin's host-mode fault
+ * (CTRLB.SSD), clock modes and timing (transfers take no time).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/bitops.h"
+#include "hw/core/irq.h"
+#include "hw/avr/avr8x_periph.h"
+#include "hw/mchp/gen/spi_spi_8bit_v2.h"
+#include "hw/ssi/avr8x_spi.h"
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define AVR8X_SPI_RX_DEPTH  2
+
+OBJECT_DECLARE_SIMPLE_TYPE(Avr8xSpiState, AVR8X_SPI)
+
+struct Avr8xSpiState {
+    MchpRegBlock parent_obj;
+
+    SSIBus *bus;
+    uint8_t flags;              /* INTFLAGS as the active mode shows it */
+    uint8_t data;               /* normal mode: last byte received */
+    uint8_t rx[AVR8X_SPI_RX_DEPTH];
+    uint8_t rx_count;
+    bool if_read;               /* INTFLAGS read with IF set */
+};
+
+static uint8_t avr8x_spi_reg(Avr8xSpiState *s, hwaddr reg)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, reg, 1);
+}
+
+static bool avr8x_spi_buffered(Avr8xSpiState *s)
+{
+    return FIELD_EX8(avr8x_spi_reg(s, A_MCHP_SPI_CTRLB), MCHP_SPI_CTRLB,
+                     BUFEN);
+}
+
+/* INTFLAGS as read: buffered mode derives DREIF and RXCIF */
+static uint8_t avr8x_spi_flags(Avr8xSpiState *s)
+{
+    if (!avr8x_spi_buffered(s)) {
+        return s->flags;
+    }
+    return (s->flags & (R_MCHP_SPI_INTFLAGS_BUFFERED_TXCIF_MASK |
+                        R_MCHP_SPI_INTFLAGS_BUFFERED_SSIF_MASK |
+                        R_MCHP_SPI_INTFLAGS_BUFFERED_BUFOVF_MASK)) |
+           R_MCHP_SPI_INTFLAGS_BUFFERED_DREIF_MASK |
+           (s->rx_count ? R_MCHP_SPI_INTFLAGS_BUFFERED_RXCIF_MASK : 0);
+}
+
+static bool avr8x_spi_irq_pending(MchpRegBlock *rb)
+{
+    Avr8xSpiState *s = AVR8X_SPI(rb);
+    uint8_t intctrl = avr8x_spi_reg(s, A_MCHP_SPI_INTCTRL);
+    uint8_t flags = avr8x_spi_flags(s);
+
+    if (!avr8x_spi_buffered(s)) {
+        return (intctrl & R_MCHP_SPI_INTCTRL_IE_MASK) &&
+               (flags & R_MCHP_SPI_INTFLAGS_IF_MASK);
+    }
+    /* RXCIE, TXCIE, DREIE and SSIE sit over RXCIF, TXCIF, DREIF, SSIF */
+    return intctrl & flags & 0xF0;
+}
+
+static uint8_t avr8x_spi_order(Avr8xSpiState *s, uint8_t byte)
+{
+    if (FIELD_EX8(avr8x_spi_reg(s, A_MCHP_SPI_CTRLA), MCHP_SPI_CTRLA, DORD)) {
+        return revbit8(byte);
+    }
+    return byte;
+}
+
+static void avr8x_spi_transfer(Avr8xSpiState *s, uint8_t out)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint8_t ctrla = avr8x_spi_reg(s, A_MCHP_SPI_CTRLA);
+    uint8_t in;
+
+    if (!FIELD_EX8(ctrla, MCHP_SPI_CTRLA, ENABLE)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.DATA: write while disabled\n",
+                      rb->name);
+        return;
+    }
+    if (!FIELD_EX8(ctrla, MCHP_SPI_CTRLA, MASTER)) {
+        qemu_log_mask(LOG_UNIMP, "%s: client mode not modelled\n", rb->name);
+        return;
+    }
+    in = avr8x_spi_order(s, ssi_transfer(s->bus, avr8x_spi_order(s, out)));
+    trace_avr8x_spi_transfer(rb->name, out, in);
+    if (!avr8x_spi_buffered(s)) {
+        s->data = in;
+        s->flags |= R_MCHP_SPI_INTFLAGS_IF_MASK;
+        return;
+    }
+    if (s->rx_count == AVR8X_SPI_RX_DEPTH) {
+        s->flags |= R_MCHP_SPI_INTFLAGS_BUFFERED_BUFOVF_MASK;
+    } else {
+        s->rx[s->rx_count++] = in;
+    }
+    s->flags |= R_MCHP_SPI_INTFLAGS_BUFFERED_TXCIF_MASK;
+}
+
+static uint32_t avr8x_spi_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                   unsigned idx, uint32_t stored,
+                                   bool side_effects)
+{
+    Avr8xSpiState *s = AVR8X_SPI(rf->opaque);
+    uint8_t value;
+
+    switch (ri->offset) {
+    case A_MCHP_SPI_INTFLAGS:
+        value = avr8x_spi_flags(s);
+        if (side_effects && !avr8x_spi_buffered(s)) {
+            s->if_read = value & R_MCHP_SPI_INTFLAGS_IF_MASK;
+        }
+        return value;
+    case A_MCHP_SPI_DATA:
+        if (!avr8x_spi_buffered(s)) {
+            if (side_effects && s->if_read) {
+                s->flags &= ~(R_MCHP_SPI_INTFLAGS_IF_MASK |
+                              R_MCHP_SPI_INTFLAGS_WRCOL_MASK);
+                s->if_read = false;
+            }
+            return s->data;
+        }
+        value = s->rx_count ? s->rx[0] : 0;
+        if (side_effects && s->rx_count) {
+            s->rx[0] = s->rx[1];
+            s->rx_count--;
+        }
+        return value;
+    }
+    return stored;
+}
+
+static void avr8x_spi_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                 unsigned idx, uint32_t old,
+                                 uint32_t written, uint32_t we)
+{
+    Avr8xSpiState *s = AVR8X_SPI(rf->opaque);
+
+    switch (ri->offset) {
+    case A_MCHP_SPI_INTFLAGS:
+        /* Write 1 clears; DREIF and RXCIF follow the buffers */
+        s->flags &= ~(written & we & (avr8x_spi_buffered(s) ?
+                      (R_MCHP_SPI_INTFLAGS_BUFFERED_TXCIF_MASK |
+                       R_MCHP_SPI_INTFLAGS_BUFFERED_SSIF_MASK |
+                       R_MCHP_SPI_INTFLAGS_BUFFERED_BUFOVF_MASK) :
+                      (R_MCHP_SPI_INTFLAGS_IF_MASK |
+                       R_MCHP_SPI_INTFLAGS_WRCOL_MASK)));
+        break;
+    case A_MCHP_SPI_DATA:
+        if (!avr8x_spi_buffered(s) && s->if_read) {
+            s->flags &= ~(R_MCHP_SPI_INTFLAGS_IF_MASK |
+                          R_MCHP_SPI_INTFLAGS_WRCOL_MASK);
+            s->if_read = false;
+        }
+        if (avr8x_spi_buffered(s)) {
+            s->flags &= ~R_MCHP_SPI_INTFLAGS_BUFFERED_TXCIF_MASK;
+        }
+        avr8x_spi_transfer(s, written & 0xff);
+        break;
+    case A_MCHP_SPI_CTRLB:
+        if ((written ^ old) & R_MCHP_SPI_CTRLB_BUFEN_MASK) {
+            s->flags = 0;
+            s->rx_count = 0;
+        }
+        break;
+    case A_MCHP_SPI_CTRLA:
+        if (!FIELD_EX8(written, MCHP_SPI_CTRLA, ENABLE)) {
+            s->flags = 0;
+            s->rx_count = 0;
+        }
+        break;
+    }
+}
+
+static void avr8x_spi_reset_hold(MchpRegBlock *rb)
+{
+    Avr8xSpiState *s = AVR8X_SPI(rb);
+
+    s->flags = 0;
+    s->data = 0;
+    s->rx_count = 0;
+    s->if_read = false;
+}
+
+static bool avr8x_spi_realize(MchpRegBlock *rb, Error **errp)
+{
+    g_autofree char *bus = g_strdup_printf("%s.spi", rb->name);
+
+    AVR8X_SPI(rb)->bus = ssi_create_bus(DEVICE(rb), bus);
+    return true;
+}
+
+static const VMStateDescription vmstate_avr8x_spi = {
+    .name = TYPE_AVR8X_SPI,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, Avr8xSpiState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_UINT8(flags, Avr8xSpiState),
+        VMSTATE_UINT8(data, Avr8xSpiState),
+        VMSTATE_UINT8_ARRAY(rx, Avr8xSpiState, AVR8X_SPI_RX_DEPTH),
+        VMSTATE_UINT8(rx_count, Avr8xSpiState),
+        VMSTATE_BOOL(if_read, Avr8xSpiState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void avr8x_spi_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    dc->vmsd = &vmstate_avr8x_spi;
+    c->realize = avr8x_spi_realize;
+    c->pre_read = avr8x_spi_pre_read;
+    c->post_write = avr8x_spi_post_write;
+    c->irq_pending = avr8x_spi_irq_pending;
+    c->reset_hold = avr8x_spi_reset_hold;
+    c->is_enabled = avr8x_never_enabled;
+    c->log_writes = false;
+}
+
+static const TypeInfo avr8x_spi_types[] = {
+    {
+        .name = TYPE_AVR8X_SPI,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(Avr8xSpiState),
+        .class_init = avr8x_spi_class_init,
+    },
+};
+
+DEFINE_TYPES(avr8x_spi_types)
diff --git a/hw/ssi/max7219.c b/hw/ssi/max7219.c
new file mode 100644
index 0000000..673cd41
--- /dev/null
+++ b/hw/ssi/max7219.c
@@ -0,0 +1,214 @@
+/*
+ * Maxim MAX7219 serially interfaced 8-digit LED display driver
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * MAX7219/MAX7221 data sheet (19-4452, rev 4): 16-bit frames D15..D0 shift
+ * in on DIN, MSB first, and out on DOUT 16 clocks later, so "length"
+ * devices form a daisy chain; the rising edge of LOAD latches each
+ * device's last 16 bits. D11..D8 address No-Op (0), Digit 0-7 (1-8),
+ * Decode Mode (9), Intensity (A), Scan Limit (B), Shutdown (C) and Display
+ * Test (F); D7..D0 are the data. At power-up the device is in shutdown
+ * with every register 0. Code B decoding follows Table 5; DP is D7.
+ *
+ * Here the chain sits on a QEMU SSI bus (SPI mode 0, 8 bits a transfer)
+ * and GPIO input "load" takes 0/1 (or -1 undriven: the level stays).
+ * QOM properties (read-only): "display", per device the eight digit
+ * outputs as hex bytes "d0 d1 ... d7" (segment DP..G in bits 7..0, what
+ * the LEDs show: blank in shutdown, all on in display test, digits past
+ * the scan limit off), devices separated by "/"; "intensity" of device 0
+ * (0-15, the PWM duty in 32nds is 2 * intensity + 1).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/ssi/max7219.h"
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define MAX7219_MAX_CHAIN   4
+#define MAX7219_DIGITS      8
+
+enum {
+    REG_NOOP = 0x0,
+    REG_DIGIT0 = 0x1,
+    REG_DECODE = 0x9,
+    REG_INTENSITY = 0xA,
+    REG_SCAN_LIMIT = 0xB,
+    REG_SHUTDOWN = 0xC,
+    REG_TEST = 0xF,
+    REG_COUNT = 16,
+};
+
+OBJECT_DECLARE_SIMPLE_TYPE(Max7219State, MAX7219)
+
+struct Max7219State {
+    SSIPeripheral parent_obj;
+
+    uint32_t length;
+    uint64_t shift;             /* device 0 (on DIN) in bits 15:0 */
+    uint8_t regs[MAX7219_MAX_CHAIN][REG_COUNT];
+    bool load;
+};
+
+/* Code B font (Table 5): 0-9, -, E, H, L, P, blank; segments A-G in 6:0 */
+static const uint8_t max7219_code_b[16] = {
+    0x7E, 0x30, 0x6D, 0x79, 0x33, 0x5B, 0x5F, 0x70,
+    0x7F, 0x7B, 0x01, 0x4F, 0x37, 0x0E, 0x67, 0x00,
+};
+
+static uint64_t max7219_mask(Max7219State *s)
+{
+    return s->length >= 4 ? UINT64_MAX : (1ULL << (16 * s->length)) - 1;
+}
+
+static uint32_t max7219_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    Max7219State *s = MAX7219(dev);
+    uint32_t out = (s->shift >> (16 * s->length - 8)) & 0xFF;
+
+    s->shift = ((s->shift << 8) | (val & 0xFF)) & max7219_mask(s);
+    return out;
+}
+
+static void max7219_set_load(void *opaque, int n, int level)
+{
+    Max7219State *s = opaque;
+    bool high = level > 0 || (level < 0 && s->load);
+
+    if (high && !s->load) {
+        for (unsigned d = 0; d < s->length; d++) {
+            uint16_t word = s->shift >> (16 * d);
+            unsigned reg = (word >> 8) & 0xF;
+
+            trace_max7219_latch(d, reg, word & 0xFF);
+            if (reg != REG_NOOP) {
+                s->regs[d][reg] = word & 0xFF;
+            }
+        }
+    }
+    s->load = high;
+}
+
+/* What digit @digit of device @d shows */
+static uint8_t max7219_digit(Max7219State *s, unsigned d, unsigned digit)
+{
+    const uint8_t *r = s->regs[d];
+    uint8_t data = r[REG_DIGIT0 + digit];
+
+    if (r[REG_TEST] & 1) {
+        return 0xFF;
+    }
+    if (!(r[REG_SHUTDOWN] & 1) || digit > (r[REG_SCAN_LIMIT] & 7)) {
+        return 0;
+    }
+    if (r[REG_DECODE] & BIT(digit)) {
+        return (data & 0x80) | max7219_code_b[data & 0xF];
+    }
+    return data;
+}
+
+static void max7219_get_display(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    Max7219State *s = MAX7219(obj);
+    g_autoptr(GString) str = g_string_new(NULL);
+    g_autofree char *val = NULL;
+
+    for (unsigned d = 0; d < s->length; d++) {
+        for (unsigned digit = 0; digit < MAX7219_DIGITS; digit++) {
+            g_string_append_printf(str, "%s%02x",
+                                   digit ? " " : (d ? "/" : ""),
+                                   max7219_digit(s, d, digit));
+        }
+    }
+    val = g_string_free(g_steal_pointer(&str), false);
+    visit_type_str(v, name, &val, errp);
+}
+
+static void max7219_get_intensity(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    uint32_t value = MAX7219(obj)->regs[0][REG_INTENSITY] & 0xF;
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void max7219_realize(SSIPeripheral *dev, Error **errp)
+{
+    Max7219State *s = MAX7219(dev);
+
+    if (s->length < 1 || s->length > MAX7219_MAX_CHAIN) {
+        error_setg(errp, "length must be 1 to %d", MAX7219_MAX_CHAIN);
+        return;
+    }
+    qdev_init_gpio_in_named(DEVICE(dev), max7219_set_load, MAX7219_LOAD, 1);
+}
+
+static void max7219_reset(DeviceState *dev)
+{
+    Max7219State *s = MAX7219(dev);
+
+    s->shift = 0;
+    memset(s->regs, 0, sizeof(s->regs));
+    s->load = true;
+}
+
+static void max7219_init(Object *obj)
+{
+    object_property_add(obj, "display", "str", max7219_get_display,
+                        NULL, NULL, NULL);
+    object_property_add(obj, "intensity", "uint32", max7219_get_intensity,
+                        NULL, NULL, NULL);
+}
+
+static const Property max7219_properties[] = {
+    DEFINE_PROP_UINT32("length", Max7219State, length, 1),
+};
+
+static const VMStateDescription vmstate_max7219 = {
+    .name = TYPE_MAX7219,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, Max7219State),
+        VMSTATE_UINT64(shift, Max7219State),
+        VMSTATE_UINT8_2DARRAY(regs, Max7219State, MAX7219_MAX_CHAIN,
+                              REG_COUNT),
+        VMSTATE_BOOL(load, Max7219State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void max7219_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    dc->desc = "MAX7219 8-digit LED display driver";
+    dc->vmsd = &vmstate_max7219;
+    device_class_set_props(dc, max7219_properties);
+    device_class_set_legacy_reset(dc, max7219_reset);
+    k->realize = max7219_realize;
+    k->transfer = max7219_transfer;
+    k->cs_polarity = SSI_CS_NONE;   /* shifts on every clock; LOAD latches */
+}
+
+static const TypeInfo max7219_types[] = {
+    {
+        .name = TYPE_MAX7219,
+        .parent = TYPE_SSI_PERIPHERAL,
+        .instance_size = sizeof(Max7219State),
+        .instance_init = max7219_init,
+        .class_init = max7219_class_init,
+    },
+};
+
+DEFINE_TYPES(max7219_types)
