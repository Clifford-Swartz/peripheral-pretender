diff --git a/hw/timer/avr8x_tcb.c b/hw/timer/avr8x_tcb.c
new file mode 100644
index 0000000..d228a06
--- /dev/null
+++ b/hw/timer/avr8x_tcb.c
@@ -0,0 +1,266 @@
+/*
+ * Microchip AVR8X 16-bit timer/counter type B (tmr_16b_capture_v1)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Behaviour from DS40002324 (AVR64EA48), chapter TCB. Modelled: the
+ * periodic interrupt mode (CTRLB.CNTMODE INT): CNT counts CLK_PER (CLKSEL
+ * DIV1) or CLK_PER / 2 (DIV2) from 0 to CCMP, then restarts at 0 and sets
+ * INTFLAGS.CAPT; CNT reads the count on QEMU_CLOCK_VIRTUAL; STATUS.RUN.
+ * The interrupt (one vector, sysbus IRQ 0) is INTFLAGS & INTCTRL. Not
+ * modelled, and logged: the other counter modes, the TCA clock sources,
+ * events and the waveform output; OVF never sets.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/avr/avr8x_periph.h"
+#include "hw/core/clock.h"
+#include "hw/mchp/gen/tcb_tmr_16b_capture_v1.h"
+#include "hw/timer/avr8x_tcb.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define TCB_CLKSEL_DIV1     0
+#define TCB_CLKSEL_DIV2     1
+#define TCB_CNTMODE_INT     0
+
+OBJECT_DECLARE_SIMPLE_TYPE(Avr8xTcbState, AVR8X_TCB)
+
+struct Avr8xTcbState {
+    MchpRegBlock parent_obj;
+
+    QEMUTimer *timer;
+    bool running;
+    int64_t start_ns;           /* virtual time of count 0 */
+    uint64_t periods;           /* periods completed since start_ns */
+};
+
+static uint32_t avr8x_tcb_reg(Avr8xTcbState *s, hwaddr reg, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, reg, size);
+}
+
+/* Counter clock in Hz, 0 when it does not run in a modelled way */
+static uint64_t avr8x_tcb_hz(Avr8xTcbState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint8_t ctrla = avr8x_tcb_reg(s, A_MCHP_TCB_CTRLA, 1);
+    uint8_t ctrlb = avr8x_tcb_reg(s, A_MCHP_TCB_CTRLB, 1);
+    uint64_t hz = clock_get_hz(rb->gclk);
+
+    if (!FIELD_EX8(ctrla, MCHP_TCB_CTRLA, ENABLE)) {
+        return 0;
+    }
+    if (FIELD_EX8(ctrlb, MCHP_TCB_CTRLB, CNTMODE) != TCB_CNTMODE_INT) {
+        qemu_log_mask(LOG_UNIMP, "%s.CTRLB: counter mode %u not modelled\n",
+                      rb->name, FIELD_EX8(ctrlb, MCHP_TCB_CTRLB, CNTMODE));
+        return 0;
+    }
+    switch (FIELD_EX8(ctrla, MCHP_TCB_CTRLA, CLKSEL)) {
+    case TCB_CLKSEL_DIV1:
+        return hz;
+    case TCB_CLKSEL_DIV2:
+        return hz / 2;
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s.CTRLA: clock source %u not modelled\n",
+                      rb->name, FIELD_EX8(ctrla, MCHP_TCB_CTRLA, CLKSEL));
+        return 0;
+    }
+}
+
+static uint64_t avr8x_tcb_period(Avr8xTcbState *s)
+{
+    return (uint64_t)avr8x_tcb_reg(s, A_MCHP_TCB_CCMP, 2) + 1;
+}
+
+/* Counter ticks since start_ns */
+static uint64_t avr8x_tcb_ticks(Avr8xTcbState *s, uint64_t hz)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    return now <= s->start_ns ? 0 :
+           muldiv64(now - s->start_ns, hz, NANOSECONDS_PER_SECOND);
+}
+
+static void avr8x_tcb_schedule(Avr8xTcbState *s, uint64_t hz)
+{
+    uint64_t next = (s->periods + 1) * avr8x_tcb_period(s);
+
+    timer_mod(s->timer, s->start_ns +
+              muldiv64(next, NANOSECONDS_PER_SECOND, hz) + 1);
+}
+
+/* (Re)start counting at @count with the current configuration */
+static void avr8x_tcb_restart(Avr8xTcbState *s, uint32_t count)
+{
+    uint64_t hz = avr8x_tcb_hz(s);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    s->running = hz != 0;
+    timer_del(s->timer);
+    if (!s->running) {
+        return;
+    }
+    s->start_ns = now - muldiv64(count, NANOSECONDS_PER_SECOND, hz);
+    s->periods = 0;
+    avr8x_tcb_schedule(s, hz);
+}
+
+static uint32_t avr8x_tcb_count(Avr8xTcbState *s)
+{
+    uint64_t hz = avr8x_tcb_hz(s);
+
+    if (!s->running || !hz) {
+        return avr8x_tcb_reg(s, A_MCHP_TCB_CNT, 2);
+    }
+    return avr8x_tcb_ticks(s, hz) % avr8x_tcb_period(s);
+}
+
+static void avr8x_tcb_expire(void *opaque)
+{
+    Avr8xTcbState *s = opaque;
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint64_t hz = avr8x_tcb_hz(s);
+
+    if (!s->running || !hz) {
+        return;
+    }
+    s->periods = avr8x_tcb_ticks(s, hz) / avr8x_tcb_period(s);
+    mchp_regfile_poke(&rb->rf, A_MCHP_TCB_INTFLAGS, 1,
+                      avr8x_tcb_reg(s, A_MCHP_TCB_INTFLAGS, 1) |
+                      R_MCHP_TCB_INTFLAGS_CAPT_MASK);
+    trace_avr8x_tcb_capt(rb->name);
+    mchp_regblock_update_irq(rb);
+    avr8x_tcb_schedule(s, hz);
+}
+
+static bool avr8x_tcb_irq_pending(MchpRegBlock *rb)
+{
+    Avr8xTcbState *s = AVR8X_TCB(rb);
+
+    return avr8x_tcb_reg(s, A_MCHP_TCB_INTFLAGS, 1) &
+           avr8x_tcb_reg(s, A_MCHP_TCB_INTCTRL, 1);
+}
+
+static uint32_t avr8x_tcb_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                   unsigned idx, uint32_t stored,
+                                   bool side_effects)
+{
+    Avr8xTcbState *s = AVR8X_TCB(rf->opaque);
+
+    switch (ri->offset) {
+    case A_MCHP_TCB_CNT:
+        return avr8x_tcb_count(s);
+    case A_MCHP_TCB_STATUS:
+        return s->running ? R_MCHP_TCB_STATUS_RUN_MASK : 0;
+    }
+    return stored;
+}
+
+static void avr8x_tcb_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                 unsigned idx, uint32_t old,
+                                 uint32_t written, uint32_t we)
+{
+    Avr8xTcbState *s = AVR8X_TCB(rf->opaque);
+    uint32_t count = s->running ? avr8x_tcb_count(s) : 0;
+
+    switch (ri->offset) {
+    case A_MCHP_TCB_CNT:
+        count = avr8x_tcb_reg(s, A_MCHP_TCB_CNT, 2);
+        break;
+    case A_MCHP_TCB_CTRLA:
+        if (!FIELD_EX8(old, MCHP_TCB_CTRLA, ENABLE)) {
+            count = avr8x_tcb_reg(s, A_MCHP_TCB_CNT, 2);
+        }
+        break;
+    }
+    if (ri->offset == A_MCHP_TCB_CTRLA &&
+        !FIELD_EX8(written, MCHP_TCB_CTRLA, ENABLE) && s->running) {
+        /* Disabling stops the count where it is */
+        mchp_regfile_poke(rf, A_MCHP_TCB_CNT, 2, count);
+    }
+    avr8x_tcb_restart(s, count);
+}
+
+static void avr8x_tcb_gclk_update(MchpRegBlock *rb, ClockEvent event)
+{
+    Avr8xTcbState *s = AVR8X_TCB(rb);
+
+    if (event == ClockPreUpdate) {
+        if (s->running) {
+            mchp_regfile_poke(&rb->rf, A_MCHP_TCB_CNT, 2,
+                              avr8x_tcb_count(s));
+        }
+    } else {
+        avr8x_tcb_restart(s, avr8x_tcb_reg(s, A_MCHP_TCB_CNT, 2));
+    }
+}
+
+static void avr8x_tcb_reset_hold(MchpRegBlock *rb)
+{
+    Avr8xTcbState *s = AVR8X_TCB(rb);
+
+    timer_del(s->timer);
+    s->running = false;
+    s->periods = 0;
+}
+
+static bool avr8x_tcb_realize(MchpRegBlock *rb, Error **errp)
+{
+    AVR8X_TCB(rb)->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, avr8x_tcb_expire,
+                                        rb);
+    return true;
+}
+
+static void avr8x_tcb_finalize(Object *obj)
+{
+    timer_free(AVR8X_TCB(obj)->timer);
+}
+
+static const VMStateDescription vmstate_avr8x_tcb = {
+    .name = TYPE_AVR8X_TCB,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, Avr8xTcbState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_TIMER_PTR(timer, Avr8xTcbState),
+        VMSTATE_BOOL(running, Avr8xTcbState),
+        VMSTATE_INT64(start_ns, Avr8xTcbState),
+        VMSTATE_UINT64(periods, Avr8xTcbState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void avr8x_tcb_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    dc->vmsd = &vmstate_avr8x_tcb;
+    c->realize = avr8x_tcb_realize;
+    c->pre_read = avr8x_tcb_pre_read;
+    c->post_write = avr8x_tcb_post_write;
+    c->irq_pending = avr8x_tcb_irq_pending;
+    c->reset_hold = avr8x_tcb_reset_hold;
+    c->gclk_update = avr8x_tcb_gclk_update;
+    c->is_enabled = avr8x_never_enabled;
+    c->log_writes = false;
+}
+
+static const TypeInfo avr8x_tcb_types[] = {
+    {
+        .name = TYPE_AVR8X_TCB,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(Avr8xTcbState),
+        .instance_finalize = avr8x_tcb_finalize,
+        .class_init = avr8x_tcb_class_init,
+    },
+};
+
+DEFINE_TYPES(avr8x_tcb_types)
