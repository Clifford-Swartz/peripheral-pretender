+        sockets[n] = (MikrobusSocket) {
+            .name = names[n], .port = DEVICE(&s->soc.port),
+            .port_in = AVR8X_PORT_IN, .port_pad = AVR8X_PORT_PAD,
+            .spi = spi,
+        };
+        memcpy(sockets[n].pins, avr64ea48_cnano_mb_pins[n],
+               sizeof(sockets[n].pins));
+    }
+    mikrobus_plug(OBJECT(s), sockets, s->mb, CNANO_MB_NUM);
+}
+
