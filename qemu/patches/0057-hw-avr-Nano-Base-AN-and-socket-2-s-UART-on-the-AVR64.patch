--- a/include/hw/misc/mikrobus.h
+++ b/include/hw/misc/mikrobus.h
@@ -64,6 +64,15 @@ const char *mikrobus_click_names(void);
  */
 Chardev *mikrobus_uart_chardev(const char *socket, const char *click);
 
+/*
+ * A UART line shared by a Click's chardev @click and another device
+ * @other (a debugger's virtual COM port; NULL: none): give the returned
+ * chardev (/chardevs/<socket>-share) to the UART. What the MCU sends
+ * reaches both; what either sends reaches the MCU.
+ */
+Chardev *mikrobus_uart_share(const char *socket, Chardev *click,
+                             Chardev *other);
+
 /*
  * Plug the Click @click (a catalog name; NULL, "" or "none": nothing)
  * into each of @n sockets; exits with an error for unknown Clicks, a bus
diff --git a/tests/qtest/avr64ea48-cnano-test.c b/tests/qtest/avr64ea48-cnano-test.c
index 6872e20..fed4372 100644
--- a/tests/qtest/avr64ea48-cnano-test.c
+++ b/tests/qtest/avr64ea48-cnano-test.c
@@ -432,6 +432,27 @@ static void test_twi_thermo8(const void *fw)
     qtest_quit(qts);
 }
 
+/*
+ * The Nano Base's AN: a POT on mb1 on ADC0 AIN4 (PD4); the DC Motor on
+ * mb3 pulls its nSLEEP, AN as a digital pad (PD7), high through R3
+ */
+static void test_an(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb1=pot,mb3=dcmotor "
+                                  "-kernel %s", (const char *)fw);
+    g_autofree char *mid = qom_str(qts, "/machine/soc/adc0", "ain");
+    g_autofree char *top = NULL;
+
+    g_assert_cmpstr(mid, ==, "4=1024");
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/mb1-click',"
+                             " 'property': 'position', 'value': 1000 } }");
+    top = qom_str(qts, "/machine/soc/adc0", "ain");
+    g_assert_cmpstr(top, ==, "4=2048");
+    g_assert_cmphex(qtest_readb(qts, PORTD + P_IN) & BIT(7), ==, BIT(7));
+    qtest_quit(qts);
+}
+
 /* RTC 6 Click (MCP79411) on mikroBUS 3: the clock runs, MFP on INT PE0 */
 static void test_twi_rtc6(const void *fw)
 {
@@ -483,6 +504,7 @@ int main(int argc, char **argv)
     qtest_add_data_func("avr64ea48-cnano/twi-accel", fw, test_twi_accel);
     qtest_add_data_func("avr64ea48-cnano/twi-thermo8", fw, test_twi_thermo8);
     qtest_add_data_func("avr64ea48-cnano/twi-rtc6", fw, test_twi_rtc6);
+    qtest_add_data_func("avr64ea48-cnano/an", fw, test_an);
     ret = g_test_run();
     unlink(fw);
     return ret;
