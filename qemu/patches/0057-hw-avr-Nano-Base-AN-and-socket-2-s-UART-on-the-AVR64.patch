diff --git a/hw/misc/mikrobus.c b/hw/misc/mikrobus.c
index fd1502f..55c4b99 100644
--- a/hw/misc/mikrobus.c
+++ b/hw/misc/mikrobus.c
@@ -16,6 +16,7 @@
 #include "qapi/error.h"
 #include "qemu/error-report.h"
 #include "chardev/char.h"
+#include "chardev/char-fe.h"
 #include "hw/core/irq.h"
 #include "hw/core/qdev-properties.h"
 #include "hw/misc/click_button.h"
@@ -366,6 +367,101 @@ Chardev *mikrobus_uart_chardev(const char *socket, const char *click)
     return qemu_chardev_new(id, c->type, NULL, NULL, &error_fatal);
 }
 
+/*
+ * A UART line two devices hang on (a UART Click and a debugger's virtual
+ * COM port): what the MCU sends goes to both, what either sends reaches
+ * the MCU (on silicon, both at once would collide).
+ */
+#define TYPE_CHARDEV_MIKROBUS_SHARE "chardev-mikrobus-share"
+OBJECT_DECLARE_SIMPLE_TYPE(MikrobusShareChardev, CHARDEV_MIKROBUS_SHARE)
+
+struct MikrobusShareChardev {
+    Chardev parent_obj;
+    CharFrontend fe[2];
+};
+
+static int mikrobus_share_can_read(void *opaque)
+{
+    return qemu_chr_be_can_write(CHARDEV(opaque));
+}
+
+static void mikrobus_share_read(void *opaque, const uint8_t *buf, int size)
+{
+    qemu_chr_be_write(CHARDEV(opaque), buf, size);
+}
+
+static int mikrobus_share_write(Chardev *chr, const uint8_t *buf, int len)
+{
+    MikrobusShareChardev *s = CHARDEV_MIKROBUS_SHARE(chr);
+
+    for (unsigned i = 0; i < 2; i++) {
+        if (s->fe[i].chr) {
+            qemu_chr_fe_write(&s->fe[i], buf, len);
+        }
+    }
+    return len;
+}
+
+static void mikrobus_share_accept_input(Chardev *chr)
+{
+    MikrobusShareChardev *s = CHARDEV_MIKROBUS_SHARE(chr);
+
+    for (unsigned i = 0; i < 2; i++) {
+        if (s->fe[i].chr) {
+            qemu_chr_fe_accept_input(&s->fe[i]);
+        }
+    }
+}
+
+static bool mikrobus_share_open(Chardev *chr, ChardevBackend *backend,
+                                Error **errp)
+{
+    return true;
+}
+
+static void mikrobus_share_class_init(ObjectClass *oc, const void *data)
+{
+    ChardevClass *cc = CHARDEV_CLASS(oc);
+
+    cc->chr_open = mikrobus_share_open;
+    cc->chr_write = mikrobus_share_write;
+    cc->chr_accept_input = mikrobus_share_accept_input;
+}
+
+static const TypeInfo mikrobus_share_type = {
+    .name = TYPE_CHARDEV_MIKROBUS_SHARE,
+    .parent = TYPE_CHARDEV,
+    .instance_size = sizeof(MikrobusShareChardev),
+    .class_init = mikrobus_share_class_init,
+};
+
+static void mikrobus_register_types(void)
+{
+    type_register_static(&mikrobus_share_type);
+}
+
+type_init(mikrobus_register_types)
+
+Chardev *mikrobus_uart_share(const char *socket, Chardev *click,
+                             Chardev *other)
+{
+    g_autofree char *id = g_strdup_printf("%s-share", socket);
+    Chardev *chr = qemu_chardev_new(id, TYPE_CHARDEV_MIKROBUS_SHARE, NULL,
+                                    NULL, &error_fatal);
+    MikrobusShareChardev *s = CHARDEV_MIKROBUS_SHARE(chr);
+    Chardev *be[2] = { click, other };
+
+    for (unsigned i = 0; i < 2; i++) {
+        if (be[i]) {
+            qemu_chr_fe_init(&s->fe[i], be[i], &error_fatal);
+            qemu_chr_fe_set_handlers(&s->fe[i], mikrobus_share_can_read,
+                                     mikrobus_share_read, NULL, NULL, s,
+                                     NULL, true);
+        }
+    }
+    return chr;
+}
+
 static void mikrobus_plug_one(Object *machine, const MikrobusSocket *sock,
                               unsigned index, const ClickInfo *c)
 {
diff --git a/include/hw/misc/mikrobus.h b/include/hw/misc/mikrobus.h
