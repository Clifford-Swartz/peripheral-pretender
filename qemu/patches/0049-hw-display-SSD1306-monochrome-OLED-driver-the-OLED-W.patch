new file mode 100644
index 0000000..b2489eb
--- /dev/null
+++ b/hw/display/ssd1306.c
@@ -0,0 +1,466 @@
+/*
+ * Solomon Systech SSD1306 128x64 monochrome OLED driver on an SSI bus
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SSD1306 data sheet rev 1.1, 4-wire SPI (BS[2:0] = 000): bytes are
+ * commands while D/C# is low and display data while it is high; CS# low
+ * selects. The 128 x 64 GDDRAM is 8 pages of 128 columns, a byte a column,
+ * its LSB the top row of the page. Modelled: the three addressing modes
+ * (20h: horizontal, vertical, page; 21h/22h windows in the first two,
+ * B0h-B7h and 00h-1Fh in page mode), start line (40h-7Fh), segment re-map
+ * (A0h/A1h), MUX ratio (A8h), COM scan direction (C0h/C8h), display offset
+ * (D3h), COM pins layout (DAh, sequential or alternative), entire display
+ * on (A4h/A5h), normal/inverse (A6h/A7h), display on/off (AEh/AFh) and the
+ * charge pump (8Dh): the panel lights only with the display on and the
+ * pump enabled (14h), as on a Click without an external VCC. Every other
+ * command takes its parameters and is otherwise ignored: contrast,
+ * timing and VCOMH do not change the picture. Not modelled: scrolling
+ * (26h-2Fh, A3h: logged), reading RAM (not possible over SPI). RES# low
+ * returns the registers to their reset values; the RAM keeps its contents.
+ *
+ * The panel: "width" x "height" pixels; column x shows segment
+ * "seg-left" - x, and row y common pin "com-row0" - y / 2 (even rows) or
+ * "com-row1" - (y - 1) / 2 (odd rows). The defaults are the OLED W
+ * Click's MI9639BO-W (96 x 39: SEG95..0, COM19..0 and COM50..32
+ * interleaved, from its data sheet's drawing); with MikroElektronika's
+ * initialisation (A0h, C8h, DAh 12h, MUX 40) row y shows RAM line y + 1
+ * and column x RAM column 95 - x. The picture is white on black ("color",
+ * RGB565). Not checked against a physical display.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/display/pp_panel.h"
+#include "hw/display/ssd1306.h"
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+
+#define SSD1306_COLS        128
+#define SSD1306_PAGES       8
+#define SSD1306_ROWS        64
+#define SSD1306_MAX_ARGS    6
+
+OBJECT_DECLARE_SIMPLE_TYPE(Ssd1306State, SSD1306)
+
+struct Ssd1306State {
+    SSIPeripheral parent_obj;
+
+    PpPanel panel;
+    uint32_t width;
+    uint32_t height;
+    uint32_t seg_left;
+    uint32_t com_row0;
+    uint32_t com_row1;
+    uint32_t color;
+
+    uint8_t ram[SSD1306_PAGES * SSD1306_COLS];
+    uint8_t cmd;
+    uint8_t nargs;
+    uint8_t argc;
+    uint8_t args[SSD1306_MAX_ARGS];
+
+    uint8_t mode;               /* 0 horizontal, 1 vertical, 2 page */
+    uint8_t col_start, col_end, page_start, page_end, col, page;
+    bool remap;                 /* A1h: column 127 on SEG0 */
+    bool com_reverse;           /* C8h */
+    bool com_alt;               /* DAh bit 4: alternative COM layout */
+    uint8_t start_line;
+    uint8_t offset;
+    uint8_t mux;                /* MUX ratio - 1 */
+    bool all_on;
+    bool inverse;
+    bool display_on;
+    bool pump;
+
+    bool dc;
+    bool in_reset;
+};
+
+/* Parameters each command takes */
+static unsigned ssd1306_nargs(uint8_t cmd)
+{
+    switch (cmd) {
+    case 0x20: case 0x81: case 0x8D: case 0xA8: case 0xD3: case 0xD5:
+    case 0xD9: case 0xDA: case 0xDB:
+        return 1;
+    case 0x21: case 0x22: case 0xA3:
+        return 2;
+    case 0x29: case 0x2A:
+        return 5;
+    case 0x26: case 0x27:
+        return 6;
+    default:
+        return 0;
+    }
+}
+
+static void ssd1306_registers_reset(Ssd1306State *s)
+{
+    s->cmd = 0;
+    s->nargs = 0;
+    s->argc = 0;
+    s->mode = 2;
+    s->col_start = 0;
+    s->col_end = SSD1306_COLS - 1;
+    s->page_start = 0;
+    s->page_end = SSD1306_PAGES - 1;
+    s->col = 0;
+    s->page = 0;
+    s->remap = false;
+    s->com_reverse = false;
+    s->com_alt = true;          /* DAh reset value 12h */
+    s->start_line = 0;
+    s->offset = 0;
+    s->mux = SSD1306_ROWS - 1;
+    s->all_on = false;
+    s->inverse = false;
+    s->display_on = false;
+    s->pump = false;
+    pp_panel_changed(&s->panel);
+}
+
+static void ssd1306_execute(Ssd1306State *s)
+{
+    uint8_t c = s->cmd, *a = s->args;
+
+    switch (c) {
+    case 0x20:
+        s->mode = a[0] & 3;
+        if (s->mode == 3) {
+            s->mode = 2;            /* invalid: page */
+        }
+        break;
+    case 0x21:
+        s->col_start = a[0] & 0x7F;
+        s->col_end = a[1] & 0x7F;
+        s->col = s->col_start;
+        break;
+    case 0x22:
+        s->page_start = a[0] & 7;
+        s->page_end = a[1] & 7;
+        s->page = s->page_start;
+        break;
+    case 0x8D:
+        s->pump = a[0] & 0x04;
+        pp_panel_changed(&s->panel);
+        break;
+    case 0xA8:
+        if ((a[0] & 0x3F) >= 15) {
+            s->mux = a[0] & 0x3F;
+            pp_panel_changed(&s->panel);
+        }
+        break;
+    case 0xD3:
+        s->offset = a[0] & 0x3F;
+        pp_panel_changed(&s->panel);
+        break;
+    case 0xDA:
+        s->com_alt = a[0] & 0x10;
+        if (a[0] & 0x20) {
+            qemu_log_mask(LOG_UNIMP, "ssd1306: COM left/right re-map is "
+                          "not modelled\n");
+        }
+        pp_panel_changed(&s->panel);
+        break;
+    case 0x26: case 0x27: case 0x29: case 0x2A: case 0xA3:
+        qemu_log_mask(LOG_UNIMP, "ssd1306: scrolling (%02Xh) is not "
+                      "modelled\n", c);
+        break;
+    default:
+        break;                      /* contrast, timing, VCOMH: no effect */
+    }
+}
+
+/* A command without parameters, or the first byte of one with them */
+static void ssd1306_command(Ssd1306State *s, uint8_t v)
+{
+    if (s->argc < s->nargs) {
+        s->args[s->argc++] = v;
+        if (s->argc == s->nargs) {
+            ssd1306_execute(s);
+        }
+        return;
+    }
+    s->cmd = v;
+    s->argc = 0;
+    s->nargs = ssd1306_nargs(v);
+    if (s->nargs) {
+        return;
+    }
+    if (v <= 0x0F) {                /* page mode: column low nibble */
+        s->col = (s->col & 0xF0) | v;
+    } else if (v <= 0x1F) {
+        s->col = (s->col & 0x0F) | (v & 7) << 4;
+    } else if (v >= 0x40 && v <= 0x7F) {
+        s->start_line = v & 0x3F;
+    } else if (v >= 0xB0 && v <= 0xB7) {
+        s->page = v & 7;
+    } else {
+        switch (v) {
+        case 0xA0: case 0xA1:
+            s->remap = v & 1;
+            break;
+        case 0xA4: case 0xA5:
+            s->all_on = v & 1;
+            break;
+        case 0xA6: case 0xA7:
+            s->inverse = v & 1;
+            break;
+        case 0xAE: case 0xAF:
+            s->display_on = v & 1;
+            break;
+        case 0xC0: case 0xC8:
+            s->com_reverse = v & 8;
+            break;
+        case 0x2E: case 0x2F:
+            if (v == 0x2F) {
+                qemu_log_mask(LOG_UNIMP, "ssd1306: scrolling is not "
+                              "modelled\n");
+            }
+            break;
+        default:
+            break;
+        }
+    }
+    pp_panel_changed(&s->panel);
+}
+
+static void ssd1306_data(Ssd1306State *s, uint8_t v)
+{
+    s->ram[s->page * SSD1306_COLS + s->col] = v;
+    pp_panel_changed(&s->panel);
+    switch (s->mode) {
+    case 0:                         /* horizontal: column, then page */
+        if (s->col++ >= s->col_end) {
+            s->col = s->col_start;
+            if (s->page++ >= s->page_end) {
+                s->page = s->page_start;
+            }
+        }
+        break;
+    case 1:                         /* vertical: page, then column */
+        if (s->page++ >= s->page_end) {
+            s->page = s->page_start;
+            if (s->col++ >= s->col_end) {
+                s->col = s->col_start;
+            }
+        }
+        break;
+    default:                        /* page: the column wraps in the page */
+        s->col = (s->col + 1) % SSD1306_COLS;
+        break;
+    }
+}
+
+static uint32_t ssd1306_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    Ssd1306State *s = SSD1306(dev);
+
+    if (s->in_reset) {
+        return 0;
+    }
+    if (s->dc) {
+        ssd1306_data(s, val);
+    } else {
+        ssd1306_command(s, val);
+    }
+    return 0;
+}
+
+/*
+ * The RAM line a common pin shows (-1: none): the pin's place in the scan
+ * (DAh layout), the scan direction and offset, the MUX ratio, the start
+ * line (data sheet tables 10-1 and 10-2)
+ */
+static int ssd1306_line(Ssd1306State *s, unsigned pin)
+{
+    unsigned rows = s->mux + 1;
+    int q, r;
+
+    if (s->com_alt) {
+        q = pin < 32 ? 2 * pin : 2 * (pin - 32) + 1;
+    } else {
+        q = pin;
+    }
+    if (s->com_reverse) {
+        r = (int)rows - 1 - ((q - s->offset + SSD1306_ROWS) % SSD1306_ROWS);
+    } else {
+        r = (q + s->offset) % SSD1306_ROWS;
+    }
+    if (r < 0 || r >= (int)rows) {
+        return -1;
+    }
+    return (r + s->start_line) % SSD1306_ROWS;
+}
+
+static void ssd1306_render(void *opaque, uint16_t *fb)
+{
+    Ssd1306State *s = opaque;
+    bool lit = s->display_on && s->pump && !s->in_reset;
+
+    for (unsigned y = 0; y < s->height; y++) {
+        unsigned pin = (y & 1) ? s->com_row1 - (y - 1) / 2
+                               : s->com_row0 - y / 2;
+        int line = ssd1306_line(s, pin);
+
+        for (unsigned x = 0; x < s->width; x++) {
+            unsigned seg = s->seg_left - x;
+            unsigned col = s->remap ? SSD1306_COLS - 1 - seg : seg;
+            bool on = false;
+
+            if (lit && line >= 0) {
+                on = s->all_on ||
+                     (s->ram[(line / 8) * SSD1306_COLS + col] >> (line % 8)
+                      & 1);
+                on ^= s->inverse && !s->all_on;
+            }
+            fb[y * s->width + x] = on ? s->color : 0;
+        }
+    }
+}
+
+static void ssd1306_set_dc(void *opaque, int n, int level)
+{
+    SSD1306(opaque)->dc = level > 0;
+}
+
+static void ssd1306_set_reset(void *opaque, int n, int level)
+{
+    Ssd1306State *s = opaque;
+    bool low = level == 0;
+
+    if (low && !s->in_reset) {
+        ssd1306_registers_reset(s);
+    }
+    s->in_reset = low;
+    pp_panel_changed(&s->panel);
+}
+
+static void ssd1306_realize(SSIPeripheral *dev, Error **errp)
+{
+    Ssd1306State *s = SSD1306(dev);
+
+    if (!s->width || !s->height || s->width > s->seg_left + 1 ||
+        s->seg_left >= SSD1306_COLS || s->com_row0 >= SSD1306_ROWS ||
+        s->com_row1 >= SSD1306_ROWS ||
+        (s->height + 1) / 2 > s->com_row0 + 1 ||
+        s->height / 2 > s->com_row1 + 1) {
+        error_setg(errp, "the panel must lie within SEG0-127 and COM0-63");
+        return;
+    }
+    s->panel.width = s->width;
+    s->panel.height = s->height;
+    g_free(s->panel.fb);
+    s->panel.fb = g_new0(uint16_t, s->width * s->height);
+    qdev_init_gpio_in_named(DEVICE(dev), ssd1306_set_dc, SSD1306_DC, 1);
+    qdev_init_gpio_in_named(DEVICE(dev), ssd1306_set_reset,
+                            SSD1306_RESET, 1);
+}
+
+static void ssd1306_reset(DeviceState *dev)
+{
+    Ssd1306State *s = SSD1306(dev);
+
+    ssd1306_registers_reset(s);
+    /* Power-on: RAM undefined (cleared here), CS high, RES# released */
+    memset(s->ram, 0, sizeof(s->ram));
+    s->parent_obj.cs = true;
+    s->in_reset = false;
+}
+
+static void ssd1306_init(Object *obj)
+{
+    Ssd1306State *s = SSD1306(obj);
+
+    pp_panel_init(&s->panel, obj, 1, 1, ssd1306_render, s);
+}
+
+static void ssd1306_finalize(Object *obj)
+{
+    g_free(SSD1306(obj)->panel.fb);
+}
+
+static int ssd1306_post_load(void *opaque, int version_id)
+{
+    pp_panel_changed(&SSD1306(opaque)->panel);
+    return 0;
+}
+
+static const Property ssd1306_properties[] = {
+    DEFINE_PROP_UINT32("width", Ssd1306State, width, 96),
+    DEFINE_PROP_UINT32("height", Ssd1306State, height, 39),
+    DEFINE_PROP_UINT32("seg-left", Ssd1306State, seg_left, 95),
+    DEFINE_PROP_UINT32("com-row0", Ssd1306State, com_row0, 19),
+    DEFINE_PROP_UINT32("com-row1", Ssd1306State, com_row1, 50),
+    DEFINE_PROP_UINT32("color", Ssd1306State, color, 0xFFFF),
+};
+
+static const VMStateDescription vmstate_ssd1306 = {
+    .name = TYPE_SSD1306,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = ssd1306_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, Ssd1306State),
+        VMSTATE_UINT8_ARRAY(ram, Ssd1306State,
+                            SSD1306_PAGES * SSD1306_COLS),
+        VMSTATE_UINT8(cmd, Ssd1306State),
+        VMSTATE_UINT8(nargs, Ssd1306State),
+        VMSTATE_UINT8(argc, Ssd1306State),
+        VMSTATE_UINT8_ARRAY(args, Ssd1306State, SSD1306_MAX_ARGS),
+        VMSTATE_UINT8(mode, Ssd1306State),
+        VMSTATE_UINT8(col_start, Ssd1306State),
+        VMSTATE_UINT8(col_end, Ssd1306State),
+        VMSTATE_UINT8(page_start, Ssd1306State),
+        VMSTATE_UINT8(page_end, Ssd1306State),
+        VMSTATE_UINT8(col, Ssd1306State),
+        VMSTATE_UINT8(page, Ssd1306State),
+        VMSTATE_BOOL(remap, Ssd1306State),
+        VMSTATE_BOOL(com_reverse, Ssd1306State),
+        VMSTATE_BOOL(com_alt, Ssd1306State),
+        VMSTATE_UINT8(start_line, Ssd1306State),
+        VMSTATE_UINT8(offset, Ssd1306State),
+        VMSTATE_UINT8(mux, Ssd1306State),
+        VMSTATE_BOOL(all_on, Ssd1306State),
+        VMSTATE_BOOL(inverse, Ssd1306State),
+        VMSTATE_BOOL(display_on, Ssd1306State),
+        VMSTATE_BOOL(pump, Ssd1306State),
+        VMSTATE_BOOL(dc, Ssd1306State),
+        VMSTATE_BOOL(in_reset, Ssd1306State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void ssd1306_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    dc->desc = "SSD1306 128x64 monochrome OLED driver";
+    dc->vmsd = &vmstate_ssd1306;
+    device_class_set_props(dc, ssd1306_properties);
+    device_class_set_legacy_reset(dc, ssd1306_reset);
+    k->realize = ssd1306_realize;
+    k->transfer = ssd1306_transfer;
+    k->cs_polarity = SSI_CS_LOW;
+}
+
+static const TypeInfo ssd1306_types[] = {
+    {
+        .name = TYPE_SSD1306,
+        .parent = TYPE_SSI_PERIPHERAL,
+        .instance_size = sizeof(Ssd1306State),
+        .instance_init = ssd1306_init,
+        .instance_finalize = ssd1306_finalize,
+        .class_init = ssd1306_class_init,
+    },
+};
+
+DEFINE_TYPES(ssd1306_types)
