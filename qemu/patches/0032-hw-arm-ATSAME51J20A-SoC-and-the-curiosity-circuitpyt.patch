+        { 0x00804000, 0xFE9A9239 },
+        /* USER row word 1 (production) */
+        { 0x00804004, 0xAEECFF80 },
+    };
+    const uint32_t base = ATSAME51J20A_NVMROWS_BASE;
+    unsigned i;
+
+    memset(buf, 0xFF, ATSAME51J20A_NVMROWS_SIZE);
+    for (i = 0; i < ARRAY_SIZE(words); i++) {
+        stl_le_p(buf + words[i].addr - base, words[i].value);
+    }
+    for (i = 0; i < 4; i++) {
+        stl_le_p(buf + atsame51j20a_serial_addr[i] - base, serial[i]);
+    }
+}
