new file mode 100644
index 0000000..275f338
--- /dev/null
+++ b/hw/block/sst26vf.c
@@ -0,0 +1,502 @@
+/*
+ * Microchip SST26VF016B/032B/064B serial quad I/O flash
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An SSI peripheral (chip select active low) with the SST26VF command set
+ * that firmware such as CircuitPython uses: JEDEC ID, status and
+ * configuration registers, write enable, reset, read (0x03), fast read
+ * (0x0B) and its dual (0x3B) and quad (0x6B) output forms, page program
+ * (0x02, 0x32), 4 KiB sector erase (0x20), block erase (0xD8: 64 KiB here),
+ * chip erase (0xC7) and the block protection register (0x72, 0x42, 0x98).
+ *
+ * The SSI bus moves one byte per transfer; the QSPI host decides how many
+ * bytes the dummy cycles take (fast reads expect one dummy byte). Like the
+ * part, the flash powers up with every block write-protected until ULBPR
+ * (0x98) or a WBPR of zeros. Operations finish at once (BUSY never reads 1).
+ *
+ * Contents come from the "drive" property (-drive if=mtd, raw, exactly the
+ * flash size); changes are written back sector by sector.
+ * Reference: DS20005218 (SST26VF032B/064B data sheet).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/units.h"
+#include "hw/block/block.h"
+#include "hw/block/sst26vf.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+#include "system/block-backend.h"
+#include "system/blockdev.h"
+
+#define SST26_SECTOR        (4 * KiB)
+#define SST26_PAGE          256
+#define SST26_BLOCK         (64 * KiB)
+#define SST26_BPR_BYTES     18          /* 032B; 064B has 18 too (+ more) */
+
+/* Commands (DS20005218 Table 5-1) */
+#define CMD_WRSR    0x01
+#define CMD_PP      0x02
+#define CMD_READ    0x03
+#define CMD_WRDI    0x04
+#define CMD_RDSR    0x05
+#define CMD_WREN    0x06
+#define CMD_FAST    0x0B
+#define CMD_SE      0x20
+#define CMD_SQPP    0x32
+#define CMD_RDCR    0x35
+#define CMD_SDOR    0x3B
+#define CMD_WBPR    0x42
+#define CMD_RSTEN   0x66
+#define CMD_SQOR    0x6B
+#define CMD_RBPR    0x72
+#define CMD_ULBPR   0x98
+#define CMD_RST     0x99
+#define CMD_JEDEC   0x9F
+#define CMD_WAKE    0xAB
+#define CMD_CE      0xC7
+#define CMD_BE      0xD8
+
+#define SR_BUSY     0x01
+#define SR_WEL      0x02
+
+typedef enum Sst26Phase {
+    SST26_IDLE,                 /* next byte is a command */
+    SST26_ADDR,                 /* collecting address bytes */
+    SST26_DUMMY,                /* skipping dummy bytes */
+    SST26_READ,                 /* streaming array data out */
+    SST26_PROGRAM,              /* page program data in */
+    SST26_REG_OUT,              /* streaming reg[] out */
+    SST26_REG_IN,               /* collecting reg[] (WRSR, WBPR) */
+    SST26_IGNORE,               /* rest of the transfer is ignored */
+} Sst26Phase;
+
+OBJECT_DECLARE_TYPE(Sst26Flash, Sst26Class, SST26VF)
+
+typedef struct Sst26Class {
+    SSIPeripheralClass parent_class;
+
+    uint8_t capacity_id;        /* third JEDEC ID byte */
+    uint32_t size;
+} Sst26Class;
+
+struct Sst26Flash {
+    SSIPeripheral parent_obj;
+
+    BlockBackend *blk;
+    uint8_t *storage;
+    uint32_t size;
+
+    uint8_t state;
+    uint8_t cmd;
+    uint8_t addr_bytes;         /* address bytes still to come */
+    uint8_t dummy;              /* dummy bytes still to come */
+    uint32_t addr;
+    uint8_t reg[SST26_BPR_BYTES];
+    uint8_t reg_len;
+    uint8_t reg_pos;
+
+    uint8_t status;
+    uint8_t config;
+    uint8_t bpr[SST26_BPR_BYTES];
+    bool reset_enabled;
+    int64_t dirty_sector;       /* sector to write back, -1: none */
+};
+
+
+static void sst26_sync(Sst26Flash *s, uint32_t off, uint32_t len)
+{
+    if (!s->blk || !blk_is_writable(s->blk)) {
+        return;
+    }
+    if (blk_pwrite(s->blk, off, len, s->storage + off, 0) < 0) {
+        qemu_log_mask(LOG_GUEST_ERROR, "sst26vf: write-back at 0x%" PRIx32
+                      " failed\n", off);
+    }
+}
+
+static void sst26_flush_dirty(Sst26Flash *s)
+{
+    if (s->dirty_sector >= 0) {
+        sst26_sync(s, s->dirty_sector * SST26_SECTOR, SST26_SECTOR);
+        s->dirty_sector = -1;
+    }
+}
+
+/* Any block protected? (The model keeps one global switch per BPR.) */
+static bool sst26_protected(Sst26Flash *s)
+{
+    for (unsigned i = 0; i < SST26_BPR_BYTES; i++) {
+        if (s->bpr[i]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool sst26_write_allowed(Sst26Flash *s, const char *what)
+{
+    if (!(s->status & SR_WEL)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "sst26vf: %s without WREN\n", what);
+        return false;
+    }
+    if (sst26_protected(s)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "sst26vf: %s while blocks are "
+                      "write-protected (no ULBPR)\n", what);
+        return false;
+    }
+    return true;
+}
+
+static void sst26_erase(Sst26Flash *s, uint32_t addr, uint32_t len)
+{
+    addr &= ~(len - 1);
+    if (addr >= s->size) {
+        return;
+    }
+    len = MIN(len, s->size - addr);
+    memset(s->storage + addr, 0xFF, len);
+    sst26_sync(s, addr, len);
+}
+
+static void sst26_reg_out(Sst26Flash *s, const uint8_t *data, unsigned len)
+{
+    memcpy(s->reg, data, len);
+    s->reg_len = len;
+    s->reg_pos = 0;
+    s->state = SST26_REG_OUT;
+}
+
+static void sst26_command(Sst26Flash *s, uint8_t cmd)
+{
+    Sst26Class *k = SST26VF_GET_CLASS(s);
+    uint8_t id[3] = { 0xBF, 0x26, k->capacity_id };
+
+    s->cmd = cmd;
+    s->state = SST26_IGNORE;
+    if (cmd != CMD_RST) {
+        s->reset_enabled = cmd == CMD_RSTEN;
+    }
+    switch (cmd) {
+    case CMD_READ:
+    case CMD_FAST:
+    case CMD_SDOR:
+    case CMD_SQOR:
+    case CMD_PP:
+    case CMD_SQPP:
+    case CMD_SE:
+    case CMD_BE:
+        s->addr = 0;
+        s->addr_bytes = 3;
+        s->state = SST26_ADDR;
+        break;
+    case CMD_JEDEC:
+        sst26_reg_out(s, id, sizeof(id));
+        break;
+    case CMD_RDSR:
+        sst26_reg_out(s, &s->status, 1);
+        s->reg_len = 0;         /* repeats the status register */
+        break;
+    case CMD_RDCR:
+        sst26_reg_out(s, &s->config, 1);
+        s->reg_len = 0;
+        break;
+    case CMD_RBPR:
+        sst26_reg_out(s, s->bpr, SST26_BPR_BYTES);
+        break;
+    case CMD_WREN:
+        s->status |= SR_WEL;
+        break;
+    case CMD_WRDI:
+        s->status &= ~SR_WEL;
+        break;
+    case CMD_WRSR:
+    case CMD_WBPR:
+        s->reg_len = cmd == CMD_WRSR ? 2 : SST26_BPR_BYTES;
+        s->reg_pos = 0;
+        s->state = SST26_REG_IN;
+        break;
+    case CMD_ULBPR:
+        if (s->status & SR_WEL) {
+            memset(s->bpr, 0, sizeof(s->bpr));
+            s->status &= ~SR_WEL;
+        }
+        break;
+    case CMD_CE:
+        if (sst26_write_allowed(s, "chip erase")) {
+            memset(s->storage, 0xFF, s->size);
+            sst26_sync(s, 0, s->size);
+            s->status &= ~SR_WEL;
+        }
+        break;
+    case CMD_RSTEN:
+    case CMD_WAKE:
+        break;
+    case CMD_RST:
+        if (s->reset_enabled) {
+            s->status = 0;
+            s->config = 0x08;   /* power-up configuration register value */
+        }
+        s->reset_enabled = false;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "sst26vf: command 0x%02x not modelled\n",
+                      cmd);
+        break;
+    }
+}
+
+/* All address bytes are in: start the data phase of s->cmd. */
+static void sst26_addressed(Sst26Flash *s)
+{
+    s->addr %= s->size;
+    switch (s->cmd) {
+    case CMD_READ:
+        s->state = SST26_READ;
+        break;
+    case CMD_FAST:
+    case CMD_SDOR:
+    case CMD_SQOR:
+        s->dummy = 1;           /* 8 dummy clocks on one line */
+        s->state = SST26_DUMMY;
+        break;
+    case CMD_PP:
+    case CMD_SQPP:
+        s->state = sst26_write_allowed(s, "page program") ? SST26_PROGRAM
+                                                          : SST26_IGNORE;
+        break;
+    case CMD_SE:
+        if (sst26_write_allowed(s, "sector erase")) {
+            sst26_erase(s, s->addr, SST26_SECTOR);
+            s->status &= ~SR_WEL;
+        }
+        s->state = SST26_IGNORE;
+        break;
+    case CMD_BE:
+        if (sst26_write_allowed(s, "block erase")) {
+            sst26_erase(s, s->addr, SST26_BLOCK);
+            s->status &= ~SR_WEL;
+        }
+        s->state = SST26_IGNORE;
+        break;
+    default:
+        s->state = SST26_IGNORE;
+        break;
+    }
+}
+
+static uint32_t sst26_transfer(SSIPeripheral *ss, uint32_t tx)
+{
+    Sst26Flash *s = SST26VF(ss);
+    uint8_t rx = 0xFF;
+
+    switch (s->state) {
+    case SST26_IDLE:
+        sst26_command(s, tx);
+        break;
+    case SST26_ADDR:
+        s->addr = s->addr << 8 | (tx & 0xFF);
+        if (--s->addr_bytes == 0) {
+            sst26_addressed(s);
+        }
+        break;
+    case SST26_DUMMY:
+        if (--s->dummy == 0) {
+            s->state = SST26_READ;
+        }
+        break;
+    case SST26_READ:
+        rx = s->storage[s->addr];
+        s->addr = (s->addr + 1) % s->size;
+        break;
+    case SST26_PROGRAM: {
+        uint32_t sector = s->addr / SST26_SECTOR;
+
+        if (s->dirty_sector >= 0 && s->dirty_sector != sector) {
+            sst26_flush_dirty(s);
+        }
+        s->storage[s->addr] &= tx;      /* programming clears bits only */
+        s->dirty_sector = sector;
+        /* The address wraps within the 256-byte page */
+        s->addr = (s->addr & ~(SST26_PAGE - 1)) |
+                  ((s->addr + 1) & (SST26_PAGE - 1));
+        break;
+    }
+    case SST26_REG_OUT:
+        if (s->reg_len == 0) {
+            rx = s->reg[0];             /* status/config repeat */
+        } else {
+            rx = s->reg[s->reg_pos];
+            s->reg_pos = (s->reg_pos + 1) % s->reg_len;
+        }
+        break;
+    case SST26_REG_IN:
+        if (s->reg_pos < s->reg_len) {
+            s->reg[s->reg_pos++] = tx;
+        }
+        break;
+    case SST26_IGNORE:
+    default:
+        break;
+    }
+    return rx;
+}
+
+/* Chip select released: a register write or a program completes. */
+static void sst26_deselect(Sst26Flash *s)
+{
+    if (s->state == SST26_REG_IN && (s->status & SR_WEL)) {
+        if (s->cmd == CMD_WRSR && s->reg_pos >= 2) {
+            s->config = (s->config & ~0x0A) | (s->reg[1] & 0x0A);
+        } else if (s->cmd == CMD_WBPR && s->reg_pos == SST26_BPR_BYTES) {
+            /* The BPR is sent most significant byte first */
+            for (unsigned i = 0; i < SST26_BPR_BYTES; i++) {
+                s->bpr[i] = s->reg[SST26_BPR_BYTES - 1 - i];
+            }
+        }
+        s->status &= ~SR_WEL;
+    }
+    if (s->state == SST26_PROGRAM) {
+        sst26_flush_dirty(s);
+        s->status &= ~SR_WEL;
+    }
+    s->state = SST26_IDLE;
+}
+
+/* @level: the chip select line (active low) */
+static int sst26_set_cs(SSIPeripheral *ss, bool level)
+{
+    Sst26Flash *s = SST26VF(ss);
+
+    if (level) {
+        sst26_deselect(s);
+    } else {
+        s->state = SST26_IDLE;
+    }
+    return 0;
+}
+
+static void sst26_realize(SSIPeripheral *ss, Error **errp)
+{
+    Sst26Flash *s = SST26VF(ss);
+    Sst26Class *k = SST26VF_GET_CLASS(s);
+
+    s->size = k->size;
+    if (s->blk) {
+        uint64_t perm = BLK_PERM_CONSISTENT_READ |
+                        (blk_supports_write_perm(s->blk) ? BLK_PERM_WRITE : 0);
+
+        if (blk_set_perm(s->blk, perm, BLK_PERM_ALL, errp) < 0) {
+            return;
+        }
+        s->storage = blk_blockalign(s->blk, s->size);
+        if (!blk_check_size_and_read_all(s->blk, DEVICE(s), s->storage,
+                                         s->size, errp)) {
+            return;
+        }
+    } else {
+        s->storage = blk_blockalign(NULL, s->size);
+        memset(s->storage, 0xFF, s->size);
+    }
+}
+
+static void sst26_reset(DeviceState *dev)
+{
+    Sst26Flash *s = SST26VF(dev);
+
+    s->state = SST26_IDLE;
+    s->status = 0;
+    s->config = 0x08;           /* power-up configuration register value */
+    memset(s->bpr, 0xFF, sizeof(s->bpr));   /* all blocks protected */
+    s->reset_enabled = false;
+    s->dirty_sector = -1;
+}
+
+static const Property sst26_properties[] = {
+    DEFINE_PROP_DRIVE("drive", Sst26Flash, blk),
+};
+
+static const VMStateDescription vmstate_sst26 = {
+    .name = "sst26vf",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8(state, Sst26Flash),
+        VMSTATE_UINT8(cmd, Sst26Flash),
+        VMSTATE_UINT8(addr_bytes, Sst26Flash),
+        VMSTATE_UINT8(dummy, Sst26Flash),
+        VMSTATE_UINT32(addr, Sst26Flash),
+        VMSTATE_UINT8_ARRAY(reg, Sst26Flash, SST26_BPR_BYTES),
+        VMSTATE_UINT8(reg_len, Sst26Flash),
+        VMSTATE_UINT8(reg_pos, Sst26Flash),
+        VMSTATE_UINT8(status, Sst26Flash),
+        VMSTATE_UINT8(config, Sst26Flash),
+        VMSTATE_UINT8_ARRAY(bpr, Sst26Flash, SST26_BPR_BYTES),
+        VMSTATE_BOOL(reset_enabled, Sst26Flash),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void sst26_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = sst26_realize;
+    k->transfer = sst26_transfer;
+    k->set_cs = sst26_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    dc->vmsd = &vmstate_sst26;
+    device_class_set_legacy_reset(dc, sst26_reset);
+    device_class_set_props(dc, sst26_properties);
+    set_bit(DEVICE_CATEGORY_STORAGE, dc->categories);
+}
+
+static void sst26_variant_class_init(ObjectClass *klass, const void *data)
+{
+    Sst26Class *sc = SST26VF_CLASS(klass);
+    const uint32_t *variant = data;
+
+    sc->capacity_id = variant[0];
