+/* OSC32KCTRL U2400 */
+
+OBJECT_DECLARE_SIMPLE_TYPE(Same5xOsc32kctrlState, MCHP_SAME5X_OSC32KCTRL)
+
+struct Same5xOsc32kctrlState {
+    MchpRegBlock parent_obj;
+
+    Clock *xtal32k;
+    Clock *xosc32k;
+    Clock *osculp32k;
+    Clock *rtc;                     /* CLK_RTC_OSC (RTCCTRL.RTCSEL) */
+
+    uint32_t status;
+};
+
+/* RTCCTRL.RTCSEL (DS60001507 OSC32KCTRL.RTCCTRL) */
+#define SAME5X_RTCSEL_ULP1K     0
+#define SAME5X_RTCSEL_ULP32K    1
+#define SAME5X_RTCSEL_XOSC1K    4
+#define SAME5X_RTCSEL_XOSC32K   5
+
+static uint32_t same5x_osc32k_status(Same5xOsc32kctrlState *s)
+{
+    uint32_t xosc = same5x_reg(MCHP_REGBLOCK(s), A_MCHP_OSC32KCTRL_XOSC32K, 2);
+
+    if (FIELD_EX32(xosc, MCHP_OSC32KCTRL_XOSC32K, ENABLE) &&
+        clock_get_hz(s->xtal32k)) {
+        return R_MCHP_OSC32KCTRL_STATUS_XOSC32KRDY_MASK;
+    }
+    return 0;
+}
+
+static uint64_t same5x_osc32k_rtc_hz(Same5xOsc32kctrlState *s, uint32_t status)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ulp = same5x_reg(rb, A_MCHP_OSC32KCTRL_OSCULP32K, 4);
+    uint32_t xosc = same5x_reg(rb, A_MCHP_OSC32KCTRL_XOSC32K, 2);
+    bool xosc_on = status & R_MCHP_OSC32KCTRL_STATUS_XOSC32KRDY_MASK;
+    uint64_t xhz = clock_get_hz(s->xtal32k);
+
+    switch (FIELD_EX32(same5x_reg(rb, A_MCHP_OSC32KCTRL_RTCCTRL, 1),
+                       MCHP_OSC32KCTRL_RTCCTRL, RTCSEL)) {
+    case SAME5X_RTCSEL_ULP1K:
+        return FIELD_EX32(ulp, MCHP_OSC32KCTRL_OSCULP32K, EN1K) ?
+               SAME5X_OSC32K_HZ / 32 : 0;
+    case SAME5X_RTCSEL_ULP32K:
+        return FIELD_EX32(ulp, MCHP_OSC32KCTRL_OSCULP32K, EN32K) ?
+               SAME5X_OSC32K_HZ : 0;
+    case SAME5X_RTCSEL_XOSC1K:
+        return xosc_on && FIELD_EX32(xosc, MCHP_OSC32KCTRL_XOSC32K, EN1K) ?
+               xhz / 32 : 0;
+    case SAME5X_RTCSEL_XOSC32K:
+        return xosc_on && FIELD_EX32(xosc, MCHP_OSC32KCTRL_XOSC32K, EN32K) ?
+               xhz : 0;
+    default:
+        return 0;
+    }
+}
+
+static void same5x_osc32k_update(Same5xOsc32kctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t xosc = same5x_reg(rb, A_MCHP_OSC32KCTRL_XOSC32K, 2);
+    uint32_t ulp = same5x_reg(rb, A_MCHP_OSC32KCTRL_OSCULP32K, 4);
+    uint32_t status = same5x_osc32k_status(s);
+
+    same5x_raise_flags(rb, status & ~s->status);
+    s->status = status;
+    mchp_regblock_set_clock(rb, s->xosc32k,
+        status && FIELD_EX32(xosc, MCHP_OSC32KCTRL_XOSC32K, EN32K) ?
+        clock_get_hz(s->xtal32k) : 0);
+    mchp_regblock_set_clock(rb, s->osculp32k,
+        FIELD_EX32(ulp, MCHP_OSC32KCTRL_OSCULP32K, EN32K) ?
+        SAME5X_OSC32K_HZ : 0);
+    mchp_regblock_set_clock(rb, s->rtc, same5x_osc32k_rtc_hz(s, status));
+    mchp_regblock_update_irq(rb);
+}
+
+static void same5x_osc32k_clk_update(void *opaque, ClockEvent event)
+{
+    same5x_osc32k_update(MCHP_SAME5X_OSC32KCTRL(opaque));
+}
+
+static uint32_t same5x_osc32k_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                       unsigned idx, uint32_t stored,
+                                       bool side_effects)
+{
+    if (ri->offset == A_MCHP_OSC32KCTRL_STATUS) {
+        return same5x_osc32k_status(MCHP_SAME5X_OSC32KCTRL(rf->opaque));
+    }
+    return stored;
+}
+
+static void same5x_osc32k_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                     unsigned idx, uint32_t old,
+                                     uint32_t written, uint32_t we)
+{
+    Same5xOsc32kctrlState *s = MCHP_SAME5X_OSC32KCTRL(rf->opaque);
+    uint32_t lock = 0;
+
+    if (ri->offset == A_MCHP_OSC32KCTRL_XOSC32K) {
+        lock = R_MCHP_OSC32KCTRL_XOSC32K_WRTLOCK_MASK;
+    } else if (ri->offset == A_MCHP_OSC32KCTRL_OSCULP32K) {
+        lock = R_MCHP_OSC32KCTRL_OSCULP32K_WRTLOCK_MASK;
+    }
+    if (old & lock) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.%s: write while WRTLOCK is set"
+                      " (ignored)\n", MCHP_REGBLOCK(s)->name, ri->name);
+        mchp_regfile_set(rf, ri, idx, old);
+    }
+    same5x_osc32k_update(s);
+}
+
+static void same5x_osc32k_reset_hold(MchpRegBlock *rb)
+{
+    Same5xOsc32kctrlState *s = MCHP_SAME5X_OSC32KCTRL(rb);
+
+    s->status = same5x_osc32k_status(s);
+}
+
+static void same5x_osc32k_reset_exit(MchpRegBlock *rb)
+{
+    same5x_osc32k_update(MCHP_SAME5X_OSC32KCTRL(rb));
+}
+
+static void same5x_osc32k_init(Object *obj)
+{
+    Same5xOsc32kctrlState *s = MCHP_SAME5X_OSC32KCTRL(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    s->xtal32k = qdev_init_clock_in(dev, "xtal32k", same5x_osc32k_clk_update,
+                                    s, ClockUpdate);
+    s->xosc32k = qdev_init_clock_out(dev, "xosc32k");
+    s->osculp32k = qdev_init_clock_out(dev, "osculp32k");
+    s->rtc = qdev_init_clock_out(dev, "rtc");
+}
+
+static const VMStateDescription vmstate_same5x_osc32k = {
+    .name = TYPE_MCHP_SAME5X_OSC32KCTRL,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, Same5xOsc32kctrlState, 1,
+                       vmstate_mchp_regblock, MchpRegBlock),
+        VMSTATE_CLOCK(xtal32k, Same5xOsc32kctrlState),
+        VMSTATE_CLOCK(xosc32k, Same5xOsc32kctrlState),
+        VMSTATE_CLOCK(osculp32k, Same5xOsc32kctrlState),
+        VMSTATE_CLOCK(rtc, Same5xOsc32kctrlState),
+        VMSTATE_UINT32(status, Same5xOsc32kctrlState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void same5x_osc32k_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_same5x_osc32k;
+    c->pre_read = same5x_osc32k_pre_read;
+    c->post_write = same5x_osc32k_post_write;
+    c->reset_hold = same5x_osc32k_reset_hold;
+    c->reset_exit = same5x_osc32k_reset_exit;
+    c->por_only = true;             /* the 32 kHz domain survives resets */
+    c->log_writes = false;
+}
