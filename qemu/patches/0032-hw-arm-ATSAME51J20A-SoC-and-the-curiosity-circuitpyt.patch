@@ -0,0 +1,24 @@
+/*
+ * Microchip SAM D5x/E5x QSPI controller (QSPI U2008)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An mchp-regblock with an SSI bus "<inst>.qspi" for the serial memory
+ * (one byte per transfer whatever the line width) and the GPIO output
+ * "cs" (active low) for its chip select. sysbus MMIO 1 is the 16 MiB
+ * memory window (0x04000000 on the SAM E51) that serial memory mode reads
+ * and writes through.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SSI_MCHP_QSPI_H
+#define HW_SSI_MCHP_QSPI_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_QSPI "mchp-qspi"
+#define MCHP_QSPI_CS "cs"
+
+#endif /* HW_SSI_MCHP_QSPI_H */
diff --git a/tests/qtest/curiosity-cp-test.c b/tests/qtest/curiosity-cp-test.c
new file mode 100644
index 0000000..f94df7a
--- /dev/null
+++ b/tests/qtest/curiosity-cp-test.c
@@ -0,0 +1,232 @@
+/*
+ * QTest for the Curiosity CircuitPython machine (curiosity-circuitpython)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * ATSAME51J20A identity, the SAM D5x clock tree up to the 120 MHz CircuitPython
+ * uses, NVIC lines of a multi-line SERCOM, the board's LED and USER button,
+ * the SST26VF032B behind the QSPI controller, the TRNG and the USB
+ * controller's software reset handshake.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M curiosity-circuitpython "
+
+#define OSCCTRL         0x40001000
+#define OSC32KCTRL      0x40001400
+#define GCLK            0x40001C00
+#define USB             0x41000000
+#define DSU             0x41002000
+#define NVMCTRL         0x41004000
+#define PORT            0x41008000
+#define TRNG            0x42002800
+#define QSPI            0x42003400
+#define QSPI_AHB        0x04000000
+#define SCB_CPUID       0xE000ED00
+
+#define PA              (PORT + 0x00)
+#define PB              (PORT + 0x80)
+#define P_DIRSET        0x08
+#define P_OUTSET        0x18
+#define P_OUTCLR        0x14
+#define P_IN            0x20
+#define P_PINCFG        0x40
+
+#define DPLL0           (OSCCTRL + 0x30)
+
+static uint64_t clock_hz(QTestState *qts, const char *path)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': %s,"
+                           " 'property': 'qtest-clock-period' } }", path);
+    uint64_t period;
+
+    g_assert(qdict_haskey(rsp, "return"));
+    period = qdict_get_int(rsp, "return");
+    qobject_unref(rsp);
+    return period ? (1000000000ULL << 32) / period : 0;
+}
+
+static void test_identity(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* ATDF signature: SAM E51J20A rev D; Cortex-M4 r0p1 */
+    g_assert_cmphex(qtest_readl(qts, DSU + 0x18), ==, 0x61810304);
+    g_assert_cmphex(qtest_readl(qts, SCB_CPUID), ==, 0x410FC241);
+    /* 2048 pages of 512 bytes */
+    g_assert_cmphex(qtest_readl(qts, NVMCTRL + 0x08), ==, 0x00060800);
+    g_assert_cmphex(qtest_readw(qts, NVMCTRL + 0x12) & 1, ==, 1);
+    /* Serial number of the kit on the desk (CircuitPython UID) */
+    g_assert_cmphex(qtest_readl(qts, 0x008061FC), ==, 0x0004E5F3);
+    g_assert_cmphex(qtest_readl(qts, 0x00806018), ==, 0xFF103621);
+    qtest_quit(qts);
+}
+
+static void test_clocks(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* GCLK0 runs from the DFLL48M in open loop out of reset */
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/mclk/cpu"), ==, 48000000);
+
+    /* XOSC32K with the board's crystal */
+    qtest_writew(qts, OSC32KCTRL + 0x14, 0x208E);   /* CGM1 EN32K XTALEN EN */
+    g_assert_cmphex(qtest_readl(qts, OSC32KCTRL + 0x0C) & 1, ==, 1);
+
+    /* GCLK5 = DFLL / 24 -> DPLL0 x 60 = 120 MHz -> GCLK0 */
+    qtest_writel(qts, GCLK + 0x20 + 4 * 5, 0x00180106);
+    qtest_writel(qts, GCLK + 0x80 + 4 * 1, 0x45);   /* FDPLL0: GCLK5 */
+    qtest_writel(qts, DPLL0 + 0x04, 59);            /* LDR */
+    qtest_writel(qts, DPLL0 + 0x08, 0);             /* REFCLK GCLK */
+    g_assert_cmphex(qtest_readl(qts, DPLL0 + 0x10), ==, 0);
+    qtest_writeb(qts, DPLL0 + 0x00, 0x02);          /* ENABLE */
+    g_assert_cmphex(qtest_readl(qts, DPLL0 + 0x10), ==, 0x3);
+    g_assert_cmphex(qtest_readl(qts, OSCCTRL + 0x10) & (1 << 16), !=, 0);
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/oscctrl/dpll0"), ==,
+                     120000000);
+    qtest_writel(qts, GCLK + 0x20, 0x00010107);     /* GCLK0 from DPLL0 */
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/mclk/cpu"), ==, 120000000);
+    qtest_quit(qts);
+}
+
+static void test_led_user(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* LED D13 on PB23, active high */
+    qtest_writeb(qts, PB + P_PINCFG + 23, 0x02);    /* INEN: IN follows */
+    qtest_writel(qts, PB + P_DIRSET, 1u << 23);
+    qtest_writel(qts, PB + P_OUTSET, 1u << 23);
+    g_assert_cmphex(qtest_readl(qts, PB + P_IN) & (1u << 23), !=, 0);
+
+    /* USER on PA27: R20 pulls it high; pressed reads low */
+    qtest_writeb(qts, PA + P_PINCFG + 27, 0x02);    /* INEN */
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & (1u << 27), !=, 0);
+    qtest_qom_set_bool(qts, "/machine", "user-pressed", true);
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & (1u << 27), ==, 0);
+    qtest_qom_set_bool(qts, "/machine", "user-pressed", false);
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & (1u << 27), !=, 0);
+    qtest_quit(qts);
+}
+
+/* One serial-memory-mode instruction frame, as CircuitPython sends them */
+static void qspi_frame(QTestState *qts, uint8_t instr, uint32_t frame,
+                       uint32_t addr)
+{
+    qtest_writel(qts, QSPI + 0x34, instr);
+    qtest_writel(qts, QSPI + 0x30, addr);
+    qtest_writel(qts, QSPI + 0x38, frame);
+    qtest_readl(qts, QSPI + 0x38);
+}
+
+static void qspi_end(QTestState *qts)
+{
+    qtest_writel(qts, QSPI + 0x00, 0x01000002);     /* ENABLE | LASTXFER */
+    g_assert_cmphex(qtest_readl(qts, QSPI + 0x1C) & (1 << 10), !=, 0);
+    qtest_writel(qts, QSPI + 0x1C, 1 << 10);
+}
+
+#define FRAME_CMD       0x00000010      /* INSTREN, READ */
+#define FRAME_READ      0x00000090      /* INSTREN DATAEN, READ */
+#define FRAME_ERASE     0x00002030      /* INSTREN ADDREN, WRITE */
+#define FRAME_PROGRAM   0x000030B0      /* INSTREN ADDREN DATAEN, WRITEMEM */
+#define FRAME_QREAD     0x000810B2      /* quad output, READMEM, 8 dummy */
+
+static void test_qspi_flash(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, QSPI + 0x04, 0x00000011);     /* MEMORY, LASTXFER CS */
+    qtest_writel(qts, QSPI + 0x00, 0x00000002);     /* ENABLE */
+
+    /* JEDEC ID of the SST26VF032B */
+    qspi_frame(qts, 0x9F, FRAME_READ, 0);
+    g_assert_cmphex(qtest_readb(qts, QSPI_AHB + 0), ==, 0xBF);
+    g_assert_cmphex(qtest_readb(qts, QSPI_AHB + 1), ==, 0x26);
+    g_assert_cmphex(qtest_readb(qts, QSPI_AHB + 2), ==, 0x42);
+    qspi_end(qts);
+
+    /* Blocks are write-protected until ULBPR */
+    qspi_frame(qts, 0x06, FRAME_CMD, 0);
+    qspi_end(qts);
+    qspi_frame(qts, 0x02, FRAME_PROGRAM, 0);
+    qtest_writel(qts, QSPI_AHB + 0x100, 0x12345678);
+    qspi_end(qts);
+    qspi_frame(qts, 0x6B, FRAME_QREAD, 0);
+    g_assert_cmphex(qtest_readl(qts, QSPI_AHB + 0x100), ==, 0xFFFFFFFF);
+    qspi_end(qts);
+
+    qspi_frame(qts, 0x06, FRAME_CMD, 0);
+    qspi_end(qts);
+    qspi_frame(qts, 0x98, FRAME_CMD, 0);            /* ULBPR */
+    qspi_end(qts);
+    qspi_frame(qts, 0x06, FRAME_CMD, 0);
+    qspi_end(qts);
+    qspi_frame(qts, 0x02, FRAME_PROGRAM, 0);
+    qtest_writel(qts, QSPI_AHB + 0x100, 0x12345678);
+    qtest_writel(qts, QSPI_AHB + 0x104, 0x9ABCDEF0);
+    qspi_end(qts);
+    qspi_frame(qts, 0x6B, FRAME_QREAD, 0);
+    g_assert_cmphex(qtest_readl(qts, QSPI_AHB + 0x100), ==, 0x12345678);
+    g_assert_cmphex(qtest_readl(qts, QSPI_AHB + 0x104), ==, 0x9ABCDEF0);
+    /* A non-sequential access starts a new read there */
+    g_assert_cmphex(qtest_readl(qts, QSPI_AHB + 0x100), ==, 0x12345678);
+    qspi_end(qts);
+
+    /* Sector erase */
+    qspi_frame(qts, 0x06, FRAME_CMD, 0);
+    qspi_end(qts);
+    qspi_frame(qts, 0x20, FRAME_ERASE, 0x000000);
+    qspi_end(qts);
+    qspi_frame(qts, 0x6B, FRAME_QREAD, 0);
+    g_assert_cmphex(qtest_readl(qts, QSPI_AHB + 0x100), ==, 0xFFFFFFFF);
+    qspi_end(qts);
+    qtest_quit(qts);
+}
+
+static void test_trng(void)
+{
+    QTestState *qts = qtest_init(MACHINE "-seed 1");
+    uint32_t a, b;
+
+    g_assert_cmphex(qtest_readb(qts, TRNG + 0x0A), ==, 0);
+    qtest_writeb(qts, TRNG + 0x00, 0x02);           /* ENABLE */
+    g_assert_cmphex(qtest_readb(qts, TRNG + 0x0A), ==, 1);
+    a = qtest_readl(qts, TRNG + 0x20);
+    b = qtest_readl(qts, TRNG + 0x20);
+    g_assert_cmphex(a, !=, b);
+    qtest_quit(qts);
+}
+
+static void test_usb_reset(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* SWRST: SYNCBUSY.SWRST reads 1 once, then 0 (TinyUSB waits for both) */
+    qtest_writeb(qts, USB + 0x00, 0x01);
+    g_assert_cmphex(qtest_readb(qts, USB + 0x02) & 1, ==, 1);
+    g_assert_cmphex(qtest_readb(qts, USB + 0x02) & 1, ==, 0);
+    /* Detached out of reset */
+    g_assert_cmphex(qtest_readw(qts, USB + 0x08) & 1, ==, 1);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("curiosity-cp/identity", test_identity);
+    qtest_add_func("curiosity-cp/clocks", test_clocks);
+    qtest_add_func("curiosity-cp/led-user", test_led_user);
+    qtest_add_func("curiosity-cp/qspi-flash", test_qspi_flash);
+    qtest_add_func("curiosity-cp/trng", test_trng);
+    qtest_add_func("curiosity-cp/usb-reset", test_usb_reset);
+    return g_test_run();
+}
