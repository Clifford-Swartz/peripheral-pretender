+/* MCLK U2408 */
+
+OBJECT_DECLARE_SIMPLE_TYPE(Same5xMclkState, MCHP_SAME5X_MCLK)
+
+struct Same5xMclkState {
+    MchpRegBlock parent_obj;
+
+    Clock *main;
+    Clock *cpu;
+};
+
+static void same5x_mclk_update(Same5xMclkState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t div = same5x_reg(rb, A_MCHP_MCLK_CPUDIV, 1);
+
+    mchp_regblock_set_clock(rb, s->cpu, div ? clock_get_hz(s->main) / div : 0);
+}
+
+static void same5x_mclk_clk_update(void *opaque, ClockEvent event)
+{
+    same5x_mclk_update(MCHP_SAME5X_MCLK(opaque));
+}
+
+/* CPUDIV takes powers of two up to 128; CKRDY sets again. */
+static void same5x_mclk_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                   unsigned idx, uint32_t old,
+                                   uint32_t written, uint32_t we)
+{
+    Same5xMclkState *s = MCHP_SAME5X_MCLK(rf->opaque);
+    uint32_t div = mchp_regfile_get(rf, ri, idx);
+
+    if (ri->offset != A_MCHP_MCLK_CPUDIV) {
+        return;
+    }
+    if (!is_power_of_2(div) || div > 128) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.CPUDIV: reserved value 0x%" PRIx32
+                      " (ignored)\n", MCHP_REGBLOCK(s)->name, div);
+        mchp_regfile_set(rf, ri, idx, old);
+    }
+    same5x_raise_flags(MCHP_REGBLOCK(s), R_MCHP_MCLK_INTFLAG_CKRDY_MASK);
+    same5x_mclk_update(s);
+}
+
+static void same5x_mclk_reset_exit(MchpRegBlock *rb)
+{
+    same5x_mclk_update(MCHP_SAME5X_MCLK(rb));
+}
+
+static void same5x_mclk_init(Object *obj)
+{
+    Same5xMclkState *s = MCHP_SAME5X_MCLK(obj);
+
+    s->main = qdev_init_clock_in(DEVICE(obj), "gclk-main",
+                                 same5x_mclk_clk_update, s, ClockUpdate);
+    s->cpu = qdev_init_clock_out(DEVICE(obj), "cpu");
+}
