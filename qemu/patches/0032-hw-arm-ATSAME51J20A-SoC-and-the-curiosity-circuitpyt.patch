+     */
+    uint32_t (*irq_lines)(MchpRegBlock *s);
     /* Called after the registers are reset (system reset and SWRST) */
     void (*reset_hold)(MchpRegBlock *s);
     /* Called after reset_hold, may update outputs such as clocks */
