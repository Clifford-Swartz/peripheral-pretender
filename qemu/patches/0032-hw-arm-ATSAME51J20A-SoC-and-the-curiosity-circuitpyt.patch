diff --git a/hw/misc/mchp_same5x.c b/hw/misc/mchp_same5x.c
new file mode 100644
index 0000000..d11570d
--- /dev/null
+++ b/hw/misc/mchp_same5x.c
@@ -0,0 +1,755 @@
+/*
+ * Microchip SAM D5x/E5x system controllers: OSCCTRL U2401, OSC32KCTRL
+ * U2400, MCLK U2408 and NVMCTRL U2409
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The clock tree of the SAM D5x/E5x (DS60001507 chapters GCLK, MCLK,
+ * OSCCTRL and OSC32KCTRL):
+ *
+ *   crystals -> OSCCTRL    (XOSC0, XOSC1, DFLL48M, FDPLL0, FDPLL1) --+
+ *               OSC32KCTRL (XOSC32K, OSCULP32K) ---------------------+->
+ *   GCLK generators (mchp-gclk) -> peripheral channels -> peripherals
+ *   GCLK generator 0 -> MCLK (/ CPUDIV) -> armv7m cpuclk
+ *
+ * As on the PIC32CM models (mchp_clock.c), oscillators are ready as soon as
+ * they are enabled, the PLLs lock as soon as they have a reference and
+ * synchronization is instant. The DFLL48M gives 48 MHz in open loop and
+ * MUL times its reference in closed loop.
+ *
+ * NVMCTRL: READY at once, commands complete instantly; flash erase and
+ * write through the page buffer (CircuitPython's microcontroller.nvm and
+ * internal flash storage) are not modelled yet and are logged.
+ *
+ * TRNG U2242: DATARDY whenever enabled; each DATA read returns a new word
+ * from QEMU's guest random source (-seed makes runs repeatable).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/mchp/gen/mclk_u2408.h"
+#include "hw/mchp/gen/nvmctrl_u2409.h"
+#include "hw/mchp/gen/osc32kctrl_u2400.h"
+#include "hw/mchp/gen/oscctrl_u2401.h"
+#include "hw/mchp/gen/trng_u2242.h"
+#include "hw/misc/mchp_sysctrl.h"
+#include "migration/vmstate.h"
+#include "qemu/guest-random.h"
+
+#define SAME5X_DFLL_HZ      48000000
+#define SAME5X_OSC32K_HZ    32768
+#define SAME5X_NDPLL        MCHP_OSCCTRL_DPLL_COUNT
+#define SAME5X_NXOSC        MCHP_OSCCTRL_XOSCCTRL_COUNT
+
+/* Same settling scheme as mchp_clock.c: the clock graph can loop. */
+#define SAME5X_CLK_MAX_PASSES 8
+
+typedef struct Same5xClkSettle {
+    bool busy;
+    bool dirty;
+} Same5xClkSettle;
+
+static void same5x_clk_settle(MchpRegBlock *s, Same5xClkSettle *st,
+                              void (*compute)(MchpRegBlock *s))
+{
+    if (st->busy) {
+        st->dirty = true;
+        return;
+    }
+    st->busy = true;
+    for (int pass = 0; pass < SAME5X_CLK_MAX_PASSES; pass++) {
+        st->dirty = false;
+        compute(s);
+        if (!st->dirty) {
+            break;
+        }
+    }
+    if (st->dirty) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: clock configuration loops and does not settle\n",
+                      s->name);
+    }
+    st->busy = false;
+}
+
+static uint32_t same5x_reg(MchpRegBlock *s, hwaddr offset, unsigned size)
+{
+    return mchp_regfile_peek(&s->rf, offset, size);
+}
+
+static void same5x_raise_flags(MchpRegBlock *s, uint32_t flags)
+{
+    if (flags && s->intflag) {
+        mchp_regfile_set(&s->rf, s->intflag, 0,
+                         mchp_regfile_get(&s->rf, s->intflag, 0) | flags);
+    }
+}
+
+/* OSCCTRL U2401 */
+
+OBJECT_DECLARE_SIMPLE_TYPE(Same5xOscctrlState, MCHP_SAME5X_OSCCTRL)
+
+struct Same5xOscctrlState {
+    MchpRegBlock parent_obj;
+
+    Clock *xtal[SAME5X_NXOSC];
+    Clock *ref_xosc32k;
+    Clock *ref_dfll;                /* GCLK_DFLL48 channel (closed loop) */
+    Clock *ref_gclk[SAME5X_NDPLL];  /* GCLK_FDPLLn channels */
+    Clock *xosc[SAME5X_NXOSC];
+    Clock *dfll;
+    Clock *dpll[SAME5X_NDPLL];
+
+    uint32_t status;                /* STATUS when last updated */
+    Same5xClkSettle settle;
+};
+
+static hwaddr same5x_dpll_reg(unsigned n, hwaddr reg)
+{
+    return MCHP_OSCCTRL_DPLL_OFFSET + n * MCHP_OSCCTRL_DPLL_STRIDE + reg;
+}
+
+static uint64_t same5x_xosc_hz(Same5xOscctrlState *s, unsigned n)
+{
+    uint32_t ctrl = same5x_reg(MCHP_REGBLOCK(s),
+                               A_MCHP_OSCCTRL_XOSCCTRL + 4 * n, 4);
+
+    return FIELD_EX32(ctrl, MCHP_OSCCTRL_XOSCCTRL, ENABLE) ?
+           clock_get_hz(s->xtal[n]) : 0;
+}
+
+static uint64_t same5x_dfll_hz(Same5xOscctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ctrla = same5x_reg(rb, A_MCHP_OSCCTRL_DFLLCTRLA, 1);
+    uint32_t ctrlb = same5x_reg(rb, A_MCHP_OSCCTRL_DFLLCTRLB, 1);
+    uint32_t mul = same5x_reg(rb, A_MCHP_OSCCTRL_DFLLMUL, 4);
+    uint64_t ref = clock_get_hz(s->ref_dfll);
+
+    if (!FIELD_EX32(ctrla, MCHP_OSCCTRL_DFLLCTRLA, ENABLE)) {
+        return 0;
+    }
+    /* Closed loop with a reference (USB clock recovery: open loop here) */
+    if (FIELD_EX32(ctrlb, MCHP_OSCCTRL_DFLLCTRLB, MODE) &&
+        !FIELD_EX32(ctrlb, MCHP_OSCCTRL_DFLLCTRLB, USBCRM) && ref &&
+        FIELD_EX32(mul, MCHP_OSCCTRL_DFLLMUL, MUL)) {
+        return ref * FIELD_EX32(mul, MCHP_OSCCTRL_DFLLMUL, MUL);
+    }
+    return SAME5X_DFLL_HZ;
+}
+
+static uint64_t same5x_dpll_ref_hz(Same5xOscctrlState *s, unsigned n)
+{
+    uint32_t ctrlb = same5x_reg(MCHP_REGBLOCK(s),
+                                same5x_dpll_reg(n, A_MCHP_OSCCTRL_DPLL_DPLLCTRLB),
+                                4);
+    uint32_t div = FIELD_EX32(ctrlb, MCHP_OSCCTRL_DPLL_DPLLCTRLB, DIV);
+
+    switch (FIELD_EX32(ctrlb, MCHP_OSCCTRL_DPLL_DPLLCTRLB, REFCLK)) {
+    case MCHP_OSCCTRL_DPLL_DPLLCTRLB_REFCLK_GCLK:
+        return clock_get_hz(s->ref_gclk[n]);
+    case MCHP_OSCCTRL_DPLL_DPLLCTRLB_REFCLK_XOSC32:
+        return clock_get_hz(s->ref_xosc32k);
+    case MCHP_OSCCTRL_DPLL_DPLLCTRLB_REFCLK_XOSC0:
+        return same5x_xosc_hz(s, 0) / (2 * (div + 1));
+    case MCHP_OSCCTRL_DPLL_DPLLCTRLB_REFCLK_XOSC1:
+        return same5x_xosc_hz(s, 1) / (2 * (div + 1));
+    default:
+        return 0;
+    }
+}
+
+static bool same5x_dpll_locked(Same5xOscctrlState *s, unsigned n)
+{
+    uint32_t ctrla = same5x_reg(MCHP_REGBLOCK(s),
+                                same5x_dpll_reg(n, A_MCHP_OSCCTRL_DPLL_DPLLCTRLA),
+                                1);
+
+    return FIELD_EX32(ctrla, MCHP_OSCCTRL_DPLL_DPLLCTRLA, ENABLE) &&
+           same5x_dpll_ref_hz(s, n);
+}
+
+/* fDPLL = fREF * (LDR + 1 + LDRFRAC / 32) */
+static uint64_t same5x_dpll_hz(Same5xOscctrlState *s, unsigned n)
+{
+    uint32_t ratio = same5x_reg(MCHP_REGBLOCK(s),
+                                same5x_dpll_reg(n, A_MCHP_OSCCTRL_DPLL_DPLLRATIO),
+                                4);
+    uint64_t mul32;
+
+    if (!same5x_dpll_locked(s, n)) {
+        return 0;
+    }
+    mul32 = 32 * (FIELD_EX32(ratio, MCHP_OSCCTRL_DPLL_DPLLRATIO, LDR) + 1) +
+            FIELD_EX32(ratio, MCHP_OSCCTRL_DPLL_DPLLRATIO, LDRFRAC);
+    return same5x_dpll_ref_hz(s, n) * mul32 / 32;
+}
+
+#define SAME5X_DPLL_STATUS_SHIFT(n)     (16 + 8 * (n))
+
+static uint32_t same5x_oscctrl_status(Same5xOscctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ctrlb = same5x_reg(rb, A_MCHP_OSCCTRL_DFLLCTRLB, 1);
+    uint32_t status = 0;
+
+    for (unsigned n = 0; n < SAME5X_NXOSC; n++) {
+        if (same5x_xosc_hz(s, n)) {
+            status |= R_MCHP_OSCCTRL_STATUS_XOSCRDY0_MASK << n;
+        }
+    }
+    if (same5x_dfll_hz(s)) {
+        status |= R_MCHP_OSCCTRL_STATUS_DFLLRDY_MASK;
+        if (FIELD_EX32(ctrlb, MCHP_OSCCTRL_DFLLCTRLB, MODE)) {
+            status |= R_MCHP_OSCCTRL_STATUS_DFLLLCKF_MASK |
+                      R_MCHP_OSCCTRL_STATUS_DFLLLCKC_MASK;
+        }
+    }
+    for (unsigned n = 0; n < SAME5X_NDPLL; n++) {
+        if (same5x_dpll_locked(s, n)) {
+            status |= R_MCHP_OSCCTRL_STATUS_DPLL0LCKR_MASK <<
+                      (SAME5X_DPLL_STATUS_SHIFT(n) -
+                       SAME5X_DPLL_STATUS_SHIFT(0));
+        }
+    }
+    return status;
+}
+
+static void same5x_oscctrl_compute(MchpRegBlock *rb)
+{
+    Same5xOscctrlState *s = MCHP_SAME5X_OSCCTRL(rb);
+    uint32_t status = same5x_oscctrl_status(s);
+
+    /* Ready and lock flags rise on the status edges */
+    same5x_raise_flags(rb, status & ~s->status);
+    for (unsigned n = 0; n < SAME5X_NDPLL; n++) {
+        uint32_t lckr = R_MCHP_OSCCTRL_STATUS_DPLL0LCKR_MASK <<
+                        (SAME5X_DPLL_STATUS_SHIFT(n) -
+                         SAME5X_DPLL_STATUS_SHIFT(0));
+
+        if (s->status & ~status & lckr) {
+            same5x_raise_flags(rb, lckr << 1);          /* DPLLnLCKF */
+        }
+    }
+    s->status = status;
+
+    for (unsigned n = 0; n < SAME5X_NXOSC; n++) {
+        mchp_regblock_set_clock(rb, s->xosc[n], same5x_xosc_hz(s, n));
+    }
+    mchp_regblock_set_clock(rb, s->dfll, same5x_dfll_hz(s));
+    for (unsigned n = 0; n < SAME5X_NDPLL; n++) {
+        mchp_regblock_set_clock(rb, s->dpll[n], same5x_dpll_hz(s, n));
+    }
+}
+
+static void same5x_oscctrl_update(Same5xOscctrlState *s)
+{
+    same5x_clk_settle(MCHP_REGBLOCK(s), &s->settle, same5x_oscctrl_compute);
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void same5x_oscctrl_clk_update(void *opaque, ClockEvent event)
+{
+    same5x_oscctrl_update(MCHP_SAME5X_OSCCTRL(opaque));
+}
+
+static uint32_t same5x_oscctrl_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                        unsigned idx, uint32_t stored,
+                                        bool side_effects)
+{
+    Same5xOscctrlState *s = MCHP_SAME5X_OSCCTRL(rf->opaque);
+    uint32_t off = mchp_regfile_elem_offset(ri, idx);
+
+    if (off == A_MCHP_OSCCTRL_STATUS) {
+        return same5x_oscctrl_status(s);
+    }
+    for (unsigned n = 0; n < SAME5X_NDPLL; n++) {
+        if (off == same5x_dpll_reg(n, A_MCHP_OSCCTRL_DPLL_DPLLSTATUS)) {
+            return same5x_dpll_locked(s, n) ?
+                   R_MCHP_OSCCTRL_DPLL_DPLLSTATUS_LOCK_MASK |
+                   R_MCHP_OSCCTRL_DPLL_DPLLSTATUS_CLKRDY_MASK : 0;
+        }
+    }
+    return 0;                       /* DFLLSYNC, DPLLSYNCBUSY: instant */
+}
+
+static void same5x_oscctrl_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                      unsigned idx, uint32_t old,
+                                      uint32_t written, uint32_t we)
+{
+    same5x_oscctrl_update(MCHP_SAME5X_OSCCTRL(rf->opaque));
+}
+
+static void same5x_oscctrl_reset_hold(MchpRegBlock *rb)
+{
+    Same5xOscctrlState *s = MCHP_SAME5X_OSCCTRL(rb);
+
+    s->status = same5x_oscctrl_status(s);
+}
+
+static void same5x_oscctrl_reset_exit(MchpRegBlock *rb)
+{
+    same5x_oscctrl_update(MCHP_SAME5X_OSCCTRL(rb));
+}
+
+/* Five lines: XOSC0, XOSC1, DFLL, DPLL0, DPLL1 (by INTFLAG byte/nibble) */
+static uint32_t same5x_oscctrl_irq_lines(MchpRegBlock *rb)
+{
+    uint32_t pend = mchp_regfile_get(&rb->rf, rb->intflag, 0) &
+                    mchp_regfile_peek(&rb->rf, A_MCHP_OSCCTRL_INTENSET, 4);
+    uint32_t lines = 0;
+
+    lines |= (pend & 0x05) ? 1 << 0 : 0;
+    lines |= (pend & 0x0A) ? 1 << 1 : 0;
+    lines |= (pend & 0x1F00) ? 1 << 2 : 0;
+    lines |= (pend & 0x0F0000) ? 1 << 3 : 0;
+    lines |= (pend & 0x0F000000) ? 1 << 4 : 0;
+    return lines;
+}
