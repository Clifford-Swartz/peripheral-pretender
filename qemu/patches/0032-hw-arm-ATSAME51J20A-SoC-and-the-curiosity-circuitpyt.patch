+{
+    Same5xOscctrlState *s = MCHP_SAME5X_OSCCTRL(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    for (unsigned n = 0; n < SAME5X_NXOSC; n++) {
+        g_autofree char *in = g_strdup_printf("xtal%u", n);
+        g_autofree char *out = g_strdup_printf("xosc%u", n);
+
+        s->xtal[n] = qdev_init_clock_in(dev, in, same5x_oscctrl_clk_update, s,
+                                        ClockUpdate);
+        s->xosc[n] = qdev_init_clock_out(dev, out);
+    }
+    s->ref_xosc32k = qdev_init_clock_in(dev, "dpll-ref-xosc32k",
+                                        same5x_oscctrl_clk_update, s,
+                                        ClockUpdate);
+    s->ref_dfll = qdev_init_clock_in(dev, "dfll-ref-gclk",
+                                     same5x_oscctrl_clk_update, s,
+                                     ClockUpdate);
+    for (unsigned n = 0; n < SAME5X_NDPLL; n++) {
+        g_autofree char *in = g_strdup_printf("dpll%u-ref-gclk", n);
+        g_autofree char *out = g_strdup_printf("dpll%u", n);
+
+        s->ref_gclk[n] = qdev_init_clock_in(dev, in, same5x_oscctrl_clk_update,
+                                            s, ClockUpdate);
+        s->dpll[n] = qdev_init_clock_out(dev, out);
+    }
+    s->dfll = qdev_init_clock_out(dev, "dfll48m");
+}
