+/* NVMCTRL U2409 */
+
+#define SAME5X_NVM_CMDEX_KEY    0xA5
+
+static uint32_t same5x_nvmctrl_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                        unsigned idx, uint32_t stored,
+                                        bool side_effects)
+{
+    if (ri->offset == A_MCHP_NVMCTRL_STATUS) {
+        /* Always ready; BOOTPROT as stored (fuses not loaded yet) */
+        return stored | R_MCHP_NVMCTRL_STATUS_READY_MASK;
+    }
+    return stored;
+}
+
+static void same5x_nvmctrl_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                      unsigned idx, uint32_t old,
+                                      uint32_t written, uint32_t we)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(rf->opaque);
+    uint32_t cmd = FIELD_EX32(written, MCHP_NVMCTRL_CTRLB, CMD);
+
+    if (ri->offset != A_MCHP_NVMCTRL_CTRLB) {
+        return;
+    }
+    if (FIELD_EX32(written, MCHP_NVMCTRL_CTRLB, CMDEX) !=
+        SAME5X_NVM_CMDEX_KEY) {
+        same5x_raise_flags(rb, R_MCHP_NVMCTRL_INTFLAG_PROGE_MASK);
+    } else {
+        qemu_log_mask(LOG_UNIMP, "%s: command 0x%02" PRIx32 " at 0x%06"
+                      PRIx32 " completes without effect\n", rb->name, cmd,
+                      mchp_regfile_peek(rf, A_MCHP_NVMCTRL_ADDR, 4));
+        same5x_raise_flags(rb, R_MCHP_NVMCTRL_INTFLAG_DONE_MASK);
+    }
+    mchp_regblock_update_irq(rb);
+}
+
+static void same5x_nvmctrl_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    c->pre_read = same5x_nvmctrl_pre_read;
+    c->post_write = same5x_nvmctrl_post_write;
+    c->log_writes = false;
+}
