+/* TRNG U2242 */
+
+static bool same5x_trng_enabled(MchpRegBlock *rb)
+{
+    return FIELD_EX32(mchp_regfile_peek(&rb->rf, A_MCHP_TRNG_CTRLA, 1),
+                      MCHP_TRNG_CTRLA, ENABLE);
+}
+
+static uint32_t same5x_trng_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                     unsigned idx, uint32_t stored,
+                                     bool side_effects)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(rf->opaque);
+    uint32_t word = 0;
+
+    switch (ri->offset) {
+    case A_MCHP_TRNG_INTFLAG:
+        return same5x_trng_enabled(rb) ? R_MCHP_TRNG_INTFLAG_DATARDY_MASK : 0;
+    case A_MCHP_TRNG_DATA:
+        if (side_effects && same5x_trng_enabled(rb)) {
+            qemu_guest_getrandom_nofail(&word, sizeof(word));
+            mchp_regfile_set(rf, ri, idx, word);
+            return word;
+        }
+        return stored;
+    default:
+        return stored;
+    }
+}
+
+static void same5x_trng_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                   unsigned idx, uint32_t old,
+                                   uint32_t written, uint32_t we)
+{
+    mchp_regblock_update_irq(MCHP_REGBLOCK(rf->opaque));
+}
+
+static bool same5x_trng_irq_pending(MchpRegBlock *rb)
+{
+    return same5x_trng_enabled(rb) &&
+           (mchp_regfile_peek(&rb->rf, A_MCHP_TRNG_INTENSET, 1) &
+            R_MCHP_TRNG_INTENSET_DATARDY_MASK);
+}
+
+static void same5x_trng_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    c->pre_read = same5x_trng_pre_read;
+    c->post_write = same5x_trng_post_write;
+    c->irq_pending = same5x_trng_irq_pending;
+    c->log_writes = false;
+}
