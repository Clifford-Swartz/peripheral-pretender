diff --git a/hw/ssi/mchp_qspi.c b/hw/ssi/mchp_qspi.c
new file mode 100644
index 0000000..83c3fe9
--- /dev/null
+++ b/hw/ssi/mchp_qspi.c
@@ -0,0 +1,330 @@
+/*
+ * Microchip SAM D5x/E5x QSPI controller (QSPI U2008)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Serial memory mode (CTRLB.MODE = MEMORY), as CircuitPython and Harmony
+ * drive it (DS60001507 QSPI chapter, instruction transmission flow):
+ *
+ * - Writing INSTRFRAME starts an instruction frame. Without DATAEN the
+ *   instruction (and INSTRADDR, option code, dummy cycles) goes out at
+ *   once. With DATAEN the frame starts at the first access to the memory
+ *   window: READ/WRITE frames address with INSTRADDR and move data at
+ *   each access; READMEMORY/WRITEMEMORY frames address with the window
+ *   offset, and a non-sequential access restarts the frame there.
+ * - Writing CTRLA.LASTXFER raises chip select and sets INTFLAG.INSTREND
+ *   (and CSRISE).
+ *
+ * The serial memory is an SSI peripheral; one SSI transfer carries one
+ * byte whatever INSTRFRAME.WIDTH says. Dummy cycles become
+ * DUMMYLEN * (lines of the address phase) / 8 bytes. SPI mode (TXDATA,
+ * RXDATA) does single-byte transfers. Scrambling, DDR and continuous read
+ * mode are not modelled.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/units.h"
+#include "hw/core/irq.h"
+#include "hw/mchp/gen/qspi_u2008.h"
+#include "hw/ssi/mchp_qspi.h"
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+
+#define QSPI_WINDOW_SIZE    (16 * MiB)
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpQspiState, MCHP_QSPI)
+
+struct MchpQspiState {
+    MchpRegBlock parent_obj;
+
+    SSIBus *bus;
+    qemu_irq cs;
+    MemoryRegion window;
+
+    bool selected;              /* chip select low, header sent */
+    bool pending;               /* DATAEN frame waiting for its first access */
+    uint32_t next;              /* next sequential window offset */
+    uint32_t rxdata;            /* SPI mode */
+};
+
+static uint32_t qspi_reg(MchpQspiState *s, hwaddr off)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, 4);
+}
+
+static void qspi_raise(MchpQspiState *s, uint32_t flags)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+
+    mchp_regfile_poke(&rb->rf, A_MCHP_QSPI_INTFLAG, 4,
+                      qspi_reg(s, A_MCHP_QSPI_INTFLAG) | flags);
+    mchp_regblock_update_irq(rb);
+}
+
+static void qspi_select(MchpQspiState *s, bool on)
+{
+    if (s->selected != on) {
+        s->selected = on;
+        qemu_set_irq(s->cs, !on);
+    }
+}
+
+/* Lines used by the address phase of INSTRFRAME.WIDTH */
+static unsigned qspi_addr_lines(uint32_t width)
+{
+    switch (width) {
+    case MCHP_QSPI_INSTRFRAME_WIDTH_DUAL_IO:
+    case MCHP_QSPI_INSTRFRAME_WIDTH_DUAL_CMD:
+        return 2;
+    case MCHP_QSPI_INSTRFRAME_WIDTH_QUAD_IO:
+    case MCHP_QSPI_INSTRFRAME_WIDTH_QUAD_CMD:
+        return 4;
+    default:
+        return 1;
+    }
+}
+
+/* Chip select low, then instruction, address, option code, dummy bytes */
+static void qspi_start_frame(MchpQspiState *s, uint32_t addr)
+{
+    uint32_t frame = qspi_reg(s, A_MCHP_QSPI_INSTRFRAME);
+    uint32_t ctrl = qspi_reg(s, A_MCHP_QSPI_INSTRCTRL);
+    unsigned dummy;
+
+    qspi_select(s, false);
+    qspi_select(s, true);
+    if (FIELD_EX32(frame, MCHP_QSPI_INSTRFRAME, INSTREN)) {
+        ssi_transfer(s->bus, FIELD_EX32(ctrl, MCHP_QSPI_INSTRCTRL, INSTR));
+    }
+    if (FIELD_EX32(frame, MCHP_QSPI_INSTRFRAME, ADDREN)) {
+        int bytes = FIELD_EX32(frame, MCHP_QSPI_INSTRFRAME, ADDRLEN) ? 4 : 3;
+
+        for (int i = bytes - 1; i >= 0; i--) {
+            ssi_transfer(s->bus, (addr >> (8 * i)) & 0xFF);
+        }
+    }
+    if (FIELD_EX32(frame, MCHP_QSPI_INSTRFRAME, OPTCODEEN)) {
+        ssi_transfer(s->bus, FIELD_EX32(ctrl, MCHP_QSPI_INSTRCTRL, OPTCODE));
+    }
+    dummy = FIELD_EX32(frame, MCHP_QSPI_INSTRFRAME, DUMMYLEN) *
+            qspi_addr_lines(FIELD_EX32(frame, MCHP_QSPI_INSTRFRAME, WIDTH)) /
+            8;
+    while (dummy--) {
+        ssi_transfer(s->bus, 0xFF);
+    }
+    s->next = addr;
+}
+
+static void qspi_end_frame(MchpQspiState *s)
+{
+    s->pending = false;
+    qspi_select(s, false);
+}
+
+/* Bring the frame to window offset @off; false: no data phase there */
+static bool qspi_window_frame(MchpQspiState *s, hwaddr off)
+{
+    uint32_t frame = qspi_reg(s, A_MCHP_QSPI_INSTRFRAME);
+    uint32_t tfr = FIELD_EX32(frame, MCHP_QSPI_INSTRFRAME, TFRTYPE);
+    bool memory = tfr == MCHP_QSPI_INSTRFRAME_TFRTYPE_READMEMORY ||
+                  tfr == MCHP_QSPI_INSTRFRAME_TFRTYPE_WRITEMEMORY;
+
+    if (!FIELD_EX32(qspi_reg(s, A_MCHP_QSPI_CTRLA), MCHP_QSPI_CTRLA, ENABLE) ||
+        !FIELD_EX32(frame, MCHP_QSPI_INSTRFRAME, DATAEN)) {
+        return false;
+    }
+    if (memory) {
+        if (s->pending || !s->selected || off != s->next) {
+            qspi_start_frame(s, off);
+        }
+    } else if (s->pending) {
+        qspi_start_frame(s, qspi_reg(s, A_MCHP_QSPI_INSTRADDR));
+    }
+    s->pending = false;
+    return true;
+}
+
+static uint64_t qspi_window_read(void *opaque, hwaddr off, unsigned size)
+{
+    MchpQspiState *s = opaque;
+    uint64_t val = 0;
+
+    if (!qspi_window_frame(s, off)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: memory window read at 0x%"
+                      HWADDR_PRIx " outside a data frame\n",
+                      MCHP_REGBLOCK(s)->name, off);
+        return 0;
+    }
+    for (unsigned i = 0; i < size; i++) {
+        val |= (uint64_t)(ssi_transfer(s->bus, 0xFF) & 0xFF) << (8 * i);
+    }
+    s->next = off + size;
+    return val;
+}
+
+static void qspi_window_write(void *opaque, hwaddr off, uint64_t val,
+                              unsigned size)
+{
+    MchpQspiState *s = opaque;
+
+    if (!qspi_window_frame(s, off)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: memory window write at 0x%"
+                      HWADDR_PRIx " outside a data frame\n",
+                      MCHP_REGBLOCK(s)->name, off);
+        return;
+    }
+    for (unsigned i = 0; i < size; i++) {
+        ssi_transfer(s->bus, (val >> (8 * i)) & 0xFF);
+    }
+    s->next = off + size;
+}
+
+static const MemoryRegionOps qspi_window_ops = {
+    .read = qspi_window_read,
+    .write = qspi_window_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+        .unaligned = true,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+        .unaligned = true,
+    },
+};
+
+static uint32_t qspi_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                              unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpQspiState *s = MCHP_QSPI(rf->opaque);
+    uint32_t ctrla = qspi_reg(s, A_MCHP_QSPI_CTRLA);
+
+    switch (ri->offset) {
+    case A_MCHP_QSPI_STATUS:
+        return (FIELD_EX32(ctrla, MCHP_QSPI_CTRLA, ENABLE) ?
+                R_MCHP_QSPI_STATUS_ENABLE_MASK : 0) |
+               (s->selected ? 0 : R_MCHP_QSPI_STATUS_CSSTATUS_MASK);
+    case A_MCHP_QSPI_RXDATA:
+        if (side_effects) {
+            mchp_regfile_poke(rf, A_MCHP_QSPI_INTFLAG, 4,
+                              qspi_reg(s, A_MCHP_QSPI_INTFLAG) &
+                              ~R_MCHP_QSPI_INTFLAG_RXC_MASK);
+            mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+        }
+        return s->rxdata;
+    default:
+        return stored;              /* INSTRFRAME: the dummy read syncs */
+    }
+}
+
+static void qspi_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                            unsigned idx, uint32_t old, uint32_t written,
+                            uint32_t we)
+{
+    MchpQspiState *s = MCHP_QSPI(rf->opaque);
+    uint32_t frame;
+
+    switch (ri->offset) {
+    case A_MCHP_QSPI_CTRLA:
+        if (written & we & R_MCHP_QSPI_CTRLA_LASTXFER_MASK) {
+            qspi_end_frame(s);
