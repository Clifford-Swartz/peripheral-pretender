+    .name = TYPE_MCHP_SAME5X_MCLK,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, Same5xMclkState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_CLOCK(main, Same5xMclkState),
+        VMSTATE_CLOCK(cpu, Same5xMclkState),
+        VMSTATE_END_OF_LIST()
+    },
+};
