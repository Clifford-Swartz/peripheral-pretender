+/*
+ * Microchip SAM D5x/E5x USB device controller (USB U2222) with a built-in
+ * host
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An mchp-regblock (four NVIC lines). Property "chardev": the host side of
+ * the device's first CDC ACM interface (CircuitPython's REPL and print()
+ * output). The built-in host enumerates the device once firmware attaches
+ * it (CTRLB.DETACH = 0), then polls the CDC data IN endpoint and sends
+ * chardev input to the data OUT endpoint, as a PC with a terminal open on
+ * the serial port would (DTR and RTS set).
+ *
+ * Read-only QOM properties for front ends: "host-state" (detached,
+ * enumerating, configured, failed), "usb-vid", "usb-pid", "usb-product",
+ * "usb-interfaces" (one "class:subclass:protocol" per interface).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_USB_H
+#define HW_MISC_MCHP_USB_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_USB "mchp-usb"
+
+#endif /* HW_MISC_MCHP_USB_H */
