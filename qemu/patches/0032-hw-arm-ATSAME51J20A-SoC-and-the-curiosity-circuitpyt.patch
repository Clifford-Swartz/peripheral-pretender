+DEFINE_TYPES(same5x_types)
diff --git a/hw/misc/mchp_usb.c b/hw/misc/mchp_usb.c
new file mode 100644
index 0000000..0df02d7
--- /dev/null
+++ b/hw/misc/mchp_usb.c
@@ -0,0 +1,899 @@
+/*
+ * Microchip SAM D5x/E5x USB device controller (USB U2222) with a built-in
+ * host
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Device mode as in DS60001507 (USB chapter): each endpoint has two banks
+ * (bank 0 OUT, bank 1 IN) described in RAM at DESCADD (16 bytes per bank:
+ * ADDR, PCKSIZE with BYTE_COUNT [13:0], MULTI_PACKET_SIZE [27:14] and SIZE
+ * [30:28]). Firmware arms an OUT bank by clearing EPSTATUS.BK0RDY and
+ * fills an IN bank before setting EPSTATUS.BK1RDY; the controller moves
+ * the data and raises EPINTFLAG.TRCPT0/TRCPT1. A SETUP packet always lands
+ * in bank 0 of endpoint 0 with RXSTP.
+ *
+ * There is no USB bus in this machine, so the controller carries its own
+ * host, clocked by 1 ms frames of virtual time while the device is
+ * attached: a bus reset (EORST), enumeration (device descriptor,
+ * SET_ADDRESS, configuration descriptor, product string,
+ * SET_CONFIGURATION), then for the first CDC ACM interface
+ * SET_LINE_CODING (115200 8N1) and SET_CONTROL_LINE_STATE (DTR | RTS), as
+ * a terminal program opening the port would. After that it moves one
+ * transfer per frame and direction between the CDC data endpoints and the
+ * "chardev". Other interfaces (mass storage, HID, MIDI) are enumerated but
+ * never used. Interrupt lines: 0 = everything but SOF and transfer
+ * completes, 1 = SOF, 2 = TRCPT0, 3 = TRCPT1 (DS USB interrupt table).
+ *
+ * Not modelled: host mode, isochronous timing, LPM, suspend/resume,
+ * remote wake-up, the CRC bytes a SETUP may append.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/fifo8.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "chardev/char-fe.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/mchp/gen/usb_u2222.h"
+#include "hw/misc/mchp_usb.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+#include "system/dma.h"
+
+#define USB_NEP             MCHP_USB_DEVICE_DEVICE_ENDPOINT_COUNT
+#define USB_EP_REG(ep, r)   (MCHP_USB_DEVICE_DEVICE_ENDPOINT_OFFSET + \
+                             (ep) * MCHP_USB_DEVICE_DEVICE_ENDPOINT_STRIDE + \
+                             (r))
+#define USB_FRAME_NS        1000000             /* full speed: 1 ms */
+#define USB_EP0_SIZE        64
+#define USB_RX_FIFO         512
+#define USB_CTL_BUF         1024
+
+/* Bank descriptor (DESCADD + ep * 32 + bank * 16) */
+#define BANK_ADDR           0
+#define BANK_PCKSIZE        4
+#define PCK_BYTE_COUNT      MAKE_64BIT_MASK(0, 14)
+#define PCK_MPS_SHIFT       14
+#define PCK_MPS_MASK        MAKE_64BIT_MASK(14, 14)
+#define PCK_SIZE_SHIFT      28
+
+/* EPSTATUS, EPINTFLAG bits */
+#define EPS_STALLRQ0        R_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPSTATUS_STALLRQ0_MASK
+#define EPS_STALLRQ1        R_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPSTATUS_STALLRQ1_MASK
+#define EPS_BK0RDY          R_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPSTATUS_BK0RDY_MASK
+#define EPS_BK1RDY          R_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPSTATUS_BK1RDY_MASK
+#define EPI_TRCPT0          R_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTFLAG_TRCPT0_MASK
+#define EPI_TRCPT1          R_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTFLAG_TRCPT1_MASK
+#define EPI_RXSTP           R_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTFLAG_RXSTP_MASK
+#define EPI_STALL0          R_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTFLAG_STALL0_MASK
+#define EPI_STALL1          R_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTFLAG_STALL1_MASK
+
+/* Standard requests and descriptor types (USB 2.0 chapter 9) */
+#define REQ_GET_DESCRIPTOR  6
+#define REQ_SET_ADDRESS     5
+#define REQ_SET_CONFIG      9
+#define DESC_DEVICE         1
+#define DESC_CONFIG         2
+#define DESC_STRING         3
+#define DESC_INTERFACE      4
+#define DESC_ENDPOINT       5
+#define CDC_SET_LINE_CODING 0x20
+#define CDC_SET_CTRL_LINE   0x22
+#define USB_HOST_ADDRESS    9
+
+typedef enum {
+    HOST_DETACHED,
+    HOST_ATTACHING,             /* waiting to reset the bus */
+    HOST_RESET,                 /* bus reset sent, waiting for EP0 */
+    HOST_ENUM,
+    HOST_CONFIGURED,
+    HOST_FAILED,
+} UsbHostState;
+
+static const char *const usb_host_state_names[] = {
+    [HOST_DETACHED] = "detached",
+    [HOST_ATTACHING] = "attaching",
+    [HOST_RESET] = "reset",
+    [HOST_ENUM] = "enumerating",
+    [HOST_CONFIGURED] = "configured",
+    [HOST_FAILED] = "failed",
+};
+
+typedef enum {
+    CTL_IDLE,
+    CTL_SETUP,
+    CTL_DATA_IN,
+    CTL_DATA_OUT,
+    CTL_STATUS_IN,
+    CTL_STATUS_OUT,
+    CTL_DONE,
+    CTL_STALLED,
+} UsbCtlPhase;
+
+/* Enumeration steps, in order */
+typedef enum {
+    ENUM_DEVICE_DESC,
+    ENUM_SET_ADDRESS,
+    ENUM_CONFIG_HEAD,
+    ENUM_CONFIG_ALL,
+    ENUM_PRODUCT,
+    ENUM_SET_CONFIG,
+    ENUM_LINE_CODING,
+    ENUM_LINE_STATE,
+    ENUM_DONE,
+} UsbEnumStep;
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpUsbState, MCHP_USB)
+
+struct MchpUsbState {
+    MchpRegBlock parent_obj;
+
+    CharFrontend chr;
+    QEMUTimer *frame;
+    Fifo8 rx;                       /* chardev input for the CDC OUT EP */
+
+    uint16_t fnum;
+    bool swrst_busy;                /* SYNCBUSY.SWRST reads 1 once */
+
+    /* Built-in host */
+    uint8_t host;
+    uint8_t wait;                   /* frames before the next host step */
+    uint8_t step;                   /* UsbEnumStep */
+    uint8_t ctl;                    /* UsbCtlPhase */
+    uint8_t setup[8];
+    uint8_t ctl_buf[USB_CTL_BUF];
+    uint16_t ctl_len;               /* bytes of the data stage */
+    uint16_t ctl_pos;
+    uint8_t dev_desc[18];
+    uint8_t config[USB_CTL_BUF];
+    uint16_t config_len;
+    int8_t cdc_comm_if;
+    int8_t cdc_in_ep;
+    int8_t cdc_out_ep;
+    uint16_t cdc_out_pos;           /* bytes into the armed OUT transfer */
+    char *product;
+    char *interfaces;
+};
+
+static uint32_t usb_peek(MchpUsbState *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static void usb_poke(MchpUsbState *s, hwaddr off, unsigned size, uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
+static uint8_t usb_epstatus(MchpUsbState *s, unsigned ep)
+{
+    return usb_peek(s, USB_EP_REG(ep, A_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPSTATUS),
+                    1);
+}
+
+static void usb_epstatus_set(MchpUsbState *s, unsigned ep, uint8_t set,
+                             uint8_t clr)
+{
+    hwaddr off = USB_EP_REG(ep, A_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPSTATUS);
+
+    usb_poke(s, off, 1, (usb_peek(s, off, 1) & ~clr) | set);
+}
+
+static void usb_epint_raise(MchpUsbState *s, unsigned ep, uint8_t flags)
+{
+    hwaddr off = USB_EP_REG(ep, A_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTFLAG);
+
+    usb_poke(s, off, 1, usb_peek(s, off, 1) | flags);
+}
+
+static uint8_t usb_epcfg(MchpUsbState *s, unsigned ep)
+{
+    return usb_peek(s, USB_EP_REG(ep, A_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPCFG),
+                    1);
+}
+
+/* Bank descriptors in RAM */
+static hwaddr usb_bank(MchpUsbState *s, unsigned ep, unsigned bank)
+{
+    return usb_peek(s, A_MCHP_USB_DEVICE_DESCADD, 4) + ep * 32 + bank * 16;
+}
+
+static uint32_t usb_ld32(hwaddr addr)
+{
+    uint32_t v = 0;
+
+    dma_memory_read(&address_space_memory, addr, &v, 4,
+                    MEMTXATTRS_UNSPECIFIED);
+    return le32_to_cpu(v);
+}
+
+static void usb_st32(hwaddr addr, uint32_t v)
+{
+    v = cpu_to_le32(v);
+    dma_memory_write(&address_space_memory, addr, &v, 4,
+                     MEMTXATTRS_UNSPECIFIED);
+}
+
+static unsigned usb_bank_packet_size(uint32_t pck)
+{
+    return 8 << ((pck >> PCK_SIZE_SHIFT) & 7);      /* 8 .. 1023 */
+}
+
+/*
+ * Host to device: @len bytes into the armed bank 0 of @ep (it was armed
+ * when firmware cleared BK0RDY). Returns the bytes taken; the transfer
+ * completes (TRCPT0) on a short packet or a full MULTI_PACKET_SIZE.
+ */
+static unsigned usb_out(MchpUsbState *s, unsigned ep, const uint8_t *data,
+                        unsigned len, bool setup)
+{
+    hwaddr bank = usb_bank(s, ep, 0);
+    uint32_t addr = usb_ld32(bank + BANK_ADDR);
+    uint32_t pck = usb_ld32(bank + BANK_PCKSIZE);
+    unsigned count = pck & PCK_BYTE_COUNT;
+    unsigned mps = (pck & PCK_MPS_MASK) >> PCK_MPS_SHIFT;
+    unsigned psize = usb_bank_packet_size(pck);
+    unsigned n;
+    bool done;
+
+    if (setup) {
+        count = 0;
+        n = len;
+    } else {
+        n = MIN(MIN(len, psize), mps > count ? mps - count : 0);
+    }
+    dma_memory_write(&address_space_memory, addr + count, data, n,
+                     MEMTXATTRS_UNSPECIFIED);
+    count += n;
+    pck = (pck & ~PCK_BYTE_COUNT) | count;
+    usb_st32(bank + BANK_PCKSIZE, pck);
+    done = setup || n < psize || count >= mps;
+    if (done) {
+        usb_epstatus_set(s, ep, EPS_BK0RDY,
+                         setup ? EPS_STALLRQ0 | EPS_STALLRQ1 : 0);
+        usb_epint_raise(s, ep, setup ? EPI_RXSTP : EPI_TRCPT0);
+    }
+    return n;
+}
+
+/* Device to host: the whole filled bank 1 of @ep; TRCPT1. */
+static unsigned usb_in(MchpUsbState *s, unsigned ep, uint8_t *buf,
+                       unsigned max)
+{
+    hwaddr bank = usb_bank(s, ep, 1);
+    uint32_t addr = usb_ld32(bank + BANK_ADDR);
+    uint32_t pck = usb_ld32(bank + BANK_PCKSIZE);
+    unsigned n = MIN(pck & PCK_BYTE_COUNT, max);
+
+    dma_memory_read(&address_space_memory, addr, buf, n,
+                    MEMTXATTRS_UNSPECIFIED);
+    /* MULTI_PACKET_SIZE counts the bytes sent */
+    pck = (pck & ~PCK_MPS_MASK) |
+          (((pck & PCK_BYTE_COUNT) << PCK_MPS_SHIFT) & PCK_MPS_MASK);
+    usb_st32(bank + BANK_PCKSIZE, pck);
+    usb_epstatus_set(s, ep, 0, EPS_BK1RDY);
+    usb_epint_raise(s, ep, EPI_TRCPT1);
+    return n;
+}
+
+/* Interrupt lines: 0 misc, 1 SOF, 2 TRCPT0, 3 TRCPT1 */
+static uint32_t usb_irq_lines(MchpRegBlock *rb)
+{
+    MchpUsbState *s = MCHP_USB(rb);
+    uint32_t pend = usb_peek(s, A_MCHP_USB_DEVICE_INTFLAG, 2) &
+                    usb_peek(s, A_MCHP_USB_DEVICE_INTENSET, 2);
+    uint32_t lines = 0;
+
+    if (pend & ~R_MCHP_USB_DEVICE_INTFLAG_SOF_MASK) {
+        lines |= 1 << 0;
+    }
+    if (pend & R_MCHP_USB_DEVICE_INTFLAG_SOF_MASK) {
+        lines |= 1 << 1;
+    }
+    for (unsigned ep = 0; ep < USB_NEP; ep++) {
+        uint8_t f = usb_peek(s, USB_EP_REG(ep,
+                        A_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTFLAG), 1) &
+                    usb_peek(s, USB_EP_REG(ep,
+                        A_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTENSET), 1);
+
+        if (f & EPI_TRCPT0) {
+            lines |= 1 << 2;
+        }
+        if (f & EPI_TRCPT1) {
+            lines |= 1 << 3;
+        }
+        if (f & ~(EPI_TRCPT0 | EPI_TRCPT1)) {
+            lines |= 1 << 0;
+        }
+    }
+    return lines;
+}
+
+static bool usb_irq_pending(MchpRegBlock *rb)
+{
+    return usb_irq_lines(rb) != 0;
+}
+
+static bool usb_attached(MchpUsbState *s)
+{
+    uint32_t ctrla = usb_peek(s, A_MCHP_USB_DEVICE_CTRLA, 1);
+
+    return FIELD_EX32(ctrla, MCHP_USB_DEVICE_CTRLA, ENABLE) &&
+           !FIELD_EX32(ctrla, MCHP_USB_DEVICE_CTRLA, MODE) &&
+           !FIELD_EX32(usb_peek(s, A_MCHP_USB_DEVICE_CTRLB, 2),
+                       MCHP_USB_DEVICE_CTRLB, DETACH);
+}
+
+/* Start a control transfer on endpoint 0 */
+static void usb_control(MchpUsbState *s, uint8_t type, uint8_t req,
+                        uint16_t value, uint16_t index, uint16_t len,
+                        const void *out)
+{
+    s->setup[0] = type;
+    s->setup[1] = req;
+    stw_le_p(&s->setup[2], value);
+    stw_le_p(&s->setup[4], index);
+    stw_le_p(&s->setup[6], len);
+    s->ctl_len = MIN(len, USB_CTL_BUF);
+    s->ctl_pos = 0;
+    if (out) {
+        memcpy(s->ctl_buf, out, s->ctl_len);
+    }
+    s->ctl = CTL_SETUP;
+}
+
+/* One step of the control transfer in progress; true: it moved */
+static bool usb_control_step(MchpUsbState *s)
+{
+    uint8_t st = usb_epstatus(s, 0);
+    bool in = s->setup[0] & 0x80;
+    unsigned n;
+
+    switch (s->ctl) {
+    case CTL_SETUP:
+        usb_out(s, 0, s->setup, sizeof(s->setup), true);
+        s->ctl = !s->ctl_len ? CTL_STATUS_IN : in ? CTL_DATA_IN : CTL_DATA_OUT;
+        return true;
+    case CTL_DATA_IN:
+        if (st & EPS_STALLRQ1) {
+            s->ctl = CTL_STALLED;
+            return true;
+        }
+        if (!(st & EPS_BK1RDY)) {
+            return false;
+        }
+        n = usb_in(s, 0, s->ctl_buf + s->ctl_pos, s->ctl_len - s->ctl_pos);
+        s->ctl_pos += n;
+        if (n < USB_EP0_SIZE || s->ctl_pos >= s->ctl_len) {
+            s->ctl_len = s->ctl_pos;
+            s->ctl = CTL_STATUS_OUT;
+        }
+        return true;
+    case CTL_DATA_OUT:
+        if (st & EPS_STALLRQ0) {
+            s->ctl = CTL_STALLED;
+            return true;
+        }
+        if (st & EPS_BK0RDY) {
+            return false;               /* not armed yet */
+        }
+        n = MIN(s->ctl_len - s->ctl_pos, USB_EP0_SIZE);
+        n = usb_out(s, 0, s->ctl_buf + s->ctl_pos, n, false);
+        s->ctl_pos += n;
+        if (s->ctl_pos >= s->ctl_len) {
+            s->ctl = CTL_STATUS_IN;
+        }
+        return true;
+    case CTL_STATUS_IN:
+        if (st & EPS_STALLRQ1) {
+            s->ctl = CTL_STALLED;
+            return true;
+        }
+        if (!(st & EPS_BK1RDY)) {
+            return false;
+        }
+        usb_in(s, 0, s->ctl_buf, 0);
+        s->ctl = CTL_DONE;
+        return true;
+    case CTL_STATUS_OUT:
+        if (st & EPS_STALLRQ0) {
+            s->ctl = CTL_STALLED;
+            return true;
+        }
+        if (st & EPS_BK0RDY) {
+            return false;
+        }
+        usb_out(s, 0, NULL, 0, false);
+        s->ctl = CTL_DONE;
+        return true;
+    default:
+        return false;
+    }
+}
+
+/* Interfaces and endpoints of the configuration descriptor */
+static void usb_parse_config(MchpUsbState *s)
+{
+    g_autoptr(GString) ifs = g_string_new(NULL);
+    int iface = -1, cls = -1;
+
+    s->cdc_comm_if = s->cdc_in_ep = s->cdc_out_ep = -1;
+    for (unsigned i = 0; i + 1 < s->config_len && s->config[i] >= 2;
+         i += s->config[i]) {
+        const uint8_t *d = &s->config[i];
+
+        if (d[1] == DESC_INTERFACE && d[0] >= 9) {
+            iface = d[2];
+            cls = d[5];
+            if (d[3] == 0) {            /* bAlternateSetting 0 */
+                g_string_append_printf(ifs, "%s%02x:%02x:%02x",
+                                       ifs->len ? " " : "", d[5], d[6], d[7]);
+            }
+            if (cls == 0x02 && d[6] == 0x02 && s->cdc_comm_if < 0) {
+                s->cdc_comm_if = iface;
+            }
+        } else if (d[1] == DESC_ENDPOINT && d[0] >= 7 && cls == 0x0A &&
+                   (d[3] & 3) == 2) {
+            /* Bulk endpoints of the first CDC data interface */
+            if ((d[2] & 0x80) && s->cdc_in_ep < 0) {
+                s->cdc_in_ep = d[2] & 0x0F;
+            } else if (!(d[2] & 0x80) && s->cdc_out_ep < 0) {
+                s->cdc_out_ep = d[2] & 0x0F;
+            }
+        }
+    }
+    g_free(s->interfaces);
+    s->interfaces = g_string_free(g_steal_pointer(&ifs), false);
+}
+
+static void usb_set_product(MchpUsbState *s)
+{
+    g_autoptr(GString) str = g_string_new(NULL);
+
+    /* UTF-16LE string descriptor; keep the ASCII characters */
+    for (unsigned i = 2; i + 1 < s->ctl_len && i + 1 < s->ctl_buf[0];
+         i += 2) {
+        uint16_t c = lduw_le_p(&s->ctl_buf[i]);
+
+        g_string_append_c(str, c < 0x80 ? c : '?');
+    }
+    g_free(s->product);
+    s->product = g_string_free(g_steal_pointer(&str), false);
+}
+
+static void usb_enum_next(MchpUsbState *s, UsbEnumStep step)
+{
+    static const uint8_t line_coding[7] = {
+        0x00, 0xC2, 0x01, 0x00,         /* 115200 */
+        0, 0, 8,                        /* 1 stop bit, no parity, 8 bits */
+    };
+
+    s->step = step;
+    s->wait = 2;
+    switch (step) {
+    case ENUM_DEVICE_DESC:
+        usb_control(s, 0x80, REQ_GET_DESCRIPTOR, DESC_DEVICE << 8, 0, 18,
+                    NULL);
+        break;
+    case ENUM_SET_ADDRESS:
+        usb_control(s, 0x00, REQ_SET_ADDRESS, USB_HOST_ADDRESS, 0, 0, NULL);
+        break;
+    case ENUM_CONFIG_HEAD:
+        usb_control(s, 0x80, REQ_GET_DESCRIPTOR, DESC_CONFIG << 8, 0, 9,
+                    NULL);
+        break;
+    case ENUM_CONFIG_ALL:
+        usb_control(s, 0x80, REQ_GET_DESCRIPTOR, DESC_CONFIG << 8, 0,
+                    MIN(s->config_len, USB_CTL_BUF), NULL);
+        break;
+    case ENUM_PRODUCT:
+        if (!s->dev_desc[15]) {
+            usb_enum_next(s, ENUM_SET_CONFIG);
+            return;
+        }
+        usb_control(s, 0x80, REQ_GET_DESCRIPTOR,
+                    DESC_STRING << 8 | s->dev_desc[15], 0x0409, 255, NULL);
+        break;
+    case ENUM_SET_CONFIG:
+        usb_control(s, 0x00, REQ_SET_CONFIG, 1, 0, 0, NULL);
+        break;
+    case ENUM_LINE_CODING:
+        if (s->cdc_comm_if < 0) {
+            usb_enum_next(s, ENUM_DONE);
+            return;
+        }
+        usb_control(s, 0x21, CDC_SET_LINE_CODING, 0, s->cdc_comm_if,
+                    sizeof(line_coding), line_coding);
+        break;
+    case ENUM_LINE_STATE:
+        usb_control(s, 0x21, CDC_SET_CTRL_LINE, 0x0003, s->cdc_comm_if, 0,
+                    NULL);
+        break;
+    case ENUM_DONE:
+        s->ctl = CTL_IDLE;
+        s->host = HOST_CONFIGURED;
+        s->cdc_out_pos = 0;
+        qemu_log_mask(LOG_TRACE, "%s: configured \"%s\" (%04x:%04x), "
+                      "interfaces %s\n", MCHP_REGBLOCK(s)->name,
+                      s->product ? s->product : "",
+                      lduw_le_p(&s->dev_desc[8]), lduw_le_p(&s->dev_desc[10]),
+                      s->interfaces ? s->interfaces : "");
+        break;
+    }
+}
+
+/* A control transfer of the enumeration finished (or stalled) */
+static void usb_enum_result(MchpUsbState *s)
+{
+    bool ok = s->ctl == CTL_DONE;
+
+    switch (s->step) {
+    case ENUM_DEVICE_DESC:
+        if (!ok || s->ctl_len < 18) {
+            break;
+        }
+        memcpy(s->dev_desc, s->ctl_buf, sizeof(s->dev_desc));
+        usb_enum_next(s, ENUM_SET_ADDRESS);
+        return;
+    case ENUM_SET_ADDRESS:
+        if (!ok) {
+            break;
+        }
+        usb_enum_next(s, ENUM_CONFIG_HEAD);
+        return;
+    case ENUM_CONFIG_HEAD:
+        if (!ok || s->ctl_len < 9) {
+            break;
+        }
+        s->config_len = MIN(lduw_le_p(&s->ctl_buf[2]), USB_CTL_BUF);
+        usb_enum_next(s, ENUM_CONFIG_ALL);
+        return;
+    case ENUM_CONFIG_ALL:
+        if (!ok) {
+            break;
+        }
+        s->config_len = s->ctl_len;
+        memcpy(s->config, s->ctl_buf, s->config_len);
+        usb_parse_config(s);
+        usb_enum_next(s, ENUM_PRODUCT);
+        return;
+    case ENUM_PRODUCT:
+        if (ok) {
+            usb_set_product(s);
+        }
+        usb_enum_next(s, ENUM_SET_CONFIG);
+        return;
+    case ENUM_SET_CONFIG:
+        if (!ok) {
+            break;
+        }
+        usb_enum_next(s, ENUM_LINE_CODING);
+        return;
+    case ENUM_LINE_CODING:
+        usb_enum_next(s, ENUM_LINE_STATE);      /* a stall is tolerated */
+        return;
+    case ENUM_LINE_STATE:
+        usb_enum_next(s, ENUM_DONE);
+        return;
+    default:
+        return;
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "%s: enumeration step %u %s\n",
+                  MCHP_REGBLOCK(s)->name, s->step,
+                  ok ? "returned too little" : "stalled");
+    s->ctl = CTL_IDLE;
+    s->host = HOST_FAILED;
+}
+
+/* CDC data: device output to the chardev, chardev input to the device */
+static void usb_cdc_step(MchpUsbState *s)
+{
+    uint8_t buf[1024];
+
+    if (s->cdc_in_ep > 0 && (usb_epstatus(s, s->cdc_in_ep) & EPS_BK1RDY) &&
+        !(usb_epstatus(s, s->cdc_in_ep) & EPS_STALLRQ1)) {
+        unsigned n = usb_in(s, s->cdc_in_ep, buf, sizeof(buf));
+
+        if (n && qemu_chr_fe_backend_connected(&s->chr)) {
+            qemu_chr_fe_write_all(&s->chr, buf, n);
+        }
+    }
+    if (s->cdc_out_ep > 0 && !fifo8_is_empty(&s->rx) &&
+        FIELD_EX32(usb_epcfg(s, s->cdc_out_ep),
+                   MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPCFG, EPTYPE0) &&
+        !(usb_epstatus(s, s->cdc_out_ep) & (EPS_BK0RDY | EPS_STALLRQ0))) {
+        uint32_t len = MIN(fifo8_num_used(&s->rx), USB_EP0_SIZE);
+        const uint8_t *data;
+        unsigned n;
+
+        data = fifo8_peek_bufptr(&s->rx, len, &len);
+        n = usb_out(s, s->cdc_out_ep, data, len, false);
+        fifo8_drop(&s->rx, n);
+        qemu_chr_fe_accept_input(&s->chr);
+    }
+}
+
+static void usb_bus_reset(MchpUsbState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+
+    usb_poke(s, A_MCHP_USB_DEVICE_DADD, 1, 0);
+    usb_poke(s, A_MCHP_USB_DEVICE_INTFLAG, 2,
+             usb_peek(s, A_MCHP_USB_DEVICE_INTFLAG, 2) |
+             R_MCHP_USB_DEVICE_INTFLAG_EORST_MASK);
+    s->host = HOST_RESET;
+    s->ctl = CTL_IDLE;
+    s->wait = 5;
+    mchp_regblock_update_irq(rb);
+}
+
+static void usb_frame(void *opaque)
+{
+    MchpUsbState *s = opaque;
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+
+    if (!usb_attached(s)) {
+        s->host = HOST_DETACHED;
+        return;                     /* the timer restarts on attach */
+    }
+    s->fnum = (s->fnum + 1) & 0x7FF;
+    usb_poke(s, A_MCHP_USB_DEVICE_INTFLAG, 2,
+             usb_peek(s, A_MCHP_USB_DEVICE_INTFLAG, 2) |
+             R_MCHP_USB_DEVICE_INTFLAG_SOF_MASK);
+
+    if (s->wait) {
+        s->wait--;
+    } else {
+        switch (s->host) {
+        case HOST_DETACHED:
+            s->host = HOST_ATTACHING;
+            s->wait = 20;           /* debounce, as a hub does */
+            break;
+        case HOST_ATTACHING:
+            usb_bus_reset(s);
+            break;
+        case HOST_RESET:
+            /* Firmware configured endpoint 0 after EORST */
+            if (FIELD_EX32(usb_epcfg(s, 0),
+                           MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPCFG, EPTYPE0)) {
+                s->host = HOST_ENUM;
+                usb_enum_next(s, ENUM_DEVICE_DESC);
+            }
+            break;
+        case HOST_ENUM:
+            while (usb_control_step(s)) {
+                if (s->ctl == CTL_DONE || s->ctl == CTL_STALLED) {
+                    usb_enum_result(s);
+                    break;
+                }
+                if (s->ctl == CTL_DATA_IN || s->ctl == CTL_STATUS_IN ||
+                    s->ctl == CTL_STATUS_OUT || s->ctl == CTL_DATA_OUT) {
+                    break;          /* one stage per frame */
+                }
+            }
+            break;
+        case HOST_CONFIGURED:
+            usb_cdc_step(s);
+            break;
+        default:
+            break;
+        }
+    }
+    mchp_regblock_update_irq(rb);
+    timer_mod(s->frame, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + USB_FRAME_NS);
+}
+
+static void usb_kick(MchpUsbState *s)
+{
+    if (usb_attached(s) && !timer_pending(s->frame)) {
+        timer_mod(s->frame, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  USB_FRAME_NS);
+    }
+}
+
+static uint32_t usb_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                             unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpUsbState *s = MCHP_USB(rf->opaque);
+    uint32_t smry = 0;
+
+    switch (ri->offset) {
+    case A_MCHP_USB_DEVICE_SYNCBUSY:
+        if (s->swrst_busy) {
+            if (side_effects) {
+                s->swrst_busy = false;
+            }
+            return R_MCHP_USB_DEVICE_SYNCBUSY_SWRST_MASK;
+        }
+        return 0;
+    case A_MCHP_USB_DEVICE_FNUM:
+        return s->fnum << 3;
+    case A_MCHP_USB_DEVICE_EPINTSMRY:
+        for (unsigned ep = 0; ep < USB_NEP; ep++) {
+            if (usb_peek(s, USB_EP_REG(ep,
+                    A_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTFLAG), 1) &
+                usb_peek(s, USB_EP_REG(ep,
+                    A_MCHP_USB_DEVICE_DEVICE_ENDPOINT_EPINTENSET), 1)) {
+                smry |= 1 << ep;
+            }
+        }
+        return smry;
+    default:
+        return stored;
+    }
+}
+
+static void usb_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                           unsigned idx, uint32_t old, uint32_t written,
+                           uint32_t we)
+{
+    MchpUsbState *s = MCHP_USB(rf->opaque);
+
+    if (ri->offset == A_MCHP_USB_DEVICE_CTRLA &&
+        (written & we & R_MCHP_USB_DEVICE_CTRLA_SWRST_MASK)) {
+        s->swrst_busy = true;
+    }
+    if (!usb_attached(s)) {
+        s->host = HOST_DETACHED;
+    }
+    usb_kick(s);
+}
+
+static void usb_reset_hold(MchpRegBlock *rb)
+{
+    MchpUsbState *s = MCHP_USB(rb);
+    bool busy = s->swrst_busy;
+
+    timer_del(s->frame);
+    s->host = HOST_DETACHED;
+    s->ctl = CTL_IDLE;
+    s->wait = 0;
+    s->fnum = 0;
+    s->cdc_comm_if = s->cdc_in_ep = s->cdc_out_ep = -1;
+    s->swrst_busy = busy;           /* a software reset reads busy once */
+    fifo8_reset(&s->rx);
+}
+
+static int usb_can_receive(void *opaque)
+{
+    MchpUsbState *s = opaque;
+
+    return fifo8_num_free(&s->rx);
+}
+
+static void usb_receive(void *opaque, const uint8_t *buf, int size)
+{
+    MchpUsbState *s = opaque;
+
+    fifo8_push_all(&s->rx, buf, MIN(size, fifo8_num_free(&s->rx)));
+}
+
+static char *usb_get_host_state(Object *obj, Error **errp)
+{
+    return g_strdup(usb_host_state_names[MCHP_USB(obj)->host]);
+}
+
+static char *usb_get_product(Object *obj, Error **errp)
+{
+    return g_strdup(MCHP_USB(obj)->product ? MCHP_USB(obj)->product : "");
+}
+
+static char *usb_get_interfaces(Object *obj, Error **errp)
+{
+    MchpUsbState *s = MCHP_USB(obj);
+
+    return g_strdup(s->interfaces ? s->interfaces : "");
+}
+
+static void usb_get_id(Object *obj, Visitor *v, const char *name,
+                       void *opaque, Error **errp)
+{
+    MchpUsbState *s = MCHP_USB(obj);
+    uint32_t id = lduw_le_p(&s->dev_desc[!strcmp(name, "usb-vid") ? 8 : 10]);
+
+    visit_type_uint32(v, name, &id, errp);
+}
+
+static bool usb_realize(MchpRegBlock *rb, Error **errp)
+{
+    MchpUsbState *s = MCHP_USB(rb);
+
+    qemu_chr_fe_set_handlers(&s->chr, usb_can_receive, usb_receive, NULL,
+                             NULL, s, NULL, true);
+    return true;
+}
+
+static void usb_init(Object *obj)
+{
+    MchpUsbState *s = MCHP_USB(obj);
+
+    s->frame = timer_new_ns(QEMU_CLOCK_VIRTUAL, usb_frame, s);
+    fifo8_create(&s->rx, USB_RX_FIFO);
+    s->cdc_comm_if = s->cdc_in_ep = s->cdc_out_ep = -1;
+    object_property_add_str(obj, "host-state", usb_get_host_state, NULL);
+    object_property_add_str(obj, "usb-product", usb_get_product, NULL);
+    object_property_add_str(obj, "usb-interfaces", usb_get_interfaces, NULL);
+    object_property_add(obj, "usb-vid", "uint32", usb_get_id, NULL, NULL,
+                        NULL);
+    object_property_add(obj, "usb-pid", "uint32", usb_get_id, NULL, NULL,
+                        NULL);
+}
+
+static void usb_finalize(Object *obj)
+{
+    MchpUsbState *s = MCHP_USB(obj);
+
+    timer_free(s->frame);
+    fifo8_destroy(&s->rx);
+    g_free(s->product);
+    g_free(s->interfaces);
+}
+
+static const Property usb_properties[] = {
+    DEFINE_PROP_CHR("chardev", MchpUsbState, chr),
+};
+
+static const VMStateDescription vmstate_mchp_usb = {
+    .name = TYPE_MCHP_USB,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpUsbState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_TIMER_PTR(frame, MchpUsbState),
+        VMSTATE_FIFO8(rx, MchpUsbState),
+        VMSTATE_UINT16(fnum, MchpUsbState),
+        VMSTATE_BOOL(swrst_busy, MchpUsbState),
+        VMSTATE_UINT8(host, MchpUsbState),
+        VMSTATE_UINT8(wait, MchpUsbState),
+        VMSTATE_UINT8(step, MchpUsbState),
+        VMSTATE_UINT8(ctl, MchpUsbState),
+        VMSTATE_UINT8_ARRAY(setup, MchpUsbState, 8),
+        VMSTATE_UINT8_ARRAY(ctl_buf, MchpUsbState, USB_CTL_BUF),
+        VMSTATE_UINT16(ctl_len, MchpUsbState),
+        VMSTATE_UINT16(ctl_pos, MchpUsbState),
+        VMSTATE_UINT8_ARRAY(dev_desc, MchpUsbState, 18),
+        VMSTATE_UINT8_ARRAY(config, MchpUsbState, USB_CTL_BUF),
+        VMSTATE_UINT16(config_len, MchpUsbState),
+        VMSTATE_INT8(cdc_comm_if, MchpUsbState),
+        VMSTATE_INT8(cdc_in_ep, MchpUsbState),
+        VMSTATE_INT8(cdc_out_ep, MchpUsbState),
+        VMSTATE_UINT16(cdc_out_pos, MchpUsbState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void usb_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    dc->vmsd = &vmstate_mchp_usb;
+    device_class_set_props(dc, usb_properties);
+    c->realize = usb_realize;
+    c->pre_read = usb_pre_read;
+    c->post_write = usb_post_write;
+    c->reset_hold = usb_reset_hold;
+    c->irq_pending = usb_irq_pending;
+    c->irq_lines = usb_irq_lines;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_usb_types[] = {
+    {
+        .name = TYPE_MCHP_USB,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpUsbState),
+        .instance_init = usb_init,
+        .instance_finalize = usb_finalize,
+        .class_init = usb_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_usb_types)
