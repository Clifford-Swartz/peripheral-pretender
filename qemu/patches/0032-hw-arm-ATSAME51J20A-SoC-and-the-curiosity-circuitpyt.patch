diff --git a/hw/arm/curiosity_circuitpython.c b/hw/arm/curiosity_circuitpython.c
new file mode 100644
index 0000000..a8455f0
--- /dev/null
+++ b/hw/arm/curiosity_circuitpython.c
@@ -0,0 +1,219 @@
+/*
+ * Microchip Curiosity CircuitPython board (EV78P89A), the controller board
+ * of the Curiosity PyKit Explorer
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * ATSAME51J20A with a 32.768 kHz crystal on XIN32/XOUT32 (PA00/PA01) and
+ * no main crystal (schematic 02-01318 rev 3, 2025-09-05):
+ *
+ * - SST26VF032B QSPI flash (U7) on the QSPI pins; its contents are
+ *   -drive if=mtd,index=0 (a raw 4 MiB image; CircuitPython's CIRCUITPY
+ *   FAT file system lives there).
+ * - Red LED D6 on PB23 (D13, active high through 1 kOhm).
+ * - USER button on PA27 (D3) to ground, 10 kOhm pull-up R20.
+ * - USB-C (PA24/PA25): the USB device; the host's view of its first CDC
+ *   ACM interface (CircuitPython's REPL) is a serial port, see mchp-usb.
+ * - Debug UART (DEBUG_TX PA22, DEBUG_RX PA23): SERCOM3 pads 0/1.
+ * - BLE module UART (BLE_TX PA12, BLE_RX PA13): SERCOM2 pads 0/1 (the
+ *   RNBD451 itself is not modelled).
+ *
+ * Machine option console=usb (default) makes serial0 the USB console,
+ * serial1 the debug UART and serial2 the BLE UART; console=debug swaps the
+ * first two, for bare-metal images that print on the debug UART.
+ *
+ * The board ships with Adafruit's UF2 bootloader in the first 16 KiB of
+ * flash. Like that bootloader, the machine starts an image linked at
+ * 0x4000 (the application area, where CircuitPython lives) when nothing
+ * is loaded at 0: it puts the image's initial SP and reset vector at 0.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "hw/arm/boot.h"
+#include "hw/arm/machines-qom.h"
+#include "hw/arm/pic32cm_soc.h"
+#include "hw/block/sst26vf.h"
+#include "hw/core/boards.h"
+#include "hw/core/irq.h"
+#include "hw/core/loader.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/gpio/mchp_port.h"
+#include "hw/misc/led.h"
+#include "hw/ssi/mchp_qspi.h"
+#include "hw/ssi/ssi.h"
+#include "system/block-backend.h"
+#include "system/blockdev.h"
+#include "system/system.h"
+
+#define CCP_XOSC32K_HZ      32768
+#define CCP_APP_BASE        0x4000      /* after the UF2 bootloader */
+
+#define CCP_LED_PIN         MCHP_PORT_PIN('B', 23)
+#define CCP_USER_PIN        MCHP_PORT_PIN('A', 27)
+
+#define CCP_DEBUG_SERCOM    3       /* DEBUG_TX/RX (PA22/PA23) */
+#define CCP_BLE_SERCOM      2       /* BLE_TX/RX (PA12/PA13) to the RNBD451 */
+
+#define TYPE_CURIOSITY_CP_MACHINE MACHINE_TYPE_NAME("curiosity-circuitpython")
+OBJECT_DECLARE_SIMPLE_TYPE(CuriosityCpState, CURIOSITY_CP_MACHINE)
+
+struct CuriosityCpState {
+    MachineState parent_obj;
+
+    Pic32cmSocState soc;
+    Clock *xosc32k;
+    LEDState *led;
+    qemu_irq user;
+    bool user_pressed;
+    bool console_debug;             /* serial0 is the debug UART */
+};
+
+/* A pressed USER button pulls PA27 low; released, R20 pulls it high. */
+static void curiosity_cp_update_user(CuriosityCpState *s)
+{
+    if (s->user) {
+        qemu_set_irq(s->user, s->user_pressed ? 0 : 1);
+    }
+}
+
+static bool curiosity_cp_get_user(Object *obj, Error **errp)
+{
+    return CURIOSITY_CP_MACHINE(obj)->user_pressed;
+}
+
+static void curiosity_cp_set_user(Object *obj, bool value, Error **errp)
+{
+    CuriosityCpState *s = CURIOSITY_CP_MACHINE(obj);
+
+    s->user_pressed = value;
+    curiosity_cp_update_user(s);
+}
+
+/* The SST26VF032B on the QSPI bus, its chip select from the controller */
+static void curiosity_cp_add_flash(CuriosityCpState *s)
+{
+    DeviceState *qspi = pic32cm_soc_periph(&s->soc, "QSPI");
+    DriveInfo *dinfo = drive_get(IF_MTD, 0, 0);
+    DeviceState *flash = qdev_new(TYPE_SST26VF032B);
+
+    if (dinfo) {
+        qdev_prop_set_drive_err(flash, "drive", blk_by_legacy_dinfo(dinfo),
+                                &error_fatal);
+    }
+    qdev_realize_and_unref(flash, qdev_get_child_bus(qspi, "qspi.qspi"),
+                           &error_fatal);
+    qdev_connect_gpio_out_named(qspi, MCHP_QSPI_CS, 0,
+                                qdev_get_gpio_in_named(flash, SSI_GPIO_CS,
+                                                       0));
+}
+
+/*
+ * The UF2 bootloader's job: an image linked at the application area
+ * starts from its own vector table when nothing occupies 0.
+ */
+static void curiosity_cp_boot_app(void)
+{
+    static uint32_t stub[2];
+    const uint32_t *app = rom_ptr(CCP_APP_BASE, sizeof(stub));
+
+    if (rom_ptr(0, sizeof(stub)) || !app) {
+        return;
+    }
+    stub[0] = app[0];
+    stub[1] = app[1];
+    rom_add_blob_fixed("uf2-bootloader-jump", stub, sizeof(stub), 0);
+}
+
+static void curiosity_cp_init(MachineState *machine)
+{
+    CuriosityCpState *s = CURIOSITY_CP_MACHINE(machine);
+    DeviceState *soc, *port;
+
+    s->xosc32k = clock_new(OBJECT(machine), "xosc32k");
+    clock_set_hz(s->xosc32k, CCP_XOSC32K_HZ);
+
+    object_initialize_child(OBJECT(machine), "soc", &s->soc,
+                            TYPE_ATSAME51J20A_SOC);
+    soc = DEVICE(&s->soc);
+    qdev_connect_clock_in(soc, "xosc32k", s->xosc32k);
+    pic32cm_soc_connect_usb(&s->soc, serial_hd(s->console_debug ? 1 : 0));
+    pic32cm_soc_connect_serial(&s->soc, CCP_DEBUG_SERCOM,
+                               serial_hd(s->console_debug ? 0 : 1));
+    pic32cm_soc_connect_serial(&s->soc, CCP_BLE_SERCOM, serial_hd(2));
+    sysbus_realize(SYS_BUS_DEVICE(soc), &error_fatal);
+
+    port = pic32cm_soc_periph(&s->soc, "PORT");
+    s->led = led_create_simple(OBJECT(machine), GPIO_POLARITY_ACTIVE_HIGH,
+                               LED_COLOR_RED, "D13");
+    qdev_connect_gpio_out_named(port, MCHP_PORT_PAD, CCP_LED_PIN,
+                                qdev_get_gpio_in(DEVICE(s->led), 0));
+    s->user = qdev_get_gpio_in_named(port, MCHP_PORT_IN, CCP_USER_PIN);
+    curiosity_cp_update_user(s);
+    curiosity_cp_add_flash(s);
+
+    armv7m_load_kernel(s->soc.armv7m.cpu, machine->kernel_filename,
+                       s->soc.dev->flash_base, s->soc.dev->flash_size);
+    curiosity_cp_boot_app();
+}
+
+static char *curiosity_cp_get_console(Object *obj, Error **errp)
+{
+    return g_strdup(CURIOSITY_CP_MACHINE(obj)->console_debug ? "debug"
+                                                             : "usb");
+}
+
+static void curiosity_cp_set_console(Object *obj, const char *value,
+                                     Error **errp)
+{
+    CuriosityCpState *s = CURIOSITY_CP_MACHINE(obj);
+
+    if (!strcmp(value, "usb") || !strcmp(value, "debug")) {
+        s->console_debug = !strcmp(value, "debug");
+    } else {
+        error_setg(errp, "console must be usb or debug");
+    }
+}
+
+static void curiosity_cp_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    static const char *const valid_cpu_types[] = {
+        ARM_CPU_TYPE_NAME("cortex-m4"),
+        NULL
+    };
+
+    mc->desc = "Microchip Curiosity CircuitPython (EV78P89A, ATSAME51J20A, "
+               "Cortex-M4F)";
+    mc->init = curiosity_cp_init;
+    mc->max_cpus = 1;
+    mc->valid_cpu_types = valid_cpu_types;
+    mc->default_ram_size = 0;           /* SRAM is part of the SoC */
+    object_class_property_add_bool(oc, "user-pressed", curiosity_cp_get_user,
+                                   curiosity_cp_set_user);
+    object_class_property_set_description(oc, "user-pressed",
+                                          "Hold the USER button (PA27) down");
+    object_class_property_add_str(oc, "console", curiosity_cp_get_console,
+                                  curiosity_cp_set_console);
+    object_class_property_set_description(oc, "console",
+        "What serial0 is: usb (the USB CDC console, default) or debug (the "
+        "debug UART on SERCOM3)");
+}
+
+static const TypeInfo curiosity_cp_types[] = {
+    {
+        .name = TYPE_CURIOSITY_CP_MACHINE,
+        .parent = TYPE_MACHINE,
+        .instance_size = sizeof(CuriosityCpState),
+        .class_init = curiosity_cp_class_init,
+        .interfaces = arm_machine_interfaces,
+    },
+};
+
+DEFINE_TYPES(curiosity_cp_types)
