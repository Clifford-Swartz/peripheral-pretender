diff --git a/hw/sensor/isl29125.c b/hw/sensor/isl29125.c
new file mode 100644
index 0000000..01da58c
--- /dev/null
+++ b/hw/sensor/isl29125.c
@@ -0,0 +1,368 @@
+/*
+ * Renesas (Intersil) ISL29125 RGB colour light sensor
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * ISL29125 data sheet (FN8424): fifteen byte registers at I2C 0x44, read
+ * and written with an auto-incrementing pointer that wraps from 0x0E to
+ * 0x00. Writing CONFIG1 picks the mode (green, red, blue, or the three,
+ * green/red, green/blue in that order; standby and power-down stop), the
+ * range (375 or 10000 lux full scale) and 12- or 16-bit conversions, and
+ * restarts the conversions. A 16-bit conversion of one channel takes 101
+ * ms, a 12-bit one 1/16 of that; each finished channel lands in its data
+ * registers (green, red, blue, little-endian), STATUS.GRBCF tells which
+ * channel converts now. When the last channel of a cycle finishes,
+ * STATUS.CONVENF sets and, with CONFIG3.CONVEN, INT goes low. The channel
+ * CONFIG3.INTSEL chooses is compared with the thresholds: at or below the
+ * low one or above the high one for PRST (1, 2, 4 or 8) cycles in a row
+ * sets STATUS.RGBTHF and pulls INT low. Reading STATUS clears both flags
+ * and releases INT. STATUS.BOUTF is 1 from power-up until firmware writes
+ * it 0. Writing 0x46 to register 0x00 resets every register. SYNC mode
+ * (INT as a start input) and the IR compensation of CONFIG2 are stored but
+ * not modelled.
+ *
+ * The light: each sRGB component is linearised and times "lux" gives that
+ * channel's illuminance; counts are that over the full scale, plus the
+ * one-count dark level of the data sheet (so no channel reads 0, as
+ * MikroElektronika's colour classifier needs). No physical part checked
+ * it.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/i2c/i2c.h"
+#include "hw/core/irq.h"
+#include "hw/sensor/isl29125.h"
+#include "migration/vmstate.h"
+#include <math.h>
+
+#define REG_ID              0x00
+#define REG_CONFIG1         0x01
+#define REG_CONFIG2         0x02
+#define REG_CONFIG3         0x03
+#define REG_LT_L            0x04
+#define REG_HT_L            0x06
+#define REG_STATUS          0x08
+#define REG_DATA            0x09        /* green, red, blue: L, H */
+#define NREGS               0x0F
+
+#define DEVICE_ID           0x7D
+#define RESET_CMD           0x46
+
+#define CFG1_MODE           0x07
+#define CFG1_RNG            BIT(3)      /* 10000 lux */
+#define CFG1_BITS           BIT(4)      /* 12-bit */
+#define CFG3_INTSEL         0x03
+#define CFG3_PRST_SHIFT     2
+#define CFG3_CONVEN         BIT(4)
+#define ST_RGBTHF           BIT(0)
+#define ST_CONVENF          BIT(1)
+#define ST_BOUTF            BIT(2)
+#define ST_GRBCF_SHIFT      4
+
+#define CONV_NS             (101 * SCALE_MS)
+
+enum { CH_G, CH_R, CH_B, CH_NONE = -1 };
+
+/* The channels each mode converts, in order */
+static const int8_t isl_modes[8][4] = {
+    { CH_NONE },                        /* power-down */
+    { CH_G, CH_NONE },
+    { CH_R, CH_NONE },
+    { CH_B, CH_NONE },
+    { CH_NONE },                        /* standby */
+    { CH_G, CH_R, CH_B, CH_NONE },
+    { CH_G, CH_R, CH_NONE },
+    { CH_G, CH_B, CH_NONE },
+};
+
+OBJECT_DECLARE_SIMPLE_TYPE(Isl29125State, ISL29125)
+
+struct Isl29125State {
+    I2CSlave parent_obj;
+
+    uint8_t regs[NREGS];
+    uint8_t ptr;
+    bool ptr_set;               /* the first byte of a write came */
+    uint8_t step;               /* index into the mode's channels */
+    uint8_t persist;            /* cycles outside the window in a row */
+    bool irq_on;
+
+    uint32_t rgb[3];            /* the light: green, red, blue (sRGB) */
+    uint32_t lux;
+
+    QEMUTimer *timer;
+    qemu_irq irq;
+};
+
+static void isl_update_irq(Isl29125State *s)
+{
+    qemu_set_irq(s->irq, s->irq_on ? 0 : -1);   /* open drain */
+}
+
+static uint16_t isl_counts(Isl29125State *s, int ch)
+{
+    double v = MIN(s->rgb[ch], 255) / 255.0;
+    double lin = v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4);
+    double fs = s->regs[REG_CONFIG1] & CFG1_RNG ? 10000.0 : 375.0;
+    unsigned max = s->regs[REG_CONFIG1] & CFG1_BITS ? 4095 : 65535;
+    double c = lround(MIN(s->lux, 100000) * lin / fs * max) + 1;
+
+    return MIN(c, max);
+}
+
+static void isl_grbcf(Isl29125State *s)
+{
+    int ch = isl_modes[s->regs[REG_CONFIG1] & CFG1_MODE][s->step];
+
+    s->regs[REG_STATUS] &= ~(3 << ST_GRBCF_SHIFT);
+    if (ch != CH_NONE) {
+        s->regs[REG_STATUS] |= (ch + 1) << ST_GRBCF_SHIFT;
+    }
+}
+
+static int64_t isl_conv_ns(Isl29125State *s)
+{
+    return s->regs[REG_CONFIG1] & CFG1_BITS ? CONV_NS / 16 : CONV_NS;
+}
+
+/* CONFIG1 written: start over at the mode's first channel */
+static void isl_restart(Isl29125State *s)
+{
+    s->step = 0;
+    s->persist = 0;
+    isl_grbcf(s);
+    if (isl_modes[s->regs[REG_CONFIG1] & CFG1_MODE][0] != CH_NONE) {
+        timer_mod(s->timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + isl_conv_ns(s));
+    } else {
+        timer_del(s->timer);
+    }
+}
+
+static void isl_threshold(Isl29125State *s, int ch, uint16_t v)
+{
+    uint16_t lo = s->regs[REG_LT_L] | s->regs[REG_LT_L + 1] << 8;
+    uint16_t hi = s->regs[REG_HT_L] | s->regs[REG_HT_L + 1] << 8;
+    unsigned sel = s->regs[REG_CONFIG3] & CFG3_INTSEL;
+    unsigned need = 1 << ((s->regs[REG_CONFIG3] >> CFG3_PRST_SHIFT) & 3);
+
+    if (sel != (unsigned)ch + 1) {
+        return;
+    }
+    if (v <= lo || v > hi) {
+        if (++s->persist >= need) {
+            s->persist = need;
+            s->regs[REG_STATUS] |= ST_RGBTHF;
+            s->irq_on = true;
+        }
+    } else {
+        s->persist = 0;
+    }
+}
+
+static void isl_convert(void *opaque)
+{
+    Isl29125State *s = opaque;
+    const int8_t *seq = isl_modes[s->regs[REG_CONFIG1] & CFG1_MODE];
+    int ch = seq[s->step];
+    uint16_t v;
+
+    if (ch == CH_NONE) {
+        return;
+    }
+    v = isl_counts(s, ch);
+    s->regs[REG_DATA + 2 * ch] = v & 0xFF;
+    s->regs[REG_DATA + 2 * ch + 1] = v >> 8;
+    isl_threshold(s, ch, v);
+    if (seq[++s->step] == CH_NONE) {
+        s->step = 0;
+        s->regs[REG_STATUS] |= ST_CONVENF;
+        if (s->regs[REG_CONFIG3] & CFG3_CONVEN) {
+            s->irq_on = true;
+        }
+    }
+    isl_grbcf(s);
+    isl_update_irq(s);
+    timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              isl_conv_ns(s));
+}
+
+static void isl_reset_regs(Isl29125State *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[REG_HT_L] = 0xFF;
+    s->regs[REG_HT_L + 1] = 0xFF;
+    s->regs[REG_STATUS] = ST_BOUTF;
+    s->step = 0;
+    s->persist = 0;
+    s->irq_on = false;
+    timer_del(s->timer);
+    isl_update_irq(s);
+}
+
+static void isl_write(Isl29125State *s, uint8_t reg, uint8_t v)
+{
+    switch (reg) {
+    case REG_ID:
+        if (v == RESET_CMD) {
+            isl_reset_regs(s);
+        }
+        break;
+    case REG_CONFIG1:
+        s->regs[reg] = v & 0x3F;
+        isl_restart(s);
+        break;
+    case REG_CONFIG2:
+        s->regs[reg] = v & 0xBF;
+        break;
+    case REG_CONFIG3:
+        s->regs[reg] = v & 0x1F;
+        break;
+    case REG_LT_L ... REG_HT_L + 1:
+        s->regs[reg] = v;
+        break;
+    case REG_STATUS:
+        if (!(v & ST_BOUTF)) {
+            s->regs[reg] &= ~ST_BOUTF;
+        }
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "isl29125: write 0x%02x to read-only 0x%02x\n", v, reg);
+        break;
+    }
+}
+
+static uint8_t isl_read(Isl29125State *s, uint8_t reg)
+{
+    uint8_t v;
+
+    if (reg == REG_ID) {
+        return DEVICE_ID;
+    }
+    v = s->regs[reg];
+    if (reg == REG_STATUS) {
+        s->regs[reg] &= ~(ST_RGBTHF | ST_CONVENF);
+        s->irq_on = false;
+        isl_update_irq(s);
+    }
+    return v;
+}
+
+static int isl_event(I2CSlave *i2c, enum i2c_event event)
+{
+    Isl29125State *s = ISL29125(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->ptr_set = false;
+    }
+    return 0;
+}
+
+static int isl_send(I2CSlave *i2c, uint8_t data)
+{
+    Isl29125State *s = ISL29125(i2c);
+
+    if (!s->ptr_set) {
+        s->ptr = data % NREGS;
+        s->ptr_set = true;
+    } else {
+        isl_write(s, s->ptr, data);
+        s->ptr = (s->ptr + 1) % NREGS;
+    }
+    return 0;
+}
+
+static uint8_t isl_recv(I2CSlave *i2c)
+{
+    Isl29125State *s = ISL29125(i2c);
+    uint8_t v = isl_read(s, s->ptr);
+
+    s->ptr = (s->ptr + 1) % NREGS;
+    return v;
+}
+
+static void isl_reset(DeviceState *dev)
+{
+    Isl29125State *s = ISL29125(dev);
+
+    s->ptr = 0;
+    s->ptr_set = false;
+    isl_reset_regs(s);
+}
+
+static void isl_init(Object *obj)
+{
+    Isl29125State *s = ISL29125(obj);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, isl_convert, s);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->irq, ISL29125_INT, 1);
+    s->rgb[CH_R] = 255;
+    s->rgb[CH_G] = 0;
+    s->rgb[CH_B] = 0;
+    s->lux = 5000;
+    object_property_add_uint32_ptr(obj, "green", &s->rgb[CH_G],
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "red", &s->rgb[CH_R],
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "blue", &s->rgb[CH_B],
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "lux", &s->lux,
+                                   OBJ_PROP_FLAG_READWRITE);
+}
+
+static void isl_finalize(Object *obj)
+{
+    timer_free(ISL29125(obj)->timer);
+}
+
+static const VMStateDescription vmstate_isl = {
+    .name = TYPE_ISL29125,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, Isl29125State),
+        VMSTATE_UINT8_ARRAY(regs, Isl29125State, NREGS),
+        VMSTATE_UINT8(ptr, Isl29125State),
+        VMSTATE_BOOL(ptr_set, Isl29125State),
+        VMSTATE_UINT8(step, Isl29125State),
+        VMSTATE_UINT8(persist, Isl29125State),
+        VMSTATE_BOOL(irq_on, Isl29125State),
+        VMSTATE_UINT32_ARRAY(rgb, Isl29125State, 3),
+        VMSTATE_UINT32(lux, Isl29125State),
+        VMSTATE_TIMER_PTR(timer, Isl29125State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void isl_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->desc = "ISL29125 RGB colour light sensor";
+    dc->vmsd = &vmstate_isl;
+    device_class_set_legacy_reset(dc, isl_reset);
+    k->event = isl_event;
+    k->send = isl_send;
+    k->recv = isl_recv;
+}
+
+static const TypeInfo isl_types[] = {
+    {
+        .name = TYPE_ISL29125,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(Isl29125State),
+        .instance_init = isl_init,
+        .instance_finalize = isl_finalize,
+        .class_init = isl_class_init,
+    },
+};
+
+DEFINE_TYPES(isl_types)
