diff --git a/include/hw/sensor/isl29125.h b/include/hw/sensor/isl29125.h
new file mode 100644
index 0000000..4d944e4
--- /dev/null
+++ b/include/hw/sensor/isl29125.h
@@ -0,0 +1,22 @@
+/*
+ * Renesas (Intersil) ISL29125 RGB colour light sensor
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * I2C address 0x44. The light it sees: "red", "green", "blue" (sRGB,
+ * 0-255) and "lux" (the brightness of white, 0-100000), settable while
+ * running. GPIO output "int": the open-drain INT pin, 0 while driven low,
+ * -1 while released.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SENSOR_ISL29125_H
+#define HW_SENSOR_ISL29125_H
+
+#define TYPE_ISL29125 "isl29125"
+#define ISL29125_ADDR 0x44
+#define ISL29125_INT "int"
+
+#endif /* HW_SENSOR_ISL29125_H */
diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index 0b0eb01..736d1e6 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -1008,6 +1008,81 @@ static void test_pot(void)
     qtest_quit(qts);
 }
 
+/*
+ * Color 2 Click: ISL29125 at 0x44 on EXT1, INT (PB02) open drain with the
+ * Click's pull-up. G/R/B at 10000 lux and 16 bits (MikroElektronika's
+ * set-up) sees pure red at 5000 lux as half scale on red, the dark count
+ * on the others; the conversion-done interrupt clears on a STATUS read.
+ */
+#define ISL29125        0x44
+
+static uint8_t isl_reg(QTestState *qts, uint8_t reg)
+{
+    uint8_t v;
+
+    i2c_rd(qts, ISL29125, reg, &v, 1);
+    return v;
+}
+
+static void isl_rgb(QTestState *qts, unsigned *g, unsigned *r, unsigned *b)
+{
+    uint8_t d[6];
+
+    i2c_rd(qts, ISL29125, 0x09, d, 6);
+    *g = d[0] | d[1] << 8;
+    *r = d[2] | d[3] << 8;
+    *b = d[4] | d[5] << 8;
+}
+
+static void test_color2(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext1=color2 ");
+    unsigned g, r, b;
+
+    g_assert_cmphex(isl_reg(qts, 0x00), ==, 0x7D);
+    g_assert_cmphex(isl_reg(qts, 0x08), ==, 0x04);          /* BOUTF */
+    g_assert_true(int_high(qts));
+    g_assert_true(i2c_wr(qts, ISL29125, 0x01,
+                         (const uint8_t[]){ 0x0D, 0x3F, 0x10 }, 3));
+    g_assert_cmphex(isl_reg(qts, 0x08), ==, 0x14);          /* G now */
+    qtest_clock_step(qts, 2 * 101 * SCALE_MS);
+    g_assert_true(int_high(qts));                           /* G, R done */
+    qtest_clock_step(qts, 101 * SCALE_MS);
+    g_assert_false(int_high(qts));                          /* B done */
+    g_assert_cmphex(isl_reg(qts, 0x08), ==, 0x16);  /* CONVENF, G again */
+    g_assert_true(int_high(qts));
+    isl_rgb(qts, &g, &r, &b);
+    g_assert_cmpuint(g, ==, 1);
+    g_assert_cmpuint(r, ==, 32769);
+    g_assert_cmpuint(b, ==, 1);
+
+    /* Green at the full 10000 lux; 12-bit conversions */
+    qom_set_int(qts, CLICK1, "red", 0);
+    qom_set_int(qts, CLICK1, "green", 255);
+    qom_set_int(qts, CLICK1, "lux", 10000);
+    g_assert_true(i2c_wr(qts, ISL29125, 0x01,
+                         (const uint8_t[]){ 0x1D }, 1));
+    qtest_clock_step(qts, 3 * 101 * SCALE_MS / 16 + SCALE_MS);
+    isl_rgb(qts, &g, &r, &b);
