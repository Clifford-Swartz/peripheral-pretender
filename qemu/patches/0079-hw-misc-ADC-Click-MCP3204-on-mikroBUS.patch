+/* ADC Click on EXT1: MCP3204 on SPI (CS# PA17), inputs on terminals */
+static void test_adc(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=adc ");
+    static const unsigned mv[4] = { 1650, 3300, 825, 0 };
+    static const unsigned code[4] = { 2048, 4095, 1024, 0 };
+
+    g_assert_true(pin_high(qts, PA, 17));               /* R7 pull-up */
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);
+    qtest_writel(qts, SERCOM1 + 0x04, BIT(17));         /* RXEN */
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));
+    qtest_writel(qts, PA + P_DIRSET, BIT(17));
+    for (unsigned ch = 0; ch < 4; ch++) {
+        g_autofree char *name = g_strdup_printf("in%u", ch);
+
+        qom_set_int(qts, CLICK1, name, mv[ch]);
+    }
+    for (unsigned ch = 0; ch < 4; ch++) {
+        g_assert_cmpuint(mcp3204_read(qts, 0x06 | ch >> 2, (ch & 3) << 6),
+                         ==, code[ch]);
+    }
+    /* CH0 - CH1 differential: below zero reads 0 */
+    g_assert_cmpuint(mcp3204_read(qts, 0x04, 0x00), ==, 0);
+    qtest_quit(qts);
+}
+
 /* I2C on SERCOM2 (as mcp_write/mcp_read) to any address */
 static bool i2c_wr(QTestState *qts, uint8_t addr, uint8_t reg,
                    const uint8_t *d, unsigned n)
@@ -1449,6 +1476,7 @@ int main(int argc, char **argv)
     qtest_add_func("pic32cm-click/two-spi", test_two_spi);
     qtest_add_func("pic32cm-click/oledc", test_oledc);
     qtest_add_func("pic32cm-click/thumbstick", test_thumbstick);
+    qtest_add_func("pic32cm-click/adc", test_adc);
     qtest_add_func("pic32cm-click/accel", test_accel);
     qtest_add_func("pic32cm-click/rtc6-time", test_rtc6_time);
     qtest_add_func("pic32cm-click/rtc6-alarm", test_rtc6_alarm);
