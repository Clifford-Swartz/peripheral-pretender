+/* ADC Click (MCP3204) on mikroBUS 1: CS on PA7 */
+static void test_adc_mb1(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb1=adc -kernel %s",
+                                  (const char *)fw);
+    unsigned hi, lo;
+
+    g_assert_cmphex(qtest_readb(qts, PORTA + P_IN) & BIT(7), ==, BIT(7));
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/mb1-click',"
+                             " 'property': 'in2', 'value': 2475 } }");
+    qtest_writeb(qts, PORTA + 0x05, BIT(7));                    /* OUTSET */
+    qtest_writeb(qts, PORTA + 0x01, BIT(4) | BIT(6) | BIT(7));  /* DIRSET */
+    qtest_writeb(qts, SPI0 + 0, 0x21);                  /* MASTER, ENABLE */
+    qtest_writeb(qts, PORTA + 0x06, BIT(7));                    /* OUTCLR */
+    g_assert_cmphex(spi0_xfer(qts, 0x06), ==, 0);       /* start, single */
+    hi = spi0_xfer(qts, 0x80);                          /* CH2 */
+    lo = spi0_xfer(qts, 0x00);
+    qtest_writeb(qts, PORTA + 0x05, BIT(7));
+    g_assert_cmpuint((hi & 0x0f) << 8 | lo, ==, 3072);  /* 3/4 of VREF */
+    qtest_quit(qts);
+}
