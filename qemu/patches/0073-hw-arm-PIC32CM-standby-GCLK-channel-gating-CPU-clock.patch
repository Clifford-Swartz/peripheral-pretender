+void arm_cpu_sleep_notify(ARMCPU *cpu, bool asleep)
+{
+    bool locked = bql_locked();
+
+    if (!cpu->sleep_hook) {
+        return;
+    }
+    if (!locked) {
+        bql_lock();
+    }
+    cpu->sleep_hook(cpu->sleep_opaque, asleep);
+    if (!locked) {
