index 0000000..266411e
--- /dev/null
+++ b/tests/qtest/pic32cm-pm-test.c
@@ -0,0 +1,130 @@
+/*
+ * QTest for standby on the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The SoC's "standby" property does what a WFI with PM.SLEEPCFG =
+ * STANDBY does: GCLK channels that no peripheral asks for stop, the CPU
+ * clock (SysTick) stops. firmware/hello APP=sleep checks the same against
+ * silicon.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+#define SOC_PATH        "/machine/soc"
+
+#define GCLK_PCHCTRL    0x40001C80
+#define TC0             0x42003000
+#define TC2             0x42003800
+#define TC0_GCLK_ID     25              /* TC0 and TC1 */
+#define TC2_GCLK_ID     26              /* TC2 and TC3 */
+#define R_CTRLA         0x00
+#define R_CTRLBSET      0x05
+#define R_COUNT         0x14
+#define ENABLE          BIT(1)
+#define RUNSTDBY        BIT(6)
+#define CMD_READSYNC    (4 << 5)
+#define SYST_CSR        0xE000E010
+#define SYST_RVR        0xE000E014
+#define SYST_CVR        0xE000E018
+#define MS              1000000
+
+static void standby(QTestState *qts, bool on)
+{
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments':"
+                             " { 'path': '" SOC_PATH "',"
+                             " 'property': 'standby', 'value': %i } }", on);
+}
+
+/* TC @base in COUNT16 on GCLK0 (4 MHz): a tick every 250 ns */
+static void tc_start(QTestState *qts, uint32_t base, unsigned id,
+                     uint32_t ctrla)
+{
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * id, 0x40);
+    qtest_writel(qts, base + R_CTRLA, ctrla);
+    qtest_writel(qts, base + R_CTRLA, ctrla | ENABLE);
+}
+
+static uint32_t tc_count(QTestState *qts, uint32_t base)
+{
+    qtest_writeb(qts, base + R_CTRLBSET, CMD_READSYNC);
+    return qtest_readw(qts, base + R_COUNT);
+}
+
+/*
+ * TC0 without RUNSTDBY stops in standby; TC2 with it runs; so does TC1 on
+ * TC0's channel once TC1 asks for it (silicon: everyone on a running
+ * channel counts)
+ */
+static void test_channels(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    uint32_t a, b;
+
+    tc_start(qts, TC0, TC0_GCLK_ID, 0);
+    tc_start(qts, TC2, TC2_GCLK_ID, RUNSTDBY);
+    qtest_clock_step(qts, 1000);
+    a = tc_count(qts, TC0);
+    b = tc_count(qts, TC2);
+    standby(qts, true);
+    qtest_clock_step(qts, 5000);                /* 20 ticks */
+    standby(qts, false);
+    g_assert_cmpuint(tc_count(qts, TC0), ==, a);
+    g_assert_cmpuint(tc_count(qts, TC2), ==, (b + 20) & 0xFFFF);
+    qtest_clock_step(qts, 2500);                /* 10 ticks, awake */
+    g_assert_cmpuint(tc_count(qts, TC0), ==, (a + 10) & 0xFFFF);
+    qtest_quit(qts);
+}
+
+/* TC1 with RUNSTDBY keeps the shared channel, and TC0 with it, running */
+static void test_shared_channel(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    uint32_t a;
+
+    tc_start(qts, TC0, TC0_GCLK_ID, 0);
+    tc_start(qts, TC0 + 0x400, TC0_GCLK_ID, RUNSTDBY);      /* TC1 */
+    qtest_clock_step(qts, 1000);
+    a = tc_count(qts, TC0);
+    standby(qts, true);
+    qtest_clock_step(qts, 5000);
+    standby(qts, false);
+    g_assert_cmpuint(tc_count(qts, TC0), ==, (a + 20) & 0xFFFF);
+    qtest_quit(qts);
+}
+
+/* SysTick on the CPU clock holds its count in standby and goes on after */
+static void test_systick(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    uint32_t v;
+
+    qtest_writel(qts, SYST_RVR, 0xFFFFFF);
+    qtest_writel(qts, SYST_CVR, 0);
+    qtest_writel(qts, SYST_CSR, 0x5);           /* CPU clock, enabled */
+    qtest_clock_step(qts, MS);
+    standby(qts, true);
+    v = qtest_readl(qts, SYST_CVR);
+    qtest_clock_step(qts, 10 * MS);
+    g_assert_cmphex(qtest_readl(qts, SYST_CVR), ==, v);
+    standby(qts, false);
+    qtest_clock_step(qts, MS);
+    g_assert_cmphex(qtest_readl(qts, SYST_CVR), <, v);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-pm/channels", test_channels);
+    qtest_add_func("pic32cm-pm/shared-channel", test_shared_channel);
+    qtest_add_func("pic32cm-pm/systick", test_systick);
+    return g_test_run();
+}
