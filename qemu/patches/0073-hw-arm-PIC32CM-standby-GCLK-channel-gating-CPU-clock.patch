diff --git a/hw/arm/pic32cm_soc.c b/hw/arm/pic32cm_soc.c
index e7e0fef..e501d6e 100644
--- a/hw/arm/pic32cm_soc.c
+++ b/hw/arm/pic32cm_soc.c
@@ -43,6 +43,7 @@
 #include "hw/ssi/mchp_qspi.h"
 #include "system/address-spaces.h"
 #include "target/arm/cpu-qom.h"
+#include "target/arm/cpu.h"
 
 /*
  * The QOM type modelling each ATDF module (and IP id, where devices carry
@@ -1083,6 +1084,98 @@ static void pic32cm_connect_resets(Pic32cmSocState *s)
                                R_MCHP_RSTC_RCAUSE_WDT_SHIFT));
 }
 
+/*
+ * Standby (PM.SLEEPCFG = STANDBY at a WFI), as PIC32CM MC00 silicon showed
+ * it (firmware/hello APP=sleepprobe, sleepprobe2): a GCLK channel keeps
+ * running only while one of its peripherals asks for it, an enabled one
+ * with RUNSTDBY (then every peripheral on that channel counts, RUNSTDBY or
+ * not); the generators and oscillators run on demand whatever their own
+ * RUNSTDBY says; the CPU clock and so SysTick stop. Channels with no
+ * instance that has a RUNSTDBY bit (EIC, EVSYS, FREQM, the FDPLL96M
+ * reference) keep running, as do the RTC and the WDT on their 32 kHz
+ * clocks: they and the peripherals still running wake the core.
+ */
+#define PIC32CM_PM_SLEEPCFG     0x01
+#define PIC32CM_PM_STANDBY      4
+
+/* Instance @i asks for its GCLK channels in standby */
+static bool pic32cm_runs_in_standby(Pic32cmSocState *s, unsigned i)
+{
+    const MchpInstanceInfo *info = &s->dev->instances[i];
+    uint32_t both = info->standby_mask | info->standby_enable;
+    uint32_t v;
+
+    if (!info->standby_mask ||
+        !object_dynamic_cast(OBJECT(s->periph[i]), TYPE_MCHP_REGBLOCK)) {
+        return true;            /* no RUNSTDBY: its clock is not ours to stop */
+    }
+    v = mchp_regfile_peek(&MCHP_REGBLOCK(s->periph[i])->rf,
+                          info->standby_offset,
+                          both > 0xFFFF ? 4 : both > 0xFF ? 2 : 1);
+    return (v & info->standby_mask) && (v & info->standby_enable);
+}
+
+/* The GCLK channels that keep running in standby */
+static uint64_t pic32cm_standby_channels(Pic32cmSocState *s)
+{
+    uint64_t used = 0, keep = 0;
+
+    for (unsigned i = 0; i < s->dev->ninstances; i++) {
+        const MchpInstanceInfo *info = &s->dev->instances[i];
+        int16_t ch[2] = { info->gclk_core, info->gclk_slow };
+
+        if (!s->periph[i]) {
+            continue;
+        }
+        for (unsigned k = 0; k < ARRAY_SIZE(ch); k++) {
+            if (ch[k] < 0 || ch[k] >= 64) {
+                continue;
+            }
+            used |= BIT_ULL(ch[k]);
+            if (pic32cm_runs_in_standby(s, i)) {
+                keep |= BIT_ULL(ch[k]);
+            }
+        }
+    }
+    return keep | ~used;
+}
+
+static void pic32cm_set_standby(Pic32cmSocState *s, bool standby)
+{
+    DeviceState *gclk = pic32cm_periph(s, "GCLK");
+    DeviceState *mclk = pic32cm_periph(s, "MCLK");
+
+    if (standby == s->standby || !gclk || !mclk) {
+        return;
+    }
+    s->standby = standby;
+    mchp_gclk_set_standby(gclk, standby,
+                          standby ? pic32cm_standby_channels(s) : 0);
+    mchp_mclk_set_standby(mclk, standby);
+}
+
+/* The CPU's sleep hook: WFI halted it (@asleep) or it woke up */
+static void pic32cm_sleep(void *opaque, bool asleep)
+{
+    Pic32cmSocState *s = opaque;
+    DeviceState *pm = pic32cm_periph(s, "PM");
+    uint32_t mode = pm ? mchp_regfile_peek(&MCHP_REGBLOCK(pm)->rf,
+                                           PIC32CM_PM_SLEEPCFG, 1) & 7 : 0;
+
+    pic32cm_set_standby(s, asleep && mode == PIC32CM_PM_STANDBY);
+}
+
+/* "standby": the sleep state, also settable (qtest) */
+static bool pic32cm_get_standby(Object *obj, Error **errp)
+{
+    return PIC32CM_SOC(obj)->standby;
+}
+
+static void pic32cm_set_standby_prop(Object *obj, bool value, Error **errp)
+{
+    pic32cm_set_standby(PIC32CM_SOC(obj), value);
+}
+
 static void pic32cm_soc_realize(DeviceState *dev, Error **errp)
 {
     Pic32cmSocState *s = PIC32CM_SOC(dev);
@@ -1109,6 +1202,8 @@ static void pic32cm_soc_realize(DeviceState *dev, Error **errp)
     pic32cm_dmac_pulses(s);
     pic32cm_connect_pads(s);
     pic32cm_analog_pads(s);
+    s->armv7m.cpu->sleep_hook = pic32cm_sleep;
+    s->armv7m.cpu->sleep_opaque = s;
     for (unsigned i = 0; i < s->dev->ninstances; i++) {
         if (s->periph[i] && object_property_find(OBJECT(s->periph[i]),
                                                  "vdd")) {
@@ -1125,10 +1220,19 @@ static const Property pic32cm_soc_properties[] = {
     DEFINE_PROP_INT32("vddana", Pic32cmSocState, vddana_mv, 3300),
 };
 
+/* A reset wakes the part: GCLK and MCLK leave standby in their own reset */
+static void pic32cm_soc_reset_hold(Object *obj, ResetType type)
+{
+    PIC32CM_SOC(obj)->standby = false;
+}
+
 static void pic32cm_soc_class_init(ObjectClass *klass, const void *data)
 {
     DeviceClass *dc = DEVICE_CLASS(klass);
 
+    RESETTABLE_CLASS(klass)->phases.hold = pic32cm_soc_reset_hold;
+    object_class_property_add_bool(klass, "standby", pic32cm_get_standby,
+                                   pic32cm_set_standby_prop);
     dc->realize = pic32cm_soc_realize;
     device_class_set_props(dc, pic32cm_soc_properties);
     /* Reason: mapped at fixed addresses on the system bus */
diff --git a/hw/misc/mchp_clock.c b/hw/misc/mchp_clock.c
index de71b58..85744ba 100644
--- a/hw/misc/mchp_clock.c
+++ b/hw/misc/mchp_clock.c
@@ -14,6 +14,12 @@
  * An oscillator is ready as soon as it is enabled (and its crystal, if it
  * needs one, is fitted), FDPLL96M locks as soon as it has a reference, and
  * every synchronization completes instantly (SYNCBUSY reads 0).
+ *
+ * Standby (mchp_gclk_set_standby(), mchp_mclk_set_standby(), driven by the
+ * SoC from PM.SLEEPCFG): a peripheral channel runs only if one of its
+ * peripherals asks for it, whatever GENCTRL.RUNSTDBY and the oscillators'
+ * RUNSTDBY say (PIC32CM MC00 silicon, firmware/hello APP=sleepprobe2: a
+ * requested clock runs on demand); the CPU clock stops.
  * References: DS60001632H chapters 14 (GCLK), 15 (MCLK), 16 (OSC32KCTRL)
  * and 17 (OSCCTRL).
  *
@@ -551,6 +557,8 @@ struct MchpGclkState {
     Clock *src[MCHP_GCLK_NSRC];
     Clock *gen[MCHP_GCLK_GENCTRL_COUNT];
     Clock *pch[MCHP_GCLK_PCHCTRL_COUNT];
+    bool standby;
+    uint64_t keep;                  /* channels running in standby */
     /* Generators and channels this device has (the constants: the most) */
     unsigned ngen;
     unsigned npch;
@@ -620,7 +628,8 @@ static void mchp_gclk_compute(MchpRegBlock *rb)
     for (unsigned m = 0; m < s->npch; m++) {
         uint32_t ctrl = mchp_clk_reg(rb, A_MCHP_GCLK_PCHCTRL + 4 * m, 4);
         uint32_t gen = FIELD_EX32(ctrl, MCHP_GCLK_PCHCTRL, GEN);
-        bool on = FIELD_EX32(ctrl, MCHP_GCLK_PCHCTRL, CHEN) && gen < s->ngen;
+        bool on = FIELD_EX32(ctrl, MCHP_GCLK_PCHCTRL, CHEN) && gen < s->ngen &&
+                  (!s->standby || extract64(s->keep, m, 1));
 
         mchp_regblock_set_clock_period(rb, s->pch[m], on ? period[gen] : 0);
     }
@@ -636,6 +645,15 @@ static void mchp_gclk_clk_update(void *opaque, ClockEvent event)
     mchp_gclk_update(MCHP_GCLK(opaque));
 }
 
+void mchp_gclk_set_standby(DeviceState *dev, bool standby, uint64_t keep)
+{
+    MchpGclkState *s = MCHP_GCLK(dev);
+
+    s->standby = standby;
+    s->keep = keep;
+    mchp_gclk_update(s);
+}
+
 static void mchp_gclk_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
                                  unsigned idx, uint32_t old,
                                  uint32_t written, uint32_t we)
@@ -662,6 +680,7 @@ static void mchp_gclk_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
 
 static void mchp_gclk_reset_exit(MchpRegBlock *rb)
 {
+    MCHP_GCLK(rb)->standby = false;
     mchp_gclk_update(MCHP_GCLK(rb));
 }
 
@@ -713,11 +732,13 @@ static void mchp_gclk_init(Object *obj)
 
 static const VMStateDescription vmstate_mchp_gclk = {
     .name = TYPE_MCHP_GCLK,
-    .version_id = 3,
-    .minimum_version_id = 3,
+    .version_id = 4,
+    .minimum_version_id = 4,
     .fields = (const VMStateField[]) {
         VMSTATE_STRUCT(parent_obj, MchpGclkState, 1, vmstate_mchp_regblock,
                        MchpRegBlock),
+        VMSTATE_BOOL(standby, MchpGclkState),
+        VMSTATE_UINT64(keep, MchpGclkState),
         VMSTATE_ARRAY_CLOCK(src, MchpGclkState, MCHP_GCLK_NSRC),
         VMSTATE_ARRAY_CLOCK(gen, MchpGclkState, MCHP_GCLK_GENCTRL_COUNT),
         VMSTATE_ARRAY_CLOCK(pch, MchpGclkState, MCHP_GCLK_PCHCTRL_COUNT),
@@ -745,6 +766,7 @@ struct MchpMclkState {
 
     Clock *main;
     Clock *cpu;
+    bool standby;               /* the CPU clock is stopped */
 };
 
 static void mchp_mclk_update(MchpMclkState *s)
@@ -752,7 +774,16 @@ static void mchp_mclk_update(MchpMclkState *s)
     MchpRegBlock *rb = MCHP_REGBLOCK(s);
     uint32_t div = mchp_clk_reg(rb, A_MCHP_MCLK_CPUDIV, 1);
 
-    mchp_regblock_set_clock(rb, s->cpu, div ? clock_get_hz(s->main) / div : 0);
+    mchp_regblock_set_clock(rb, s->cpu, div && !s->standby ?
+                            clock_get_hz(s->main) / div : 0);
+}
+
+void mchp_mclk_set_standby(DeviceState *dev, bool standby)
+{
+    MchpMclkState *s = MCHP_MCLK(dev);
+
+    s->standby = standby;
+    mchp_mclk_update(s);
 }
 
 static void mchp_mclk_clk_update(void *opaque, ClockEvent event)
@@ -782,6 +813,7 @@ static void mchp_mclk_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
 
 static void mchp_mclk_reset_exit(MchpRegBlock *rb)
 {
+    MCHP_MCLK(rb)->standby = false;
     mchp_mclk_update(MCHP_MCLK(rb));
 }
 
@@ -796,11 +828,12 @@ static void mchp_mclk_init(Object *obj)
 
 static const VMStateDescription vmstate_mchp_mclk = {
     .name = TYPE_MCHP_MCLK,
-    .version_id = 2,
-    .minimum_version_id = 2,
+    .version_id = 3,
+    .minimum_version_id = 3,
     .fields = (const VMStateField[]) {
         VMSTATE_STRUCT(parent_obj, MchpMclkState, 1, vmstate_mchp_regblock,
                        MchpRegBlock),
