diff --git a/hw/timer/armv7m_systick.c b/hw/timer/armv7m_systick.c
index 65cfaf4..dddd5c8 100644
--- a/hw/timer/armv7m_systick.c
+++ b/hw/timer/armv7m_systick.c
@@ -220,10 +220,22 @@ static void systick_cpuclk_update(void *opaque, ClockEvent event)
 
     if (!(s->control & SYSTICK_CLKSOURCE)) {
         /* currently using refclk, we can ignore cpuclk changes */
+        return;
     }
 
     ptimer_transaction_begin(s->ptimer);
-    ptimer_set_period_from_clock(s->ptimer, s->cpuclk, 1);
+    if (!clock_is_enabled(s->cpuclk)) {
+        /*
+         * Peripheral Pretender: a stopped CPU clock (standby) holds the
+         * count; a ptimer with period 0 would disable itself instead
+         */
+        ptimer_stop(s->ptimer);
+    } else {
+        ptimer_set_period_from_clock(s->ptimer, s->cpuclk, 1);
+        if (s->control & SYSTICK_ENABLE) {
+            ptimer_run(s->ptimer, 0);
+        }
+    }
     ptimer_transaction_commit(s->ptimer);
 }
 
diff --git a/hw/timer/mchp_tc.c b/hw/timer/mchp_tc.c
index 960e4e7..4e2fc23 100644
--- a/hw/timer/mchp_tc.c
+++ b/hw/timer/mchp_tc.c
@@ -1048,9 +1048,28 @@ static void mchp_tc_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
 static void mchp_tc_gclk_update(MchpRegBlock *rb, ClockEvent event)
 {
     MchpTcState *s = MCHP_TC(rb);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
 
-    /* Count at the old rate up to now, then reschedule at the new one */
-    mchp_tc_advance(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    if (event == ClockPreUpdate) {
+        if (mchp_tc_hz(s)) {
+            /*
+             * Count at the old rate up to now, the ticks since the last
+             * event included
+             */
+            uint64_t ticks;
+
+            mchp_tc_advance(s, now);
+            ticks = mchp_tc_ticks(s, now);
+            s->count = mchp_tc_value(s, ticks);
+            mchp_tc_base_tick(s, ticks);
+            mchp_tc_wo_resync(s);
+            mchp_tc_update_pads(s);
+        } else {
+            mchp_tc_base_set(s, now);   /* stopped (standby): no ticks */
+        }
+        return;
+    }
+    mchp_tc_advance(s, now);            /* reschedule at the new rate */
 }
 
 static void mchp_tc_reset_hold(MchpRegBlock *rb)
diff --git a/hw/timer/mchp_tcc.c b/hw/timer/mchp_tcc.c
index 5916bfa..332d19d 100644
--- a/hw/timer/mchp_tcc.c
+++ b/hw/timer/mchp_tcc.c
@@ -2083,9 +2083,22 @@ static void tcc_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
 static void tcc_gclk_update(MchpRegBlock *rb, ClockEvent event)
 {
     MchpTccState *s = MCHP_TCC(rb);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
 
-    /* Count at the old rate up to now, then reschedule at the new one */
-    tcc_advance(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    if (event == ClockPreUpdate) {
+        if (tcc_hz(s)) {
+            /*
+             * Count at the old rate up to now, the ticks since the last
+             * event included
+             */
+            tcc_advance(s, now);
+            tcc_jump(s, tcc_ticks(s, now));
+        } else {
+            tcc_base_set(s, now);       /* stopped (standby): no ticks */
+        }
+        return;
+    }
+    tcc_advance(s, now);                /* reschedule at the new rate */
 }
 
 static void tcc_reset_hold(MchpRegBlock *rb)
