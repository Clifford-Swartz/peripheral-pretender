diff --git a/include/hw/misc/emc2301.h b/include/hw/misc/emc2301.h
new file mode 100644
index 0000000..8aebaad
--- /dev/null
+++ b/include/hw/misc/emc2301.h
@@ -0,0 +1,24 @@
+/*
+ * Microchip EMC2301 RPM-based PWM fan controller, with a fan on it
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * I2C address 0x2F. GPIO output "alert": the open-drain ALERT# pin, 0
+ * while driven low, -1 while released. The fan on its PWM and TACH:
+ * "max-rpm" at full drive (default 4000), "min-duty" in per mille below
+ * which it stops (200), "tau-ms" its time constant (700), "poles" (2),
+ * "blocked" (holds it still); read-only "rpm" and "duty" (per mille, the
+ * PWM it gets).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_EMC2301_H
+#define HW_MISC_EMC2301_H
+
+#define TYPE_EMC2301 "emc2301"
+#define EMC2301_ADDR 0x2F
+#define EMC2301_ALERT "alert"
+
+#endif /* HW_MISC_EMC2301_H */
