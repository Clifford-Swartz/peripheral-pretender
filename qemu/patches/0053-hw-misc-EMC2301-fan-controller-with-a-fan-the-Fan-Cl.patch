+                             " 'path': %s, 'property': %s, 'value': %i } }",
+                             path, prop, v);
+}
+
 /* Thumbstick Click on EXT1: MCP3204 on SPI (CS# PA17), switch on INT */
 static void test_thumbstick(void)
 {
@@ -1145,6 +1153,89 @@ static void test_weather(void)
     qtest_quit(qts);
 }
 
+/*
+ * Fan Click: EMC2301 at 0x2F on EXT1. Identity, Direct Setting at 50 %
+ * spins the fan to about 2000 RPM (TACH Reading 3932 at the reset
+ * settings), the RPM-based algorithm settles on a target, a blocked fan
+ * sets FNSTL and pulls ALERT# with the interrupt on; reading clears it
+ * once the fan turns again. The power-up watchdog drives 100 %.
+ */
+#define EMC2301         0x2F
+
+static uint8_t emc_reg(QTestState *qts, uint8_t reg)
+{
+    uint8_t v;
+
+    i2c_rd(qts, EMC2301, reg, &v, 1);
+    return v;
+}
+
+static void emc_set(QTestState *qts, uint8_t reg, uint8_t v)
+{
+    g_assert_true(i2c_wr(qts, EMC2301, reg, &v, 1));
+}
+
+static unsigned emc_tach(QTestState *qts)
+{
+    unsigned h = emc_reg(qts, 0x3E);
+
+    return h << 5 | emc_reg(qts, 0x3F) >> 3;
+}
+
+static void test_fan(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext1=fan ");
+    unsigned c;
+
+    g_assert_cmphex(emc_reg(qts, 0xFD), ==, 0x37);
+    g_assert_cmphex(emc_reg(qts, 0xFE), ==, 0x5D);
+    g_assert_cmphex(emc_reg(qts, 0x32), ==, 0x2B);
+    g_assert_cmpuint(emc_tach(qts), ==, 8191);              /* stopped */
+
+    /* MikroElektronika's start: 50 % (stops the watchdog), base freq */
+    emc_set(qts, 0x30, 0x80);
+    emc_set(qts, 0x2D, 0x80);
+    g_assert_cmphex(emc_reg(qts, 0x2D), ==, 0x00);
+    qtest_clock_step(qts, 8 * NANOSECONDS_PER_SECOND);
+    g_assert_cmpuint(qom_int(qts, CLICK1, "rpm"), ==, 2004); /* 501 ‰ */
+    c = emc_tach(qts);
+    g_assert_cmpuint(c, ==, 7864320 / 2004);
+    g_assert_cmphex(emc_reg(qts, 0x24), ==, 0);             /* no WATCH */
+
+    /* RPM mode: target 3000 RPM (count 2621) */
+    emc_set(qts, 0x3C, (2621 & 0x1F) << 3);
+    emc_set(qts, 0x3D, 2621 >> 5);
+    emc_set(qts, 0x32, 0x2B | 0x80);
+    qtest_clock_step(qts, 20 * NANOSECONDS_PER_SECOND);
+    c = qom_int(qts, CLICK1, "rpm");
+    g_assert_cmpuint(c, >, 2900);
+    g_assert_cmpuint(c, <, 3100);
+
+    /* Blocked: stall, ALERT# with the interrupt enabled */
+    emc_set(qts, 0x29, 0x01);
+    qom_set_bool(qts, CLICK1, "blocked", true);
+    qtest_clock_step(qts, 2 * NANOSECONDS_PER_SECOND);
+    g_assert_false(int_high(qts));
+    g_assert_cmphex(emc_reg(qts, 0x25), ==, 0x01);
+    qom_set_bool(qts, CLICK1, "blocked", false);
+    qtest_clock_step(qts, 6 * NANOSECONDS_PER_SECOND);
+    emc_reg(qts, 0x24);
+    emc_reg(qts, 0x25);
+    emc_reg(qts, 0x26);
+    g_assert_true(int_high(qts));
+    qtest_quit(qts);
+
+    /* Nobody writes: the watchdog runs the fan at full speed */
+    qts = i2c_init("-M pic32cm-mc00-cpro,ext1=fan ");
+    qtest_clock_step(qts, 4 * NANOSECONDS_PER_SECOND + SCALE_MS);
+    g_assert_false(int_high(qts));
+    g_assert_cmphex(emc_reg(qts, 0x24), ==, 0x80);
+    g_assert_cmphex(emc_reg(qts, 0x30), ==, 0xFF);
+    qtest_clock_step(qts, 5 * NANOSECONDS_PER_SECOND);
+    g_assert_cmpuint(qom_int(qts, CLICK1, "rpm"), >, 3950);
+    qtest_quit(qts);
+}
+
