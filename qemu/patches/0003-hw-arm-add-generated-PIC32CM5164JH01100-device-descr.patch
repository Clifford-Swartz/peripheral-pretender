+/*
+ * PIC32CM5164JH01100 default NVM rows image (0x00800000-0x0080FFFF)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * GENERATED by generator/atdf2qemu.py from PIC32CM5164JH01100.atdf
+ * (PIC32CM-JH_DFP 1.3.221). Do not edit.
+ * Calibration and serial-number values are placeholders;
+ * dump real ones from silicon before trusting them.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_ARM_PIC32CM5164JH01100_NVMROWS_H
+#define HW_ARM_PIC32CM5164JH01100_NVMROWS_H
+
+#include "qemu/bswap.h"
+
+#define PIC32CM5164JH01100_NVMROWS_BASE 0x00800000
+#define PIC32CM5164JH01100_NVMROWS_SIZE 0x10000
+#define PIC32CM5164JH01100_NVMROWS_CAL_OFFSET 0x0000
+#define PIC32CM5164JH01100_NVMROWS_LOCKBIT_OFFSET 0x2000
+#define PIC32CM5164JH01100_NVMROWS_USER_PAGE_OFFSET 0x4000
+#define PIC32CM5164JH01100_NVMROWS_OTP1_OFFSET 0x6000
+#define PIC32CM5164JH01100_NVMROWS_OTP2_OFFSET 0x6008
+#define PIC32CM5164JH01100_NVMROWS_OTP3_OFFSET 0x6010
+#define PIC32CM5164JH01100_NVMROWS_OTP4_OFFSET 0x6018
+#define PIC32CM5164JH01100_NVMROWS_OTP5_OFFSET 0x6020
+#define PIC32CM5164JH01100_NVMROWS_TEMP_LOG_OFFSET 0x6030
+
+/* Production user row (DS60001632H Table 10-3) */
+#define PIC32CM5164JH01100_USER_ROW_WORD0 0xB15088FB
+#define PIC32CM5164JH01100_USER_ROW_WORD1 0xFFFFF8BB
+
+/* Serial number word addresses (DS 10.3) and default value */
+static const uint32_t pic32cm5164jh01100_serial_addr[4] = {
+    0x0080A00C, 0x0080A040, 0x0080A044, 0x0080A048,
+};
+static const uint32_t pic32cm5164jh01100_serial_default[4] = {
+    0x50500000, 0x00000001, 0x00000002, 0x00000003,
+};
+
+/*
+ * Fill @buf (PIC32CM5164JH01100_NVMROWS_SIZE bytes, mapped at
+ * PIC32CM5164JH01100_NVMROWS_BASE) with the default image: erased (0xFF)
+ * rows, production user row, NVM geometry in OTP1, a plausible
+ * calibration row, and @serial as the four serial-number words.
+ */
+static inline void pic32cm5164jh01100_nvmrows_fill(uint8_t *buf,
+                                                   const uint32_t serial[4])
+{
+    static const struct {
+        uint32_t addr;
+        uint32_t value;
+    } words[] = {
+        /* USER row word 0 (production) */
+        { 0x00804000, 0xB15088FB },
+        /* USER row word 1 (production) */
+        { 0x00804004, 0xFFFFF8BB },
+        /* OTP1 word 0: NVMP, PSZ (NVM_LOCK left erased) */
+        { 0x00806000, 0xE000FFFF },
+        /* OTP1 word 1: DATAFLASHP */
+        { 0x00806004, 0xFFFFFF80 },
+        /* OTP5 word 0: ADC bias mid-scale, OSC32K CAL 0x3F, CAL48M low */
+        { 0x00806020, 0x1103F924 },
+        /* OTP5 word 1: CAL48M high, reserved */
+        { 0x00806024, 0xFFFFFF00 },
+    };
+    const uint32_t base = PIC32CM5164JH01100_NVMROWS_BASE;
+    unsigned i;
+
+    memset(buf, 0xFF, PIC32CM5164JH01100_NVMROWS_SIZE);
+    for (i = 0; i < ARRAY_SIZE(words); i++) {
+        stl_le_p(buf + words[i].addr - base, words[i].value);
+    }
+    for (i = 0; i < 4; i++) {
+        stl_le_p(buf + pic32cm5164jh01100_serial_addr[i] - base, serial[i]);
+    }
+}
+
+#endif /* HW_ARM_PIC32CM5164JH01100_NVMROWS_H */
