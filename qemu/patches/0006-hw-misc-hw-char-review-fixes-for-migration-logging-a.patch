 /* Fuse words in the loaded image take effect at the first reset. */
+/* WDT CONFIG and EWCTRL are enable-protected, also by ALWAYSON (DS 22.6) */
+static void test_wdt_protection(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writeb(qts, WDT + 0x01, 0x55);
+    g_assert_cmphex(qtest_readb(qts, WDT + 0x01), ==, 0x55);
+
+    qtest_writeb(qts, WDT + 0x00, 0x02);                    /* ENABLE */
+    qtest_writeb(qts, WDT + 0x01, 0x66);
+    qtest_writeb(qts, WDT + 0x02, 0x03);
+    g_assert_cmphex(qtest_readb(qts, WDT + 0x01), ==, 0x55);
+    g_assert_cmphex(qtest_readb(qts, WDT + 0x02), ==, 0x0B);
+
+    qtest_writeb(qts, WDT + 0x00, 0x80);                    /* ALWAYSON */
+    qtest_writeb(qts, WDT + 0x00, 0x00);
+    g_assert_cmphex(qtest_readb(qts, WDT + 0x00) & 0x80, ==, 0x80);
+    qtest_writeb(qts, WDT + 0x01, 0x66);
+    g_assert_cmphex(qtest_readb(qts, WDT + 0x01), ==, 0x55);
+    qtest_quit(qts);
+}
