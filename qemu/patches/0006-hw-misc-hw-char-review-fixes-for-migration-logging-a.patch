 }
 
+/*
+ * Writes logged per register before going quiet: enough to show what the
+ * firmware programs, without flooding the log from a busy loop.
+ */
+#define MCHP_REGBLOCK_UNIMP_LOG_MAX 8
+
 static void mchp_regblock_log_write(MchpRegBlock *s, const MchpRegInfo *ri,
                                     unsigned idx, uint32_t value)
 {
+    gpointer key = GUINT_TO_POINTER(mchp_regfile_elem_offset(ri, idx));
+    unsigned n;
+
     trace_mchp_regblock_unimp_write(s->name, ri->name, idx, value);
+    if (!s->unimp_writes) {
+        s->unimp_writes = g_hash_table_new(NULL, NULL);
+    }
+    n = GPOINTER_TO_UINT(g_hash_table_lookup(s->unimp_writes, key));
+    if (n > MCHP_REGBLOCK_UNIMP_LOG_MAX) {
+        return;
+    }
+    g_hash_table_insert(s->unimp_writes, key, GUINT_TO_POINTER(n + 1));
+    if (n == MCHP_REGBLOCK_UNIMP_LOG_MAX) {
+        qemu_log_mask(LOG_UNIMP, "%s.%s: further writes not logged\n",
+                      s->name, ri->name);
+        return;
+    }
     if (ri->count > 1) {
         qemu_log_mask(LOG_UNIMP, "%s.%s[%u]: write 0x%" PRIx32
                       " not modelled\n", s->name, ri->name, idx, value);
@@ -372,6 +394,7 @@ static void mchp_regblock_finalize(Object *obj)
 
     g_free(s->rf.storage);
     g_free(s->name);
+    g_clear_pointer(&s->unimp_writes, g_hash_table_destroy);
 }
 
