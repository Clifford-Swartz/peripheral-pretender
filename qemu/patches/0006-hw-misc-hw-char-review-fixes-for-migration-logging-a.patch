+    s->resume_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, mchp_sercom_resume, s);
     qemu_chr_fe_set_handlers(&s->chr, mchp_sercom_can_receive,
                              mchp_sercom_receive, NULL, NULL, s, NULL, true);
     return true;
@@ -464,17 +481,33 @@ static void mchp_sercom_finalize(Object *obj)
 {
     MchpSercomState *s = MCHP_SERCOM(obj);
 
+    g_clear_handle_id(&s->watch_tag, g_source_remove);
     timer_free(s->frame_timer);
+    timer_free(s->resume_timer);
 }
 
-/* A character waiting for the chardev was not migrated with its watch. */
+/* A watch of this process refers to state that loadvm replaces. */
+static int mchp_sercom_pre_load(void *opaque)
+{
+    MchpSercomState *s = opaque;
+
+    g_clear_handle_id(&s->watch_tag, g_source_remove);
+    return 0;
+}
+
+/*
+ * Chardev I/O waits until the VM runs (the virtual clock is stopped while
+ * loading), so nothing is sent and no IRQ changes before every device is
+ * loaded.
+ */
 static int mchp_sercom_post_load(void *opaque, int version_id)
 {
     MchpSercomState *s = opaque;
 
-    if (s->tx_busy && !timer_pending(s->frame_timer)) {
-        mchp_sercom_tx_send(NULL, 0, s);
+    if (s->rx_count > MCHP_SERCOM_RX_DEPTH) {
+        return -EINVAL;
     }
+    timer_mod(s->resume_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
     return 0;
 }
 
