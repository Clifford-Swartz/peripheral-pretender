+/* After loadvm: resend a character the chardev had not taken, take input */
+static void mchp_sercom_resume(void *opaque)
+{
+    MchpSercomState *s = opaque;
+
+    if (s->tx_busy && !s->watch_tag && !timer_pending(s->frame_timer)) {
+        mchp_sercom_tx_send(NULL, 0, s);
+    }
