diff --git a/include/hw/misc/pp_bus_tap.h b/include/hw/misc/pp_bus_tap.h
new file mode 100644
index 0000000..eaabf5c
--- /dev/null
+++ b/include/hw/misc/pp_bus_tap.h
@@ -0,0 +1,31 @@
+/*
+ * Bus taps: a Click wired to pads reaches whichever SERCOM the firmware
+ * muxes those pads to
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A Click wired on the bench sits on the private SPI and I2C buses of a
+ * TYPE_PP_BUS_HUB. A tap (TYPE_PP_SSI_TAP, TYPE_PP_I2C_TAP) sits on the bus
+ * of each SERCOM that could drive those pads, and passes its traffic on to
+ * the hub's bus while the pad it checks ("pin") is muxed to that SERCOM's
+ * function ("pmux"), as silicon routes it through the PORT.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_PP_BUS_TAP_H
+#define HW_MISC_PP_BUS_TAP_H
+
+#include "hw/i2c/i2c.h"
+#include "hw/ssi/ssi.h"
+
+#define TYPE_PP_BUS_HUB "pp-bus-hub"
+#define TYPE_PP_SSI_TAP "pp-ssi-tap"
+#define TYPE_PP_I2C_TAP "pp-i2c-tap"
+
+/* The hub's private buses ("spi", "i2c") */
+SSIBus *pp_bus_hub_spi(DeviceState *hub);
+I2CBus *pp_bus_hub_i2c(DeviceState *hub);
+
+#endif /* HW_MISC_PP_BUS_TAP_H */
diff --git a/include/hw/misc/pp_cosim.h b/include/hw/misc/pp_cosim.h
