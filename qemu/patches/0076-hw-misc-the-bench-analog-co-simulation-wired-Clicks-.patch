+void pic32cm_soc_trace(Pic32cmSocState *s, Object *machine,
+                       const char *chardev)
+{
+    /* The pads first: a reader already there gets them in the HELLO */
+    mchp_port_trace(pic32cm_soc_periph(s, "PORT"));
+    armv7m_nvic_observe(&s->armv7m.nvic, pic32cm_soc_trace_irq, NULL);
+    pp_trace_attach(machine, chardev, 0);
+}
