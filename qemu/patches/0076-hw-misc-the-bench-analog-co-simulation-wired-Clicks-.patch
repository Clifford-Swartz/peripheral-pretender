+/* The PORT pin of pad @pad ("PA05"), or -1 */
+static int pic32cm_pad_pin(Pic32cmSocState *s, const char *pad)
+{
+    for (unsigned i = 0; i < s->dev->nsignals; i++) {
+        const MchpSignalInfo *sig = &s->dev->signals[i];
+
+        if (sig->pad && sig->pin >= 0 && !strcmp(sig->pad, pad)) {
+            return sig->pin;
+        }
+    }
+    return -1;
+}
+
+/* SERCOM @inst's PAD index on @pin (*pmux: its function), or -1 */
+static int pic32cm_sercom_pad(Pic32cmSocState *s, const char *inst, int pin,
+                              int *pmux)
+{
+    for (unsigned i = 0; i < s->dev->nsignals && pin >= 0; i++) {
+        const MchpSignalInfo *sig = &s->dev->signals[i];
+
+        if (sig->pin == pin && sig->pmux >= 0 && sig->index >= 0 &&
+            !strcmp(sig->instance, inst) && !strcmp(sig->group, "PAD")) {
+            *pmux = sig->pmux;
+            return sig->index;
+        }
+    }
+    return -1;
+}
+
+/*
+ * A SERCOM can be the SPI host on these pads: DO (MOSI) and SCK one of
+ * DOPO's pairs (PAD0/1, PAD2/3, PAD3/1, PAD0/3), DI (MISO, -1: unwired)
+ * another of its pads. *pmux: SCK's function.
+ */
+static bool pic32cm_spi_fits(Pic32cmSocState *s, const char *inst, int sck,
+                             int mosi, int miso, int *pmux)
+{
+    static const int dopo[][2] = { { 0, 1 }, { 2, 3 }, { 3, 1 }, { 0, 3 } };
+    int f, so = pic32cm_sercom_pad(s, inst, mosi, &f);
+    int sc = pic32cm_sercom_pad(s, inst, sck, pmux);
+    int si = miso < 0 ? -2 : pic32cm_sercom_pad(s, inst, miso, &f);
+
+    if (so < 0 || sc < 0 || si == -1 || si == so || si == sc) {
+        return false;
+    }
+    for (unsigned i = 0; i < ARRAY_SIZE(dopo); i++) {
+        if (dopo[i][0] == so && dopo[i][1] == sc) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void pic32cm_soc_wire_click(Pic32cmSocState *s, Object *machine,
+                            const char *name, const char *spec)
+{
+    static const char *const roles[] = {
+        "rst", "pwm", "int", "cs", "an", "sck", "miso", "mosi", "scl", "sda"
+    };
+    enum { R_AN = 4, R_SCK, R_MISO, R_MOSI, R_SCL, R_SDA, R_NUM };
+    g_auto(GStrv) items = g_strsplit(spec, ":", -1);
+    DeviceState *port = pic32cm_soc_periph(s, "PORT");
+    int pin[R_NUM];
+    char *click = items[0];
+    uint8_t addr = 0;
+    int bus = click ? mikrobus_click_bus(click, &addr) : MIKROBUS_BUS_NONE;
+    g_autofree char *hub_name = g_strdup_printf("%s-bus", name);
+    DeviceState *hub;
+    MikrobusSocket sock = {
+        .name = name, .port = port, .port_in = MCHP_PORT_IN,
+        .port_pad = MCHP_PORT_PAD, .pad_listen = mchp_port_pad_listen,
+        .an_pin = -1,
+    };
+    unsigned ntap = 0, nan = 0;
+
+    if (bus == MIKROBUS_BUS_NONE || bus == MIKROBUS_BUS_UART) {
+        warn_report("%s: %s cannot be wired on the bench%s", name,
+                    click ? click : "?",
+                    bus == MIKROBUS_BUS_UART ?
+                    " (a UART Click plugs into a mikroBUS header)" : "");
+        return;
+    }
+    for (unsigned r = 0; r < R_NUM; r++) {
+        pin[r] = -1;
+    }
+    for (unsigned i = 1; items[i]; i++) {
+        g_auto(GStrv) kv = g_strsplit(items[i], ".", 2);
+        int p = kv[0] && kv[1] ? pic32cm_pad_pin(s, kv[1]) : -1;
+        unsigned r = 0;
+
+        while (r < R_NUM && (!kv[0] || strcmp(roles[r], kv[0]))) {
+            r++;
+        }
+        if (r == R_NUM || p < 0) {
+            warn_report("%s: no pin %s here", name, items[i]);
+            continue;
+        }
+        pin[r] = p;
+    }
+    for (unsigned r = 0; r < MIKROBUS_ROLES; r++) {
+        sock.pins[r] = pin[r];
+    }
+    /* AN: a digital pin too, and the ADC inputs on its pad */
+    sock.an_pin = pin[R_AN];
+    for (unsigned i = 0; i < s->dev->nsignals && pin[R_AN] >= 0 &&
+         nan < MIKROBUS_AN_ADCS; i++) {
+        const MchpSignalInfo *sig = &s->dev->signals[i];
+        DeviceState *adc = pic32cm_soc_periph(s, sig->instance);
+
+        if (sig->pin == pin[R_AN] && g_str_has_prefix(sig->instance, "ADC") &&
+            !strcmp(sig->group, "AIN") && sig->index >= 0 && adc) {
+            sock.an[nan++] = (MikrobusAnalog) { OBJECT(adc), sig->index };
+        }
+    }
+    /* The private buses, and a tap on each SERCOM that fits the pads */
+    hub = qdev_new(TYPE_PP_BUS_HUB);
+    object_property_add_child(machine, hub_name, OBJECT(hub));
+    qdev_realize_and_unref(hub, NULL, &error_fatal);
+    sock.spi = pp_bus_hub_spi(hub);
+    sock.i2c = pp_bus_hub_i2c(hub);
+    for (unsigned i = 0; i < s->dev->ninstances; i++) {
+        const char *inst = s->dev->instances[i].name;
+        g_autofree char *lower = g_ascii_strdown(inst, -1);
+        g_autofree char *tap_name = g_strdup_printf("%s-tap%u", name, ntap);
+        DeviceState *sercom = s->periph[i], *tap;
+        BusState *b;
+        int pmux;
+
+        if (!sercom || !g_str_has_prefix(inst, "SERCOM")) {
+            continue;
+        }
+        if (bus == MIKROBUS_BUS_SPI &&
+            pic32cm_spi_fits(s, inst, pin[R_SCK], pin[R_MOSI], pin[R_MISO],
+                             &pmux)) {
+            g_autofree char *bname = g_strdup_printf("%s.spi", lower);
+
+            b = qdev_get_child_bus(sercom, bname);
+            if (!b) {
+                continue;
+            }
+            tap = qdev_new(TYPE_PP_SSI_TAP);
+            qdev_prop_set_uint32(tap, "pin", pin[R_SCK]);
+            qdev_prop_set_int32(tap, "pmux", pmux);
+            object_property_set_link(OBJECT(tap), "port", OBJECT(port),
+                                     &error_fatal);
+            object_property_set_link(OBJECT(tap), "hub", OBJECT(hub),
+                                     &error_fatal);
+            object_property_add_child(machine, tap_name, OBJECT(tap));
+            ssi_realize_and_unref(tap, (SSIBus *)b, &error_fatal);
+            ntap++;
+        } else if (bus == MIKROBUS_BUS_I2C &&
+                   pic32cm_sercom_pad(s, inst, pin[R_SDA], &pmux) == 0 &&
+                   pic32cm_sercom_pad(s, inst, pin[R_SCL], &pmux) == 1) {
+            g_autofree char *bname = g_strdup_printf("%s.i2c", lower);
+
+            b = qdev_get_child_bus(sercom, bname);
+            if (!b) {
+                continue;
+            }
+            pic32cm_sercom_pad(s, inst, pin[R_SDA], &pmux);
+            tap = qdev_new(TYPE_PP_I2C_TAP);
+            qdev_prop_set_uint8(tap, "address", addr);
+            qdev_prop_set_uint32(tap, "pin", pin[R_SDA]);
+            qdev_prop_set_int32(tap, "pmux", pmux);
+            object_property_set_link(OBJECT(tap), "port", OBJECT(port),
+                                     &error_fatal);
+            object_property_set_link(OBJECT(tap), "hub", OBJECT(hub),
+                                     &error_fatal);
+            object_property_add_child(machine, tap_name, OBJECT(tap));
+            i2c_slave_realize_and_unref(I2C_SLAVE(tap), I2C_BUS(b),
+                                        &error_fatal);
+            ntap++;
+        }
+    }
+    if ((bus == MIKROBUS_BUS_SPI || bus == MIKROBUS_BUS_I2C) && !ntap) {
+        warn_report("%s: no SERCOM can drive %s's %s on those pads", name,
+                    click, bus == MIKROBUS_BUS_SPI ? "SPI" : "I2C");
+    }
+    mikrobus_plug(machine, &sock, &click, 1);
+}
+
+void pic32cm_soc_wire_clicks(Pic32cmSocState *s, Object *machine,
+                             const char *wired)
+{
+    g_auto(GStrv) entries = g_strsplit(wired ? wired : "", "/", -1);
+
+    for (unsigned i = 0; entries[i]; i++) {
+        g_auto(GStrv) kv = g_strsplit(entries[i], "=", 2);
+
+        if (kv[0] && kv[1] && *kv[0]) {
+            pic32cm_soc_wire_click(s, machine, kv[0], kv[1]);
+        }
+    }
+}
