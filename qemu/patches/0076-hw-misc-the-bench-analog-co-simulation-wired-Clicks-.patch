+/*
+ * Input @mux in microvolts, sampled @bits CLK_ADC cycles before now: from
+ * the circuit on the board when one is simulated alongside
+ */
+static int64_t adc_input_uv(MchpAdcU2247State *s, unsigned mux,
+                            unsigned bits)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t uv;
+
+    if (mux < ADC_NAIN &&
+        pp_cosim_sample(OBJECT(s), mux,
+                        now - clock_ticks_to_ns(adc_gclk(s),
+                                                bits * adc_div(s)), &uv)) {
+        return uv;
+    }
+    return adc_input_mv(s, mux) * 1000LL;
+}
