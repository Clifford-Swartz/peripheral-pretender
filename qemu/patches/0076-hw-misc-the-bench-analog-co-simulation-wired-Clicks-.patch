+ * Bus taps: a Click wired to pads reaches whichever SERCOM the firmware
+ * muxes those pads to
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * See pp_bus_tap.h. The SPI tap has no chip select of its own: every byte
+ * the SERCOM shifts reaches the hub's bus, and the Click there answers
+ * only while its own CS pad is low. The I2C tap answers at the Click's
+ * address and forwards the transfer to the hub's bus.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/gpio/mchp_port.h"
+#include "hw/misc/pp_bus_tap.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(PpBusHubState, PP_BUS_HUB)
+OBJECT_DECLARE_SIMPLE_TYPE(PpSsiTapState, PP_SSI_TAP)
+OBJECT_DECLARE_SIMPLE_TYPE(PpI2cTapState, PP_I2C_TAP)
+
+struct PpBusHubState {
+    DeviceState parent_obj;
+
+    SSIBus *spi;
+    I2CBus *i2c;
+};
+
+struct PpSsiTapState {
+    SSIPeripheral parent_obj;
+
+    DeviceState *port;
+    DeviceState *hub;
+    uint32_t pin;
+    int32_t pmux;
+};
+
+struct PpI2cTapState {
+    I2CSlave parent_obj;
+
+    DeviceState *port;
+    DeviceState *hub;
+    uint32_t pin;
+    int32_t pmux;
+    bool open;                  /* a transfer the hub's bus took */
+};
+
+SSIBus *pp_bus_hub_spi(DeviceState *hub)
+{
+    return PP_BUS_HUB(hub)->spi;
+}
+
+I2CBus *pp_bus_hub_i2c(DeviceState *hub)
+{
+    return PP_BUS_HUB(hub)->i2c;
+}
+
+static void pp_bus_hub_init(Object *obj)
+{
+    PpBusHubState *s = PP_BUS_HUB(obj);
+
+    s->spi = ssi_create_bus(DEVICE(obj), "spi");
+    s->i2c = i2c_init_bus(DEVICE(obj), "i2c");
+}
+
+/* The tapped SERCOM drives the pads: its pad is muxed to its function */
+static bool pp_tap_routed(DeviceState *port, uint32_t pin, int32_t pmux)
+{
+    return port && mchp_port_pad_function(port, pin) == pmux;
+}
+
+static uint32_t pp_ssi_tap_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    PpSsiTapState *s = PP_SSI_TAP(dev);
+
+    if (!pp_tap_routed(s->port, s->pin, s->pmux)) {
+        return 0;
+    }
+    return ssi_transfer(pp_bus_hub_spi(s->hub), val);
+}
+
+static int pp_i2c_tap_event(I2CSlave *dev, enum i2c_event event)
+{
+    PpI2cTapState *s = PP_I2C_TAP(dev);
+    I2CBus *bus = pp_bus_hub_i2c(s->hub);
+
+    switch (event) {
+    case I2C_START_SEND:
+    case I2C_START_RECV:
+        if (s->open) {
+            /* A repeated start */
+            s->open = false;
+        }
+        if (!pp_tap_routed(s->port, s->pin, s->pmux)) {
+            return -1;
+        }
+        if ((event == I2C_START_SEND ? i2c_start_send(bus, dev->address)
+                                     : i2c_start_recv(bus, dev->address))) {
+            return -1;
+        }
+        s->open = true;
+        return 0;
+    case I2C_FINISH:
+        if (s->open) {
+            i2c_end_transfer(bus);
+            s->open = false;
+        }
+        return 0;
+    case I2C_NACK:
+        if (s->open) {
+            i2c_nack(bus);
+        }
+        return 0;
+    default:
+        return 0;
+    }
+}
+
+static int pp_i2c_tap_send(I2CSlave *dev, uint8_t data)
+{
+    PpI2cTapState *s = PP_I2C_TAP(dev);
+
+    return s->open ? i2c_send(pp_bus_hub_i2c(s->hub), data) : -1;
+}
+
+static uint8_t pp_i2c_tap_recv(I2CSlave *dev)
+{
+    PpI2cTapState *s = PP_I2C_TAP(dev);
+
+    return s->open ? i2c_recv(pp_bus_hub_i2c(s->hub)) : 0xff;
+}
+
+static void pp_tap_check(DeviceState *port, DeviceState *hub, Error **errp)
+{
+    if (!port || !hub) {
+        error_setg(errp, "a bus tap needs its \"port\" and \"hub\"");
+    }
+}
+
+static void pp_ssi_tap_realize(SSIPeripheral *dev, Error **errp)
+{
+    PpSsiTapState *s = PP_SSI_TAP(dev);
+
+    pp_tap_check(s->port, s->hub, errp);
+}
+
+static void pp_i2c_tap_realize(DeviceState *dev, Error **errp)
+{
+    PpI2cTapState *s = PP_I2C_TAP(dev);
+
+    pp_tap_check(s->port, s->hub, errp);
+}
+
+static const Property pp_ssi_tap_properties[] = {
+    DEFINE_PROP_LINK("port", PpSsiTapState, port, TYPE_DEVICE,
+                     DeviceState *),
+    DEFINE_PROP_LINK("hub", PpSsiTapState, hub, TYPE_PP_BUS_HUB,
+                     DeviceState *),
+    DEFINE_PROP_UINT32("pin", PpSsiTapState, pin, 0),
+    DEFINE_PROP_INT32("pmux", PpSsiTapState, pmux, -1),
+};
+
+static const Property pp_i2c_tap_properties[] = {
+    DEFINE_PROP_LINK("port", PpI2cTapState, port, TYPE_DEVICE,
+                     DeviceState *),
+    DEFINE_PROP_LINK("hub", PpI2cTapState, hub, TYPE_PP_BUS_HUB,
+                     DeviceState *),
+    DEFINE_PROP_UINT32("pin", PpI2cTapState, pin, 0),
+    DEFINE_PROP_INT32("pmux", PpI2cTapState, pmux, -1),
+};
+
+static void pp_bus_hub_class_init(ObjectClass *klass, const void *data)
+{
+    DEVICE_CLASS(klass)->user_creatable = false;
+}
+
+static void pp_ssi_tap_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = pp_ssi_tap_realize;
+    k->transfer = pp_ssi_tap_transfer;
+    k->cs_polarity = SSI_CS_NONE;
+    dc->user_creatable = false;
+    device_class_set_props(dc, pp_ssi_tap_properties);
+}
+
+static void pp_i2c_tap_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->realize = pp_i2c_tap_realize;
+    dc->user_creatable = false;
+    k->event = pp_i2c_tap_event;
+    k->send = pp_i2c_tap_send;
+    k->recv = pp_i2c_tap_recv;
+    device_class_set_props(dc, pp_i2c_tap_properties);
+}
+
+static const TypeInfo pp_bus_tap_types[] = {
+    {
+        .name = TYPE_PP_BUS_HUB,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(PpBusHubState),
+        .instance_init = pp_bus_hub_init,
+        .class_init = pp_bus_hub_class_init,
+    },
+    {
+        .name = TYPE_PP_SSI_TAP,
+        .parent = TYPE_SSI_PERIPHERAL,
+        .instance_size = sizeof(PpSsiTapState),
+        .class_init = pp_ssi_tap_class_init,
+    },
+    {
+        .name = TYPE_PP_I2C_TAP,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(PpI2cTapState),
+        .class_init = pp_i2c_tap_class_init,
+    },
+};
+
+DEFINE_TYPES(pp_bus_tap_types)
diff --git a/hw/misc/pp_cosim.c b/hw/misc/pp_cosim.c
new file mode 100644
index 0000000..17394d3
--- /dev/null
+++ b/hw/misc/pp_cosim.c
@@ -0,0 +1,414 @@
+/*
+ * Peripheral Pretender co-simulation port
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The twin's side of a circuit simulated outside QEMU (the project's
+ * analog host, running SPICE: docs/design/analog.md), in lockstep with
+ * QEMU_CLOCK_VIRTUAL. A message, in either direction, is a 4-byte
+ * little-endian length and that many bytes of text lines. QEMU always
+ * speaks first and waits for the reply, so the host never runs ahead of
+ * QEMU's time and the result does not depend on host timing:
+ *
+ *   hello 1 <machine> <vdd mV>   at connection; the host answers with
+ *                                "watch <pad>" (send that pad's changes),
+ *                                "probe <id> <QOM path> <channel>" (that
+ *                                analog input reads the circuit), "tick
+ *                                <ns>" (0: none) and "ok"
+ *   init <t>                     after the watched pads' states; "ok"
+ *   e <t> <pad> <state>          a watched pad changed, sent with the next
+ *                                request: h or l (driven), u or d (pulled
+ *                                up or down, not driven), z (floating)
+ *   s <t> <id>                   the voltage of probe <id> at <t>; the
+ *                                host answers "v <microvolts>"
+ *   t <t>                        a tick; the host answers "in <group>
+ *                                <mask> <level>" lines (hex: the pads the
+ *                                circuit drives and their levels, set as
+ *                                the PORT's "pX-bench") and "ok"
+ *   f <t>                        a flush of many events; "ok"
+ *
+ * Times are QEMU_CLOCK_VIRTUAL nanoseconds; pads are named as in the data
+ * sheet (PA05). If the host goes away the port stops, and analog inputs
+ * fall back to their models' own inputs. Lockstep needs -icount: without
+ * it, virtual time follows the host clock and runs on while the circuit
+ * is being solved.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qemu/bswap.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "chardev/char.h"
+#include "chardev/char-fe.h"
+#include "exec/icount.h"
+#include "hw/core/boards.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/gpio/mchp_port.h"
+#include "hw/misc/pp_cosim.h"
+#include "migration/vmstate.h"
+
+#define PP_COSIM_PINS       (4 * 32)    /* PA..PD */
+#define PP_COSIM_PROBES     32
+#define PP_COSIM_FLUSH      65536       /* bytes of events before a flush */
+#define PP_COSIM_MAX_REPLY  65536
+
+OBJECT_DECLARE_SIMPLE_TYPE(PpCosimState, PP_COSIM)
+
+typedef struct PpCosimProbe {
+    char *path;
+    Object *obj;
+    unsigned channel, id;
+} PpCosimProbe;
+
+struct PpCosimState {
+    DeviceState parent_obj;
+
+    CharFrontend chr;
+    DeviceState *port;
+    char *machine;
+    uint32_t vdd_mv;
+
+    bool up;                    /* configured, and the host answers */
+    bool observing;
+    bool watch[PP_COSIM_PINS];
+    PpCosimProbe probe[PP_COSIM_PROBES];
+    unsigned nprobes;
+    int64_t tick_ns;
+    QEMUTimer *tick;
+    GString *pending;           /* event lines for the next request */
+};
+
+/* The machine's port: analog inputs reach it from their sample hooks */
+static PpCosimState *pp_cosim;
+
+static void pp_cosim_down(PpCosimState *s, const char *why)
+{
+    if (s->up) {
+        warn_report("cosim: %s; the circuit no longer drives the pads", why);
+    }
+    s->up = false;
+    timer_del(s->tick);
+    g_string_truncate(s->pending, 0);
+}
+
+/*
+ * Send the pending events and the request @req, and read the reply into
+ * @reply. False if the host is gone.
+ */
+static bool pp_cosim_exchange(PpCosimState *s, const char *req,
+                              GString *reply)
+{
+    uint8_t hdr[4];
+    uint32_t len;
+
+    g_string_append_printf(s->pending, "%s\n", req);
+    stl_le_p(hdr, s->pending->len);
+    if (qemu_chr_fe_write_all(&s->chr, hdr, 4) != 4 ||
+        qemu_chr_fe_write_all(&s->chr, (uint8_t *)s->pending->str,
+                              s->pending->len) != (int)s->pending->len) {
+        pp_cosim_down(s, "cannot write to the circuit host");
+        return false;
+    }
+    g_string_truncate(s->pending, 0);
+    if (qemu_chr_fe_read_all(&s->chr, hdr, 4) != 4) {
+        pp_cosim_down(s, "the circuit host stopped answering");
+        return false;
+    }
+    len = ldl_le_p(hdr);
+    if (len > PP_COSIM_MAX_REPLY) {
+        pp_cosim_down(s, "bad reply from the circuit host");
+        return false;
+    }
+    g_string_set_size(reply, len);
+    if (len && qemu_chr_fe_read_all(&s->chr, (uint8_t *)reply->str,
+                                    len) != (int)len) {
+        pp_cosim_down(s, "the circuit host stopped answering");
+        return false;
+    }
+    return true;
+}
+
+/* "PA05" -> 5, "PB10" -> 42; -1 if @name is not a pad */
+static int pp_cosim_pin(const char *name)
+{
+    unsigned n;
+    char g, end;
+
+    if (sscanf(name, "P%c%u%c", &g, &n, &end) != 2 || g < 'A' ||
+        g >= 'A' + PP_COSIM_PINS / 32 || n >= 32) {
+        return -1;
+    }
+    return (g - 'A') * 32 + n;
+}
+
+static void pp_cosim_append_pad(PpCosimState *s, int64_t t, unsigned pin,
+                                char state)
+{
+    g_string_append_printf(s->pending, "e %" PRId64 " P%c%02u %c\n", t,
+                           'A' + pin / 32, pin % 32, state);
+}
+
+/* The PORT's pad observer */
+static void pp_cosim_pad(void *opaque, unsigned pin, char state)
+{
+    PpCosimState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (!s->up || pin >= PP_COSIM_PINS || !s->watch[pin]) {
+        return;
+    }
+    pp_cosim_append_pad(s, now, pin, state);
+    if (s->pending->len > PP_COSIM_FLUSH) {
+        g_autoptr(GString) reply = g_string_new(NULL);
+        g_autofree char *req = g_strdup_printf("f %" PRId64, now);
+
+        pp_cosim_exchange(s, req, reply);
+    }
+}
+
+static void pp_cosim_tick(void *opaque)
+{
+    PpCosimState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    g_autoptr(GString) reply = g_string_new(NULL);
+    g_autofree char *req = g_strdup_printf("t %" PRId64, now);
+    g_auto(GStrv) lines = NULL;
+
+    if (!s->up || !pp_cosim_exchange(s, req, reply)) {
+        return;
+    }
+    lines = g_strsplit(reply->str, "\n", -1);
+    for (char **l = lines; *l; l++) {
+        uint32_t mask, level;
+        char group;
+
+        if (sscanf(*l, "in %c %" SCNx32 " %" SCNx32, &group, &mask,
+                   &level) == 3) {
+            g_autofree char *prop = g_strdup_printf("p%c-bench",
+                                                    g_ascii_tolower(group));
+            g_autofree char *val = g_strdup_printf("%" PRIx32 " %" PRIx32,
+                                                   mask, level);
+
+            /* A group this device lacks: nothing to drive */
+            object_property_set_str(OBJECT(s->port), prop, val, NULL);
+        }
+    }
+    timer_mod(s->tick, now + s->tick_ns);
+}
+
+/* Read the host's configuration, one line of the hello's reply */
+static bool pp_cosim_config(PpCosimState *s, const char *line)
+{
+    char name[16], path[256];
+    unsigned id, channel;
+    int64_t tick;
+    int pin;
+
+    if (sscanf(line, "watch %15s", name) == 1) {
+        pin = pp_cosim_pin(name);
+        if (pin < 0) {
+            warn_report("cosim: no pad %s", name);
+        } else {
+            s->watch[pin] = true;
+        }
+    } else if (sscanf(line, "probe %u %255s %u", &id, path, &channel) == 3) {
+        PpCosimProbe *p = &s->probe[s->nprobes];
+
+        if (s->nprobes == PP_COSIM_PROBES) {
+            warn_report("cosim: more than %d probes", PP_COSIM_PROBES);
+            return true;
+        }
+        p->obj = object_resolve_path(path, NULL);
+        if (!p->obj) {
+            warn_report("cosim: no device %s", path);
+            return true;
+        }
+        p->path = g_strdup(path);
+        p->channel = channel;
+        p->id = id;
+        s->nprobes++;
+    } else if (sscanf(line, "tick %" SCNd64, &tick) == 1) {
+        s->tick_ns = MAX(tick, 0);
+    } else if (g_str_has_prefix(line, "error")) {
+        error_report("cosim: the circuit host refused: %s", line);
+        return false;
+    }
+    return true;
+}
+
+/* Hello, configuration, and the watched pads' states */
+static void pp_cosim_connect(PpCosimState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    g_autoptr(GString) reply = g_string_new(NULL);
+    g_autofree char *hello = g_strdup_printf("hello 1 %s %" PRIu32,
+                                             s->machine ?: "?", s->vdd_mv);
+    g_autofree char *init = g_strdup_printf("init %" PRId64, now);
+    g_auto(GStrv) lines = NULL;
+
+    memset(s->watch, 0, sizeof(s->watch));
+    for (unsigned i = 0; i < s->nprobes; i++) {
+        g_free(s->probe[i].path);
+    }
+    s->nprobes = 0;
+    s->tick_ns = 0;
+    g_string_truncate(s->pending, 0);
+    s->up = true;
+    if (!pp_cosim_exchange(s, hello, reply)) {
+        return;
+    }
+    lines = g_strsplit(reply->str, "\n", -1);
+    for (char **l = lines; *l; l++) {
+        if (!pp_cosim_config(s, *l)) {
+            pp_cosim_down(s, "configuration refused");
+            return;
+        }
+    }
+    if (!s->observing) {
+        mchp_port_observe(s->port, pp_cosim_pad, s);
+        s->observing = true;
+    }
+    for (unsigned pin = 0; pin < PP_COSIM_PINS; pin++) {
+        if (s->watch[pin]) {
+            pp_cosim_append_pad(s, now, pin,
+                                mchp_port_pad_state(s->port, pin));
+        }
+    }
+    if (!pp_cosim_exchange(s, init, reply)) {
+        return;
+    }
+    if (s->tick_ns) {
+        timer_mod(s->tick, now + s->tick_ns);
+    }
+}
+
+static void pp_cosim_event(void *opaque, QEMUChrEvent event)
+{
+    PpCosimState *s = opaque;
+
+    switch (event) {
+    case CHR_EVENT_OPENED:
+        if (!s->up) {
+            pp_cosim_connect(s);
+        }
+        break;
+    case CHR_EVENT_CLOSED:
+        pp_cosim_down(s, "the circuit host disconnected");
+        break;
+    default:
+        break;
+    }
+}
+
+bool pp_cosim_sample(Object *dev, unsigned channel, int64_t when,
+                     int64_t *uv)
+{
+    PpCosimState *s = pp_cosim;
+    g_autoptr(GString) reply = NULL;
+    g_autofree char *req = NULL;
+    PpCosimProbe *p = NULL;
+    int64_t v;
+
+    if (!s || !s->up) {
+        return false;
+    }
+    for (unsigned i = 0; i < s->nprobes && !p; i++) {
+        if (s->probe[i].obj == dev && s->probe[i].channel == channel) {
+            p = &s->probe[i];
+        }
+    }
+    if (!p) {
+        return false;
+    }
+    reply = g_string_new(NULL);
+    req = g_strdup_printf("s %" PRId64 " %u", when, p->id);
+    if (!pp_cosim_exchange(s, req, reply) ||
+        sscanf(reply->str, "v %" SCNd64, &v) != 1) {
+        return false;
+    }
+    *uv = v;
+    return true;
+}
+
+void pp_cosim_attach(Object *machine, const char *chardev, DeviceState *port,
+                     uint32_t vdd_mv)
+{
+    DeviceState *dev = qdev_new(TYPE_PP_COSIM);
+    Chardev *chr = qemu_chr_find(chardev);
+
+    if (!chr) {
+        error_report("cosim: no chardev \"%s\"", chardev);
+        exit(1);
+    }
+    qdev_prop_set_chr(dev, "chardev", chr);
+    qdev_prop_set_string(dev, "machine", MACHINE_GET_CLASS(machine)->name);
+    qdev_prop_set_uint32(dev, "vdd-mv", vdd_mv);
+    object_property_set_link(OBJECT(dev), "port", OBJECT(port),
+                             &error_fatal);
+    object_property_add_child(machine, "pp-cosim", OBJECT(dev));
+    qdev_realize_and_unref(dev, NULL, &error_fatal);
+}
+
+static void pp_cosim_realize(DeviceState *dev, Error **errp)
+{
+    PpCosimState *s = PP_COSIM(dev);
+
+    if (!s->port) {
+        error_setg(errp, "cosim: no PORT to observe");
+        return;
+    }
+    if (pp_cosim) {
+        error_setg(errp, "cosim: one per machine");
+        return;
+    }
+    if (!icount_enabled()) {
+        warn_report("cosim: without -icount, virtual time runs on while "
+                    "the circuit is solved; timing will be wrong");
+    }
+    pp_cosim = s;
+    s->pending = g_string_new(NULL);
+    s->tick = timer_new_ns(QEMU_CLOCK_VIRTUAL, pp_cosim_tick, s);
+    /* No read handlers: every read is a reply, read synchronously */
+    qemu_chr_fe_set_handlers(&s->chr, NULL, NULL, pp_cosim_event, NULL, s,
+                             NULL, true);
+}
+
+static const Property pp_cosim_properties[] = {
+    DEFINE_PROP_CHR("chardev", PpCosimState, chr),
+    DEFINE_PROP_STRING("machine", PpCosimState, machine),
+    DEFINE_PROP_UINT32("vdd-mv", PpCosimState, vdd_mv, 3300),
+    DEFINE_PROP_LINK("port", PpCosimState, port, TYPE_MCHP_PORT,
+                     DeviceState *),
+};
+
+/* The circuit's state lives outside QEMU */
+static const VMStateDescription vmstate_pp_cosim = {
+    .name = TYPE_PP_COSIM,
+    .unmigratable = 1,
+};
+
+static void pp_cosim_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = pp_cosim_realize;
+    dc->vmsd = &vmstate_pp_cosim;
+    dc->user_creatable = false;
+    device_class_set_props(dc, pp_cosim_properties);
+}
+
+static const TypeInfo pp_cosim_types[] = {
+    {
+        .name = TYPE_PP_COSIM,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(PpCosimState),
+        .class_init = pp_cosim_class_init,
+    },
+};
+
+DEFINE_TYPES(pp_cosim_types)
diff --git a/hw/misc/pp_trace.c b/hw/misc/pp_trace.c
new file mode 100644
index 0000000..0c73837
--- /dev/null
+++ b/hw/misc/pp_trace.c
@@ -0,0 +1,630 @@
+/*
+ * Peripheral Pretender event recorder
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The machine's recorder for a timeline of the board (see
+ * include/hw/misc/pp_trace.h for the stream): every pad's level from the
+ * PORT, each interrupt's pend, entry and return, and what the models
+ * report (bytes on a SERCOM, a USART, a TWI). Records are stamped with
+ * QEMU_CLOCK_VIRTUAL; with -icount that is the firmware's own time. The
+ * recorder knows no particular model: the SoC wires its PORT and its
+ * interrupt controller to it, so the Arm and AVR builds share it.
+ *
+ * A pad that toggles more than PP_TRACE_BURST times in a window of
+ * PP_TRACE_WINDOW_NS (a PWM, a buzzer) is reported a window at a time
+ * (PP_TRACE_PAD_BUSY: its edges and high time) until it calms down. The
+ * stream never blocks QEMU: when the reader falls behind, records wait in
+ * a buffer and past PP_TRACE_BUF_MAX are dropped and counted
+ * (PP_TRACE_LOST). On each connection the recorder says hello, names its
+ * sources and sends every pad's level.
+ *
+ * The reader's actions ("at <t> <id> set ...", "at <t> <id> reset") wait
+ * in time order for a QEMU_CLOCK_VIRTUAL timer at their time, so with a
+ * fixed -icount shift and sleep=off the guest sees each at the same
+ * instruction in every run. "pace 1" keeps such a run near real time:
+ * a QEMU_CLOCK_REALTIME timer pauses the VM while virtual time is ahead,
+ * which the guest cannot tell (-icount align=on would, but it needs
+ * sleep=on, whose idle time follows the host clock).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qemu/bswap.h"
+#include "qemu/error-report.h"
+#include "qemu/main-loop.h"
+#include "qapi/error.h"
+#include "chardev/char.h"
+#include "chardev/char-fe.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/misc/pp_trace.h"
+#include "migration/vmstate.h"
+#include "system/reset.h"
+#include "system/runstate.h"
+
+#define PP_TRACE_REC        16
+#define PP_TRACE_BUF_MAX    (8 * 1024 * 1024)
+#define PP_TRACE_SOURCES    64
+#define PP_TRACE_PADS       128     /* PA..PD of 32, or PA..PF of 8 */
+#define PP_TRACE_WINDOW_NS  1000000             /* 1 ms */
+#define PP_TRACE_BURST      64                  /* edges a window, singly */
+#define PP_TRACE_TICK_NS    20000000            /* the time, every 20 ms */
+#define PP_TRACE_LINE_MAX   65536               /* a line from the reader */
+#define PP_TRACE_PACE_NS    5000000             /* pacing looks every 5 ms */
+#define PP_TRACE_AHEAD_NS   5000000             /* virtual time may lead */
+#define PP_TRACE_BEHIND_NS  200000000           /* and lag, then let go */
+
+/* An action of the reader, waiting for its virtual time */
+typedef struct PpTraceAction {
+    int64_t t;
+    uint64_t seq;               /* arrival order, for actions at one t */
+    uint32_t id;
+    char *path, *prop, *value;  /* NULL path: a system reset */
+} PpTraceAction;
+
+OBJECT_DECLARE_SIMPLE_TYPE(PpTraceState, PP_TRACE)
+
+typedef struct PpTracePad {
+    int64_t start;              /* of the current window */
+    int64_t last;               /* the last edge, or the window's start */
+    int64_t high_ns;            /* high time in the window so far */
+    uint32_t edges;             /* in the window */
+    bool level;
+    bool busy;                  /* reported a window at a time */
+} PpTracePad;
+
+struct PpTraceState {
+    DeviceState parent_obj;
+
+    CharFrontend chr;
+    uint32_t irq_flags;         /* PP_TRACE_IRQ_VECTORS, or 0 */
+
+    bool connected;
+    GByteArray *buf;            /* records from @sent on wait to be written */
+    unsigned sent;
+    guint watch_tag;
+    QEMUBH *flush_bh;
+    QEMUTimer *tick;
+    uint32_t lost;
+    unsigned names_sent;
+    PpTracePad pad[PP_TRACE_PADS];
+
+    /* The reader's actions, in time order, and their timer */
+    GString *line;
+    GQueue actions;
+    uint64_t action_seq;
+    QEMUTimer *act_timer;
+    /* Pacing: the origins of real and virtual time, whether we paused */
+    bool pace, paused;
+    int64_t real0, virt0;
+    QEMUTimer *pace_timer;
+};
+
+static PpTraceState *pp_trace;
+static char *pp_trace_names[PP_TRACE_SOURCES];
+static unsigned pp_trace_nnames;
+/* The PORT's way to read every pad (pp_trace_pads()) */
+static PpTraceLevelsFn *pp_trace_levels;
+static void *pp_trace_levels_opaque;
+static unsigned pp_trace_group_pins = 32;
+
+void pp_trace_pads(PpTraceLevelsFn *fn, void *opaque, unsigned group_pins)
+{
+    pp_trace_levels = fn;
+    pp_trace_levels_opaque = opaque;
+    pp_trace_group_pins = group_pins;
+}
+
+unsigned pp_trace_source(const char *name)
+{
+    if (!pp_trace_nnames) {
+        pp_trace_names[PP_TRACE_SRC_PORT] = g_strdup("PORT");
+        pp_trace_names[PP_TRACE_SRC_NVIC] = g_strdup("NVIC");
+        pp_trace_nnames = 2;
+    }
+    for (unsigned i = 0; i < pp_trace_nnames; i++) {
+        if (!strcmp(pp_trace_names[i], name)) {
+            return i;
+        }
+    }
+    if (pp_trace_nnames == PP_TRACE_SOURCES) {
+        warn_report("trace: more than %d sources; %s shares the last",
+                    PP_TRACE_SOURCES, name);
+        return PP_TRACE_SOURCES - 1;
+    }
+    pp_trace_names[pp_trace_nnames] = g_strdup(name);
+    return pp_trace_nnames++;
+}
+
+static void pp_trace_record(PpTraceState *s, int64_t t, unsigned kind,
+                            unsigned src, uint32_t a, uint32_t b)
+{
+    uint8_t rec[PP_TRACE_REC];
+
+    stq_le_p(rec, t);
+    rec[8] = kind;
+    rec[9] = src;
+    stw_le_p(rec + 10, a);
+    stl_le_p(rec + 12, b);
+    g_byte_array_append(s->buf, rec, PP_TRACE_REC);
+}
+
+/* The names of the sources registered since the last ones were sent */
+static void pp_trace_send_names(PpTraceState *s, int64_t t)
+{
+    static const uint8_t zeros[PP_TRACE_REC];
+
+    for (; s->names_sent < pp_trace_nnames; s->names_sent++) {
+        const char *name = pp_trace_names[s->names_sent];
+        size_t len = MIN(strlen(name), 255);
+
+        pp_trace_record(s, t, PP_TRACE_NAME, s->names_sent, len, 0);
+        g_byte_array_append(s->buf, (const uint8_t *)name, len);
+        g_byte_array_append(s->buf, zeros, -len & (PP_TRACE_REC - 1));
+    }
+}
+
+/* Queue a record for the reader (and the names it refers to) */
+static void pp_trace_put(PpTraceState *s, int64_t t, unsigned kind,
+                         unsigned src, uint32_t a, uint32_t b)
+{
+    if (!s->connected) {
+        return;
+    }
+    if (s->buf->len - s->sent >= PP_TRACE_BUF_MAX) {
+        s->lost++;
+        return;
+    }
+    if (s->lost) {
+        pp_trace_record(s, t, PP_TRACE_LOST, 0, 0, s->lost);
+        s->lost = 0;
+    }
+    if (s->names_sent < pp_trace_nnames) {
+        pp_trace_send_names(s, t);
+    }
+    pp_trace_record(s, t, kind, src, a, b);
+    qemu_bh_schedule(s->flush_bh);
+}
+
+void pp_trace_event(PpTraceKind kind, unsigned src, uint32_t a, uint32_t b)
+{
+    PpTraceState *s = pp_trace;
+
+    if (s && s->connected) {
+        pp_trace_put(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), kind, src, a,
+                     b);
+    }
+}
+
+static gboolean pp_trace_writable(void *do_not_use, GIOCondition cond,
+                                  void *opaque);
+
+/* Write what the chardev takes; wait for it to take the rest */
+static void pp_trace_flush(void *opaque)
+{
+    PpTraceState *s = opaque;
+    int n;
+
+    if (s->watch_tag) {
+        return;                 /* pp_trace_writable() goes on */
+    }
+    if (!s->connected) {
+        g_byte_array_set_size(s->buf, 0);
+        s->sent = 0;
+        return;
+    }
+    if (s->sent < s->buf->len) {
+        n = qemu_chr_fe_write(&s->chr, s->buf->data + s->sent,
+                              s->buf->len - s->sent);
+        if (n > 0) {
+            s->sent += n;
+        }
+    }
+    if (s->sent == s->buf->len) {
+        g_byte_array_set_size(s->buf, 0);
+        s->sent = 0;
+        return;
+    }
+    if (s->sent > s->buf->len / 2) {
+        g_byte_array_remove_range(s->buf, 0, s->sent);
+        s->sent = 0;
+    }
+    s->watch_tag = qemu_chr_fe_add_watch(&s->chr, G_IO_OUT | G_IO_HUP,
+                                         pp_trace_writable, s);
+    if (!s->watch_tag) {
+        /* A backend that cannot say when it is ready: drop the rest */
+        s->lost += (s->buf->len - s->sent) / PP_TRACE_REC;
+        g_byte_array_set_size(s->buf, 0);
+        s->sent = 0;
+    }
+}
+
+static gboolean pp_trace_writable(void *do_not_use, GIOCondition cond,
+                                  void *opaque)
+{
+    PpTraceState *s = opaque;
+
+    s->watch_tag = 0;
+    pp_trace_flush(s);
+    return G_SOURCE_REMOVE;
+}
+
+/* Close pad @pin's window if it ended before @now */
+static void pp_trace_pad_close(PpTraceState *s, unsigned pin, int64_t now)
+{
+    PpTracePad *p = &s->pad[pin];
+    int64_t end = p->start + PP_TRACE_WINDOW_NS;
+
+    if (now < end) {
+        return;
+    }
+    if (p->busy) {
+        uint32_t duty;
+
+        if (p->level) {
+            p->high_ns += end - p->last;
+        }
+        duty = MIN(p->high_ns * 255 / PP_TRACE_WINDOW_NS, 255);
+        pp_trace_put(s, p->start, PP_TRACE_PAD_BUSY, PP_TRACE_SRC_PORT, pin,
+                     MIN(p->edges, 0xffffff) | duty << 24);
+        /* A calm window (or none since): single edges again */
+        if (p->edges <= PP_TRACE_BURST || now - end >= PP_TRACE_WINDOW_NS) {
+            p->busy = false;
+            pp_trace_put(s, end, PP_TRACE_PAD, PP_TRACE_SRC_PORT, pin,
+                         p->level);
+        }
+    }
+    p->start = p->last = now;
+    p->edges = 0;
+    p->high_ns = 0;
+}
+
+/* A pad changed level (the PORT calls this) */
+void pp_trace_pad(unsigned pin, bool level)
+{
+    PpTraceState *s = pp_trace;
+    int64_t now;
+    PpTracePad *p;
+
+    if (!s || pin >= PP_TRACE_PADS) {
+        return;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    p = &s->pad[pin];
+    pp_trace_pad_close(s, pin, now);
+    if (p->level) {
+        p->high_ns += now - p->last;
+    }
+    p->last = now;
+    p->level = level;
+    p->edges++;
+    if (p->edges > PP_TRACE_BURST) {
+        p->busy = true;
+    }
+    if (!p->busy) {
+        pp_trace_put(s, now, PP_TRACE_PAD, PP_TRACE_SRC_PORT, pin, level);
+    }
+}
+
+/* The time now and then; busy pads that went quiet get their level */
+static void pp_trace_tick(void *opaque)
+{
+    PpTraceState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    for (unsigned pin = 0; pin < PP_TRACE_PADS; pin++) {
+        if (s->pad[pin].busy) {
+            pp_trace_pad_close(s, pin, now);
+        }
+    }
+    pp_trace_put(s, now, PP_TRACE_TIME, 0, 0, 0);
+    timer_mod(s->tick, now + PP_TRACE_TICK_NS);
+}
+
+static void pp_trace_reset(void *opaque)
+{
+    pp_trace_event(PP_TRACE_RESET, 0, 0, 0);
+}
+
+/* -- the reader's actions ------------------------------------------------ */
+
+static void pp_trace_action_free(gpointer data)
+{
+    PpTraceAction *a = data;
+
+    g_free(a->path);
+    g_free(a->prop);
+    g_free(a->value);
+    g_free(a);
+}
+
+static gint pp_trace_action_cmp(gconstpointer x, gconstpointer y,
+                                gpointer unused)
+{
+    const PpTraceAction *a = x, *b = y;
+
+    /* In time order, and in the order they came for one time */
+    if (a->t != b->t) {
+        return a->t < b->t ? -1 : 1;
+    }
+    return a->seq < b->seq ? -1 : a->seq > b->seq;
+}
+
+static void pp_trace_arm(PpTraceState *s)
+{
+    PpTraceAction *a = g_queue_peek_head(&s->actions);
+
+    if (a) {
+        timer_mod(s->act_timer, a->t);
+    } else {
+        timer_del(s->act_timer);
+    }
+}
+
+/* The actions whose time has come, in order */
+static void pp_trace_act(void *opaque)
+{
+    PpTraceState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    PpTraceAction *a;
+
+    while ((a = g_queue_peek_head(&s->actions)) && a->t <= now) {
+        Error *err = NULL;
+        bool ok = true;
+
+        g_queue_pop_head(&s->actions);
+        if (!a->path) {
+            qemu_system_reset_request(SHUTDOWN_CAUSE_HOST_QMP_SYSTEM_RESET);
+        } else {
+            Object *obj = object_resolve_path(a->path, NULL);
+
+            if (!obj) {
+                error_setg(&err, "no object %s", a->path);
+            } else {
+                object_property_parse(obj, a->prop, a->value, &err);
+            }
+            if (err) {
+                warn_report_err(err);
+                ok = false;
+            }
+        }
+        pp_trace_put(s, now, ok ? PP_TRACE_INPUT : PP_TRACE_INPUT_ERROR, 0,
+                     a->id & 0xffff, a->id >> 16);
+        pp_trace_action_free(a);
+    }
+    pp_trace_arm(s);
+}
+
+/* Keep virtual time near real time by pausing the VM while it is ahead */
+static void pp_trace_pace(void *opaque)
+{
+    PpTraceState *s = opaque;
+    int64_t real, virt;
+
+    if (!s->pace) {
+        return;
+    }
+    real = qemu_clock_get_ns(QEMU_CLOCK_REALTIME) - s->real0;
+    virt = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->virt0;
+    if (runstate_is_running()) {
+        if (virt > real + PP_TRACE_AHEAD_NS) {
+            s->paused = true;
+            vm_stop(RUN_STATE_PAUSED);
+        } else if (virt < real - PP_TRACE_BEHIND_NS) {
+            /* A guest slower than real time: do not race it later */
+            s->real0 += real - virt - PP_TRACE_BEHIND_NS;
+        }
+    } else if (s->paused && runstate_check(RUN_STATE_PAUSED) &&
+               virt <= real) {
+        s->paused = false;
+        vm_start();
+    }
+    timer_mod(s->pace_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + PP_TRACE_PACE_NS);
+}
+
+static void pp_trace_set_pace(PpTraceState *s, bool on)
+{
+    s->pace = on;
+    if (on) {
+        s->real0 = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+        s->virt0 = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        pp_trace_pace(s);
+        return;
+    }
+    timer_del(s->pace_timer);
+    if (s->paused && runstate_check(RUN_STATE_PAUSED)) {
+        s->paused = false;
+        vm_start();
+    }
+}
+
+/* One line from the reader */
+static void pp_trace_line(PpTraceState *s, const char *line)
+{
+    int64_t t;
+    uint32_t id;
+    int on, n = 0;
+    char path[256], prop[128];
+
+    if (sscanf(line, "pace %d", &on) == 1) {
+        pp_trace_set_pace(s, on);
+    } else if (sscanf(line, "at %" SCNd64 " %" SCNu32 " %n", &t, &id,
+                      &n) == 2 && n) {
+        const char *rest = line + n;
+        PpTraceAction *a = g_new0(PpTraceAction, 1);
+        int m = 0;
+
+        a->t = MAX(t, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+        a->seq = s->action_seq++;
+        a->id = id;
+        if (!strcmp(rest, "reset")) {
+            /* a->path NULL */
+        } else if (sscanf(rest, "set %255s %127s %n", path, prop, &m) == 2 &&
+                   m) {
+            a->path = g_strdup(path);
+            a->prop = g_strdup(prop);
+            a->value = g_strdup(rest + m);
+        } else {
+            warn_report("trace: what is \"%s\"?", line);
+            g_free(a);
+            return;
+        }
+        g_queue_insert_sorted(&s->actions, a, pp_trace_action_cmp, NULL);
+        pp_trace_arm(s);
+    } else if (*line) {
+        warn_report("trace: what is \"%s\"?", line);
+    }
+}
+
+static int pp_trace_can_read(void *opaque)
+{
+    return PP_TRACE_LINE_MAX;
+}
+
+static void pp_trace_read(void *opaque, const uint8_t *buf, int size)
+{
+    PpTraceState *s = opaque;
+
+    for (int i = 0; i < size; i++) {
+        if (buf[i] == '\n') {
+            g_strchomp(s->line->str);
+            pp_trace_line(s, s->line->str);
+            g_string_truncate(s->line, 0);
+        } else if (s->line->len < PP_TRACE_LINE_MAX) {
+            g_string_append_c(s->line, buf[i]);
+        }
+    }
+}
+
+/* A reader connected: hello, the names, every pad's level */
+static void pp_trace_connect(PpTraceState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    unsigned gp = pp_trace_group_pins;
+    uint32_t levels[PP_TRACE_PADS / 8];
+    unsigned groups = 0;
+
+    g_clear_handle_id(&s->watch_tag, g_source_remove);
+    g_byte_array_set_size(s->buf, 0);
+    s->sent = 0;
+    s->lost = 0;
+    s->names_sent = 0;
+    s->connected = true;
+    pp_trace_record(s, now, PP_TRACE_HELLO, 0, PP_TRACE_VERSION,
+                    gp | s->irq_flags);
+    if (pp_trace_levels) {
+        groups = pp_trace_levels(pp_trace_levels_opaque, levels,
+                                 MIN(ARRAY_SIZE(levels), PP_TRACE_PADS / gp));
+    }
+    for (unsigned pin = 0; pin < groups * gp; pin++) {
+        PpTracePad *p = &s->pad[pin];
+
+        p->level = extract32(levels[pin / gp], pin % gp, 1);
+        p->busy = false;
+        p->start = p->last = now;
+        p->edges = 0;
+        p->high_ns = 0;
+        pp_trace_put(s, now, PP_TRACE_PAD, PP_TRACE_SRC_PORT, pin, p->level);
+    }
+    pp_trace_put(s, now, PP_TRACE_TIME, 0, 0, 0);
+    timer_mod(s->tick, now + PP_TRACE_TICK_NS);
+}
+
+static void pp_trace_chr_event(void *opaque, QEMUChrEvent event)
+{
+    PpTraceState *s = opaque;
+
+    switch (event) {
+    case CHR_EVENT_OPENED:
+        pp_trace_connect(s);
+        break;
+    case CHR_EVENT_CLOSED:
+        s->connected = false;
+        g_clear_handle_id(&s->watch_tag, g_source_remove);
+        g_byte_array_set_size(s->buf, 0);
+        s->sent = 0;
+        timer_del(s->tick);
+        /* The reader's actions and pacing go with it */
+        g_queue_clear_full(&s->actions, pp_trace_action_free);
+        timer_del(s->act_timer);
+        g_string_truncate(s->line, 0);
+        pp_trace_set_pace(s, false);
+        break;
+    default:
+        break;
+    }
+}
+
+void pp_trace_attach(Object *machine, const char *chardev, uint32_t irq_flags)
+{
+    DeviceState *dev = qdev_new(TYPE_PP_TRACE);
+    Chardev *chr = qemu_chr_find(chardev);
+
+    if (!chr) {
+        error_report("trace: no chardev \"%s\"", chardev);
+        exit(1);
+    }
+    qdev_prop_set_chr(dev, "chardev", chr);
+    qdev_prop_set_uint32(dev, "irq-flags", irq_flags);
+    object_property_add_child(machine, "pp-trace", OBJECT(dev));
+    qdev_realize_and_unref(dev, NULL, &error_fatal);
+}
+
+static void pp_trace_realize(DeviceState *dev, Error **errp)
+{
+    PpTraceState *s = PP_TRACE(dev);
+
+    if (pp_trace) {
+        error_setg(errp, "trace: one per machine");
+        return;
+    }
+    pp_trace = s;
+    pp_trace_source("PORT");            /* names PORT and NVIC */
+    s->buf = g_byte_array_new();
+    s->line = g_string_new(NULL);
+    g_queue_init(&s->actions);
+    s->flush_bh = qemu_bh_new(pp_trace_flush, s);
+    s->tick = timer_new_ns(QEMU_CLOCK_VIRTUAL, pp_trace_tick, s);
+    s->act_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, pp_trace_act, s);
+    s->pace_timer = timer_new_ns(QEMU_CLOCK_REALTIME, pp_trace_pace, s);
+    qemu_register_reset(pp_trace_reset, s);
+    qemu_chr_fe_set_handlers(&s->chr, pp_trace_can_read, pp_trace_read,
+                             pp_trace_chr_event, NULL, s, NULL, true);
+}
+
+static const Property pp_trace_properties[] = {
+    DEFINE_PROP_CHR("chardev", PpTraceState, chr),
+    DEFINE_PROP_UINT32("irq-flags", PpTraceState, irq_flags, 0),
+};
+
+/* The reader keeps what was recorded; a restored VM starts a new stream */
+static const VMStateDescription vmstate_pp_trace = {
+    .name = TYPE_PP_TRACE,
+    .unmigratable = 1,
+};
+
+static void pp_trace_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = pp_trace_realize;
+    dc->vmsd = &vmstate_pp_trace;
+    dc->user_creatable = false;
+    device_class_set_props(dc, pp_trace_properties);
+}
+
+static const TypeInfo pp_trace_types[] = {
+    {
+        .name = TYPE_PP_TRACE,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(PpTraceState),
+        .class_init = pp_trace_class_init,
+    },
+};
+
+DEFINE_TYPES(pp_trace_types)
