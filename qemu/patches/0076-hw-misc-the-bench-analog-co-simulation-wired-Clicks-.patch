+++ b/include/hw/misc/pp_cosim.h
@@ -0,0 +1,39 @@
+/*
+ * Peripheral Pretender co-simulation port: the twin's pads and analog
+ * inputs in lockstep with a circuit simulated outside QEMU
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A board machine creates one with pp_cosim_attach() when its "cosim"
+ * property names a chardev. The protocol is described in pp_cosim.c and in
+ * the project's docs/design/analog.md.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_PP_COSIM_H
+#define HW_MISC_PP_COSIM_H
+
+#include "hw/core/qdev.h"
+
+#define TYPE_PP_COSIM "pp-cosim"
+
+/*
+ * Create the port as a child of @machine ("pp-cosim"), talking on chardev
+ * @chardev, observing @port (a TYPE_MCHP_PORT); @vdd_mv is the pads'
+ * supply. Exits with an error if @chardev does not exist.
+ */
+void pp_cosim_attach(Object *machine, const char *chardev, DeviceState *port,
+                     uint32_t vdd_mv);
+
+/*
+ * The voltage of analog input @channel of @dev (an ADC) at virtual time
+ * @when (ns, not after now), in microvolts, if the circuit drives that
+ * input: true and *@uv set; false while no circuit does (the model falls
+ * back to its own inputs).
+ */
+bool pp_cosim_sample(Object *dev, unsigned channel, int64_t when,
+                     int64_t *uv);
+
+#endif /* HW_MISC_PP_COSIM_H */
diff --git a/include/hw/misc/pp_trace.h b/include/hw/misc/pp_trace.h
new file mode 100644
index 0000000..3c36ed8
--- /dev/null
+++ b/include/hw/misc/pp_trace.h
@@ -0,0 +1,106 @@
+/*
+ * Peripheral Pretender event recorder
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Models report what happens on the board (a pad changes, a byte crosses
+ * a bus, an exception is taken) with pp_trace_event(); the machine's
+ * recorder ("trace=<chardev>") stamps each event with QEMU_CLOCK_VIRTUAL
+ * and streams it to the chardev for a timeline. Without a recorder the
+ * calls cost a test of one pointer.
+ *
+ * The stream is 16-byte little-endian records:
+ *   uint64 t     virtual time in ns
+ *   uint8  kind  PP_TRACE_*
+ *   uint8  src   the source (pp_trace_source()): a SERCOM, the PORT...
+ *   uint16 a, uint32 b   as each kind says
+ * A PP_TRACE_NAME record is followed by its name, padded to 16 bytes.
+ *
+ * The reader may send lines back, to act on the board at exact virtual
+ * times (for a run that replays exactly, with a fixed -icount shift and
+ * sleep=off):
+ *   at <t> <id> set <path> <property> <value>   set a QOM property at
+ *                       virtual time <t> ns (0: now), as qom-set would
+ *   at <t> <id> reset   a system reset at <t>
+ *   pace <0|1>          keep virtual time from running ahead of real time
+ *                       by pausing the VM (invisible to the guest)
+ * Each applied action is reported (PP_TRACE_INPUT, its id) with the time
+ * it took effect, so a recording can repeat it at that time.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_PP_TRACE_H
+#define HW_MISC_PP_TRACE_H
+
+#include "hw/core/qdev.h"
+
+#define TYPE_PP_TRACE "pp-trace"
+
+#define PP_TRACE_VERSION    1
+
+typedef enum PpTraceKind {
+    PP_TRACE_PAD = 1,       /* a: pad (group * pads a group + pin),
+                               b: level */
+    PP_TRACE_PAD_BUSY,      /* a: pad, b: edges in the window (t: its start;
+                               the pad toggles too fast for single edges);
+                               bits 24-31 of b: high time, of 255 */
+    PP_TRACE_UART_TX,       /* a: character */
+    PP_TRACE_UART_RX,       /* a: character */
+    PP_TRACE_SPI,           /* a: character out, b: character in */
+    PP_TRACE_I2C_START,     /* a: 7-bit address, b: bit 0 read, bit 1 NACK */
+    PP_TRACE_I2C_BYTE,      /* a: byte, b: bit 0 NACK, bit 1 read */
+    PP_TRACE_I2C_HOST_NACK, /* the host NACKs the last byte it read */
+    PP_TRACE_I2C_STOP,
+    PP_TRACE_IRQ_PEND,      /* a: exception number (16 + IRQ line), or
+                               the AVR vector (PP_TRACE_IRQ_VECTORS) */
+    PP_TRACE_IRQ_ENTER,     /* a: exception number, or vector */
+    PP_TRACE_IRQ_EXIT,      /* a: exception number, or vector */
+    PP_TRACE_RESET,         /* a system reset */
+    PP_TRACE_INPUT,         /* an action of the reader took effect: id in
+                               a (low 16 bits) and b (high 16) */
+    PP_TRACE_INPUT_ERROR,   /* an action failed (as PP_TRACE_INPUT) */
+    PP_TRACE_HELLO = 0xf0,  /* a: PP_TRACE_VERSION; b: pads a group (bits
+                               0-7: PA05 is pad 5 + 32 on Arm parts, PB3
+                               pad 3 + 8 on AVR), interrupt numbering (bit
+                               8: AVR vectors, else Cortex-M exceptions) */
+    PP_TRACE_NAME,          /* a: length of the name that follows */
+    PP_TRACE_LOST,          /* b: events dropped (the reader fell behind) */
+    PP_TRACE_TIME,          /* the virtual time, now and then */
+} PpTraceKind;
+
+/* Sources with fixed ids: the pads, and the interrupt controller */
+#define PP_TRACE_SRC_PORT   0
+#define PP_TRACE_SRC_NVIC   1
+
+#define PP_TRACE_IRQ_VECTORS    (1 << 8)    /* PP_TRACE_HELLO flag */
+
+/* A source id for the model instance called @name ("SERCOM3") */
+unsigned pp_trace_source(const char *name);
+
+/* Record an event of @kind from @src; nothing without a recorder */
+void pp_trace_event(PpTraceKind kind, unsigned src, uint32_t a, uint32_t b);
+
+/*
+ * The pads: a PORT model calls pp_trace_pad() whenever pad @pin (group *
+ * @group_pins + pin) changes level, whoever set it, and registers with
+ * pp_trace_pads() how to read every pad's level now (@fn fills one word a
+ * group, returns the groups), for a reader that connects.
+ */
+typedef unsigned PpTraceLevelsFn(void *opaque, uint32_t *levels,
+                                 unsigned max);
+void pp_trace_pads(PpTraceLevelsFn *fn, void *opaque, unsigned group_pins);
+void pp_trace_pad(unsigned pin, bool level);
+
+/*
+ * The machine's recorder on chardev @chardev; @irq_flags: 0 for Cortex-M
+ * exception numbers, PP_TRACE_IRQ_VECTORS for AVR vectors. The SoC wires
+ * its PORT (pp_trace_pads(), before this: a reader that is already
+ * connected gets the HELLO now) and its interrupt controller
+ * (PP_TRACE_IRQ_* events from PP_TRACE_SRC_NVIC).
+ */
+void pp_trace_attach(Object *machine, const char *chardev,
+                     uint32_t irq_flags);
+
+#endif /* HW_MISC_PP_TRACE_H */
diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index 11221b2..e76c4bc 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -630,6 +630,75 @@ static void test_thumbstick(void)
     qtest_quit(qts);
 }
 
+#define SERCOM0         0x42000400
+
+/*
+ * Injected faults: a short over the PORT's own drive (LED0, PA24), an I2C
+ * address that NACKs (the Thermo 8), a stuck MISO (the Thumbstick's
+ * MCP3204); characters into the VCOM's receiver (SERCOM0 rx-inject)
+ */
+static void test_faults(void)
+{
+    QTestState *qts = click_init("");
+    const char *ch;
+
+    qtest_writeb(qts, PA + P_PINCFG + 24, 0x02);            /* INEN */
+    qtest_writel(qts, PA + P_OUTCLR, BIT(24));
+    qtest_writel(qts, PA + P_DIRSET, BIT(24));
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(24), ==, 0);
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/soc/port', 'property':"
+                             " 'pa-short', 'value': '1000000 1000000' } }");
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(24), ==, BIT(24));
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/soc/port', 'property':"
+                             " 'pa-short', 'value': '0 0' } }");
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(24), ==, 0);
+
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/soc/sercom2', 'property':"
+                             " 'fault-nack', 'value': '18' } }");
+    g_assert_false(mcp_write(qts, 1, NULL, 0));
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/soc/sercom2', 'property':"
+                             " 'fault-nack', 'value': '' } }");
+    g_assert_cmphex(mcp_read(qts, 6, 2), ==, 0x0054);       /* manufacturer */
+
+    /* VCOM: 8N1, RXPO 1, TXEN and RXEN (as pic32cm-mc00-test) */
+    qtest_writel(qts, SERCOM0 + 0x00, 0x40310004);
+    qtest_writel(qts, SERCOM0 + 0x04, 0x00030000);
+    qtest_writel(qts, SERCOM0 + 0x00, 0x40310006);
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/soc/sercom0', 'property':"
+                             " 'rx-inject', 'value': '686921' } }");
+    for (ch = "hi!"; *ch; ch++) {
+        g_assert_cmphex(qtest_readb(qts, SERCOM0 + 0x18) & BIT(2), ==,
+                        BIT(2));                            /* RXC */
+        g_assert_cmphex(qtest_readw(qts, SERCOM0 + 0x28), ==, *ch);
+    }
+    g_assert_cmphex(qtest_readb(qts, SERCOM0 + 0x18) & BIT(2), ==, 0);
+    qtest_quit(qts);
+
+    qts = qtest_init("-M pic32cm-mc00-cpro,ext1=thumbstick ");
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);
+    qtest_writel(qts, SERCOM1 + 0x04, BIT(17));             /* RXEN */
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));
+    qtest_writel(qts, PA + P_DIRSET, BIT(17));
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/soc/sercom1', 'property':"
+                             " 'fault-miso', 'value': 'a5' } }");
+    qtest_writel(qts, PA + P_OUTCLR, BIT(17));
+    g_assert_cmphex(spi_xfer(qts, 0x06), ==, 0xa5);
+    g_assert_cmphex(spi_xfer(qts, 0x00), ==, 0xa5);
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/soc/sercom1', 'property':"
+                             " 'fault-miso', 'value': '' } }");
+    g_assert_cmpuint(mcp3204_read(qts, 0x06, 0x00), ==, 2048);
+    qtest_quit(qts);
+}
+
 /* I2C on SERCOM2 (as mcp_write/mcp_read) to any address */
 static bool i2c_wr(QTestState *qts, uint8_t addr, uint8_t reg,
                    const uint8_t *d, unsigned n)
@@ -1400,5 +1469,6 @@ int main(int argc, char **argv)
     qtest_add_func("pic32cm-click/thermo8-limits", test_limit_flags);
     qtest_add_func("pic32cm-click/thermo8-alert", test_alert);
     qtest_add_func("pic32cm-click/thermo8-shutdown-lock", test_shutdown_lock);
+    qtest_add_func("pic32cm-click/faults", test_faults);
     return g_test_run();
 }
