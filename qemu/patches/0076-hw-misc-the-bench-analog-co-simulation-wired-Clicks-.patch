+static void mchp_sercom_instance_init(Object *obj)
+{
+    MCHP_SERCOM(obj)->fault_miso = -1;
+    MCHP_SERCOM(obj)->inject = g_byte_array_new();
+}
+
+/* "rx-inject": characters for the receiver, in hex; reads what waits */
+static char *mchp_sercom_get_inject(Object *obj, Error **errp)
+{
+    GByteArray *inject = MCHP_SERCOM(obj)->inject;
+    GString *hex = g_string_new(NULL);
+
+    for (unsigned i = 0; i < inject->len; i++) {
+        g_string_append_printf(hex, "%02x", inject->data[i]);
+    }
+    return g_string_free(hex, false);
+}
+
+static void mchp_sercom_set_inject(Object *obj, const char *value,
+                                   Error **errp)
+{
+    MchpSercomState *s = MCHP_SERCOM(obj);
+    size_t len = strlen(value);
+    g_autoptr(GByteArray) chars = g_byte_array_new();
+
+    for (size_t i = 0; i < len; i += 2) {
+        int hi = g_ascii_xdigit_value(value[i]);
+        int lo = i + 1 < len ? g_ascii_xdigit_value(value[i + 1]) : -1;
+        uint8_t c;
+
+        if (hi < 0 || lo < 0) {
+            error_setg(errp, "rx-inject: \"%s\" is not hex characters", value);
+            return;
+        }
+        c = hi << 4 | lo;
+        g_byte_array_append(chars, &c, 1);
+    }
+    g_byte_array_append(s->inject, chars->data, chars->len);
+    mchp_sercom_drain(s);
+}
+
+/* "fault-nack": I2C addresses that NACK, "18,48" (hex, 7-bit) */
+static char *mchp_sercom_get_fault_nack(Object *obj, Error **errp)
+{
+    return g_strdup(MCHP_SERCOM(obj)->fault_nack ?: "");
+}
+
+static void mchp_sercom_set_fault_nack(Object *obj, const char *value,
+                                       Error **errp)
+{
+    MchpSercomState *s = MCHP_SERCOM(obj);
+    g_auto(GStrv) addrs = g_strsplit_set(value, ", ", -1);
+    uint32_t map[ARRAY_SIZE(s->fault_nack_map)] = { 0 };
+
+    for (char **a = addrs; *a; a++) {
+        char *end;
+        unsigned long dev;
+
+        if (!**a) {
+            continue;
+        }
+        dev = strtoul(*a, &end, 16);
+        if (*end || dev > 0x7f) {
+            error_setg(errp, "fault-nack: \"%s\" is not a 7-bit address in "
+                       "hex", *a);
+            return;
+        }
+        map[dev / 32] |= BIT(dev % 32);
+    }
+    memcpy(s->fault_nack_map, map, sizeof(map));
+    g_free(s->fault_nack);
+    s->fault_nack = g_strdup(value);
+}
+
+/* "fault-miso": the character the SPI host reads (hex), empty for none */
+static char *mchp_sercom_get_fault_miso(Object *obj, Error **errp)
+{
+    MchpSercomState *s = MCHP_SERCOM(obj);
+
+    return s->fault_miso < 0 ? g_strdup("") :
+           g_strdup_printf("%x", s->fault_miso);
+}
+
+static void mchp_sercom_set_fault_miso(Object *obj, const char *value,
+                                       Error **errp)
+{
+    MchpSercomState *s = MCHP_SERCOM(obj);
+    char *end;
+    unsigned long ch;
+
+    if (!*value) {
+        s->fault_miso = -1;
+        return;
