+/* The NVIC's pends, entries and returns, as the recorder's events */
+static void pic32cm_soc_trace_irq(void *opaque, int irq, int what)
+{
+    static const PpTraceKind kind[] = {
+        [ARMV7M_NVIC_OBSERVE_PEND] = PP_TRACE_IRQ_PEND,
+        [ARMV7M_NVIC_OBSERVE_ENTER] = PP_TRACE_IRQ_ENTER,
+        [ARMV7M_NVIC_OBSERVE_EXIT] = PP_TRACE_IRQ_EXIT,
+    };
+
+    pp_trace_event(kind[what], PP_TRACE_SRC_NVIC, irq, 0);
+}
