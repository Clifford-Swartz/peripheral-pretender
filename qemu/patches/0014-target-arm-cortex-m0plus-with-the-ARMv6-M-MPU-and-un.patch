+        /* ARMv6-M has no TEX field (Cortex-M0+ silicon: RAZ/WI) */
+        cpu->env.pmsav7.dracr[region] = (value >> 16) &
+            (arm_feature(&cpu->env, ARM_FEATURE_V7) ? 0x173f : 0x1707);
         tlb_flush(CPU(cpu));
