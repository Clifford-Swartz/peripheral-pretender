+/*
+ * Peripheral Pretender: a personal project, AI-assisted; not for
+ * submission to upstream QEMU. Cortex-M0+ r0p1: the Cortex-M0 ISA
+ * (ARMv6-M) with the optional ARMv6-M MPU, 8 regions in the PMSAv7
+ * register format, and unprivileged Thread mode (CONTROL.nPRIV), as the
+ * PIC32CM silicon has them (Cortex-M0+ TRM, DDI 0484C). Configure the MPU
+ * out with has-mpu=false. Not modelled: the single-cycle I/O port, the
+ * MTB.
+ */
+static void cortex_m0plus_initfn(Object *obj)
+{
+    ARMCPU *cpu = ARM_CPU(obj);
+
+    cortex_m0_initfn(obj);
+    cpu->midr = 0x410cc601;
+    cpu->pmsav7_dregion = 8;
+    cpu->m_unpriv_ext = true;
+}
+
