+/*
+ * The MPU uses the PMSAv7 format: v7 PMSA CPUs, and the ARMv6-M MPU
+ * (Peripheral Pretender addition, not for upstream).
+ */
+static inline bool arm_pmsav7_format(CPUARMState *env)
+{
+    return arm_feature(env, ARM_FEATURE_PMSA) &&
+           !arm_feature(env, ARM_FEATURE_V8) &&
+           (arm_feature(env, ARM_FEATURE_V7) ||
+            arm_feature(env, ARM_FEATURE_M));
+}
+
 #endif
