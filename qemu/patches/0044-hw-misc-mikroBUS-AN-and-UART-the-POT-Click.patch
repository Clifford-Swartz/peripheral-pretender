diff --git a/hw/misc/click_pot.c b/hw/misc/click_pot.c
new file mode 100644
index 0000000..3dcd30b
--- /dev/null
+++ b/hw/misc/click_pot.c
@@ -0,0 +1,135 @@
+/*
+ * A potentiometer on a Click board, driving the mikroBUS AN pin
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * QOM property "position" (per mille of the travel, 0-1000, settable while
+ * running). GPIO output "an": the wiper voltage in millivolts,
+ * "bottom-mv" + position x ("top-mv" - "bottom-mv") / 1000, an analog line
+ * that mikrobus sets on the ADC channels behind the socket's AN pin. The
+ * defaults are the POT Click's (v101: MCP1501T-20 2.048 V reference on
+ * the track, jumper OUT SEL on REF; on 3V3 the top is 3.3 V, top-mv 3300;
+ * an OPA344 and an emitter follower buffer the wiper onto AN, so the ADC
+ * does not load it; turning direction not documented). Not modelled: the
+ * track's taper and tolerance, wiper noise. No physical Click checked it.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "system/reset.h"
+#include "hw/misc/click_pot.h"
+#include "migration/vmstate.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(ClickPotState, CLICK_POT)
+
+struct ClickPotState {
+    DeviceState parent_obj;
+
+    qemu_irq an;
+    uint32_t position;          /* per mille */
+    uint32_t bottom_mv;
+    uint32_t top_mv;
+};
+
+static void click_pot_update(ClickPotState *s)
+{
+    int64_t span = (int64_t)s->top_mv - s->bottom_mv;
+
+    qemu_set_irq(s->an, s->bottom_mv + span * s->position / 1000);
+}
+
+static void click_pot_get_position(Object *obj, Visitor *v, const char *name,
+                                   void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &CLICK_POT(obj)->position, errp);
+}
+
+static void click_pot_set_position(Object *obj, Visitor *v, const char *name,
+                                   void *opaque, Error **errp)
+{
+    ClickPotState *s = CLICK_POT(obj);
+    uint32_t value;
+
+    if (!visit_type_uint32(v, name, &value, errp)) {
+        return;
+    }
+    if (value > 1000) {
+        error_setg(errp, "position is per mille: 0-1000");
+        return;
+    }
+    s->position = value;
+    click_pot_update(s);
+}
+
+/*
+ * On machine reset (a Click is on no bus, so no device reset reaches it):
+ * the wiper's voltage onto AN, connected by then; the knob stays put
+ */
+static void click_pot_reset(void *opaque)
+{
+    click_pot_update(opaque);
+}
+
+static void click_pot_realize(DeviceState *dev, Error **errp)
+{
+    qemu_register_reset(click_pot_reset, dev);
+}
+
+static void click_pot_unrealize(DeviceState *dev)
+{
+    qemu_unregister_reset(click_pot_reset, dev);
+}
+
+static void click_pot_init(Object *obj)
+{
+    ClickPotState *s = CLICK_POT(obj);
+
+    s->position = 500;
+    qdev_init_gpio_out_named(DEVICE(obj), &s->an, CLICK_POT_AN, 1);
+    object_property_add(obj, "position", "uint32", click_pot_get_position,
+                        click_pot_set_position, NULL, NULL);
+}
+
+static const Property click_pot_properties[] = {
+    DEFINE_PROP_UINT32("bottom-mv", ClickPotState, bottom_mv, 0),
+    DEFINE_PROP_UINT32("top-mv", ClickPotState, top_mv, 2048),
+};
+
+static const VMStateDescription vmstate_click_pot = {
+    .name = TYPE_CLICK_POT,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(position, ClickPotState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void click_pot_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "Click board potentiometer on AN";
+    dc->vmsd = &vmstate_click_pot;
+    device_class_set_props(dc, click_pot_properties);
+    dc->realize = click_pot_realize;
+    dc->unrealize = click_pot_unrealize;
+}
+
+static const TypeInfo click_pot_types[] = {
+    {
+        .name = TYPE_CLICK_POT,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(ClickPotState),
+        .instance_init = click_pot_init,
+        .class_init = click_pot_class_init,
+    },
+};
+
+DEFINE_TYPES(click_pot_types)
