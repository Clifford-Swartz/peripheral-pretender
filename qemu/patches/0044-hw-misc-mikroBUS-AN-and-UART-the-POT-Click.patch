 } ClickInfo;
 
 static const ClickInfo mikrobus_clicks[] = {
@@ -132,6 +141,10 @@ static const ClickInfo mikrobus_clicks[] = {
       TYPE_MCHP_MCP79411, CLICK_I2C, MCHP_MCP7941X_RTCC_ADDR, 0,
       .outs = { { MCHP_MCP7941X_MFP, MIKROBUS_INT } },
       .pulls = { { true, MIKROBUS_INT, 1 } } },           /* R2 10k */
+    { "pot", "POT Click: potentiometer across an MCP1501 2.048 V reference "
+      "(OUT SEL on REF), buffered onto AN: 0-2.048 V",
+      TYPE_CLICK_POT, CLICK_GPIO, 0, 0,
+      .outs = { { CLICK_POT_AN, MIKROBUS_AN } } },        /* U2, Q1 buffer */
 };
 
 const char *mikrobus_click_names(void)
@@ -160,6 +173,19 @@ static void mikrobus_pull_down(void *opaque, int n, int level)
     qemu_set_irq(opaque, level < 0 ? 0 : level);
 }
 
+/* AN: the Click's analog output (mV, < 0: released) on the ADC channels */
+static void mikrobus_an(void *opaque, int n, int mv)
+{
+    const MikrobusAnalog *an = opaque;
+
+    for (unsigned i = 0; i < MIKROBUS_AN_ADCS && an[i].adc; i++) {
+        g_autofree char *item = g_strdup_printf("%u=%d", an[i].channel,
+                                                mv < 0 ? -1 : mv);
+
+        object_property_set_str(an[i].adc, "ain", item, &error_abort);
+    }
+}
+
 static const ClickInfo *mikrobus_find(const char *socket, const char *name)
 {
     for (unsigned i = 0; i < ARRAY_SIZE(mikrobus_clicks); i++) {
@@ -186,14 +212,59 @@ static unsigned mikrobus_pin(const MikrobusSocket *sock, const ClickInfo *c,
     return sock->pins[role];
 }
 
+static bool mikrobus_none(const char *click)
+{
+    return !click || !*click || !strcmp(click, "none");
+}
+
+Chardev *mikrobus_uart_chardev(const char *socket, const char *click)
+{
+    const ClickInfo *c;
+    g_autofree char *id = NULL;
+
+    if (mikrobus_none(click)) {
+        return NULL;
+    }
+    c = mikrobus_find(socket, click);
+    if (c->bus != CLICK_UART) {
+        return NULL;
+    }
+    id = g_strdup_printf("%s-click", socket);
+    return qemu_chardev_new(id, c->type, NULL, NULL, &error_fatal);
+}
+
 static void mikrobus_plug_one(Object *machine, const MikrobusSocket *sock,
                               unsigned index, const ClickInfo *c)
 {
     DeviceState *dev = NULL;
+    g_autofree char *child = g_strdup_printf("%s-click", sock->name);
 
+    if (c->bus == CLICK_UART) {
+        if (!sock->uart) {
+            error_report("%s: %s needs a UART, which this socket lacks "
+                         "(or another Click on its UART has it)",
+                         sock->name, c->name);
+            exit(1);
