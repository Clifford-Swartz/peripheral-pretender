+/*
+ * Microchip device description types used by generated register tables
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The tables themselves are generated by generator/atdf2qemu.py into
+ * include/hw/mchp/gen/ (per IP) and include/hw/arm/<device>_gen.h (SoC).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MCHP_MCHP_DEVICE_H
+#define HW_MCHP_MCHP_DEVICE_H
+
+#include "hw/misc/mchp_regfile.h"
+
+/*
+ * One register view of a multi-mode IP (SERCOM USART/SPI/I2C, TC COUNTn,
+ * RTC MODEn), selected by a field of a register common to all views. The
+ * per-IP header defines MCHP_<IP>_VIEW_SEL_OFFSET/SHIFT/LENGTH for it.
+ */
+typedef struct MchpRegView {
+    const char *name;               /* ATDF mode name, e.g. "USART_INT" */
+    uint32_t value;                 /* selector field value */
+    const MchpRegInfo *regs;
+    unsigned nregs;
+    const MchpResetOverride *ovr;   /* may be NULL */
+    unsigned novr;
+} MchpRegView;
+
+/*
+ * A register field whose reset value is loaded from an NVM fuse field, for
+ * example WDT CONFIG.PER from the user row. After mchp_regfile_reset():
+ *   v = (ldl_le(fuse_addr) & fuse_mask) >> ctz32(fuse_mask), inverted
+ *   within the field when invert is set, then deposited into reg_mask of
+ *   the register at reg_offset.
+ */
+typedef struct MchpFuseReset {
+    uint32_t fuse_addr;             /* absolute address of the fuse word */
+    uint32_t fuse_mask;
+    uint16_t reg_offset;
+    uint8_t reg_size;
+    uint32_t reg_mask;
+    bool invert;
+} MchpFuseReset;
+
+#define MCHP_INST_CORE       (1u << 0)  /* Arm core block, provided by armv7m */
+#define MCHP_INST_FUSES      (1u << 1)  /* NVM fuse rows, not MMIO */
+#define MCHP_INST_NO_REGS    (1u << 2)  /* no register map in the ATDF (PTC) */
+#define MCHP_INST_SHARED_IRQ (1u << 3)  /* NVIC line shared via an OR gate */
+
+typedef struct MchpInstanceInfo {
+    const char *name;               /* ATDF instance name, e.g. "SERCOM4" */
+    const char *module;             /* ATDF module name, e.g. "SERCOM" */
+    const char *ip_id;              /* e.g. "U2201"; "" for Arm core blocks */
+    const char *ip_version;         /* e.g. "3.1.1" */
+    uint32_t base;
+    uint32_t slot_size;             /* bytes to map at base; 0: not MMIO */
+    const char *alias_name;         /* "PORT_IOBUS", "DSU_EXT" or NULL */
+    uint32_t alias_base;            /* second view of the registers */
+    uint32_t alias_size;
+    int16_t irq;                    /* NVIC line, -1: none */
+    int16_t irq_input;              /* OR gate input when the line is shared */
+    int16_t pac_id;                 /* PAC peripheral id, -1: none */
+    int16_t gclk_core;              /* GCLK channel (GCLK_ID[_CORE]), -1 */
+    int16_t gclk_slow;              /* GCLK_ID_SLOW, -1: none */
+    int16_t dmac_rx;                /* DMAC_ID_RX, -1: none */
+    int16_t dmac_tx;                /* DMAC_ID_TX, -1: none */
+    uint32_t flags;                 /* MCHP_INST_* */
+    uint32_t regs_size;             /* register file bytes (MCHP_<IP>_SIZE) */
+    const MchpRegInfo *regs;        /* view at reset; NULL: no table */
+    unsigned nregs;
+    const MchpResetOverride *ovr;   /* may be NULL */
+    unsigned novr;
+    const MchpRegView *views;       /* NULL unless the IP has modes */
+    unsigned nviews;
+    uint16_t view_sel_offset;       /* register holding the view selector */
+    uint8_t view_sel_shift;         /* selector field, e.g. CTRLA.MODE */
+    uint8_t view_sel_length;
+    const MchpFuseReset *reset_from; /* may be NULL */
+    unsigned nreset_from;
+} MchpInstanceInfo;
+
+typedef struct MchpIrqLine {
+    const char *name;               /* ATDF name, e.g. "SERCOM0_6" */
+    int16_t line;                   /* NVIC input */
+    uint8_t nsources;               /* instances OR-ed onto the line */
+} MchpIrqLine;
+
+typedef struct MchpMemSegment {
+    const char *name;               /* ATDF memory-segment name */
+    uint32_t base;
+    uint32_t size;
+    const char *type;               /* "flash", "ram", "io", "fuses", ... */
+    bool writable;
+    bool exec;
+} MchpMemSegment;
+
+typedef struct MchpSignalInfo {
+    const char *instance;           /* e.g. "SERCOM4" */
+    const char *group;              /* signal group, e.g. "PAD" */
+    int16_t index;                  /* -1: none */
+    const char *function;           /* "A".."K", "default", "XIN32", ... */
+    int8_t pmux;                    /* PMUX value for A..K, else -1 */
+    const char *pad;                /* e.g. "PB10" */
+    int16_t pin;                    /* PORT pin, group * 32 + n; -1: none */
+} MchpSignalInfo;
+
+/* A GCLK peripheral channel or DMAC trigger and the instance using it. */
+typedef struct MchpPeriphRef {
+    uint8_t id;
+    const char *instance;
+    const char *param;              /* ATDF parameter, e.g. "GCLK_ID_CORE" */
+} MchpPeriphRef;
+
+#endif /* HW_MCHP_MCHP_DEVICE_H */
