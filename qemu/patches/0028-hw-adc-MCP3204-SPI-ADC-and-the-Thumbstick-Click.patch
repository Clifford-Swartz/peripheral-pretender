diff --git a/hw/adc/mchp_mcp3204.c b/hw/adc/mchp_mcp3204.c
new file mode 100644
index 0000000..6630f0e
--- /dev/null
+++ b/hw/adc/mchp_mcp3204.c
@@ -0,0 +1,279 @@
+/*
+ * Microchip MCP3204 4-channel 12-bit SPI ADC, and the Thumbstick Click
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * MCP3204/3208 data sheet (DS21298), section 5 and 6.1: with CS low, the
+ * first 1 on DIN is the start bit; then SGL/DIFF, D2, D1, D0 (D2 is
+ * ignored by the MCP3204). The input is sampled on the next clock, the
+ * clock after that shifts out a null bit (0), and the following twelve
+ * shift out the result MSB first. With CS still low, the device then
+ * shifts out the result again LSB first (B1 to B11), then zeros. CS
+ * high ends the conversion. DOUT is high impedance outside the result:
+ * it reads 0 here. The model works bit by bit, so any byte alignment of
+ * the command works. Result: 4096 * Vin / VREF, clipped to 0..4095; in
+ * differential mode Vin is IN+ minus IN- (CH0-CH1, CH1-CH0, CH2-CH3,
+ * CH3-CH2). Conversion time and sampling errors are not modelled.
+ *
+ * Thumbstick Click (MikroElektronika, schematic v101): the joystick's
+ * vertical potentiometer on CH0, horizontal on CH1, between VCC and GND
+ * (VREF = VCC = 3.3 V), push switch to ground on INT (R3 10k pull-up), CS#
+ * pulled up by R2 100k. MikroElektronika's thumbstick driver reads CH0
+ * as vertical (more is down) and CH1 as horizontal (more is right): "y"
+ * up lowers CH0, "x" right raises CH1, the centre is VREF / 2. Not
+ * checked against a physical Click.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/adc/mchp_mcp3204.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+
+#define MCP3204_CHANNELS    4
+#define MCP3204_MAX         4095
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpMcp3204State, MCHP_MCP3204)
+
+struct MchpMcp3204State {
+    SSIPeripheral parent_obj;
+
+    uint32_t in[MCP3204_CHANNELS];      /* mV */
+    uint32_t vref;                      /* mV */
+    bool started;
+    uint8_t clocks;                     /* since the start bit */
+    uint8_t cfg;                        /* SGL/DIFF D2 D1 D0 */
+    uint16_t result;
+
+    /* Thumbstick Click */
+    qemu_irq button;
+    int32_t x;
+    int32_t y;
+    bool pressed;
+};
+
+static uint16_t mcp3204_convert(MchpMcp3204State *s)
+{
+    unsigned ch = s->cfg & 3;
+    int64_t mv = s->in[ch];
+
+    if (!(s->cfg & 8)) {                /* differential: pairs */
+        mv -= s->in[ch ^ 1];
+    }
+    if (mv <= 0 || !s->vref) {
+        return 0;
+    }
+    return MIN(MCP3204_MAX, mv * 4096 / s->vref);
+}
+
+static unsigned mcp3204_clock(MchpMcp3204State *s, unsigned din)
+{
+    unsigned n;
+
+    if (!s->started) {
+        s->started = din;
+        s->clocks = 0;
+        s->cfg = 0;
+        return 0;
+    }
+    n = ++s->clocks;
+    if (n <= 4) {
+        s->cfg = s->cfg << 1 | din;
+        if (n == 4) {
+            s->result = mcp3204_convert(s);
+        }
+        return 0;
+    }
+    if (n >= 7 && n <= 18) {
+        return (s->result >> (18 - n)) & 1;         /* MSB first */
+    }
+    if (n >= 19 && n <= 29) {
+        return (s->result >> (n - 18)) & 1;         /* then LSB first */
+    }
+    s->clocks = MIN(n, 30);
+    return 0;                           /* sample, null bit, zeros */
+}
+
+static uint32_t mcp3204_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    MchpMcp3204State *s = MCHP_MCP3204(dev);
+    uint32_t out = 0;
+
+    for (int bit = 7; bit >= 0; bit--) {
+        out = out << 1 | mcp3204_clock(s, (val >> bit) & 1);
+    }
+    return out;
+}
+
+static int mcp3204_set_cs(SSIPeripheral *dev, bool high)
+{
+    MchpMcp3204State *s = MCHP_MCP3204(dev);
+
+    if (high) {
+        s->started = false;             /* ends the conversion */
+    }
+    return 0;
+}
+
+static void mcp3204_realize(SSIPeripheral *dev, Error **errp)
+{
+}
+
+static void mcp3204_reset(DeviceState *dev)
+{
+    MchpMcp3204State *s = MCHP_MCP3204(dev);
+
+    s->started = false;
+    s->clocks = 0;
+    s->cfg = 0;
+    s->result = 0;
+    s->parent_obj.cs = true;            /* CS# pulled up */
+}
+
+static void mcp3204_init(Object *obj)
+{
+    MchpMcp3204State *s = MCHP_MCP3204(obj);
+
+    for (unsigned i = 0; i < MCP3204_CHANNELS; i++) {
+        g_autofree char *name = g_strdup_printf("in%u", i);
+
+        object_property_add_uint32_ptr(obj, name, &s->in[i],
+                                       OBJ_PROP_FLAG_READWRITE);
+    }
+}
+
+static const Property mcp3204_properties[] = {
+    DEFINE_PROP_UINT32("vref", MchpMcp3204State, vref, 3300),
+};
+
+static const VMStateDescription vmstate_mcp3204 = {
+    .name = TYPE_MCHP_MCP3204,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, MchpMcp3204State),
+        VMSTATE_UINT32_ARRAY(in, MchpMcp3204State, MCP3204_CHANNELS),
+        VMSTATE_BOOL(started, MchpMcp3204State),
+        VMSTATE_UINT8(clocks, MchpMcp3204State),
+        VMSTATE_UINT8(cfg, MchpMcp3204State),
+        VMSTATE_UINT16(result, MchpMcp3204State),
+        VMSTATE_INT32(x, MchpMcp3204State),
+        VMSTATE_INT32(y, MchpMcp3204State),
+        VMSTATE_BOOL(pressed, MchpMcp3204State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mcp3204_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    dc->desc = "MCP3204 4-channel 12-bit SPI ADC";
+    dc->vmsd = &vmstate_mcp3204;
+    device_class_set_props(dc, mcp3204_properties);
+    device_class_set_legacy_reset(dc, mcp3204_reset);
+    k->realize = mcp3204_realize;
+    k->transfer = mcp3204_transfer;
+    k->set_cs = mcp3204_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+}
+
+/* Thumbstick Click: the stick sets CH0 and CH1, the switch INT */
+
+static void thumbstick_update(MchpMcp3204State *s)
+{
+    int64_t half = s->vref / 2;
+
+    s->in[0] = half - (int64_t)s->y * half / 1000;
+    s->in[1] = half + (int64_t)s->x * half / 1000;
+    qemu_set_irq(s->button, s->pressed ? 0 : -1);
+}
+
+static void thumbstick_get_axis(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    int32_t *axis = opaque;
+
+    visit_type_int32(v, name, axis, errp);
+}
+
+static void thumbstick_set_axis(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    int32_t *axis = opaque, value;
+
+    if (!visit_type_int32(v, name, &value, errp)) {
+        return;
+    }
+    if (value < -1000 || value > 1000) {
+        error_setg(errp, "%s must be -1000 to 1000", name);
+        return;
+    }
+    *axis = value;
+    thumbstick_update(MCHP_MCP3204(obj));
+}
+
+static bool thumbstick_get_pressed(Object *obj, Error **errp)
+{
+    return MCHP_MCP3204(obj)->pressed;
+}
+
+static void thumbstick_set_pressed(Object *obj, bool value, Error **errp)
+{
+    MchpMcp3204State *s = MCHP_MCP3204(obj);
+
+    s->pressed = value;
+    thumbstick_update(s);
+}
+
+static void thumbstick_reset(DeviceState *dev)
+{
+    mcp3204_reset(dev);
+    thumbstick_update(MCHP_MCP3204(dev));      /* the stick is held */
+}
+
+static void thumbstick_init(Object *obj)
+{
+    MchpMcp3204State *s = MCHP_MCP3204(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), &s->button,
+                             CLICK_THUMBSTICK_BUTTON, 1);
+    object_property_add(obj, "x", "int32", thumbstick_get_axis,
+                        thumbstick_set_axis, NULL, &s->x);
+    object_property_add(obj, "y", "int32", thumbstick_get_axis,
+                        thumbstick_set_axis, NULL, &s->y);
+    object_property_add_bool(obj, "pressed", thumbstick_get_pressed,
+                             thumbstick_set_pressed);
+}
+
+static void thumbstick_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "Thumbstick Click: MCP3204 with a joystick and its switch";
+    device_class_set_legacy_reset(dc, thumbstick_reset);
+}
+
+static const TypeInfo mcp3204_types[] = {
+    {
+        .name = TYPE_MCHP_MCP3204,
+        .parent = TYPE_SSI_PERIPHERAL,
+        .instance_size = sizeof(MchpMcp3204State),
+        .instance_init = mcp3204_init,
+        .class_init = mcp3204_class_init,
+    }, {
+        .name = TYPE_CLICK_THUMBSTICK,
+        .parent = TYPE_MCHP_MCP3204,
+        .instance_init = thumbstick_init,
+        .class_init = thumbstick_class_init,
+    },
+};
+
+DEFINE_TYPES(mcp3204_types)
