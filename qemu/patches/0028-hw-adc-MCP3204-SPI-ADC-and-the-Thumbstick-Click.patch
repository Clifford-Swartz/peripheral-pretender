diff --git a/include/hw/adc/mchp_mcp3204.h b/include/hw/adc/mchp_mcp3204.h
new file mode 100644
index 0000000..73d09e8
--- /dev/null
+++ b/include/hw/adc/mchp_mcp3204.h
@@ -0,0 +1,28 @@
+/*
+ * Microchip MCP3204 4-channel 12-bit SPI ADC, and the Thumbstick Click
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * "mchp-mcp3204": an SSI peripheral (chip select active low). QOM
+ * properties "in0".."in3" (the input voltages in mV, settable at run time)
+ * and "vref" (mV, default 3300).
+ *
+ * "click-thumbstick": an MCP3204 with a two-axis joystick on CH0
+ * (vertical) and CH1 (horizontal) and its push switch. QOM properties
+ * "x" (-1000 left .. 1000 right), "y" (-1000 down .. 1000 up) and
+ * "pressed"; GPIO output "button": 0 while pressed, -1 (released, the
+ * Click's pull-up sets the pin) otherwise.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_ADC_MCHP_MCP3204_H
+#define HW_ADC_MCHP_MCP3204_H
+
+#define TYPE_MCHP_MCP3204 "mchp-mcp3204"
+#define TYPE_CLICK_THUMBSTICK "click-thumbstick"
+
+#define CLICK_THUMBSTICK_BUTTON "button"
+
+#endif /* HW_ADC_MCHP_MCP3204_H */
diff --git a/tests/qtest/avr64ea48-cnano-test.c b/tests/qtest/avr64ea48-cnano-test.c
index 17494d7..0589139 100644
--- a/tests/qtest/avr64ea48-cnano-test.c
+++ b/tests/qtest/avr64ea48-cnano-test.c
@@ -312,6 +312,38 @@ static void test_oledc(const void *fw)
     qtest_quit(qts);
 }
 
+static uint8_t spi0_xfer(QTestState *qts, uint8_t v)
+{
+    qtest_writeb(qts, SPI0 + 4, v);
+    return qtest_readb(qts, SPI0 + 4);
+}
+
+/* Thumbstick Click on mikroBUS 3: MCP3204 (CS# PE3), switch on INT PE0 */
+static void test_thumbstick(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb3=thumbstick "
+                                  "-kernel %s", (const char *)fw);
+    unsigned hi, lo;
+
+    g_assert_cmphex(qtest_readb(qts, PORTE + P_IN) & BIT(0), ==, BIT(0));
+    qtest_qom_set_bool(qts, "/machine/mb3-click", "pressed", true);
+    g_assert_cmphex(qtest_readb(qts, PORTE + P_IN) & BIT(0), ==, 0);
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/mb3-click', 'property': 'x',"
+                             " 'value': -500 } }");
+    qtest_writeb(qts, PORTE + 0x05, BIT(3));
+    qtest_writeb(qts, PORTE + P_DIRSET, BIT(3));
+    qtest_writeb(qts, PORTA + 0x01, BIT(4) | BIT(6));
+    qtest_writeb(qts, SPI0 + 0, 0x21);
+    qtest_writeb(qts, PORTE + 0x06, BIT(3));
+    spi0_xfer(qts, 0x06);
+    hi = spi0_xfer(qts, 0x40);                          /* CH1 */
+    lo = spi0_xfer(qts, 0x00);
+    qtest_writeb(qts, PORTE + 0x05, BIT(3));
+    g_assert_cmpuint((hi & 0x0F) << 8 | lo, ==, 1024);  /* half left */
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_autofree char *fw = write_firmware();
@@ -327,6 +359,7 @@ int main(int argc, char **argv)
     qtest_add_data_func("avr64ea48-cnano/tcb", fw, test_tcb);
     qtest_add_data_func("avr64ea48-cnano/buzz", fw, test_buzz);
     qtest_add_data_func("avr64ea48-cnano/oledc", fw, test_oledc);
+    qtest_add_data_func("avr64ea48-cnano/thumbstick", fw, test_thumbstick);
     ret = g_test_run();
     unlink(fw);
     return ret;
diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index 5ef5820..fb09758 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -541,6 +541,78 @@ static void test_oledc(void)
     qtest_quit(qts);
 }
 
+static uint8_t spi_xfer(QTestState *qts, uint8_t v)
+{
+    qtest_writel(qts, SERCOM1 + 0x28, v);
+    return qtest_readl(qts, SERCOM1 + 0x28);
+}
+
+/* One MCP3204 conversion, the data sheet's 8-bit alignment (Figure 6-1) */
+static unsigned mcp3204_read(QTestState *qts, uint8_t b0, uint8_t b1)
+{
+    unsigned hi, lo;
+
+    qtest_writel(qts, PA + P_OUTCLR, BIT(17));          /* CS# (EXT1) */
+    g_assert_cmphex(spi_xfer(qts, b0), ==, 0);
+    hi = spi_xfer(qts, b1);
+    lo = spi_xfer(qts, 0);
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));
+    g_assert_cmphex(hi & 0xF0, ==, 0);                  /* hi-Z, null bit */
+    return (hi & 0x0F) << 8 | lo;
+}
+
+static void qom_set_int(QTestState *qts, const char *path, const char *prop,
+                        int64_t v)
+{
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': %s, 'property': %s, 'value': %"
+                             PRId64 " } }", path, prop, v);
+}
+
+/* Thumbstick Click on EXT1: MCP3204 on SPI (CS# PA17), switch on INT */
+static void test_thumbstick(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=thumbstick ");
+
+    g_assert_true(pin_high(qts, PA, 17));               /* R2 pull-up */
+    g_assert_true(pin_high(qts, PB, INT1_PIN));         /* R3 pull-up */
+    qtest_qom_set_bool(qts, CLICK1, "pressed", true);
+    g_assert_false(pin_high(qts, PB, INT1_PIN));
+    qtest_qom_set_bool(qts, CLICK1, "pressed", false);
+    g_assert_true(pin_high(qts, PB, INT1_PIN));
+
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);
+    qtest_writel(qts, SERCOM1 + 0x04, BIT(17));         /* RXEN */
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));
+    qtest_writel(qts, PA + P_DIRSET, BIT(17));
+    /* Centred: VREF / 2 on both axes */
+    g_assert_cmpuint(mcp3204_read(qts, 0x06, 0x00), ==, 2048);
+    g_assert_cmpuint(mcp3204_read(qts, 0x06, 0x40), ==, 2048);
+    qom_set_int(qts, CLICK1, "x", 1000);                /* right */
+    qom_set_int(qts, CLICK1, "y", 500);                 /* half up */
+    g_assert_cmpuint(mcp3204_read(qts, 0x06, 0x40), ==, 4095);
+    g_assert_cmpuint(mcp3204_read(qts, 0x06, 0x00), ==, 1024);
