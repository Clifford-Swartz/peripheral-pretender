+    qom_set_int(qts, CLICK1, "in0", 2000);
+    qtest_writel(qts, PA + P_OUTCLR, BIT(17));
+    g_assert_cmphex(spi_xfer(qts, 0x01), ==, 0);        /* start */
+    g_assert_cmphex(spi_xfer(qts, 0x80), ==, 0x02);     /* SGL CH0, B11 B10 */
+    g_assert_cmphex(spi_xfer(qts, 0x00), ==, 0x6C);     /* B9..B2 */
+    g_assert_cmphex(spi_xfer(qts, 0x00), ==, 0xA6);     /* B1 B0, B1..B6 */
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));
+    qtest_quit(qts);
