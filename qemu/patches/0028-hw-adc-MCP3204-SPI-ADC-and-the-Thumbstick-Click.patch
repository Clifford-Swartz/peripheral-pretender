+    g_assert_cmpuint(mcp3204_read(qts, 0x04, 0x40), ==, 3072);
+    g_assert_cmpuint(mcp3204_read(qts, 0x04, 0x00), ==, 0);
+    g_assert_cmpuint(mcp3204_read(qts, 0x06, 0x80), ==, 0);
+    qom_set_int(qts, CLICK1, "in2", 825);               /* plain MCP3204 */
+    g_assert_cmpuint(mcp3204_read(qts, 0x06, 0x80), ==, 1024);
+    /*
