diff --git a/hw/sensor/bme280.c b/hw/sensor/bme280.c
new file mode 100644
index 0000000..a65a0cf
--- /dev/null
+++ b/hw/sensor/bme280.c
@@ -0,0 +1,599 @@
+/*
+ * Bosch BME280 humidity, pressure and temperature sensor (I2C)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * BME280 data sheet (BST-BME280-DS002-15 rev 1.6), I2C only (the SPI
+ * interface is not modelled). Reads run from the register pointer and
+ * auto-increment; a write is pairs of register and data. 0xD0 reads the
+ * chip ID 0x60, 0xB6 to 0xE0 resets. The calibration image (0x88-0xA1,
+ * 0xE1-0xE7) is a fixed set of typical values; the raw readings are found
+ * by bisection over the data sheet's integer compensation (4.2.3) so that
+ * firmware compensating them reads the properties back: temperature to
+ * 0.01 degree, pressure to about 0.1 Pa, humidity to about 0.01 %RH.
+ *
+ * ctrl_hum takes effect with the next ctrl_meas write. Forced mode makes
+ * one measurement and goes back to sleep; normal mode measures and waits
+ * the standby time t_sb, over and over. A measurement takes the typical
+ * time of section 9.1 for its oversampling (status.measuring meanwhile);
+ * its results reach the data registers at its end, or, during a burst
+ * read, at that read's STOP. A skipped measurement reads 0x80000 (0x8000
+ * for humidity). Without the IIR filter, temperature and pressure have
+ * 16 + (oversampling - 1) bits; with it, 20 bits through
+ * (old * (c - 1) + new) / c, reset by writing the filter field. The
+ * config register is written in normal mode too (MikroElektronika's
+ * driver relies on it). No physical part checked it.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/i2c/i2c.h"
+#include "hw/sensor/bme280.h"
+#include "migration/vmstate.h"
+
+#define REG_CALIB0          0x88        /* to 0xA1 */
+#define REG_ID              0xD0
+#define REG_RESET           0xE0
+#define REG_CALIB1          0xE1        /* to 0xE7 */
+#define REG_CTRL_HUM        0xF2
+#define REG_STATUS          0xF3
+#define REG_CTRL_MEAS       0xF4
+#define REG_CONFIG          0xF5
+#define REG_DATA            0xF7        /* to 0xFE */
+
+#define CHIP_ID             0x60
+#define RESET_CMD           0xB6
+#define ST_MEASURING        BIT(3)
+#define MODE_SLEEP          0
+#define MODE_NORMAL         3
+
+#define SKIPPED_TP          0x80000
+#define SKIPPED_H           0x8000
+
+/* Typical calibration (dig_T3 positive and 0xE4/0xE6 below 0x80) */
+static const uint16_t cal_t1 = 28009;
+static const int16_t cal_t2 = 25654, cal_t3 = 50;
+static const uint16_t cal_p1 = 37064;
+static const int16_t cal_p[10] = { 0, 0, -10664, 3024, 7487, -72, -7,
+                                   9900, -10230, 4285 };     /* P2..P9 */
+static const uint8_t cal_h1 = 75, cal_h3 = 0;
+static const int16_t cal_h2 = 362, cal_h4 = 321, cal_h5 = 50;
+static const int8_t cal_h6 = 30;
+
+/* t_sb codes in microseconds */
+static const uint32_t t_sb_us[8] = { 500, 62500, 125000, 250000, 500000,
+                                     1000000, 10000, 20000 };
+
+OBJECT_DECLARE_SIMPLE_TYPE(Bme280State, BME280)
+
+struct Bme280State {
+    I2CSlave parent_obj;
+
+    uint8_t ptr;
+    bool ptr_set;               /* a write's register byte came */
+    bool reading;               /* in a read transfer (results held) */
+    bool pending;               /* results to land at the read's end */
+
+    uint8_t ctrl_hum;
+    uint8_t osrs_h;             /* ctrl_hum as of the last ctrl_meas */
+    uint8_t ctrl_meas;
+    uint8_t config;
+    bool measuring;
+    bool standby;               /* normal mode, between measurements */
+    bool filter_fresh;          /* next sample passes the IIR unchanged */
+    uint32_t filt_t, filt_p;
+    uint32_t adc_t, adc_p, adc_h;   /* the data registers */
+    uint32_t new_t, new_p, new_h;   /* the measurement that finished */
+
+    int32_t temperature;        /* m°C */
+    int32_t pressure;           /* Pa */
+    int32_t humidity;           /* m%RH */
+
+    QEMUTimer *timer;
+};
+
+/* ---- the data sheet's compensation (4.2.3) and its inverse ---- */
+
+static int32_t comp_t(int32_t adc, int32_t *t_fine)
+{
+    int32_t var1 = (((adc >> 3) - ((int32_t)cal_t1 << 1)) * cal_t2) >> 11;
+    int32_t d = (adc >> 4) - (int32_t)cal_t1;
+    int32_t var2 = (((d * d) >> 12) * cal_t3) >> 14;
+
+    *t_fine = var1 + var2;
+    return (*t_fine * 5 + 128) >> 8;
+}
+
+/* Q24.8 Pa */
+static uint32_t comp_p(int32_t adc, int32_t t_fine)
+{
+    int64_t var1 = (int64_t)t_fine - 128000, var2, p;
+
+    var2 = var1 * var1 * cal_p[6];
+    var2 += (var1 * cal_p[5]) * 131072;
+    var2 += (int64_t)cal_p[4] * 34359738368LL;
+    var1 = ((var1 * var1 * cal_p[3]) >> 8) + ((var1 * cal_p[2]) * 4096);
+    var1 = ((((int64_t)1) << 47) + var1) * cal_p1 >> 33;
+    if (var1 == 0) {
+        return 0;
+    }
+    p = 1048576 - adc;
+    p = ((p * 2147483648LL) - var2) * 3125 / var1;
+    var1 = ((int64_t)cal_p[9] * (p >> 13) * (p >> 13)) >> 25;
+    var2 = ((int64_t)cal_p[8] * p) >> 19;
+    return (uint32_t)(((p + var1 + var2) >> 8) + ((int64_t)cal_p[7] << 4));
+}
+
+/* Q22.10 %RH */
+static uint32_t comp_h(int32_t adc, int32_t t_fine)
+{
+    int32_t v = t_fine - 76800;
+
+    v = ((((adc << 14) - ((int32_t)cal_h4 << 20) - (cal_h5 * v)) + 16384)
+         >> 15) *
+        (((((((v * cal_h6) >> 10) * (((v * cal_h3) >> 11) + 32768)) >> 10)
+           + 2097152) * cal_h2 + 8192) >> 14);
+    v -= ((((v >> 15) * (v >> 15)) >> 7) * cal_h1) >> 4;
+    v = MAX(v, 0);
+    v = MIN(v, 419430400);
+    return (uint32_t)v >> 12;
+}
+
+/* The smallest 20-bit reading giving at least @centi (0.01 °C) */
+static uint32_t inv_t(int32_t centi, int32_t *t_fine)
+{
+    uint32_t lo = 0, hi = (1 << 20) - 1;
+
+    while (lo < hi) {
+        uint32_t mid = (lo + hi) / 2;
+
+        if (comp_t(mid, t_fine) >= centi) {
+            hi = mid;
+        } else {
+            lo = mid + 1;
+        }
+    }
+    comp_t(lo, t_fine);
+    return lo;
+}
+
+/* The reading nearest @pa (pressure falls as the reading rises) */
+static uint32_t inv_p(int32_t pa, int32_t t_fine)
+{
+    int64_t tgt = (int64_t)pa * 256;
+    uint32_t lo = 0, hi = (1 << 20) - 1;
+
+    while (lo < hi) {
+        uint32_t mid = (lo + hi) / 2;
+
+        if (comp_p(mid, t_fine) <= tgt) {
+            hi = mid;
+        } else {
+            lo = mid + 1;
+        }
+    }
+    if (lo > 0 && llabs(comp_p(lo - 1, t_fine) - tgt) <
+                  llabs(comp_p(lo, t_fine) - tgt)) {
+        lo--;
+    }
+    return lo;
+}
+
+static uint32_t inv_h(int32_t milli, int32_t t_fine)
+{
+    int64_t tgt = (int64_t)milli * 1024 / 1000;
+    uint32_t lo = 0, hi = 0xFFFF;
+
+    while (lo < hi) {
+        uint32_t mid = (lo + hi) / 2;
+
+        if (comp_h(mid, t_fine) >= tgt) {
+            hi = mid;
+        } else {
+            lo = mid + 1;
+        }
+    }
+    if (lo > 0 && llabs(comp_h(lo - 1, t_fine) - tgt) <
+                  llabs(comp_h(lo, t_fine) - tgt)) {
+        lo--;
+    }
+    return lo;
+}
+
+/* ---- measurements ---- */
+
+static unsigned osrs_factor(unsigned code)
+{
+    return code ? 1 << (MIN(code, 5) - 1) : 0;
+}
+
+/* Section 9.1, typical: 1 + 2 T + (2 P + 0.5) + (2 H + 0.5) ms */
+static int64_t meas_us(Bme280State *s)
+{
+    unsigned t = osrs_factor(s->ctrl_meas >> 5);
+    unsigned p = osrs_factor((s->ctrl_meas >> 2) & 7);
+    unsigned h = osrs_factor(s->osrs_h);
+    int64_t us = 1000 + 2000 * t;
+
+    if (p) {
+        us += 2000 * p + 500;
+    }
+    if (h) {
+        us += 2000 * h + 500;
+    }
+    return us;
+}
+
+static uint32_t iir(Bme280State *s, uint32_t *mem, uint32_t adc)
+{
+    unsigned code = (s->config >> 2) & 7;
+    unsigned c = 1 << MIN(code, 4);     /* off, 2, 4, 8, 16 */
+
+    if (c == 1) {
+        return adc;
+    }
+    if (s->filter_fresh) {
+        *mem = adc;
+    } else {
+        *mem = (uint32_t)(((uint64_t)*mem * (c - 1) + adc) / c);
+    }
+    return *mem;
+}
+
+/* The finished measurement's readings, at its oversampling and filter */
+static void measure(Bme280State *s)
+{
+    unsigned ot = s->ctrl_meas >> 5, op = (s->ctrl_meas >> 2) & 7;
+    bool filt = (s->config >> 2) & 7;
+    int32_t t_fine;
+    int32_t centi = (s->temperature + (s->temperature < 0 ? -5 : 5)) / 10;
+    uint32_t t = inv_t(centi, &t_fine);
+    uint32_t p = inv_p(s->pressure, t_fine);
+    uint32_t h = inv_h(s->humidity, t_fine);
+
+    if (!filt) {
+        /* 16 + (osrs - 1) bits, the rest zero */
+        t &= ~((1u << (5 - MIN(MAX(ot, 1), 5))) - 1);
+        p &= ~((1u << (5 - MIN(MAX(op, 1), 5))) - 1);
+    }
+    s->new_t = ot ? iir(s, &s->filt_t, t) : SKIPPED_TP;
+    s->new_p = op ? iir(s, &s->filt_p, p) : SKIPPED_TP;
+    s->new_h = s->osrs_h ? h : SKIPPED_H;
+    if (filt && (ot || op)) {
+        s->filter_fresh = false;
+    }
+}
+
+static void land(Bme280State *s)
+{
+    s->adc_t = s->new_t;
+    s->adc_p = s->new_p;
+    s->adc_h = s->new_h;
+    s->pending = false;
+}
+
+static void start_measurement(Bme280State *s)
+{
+    s->measuring = true;
+    s->standby = false;
+    timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              meas_us(s) * SCALE_US);
+}
+
+static void bme_timer(void *opaque)
+{
+    Bme280State *s = opaque;
+
+    if (s->standby) {
+        start_measurement(s);
+        return;
+    }
+    s->measuring = false;
+    measure(s);
+    if (s->reading) {
+        s->pending = true;
+    } else {
+        land(s);
+    }
+    if ((s->ctrl_meas & 3) == MODE_NORMAL) {
+        s->standby = true;
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  t_sb_us[s->config >> 5] * SCALE_US);
+    } else {
+        s->ctrl_meas &= ~3;             /* forced: back to sleep */
+    }
+}
+
+static void bme_reset_state(Bme280State *s)
+{
+    s->ctrl_hum = 0;
+    s->osrs_h = 0;
+    s->ctrl_meas = 0;
+    s->config = 0;
+    s->measuring = false;
+    s->standby = false;
+    s->filter_fresh = true;
+    s->pending = false;
+    s->adc_t = s->new_t = SKIPPED_TP;
+    s->adc_p = s->new_p = SKIPPED_TP;
+    s->adc_h = s->new_h = SKIPPED_H;
+    timer_del(s->timer);
+}
+
+static void bme_write(Bme280State *s, uint8_t reg, uint8_t v)
+{
+    unsigned mode;
+
+    switch (reg) {
+    case REG_RESET:
+        if (v == RESET_CMD) {
+            bme_reset_state(s);
+        }
+        break;
+    case REG_CTRL_HUM:
+        s->ctrl_hum = v & 7;
+        break;
+    case REG_CTRL_MEAS:
+        s->ctrl_meas = v;
+        s->osrs_h = s->ctrl_hum;
+        mode = v & 3;
+        if (s->measuring) {
+            break;                      /* takes effect after this one */
+        }
+        if (mode == MODE_SLEEP) {
+            s->standby = false;
+            timer_del(s->timer);
+        } else if (mode != MODE_NORMAL || !s->standby) {
+            start_measurement(s);
+        }
+        break;
+    case REG_CONFIG:
+        if (((v ^ s->config) >> 2) & 7) {
+            s->filter_fresh = true;
+        }
+        s->config = v & 0xFD;
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bme280: write 0x%02x to read-only 0x%02x\n", v, reg);
+        break;
+    }
+}
+
+static uint8_t calib_byte(unsigned off)
+{
+    uint8_t lo[26], hi[7];
+    uint16_t w[12] = { cal_t1, cal_t2, cal_t3, cal_p1, cal_p[2], cal_p[3],
+                       cal_p[4], cal_p[5], cal_p[6], cal_p[7], cal_p[8],
+                       cal_p[9] };
+
+    for (unsigned i = 0; i < 12; i++) {
+        lo[2 * i] = w[i] & 0xFF;
+        lo[2 * i + 1] = w[i] >> 8;
+    }
+    lo[24] = 0;
+    lo[25] = cal_h1;
+    hi[0] = cal_h2 & 0xFF;
+    hi[1] = (uint16_t)cal_h2 >> 8;
+    hi[2] = cal_h3;
+    hi[3] = (cal_h4 >> 4) & 0xFF;
+    hi[4] = (cal_h5 & 0xF) << 4 | (cal_h4 & 0xF);
+    hi[5] = (cal_h5 >> 4) & 0xFF;
+    hi[6] = (uint8_t)cal_h6;
+    if (off >= REG_CALIB0 && off < REG_CALIB0 + sizeof(lo)) {
+        return lo[off - REG_CALIB0];
+    }
+    if (off >= REG_CALIB1 && off < REG_CALIB1 + sizeof(hi)) {
+        return hi[off - REG_CALIB1];
+    }
+    return 0;
+}
+
+static uint8_t bme_read(Bme280State *s, uint8_t reg)
+{
+    switch (reg) {
+    case REG_ID:
+        return CHIP_ID;
+    case REG_CTRL_HUM:
+        return s->ctrl_hum;
+    case REG_STATUS:
+        return s->measuring ? ST_MEASURING : 0;
+    case REG_CTRL_MEAS:
+        return s->ctrl_meas;
+    case REG_CONFIG:
+        return s->config;
+    case REG_DATA:
+        return s->adc_p >> 12;
+    case REG_DATA + 1:
+        return s->adc_p >> 4;
+    case REG_DATA + 2:
+        return (s->adc_p & 0xF) << 4;
+    case REG_DATA + 3:
+        return s->adc_t >> 12;
+    case REG_DATA + 4:
+        return s->adc_t >> 4;
+    case REG_DATA + 5:
+        return (s->adc_t & 0xF) << 4;
+    case REG_DATA + 6:
+        return s->adc_h >> 8;
+    case REG_DATA + 7:
+        return s->adc_h & 0xFF;
+    default:
+        return calib_byte(reg);
+    }
+}
+
+static int bme_event(I2CSlave *i2c, enum i2c_event event)
+{
+    Bme280State *s = BME280(i2c);
+
+    switch (event) {
+    case I2C_START_SEND:
+        s->ptr_set = false;
+        s->reading = false;
+        break;
+    case I2C_START_RECV:
+        s->reading = true;
+        break;
+    case I2C_FINISH:
+        s->reading = false;
+        if (s->pending) {
+            land(s);
+        }
+        break;
+    default:
+        break;
+    }
+    return 0;
+}
+
+static int bme_send(I2CSlave *i2c, uint8_t data)
+{
+    Bme280State *s = BME280(i2c);
+
+    if (!s->ptr_set) {
+        s->ptr = data;
+        s->ptr_set = true;
+    } else {
+        bme_write(s, s->ptr, data);     /* pairs: no auto-increment */
+        s->ptr_set = false;
+    }
+    return 0;
+}
+
+static uint8_t bme_recv(I2CSlave *i2c)
+{
+    Bme280State *s = BME280(i2c);
+
+    return bme_read(s, s->ptr++);
+}
+
+static void bme_set_int(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    Bme280State *s = BME280(obj);
+    int32_t *field, lo, hi, val;
+
+    if (!strcmp(name, "temperature")) {
+        field = &s->temperature, lo = -40000, hi = 85000;
+    } else if (!strcmp(name, "pressure")) {
+        field = &s->pressure, lo = 30000, hi = 110000;
+    } else {
+        field = &s->humidity, lo = 0, hi = 100000;
+    }
+    if (!visit_type_int32(v, name, &val, errp)) {
+        return;
+    }
+    if (val < lo || val > hi) {
+        error_setg(errp, "%s must be %d to %d", name, lo, hi);
+        return;
+    }
+    *field = val;
+}
+
+static void bme_get_int(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    Bme280State *s = BME280(obj);
+    int32_t val = !strcmp(name, "temperature") ? s->temperature :
+                  !strcmp(name, "pressure") ? s->pressure : s->humidity;
+
+    visit_type_int32(v, name, &val, errp);
+}
+
+static void bme_reset(DeviceState *dev)
+{
+    Bme280State *s = BME280(dev);
+
+    s->ptr = 0;
+    s->ptr_set = false;
+    s->reading = false;
+    bme_reset_state(s);
+}
+
+static void bme_init(Object *obj)
+{
+    Bme280State *s = BME280(obj);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, bme_timer, s);
+    s->temperature = 25000;
+    s->pressure = 101325;
+    s->humidity = 50000;
+    object_property_add(obj, "temperature", "int", bme_get_int,
+                        bme_set_int, NULL, NULL);
+    object_property_add(obj, "pressure", "int", bme_get_int,
+                        bme_set_int, NULL, NULL);
+    object_property_add(obj, "humidity", "int", bme_get_int,
+                        bme_set_int, NULL, NULL);
+}
+
+static void bme_finalize(Object *obj)
+{
+    timer_free(BME280(obj)->timer);
+}
+
