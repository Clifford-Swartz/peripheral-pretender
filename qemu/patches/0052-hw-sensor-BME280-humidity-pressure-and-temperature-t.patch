+/*
+ * Weather Click: BME280 at 0x76 on EXT1. A forced measurement at x16
+ * (filter off: 20 bits) gives the raw readings that compensate to the
+ * properties, then sleep; skipped measurements read 0x80000/0x8000.
+ */
+#define BME280          0x76
+
+static void bme_data(QTestState *qts, uint32_t *p, uint32_t *t, uint32_t *h)
+{
+    uint8_t d[8];
+
+    i2c_rd(qts, BME280, 0xF7, d, 8);
+    *p = d[0] << 12 | d[1] << 4 | d[2] >> 4;
+    *t = d[3] << 12 | d[4] << 4 | d[5] >> 4;
+    *h = d[6] << 8 | d[7];
+}
+
+static void test_weather(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext1=weather ");
+    uint8_t d[4];
+    uint32_t p, t, h;
+
+    i2c_rd(qts, BME280, 0xD0, d, 1);
+    g_assert_cmphex(d[0], ==, 0x60);
+    i2c_rd(qts, BME280, 0x88, d, 4);                /* dig_T1, dig_T2 */
+    g_assert_cmphex(d[0] | d[1] << 8, ==, 28009);
+    g_assert_cmphex(d[2] | d[3] << 8, ==, 25654);
+    bme_data(qts, &p, &t, &h);
+    g_assert_cmphex(p, ==, 0x80000);
+    g_assert_cmphex(h, ==, 0x8000);
+
+    /* Pairs of register and value; ctrl_hum counts at ctrl_meas */
+    g_assert_true(i2c_wr(qts, BME280, 0xF2, (const uint8_t[]){ 0x01 }, 1));
+    g_assert_true(i2c_wr(qts, BME280, 0xF4, (const uint8_t[]){ 0xB5 }, 1));
+    i2c_rd(qts, BME280, 0xF3, d, 1);
+    g_assert_cmphex(d[0], ==, 0x08);                /* measuring */
+    qtest_clock_step(qts, 70 * SCALE_MS);           /* 1+32+32.5+2.5 ms */
+    i2c_rd(qts, BME280, 0xF3, d, 2);
+    g_assert_cmphex(d[0], ==, 0x00);
+    g_assert_cmphex(d[1], ==, 0xB4);                /* back to sleep */
+    bme_data(qts, &p, &t, &h);
+    g_assert_cmpuint(t, ==, 529864);
+    g_assert_cmpuint(p, ==, 327438);
+    g_assert_cmpuint(h, ==, 29614);
+
+    /* Pressure skipped, at x1 temperature has 16 bits */
+    qom_set_int(qts, CLICK1, "temperature", -40000);
+    g_assert_true(i2c_wr(qts, BME280, 0xF4, (const uint8_t[]){ 0x21 }, 1));
+    qtest_clock_step(qts, 10 * SCALE_MS);
+    bme_data(qts, &p, &t, &h);
+    g_assert_cmphex(p, ==, 0x80000);
+    g_assert_cmphex(t & 0xF, ==, 0);
+    g_assert_cmpuint(t, ==, 317304 & ~0xF);
+
+    /* Soft reset */
+    g_assert_true(i2c_wr(qts, BME280, 0xE0, (const uint8_t[]){ 0xB6 }, 1));
+    i2c_rd(qts, BME280, 0xF2, d, 1);
+    g_assert_cmphex(d[0], ==, 0);
+    qtest_quit(qts);
+}
