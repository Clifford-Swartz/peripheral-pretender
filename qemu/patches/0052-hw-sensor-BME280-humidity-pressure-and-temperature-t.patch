+/*
+ * Bosch BME280 humidity, pressure and temperature sensor (I2C)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * I2C address 0x76 (SDO low) or 0x77. The air it measures: "temperature"
+ * (milli-degrees Celsius, -40000 to 85000), "pressure" (Pa, 30000 to
+ * 110000) and "humidity" (thousandths of %RH, 0 to 100000), settable
+ * while running.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SENSOR_BME280_H
+#define HW_SENSOR_BME280_H
+
+#define TYPE_BME280 "bme280"
+#define BME280_ADDR 0x76
+
+#endif /* HW_SENSOR_BME280_H */
