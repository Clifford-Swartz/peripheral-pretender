+
+static void bme_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->desc = "BME280 humidity, pressure and temperature sensor";
+    dc->vmsd = &vmstate_bme;
+    device_class_set_legacy_reset(dc, bme_reset);
+    k->event = bme_event;
+    k->send = bme_send;
