--- /dev/null
+++ b/include/hw/rtc/mchp_mcp7941x.h
@@ -0,0 +1,27 @@
+/*
+ * Microchip MCP79410/MCP79411/MCP79412 I2C RTCC with SRAM and EEPROM
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * "mchp-mcp79411": answers at I2C 0x6F (RTCC registers and SRAM) and 0x57
+ * (EEPROM). QOM properties: "time" ("YYYY-MM-DD HH:MM:SS", 24-hour, years
+ * 2000-2099; reading gives the counters, writing loads them), "running"
+ * (read-only: the oscillator runs), "eui48" (the pre-programmed node
+ * address, "xx:xx:xx:xx:xx:xx"; default 00:04:A3:00:00:01, Microchip's
+ * OUI with a made-up extension). GPIO output "mfp": the open-drain MFP
+ * pin, 0 while driven low, -1 while released.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_RTC_MCHP_MCP7941X_H
+#define HW_RTC_MCHP_MCP7941X_H
+
+#define TYPE_MCHP_MCP79411 "mchp-mcp79411"
+
+#define MCHP_MCP7941X_RTCC_ADDR     0x6F
+#define MCHP_MCP7941X_EEPROM_ADDR   0x57
+#define MCHP_MCP7941X_MFP           "mfp"
+
+#endif /* HW_RTC_MCHP_MCP7941X_H */
