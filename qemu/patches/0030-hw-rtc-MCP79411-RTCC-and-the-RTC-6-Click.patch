+/* RTC 6 Click on EXT2: MCP79411 at 0x6F (RTCC, SRAM) and 0x57 (EEPROM) */
+#define RTCC            0x6F
+#define RTCEE           0x57
+#define MFP_PIN         28      /* PA28, EXT2 INT */
+
+static uint8_t rtc_reg(QTestState *qts, uint8_t reg)
+{
+    uint8_t v;
+
+    i2c_rd(qts, RTCC, reg, &v, 1);
+    return v;
+}
+
+static void rtc_set(QTestState *qts, uint8_t reg, uint8_t v)
+{
+    g_assert_true(i2c_wr(qts, RTCC, reg, &v, 1));
+}
+
+static char *qom_str(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments': {"
+                           " 'path': %s, 'property': %s } }", path, prop);
+    char *v = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return v;
+}
+
+static void test_rtc6_time(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext2=rtc6 ");
+    static const uint8_t por[] = { 0, 0, 0, 1, 1, 1, 1, 0x80, 0 };
+    /* 2023-12-31 23:59:58, weekday 7, VBATEN, oscillator on */
+    static const uint8_t newyear[] = { 0x80 | 0x58, 0x59, 0x23, 0x0F, 0x31,
+                                       0x12, 0x23 };
+    static const uint8_t leap[] = { 0x80 | 0x59, 0x59, 0x71, 0x03, 0x28,
+                                    0x02, 0x24 };
+    uint8_t r[9];
+    g_autofree char *t0 = NULL, *t1 = NULL;
+
+    i2c_rd(qts, RTCC, 0x00, r, 9);
+    g_assert_cmpmem(r, 9, por, 9);
+    t0 = qom_str(qts, CLICK2, "time");
+    g_assert_cmpstr(t0, ==, "2001-01-01 00:00:00");
+    g_assert_true(pin_high(qts, PA, MFP_PIN));          /* OUT = 1, R2 */
+    rtc_set(qts, 0x07, 0x00);                           /* OUT = 0 */
+    g_assert_false(pin_high(qts, PA, MFP_PIN));
+    /* Stopped: the counters hold */
+    qtest_clock_step(qts, 3 * NANOSECONDS_PER_SECOND);
+    g_assert_cmphex(rtc_reg(qts, 0x00), ==, 0x00);
+    g_assert_true(i2c_wr(qts, RTCC, 0x00, newyear, sizeof(newyear)));
+    g_assert_cmphex(rtc_reg(qts, 0x03), ==, 0x2F);      /* OSCRUN */
+    qtest_clock_step(qts, 2 * NANOSECONDS_PER_SECOND);
+    i2c_rd(qts, RTCC, 0x00, r, 7);
+    g_assert_cmphex(r[0], ==, 0x80);                    /* ST, :00 */
+    g_assert_cmphex(r[1], ==, 0x00);
+    g_assert_cmphex(r[2], ==, 0x00);
+    g_assert_cmphex(r[3], ==, 0x29);                    /* weekday 1 */
+    g_assert_cmphex(r[4], ==, 0x01);
+    g_assert_cmphex(r[5], ==, 0x21);                    /* LPYR, January */
+    g_assert_cmphex(r[6], ==, 0x24);
+    t1 = qom_str(qts, CLICK2, "time");
+    g_assert_cmpstr(t1, ==, "2024-01-01 00:00:00");
+    /* 12-hour mode: 11:59:59 PM on 28 February 2024 (a leap year) */
+    g_assert_true(i2c_wr(qts, RTCC, 0x00, leap, sizeof(leap)));
+    qtest_clock_step(qts, NANOSECONDS_PER_SECOND);
+    i2c_rd(qts, RTCC, 0x02, r, 3);
+    g_assert_cmphex(r[0], ==, 0x52);                    /* 12 AM */
+    g_assert_cmphex(r[1] & 7, ==, 4);
+    g_assert_cmphex(r[2], ==, 0x29);                    /* 29 February */
+    /* ST cleared: OSCRUN clears, the counters stop */
+    rtc_set(qts, 0x00, 0x10);
+    g_assert_cmphex(rtc_reg(qts, 0x03) & 0x20, ==, 0);
+    qtest_clock_step(qts, 2 * NANOSECONDS_PER_SECOND);
+    g_assert_cmphex(rtc_reg(qts, 0x00), ==, 0x10);
+    qtest_quit(qts);
+}
+
+static void test_rtc6_alarm(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext2=rtc6 ");
+
+    /* Alarm 0 on seconds = 05, active low; started at :00 */
+    rtc_set(qts, 0x0A, 0x05);
+    rtc_set(qts, 0x0D, 0x00);                           /* ALMPOL 0, secs */
+    rtc_set(qts, 0x07, 0x10);                           /* ALM0EN */
+    g_assert_true(pin_high(qts, PA, MFP_PIN));          /* !IF: released */
+    rtc_set(qts, 0x00, 0x80);
+    qtest_clock_step(qts, 4 * NANOSECONDS_PER_SECOND + 900 * SCALE_MS);
+    g_assert_true(pin_high(qts, PA, MFP_PIN));
+    qtest_clock_step(qts, 200 * SCALE_MS);              /* :05 */
+    g_assert_false(pin_high(qts, PA, MFP_PIN));
+    g_assert_cmphex(rtc_reg(qts, 0x0D), ==, 0x08);      /* ALM0IF */
+    rtc_set(qts, 0x0D, 0x00);                           /* still :05 */
+    g_assert_cmphex(rtc_reg(qts, 0x0D), ==, 0x08);
+    qtest_clock_step(qts, NANOSECONDS_PER_SECOND);      /* latched */
+    g_assert_false(pin_high(qts, PA, MFP_PIN));
+    rtc_set(qts, 0x0D, 0x00);
+    g_assert_true(pin_high(qts, PA, MFP_PIN));
+    /* ALMPOL 1 (ALM1WKDAY reads it); both alarms: OR */
+    rtc_set(qts, 0x11, 0x08);
+    rtc_set(qts, 0x14, 0x00);
+    rtc_set(qts, 0x0D, 0x80);
+    g_assert_cmphex(rtc_reg(qts, 0x14), ==, 0x80);
+    rtc_set(qts, 0x07, 0x30);
+    g_assert_false(pin_high(qts, PA, MFP_PIN));         /* no IF: low */
+    qtest_clock_step(qts, 2 * NANOSECONDS_PER_SECOND);  /* :08 */
+    g_assert_true(pin_high(qts, PA, MFP_PIN));
+    g_assert_cmphex(rtc_reg(qts, 0x14), ==, 0x88);
+    /* 1 Hz square wave: high, then low half a second later */
+    rtc_set(qts, 0x07, 0x40);
+    qtest_clock_step(qts, NANOSECONDS_PER_SECOND - 100 * SCALE_MS);
+    g_assert_true(pin_high(qts, PA, MFP_PIN));
+    qtest_clock_step(qts, 500 * SCALE_MS);
+    g_assert_false(pin_high(qts, PA, MFP_PIN));
+    qtest_clock_step(qts, 500 * SCALE_MS);
+    g_assert_true(pin_high(qts, PA, MFP_PIN));
+    qtest_quit(qts);
+}
+
+static void test_rtc6_memories(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext2=rtc6 ");
+    static const uint8_t data[] = { 0xDE, 0xAD, 0xBE, 0xEF };
+    uint8_t r[8];
+
+    /* SRAM: sequential access wraps from 0x5F to 0x20 */
+    g_assert_true(i2c_wr(qts, RTCC, 0x5E, data, 4));
+    i2c_rd(qts, RTCC, 0x5E, r, 4);
+    g_assert_cmpmem(r, 4, data, 4);
+    i2c_rd(qts, RTCC, 0x20, r, 2);
+    g_assert_cmphex(r[1], ==, 0xEF);
+    /* EEPROM: erased; the EUI-48 at 0xF2 */
+    i2c_rd(qts, RTCEE, 0x10, r, 2);
+    g_assert_cmphex(r[0], ==, 0xFF);
+    i2c_rd(qts, RTCEE, 0xF0, r, 8);
+    g_assert_cmphex(r[1], ==, 0xFF);
+    g_assert_cmphex(r[2], ==, 0x00);
+    g_assert_cmphex(r[3], ==, 0x04);
+    g_assert_cmphex(r[4], ==, 0xA3);
+    /* Page write, then 5 ms without ACK */
+    g_assert_true(i2c_wr(qts, RTCEE, 0x10, data, 4));
+    g_assert_false(i2c_wr(qts, RTCEE, 0x10, NULL, 0));
+    qtest_clock_step(qts, 6 * SCALE_MS);
+    i2c_rd(qts, RTCEE, 0x10, r, 4);
+    g_assert_cmpmem(r, 4, data, 4);
+    /* A page write wraps within its 8 bytes */
+    g_assert_true(i2c_wr(qts, RTCEE, 0x16, data, 4));
+    qtest_clock_step(qts, 6 * SCALE_MS);
+    i2c_rd(qts, RTCEE, 0x10, r, 8);
+    g_assert_cmphex(r[0], ==, 0xBE);
+    g_assert_cmphex(r[6], ==, 0xDE);
+    /* STATUS BP1:BP0 = 11 protects the array */
+    g_assert_true(i2c_wr(qts, RTCEE, 0xFF, (const uint8_t[]){ 0x0C }, 1));
+    qtest_clock_step(qts, 6 * SCALE_MS);
+    i2c_wr(qts, RTCEE, 0x00, data, 1);
+    qtest_clock_step(qts, 6 * SCALE_MS);
+    i2c_rd(qts, RTCEE, 0x00, r, 1);
+    g_assert_cmphex(r[0], ==, 0xFF);
+    /* The protected block: only right after 0x55, 0xAA to EEUNLOCK */
+    i2c_wr(qts, RTCEE, 0xF0, data, 1);
+    qtest_clock_step(qts, 6 * SCALE_MS);
+    i2c_rd(qts, RTCEE, 0xF0, r, 1);
+    g_assert_cmphex(r[0], ==, 0xFF);
+    rtc_set(qts, 0x09, 0x55);
+    rtc_set(qts, 0x09, 0xAA);
+    g_assert_true(i2c_wr(qts, RTCEE, 0xF0, data, 2));
+    qtest_clock_step(qts, 6 * SCALE_MS);
+    i2c_rd(qts, RTCEE, 0xF0, r, 3);
+    g_assert_cmphex(r[0], ==, 0xDE);
+    g_assert_cmphex(r[1], ==, 0xAD);
+    g_assert_cmphex(r[2], ==, 0x00);                    /* EUI kept */
+    qtest_quit(qts);
+}
