+++ b/tests/qtest/avr64ea48-cnano-test.c
@@ -432,6 +432,38 @@ static void test_twi_thermo8(const void *fw)
     qtest_quit(qts);
 }
 
+/* RTC 6 Click (MCP79411) on mikroBUS 3: the clock runs, MFP on INT PE0 */
+static void test_twi_rtc6(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb3=rtc6 -kernel %s",
+                                  (const char *)fw);
+    uint8_t d[3];
+
+    qtest_writeb(qts, TWI0 + T_MCTRLA, 0x03);
+    qtest_writeb(qts, TWI0 + T_MSTATUS, 0x01);
+    g_assert_cmphex(qtest_readb(qts, PORTE + P_IN) & BIT(0), ==, BIT(0));
+    /* 12:34:56 and ST; CONTROL OUT = 0 pulls MFP low */
+    qtest_writeb(qts, TWI0 + T_MADDR, 0x6F << 1);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x00);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x80 | 0x56);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x34);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x12);
+    qtest_writeb(qts, TWI0 + T_MCTRLB, 0x03);
+    qtest_writeb(qts, TWI0 + T_MADDR, 0x6F << 1);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x07);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x00);
+    qtest_writeb(qts, TWI0 + T_MCTRLB, 0x03);
+    g_assert_cmphex(qtest_readb(qts, PORTE + P_IN) & BIT(0), ==, 0);
+    qtest_clock_step(qts, 5 * 1000 * 1000 * 1000LL);
+    twi_read(qts, 0x6F, 0x00, d, 3);
+    g_assert_cmphex(d[0], ==, 0x80 | 0x01);             /* 12:35:01 */
+    g_assert_cmphex(d[1], ==, 0x35);
+    g_assert_cmphex(d[2], ==, 0x12);
+    twi_read(qts, 0x57, 0xF2, d, 3);                    /* EUI-48 OUI */
+    g_assert_cmphex(d[2], ==, 0xA3);
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_autofree char *fw = write_firmware();
@@ -450,6 +482,7 @@ int main(int argc, char **argv)
     qtest_add_data_func("avr64ea48-cnano/thumbstick", fw, test_thumbstick);
     qtest_add_data_func("avr64ea48-cnano/twi-accel", fw, test_twi_accel);
     qtest_add_data_func("avr64ea48-cnano/twi-thermo8", fw, test_twi_thermo8);
+    qtest_add_data_func("avr64ea48-cnano/twi-rtc6", fw, test_twi_rtc6);
     ret = g_test_run();
     unlink(fw);
     return ret;
