+/* -- Capture ------------------------------------------------------------ */
+
+/* Silicon moves CCBUFx into a read CCx this many GCLK_TCC cycles later */
+#define MCHP_TCC_REFILL 2
+
+/*
+ * COUNT at @now as a capture: in dual slope with TOP below MAX/2 the MSB
+ * says the down ramp (DS 34.6.2.7)
+ */
+static uint32_t tcc_capture_value(MchpTccState *s, int64_t now)
+{
+    unsigned bits = MCHP_REGBLOCK(s)->info->counter_bits ?: 24;
+    bool down;
+    uint32_t v = tcc_after(s, tcc_ticks(s, now), &down) << tcc_dith_bits(s);
+
+    if (tcc_ds(s) && s->top < (tcc_max(s) >> 1) && down) {
+        v |= BIT(bits - 1);
+    }
+    return v;
+}
+
+/* Capture channel @ch's FIFO takes @v: CCx, then CCBUFx, else ERR */
+static void tcc_capture_put(MchpTccState *s, unsigned ch, uint32_t v)
+{
+    if (!(tcc_reg(s, A_INTFLAG, 4) & (F(INTFLAG, MC0) << ch)) &&
+        s->refill_at[ch] == INT64_MAX) {
+        tcc_set_reg(s, A_CC + 4 * ch, 4, v);
+        tcc_flag(s, F(INTFLAG, MC0) << ch);
+    } else if (!(tcc_reg(s, A_STATUS, 4) & (F(STATUS, CCBUFV0) << ch))) {
+        tcc_set_reg(s, A_CCBUF + 4 * ch, 4, v);
+        tcc_mod_reg(s, A_STATUS, 4, 0, F(STATUS, CCBUFV0) << ch);
+    } else {
+        tcc_flag(s, F(INTFLAG, ERR));
+    }
+}
+
+/* Capture COUNT at @now into channel @ch if it is in capture mode */
+static void tcc_capture(MchpTccState *s, unsigned ch, int64_t now)
+{
+    unsigned nch = MCHP_REGBLOCK(s)->info->channels ?: MCHP_TCC_CHANNELS;
+
+    if (ch < nch && (tcc_capture_channels(s) & BIT(ch))) {
+        tcc_capture_put(s, ch, tcc_capture_value(s, now));
+    }
+}
+
+static void tcc_capture_arm(MchpTccState *s)
+{
+    int64_t next = INT64_MAX;
+
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        next = MIN(next, s->refill_at[ch]);
+    }
+    if (next == INT64_MAX) {
+        timer_del(s->capt_timer);
+    } else {
+        timer_mod(s->capt_timer, next);
+    }
+}
+
+/* The FIFOs whose time has come move CCBUFx up into CCx */
+static void tcc_capture_cb(void *opaque)
+{
+    MchpTccState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        uint32_t valid = F(STATUS, CCBUFV0) << ch;
+
+        if (now < s->refill_at[ch]) {
+            continue;
+        }
+        s->refill_at[ch] = INT64_MAX;
+        if (tcc_reg(s, A_STATUS, 4) & valid) {
+            tcc_set_reg(s, A_CC + 4 * ch, 4, tcc_reg(s, A_CCBUF + 4 * ch, 4));
+            tcc_mod_reg(s, A_STATUS, 4, valid, 0);
+            tcc_flag(s, F(INTFLAG, MC0) << ch);
+        }
+    }
+    tcc_capture_arm(s);
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
