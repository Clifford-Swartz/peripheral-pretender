+
+    for (unsigned k = 0; k < 2; k++) {
+        QTestState *qts = fault_init(CPTEN(0) | CPTEN(1), 0,
+                                     evact[k] | TCEI1, 0);
+
+        wave_tick(qts, 20);
+        ev_event(qts, 1, 1);
+        g_assert_cmphex(flags(qts) & TRG, ==, TRG);
+        wave_tick(qts, 35);
+        ev_event(qts, 1, 0);
+        g_assert_cmpuint(qtest_readl(qts, TCC0 + R_CC(k)), ==, 20);
+        g_assert_cmpuint(qtest_readl(qts, TCC0 + R_CC(!k)), ==, 15);
+        wave_tick(qts, 80);
+        ev_event(qts, 1, 1);
+        g_assert_cmpuint(qtest_readl(qts, TCC0 + R_CC(k)), ==, 60);
+        g_assert_cmpuint(readsync(qts), ==, 0);
+        qtest_quit(qts);
+    }
