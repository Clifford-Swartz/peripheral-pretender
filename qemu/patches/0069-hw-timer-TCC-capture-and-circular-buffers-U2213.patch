+/*
+ * An update: the valid buffers go into PER, CCx and PATT; circular ones
+ * swap with their register. At @top (DSBOTH) only circular CCx swap. A
+ * circular valid flag stays at @top and at the start of RAMP2's cycle B
+ */
+static void tcc_update_cycle(MchpTccState *s, bool top)
+{
+    uint32_t circ = tcc_circular(s), status = tcc_reg(s, A_STATUS, 4);
+    uint32_t capt = tcc_capture_channels(s);
+    bool keep = top || (s->wavegen == NPWM && tcc_ramp(s) != RAMP1 &&
+                        s->ramp_idx);
+
+    for (unsigned r = 0; r <= MCHP_TCC_CHANNELS; r++) {
+        hwaddr reg = r ? A_CC + 4 * (r - 1) : A_PER;
+        hwaddr buf = r ? A_CCBUF + 4 * (r - 1) : A_PERBUF;
+        uint32_t valid = r ? F(STATUS, CCBUFV0) << (r - 1) : F(STATUS, PERBUFV);
+        uint32_t busy = r ? R_MCHP_TCC_SYNCBUSY_CC0_MASK << (r - 1) :
+                            R_MCHP_TCC_SYNCBUSY_PER_MASK;
+        bool c = circ & BIT(r);
+
+        if ((r && (capt & BIT(r - 1))) || (top && (!r || !c))) {
+            continue;
+        }
+        if (c) {
+            uint32_t a = tcc_reg(s, reg, 4);
+
+            tcc_set_reg(s, reg, 4, tcc_reg(s, buf, 4));
+            tcc_set_reg(s, buf, 4, a);
+        } else if (status & valid) {
+            tcc_set_reg(s, reg, 4, tcc_reg(s, buf, 4));
+        }
+        if (!(c && keep)) {
+            tcc_mod_reg(s, A_STATUS, 4, valid, 0);
+            s->buf_busy &= ~busy;
         }
     }
-    if (status & F(STATUS, PATTBUFV)) {
+    if (!top && (status & F(STATUS, PATTBUFV))) {
         tcc_set_reg(s, A_PATT, 2, tcc_reg(s, A_PATTBUF, 2));
+        tcc_mod_reg(s, A_STATUS, 4, F(STATUS, PATTBUFV), 0);
     }
-    tcc_mod_reg(s, A_STATUS, 4, F(STATUS, PERBUFV) | F(STATUS, PATTBUFV) |
-                (0xF << 16), 0);
-    s->buf_busy = 0;
     tcc_refresh(s);
 }
 
+/* Copy the valid buffers into PER/CCx (UPDATE command, retrigger) */
+static void tcc_update_buffers(MchpTccState *s)
+{
+    tcc_update_cycle(s, false);
+}
