-/* Copy the valid buffers into PER/CCx (UPDATE condition or command) */
-static void tcc_update_buffers(MchpTccState *s)
+/* Circular buffering: bit 0 PER (WAVE.CIPEREN), bits 1-4 CC0-3 (CICCENx) */
+static uint32_t tcc_circular(MchpTccState *s)
 {
-    uint32_t status = tcc_reg(s, A_STATUS, 4);
+    uint32_t w = tcc_reg(s, A_WAVE, 4);
 
-    if (status & F(STATUS, PERBUFV)) {
