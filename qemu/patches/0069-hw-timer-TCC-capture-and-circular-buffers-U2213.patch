+}
+
+/* Channels in capture mode (CTRLA.CPTENx): their CCBUFx is the FIFO */
+static uint32_t tcc_capture_channels(MchpTccState *s)
+{
+    return extract32(tcc_reg(s, A_CTRLA, 4), R_MCHP_TCC_CTRLA_CPTEN0_SHIFT,
+                     MCHP_TCC_CHANNELS);
+}
