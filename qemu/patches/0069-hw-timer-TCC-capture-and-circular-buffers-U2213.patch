+/*
+ * Event capture: a CPTEN2 channel with MCEI2 captures COUNT on MC2's
+ * rising edge into CC2, then CCBUF2, then sets ERR; reading CC2 clears
+ * MC2 and moves CCBUF2 up 2 GCLK_TCC cycles later (silicon)
+ */
+static void test_capture_fifo(void)
+{
+    QTestState *qts = fault_init(CPTEN(2), 0, MCEI(2), 0);
+
+    for (unsigned t = 10; t <= 30; t += 10) {
+        wave_tick(qts, t);
+        mc_event(qts, 2, 1);
+        mc_event(qts, 2, 0);
+    }
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_INTFLAG) & (MC(2) | ERR), ==,
+                    MC(2) | ERR);
+    g_assert_cmphex(tcc_status(qts) & CCBUFV(2), ==, CCBUFV(2));
+    g_assert_cmpuint(qtest_readl(qts, TCC0 + R_CC(2)), ==, 10);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_INTFLAG) & MC(2), ==, 0);
+    wave_tick(qts, 33);                     /* 2 cycles later */
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_INTFLAG) & MC(2), ==, MC(2));
+    g_assert_cmphex(tcc_status(qts) & CCBUFV(2), ==, 0);
+    g_assert_cmpuint(qtest_readl(qts, TCC0 + R_CC(2)), ==, 20);
+    wave_tick(qts, 36);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_INTFLAG) & MC(2), ==, 0);
+    qtest_quit(qts);
+
+    /* Dual slope, TOP below MAX/2: the MSB marks the down ramp */
+    qts = wave_init(DSBOTTOM, 0);
+    qtest_writel(qts, TCC0 + R_CTRLA, CPTEN(2));
+    qtest_writel(qts, TCC0 + R_EVCTRL, MCEI(2));
+    wave_enable(qts, CPTEN(2));
+    wave_tick(qts, 130);                    /* down: 99 - 31 */
+    mc_event(qts, 2, 1);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_CC(2)), ==, BIT(23) | 68);
+    qtest_quit(qts);
+}
+
+/*
