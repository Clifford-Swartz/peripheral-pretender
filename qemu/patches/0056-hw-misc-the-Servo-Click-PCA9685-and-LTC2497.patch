diff --git a/include/hw/misc/click_servo.h b/include/hw/misc/click_servo.h
new file mode 100644
index 0000000..fd80d00
--- /dev/null
+++ b/include/hw/misc/click_servo.h
@@ -0,0 +1,28 @@
+/*
+ * Servo Click: PCA9685 16-channel PWM and LTC2497 current sense, with
+ * servos on its headers
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An I2C device answering for both chips: the PCA9685 at 0x40 (also All
+ * Call, its sub-addresses and the general call's software reset) and the
+ * LTC2497 at 0x14. GPIO input "oe": the PCA9685's OE# (the socket's CS).
+ * QOM properties (read-only): "period-us", "pulses" (the 16 channels'
+ * pulse widths in microseconds) and "angles" (the servos' angles in
+ * degrees, -1 without a pulse); settable: "min-us"/"max-us" (the servo
+ * law, 0 and 180 degrees: 81/2761, MikroElektronika's) and "load-ma"
+ * (the current a servo with a pulse draws, 150).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_CLICK_SERVO_H
+#define HW_MISC_CLICK_SERVO_H
+
+#define TYPE_CLICK_SERVO "click-servo"
+#define CLICK_SERVO_ADDR 0x40
+#define CLICK_SERVO_ADC_ADDR 0x14
+#define CLICK_SERVO_OE "oe"
+
+#endif /* HW_MISC_CLICK_SERVO_H */
diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index ad3af0d..fa940f7 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -1292,6 +1292,84 @@ static void test_dcmotor(void)
     qtest_quit(qts);
 }
 
+/*
+ * Servo Click on EXT1: PCA9685 at 0x40 with MikroElektronika's set-up
+ * (its 0xF1 from awake leaves EXTCLK clear), 30 Hz, a 90 degree pulse
+ * that shows once OE# (CS, PA17) goes low, the LTC2497 at 0x14 reading
+ * the servo's current, EXTCLK from sleep stopping the PWM, SWRST.
+ */
+#define PCA9685         0x40
+#define LTC2497         0x14
+
+static uint8_t pca_reg(QTestState *qts, uint8_t reg)
+{
+    uint8_t v;
+
+    i2c_rd(qts, PCA9685, reg, &v, 1);
+    return v;
+}
+
+static void pca_set(QTestState *qts, uint8_t reg, uint8_t v)
+{
+    g_assert_true(i2c_wr(qts, PCA9685, reg, &v, 1));
+}
+
+static void test_servo(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext1=servo ");
+    g_autofree char *off = NULL, *on = NULL, *ang = NULL, *stop = NULL;
+    uint8_t d[3];
+
+    g_assert_cmphex(pca_reg(qts, 0x00), ==, 0x11);
+    g_assert_cmphex(pca_reg(qts, 0xFE), ==, 0x1E);
+    pca_set(qts, 0x00, 0x81);
+    pca_set(qts, 0x00, 0xF1);
+    g_assert_cmphex(pca_reg(qts, 0x00), ==, 0x31);          /* no EXTCLK */
+    pca_set(qts, 0xFE, 202);
+    pca_set(qts, 0x00, 0xA1);
+    g_assert_cmphex(pca_reg(qts, 0x00), ==, 0x21);          /* RESTART 0 */
+    g_assert_cmphex(pca_reg(qts, 0xFE), ==, 202);
+    g_assert_cmpint(qom_int(qts, CLICK1, "period-us"), ==, 33259);
+
+    /* LED0: ON 0, OFF 175 (90 degrees for the driver), auto-increment */
+    g_assert_true(i2c_wr(qts, PCA9685, 0x06,
+                         (const uint8_t[]){ 0, 0, 175, 0 }, 4));
+    off = qom_str(qts, CLICK1, "pulses");
+    g_assert_true(g_str_has_prefix(off, "0 0 "));           /* OE# high */
+    qtest_writel(qts, PA + P_DIRSET, BIT(17));
+    qtest_writel(qts, PA + P_OUTCLR, BIT(17));
+    on = qom_str(qts, CLICK1, "pulses");
+    g_assert_true(g_str_has_prefix(on, "1421 0 "));
+    ang = qom_str(qts, CLICK1, "angles");
+    g_assert_true(g_str_has_prefix(ang, "90 -1 "));
+
+    /* LTC2497: CH0 single-ended, 150 mA through 0.1 Ohm = 960 counts */
+    g_assert_true(i2c_wr(qts, LTC2497, 0xB0, NULL, 0));
+    g_assert_false(i2c_wr(qts, LTC2497, 0xB0, NULL, 0));   /* converting */
+    qtest_clock_step(qts, 160 * SCALE_MS);
+    qtest_writel(qts, SERCOM2 + 0x24, LTC2497 << 1 | 1);
+    for (unsigned i = 0; i < 3; i++) {
+        if (i == 2) {
+            qtest_writel(qts, SERCOM2 + 0x04, I2CM_SMEN | I2CM_ACKACT);
+        }
+        d[i] = qtest_readb(qts, SERCOM2 + 0x28);
+    }
+    i2c_stop(qts);
+    g_assert_cmphex(d[0] << 16 | d[1] << 8 | d[2], ==, 0x800000 | 960 << 6);
+
+    /* EXTCLK set from sleep: the pin is tied low, the PWM stops */
+    pca_set(qts, 0x00, 0x31);
+    pca_set(qts, 0x00, 0x71);
+    pca_set(qts, 0x00, 0x61);
+    stop = qom_str(qts, CLICK1, "pulses");
+    g_assert_true(g_str_has_prefix(stop, "0 0 "));
+
+    /* General call software reset */
+    g_assert_true(i2c_wr(qts, 0x00, 0x06, NULL, 0));
+    g_assert_cmphex(pca_reg(qts, 0x00), ==, 0x11);
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
@@ -1314,6 +1392,7 @@ int main(int argc, char **argv)
     qtest_add_func("pic32cm-click/weather", test_weather);
     qtest_add_func("pic32cm-click/fan", test_fan);
     qtest_add_func("pic32cm-click/dcmotor", test_dcmotor);
+    qtest_add_func("pic32cm-click/servo", test_servo);
     qtest_add_func("pic32cm-click/thermo8-identity", test_identity);
     qtest_add_func("pic32cm-click/not-fitted", test_not_fitted);
     qtest_add_func("pic32cm-click/thermo8-int-pullup", test_int_pullup);
