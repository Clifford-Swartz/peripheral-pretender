--- a/include/hw/mchp/mchp_device.h
+++ b/include/hw/mchp/mchp_device.h
@@ -68,6 +68,7 @@ typedef struct MchpInstanceInfo {
     int16_t dmac_rx;                /* DMAC_ID_RX, -1: none */
     int16_t dmac_tx;                /* DMAC_ID_TX, -1: none */
     uint32_t flags;                 /* MCHP_INST_* */
+    uint8_t counter_bits;           /* TCC SIZE: width of COUNT/PER/CC; 0 */
     uint32_t regs_size;             /* register file bytes (MCHP_<IP>_SIZE) */
     const MchpRegInfo *regs;        /* view at reset; NULL: no table */
     unsigned nregs;
diff --git a/include/hw/misc/mchp_regblock.h b/include/hw/misc/mchp_regblock.h
