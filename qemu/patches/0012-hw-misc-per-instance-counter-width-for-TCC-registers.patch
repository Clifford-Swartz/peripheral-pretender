@@ -466,7 +466,7 @@ static const MchpInstanceInfo pic32cm1216mc00048_instances[] = {
         .ip_version = "3.0.0", .base = 0x42002C00, .slot_size = 0x400,
         .irq = 15, .irq_input = 0, .pac_id = 75, .gclk_core = 24,
         .gclk_slow = -1, .dmac_rx = -1, .dmac_tx = -1, .flags = 0,
-        .regs_size = PIC32CM1216MC00048_TCC_REGS_SIZE,
+        .counter_bits = 16, .regs_size = PIC32CM1216MC00048_TCC_REGS_SIZE,
         .regs = pic32cm1216mc00048_tcc_regs,
         .nregs = PIC32CM1216MC00048_TCC_NREGS,
     },
