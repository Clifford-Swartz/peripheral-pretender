-        .regs_size = PIC32CM1216MC00048_TCC_REGS_SIZE,
+        .counter_bits = 24, .regs_size = PIC32CM1216MC00048_TCC_REGS_SIZE,
         .regs = pic32cm1216mc00048_tcc_regs,
