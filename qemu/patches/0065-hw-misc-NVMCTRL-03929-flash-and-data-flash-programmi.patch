+static void mchp_nvmctrl_reset_hold(MchpRegBlock *rb)
+{
+    MchpNvmctrlState *s = MCHP_NVMCTRL(rb);
+
+    timer_del(s->timer);
+    memset(s->pb, 0xFF, sizeof(s->pb));
+    s->pbl_array = MCHP_NVM_MAIN;
+    s->pbl_section = 0;
+    if (s->security) {
+        mchp_reg_set_bits(rb, A_MCHP_NVMCTRL_STATUS, 2,
+                          R_MCHP_NVMCTRL_STATUS_SB_MASK);
+    }
+}
+
+/* After the loader has written the images: BOOTPROT from the user row */
+static void mchp_nvmctrl_reset_exit(MchpRegBlock *rb)
+{
+    MchpNvmctrlState *s = MCHP_NVMCTRL(rb);
+    uint32_t bootprot = 7;
+
+    if (s->array[MCHP_NVM_ROWS]) {
+        const uint8_t *rows = memory_region_get_ram_ptr(
+            s->array[MCHP_NVM_ROWS]);
+
+        bootprot = ldl_le_p(rows + MCHP_NVM_USER_ROW -
+                            s->base[MCHP_NVM_ROWS]) & 7;
+    }
+    s->boot_size = bootprot == 7 ? 0 : 512u << (6 - bootprot);
+}
+
+static void mchp_nvmctrl_init(Object *obj)
+{
+    MchpNvmctrlState *s = MCHP_NVMCTRL(obj);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, mchp_nvm_done, s);
+}
+
+static void mchp_nvmctrl_finalize(Object *obj)
+{
+    timer_free(MCHP_NVMCTRL(obj)->timer);
+}
