+    if (ri->offset != A_MCHP_NVMCTRL_STATUS || !side_effects ||
+        !(stored & R_MCHP_NVMCTRL_STATUS_PRM_MASK) ||
+        !mchp_nvm_cpu_in_array(s)) {
+        return stored;
+    }
+    if (!s->prm_seen) {
+        s->prm_seen = true;
+        return stored;
+    }
+    stored &= ~R_MCHP_NVMCTRL_STATUS_PRM_MASK;
+    mchp_regfile_set(rf, ri, idx, stored);
+    return stored;
