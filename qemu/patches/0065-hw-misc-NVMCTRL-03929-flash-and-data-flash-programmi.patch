+/*
+ * QTest for the flash controller of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The NVMCTRL model's timings on stepped virtual time, and what firmware
+ * on the desk board must not try: BOOTPROT, the security bit, the user row
+ * (EAR, WAP), and programmed flash staying over a loaded image through a
+ * reset. firmware/hello APP=nvmctrl checks the rest against silicon.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+
+#define NVMCTRL         0x41004000
+#define R_CTRLA         0x00
+#define R_CTRLB         0x04
+#define R_INTFLAG       0x14
+#define R_STATUS        0x18
+#define R_ADDR          0x1C
+#define R_LOCK          0x20
+#define R_PBLDATA0      0x28
+#define R_PBLDATA1      0x2C
+
+#define READY           0x01
+#define INT_ERROR       0x02
+#define PRM             0x0001
+#define LOAD            0x0002
+#define PROGE           0x0004
+#define LOCKE           0x0008
+#define SB              0x0100
+
+#define CMD(c)          (0xA500 | (c))
+#define ER              0x02
+#define WP              0x04
+#define EAR             0x05
+#define WAP             0x06
+#define DFER            0x1A
+#define DFWP            0x1C
+#define SPRM            0x42
+#define CPRM            0x43
+#define SSB             0x45
+#define SCEHL           0x7F
+
+#define DF              0x00400000
+#define USER_ROW        0x00804000
+#define USER0           0xB15088FF      /* the twin's default user row */
+#define USER1           0xFFFFF8BB
+#define TEST_ROW        0x0001FF00
+
+#define ER_NS           777000
+#define WP_NS           169000
+#define DFER_NS         768000
+#define DFWP_NS         130000
+
+static uint32_t nvm(QTestState *qts, unsigned off)
+{
+    return qtest_readl(qts, NVMCTRL + off);
+}
+
+static void cmd(QTestState *qts, unsigned c)
+{
+    qtest_writew(qts, NVMCTRL + R_CTRLA, CMD(c));
+}
+
+/* READY drops for exactly @ns */
+static void expect_busy(QTestState *qts, int64_t ns)
+{
+    g_assert_cmphex(nvm(qts, R_INTFLAG) & READY, ==, 0);
+    qtest_clock_step(qts, ns - 1);
+    g_assert_cmphex(nvm(qts, R_INTFLAG) & READY, ==, 0);
+    qtest_clock_step(qts, 1);
+    g_assert_cmphex(nvm(qts, R_INTFLAG) & READY, ==, READY);
+}
+
+/* A flash image in Intel HEX for -device loader: @n words at @addr */
+static char *hex_image(uint32_t addr, const uint32_t *words, unsigned n)
+{
+    g_autoptr(GString) hex = g_string_new(NULL);
+    char *path = NULL;
+    unsigned sum = 0x02 + 0x04 + (addr >> 24) + ((addr >> 16) & 0xFF);
+    int fd;
+
+    g_string_append_printf(hex, ":02000004%04X%02X\n", addr >> 16,
+                           (0x100 - (sum & 0xFF)) & 0xFF);
+    sum = 4 * n + ((addr >> 8) & 0xFF) + (addr & 0xFF);
+    g_string_append_printf(hex, ":%02X%04X00", 4 * n, addr & 0xFFFF);
+    for (unsigned i = 0; i < n; i++) {
+        for (unsigned b = 0; b < 4; b++) {
+            uint8_t v = words[i] >> (8 * b);
+
+            g_string_append_printf(hex, "%02X", v);
+            sum += v;
+        }
+    }
+    g_string_append_printf(hex, "%02X\n:00000001FF\n",
+                           (0x100 - (sum & 0xFF)) & 0xFF);
+    fd = g_file_open_tmp("pic32cm-nvm-XXXXXX.hex", &path, NULL);
+    g_assert(fd >= 0);
+    close(fd);
+    g_assert(g_file_set_contents(path, hex->str, hex->len, NULL));
+    return path;
+}
+
+static void test_dataflash(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    cmd(qts, DFER);
+    expect_busy(qts, DFER_NS);
+    qtest_writel(qts, DF + 0x40, 0x11111111);
+    qtest_writel(qts, DF + 0x44, 0x22222222);
+    g_assert_cmphex(nvm(qts, R_PBLDATA0), ==, 0x11111111);
+    g_assert_cmphex(nvm(qts, R_PBLDATA1), ==, 0x22222222);
+    g_assert_cmphex(nvm(qts, R_ADDR), ==, 0x22);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, LOAD);
+    g_assert_cmphex(qtest_readl(qts, DF + 0x40), ==, 0xFFFFFFFF);
+    cmd(qts, DFWP);
+    expect_busy(qts, DFWP_NS);
+    g_assert_cmphex(qtest_readl(qts, DF + 0x40), ==, 0x11111111);
+    g_assert_cmphex(qtest_readl(qts, DF + 0x44), ==, 0x22222222);
+    g_assert_cmphex(qtest_readl(qts, DF + 0x48), ==, 0xFFFFFFFF);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, 0);
+    g_assert_cmphex(nvm(qts, R_PBLDATA0), ==, 0xFFFFFFFF);
+
+    /* A command while busy, and an 8-bit load (a bus error for a CPU) */
+    cmd(qts, DFER);
+    cmd(qts, DFWP);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, PROGE);
+    g_assert_cmphex(nvm(qts, R_INTFLAG), ==, INT_ERROR);
+    qtest_clock_step(qts, DFER_NS);
+    qtest_writeb(qts, DF + 0x101, 0x5A);
+    g_assert_cmphex(nvm(qts, R_PBLDATA0), ==, 0xFFFF5A5A);
+    qtest_quit(qts);
+}
+
+/* What the guest programs stays over a loaded image through a reset */
+static void test_main_array(void)
+{
+    static const uint32_t image[] = { 0x12345678, 0x9ABCDEF0 };
+    g_autofree char *path = NULL;
+    QTestState *qts;
+
+    if (!qtest_has_device("loader")) {
+        g_test_skip("generic loader not built");
+        return;
+    }
+    path = hex_image(TEST_ROW, image, 2);
+    qts = qtest_initf(MACHINE " -device loader,file=%s", path);
+    g_assert_cmphex(qtest_readl(qts, TEST_ROW), ==, 0x12345678);
+    qtest_writel(qts, NVMCTRL + R_ADDR, TEST_ROW / 2);
+    cmd(qts, ER);
+    expect_busy(qts, ER_NS);
+    qtest_writel(qts, TEST_ROW + 0x44, 0xC0DE0001);
+    g_assert_cmphex(nvm(qts, R_ADDR), ==, (TEST_ROW + 0x44) / 2);
+    cmd(qts, WP);
+    expect_busy(qts, WP_NS);
+    qtest_system_reset(qts);
+    g_assert_cmphex(qtest_readl(qts, TEST_ROW), ==, 0xFFFFFFFF);
+    g_assert_cmphex(qtest_readl(qts, TEST_ROW + 0x44), ==, 0xC0DE0001);
+    qtest_quit(qts);
+    unlink(path);
+}
+
+/* BOOTPROT = 6 protects the first 512 bytes, from the next reset */
+static void test_bootprot(void)
+{
+    static const uint32_t row[] = { (USER0 & ~7u) | 6, USER1 };
+    g_autofree char *path = NULL;
+    QTestState *qts;
+
+    if (!qtest_has_device("loader")) {
+        g_test_skip("generic loader not built");
+        return;
+    }
+    path = hex_image(USER_ROW, row, 2);
+    qts = qtest_initf(MACHINE " -device loader,file=%s", path);
+    qtest_writel(qts, NVMCTRL + R_ADDR, 0x100 / 2);
+    cmd(qts, ER);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, LOCKE);
+    g_assert_cmphex(nvm(qts, R_INTFLAG), ==, READY | INT_ERROR);
+    qtest_writel(qts, NVMCTRL + R_ADDR, 0x200 / 2);
+    cmd(qts, ER);
+    expect_busy(qts, ER_NS);
+    qtest_quit(qts);
+    unlink(path);
+}
+
+/* WAP programs the user row; its region locks apply at the next reset */
+static void test_user_row(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    g_assert_cmphex(nvm(qts, R_LOCK), ==, 0xFFFF);
+    cmd(qts, EAR);
+    expect_busy(qts, ER_NS);
+    g_assert_cmphex(qtest_readl(qts, USER_ROW), ==, 0xFFFFFFFF);
+    qtest_writel(qts, USER_ROW, USER0);
+    qtest_writel(qts, USER_ROW + 4, (USER1 & 0xFFFF) | 0x7FFF0000);
+    cmd(qts, WAP);
+    expect_busy(qts, WP_NS);
+    g_assert_cmphex(nvm(qts, R_LOCK), ==, 0xFFFF);
+    qtest_system_reset(qts);
+    g_assert_cmphex(nvm(qts, R_LOCK), ==, 0x7FFF);
+    qtest_quit(qts);
+}
+
+/* SSB sets SB until QEMU exits and refuses the user row from then on */
+static void test_security(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    cmd(qts, SCEHL);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, PROGE);
+    qtest_writew(qts, NVMCTRL + R_STATUS, PROGE);
+    cmd(qts, SSB);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, SB);
+    cmd(qts, EAR);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, SB | PROGE);
+    qtest_system_reset(qts);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, SB);
+    qtest_quit(qts);
+}
+
+/* No CPU fetches from flash here, so PRM stays until CPRM */
+static void test_power_reduction(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    cmd(qts, SPRM);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, PRM);
+    cmd(qts, CPRM);
+    g_assert_cmphex(nvm(qts, R_STATUS), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-nvmctrl/dataflash", test_dataflash);
+    qtest_add_func("pic32cm-nvmctrl/main-array", test_main_array);
+    qtest_add_func("pic32cm-nvmctrl/bootprot", test_bootprot);
+    qtest_add_func("pic32cm-nvmctrl/user-row", test_user_row);
+    qtest_add_func("pic32cm-nvmctrl/security", test_security);
+    qtest_add_func("pic32cm-nvmctrl/power-reduction", test_power_reduction);
+    return g_test_run();
+}
