+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb1=thermo8 -kernel %s",
+                                  (const char *)fw);
+    uint8_t d[2];
+
+    qtest_writeb(qts, TWI0 + T_MCTRLA, 0x03);
+    qtest_writeb(qts, TWI0 + T_MSTATUS, 0x01);
+    twi_read(qts, 0x18, 0x06, d, 2);
+    g_assert_cmphex(d[0] << 8 | d[1], ==, 0x0054);      /* manufacturer */
+    qtest_quit(qts);
+}
