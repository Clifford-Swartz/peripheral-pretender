+/* I2C on SERCOM2 (as mcp_write/mcp_read) to any address */
+static bool i2c_wr(QTestState *qts, uint8_t addr, uint8_t reg,
+                   const uint8_t *d, unsigned n)
+{
+    bool ack;
+
+    qtest_writel(qts, SERCOM2 + 0x24, addr << 1);
+    ack = !(qtest_readw(qts, SERCOM2 + 0x1A) & BIT(2));
+    qtest_writel(qts, SERCOM2 + 0x28, reg);
+    for (unsigned i = 0; i < n; i++) {
+        qtest_writel(qts, SERCOM2 + 0x28, d[i]);
+    }
+    i2c_stop(qts);
+    return ack;
+}
+
+static void i2c_rd(QTestState *qts, uint8_t addr, uint8_t reg, uint8_t *d,
+                   unsigned n)
+{
+    i2c_wr(qts, addr, reg, NULL, 0);
+    qtest_writel(qts, SERCOM2 + 0x24, addr << 1 | 1);
+    for (unsigned i = 0; i < n; i++) {
+        if (i == n - 1) {
+            qtest_writel(qts, SERCOM2 + 0x04, I2CM_SMEN | I2CM_ACKACT);
+        }
+        d[i] = qtest_readb(qts, SERCOM2 + 0x28);
+    }
+    i2c_stop(qts);
+}
+
+#define ADXL345         0x53
+
+static uint8_t adxl_reg(QTestState *qts, uint8_t reg)
+{
+    uint8_t v;
+
+    i2c_rd(qts, ADXL345, reg, &v, 1);
+    return v;
+}
+
+static void adxl_set(QTestState *qts, uint8_t reg, uint8_t v)
+{
+    g_assert_true(i2c_wr(qts, ADXL345, reg, &v, 1));
+}
+
+/* X, Y, Z in one multi-byte read, as the data sheet recommends */
+static void adxl_data(QTestState *qts, int16_t *xyz)
+{
+    uint8_t d[6];
+
+    i2c_rd(qts, ADXL345, 0x32, d, 6);
+    for (unsigned i = 0; i < 3; i++) {
+        xyz[i] = d[2 * i] | d[2 * i + 1] << 8;
+    }
+}
+
+/* Accel Click on EXT1: ADXL345 at 0x53, INT1 on INT (PB02) */
+static void test_accel(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext1=accel ");
+    int16_t xyz[3];
+
+    g_assert_false(i2c_wr(qts, 0x1D, 0, NULL, 0));      /* ADD on GND */
+    g_assert_cmphex(adxl_reg(qts, 0x00), ==, 0xE5);     /* DEVID */
+    g_assert_cmphex(adxl_reg(qts, 0x2C), ==, 0x0A);     /* BW_RATE */
+    g_assert_cmphex(adxl_reg(qts, 0x30), ==, 0x02);     /* INT_SOURCE */
+    g_assert_true(pin_high(qts, PA, 17));               /* CS: R6 */
+    /* Standby: no samples */
+    qtest_clock_step(qts, 50 * 1000 * 1000);
+    adxl_data(qts, xyz);
+    g_assert_cmpint(xyz[2], ==, 0);
+    /* Full resolution, +-2 g, 100 Hz: 256 LSB/g; flat reads z = 1 g */
+    adxl_set(qts, 0x31, 0x08);
+    adxl_set(qts, 0x2E, 0x80);                          /* DATA_READY */
+    g_assert_false(pin_high(qts, PB, INT1_PIN));
+    adxl_set(qts, 0x2D, 0x08);                          /* Measure */
+    qtest_clock_step(qts, 10 * 1000 * 1000);
+    g_assert_true(pin_high(qts, PB, INT1_PIN));
+    g_assert_cmphex(adxl_reg(qts, 0x30), ==, 0x82);
+    adxl_data(qts, xyz);
+    g_assert_cmpint(xyz[0], ==, 0);
+    g_assert_cmpint(xyz[2], ==, 256);
+    g_assert_false(pin_high(qts, PB, INT1_PIN));        /* read: cleared */
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '" CLICK1 "', 'property': 'xyz',"
+                             " 'value': '-500 0 866' } }");
+    qtest_clock_step(qts, 10 * 1000 * 1000);
+    adxl_data(qts, xyz);
+    g_assert_cmpint(xyz[0], ==, -128);
+    g_assert_cmpint(xyz[2], ==, 222);
+    /* Two samples unread: OVERRUN */
+    qtest_clock_step(qts, 20 * 1000 * 1000);
+    g_assert_cmphex(adxl_reg(qts, 0x30), ==, 0x83);
+    /* Clipped at +-2 g in 10 bits; offset 15.6 mg/LSB */
+    qom_set_int(qts, CLICK1, "x", 16000);
+    adxl_set(qts, 0x20, 0x10);                          /* OFSZ +250 mg */
+    qtest_clock_step(qts, 10 * 1000 * 1000);
+    adxl_data(qts, xyz);
+    g_assert_cmpint(xyz[0], ==, 511);
+    g_assert_cmpint(xyz[2], ==, 286);
+    /* 10-bit mode, +-16 g: 32 LSB/g; left-justified full resolution */
+    adxl_set(qts, 0x31, 0x03);
+    qtest_clock_step(qts, 10 * 1000 * 1000);
+    adxl_data(qts, xyz);
+    g_assert_cmpint(xyz[0], ==, 511);
+    g_assert_cmpint(xyz[2], ==, 36);
+    adxl_set(qts, 0x31, 0x0C);
+    qtest_clock_step(qts, 10 * 1000 * 1000);
+    adxl_data(qts, xyz);
+    g_assert_cmphex((uint16_t)xyz[2], ==, 286 << 6);
+    /* INT_INVERT: active low; INT_MAP moves DATA_READY to INT2 */
+    adxl_set(qts, 0x31, 0x28);
+    g_assert_true(pin_high(qts, PB, INT1_PIN));
+    qtest_clock_step(qts, 10 * 1000 * 1000);
+    g_assert_false(pin_high(qts, PB, INT1_PIN));
+    adxl_set(qts, 0x2F, 0x80);
+    g_assert_true(pin_high(qts, PB, INT1_PIN));
+    qtest_quit(qts);
+}
