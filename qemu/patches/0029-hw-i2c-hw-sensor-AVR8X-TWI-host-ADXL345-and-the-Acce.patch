diff --git a/hw/i2c/avr8x_twi.c b/hw/i2c/avr8x_twi.c
new file mode 100644
index 0000000..2e9651c
--- /dev/null
+++ b/hw/i2c/avr8x_twi.c
@@ -0,0 +1,313 @@
+/*
+ * Microchip AVR8X TWI (i2c_8bit_avr_v3: AVR Dx, AVR Ex), host mode
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Behaviour from DS40002324 (AVR64EA48), chapter TWI, host operation:
+ * after MCTRLA.ENABLE the bus state is unknown until software writes
+ * IDLE to MSTATUS.BUSSTATE (or a STOP is seen). Writing MADDR issues a
+ * START (a repeated START while the host owns the bus) and the address:
+ * a write address ends with WIF and RXACK (1: NACK); a read address that
+ * is acknowledged receives the first byte (RIF), a NACKed one sets WIF and
+ * RXACK. Writing MDATA sends a byte (WIF, RXACK). In read mode
+ * MCTRLB.MCMD RECVTRANS sends ACKACT and receives the next byte; STOP
+ * sends ACKACT and a STOP; REPSTART repeats MADDR. Smart mode
+ * (MCTRLA.SMEN) sends ACKACT when MDATA is read and, on ACK, receives
+ * the next byte. RIF and WIF clear by writing 1, by writing MADDR or
+ * MDATA, by an MCMD, or by reading MDATA. The host interrupt (TWIM, the
+ * instance's second vector) follows RIF & RIEN | WIF & WIEN. The bus is
+ * the "i2c" I2C bus of the device. Transfers take no time; MBAUD,
+ * timeouts, quick command, arbitration, the client side and the pin
+ * routing (PORTMUX.TWIROUTEA) are not modelled.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/avr/avr8x_periph.h"
+#include "hw/core/irq.h"
+#include "hw/core/sysbus.h"
+#include "hw/i2c/avr8x_twi.h"
+#include "hw/i2c/i2c.h"
+#include "hw/mchp/gen/twi_i2c_8bit_avr_v3.h"
+#include "migration/vmstate.h"
+
+#define MSTATUS_FLAGS   (R_MCHP_TWI_MSTATUS_RIF_MASK | \
+                         R_MCHP_TWI_MSTATUS_WIF_MASK | \
+                         R_MCHP_TWI_MSTATUS_ARBLOST_MASK | \
+                         R_MCHP_TWI_MSTATUS_BUSERR_MASK)
+
+OBJECT_DECLARE_SIMPLE_TYPE(Avr8xTwiState, AVR8X_TWI)
+
+struct Avr8xTwiState {
+    MchpRegBlock parent_obj;
+
+    I2CBus *bus;
+    qemu_irq irq_host;          /* TWIM; the regblock's own IRQ is TWIS */
+    uint8_t status;             /* MSTATUS */
+    uint8_t data;               /* last byte received */
+    bool reading;               /* the address had R/W = 1 */
+    bool in_transfer;           /* a START is open on the QEMU bus */
+};
+
+static uint8_t avr8x_twi_reg(Avr8xTwiState *s, hwaddr reg)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, reg, 1);
+}
+
+static void avr8x_twi_set_bus(Avr8xTwiState *s, unsigned state)
+{
+    s->status = FIELD_DP8(s->status, MCHP_TWI_MSTATUS, BUSSTATE, state);
+}
+
+static bool avr8x_twi_irq_pending(MchpRegBlock *rb)
+{
+    Avr8xTwiState *s = AVR8X_TWI(rb);
+    uint8_t ctrla = avr8x_twi_reg(s, A_MCHP_TWI_MCTRLA);
+    bool host = ((s->status & R_MCHP_TWI_MSTATUS_RIF_MASK) &&
+                 (ctrla & R_MCHP_TWI_MCTRLA_RIEN_MASK)) ||
+                ((s->status & R_MCHP_TWI_MSTATUS_WIF_MASK) &&
+                 (ctrla & R_MCHP_TWI_MCTRLA_WIEN_MASK));
+
+    qemu_set_irq(s->irq_host, host);
+    return false;               /* client side not modelled */
+}
+
+static bool avr8x_twi_enabled(Avr8xTwiState *s)
+{
+    return avr8x_twi_reg(s, A_MCHP_TWI_MCTRLA) &
+           R_MCHP_TWI_MCTRLA_ENABLE_MASK;
+}
+
+static void avr8x_twi_clear_flags(Avr8xTwiState *s)
+{
+    s->status &= ~(R_MCHP_TWI_MSTATUS_RIF_MASK | R_MCHP_TWI_MSTATUS_WIF_MASK);
+}
+
+static void avr8x_twi_receive(Avr8xTwiState *s)
+{
+    s->data = i2c_recv(s->bus);
+    s->status |= R_MCHP_TWI_MSTATUS_RIF_MASK |
+                 R_MCHP_TWI_MSTATUS_CLKHOLD_MASK;
+}
+
+static void avr8x_twi_stop(Avr8xTwiState *s)
+{
+    if (s->in_transfer) {
+        i2c_end_transfer(s->bus);
+        s->in_transfer = false;
+    }
+    s->status &= ~R_MCHP_TWI_MSTATUS_CLKHOLD_MASK;
+    avr8x_twi_set_bus(s, MCHP_TWI_MSTATUS_BUSSTATE_IDLE);
+}
+
+/* START or repeated START with the address in MADDR */
+static void avr8x_twi_start(Avr8xTwiState *s, uint8_t addr)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    unsigned state = FIELD_EX8(s->status, MCHP_TWI_MSTATUS, BUSSTATE);
+    bool nack;
+
+    avr8x_twi_clear_flags(s);
+    if (!avr8x_twi_enabled(s)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.MADDR: write while disabled\n",
+                      rb->name);
+        return;
+    }
+    if (state == MCHP_TWI_MSTATUS_BUSSTATE_UNKNOWN) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.MADDR: bus state unknown (write "
+                      "IDLE to MSTATUS.BUSSTATE first)\n", rb->name);
+        return;
+    }
+    s->reading = addr & 1;
+    nack = i2c_start_transfer(s->bus, addr >> 1, s->reading) != 0;
+    s->in_transfer = !nack;
+    avr8x_twi_set_bus(s, MCHP_TWI_MSTATUS_BUSSTATE_OWNER);
+    s->status = FIELD_DP8(s->status, MCHP_TWI_MSTATUS, RXACK, nack);
+    if (s->reading && !nack) {
+        avr8x_twi_receive(s);
+    } else {
+        s->status |= R_MCHP_TWI_MSTATUS_WIF_MASK |
+                     R_MCHP_TWI_MSTATUS_CLKHOLD_MASK;
+    }
+}
+
+static void avr8x_twi_send(Avr8xTwiState *s, uint8_t byte)
+{
+    bool nack = true;
+
+    avr8x_twi_clear_flags(s);
+    if (s->in_transfer && !s->reading) {
+        nack = i2c_send(s->bus, byte) != 0;
+    } else {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.MDATA: write without a write "
+                      "transaction\n", MCHP_REGBLOCK(s)->name);
+    }
+    s->status = FIELD_DP8(s->status, MCHP_TWI_MSTATUS, RXACK, nack);
+    s->status |= R_MCHP_TWI_MSTATUS_WIF_MASK | R_MCHP_TWI_MSTATUS_CLKHOLD_MASK;
+}
+
+/* Send ACKACT for the byte just received; on ACK, receive the next */
+static void avr8x_twi_ack(Avr8xTwiState *s, bool next)
+{
+    bool nack = avr8x_twi_reg(s, A_MCHP_TWI_MCTRLB) &
+                R_MCHP_TWI_MCTRLB_ACKACT_MASK;
+
+    avr8x_twi_clear_flags(s);
+    if (!s->in_transfer || !s->reading) {
+        return;
+    }
+    if (nack) {
+        i2c_nack(s->bus);
+    } else if (next) {
+        avr8x_twi_receive(s);
+    }
+}
+
+static uint32_t avr8x_twi_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                   unsigned idx, uint32_t stored,
+                                   bool side_effects)
+{
+    Avr8xTwiState *s = AVR8X_TWI(rf->opaque);
+    uint8_t value;
+
+    switch (ri->offset) {
+    case A_MCHP_TWI_MSTATUS:
+        return s->status;
+    case A_MCHP_TWI_MCTRLB:
+        return stored & ~R_MCHP_TWI_MCTRLB_MCMD_MASK;   /* MCMD reads 0 */
+    case A_MCHP_TWI_MDATA:
+        value = s->data;
+        if (side_effects) {
+            avr8x_twi_clear_flags(s);
+            if (avr8x_twi_reg(s, A_MCHP_TWI_MCTRLA) &
+                R_MCHP_TWI_MCTRLA_SMEN_MASK) {
+                avr8x_twi_ack(s, true);
+            }
+            mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+        }
+        return value;
+    }
+    return stored;
+}
+
+static void avr8x_twi_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                 unsigned idx, uint32_t old,
+                                 uint32_t written, uint32_t we)
+{
+    Avr8xTwiState *s = AVR8X_TWI(rf->opaque);
+
+    switch (ri->offset) {
+    case A_MCHP_TWI_MCTRLA:
+        if (!(written & R_MCHP_TWI_MCTRLA_ENABLE_MASK)) {
+            if (s->in_transfer) {
+                i2c_end_transfer(s->bus);
+                s->in_transfer = false;
+            }
+            s->status = 0;      /* disabled: bus state unknown */
+        }
+        break;
+    case A_MCHP_TWI_MCTRLB:
+        if (written & R_MCHP_TWI_MCTRLB_FLUSH_MASK) {
+            s->status &= ~MSTATUS_FLAGS;
+            s->data = 0;
+        }
+        switch (FIELD_EX8(written, MCHP_TWI_MCTRLB, MCMD)) {
+        case MCHP_TWI_MCTRLB_MCMD_REPSTART:
+            avr8x_twi_start(s, avr8x_twi_reg(s, A_MCHP_TWI_MADDR));
+            break;
+        case MCHP_TWI_MCTRLB_MCMD_RECVTRANS:
+            avr8x_twi_ack(s, true);
+            break;
+        case MCHP_TWI_MCTRLB_MCMD_STOP:
+            avr8x_twi_ack(s, false);
+            avr8x_twi_stop(s);
+            break;
+        }
+        break;
+    case A_MCHP_TWI_MSTATUS:
+        s->status &= ~(written & MSTATUS_FLAGS);
+        if (FIELD_EX8(written, MCHP_TWI_MSTATUS, BUSSTATE) ==
+                MCHP_TWI_MSTATUS_BUSSTATE_IDLE && avr8x_twi_enabled(s)) {
+            avr8x_twi_set_bus(s, MCHP_TWI_MSTATUS_BUSSTATE_IDLE);
+        }
+        break;
+    case A_MCHP_TWI_MADDR:
+        avr8x_twi_start(s, written);
+        break;
+    case A_MCHP_TWI_MDATA:
+        avr8x_twi_send(s, written);
+        break;
+    }
+}
+
+static void avr8x_twi_reset_hold(MchpRegBlock *rb)
+{
+    Avr8xTwiState *s = AVR8X_TWI(rb);
+
+    if (s->in_transfer) {
+        i2c_end_transfer(s->bus);
+    }
+    s->status = 0;
+    s->data = 0;
+    s->reading = false;
+    s->in_transfer = false;
+}
+
+static bool avr8x_twi_realize(MchpRegBlock *rb, Error **errp)
+{
+    g_autofree char *bus = g_strdup_printf("%s.i2c", rb->name);
+
+    AVR8X_TWI(rb)->bus = i2c_init_bus(DEVICE(rb), bus);
+    return true;
+}
+
+static void avr8x_twi_init(Object *obj)
+{
+    /* Sysbus IRQ 0 (the regblock's) is TWIS, IRQ 1 TWIM */
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &AVR8X_TWI(obj)->irq_host);
+}
+
+static const VMStateDescription vmstate_avr8x_twi = {
+    .name = TYPE_AVR8X_TWI,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, Avr8xTwiState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_UINT8(status, Avr8xTwiState),
+        VMSTATE_UINT8(data, Avr8xTwiState),
+        VMSTATE_BOOL(reading, Avr8xTwiState),
+        VMSTATE_BOOL(in_transfer, Avr8xTwiState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void avr8x_twi_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    dc->vmsd = &vmstate_avr8x_twi;
+    c->realize = avr8x_twi_realize;
+    c->pre_read = avr8x_twi_pre_read;
+    c->post_write = avr8x_twi_post_write;
+    c->irq_pending = avr8x_twi_irq_pending;
+    c->reset_hold = avr8x_twi_reset_hold;
+    c->is_enabled = avr8x_never_enabled;
+    c->log_writes = false;
+}
+
+static const TypeInfo avr8x_twi_types[] = {
+    {
+        .name = TYPE_AVR8X_TWI,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(Avr8xTwiState),
+        .instance_init = avr8x_twi_init,
+        .class_init = avr8x_twi_class_init,
+    },
+};
+
+DEFINE_TYPES(avr8x_twi_types)
