+/*
+ * Analog Devices ADXL345 3-axis accelerometer (I2C)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * QOM properties "x", "y", "z": the acceleration the sensor measures, in
+ * mg (at rest: the opposite of gravity, so flat and face up reads z =
+ * 1000), -16000 to 16000, settable at run time; "xyz" sets all three at
+ * once ("x y z"). GPIO outputs "int1" and "int2": push-pull, 1/0 (active
+ * high unless DATA_FORMAT.INT_INVERT).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SENSOR_ADXL345_H
+#define HW_SENSOR_ADXL345_H
+
+#define TYPE_ADXL345 "adxl345"
+
+#define ADXL345_INT1 "int1"
+#define ADXL345_INT2 "int2"
+
+#endif /* HW_SENSOR_ADXL345_H */
