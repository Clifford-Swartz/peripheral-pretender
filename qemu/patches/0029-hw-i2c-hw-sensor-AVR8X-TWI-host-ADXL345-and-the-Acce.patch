diff --git a/hw/sensor/adxl345.c b/hw/sensor/adxl345.c
new file mode 100644
index 0000000..d1dd366
--- /dev/null
+++ b/hw/sensor/adxl345.c
@@ -0,0 +1,373 @@
+/*
+ * Analog Devices ADXL345 3-axis accelerometer (I2C)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * ADXL345 data sheet Rev. G: register map (Table 19, reset values), I2C
+ * with a register address byte and auto-incrementing multi-byte reads and
+ * writes. The part powers up in standby; POWER_CTL.Measure starts
+ * sampling at the BW_RATE output data rate (3200 Hz / 2^(15 - Rate)) on
+ * the virtual clock. Each sample takes the "x", "y", "z" properties (mg)
+ * plus the OFSx offsets (15.6 mg/LSB) and stores them as DATA_FORMAT asks:
+ * full resolution (3.9 mg/LSB, 10 to 13 bits by range) or 10-bit mode
+ * (the range sets the scale), clipped, right-justified with sign
+ * extension or left-justified, LSB first. DATA_READY is set with each
+ * sample; OVERRUN when a sample replaces unread data (bypass mode). Both
+ * clear when the data registers are read (any of 0x32-0x37 here); the
+ * WATERMARK bit is set while the FIFO's sample count (0 in bypass mode)
+ * equals FIFO_CTL.Samples. INT_ENABLE and INT_MAP drive the push-pull
+ * INT1/INT2 pins, active high unless DATA_FORMAT.INT_INVERT. Not modelled
+ * (logged when enabled): tap, activity, inactivity and free-fall
+ * detection, the FIFO modes other than bypass, self-test, sleep and
+ * low-power timing, SPI. Not checked against a physical part.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/i2c/i2c.h"
+#include "hw/sensor/adxl345.h"
+#include "migration/vmstate.h"
+
+enum {
+    REG_DEVID = 0x00,
+    REG_OFSX = 0x1E,
+    REG_ACT_TAP_STATUS = 0x2B,
+    REG_BW_RATE = 0x2C,
+    REG_POWER_CTL = 0x2D,
+    REG_INT_ENABLE = 0x2E,
+    REG_INT_MAP = 0x2F,
+    REG_INT_SOURCE = 0x30,
+    REG_DATA_FORMAT = 0x31,
+    REG_DATAX0 = 0x32,
+    REG_DATAZ1 = 0x37,
+    REG_FIFO_CTL = 0x38,
+    REG_FIFO_STATUS = 0x39,
+    REG_COUNT = 0x40,
+};
+
+#define DEVID               0xE5
+#define POWER_MEASURE       BIT(3)
+#define INT_DATA_READY      BIT(7)
+#define INT_WATERMARK       BIT(1)
+#define INT_OVERRUN         BIT(0)
+#define INT_DATA            (INT_DATA_READY | INT_WATERMARK | INT_OVERRUN)
+#define FMT_INT_INVERT      BIT(5)
+#define FMT_FULL_RES        BIT(3)
+#define FMT_JUSTIFY         BIT(2)
+
+OBJECT_DECLARE_SIMPLE_TYPE(Adxl345State, ADXL345)
+
+struct Adxl345State {
+    I2CSlave parent_obj;
+
+    qemu_irq int_pin[2];
+    QEMUTimer *timer;
+    int32_t accel[3];           /* mg */
+    uint8_t regs[REG_COUNT];
+    uint8_t pointer;
+    bool addressed;             /* the register address byte came */
+};
+
+static void adxl345_update_pins(Adxl345State *s)
+{
+    uint8_t active = s->regs[REG_INT_SOURCE] & s->regs[REG_INT_ENABLE];
+    bool invert = s->regs[REG_DATA_FORMAT] & FMT_INT_INVERT;
+
+    qemu_set_irq(s->int_pin[0], !!(active & ~s->regs[REG_INT_MAP]) ^ invert);
+    qemu_set_irq(s->int_pin[1], !!(active & s->regs[REG_INT_MAP]) ^ invert);
+}
+
+static void adxl345_update_watermark(Adxl345State *s)
+{
+    /* Bypass mode: the FIFO holds no samples */
+    if ((s->regs[REG_FIFO_CTL] & 0x1F) == 0) {
+        s->regs[REG_INT_SOURCE] |= INT_WATERMARK;
+    } else {
+        s->regs[REG_INT_SOURCE] &= ~INT_WATERMARK;
+    }
+}
+
+/* Output code of @mg for the DATA_FORMAT in force */
+static uint16_t adxl345_code(Adxl345State *s, int64_t mg)
+{
+    uint8_t fmt = s->regs[REG_DATA_FORMAT];
+    unsigned range = fmt & 3;
+    unsigned bits = (fmt & FMT_FULL_RES) ? 10 + range : 10;
+    /* 256 LSB/g at full resolution; 10-bit mode halves it per range */
+    int64_t lsb_per_g = (fmt & FMT_FULL_RES) ? 256 : 256 >> range;
+    int64_t code = (mg * lsb_per_g + (mg < 0 ? -500 : 500)) / 1000;
+    int64_t max = (1 << (bits - 1)) - 1;
+
+    code = MIN(MAX(code, -max - 1), max);
+    if (fmt & FMT_JUSTIFY) {
+        return (uint16_t)(code << (16 - bits));
+    }
+    return (uint16_t)code;
+}
+
+static void adxl345_sample(Adxl345State *s)
+{
+    if (s->regs[REG_INT_SOURCE] & INT_DATA_READY) {
+        s->regs[REG_INT_SOURCE] |= INT_OVERRUN;
+    }
+    for (unsigned i = 0; i < 3; i++) {
+        int64_t mg = s->accel[i] +
+                     (int64_t)(int8_t)s->regs[REG_OFSX + i] * 15625 / 1000;
+        uint16_t code = adxl345_code(s, mg);
+
+        s->regs[REG_DATAX0 + 2 * i] = code;
+        s->regs[REG_DATAX0 + 2 * i + 1] = code >> 8;
+    }
+    s->regs[REG_INT_SOURCE] |= INT_DATA_READY;
+    adxl345_update_watermark(s);
+    adxl345_update_pins(s);
+}
+
+static int64_t adxl345_period_ns(Adxl345State *s)
+{
+    unsigned rate = s->regs[REG_BW_RATE] & 0x0F;
+
+    return (NANOSECONDS_PER_SECOND << (15 - rate)) / 3200;
+}
+
+static void adxl345_schedule(Adxl345State *s)
+{
+    if (s->regs[REG_POWER_CTL] & POWER_MEASURE) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                            adxl345_period_ns(s));
+    } else {
+        timer_del(s->timer);
+    }
+}
+
+static void adxl345_tick(void *opaque)
+{
+    Adxl345State *s = opaque;
+
+    adxl345_sample(s);
+    adxl345_schedule(s);
+}
+
+static void adxl345_write(Adxl345State *s, uint8_t reg, uint8_t val)
+{
+    uint8_t old = s->regs[reg];
+
+    switch (reg) {
+    case 0x1D ... 0x2A:
+    case REG_BW_RATE:
+    case REG_INT_ENABLE:
+    case REG_INT_MAP:
+    case REG_DATA_FORMAT:
+        s->regs[reg] = val;
+        break;
+    case REG_POWER_CTL:
+        s->regs[reg] = val & 0x3F;
+        if ((val ^ old) & POWER_MEASURE) {
+            adxl345_schedule(s);
+        }
+        if (val & 0x37) {
+            qemu_log_mask(LOG_UNIMP, "adxl345: POWER_CTL link, sleep and "
+                          "wakeup are not modelled\n");
+        }
+        break;
+    case REG_FIFO_CTL:
+        s->regs[reg] = val;
+        if (val >> 6) {
+            qemu_log_mask(LOG_UNIMP, "adxl345: FIFO modes other than "
+                          "bypass are not modelled\n");
+        }
+        adxl345_update_watermark(s);
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "adxl345: write 0x%02x to read-only "
+                      "or reserved register 0x%02x\n", val, reg);
+        return;
+    }
+    if (reg == REG_INT_ENABLE && (val & 0x7C)) {
+        qemu_log_mask(LOG_UNIMP, "adxl345: tap, activity, inactivity and "
+                      "free-fall interrupts are not modelled\n");
+    }
+    adxl345_update_pins(s);
+}
+
+static uint8_t adxl345_read(Adxl345State *s, uint8_t reg)
+{
+    uint8_t val = reg < REG_COUNT ? s->regs[reg] : 0;
+
+    if (reg >= 0x01 && reg <= 0x1C) {
+        return 0;               /* reserved */
+    }
+    if (reg >= REG_DATAX0 && reg <= REG_DATAZ1) {
+        s->regs[REG_INT_SOURCE] &= ~(INT_DATA_READY | INT_OVERRUN);
+        adxl345_update_pins(s);
+    }
+    return val;
+}
+
+static int adxl345_event(I2CSlave *i2c, enum i2c_event event)
+{
+    Adxl345State *s = ADXL345(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->addressed = false;
+    }
+    return 0;
+}
+
+static int adxl345_send(I2CSlave *i2c, uint8_t data)
+{
+    Adxl345State *s = ADXL345(i2c);
+
+    if (!s->addressed) {
+        s->pointer = data & 0x3F;
+        s->addressed = true;
+        return 0;
+    }
+    adxl345_write(s, s->pointer, data);
+    s->pointer = (s->pointer + 1) & 0x3F;
+    return 0;
+}
+
+static uint8_t adxl345_recv(I2CSlave *i2c)
+{
+    Adxl345State *s = ADXL345(i2c);
+    uint8_t val = adxl345_read(s, s->pointer);
+
+    s->pointer = (s->pointer + 1) & 0x3F;
+    return val;
+}
+
+static void adxl345_get_axis(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, opaque, errp);
+}
+
+static void adxl345_set_axis(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    int32_t value;
+
+    if (!visit_type_int32(v, name, &value, errp)) {
+        return;
+    }
+    if (value < -16000 || value > 16000) {
+        error_setg(errp, "%s must be -16000 to 16000 mg", name);
+        return;
+    }
+    *(int32_t *)opaque = value;
+}
+
+/*
+ * "xyz": all three axes at once ("x y z" in mg), so no sample mixes old
+ * and new values
+ */
+static char *adxl345_get_xyz(Object *obj, Error **errp)
+{
+    Adxl345State *s = ADXL345(obj);
+
+    return g_strdup_printf("%d %d %d", s->accel[0], s->accel[1],
+                           s->accel[2]);
+}
+
+static void adxl345_set_xyz(Object *obj, const char *value, Error **errp)
+{
+    Adxl345State *s = ADXL345(obj);
+    int v[3];
+    char end;
+
+    if (sscanf(value, "%d %d %d %c", &v[0], &v[1], &v[2], &end) != 3) {
+        error_setg(errp, "xyz must be three integers (mg): \"x y z\"");
+        return;
+    }
+    for (unsigned i = 0; i < 3; i++) {
+        if (v[i] < -16000 || v[i] > 16000) {
+            error_setg(errp, "xyz values must be -16000 to 16000 mg");
+            return;
+        }
+    }
+    memcpy(s->accel, v, sizeof(s->accel));
+}
+
+static void adxl345_reset(DeviceState *dev)
+{
+    Adxl345State *s = ADXL345(dev);
+
+    timer_del(s->timer);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[REG_DEVID] = DEVID;
+    s->regs[REG_BW_RATE] = 0x0A;
+    s->regs[REG_INT_SOURCE] = INT_WATERMARK;
+    s->pointer = 0;
+    s->addressed = false;
+    adxl345_update_pins(s);
+}
+
+static void adxl345_init(Object *obj)
+{
+    Adxl345State *s = ADXL345(obj);
+    static const char *const axes[] = { "x", "y", "z" };
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, adxl345_tick, s);
+    s->accel[2] = 1000;         /* flat, face up */
+    qdev_init_gpio_out_named(DEVICE(obj), &s->int_pin[0], ADXL345_INT1, 1);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->int_pin[1], ADXL345_INT2, 1);
+    for (unsigned i = 0; i < 3; i++) {
+        object_property_add(obj, axes[i], "int32", adxl345_get_axis,
+                            adxl345_set_axis, NULL, &s->accel[i]);
+    }
+    object_property_add_str(obj, "xyz", adxl345_get_xyz, adxl345_set_xyz);
+}
+
+static void adxl345_finalize(Object *obj)
+{
+    timer_free(ADXL345(obj)->timer);
+}
+
+static const VMStateDescription vmstate_adxl345 = {
+    .name = TYPE_ADXL345,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, Adxl345State),
+        VMSTATE_TIMER_PTR(timer, Adxl345State),
+        VMSTATE_INT32_ARRAY(accel, Adxl345State, 3),
+        VMSTATE_UINT8_ARRAY(regs, Adxl345State, REG_COUNT),
+        VMSTATE_UINT8(pointer, Adxl345State),
+        VMSTATE_BOOL(addressed, Adxl345State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void adxl345_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->desc = "Analog Devices ADXL345 accelerometer";
+    dc->vmsd = &vmstate_adxl345;
+    device_class_set_legacy_reset(dc, adxl345_reset);
+    k->event = adxl345_event;
+    k->send = adxl345_send;
+    k->recv = adxl345_recv;
+}
+
+static const TypeInfo adxl345_types[] = {
+    {
+        .name = TYPE_ADXL345,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(Adxl345State),
+        .instance_init = adxl345_init,
+        .instance_finalize = adxl345_finalize,
+        .class_init = adxl345_class_init,
+    },
+};
+
+DEFINE_TYPES(adxl345_types)
