+/* TWI0 host: write @reg, then read @n bytes (smart mode), STOP */
+static void twi_read(QTestState *qts, uint8_t addr, uint8_t reg,
+                     uint8_t *d, unsigned n)
+{
+    qtest_writeb(qts, TWI0 + T_MADDR, addr << 1);
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS) & (T_WIF | T_RXACK),
+                    ==, T_WIF);
+    qtest_writeb(qts, TWI0 + T_MDATA, reg);
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS) & (T_WIF | T_RXACK),
+                    ==, T_WIF);
+    qtest_writeb(qts, TWI0 + T_MADDR, addr << 1 | 1);      /* rep. START */
+    for (unsigned i = 0; i < n; i++) {
+        g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS) & T_RIF, ==,
+                        T_RIF);
+        qtest_writeb(qts, TWI0 + T_MCTRLB, i == n - 1 ? 0x04 : 0);
+        d[i] = qtest_readb(qts, TWI0 + T_MDATA);
+    }
+    qtest_writeb(qts, TWI0 + T_MCTRLB, 0x07);           /* NACK, STOP */
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS) & 3, ==, 1);
+}
+
+/*
+ * TWI0 host and the Accel Click (ADXL345, 0x53) on mikroBUS 2: bus state,
+ * address NACK, register writes and smart-mode multi-byte reads, the
+ * host interrupt flag
+ */
+static void test_twi_accel(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb2=accel -kernel %s",
+                                  (const char *)fw);
+    uint8_t d[6];
+
+    qtest_writeb(qts, TWI0 + T_MCTRLA, 0x03);           /* ENABLE, SMEN */
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS), ==, 0); /* unknown */
+    qtest_writeb(qts, TWI0 + T_MSTATUS, 0x01);          /* force IDLE */
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS), ==, 0x01);
+    /* Nobody at 0x1D: WIF with RXACK (NACK); STOP releases the bus */
+    qtest_writeb(qts, TWI0 + T_MADDR, 0x1D << 1);
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS), ==,
+                    T_WIF | T_RXACK | BIT(5) | 0x02);
+    qtest_writeb(qts, TWI0 + T_MCTRLB, 0x03);
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS), ==, T_RXACK | 0x01);
+    twi_read(qts, 0x53, 0x00, d, 1);
+    g_assert_cmphex(d[0], ==, 0xE5);                    /* DEVID */
+    /* POWER_CTL Measure, DATA_FORMAT full resolution: 3 bytes from 0x2D */
+    qtest_writeb(qts, TWI0 + T_MADDR, 0x53 << 1);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x2D);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x08);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x00);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x00);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x08);
+    qtest_writeb(qts, TWI0 + T_MCTRLB, 0x03);
+    qtest_clock_step(qts, 20 * 1000 * 1000);
+    twi_read(qts, 0x53, 0x32, d, 6);
+    g_assert_cmphex(d[4] | d[5] << 8, ==, 256);         /* z = 1 g */
+    /* RIEN: the TWIM vector's flag follows RIF (no CPU here: the flag) */
+    qtest_writeb(qts, TWI0 + T_MCTRLA, 0x83);
+    qtest_writeb(qts, TWI0 + T_MADDR, 0x53 << 1 | 1);
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS) & T_RIF, ==, T_RIF);
+    qtest_writeb(qts, TWI0 + T_MSTATUS, T_RIF);         /* W1C */
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS) & T_RIF, ==, 0);
+    qtest_writeb(qts, TWI0 + T_MCTRLB, 0x07);
+    qtest_quit(qts);
+}
