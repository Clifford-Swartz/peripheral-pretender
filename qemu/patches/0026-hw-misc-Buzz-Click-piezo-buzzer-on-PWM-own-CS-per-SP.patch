diff --git a/hw/misc/click_buzzer.c b/hw/misc/click_buzzer.c
new file mode 100644
index 0000000..65e9e1f
--- /dev/null
+++ b/hw/misc/click_buzzer.c
@@ -0,0 +1,172 @@
+/*
+ * A piezo buzzer on a Click board, driven from one header pin
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Buzz Click (MikroElektronika, schematic v100): the PWM pin drives the
+ * base of Q1 (BC846) through R1 10k; Q1 switches the EPT-14A4005P piezo
+ * transducer (R2 1k across it). The transducer has no oscillator of its
+ * own: it sounds at the frequency of the drive signal and stays silent
+ * under a constant level, high or low.
+ *
+ * The model times the rising edges of the drive signal on the virtual
+ * clock: "frequency" is 1 / (the last full period), rounded to Hz, and
+ * "duty" the high time of that period in per mille. The tone has ended
+ * once no edge has come for two periods (plus 1 ms): both read 0 then,
+ * and the next rising edge starts a new tone instead of ending a period
+ * that spans the silence.
+ * Loudness, resonance (4 kHz) and the transistor are not modelled. Not
+ * checked against a physical Click.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/visitor.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/misc/click_buzzer.h"
+#include "migration/vmstate.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(ClickBuzzerState, CLICK_BUZZER)
+
+struct ClickBuzzerState {
+    DeviceState parent_obj;
+
+    bool level;
+    int64_t rise_ns;            /* last rising edge, -1: none yet */
+    int64_t edge_ns;            /* last edge of either kind */
+    int64_t period_ns;          /* last full period, 0: none */
+    int64_t high_ns;            /* high time in that period */
+    int64_t pending_high_ns;    /* high time since rise_ns */
+    uint32_t periods;
+};
+
+static void click_buzzer_set_in(void *opaque, int n, int level)
+{
+    ClickBuzzerState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    bool high = level > 0;
+    int64_t last = s->edge_ns;
+
+    if (high == s->level) {
+        return;
+    }
+    s->level = high;
+    s->edge_ns = now;
+    if (high) {
+        if (s->rise_ns >= 0 && (!s->period_ns ||
+                                now - last <= 2 * s->period_ns + SCALE_MS)) {
+            s->period_ns = now - s->rise_ns;
+            s->high_ns = s->pending_high_ns;
+        } else {
+            s->period_ns = 0;           /* after a silence: a new tone */
+        }
+        s->rise_ns = now;
+        s->periods++;
+    } else if (s->rise_ns >= 0) {
+        s->pending_high_ns = now - s->rise_ns;
+    }
+}
+
+/* True while the last period is still the current tone */
+static bool click_buzzer_sounding(ClickBuzzerState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    return s->period_ns > 0 &&
+           now - s->edge_ns <= 2 * s->period_ns + SCALE_MS;
+}
+
+static void click_buzzer_get_frequency(Object *obj, Visitor *v,
+                                       const char *name, void *opaque,
+                                       Error **errp)
+{
+    ClickBuzzerState *s = CLICK_BUZZER(obj);
+    uint32_t hz = 0;
+
+    if (click_buzzer_sounding(s)) {
+        hz = (NANOSECONDS_PER_SECOND + s->period_ns / 2) / s->period_ns;
+    }
+    visit_type_uint32(v, name, &hz, errp);
+}
+
+static void click_buzzer_get_duty(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    ClickBuzzerState *s = CLICK_BUZZER(obj);
+    uint32_t duty = 0;
+
+    if (click_buzzer_sounding(s)) {
+        duty = MIN(1000, (s->high_ns * 1000 + s->period_ns / 2) /
+                         s->period_ns);
+    }
+    visit_type_uint32(v, name, &duty, errp);
+}
+
+static void click_buzzer_reset(DeviceState *dev)
+{
+    ClickBuzzerState *s = CLICK_BUZZER(dev);
+
+    /* The level stays what the pin drives; the tone starts afresh */
+    s->rise_ns = -1;
+    s->edge_ns = 0;
+    s->period_ns = 0;
+    s->high_ns = 0;
+    s->pending_high_ns = 0;
+    s->periods = 0;
+}
+
+static void click_buzzer_init(Object *obj)
+{
+    ClickBuzzerState *s = CLICK_BUZZER(obj);
+
+    qdev_init_gpio_in_named(DEVICE(obj), click_buzzer_set_in,
+                            CLICK_BUZZER_IN, 1);
+    object_property_add(obj, "frequency", "uint32",
+                        click_buzzer_get_frequency, NULL, NULL, NULL);
+    object_property_add(obj, "duty", "uint32", click_buzzer_get_duty,
+                        NULL, NULL, NULL);
+    object_property_add_uint32_ptr(obj, "periods", &s->periods,
+                                   OBJ_PROP_FLAG_READ);
+    s->rise_ns = -1;
+}
+
+static const VMStateDescription vmstate_click_buzzer = {
+    .name = TYPE_CLICK_BUZZER,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(level, ClickBuzzerState),
+        VMSTATE_INT64(rise_ns, ClickBuzzerState),
+        VMSTATE_INT64(edge_ns, ClickBuzzerState),
+        VMSTATE_INT64(period_ns, ClickBuzzerState),
+        VMSTATE_INT64(high_ns, ClickBuzzerState),
+        VMSTATE_INT64(pending_high_ns, ClickBuzzerState),
+        VMSTATE_UINT32(periods, ClickBuzzerState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void click_buzzer_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "Click board piezo buzzer";
+    dc->vmsd = &vmstate_click_buzzer;
+    device_class_set_legacy_reset(dc, click_buzzer_reset);
+}
+
+static const TypeInfo click_buzzer_types[] = {
+    {
+        .name = TYPE_CLICK_BUZZER,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(ClickBuzzerState),
+        .instance_init = click_buzzer_init,
+        .class_init = click_buzzer_class_init,
+    },
+};
+
+DEFINE_TYPES(click_buzzer_types)
