diff --git a/include/hw/misc/click_buzzer.h b/include/hw/misc/click_buzzer.h
new file mode 100644
index 0000000..576d864
--- /dev/null
+++ b/include/hw/misc/click_buzzer.h
@@ -0,0 +1,21 @@
+/*
+ * A piezo buzzer on a Click board, driven from one header pin
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * GPIO input "in": the drive signal (a PWM pin). QOM properties
+ * (read-only): "frequency" (Hz of the last full period, 0 while silent),
+ * "duty" (per mille high over that period) and "periods" (rising edges
+ * so far).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_CLICK_BUZZER_H
+#define HW_MISC_CLICK_BUZZER_H
+
+#define TYPE_CLICK_BUZZER "click-buzzer"
+#define CLICK_BUZZER_IN "in"
+
+#endif /* HW_MISC_CLICK_BUZZER_H */
