@@ -27,6 +27,7 @@
 #define NVMCTRL         (DATA + 0x1000)
 #define SIGROW          (DATA + 0x1100)
 #define PORTA           (DATA + 0x0400)
+#define PORTD           (DATA + 0x0460)
 #define SPI0            (DATA + 0x0940)
 #define TCB0            (DATA + 0x0B00)
 #define EEPROM          (DATA + 0x1400)
@@ -230,6 +231,29 @@ static void test_tcb(const void *fw)
     qtest_quit(qts);
 }
 
+/* Buzz Click on mikroBUS 1: the PWM pin (PD0) sets the tone */
+static void test_buzz(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb1=buzz -kernel %s",
+                                  (const char *)fw);
+
+    g_assert_cmphex(qtest_readb(qts, PORTD + P_IN) & BIT(0), ==, 0);
+    qtest_writeb(qts, PORTD + P_DIRSET, BIT(0));
+    for (unsigned i = 0; i < 6; i++) {
+        qtest_writeb(qts, PORTD + 0x05, BIT(0));                /* OUTSET */
+        qtest_clock_step(qts, 227273);
+        qtest_writeb(qts, PORTD + P_OUTCLR, BIT(0));
+        qtest_clock_step(qts, 909091);
+    }
+    qtest_writeb(qts, PORTD + 0x05, BIT(0));
+    g_assert_cmpuint(qom_uint(qts, "/machine/mb1-click", "frequency"), ==,
+                     880);
+    g_assert_cmpuint(qom_uint(qts, "/machine/mb1-click", "duty"), ==, 200);
+    qtest_clock_step(qts, 10 * 1000 * 1000);
+    g_assert_cmpuint(qom_uint(qts, "/machine/mb1-click", "frequency"), ==, 0);
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_autofree char *fw = write_firmware();
@@ -243,6 +267,7 @@ int main(int argc, char **argv)
                         test_usart_cpuint);
     qtest_add_data_func("avr64ea48-cnano/spi-8x8g", fw, test_spi_8x8g);
     qtest_add_data_func("avr64ea48-cnano/tcb", fw, test_tcb);
+    qtest_add_data_func("avr64ea48-cnano/buzz", fw, test_buzz);
     ret = g_test_run();
     unlink(fw);
     return ret;
diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index 0e904fa..a2aa5fd 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -337,12 +337,81 @@ static void test_relay(void)
     qtest_quit(qts);
 }
 
+/* Drive @pin of @group as a square wave: @n periods of @hi_ns + @lo_ns */
+static void square(QTestState *qts, uint32_t group, unsigned pin,
+                   unsigned n, int64_t hi_ns, int64_t lo_ns)
+{
+    for (unsigned i = 0; i < n; i++) {
+        qtest_writel(qts, group + P_OUTSET, BIT(pin));
+        qtest_clock_step(qts, hi_ns);
+        qtest_writel(qts, group + P_OUTCLR, BIT(pin));
+        qtest_clock_step(qts, lo_ns);
+    }
+}
+
+/*
+ * Buzz Click on EXT1: PWM (PB10) pulled low through R1 and Q1's base; the
+ * tone is the frequency of the drive signal, silence under a steady level
+ */
+static void test_buzz(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=buzz ");
+
+    g_assert_false(pin_high(qts, PB, 10));
+    g_assert_cmpint(qom_int(qts, CLICK1, "frequency"), ==, 0);
+    qtest_writel(qts, PB + P_DIRSET, BIT(10));
+    square(qts, PB, 10, 8, 125000, 125000);             /* 4 kHz */
+    qtest_writel(qts, PB + P_OUTSET, BIT(10));
+    g_assert_cmpint(qom_int(qts, CLICK1, "frequency"), ==, 4000);
+    g_assert_cmpint(qom_int(qts, CLICK1, "duty"), ==, 500);
+    g_assert_cmpint(qom_int(qts, CLICK1, "periods"), ==, 9);
+    /* Held high: silent once two periods (and 1 ms) pass without an edge */
+    qtest_clock_step(qts, 1400000);
+    g_assert_cmpint(qom_int(qts, CLICK1, "frequency"), ==, 4000);
+    qtest_clock_step(qts, 200000);
+    g_assert_cmpint(qom_int(qts, CLICK1, "frequency"), ==, 0);
+    g_assert_cmpint(qom_int(qts, CLICK1, "duty"), ==, 0);
+    /* A new tone after the silence: 500 Hz, 25 % */
+    qtest_writel(qts, PB + P_OUTCLR, BIT(10));
+    qtest_clock_step(qts, 10000000);
+    square(qts, PB, 10, 4, 500000, 1500000);
+    g_assert_cmpint(qom_int(qts, CLICK1, "frequency"), ==, 500);
+    g_assert_cmpint(qom_int(qts, CLICK1, "duty"), ==, 250);
+    qtest_quit(qts);
+}
+
+/* Two SPI Clicks share SERCOM1: each takes the bytes on its own CS only */
+static void test_two_spi(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=8x8g,ext2=7seg ");
+    QDict *rsp;
+
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, PA + P_OUTSET, BIT(15) | BIT(17));
+    qtest_writel(qts, PA + P_DIRSET, BIT(15) | BIT(17));
+    qtest_writel(qts, PA + P_OUTCLR, BIT(15));          /* 7seg LATCH */
+    spi_byte(qts, 0x0F);                                /* display test */
+    spi_byte(qts, 0x01);
+    qtest_writel(qts, PA + P_OUTSET, BIT(15));
+    g_assert_cmphex(qom_int(qts, CLICK2, "outputs"), ==, 0x0F01);
+    rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments': {"
+                    " 'path': '" CLICK1 "', 'property': 'display' } }");
+    /* The MAX7219 shifted the bytes too, but its LOAD (PA17) stayed high */
