+++ b/hw/gpio/avr8x_port.c
@@ -0,0 +1,529 @@
+/*
+ * Microchip AVR8X I/O ports (PORT and VPORT, gpio_ports_avr_v3)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Behaviour from DS40002324 (AVR64EA48), chapter PORT: DIR and OUT with
+ * their SET/CLR/TGL strobes, IN (writing 1 toggles OUT), PINnCTRL
+ * (ISC, PULLUPEN, INVEN) and the PINCONFIG/PINCTRLUPD/SET/CLR multi-pin
+ * configuration, INTFLAGS (write 1 to clear) with the input sense
+ * configuration, and the VPORT view of DIR, OUT, IN and INTFLAGS.
+ * A pad is driven by OUT (or a peripheral override) while DIR is set;
+ * otherwise an external driver sets it, else the pull-up, else it floats
+ * and reads 0. INVEN inverts both the output and the input. Not modelled:
+ * slew rate (PORTCTRL.SRL), input levels (INLVL) and the event generators
+ * (EVGENCTRL is stored only).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/gpio/avr8x_port.h"
+#include "hw/mchp/gen/port_gpio_ports_avr_v3.h"
+#include "hw/mchp/gen/vport_gpio_ports_avr_v3_vport.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define ISC(ctrl)       FIELD_EX8(ctrl, MCHP_PORT_PINCONFIG, ISC)
+#define PULLUP(ctrl)    FIELD_EX8(ctrl, MCHP_PORT_PINCONFIG, PULLUPEN)
+#define INVEN(ctrl)     FIELD_EX8(ctrl, MCHP_PORT_PINCONFIG, INVEN)
+
+static uint8_t avr8x_port_mask_of(Avr8xPortGroup *g, uint8_t (*bit)(uint8_t))
+{
+    uint8_t mask = 0;
+
+    for (unsigned pin = 0; pin < AVR8X_PORT_PINS; pin++) {
+        if (bit(g->pinctrl[pin])) {
+            mask |= BIT(pin);
+        }
+    }
+    return mask;
+}
+
+static uint8_t avr8x_inven(uint8_t ctrl)
+{
+    return INVEN(ctrl);
+}
+
+static uint8_t avr8x_pullup(uint8_t ctrl)
+{
+    return PULLUP(ctrl);
+}
+
+/* Output level of each pin while it is an output (OUT or override) */
+static uint8_t avr8x_port_drive_level(Avr8xPortGroup *g)
+{
+    uint8_t out = (g->out & ~g->per_mask) | (g->per_level & g->per_mask);
+
+    return out ^ avr8x_port_mask_of(g, avr8x_inven);
+}
+
+/* Level of every pad of group @g */
+static uint8_t avr8x_port_pads(Avr8xPortGroup *g)
+{
+    uint8_t drive = g->dir;
+    uint8_t ext = g->ext_mask & ~drive;
+    uint8_t pull = avr8x_port_mask_of(g, avr8x_pullup) & ~drive & ~ext;
+
+    return (avr8x_port_drive_level(g) & drive) | (g->ext_level & ext) | pull;
+}
+
+/* IN: the pads as the input buffers see them (INVEN, input disable) */
+static uint8_t avr8x_port_in(Avr8xPortGroup *g)
+{
+    uint8_t in = avr8x_port_pads(g) ^ avr8x_port_mask_of(g, avr8x_inven);
+
+    for (unsigned pin = 0; pin < AVR8X_PORT_PINS; pin++) {
+        if (ISC(g->pinctrl[pin]) == MCHP_PORT_PINCONFIG_ISC_INPUT_DISABLE) {
+            in &= ~BIT(pin);
+        }
+    }
+    return in;
+}
+
+static void avr8x_port_account(Avr8xPortGroup *g)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t dt = now - g->acc_time;
+
+    for (unsigned pin = 0; pin < AVR8X_PORT_PINS && dt > 0; pin++) {
+        if (extract32(g->pad_mask, pin, 1)) {
+            if (extract32(g->pad_level, pin, 1)) {
+                g->high_ns[pin] += dt;
+            } else {
+                g->low_ns[pin] += dt;
+            }
+        }
+    }
+    g->acc_time = now;
+}
+
+/* Input sense: set INTFLAGS for the edges and levels PINnCTRL.ISC asks */
+static void avr8x_port_sense(Avr8xPortGroup *g)
+{
+    uint8_t in = avr8x_port_in(g);
+    uint8_t rose = in & ~g->in_last, fell = ~in & g->in_last;
+
+    for (unsigned pin = 0; pin < AVR8X_PORT_PINS; pin++) {
+        bool hit = false;
+
+        switch (ISC(g->pinctrl[pin])) {
+        case MCHP_PORT_PINCONFIG_ISC_BOTHEDGES:
+            hit = extract32(rose | fell, pin, 1);
+            break;
+        case MCHP_PORT_PINCONFIG_ISC_RISING:
+            hit = extract32(rose, pin, 1);
+            break;
+        case MCHP_PORT_PINCONFIG_ISC_FALLING:
+            hit = extract32(fell, pin, 1);
+            break;
+        case MCHP_PORT_PINCONFIG_ISC_LEVEL:
+            hit = !extract32(in, pin, 1);
+            break;
+        }
+        if (hit) {
+            g->intflags |= BIT(pin);
+        }
+    }
+    g->in_last = in;
+}
+
+static void avr8x_port_update(Avr8xPortState *s, unsigned n)
+{
+    Avr8xPortGroup *g = &s->g[n];
+    uint8_t pads = avr8x_port_pads(g);
+    uint8_t driven = g->dir;
+    uint8_t changed = (driven ^ g->pad_mask) |
+                      ((pads ^ g->pad_level) & driven);
+
+    avr8x_port_sense(g);
+    if (changed) {
+        avr8x_port_account(g);
+        g->pad_mask = driven;
+        g->pad_level = pads & driven;
+        for (unsigned pin = 0; pin < AVR8X_PORT_PINS; pin++) {
+            if (extract32(changed, pin, 1)) {
+                int level = extract32(driven, pin, 1) ?
+                            (int)extract32(pads, pin, 1) : -1;
+
+                trace_avr8x_port_pad('A' + n, pin, level);
+                qemu_set_irq(s->pad[n * AVR8X_PORT_PINS + pin], level);
+            }
+        }
+    }
+    qemu_set_irq(s->irq[n], g->intflags != 0);
+}
+
+/* PINCTRLUPD/SET/CLR: PINCONFIG into PINnCTRL of the pins written 1 */
+static void avr8x_port_pinctrl_multi(Avr8xPortGroup *g, hwaddr reg,
+                                     uint8_t pins)
+{
+    for (unsigned pin = 0; pin < AVR8X_PORT_PINS; pin++) {
+        if (!extract32(pins, pin, 1)) {
+            continue;
+        }
+        switch (reg) {
+        case A_MCHP_PORT_PINCTRLUPD:
+            g->pinctrl[pin] = g->pinconfig;
+            break;
+        case A_MCHP_PORT_PINCTRLSET:
+            g->pinctrl[pin] |= g->pinconfig;
+            break;
+        case A_MCHP_PORT_PINCTRLCLR:
+            g->pinctrl[pin] &= ~g->pinconfig;
+            break;
+        }
+    }
+}
+
+static uint64_t avr8x_port_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Avr8xPortGroup *g = opaque;
+    unsigned n = g->index;
+    hwaddr reg = addr;
+
+    switch (reg) {
+    case A_MCHP_PORT_DIR ... A_MCHP_PORT_DIRTGL:
+        return g->dir;
+    case A_MCHP_PORT_OUT ... A_MCHP_PORT_OUTTGL:
+        return g->out;
+    case A_MCHP_PORT_IN:
+        return avr8x_port_in(g);
+    case A_MCHP_PORT_INTFLAGS:
+        return g->intflags;
+    case A_MCHP_PORT_PORTCTRL:
+        return g->portctrl;
+    case A_MCHP_PORT_PINCONFIG:
+        return g->pinconfig;
+    case A_MCHP_PORT_PINCTRLUPD ... A_MCHP_PORT_PINCTRLCLR:
+        return 0;
+    case A_MCHP_PORT_PIN0CTRL ... A_MCHP_PORT_PIN7CTRL:
+        return g->pinctrl[reg - A_MCHP_PORT_PIN0CTRL];
+    case A_MCHP_PORT_EVGENCTRL:
+        return g->evgenctrl;
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "port%c: read of reserved offset 0x%"
+                  HWADDR_PRIx "\n", 'a' + n, reg);
+    return 0;
+}
+
+static void avr8x_port_write(void *opaque, hwaddr addr, uint64_t val64,
+                             unsigned size)
+{
+    Avr8xPortGroup *g = opaque;
+    Avr8xPortState *s = g->owner;
+    unsigned n = g->index;
+    hwaddr reg = addr;
+    uint8_t val = val64;
+
+    switch (reg) {
+    case A_MCHP_PORT_DIR:
+        g->dir = val;
+        break;
+    case A_MCHP_PORT_DIRSET:
+        g->dir |= val;
+        break;
+    case A_MCHP_PORT_DIRCLR:
+        g->dir &= ~val;
+        break;
+    case A_MCHP_PORT_DIRTGL:
+        g->dir ^= val;
+        break;
+    case A_MCHP_PORT_OUT:
+        g->out = val;
+        break;
+    case A_MCHP_PORT_OUTSET:
+        g->out |= val;
+        break;
+    case A_MCHP_PORT_OUTCLR:
+        g->out &= ~val;
+        break;
+    case A_MCHP_PORT_OUTTGL:
+    case A_MCHP_PORT_IN:            /* writing 1 to IN toggles OUT */
+        g->out ^= val;
+        break;
+    case A_MCHP_PORT_INTFLAGS:
+        g->intflags &= ~val;
+        break;
+    case A_MCHP_PORT_PORTCTRL:
+        g->portctrl = val & R_MCHP_PORT_PORTCTRL_SRL_MASK;
+        break;
+    case A_MCHP_PORT_PINCONFIG:
+        g->pinconfig = val;
+        break;
+    case A_MCHP_PORT_PINCTRLUPD ... A_MCHP_PORT_PINCTRLCLR:
+        avr8x_port_pinctrl_multi(g, reg, val);
+        break;
+    case A_MCHP_PORT_PIN0CTRL ... A_MCHP_PORT_PIN7CTRL:
+        g->pinctrl[reg - A_MCHP_PORT_PIN0CTRL] = val;
+        break;
+    case A_MCHP_PORT_EVGENCTRL:
+        g->evgenctrl = val;
+        if (val) {
+            qemu_log_mask(LOG_UNIMP, "port%c.EVGENCTRL: write 0x%02x not "
+                          "modelled\n", 'a' + n, val);
+        }
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "port%c: write of reserved offset 0x%"
+                      HWADDR_PRIx "\n", 'a' + n, reg);
+        return;
+    }
+    avr8x_port_update(s, n);
+}
+
+static uint64_t avr8x_vport_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Avr8xPortGroup *g = opaque;
+
+    switch (addr) {
+    case A_MCHP_VPORT_DIR:
+        return g->dir;
+    case A_MCHP_VPORT_OUT:
+        return g->out;
+    case A_MCHP_VPORT_IN:
+        return avr8x_port_in(g);
+    default:
+        return g->intflags;
+    }
+}
+
+static void avr8x_vport_write(void *opaque, hwaddr addr, uint64_t val64,
+                              unsigned size)
+{
+    Avr8xPortGroup *g = opaque;
+    Avr8xPortState *s = g->owner;
+    unsigned n = g->index;
+    uint8_t val = val64;
+
+    switch (addr) {
+    case A_MCHP_VPORT_DIR:
+        g->dir = val;
+        break;
+    case A_MCHP_VPORT_OUT:
+        g->out = val;
+        break;
+    case A_MCHP_VPORT_IN:
+        g->out ^= val;
+        break;
+    default:
+        g->intflags &= ~val;
+        break;
+    }
+    avr8x_port_update(s, n);
+}
+
+static const MemoryRegionOps avr8x_port_ops = {
+    .read = avr8x_port_read,
+    .write = avr8x_port_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+};
+
+static const MemoryRegionOps avr8x_vport_ops = {
+    .read = avr8x_vport_read,
+    .write = avr8x_vport_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+};
+
+/* "port-in": an external driver on pad @n (negative: released) */
+static void avr8x_port_set_input(void *opaque, int n, int level)
+{
+    Avr8xPortState *s = opaque;
+    unsigned grp = n / AVR8X_PORT_PINS, pin = n % AVR8X_PORT_PINS;
+    Avr8xPortGroup *g = &s->g[grp];
+
+    if (grp >= s->ngroups) {
+        return;
+    }
+    trace_avr8x_port_in('A' + grp, pin, level);
+    g->ext_mask = deposit32(g->ext_mask, pin, 1, level >= 0);
+    g->ext_level = deposit32(g->ext_level, pin, 1, level > 0);
+    avr8x_port_update(s, grp);
+}
+
+/* "periph-out": a peripheral overrides OUT of pad @n (negative: stops) */
+static void avr8x_port_set_periph(void *opaque, int n, int level)
+{
+    Avr8xPortState *s = opaque;
+    unsigned grp = n / AVR8X_PORT_PINS, pin = n % AVR8X_PORT_PINS;
+    Avr8xPortGroup *g = &s->g[grp];
+
+    if (grp >= s->ngroups) {
+        return;
+    }
+    g->per_mask = deposit32(g->per_mask, pin, 1, level >= 0);
+    g->per_level = deposit32(g->per_level, pin, 1, level > 0);
+    avr8x_port_update(s, grp);
+}
+
+static void avr8x_port_get_levels(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    Avr8xPortState *s = AVR8X_PORT(obj);
+    uint32_t value = avr8x_port_pads(&s->g[GPOINTER_TO_UINT(opaque)]);
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void avr8x_port_get_stats(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    Avr8xPortState *s = AVR8X_PORT(obj);
+    Avr8xPortGroup *g = &s->g[GPOINTER_TO_UINT(opaque)];
+    g_autoptr(GString) str = g_string_new(NULL);
+    g_autofree char *val = NULL;
+
+    avr8x_port_account(g);
+    g_string_append_printf(str, "%" PRId64, g->acc_time);
+    for (unsigned pin = 0; pin < AVR8X_PORT_PINS; pin++) {
+        g_string_append_printf(str, " %" PRIu64 " %" PRIu64, g->high_ns[pin],
+                               g->low_ns[pin]);
+    }
+    val = g_string_free(g_steal_pointer(&str), false);
+    visit_type_str(v, name, &val, errp);
+}
+
+static void avr8x_port_reset_hold(Object *obj, ResetType type)
+{
+    Avr8xPortState *s = AVR8X_PORT(obj);
+
+    for (unsigned n = 0; n < AVR8X_PORT_GROUPS; n++) {
+        Avr8xPortGroup *g = &s->g[n];
+
+        g->dir = g->out = g->intflags = 0;
+        g->portctrl = g->pinconfig = g->evgenctrl = 0;
+        memset(g->pinctrl, 0, sizeof(g->pinctrl));
+        g->per_mask = g->per_level = 0;
+    }
+}
+
+static void avr8x_port_reset_exit(Object *obj, ResetType type)
+{
+    Avr8xPortState *s = AVR8X_PORT(obj);
+
+    for (unsigned n = 0; n < s->ngroups; n++) {
+        s->g[n].in_last = avr8x_port_in(&s->g[n]);
+        avr8x_port_update(s, n);
+    }
+}
+
+static void avr8x_port_init(Object *obj)
+{
+    Avr8xPortState *s = AVR8X_PORT(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), s->pad, AVR8X_PORT_PAD,
+                             AVR8X_PORT_NUM_PINS);
+    qdev_init_gpio_in_named(DEVICE(obj), avr8x_port_set_input, AVR8X_PORT_IN,
+                            AVR8X_PORT_NUM_PINS);
+    qdev_init_gpio_in_named(DEVICE(obj), avr8x_port_set_periph,
+                            AVR8X_PORT_PERIPH_OUT, AVR8X_PORT_NUM_PINS);
+}
+
+static void avr8x_port_realize(DeviceState *dev, Error **errp)
+{
+    Avr8xPortState *s = AVR8X_PORT(dev);
+    Object *obj = OBJECT(dev);
+
+    if (!s->ngroups || s->ngroups > AVR8X_PORT_GROUPS) {
+        error_setg(errp, "avr8x-port: groups must be 1-%d",
+                   AVR8X_PORT_GROUPS);
+        return;
+    }
+    for (unsigned n = 0; n < s->ngroups; n++) {
+        void *group = GUINT_TO_POINTER(n);
+        g_autofree char *port = g_strdup_printf("port%c", 'a' + n);
+        g_autofree char *vport = g_strdup_printf("vport%c", 'a' + n);
+        g_autofree char *stats = g_strdup_printf("p%c-stats", 'a' + n);
+        g_autofree char *levels = g_strdup_printf("p%c-levels", 'a' + n);
+
+        s->g[n].owner = s;
+        s->g[n].index = n;
+        memory_region_init_io(&s->port_mr[n], obj, &avr8x_port_ops, &s->g[n],
+                              port, AVR8X_PORT_GROUP_SIZE);
+        memory_region_init_io(&s->vport_mr[n], obj, &avr8x_vport_ops,
+                              &s->g[n], vport, AVR8X_VPORT_SIZE);
+        sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->port_mr[n]);
+        sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->vport_mr[n]);
+        sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq[n]);
+        object_property_add(obj, stats, "str", avr8x_port_get_stats,
+                            NULL, NULL, group);
+        object_property_add(obj, levels, "uint32", avr8x_port_get_levels,
+                            NULL, NULL, group);
+    }
+}
+
+static const VMStateDescription vmstate_avr8x_port_group = {
+    .name = "avr8x-port-group",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8(dir, Avr8xPortGroup),
+        VMSTATE_UINT8(out, Avr8xPortGroup),
+        VMSTATE_UINT8(intflags, Avr8xPortGroup),
+        VMSTATE_UINT8(portctrl, Avr8xPortGroup),
+        VMSTATE_UINT8(pinconfig, Avr8xPortGroup),
+        VMSTATE_UINT8_ARRAY(pinctrl, Avr8xPortGroup, AVR8X_PORT_PINS),
+        VMSTATE_UINT8(evgenctrl, Avr8xPortGroup),
+        VMSTATE_UINT8(ext_mask, Avr8xPortGroup),
+        VMSTATE_UINT8(ext_level, Avr8xPortGroup),
+        VMSTATE_UINT8(per_mask, Avr8xPortGroup),
+        VMSTATE_UINT8(per_level, Avr8xPortGroup),
+        VMSTATE_UINT8(in_last, Avr8xPortGroup),
+        VMSTATE_UINT8(pad_mask, Avr8xPortGroup),
+        VMSTATE_UINT8(pad_level, Avr8xPortGroup),
+        VMSTATE_INT64(acc_time, Avr8xPortGroup),
+        VMSTATE_UINT64_ARRAY(high_ns, Avr8xPortGroup, AVR8X_PORT_PINS),
+        VMSTATE_UINT64_ARRAY(low_ns, Avr8xPortGroup, AVR8X_PORT_PINS),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const VMStateDescription vmstate_avr8x_port = {
+    .name = TYPE_AVR8X_PORT,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT_ARRAY(g, Avr8xPortState, AVR8X_PORT_GROUPS, 1,
+                             vmstate_avr8x_port_group, Avr8xPortGroup),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property avr8x_port_properties[] = {
+    DEFINE_PROP_UINT32("groups", Avr8xPortState, ngroups, 0),
+};
+
+static void avr8x_port_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = avr8x_port_realize;
+    dc->vmsd = &vmstate_avr8x_port;
+    device_class_set_props(dc, avr8x_port_properties);
+    rc->phases.hold = avr8x_port_reset_hold;
+    rc->phases.exit = avr8x_port_reset_exit;
+    /* Reason: part of an AVR8X SoC, mapped at its addresses */
+    dc->user_creatable = false;
+}
+
+static const TypeInfo avr8x_port_types[] = {
+    {
+        .name = TYPE_AVR8X_PORT,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(Avr8xPortState),
+        .instance_init = avr8x_port_init,
+        .class_init = avr8x_port_class_init,
+    },
+};
+
+DEFINE_TYPES(avr8x_port_types)
