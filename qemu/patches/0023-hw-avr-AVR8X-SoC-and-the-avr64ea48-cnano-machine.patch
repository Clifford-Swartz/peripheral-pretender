diff --git a/hw/char/avr8x_usart.c b/hw/char/avr8x_usart.c
new file mode 100644
index 0000000..c1b5514
--- /dev/null
+++ b/hw/char/avr8x_usart.c
@@ -0,0 +1,380 @@
+/*
+ * Microchip AVR8X USART (uart_autobd_v4: AVR Dx, AVR Ex), asynchronous mode
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Behaviour from DS40002324 (AVR64EA48), chapter USART. The register file
+ * comes from the generated tables (overlays/usart_uart_autobd_v4.yaml):
+ *  - TX: a one-character buffer (TXDATAL, DREIF) in front of the shift
+ *    register; TXCIF when the shift register empties with nothing queued.
+ *    With "pace-tx" each character takes its frame time at the baud rate
+ *    from BAUD and CLK_PER (the "gclk" clock input); otherwise it is sent
+ *    at once.
+ *  - RX: a two-character FIFO (RXDATAL/RXDATAH, RXCIF); a third character
+ *    sets BUFOVF and is lost.
+ *  - Interrupts: RXC (RXCIF & RXCIE), DRE (DREIF & DREIE), TXC (TXCIF &
+ *    TXCIE) on sysbus IRQ 0, 1 and 2, the instance's vectors in order.
+ * Not modelled: synchronous, IrDA, RS485, LIN/auto-baud, MPCM, open drain,
+ * loop-back and the start-of-frame detector; writes to their bits are
+ * logged.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "chardev/char-fe.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/char/avr8x_usart.h"
+#include "hw/mchp/gen/usart_uart_autobd_v4.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define AVR8X_USART_RX_DEPTH    2
+
+/* Control bits the model does not implement, per register */
+#define CTRLA_UNMODELLED  (R_MCHP_USART_CTRLA_RS485_MASK | \
+                           R_MCHP_USART_CTRLA_ABEIE_MASK | \
+                           R_MCHP_USART_CTRLA_LBME_MASK | \
+                           R_MCHP_USART_CTRLA_RXSIE_MASK)
+#define CTRLB_UNMODELLED  (R_MCHP_USART_CTRLB_MPCM_MASK | \
+                           R_MCHP_USART_CTRLB_ODME_MASK | \
+                           R_MCHP_USART_CTRLB_SFDEN_MASK)
+
+OBJECT_DECLARE_SIMPLE_TYPE(Avr8xUsartState, AVR8X_USART)
+
+struct Avr8xUsartState {
+    MchpRegBlock parent_obj;
+
+    CharFrontend chr;
+    bool pace_tx;
+    qemu_irq irq_dre;
+    qemu_irq irq_txc;
+    QEMUTimer *frame_timer;
+    guint watch_tag;
+
+    uint16_t tx_buf;
+    bool tx_buf_full;
+    uint16_t tx_shift;
+    bool tx_busy;
+    uint16_t rx_buf[AVR8X_USART_RX_DEPTH];  /* bit 8: DATA8, 15: BUFOVF */
+    uint8_t rx_count;
+    bool rx_overflow;
+};
+
+static MchpRegFile *avr8x_usart_rf(Avr8xUsartState *s)
+{
+    return &MCHP_REGBLOCK(s)->rf;
+}
+
+static uint8_t avr8x_usart_reg(Avr8xUsartState *s, hwaddr reg)
+{
+    return mchp_regfile_peek(avr8x_usart_rf(s), reg, 1);
+}
+
+static void avr8x_usart_set_flag(Avr8xUsartState *s, uint8_t mask)
+{
+    MchpRegFile *rf = avr8x_usart_rf(s);
+
+    mchp_regfile_poke(rf, A_MCHP_USART_STATUS, 1,
+                      mchp_regfile_peek(rf, A_MCHP_USART_STATUS, 1) | mask);
+}
+
+/* STATUS as read: the stored W1C flags plus the buffer states */
+static uint8_t avr8x_usart_status(Avr8xUsartState *s)
+{
+    uint8_t status = avr8x_usart_reg(s, A_MCHP_USART_STATUS) &
+                     ~(R_MCHP_USART_STATUS_DREIF_MASK |
+                       R_MCHP_USART_STATUS_RXCIF_MASK);
+
+    if (!s->tx_buf_full) {
+        status |= R_MCHP_USART_STATUS_DREIF_MASK;
+    }
+    if (s->rx_count) {
+        status |= R_MCHP_USART_STATUS_RXCIF_MASK;
+    }
+    return status;
+}
+
+/* The RXC level; DRE and TXC are set here too */
+static bool avr8x_usart_irq_pending(MchpRegBlock *rb)
+{
+    Avr8xUsartState *s = AVR8X_USART(rb);
+    uint8_t status = avr8x_usart_status(s);
+    uint8_t ctrla = avr8x_usart_reg(s, A_MCHP_USART_CTRLA);
+
+    qemu_set_irq(s->irq_dre, status & ctrla & R_MCHP_USART_STATUS_DREIF_MASK);
+    qemu_set_irq(s->irq_txc, status & ctrla & R_MCHP_USART_STATUS_TXCIF_MASK);
+    return status & ctrla & R_MCHP_USART_STATUS_RXCIF_MASK;
+}
+
+/* Frame time in ns at the configured baud rate, 0 when not known */
+static uint64_t avr8x_usart_frame_ns(Avr8xUsartState *s)
+{
+    uint64_t fper = clock_get_hz(MCHP_REGBLOCK(s)->gclk);
+    uint16_t baud = avr8x_usart_reg(s, A_MCHP_USART_BAUD) |
+                    avr8x_usart_reg(s, A_MCHP_USART_BAUD + 1) << 8;
+    uint8_t ctrlb = avr8x_usart_reg(s, A_MCHP_USART_CTRLB);
+    uint8_t ctrlc = avr8x_usart_reg(s, A_MCHP_USART_CTRLC);
+    unsigned samples = FIELD_EX8(ctrlb, MCHP_USART_CTRLB, RXMODE) ==
+                       MCHP_USART_CTRLB_RXMODE_CLK2X ? 8 : 16;
+    unsigned chsize = FIELD_EX8(ctrlc, MCHP_USART_CTRLC_NORMAL, CHSIZE);
+    unsigned bits;
+
+    if (!fper || baud < 64) {
+        return 0;
+    }
+    /* Start, 5-9 data bits, parity, 1 or 2 stop bits */
+    bits = 1 + (chsize >= 4 ? 9 : 5 + chsize) +
+           (FIELD_EX8(ctrlc, MCHP_USART_CTRLC_NORMAL, PMODE) ? 1 : 0) +
+           1 + FIELD_EX8(ctrlc, MCHP_USART_CTRLC_NORMAL, SBMODE);
+    /* f_baud = 64 f_per / (S BAUD) */
+    return muldiv64(bits * samples * baud, NANOSECONDS_PER_SECOND, 64 * fper);
+}
+
+static void avr8x_usart_tx_load(Avr8xUsartState *s);
+
+static void avr8x_usart_tx_done(Avr8xUsartState *s)
+{
+    s->tx_busy = false;
+    if (s->tx_buf_full) {
+        avr8x_usart_tx_load(s);
+    } else {
+        avr8x_usart_set_flag(s, R_MCHP_USART_STATUS_TXCIF_MASK);
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void avr8x_usart_frame_end(void *opaque)
+{
+    avr8x_usart_tx_done(opaque);
+}
+
+static gboolean avr8x_usart_tx_send(void *do_not_use, GIOCondition cond,
+                                    void *opaque)
+{
+    Avr8xUsartState *s = opaque;
+    uint8_t ch = s->tx_shift;
+    uint64_t frame_ns;
+
+    s->watch_tag = 0;
+    if (qemu_chr_fe_write(&s->chr, &ch, 1) <= 0) {
+        s->watch_tag = qemu_chr_fe_add_watch(&s->chr, G_IO_OUT | G_IO_HUP,
+                                             avr8x_usart_tx_send, s);
+        if (s->watch_tag) {
+            return G_SOURCE_REMOVE;
+        }
+        /* No backend that could ever take it: the character is lost. */
+    }
+    trace_avr8x_usart_tx(MCHP_REGBLOCK(s)->name, ch);
+    frame_ns = s->pace_tx ? avr8x_usart_frame_ns(s) : 0;
+    if (frame_ns) {
+        timer_mod(s->frame_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + frame_ns);
+    } else {
+        avr8x_usart_tx_done(s);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void avr8x_usart_tx_load(Avr8xUsartState *s)
+{
+    s->tx_shift = s->tx_buf;
+    s->tx_buf_full = false;
+    s->tx_busy = true;
+    avr8x_usart_tx_send(NULL, 0, s);
+}
+
+static int avr8x_usart_can_receive(void *opaque)
+{
+    Avr8xUsartState *s = opaque;
+
+    if (!(avr8x_usart_reg(s, A_MCHP_USART_CTRLB) &
+          R_MCHP_USART_CTRLB_RXEN_MASK)) {
+        return 0;
+    }
+    return AVR8X_USART_RX_DEPTH - s->rx_count;
+}
+
+static void avr8x_usart_receive(void *opaque, const uint8_t *buf, int size)
+{
+    Avr8xUsartState *s = opaque;
+
+    for (int i = 0; i < size; i++) {
+        trace_avr8x_usart_rx(MCHP_REGBLOCK(s)->name, buf[i]);
+        if (s->rx_count == AVR8X_USART_RX_DEPTH) {
+            s->rx_overflow = true;
+            continue;
+        }
+        s->rx_buf[s->rx_count++] = buf[i] | (s->rx_overflow ? 0x8000 : 0);
+        s->rx_overflow = false;
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static uint32_t avr8x_usart_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                     unsigned idx, uint32_t stored,
+                                     bool side_effects)
+{
+    Avr8xUsartState *s = AVR8X_USART(rf->opaque);
+    uint16_t head = s->rx_count ? s->rx_buf[0] : 0;
+
+    switch (ri->offset) {
+    case A_MCHP_USART_RXDATAL:
+        if (side_effects && s->rx_count) {
+            s->rx_buf[0] = s->rx_buf[1];
+            s->rx_count--;
+            mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+            qemu_chr_fe_accept_input(&s->chr);
+        }
+        return head & 0xff;
+    case A_MCHP_USART_RXDATAH:
+        return (s->rx_count ? R_MCHP_USART_RXDATAH_RXCIF_MASK : 0) |
+               ((head >> 8) & R_MCHP_USART_RXDATAH_DATA8_MASK) |
+               (head & 0x8000 ? R_MCHP_USART_RXDATAH_BUFOVF_MASK : 0);
+    case A_MCHP_USART_STATUS:
+        return avr8x_usart_status(s);
+    }
+    return stored;
+}
+
+static void avr8x_usart_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                   unsigned idx, uint32_t old,
+                                   uint32_t written, uint32_t we)
+{
+    Avr8xUsartState *s = AVR8X_USART(rf->opaque);
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint8_t ctrlb = avr8x_usart_reg(s, A_MCHP_USART_CTRLB);
+
+    switch (ri->offset) {
+    case A_MCHP_USART_TXDATAL:
+        if (!(ctrlb & R_MCHP_USART_CTRLB_TXEN_MASK)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "%s.TXDATAL: write while TXEN "
+                          "is 0; character dropped\n", rb->name);
+            break;
+        }
+        if (s->tx_buf_full) {
+            qemu_log_mask(LOG_GUEST_ERROR, "%s.TXDATAL: write while DREIF "
+                          "is 0; character dropped\n", rb->name);
+            break;
+        }
+        s->tx_buf = written & 0xff;
+        s->tx_buf_full = true;
+        if (!s->tx_busy) {
+            avr8x_usart_tx_load(s);
+        }
+        break;
+    case A_MCHP_USART_CTRLA:
+        if (written & we & CTRLA_UNMODELLED) {
+            qemu_log_mask(LOG_UNIMP, "%s.CTRLA: write 0x%02x not modelled\n",
+                          rb->name, written & CTRLA_UNMODELLED);
+        }
+        break;
+    case A_MCHP_USART_CTRLB:
+        if (written & we & CTRLB_UNMODELLED) {
+            qemu_log_mask(LOG_UNIMP, "%s.CTRLB: write 0x%02x not modelled\n",
+                          rb->name, written & CTRLB_UNMODELLED);
+        }
+        if (!(ctrlb & R_MCHP_USART_CTRLB_RXEN_MASK)) {
+            s->rx_count = 0;            /* disabling RX flushes the FIFO */
+        } else if (!(old & R_MCHP_USART_CTRLB_RXEN_MASK)) {
+            qemu_chr_fe_accept_input(&s->chr);
+        }
+        break;
+    }
+}
+
+static void avr8x_usart_reset_hold(MchpRegBlock *rb)
+{
+    Avr8xUsartState *s = AVR8X_USART(rb);
+
+    timer_del(s->frame_timer);
+    s->tx_buf_full = false;
+    s->tx_busy = false;
+    s->rx_count = 0;
+    s->rx_overflow = false;
+}
+
+static bool avr8x_usart_realize(MchpRegBlock *rb, Error **errp)
+{
+    Avr8xUsartState *s = AVR8X_USART(rb);
+
+    s->frame_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, avr8x_usart_frame_end,
+                                  s);
+    qemu_chr_fe_set_handlers(&s->chr, avr8x_usart_can_receive,
+                             avr8x_usart_receive, NULL, NULL, s, NULL, true);
+    return true;
+}
+
+static void avr8x_usart_init(Object *obj)
+{
+    Avr8xUsartState *s = AVR8X_USART(obj);
+
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq_dre);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq_txc);
+}
+
+static void avr8x_usart_finalize(Object *obj)
+{
+    Avr8xUsartState *s = AVR8X_USART(obj);
+
+    g_clear_handle_id(&s->watch_tag, g_source_remove);
+    timer_free(s->frame_timer);
+}
+
+static const VMStateDescription vmstate_avr8x_usart = {
+    .name = TYPE_AVR8X_USART,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, Avr8xUsartState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_UINT16(tx_buf, Avr8xUsartState),
+        VMSTATE_BOOL(tx_buf_full, Avr8xUsartState),
+        VMSTATE_UINT16(tx_shift, Avr8xUsartState),
+        VMSTATE_BOOL(tx_busy, Avr8xUsartState),
+        VMSTATE_TIMER_PTR(frame_timer, Avr8xUsartState),
+        VMSTATE_UINT16_ARRAY(rx_buf, Avr8xUsartState, AVR8X_USART_RX_DEPTH),
+        VMSTATE_UINT8(rx_count, Avr8xUsartState),
+        VMSTATE_BOOL(rx_overflow, Avr8xUsartState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property avr8x_usart_properties[] = {
+    DEFINE_PROP_CHR("chardev", Avr8xUsartState, chr),
+    DEFINE_PROP_BOOL("pace-tx", Avr8xUsartState, pace_tx, false),
+};
+
+static void avr8x_usart_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    dc->vmsd = &vmstate_avr8x_usart;
+    device_class_set_props(dc, avr8x_usart_properties);
+    c->realize = avr8x_usart_realize;
+    c->pre_read = avr8x_usart_pre_read;
+    c->post_write = avr8x_usart_post_write;
+    c->irq_pending = avr8x_usart_irq_pending;
+    c->reset_hold = avr8x_usart_reset_hold;
+    c->is_enabled = avr8x_never_enabled;
+    c->log_writes = false;
+}
+
+static const TypeInfo avr8x_usart_types[] = {
+    {
+        .name = TYPE_AVR8X_USART,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(Avr8xUsartState),
+        .instance_init = avr8x_usart_init,
+        .instance_finalize = avr8x_usart_finalize,
+        .class_init = avr8x_usart_class_init,
+    },
+};
+
+DEFINE_TYPES(avr8x_usart_types)
