diff --git a/include/hw/avr/avr8x_periph.h b/include/hw/avr/avr8x_periph.h
new file mode 100644
index 0000000..4511fb4
--- /dev/null
+++ b/include/hw/avr/avr8x_periph.h
@@ -0,0 +1,48 @@
+/*
+ * Microchip AVR8X system blocks: CLKCTRL, CPUINT, NVMCTRL and the
+ * NVM-backed byte blocks (SIGROW, SYSCFG, USERROW, FUSE, LOCK)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * All are mchp-regblock subclasses built from the generated tables.
+ *
+ * avr8x-clkctrl: clock output "clk_per" (CLK_PER = CLK_MAIN / prescaler);
+ *   properties "oschf-hz" (internal high-frequency oscillator) and
+ *   "xoschf-hz" (external clock or crystal on XTALHF, 0: none).
+ * avr8x-cpuint: link "cpu" to the AVRxt CPU, which holds the interrupt
+ *   level state; property "boot-size" (bytes, from FUSE.BOOTSIZE).
+ * avr8x-nvmctrl: GPIO out "flmap": the flash section mapped into the data
+ *   space (NVMCTRL.CTRLB.FLMAP).
+ * avr8x-nvmbytes: registers that read NVM contents; their reset values
+ *   come from avr8x_nvmbytes_set_image().
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_AVR_AVR8X_PERIPH_H
+#define HW_AVR_AVR8X_PERIPH_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_AVR8X_CLKCTRL  "avr8x-clkctrl"
+#define TYPE_AVR8X_CPUINT   "avr8x-cpuint"
+#define TYPE_AVR8X_NVMCTRL  "avr8x-nvmctrl"
+#define TYPE_AVR8X_NVMBYTES "avr8x-nvmbytes"
+
+#define AVR8X_NVMCTRL_FLMAP "flmap"
+
+/* AVR8X blocks have no enable-protected registers */
+static inline bool avr8x_never_enabled(MchpRegFile *rf)
+{
+    return false;
+}
+
+/*
+ * Reset contents of an avr8x-nvmbytes block: @len bytes from offset 0
+ * (copied). Call before realize.
+ */
+void avr8x_nvmbytes_set_image(DeviceState *dev, const uint8_t *bytes,
+                              unsigned len);
+
+#endif /* HW_AVR_AVR8X_PERIPH_H */
diff --git a/include/hw/avr/avr8x_soc.h b/include/hw/avr/avr8x_soc.h
new file mode 100644
index 0000000..0faf202
--- /dev/null
+++ b/include/hw/avr/avr8x_soc.h
@@ -0,0 +1,81 @@
+/*
+ * Microchip AVR8X SoCs (AVRxt core: AVR Dx, AVR Ex, ...)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Built from a generated MchpAvrDeviceInfo (hw/avr/<device>_device.h):
+ * flash in the program space (address OFFSET_CODE) and, through NVMCTRL
+ * FLMAP, in the data space; SRAM, EEPROM, the I/O registers as one
+ * mchp-regblock (or dedicated model) per instance, and an AVRxt CPU whose
+ * interrupt inputs are the vector numbers.
+ *
+ * Child "port" (avr8x-port) has every pad; the board wires LEDs, buttons
+ * and Click boards to its "pad"/"port-in" GPIOs.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_AVR_AVR8X_SOC_H
+#define HW_AVR_AVR8X_SOC_H
+
+#include "hw/core/sysbus.h"
+#include "hw/gpio/avr8x_port.h"
+#include "hw/mchp/mchp_device.h"
+#include "qom/object.h"
+#include "target/avr/cpu.h"
+
+#define TYPE_AVR8X_SOC "avr8x-soc"
+OBJECT_DECLARE_TYPE(Avr8xSocState, Avr8xSocClass, AVR8X_SOC)
+
+#define TYPE_AVR64EA48_SOC "avr64ea48-soc"
+
+/* Generated device descriptors, one translation unit each */
+extern const MchpAvrDeviceInfo *const avr64ea48_info;
+
+#define AVR8X_MAX_USART     8
+
+/* avr-gcc puts .eeprom at this data-space offset in ELF files */
+#define AVR8X_ELF_EEPROM    0x10000
+
+struct Avr8xSocClass {
+    SysBusDeviceClass parent_class;
+
+    const MchpAvrDeviceInfo *dev;
+};
+
+struct Avr8xSocState {
+    SysBusDevice parent_obj;
+
+    const MchpAvrDeviceInfo *dev;
+    AVRCPU cpu;
+    Avr8xPortState port;
+    /* Models by instance index; NULL for CPU, PORT and VPORT */
+    DeviceState **periph;
+    Chardev *usart_chr[AVR8X_MAX_USART];
+
+    MemoryRegion flash;
+    MemoryRegion flash_map;         /* FLMAP window in the data space */
+    MemoryRegion sram;
+    MemoryRegion eeprom;
+    MemoryRegion eeprom_elf;        /* ELF .eeprom load address */
+    MemoryRegion ccp;
+    uint8_t ccp_value;
+
+    char *silicon_rev;
+    uint32_t xoschf_hz;
+};
+
+/*
+ * Attach @chr to USART@usart; call before realize.
+ */
+void avr8x_soc_connect_serial(Avr8xSocState *s, unsigned usart,
+                              Chardev *chr);
+
+/* The model of ATDF instance @name (e.g. "SPI0"), or NULL */
+DeviceState *avr8x_soc_periph(Avr8xSocState *s, const char *name);
+
+/* The flash memory region (for the firmware loader) */
+MemoryRegion *avr8x_soc_flash(Avr8xSocState *s);
+
+#endif /* HW_AVR_AVR8X_SOC_H */
