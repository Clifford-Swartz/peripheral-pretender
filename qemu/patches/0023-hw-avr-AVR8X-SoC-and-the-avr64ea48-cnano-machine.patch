diff --git a/hw/avr/avr64ea48_cnano.c b/hw/avr/avr64ea48_cnano.c
new file mode 100644
index 0000000..e190f21
--- /dev/null
+++ b/hw/avr/avr64ea48_cnano.c
@@ -0,0 +1,140 @@
+/*
+ * Microchip AVR64EA48 Curiosity Nano (EV66E56A)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * AVR64EA48 (TQFP48) with LED0 on PB3 (yellow, to VCC through 1 kOhm,
+ * active low), SW0 on PB2 (to ground, no external pull-up) and the
+ * debugger's virtual COM port on USART1 (PC0 TX, PC1 RX). The 32.768 kHz
+ * crystal (PF0/PF1) and the 20 MHz crystal (PA0/PA1) are fitted.
+ * Board user guide DS50003494A, Tables 4-1 to 4-5; schematic rev 3.
+ *
+ * serial_hd(0) is the virtual COM port, serial_hd(1) USART2 (PF4/PF5,
+ * the UART of mikroBUS sockets 1 and 3 on a Curiosity Nano Base).
+ * The firmware comes from -kernel or -bios (ELF or raw binary).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "hw/avr/avr8x_soc.h"
+#include "hw/core/boards.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/misc/led.h"
+#include "system/qtest.h"
+#include "system/system.h"
+#include "boot.h"
+
+#define CNANO_XOSCHF_HZ     20000000
+
+#define AVR8X_PIN(g, n)     (((g) - 'A') * AVR8X_PORT_PINS + (n))
+#define CNANO_LED0_PIN      AVR8X_PIN('B', 3)
+#define CNANO_SW0_PIN       AVR8X_PIN('B', 2)
+
+#define TYPE_AVR64EA48_CNANO_MACHINE MACHINE_TYPE_NAME("avr64ea48-cnano")
+OBJECT_DECLARE_SIMPLE_TYPE(Avr64ea48CnanoState, AVR64EA48_CNANO_MACHINE)
+
+struct Avr64ea48CnanoState {
+    MachineState parent_obj;
+
+    Avr8xSocState soc;
+    LEDState *led0;
+    qemu_irq sw0;
+    bool sw0_pressed;
+};
+
+/* A pressed SW0 pulls PB2 low; a released one leaves the pad undriven. */
+static void avr64ea48_cnano_update_sw0(Avr64ea48CnanoState *s)
+{
+    if (s->sw0) {
+        qemu_set_irq(s->sw0, s->sw0_pressed ? 0 : -1);
+    }
+}
+
+static bool avr64ea48_cnano_get_sw0(Object *obj, Error **errp)
+{
+    return AVR64EA48_CNANO_MACHINE(obj)->sw0_pressed;
+}
+
+static void avr64ea48_cnano_set_sw0(Object *obj, bool value, Error **errp)
+{
+    Avr64ea48CnanoState *s = AVR64EA48_CNANO_MACHINE(obj);
+
+    s->sw0_pressed = value;
+    avr64ea48_cnano_update_sw0(s);
+}
+
+static void avr64ea48_cnano_init(MachineState *machine)
+{
+    Avr64ea48CnanoState *s = AVR64EA48_CNANO_MACHINE(machine);
+    const char *firmware = machine->kernel_filename ?: machine->firmware;
+    DeviceState *soc, *port;
+
+    object_initialize_child(OBJECT(machine), "soc", &s->soc,
+                            TYPE_AVR64EA48_SOC);
+    soc = DEVICE(&s->soc);
+    qdev_prop_set_uint32(soc, "xoschf-hz", CNANO_XOSCHF_HZ);
+    avr8x_soc_connect_serial(&s->soc, 1, serial_hd(0));
+    avr8x_soc_connect_serial(&s->soc, 2, serial_hd(1));
+    sysbus_realize(SYS_BUS_DEVICE(soc), &error_fatal);
+
+    port = DEVICE(&s->soc.port);
+    s->led0 = led_create_simple(OBJECT(machine), GPIO_POLARITY_ACTIVE_LOW,
+                                LED_COLOR_YELLOW, "LED0");
+    qdev_connect_gpio_out_named(port, AVR8X_PORT_PAD, CNANO_LED0_PIN,
+                                qdev_get_gpio_in(DEVICE(s->led0), 0));
+    /* The LED from VCC pulls its pad high while nothing drives it */
+    qemu_set_irq(qdev_get_gpio_in_named(port, AVR8X_PORT_IN, CNANO_LED0_PIN),
+                 1);
+    s->sw0 = qdev_get_gpio_in_named(port, AVR8X_PORT_IN, CNANO_SW0_PIN);
+    avr64ea48_cnano_update_sw0(s);
+
+    if (!firmware) {
+        /* qom-test and friends start machines without firmware */
+        if (!qtest_enabled()) {
+            warn_report("avr64ea48-cnano: no firmware (use -kernel or "
+                        "-bios); the flash is empty");
+        }
+        return;
+    }
+    if (!avr_load_firmware(&s->soc.cpu, machine, avr8x_soc_flash(&s->soc),
+                           firmware)) {
+        exit(1);
+    }
+}
+
+static void avr64ea48_cnano_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "Microchip AVR64EA48 Curiosity Nano (EV66E56A, AVRxt)";
+    mc->init = avr64ea48_cnano_init;
+    mc->default_cpus = 1;
+    mc->min_cpus = 1;
+    mc->max_cpus = 1;
+    mc->no_floppy = 1;
+    mc->no_cdrom = 1;
+    mc->no_parallel = 1;
+    /* SRAM is part of the SoC */
+    mc->default_ram_size = 0;
+    object_class_property_add_bool(oc, "sw0-pressed",
+                                   avr64ea48_cnano_get_sw0,
+                                   avr64ea48_cnano_set_sw0);
+    object_class_property_set_description(oc, "sw0-pressed",
+                                          "Hold user switch SW0 (PB2) down");
+}
+
+static const TypeInfo avr64ea48_cnano_types[] = {
+    {
+        .name = TYPE_AVR64EA48_CNANO_MACHINE,
+        .parent = TYPE_MACHINE,
+        .instance_size = sizeof(Avr64ea48CnanoState),
+        .class_init = avr64ea48_cnano_class_init,
+    },
+};
+
+DEFINE_TYPES(avr64ea48_cnano_types)
diff --git a/hw/avr/avr8x_periph.c b/hw/avr/avr8x_periph.c
new file mode 100644
index 0000000..38a7d2e
--- /dev/null
+++ b/hw/avr/avr8x_periph.c
@@ -0,0 +1,415 @@
+/*
+ * Microchip AVR8X system blocks: CLKCTRL, CPUINT, NVMCTRL and the
+ * NVM-backed byte blocks (SIGROW, SYSCFG, USERROW, FUSE, LOCK)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Behaviour from DS40002324 (AVR64EA48), chapters CLKCTRL, CPUINT and
+ * NVMCTRL; register files from the generated tables.
+ *
+ * CLKCTRL: CLK_MAIN from MCLKCTRLA.CLKSEL (OSCHF, OSC32K, XOSC32K, EXTCLK)
+ * divided by MCLKCTRLB.PDIV when PEN is set, on the "clk_per" output.
+ * Oscillators are stable as soon as they are enabled (MCLKSTATUS).
+ * Not modelled: clock failure detection, auto-tune, CLKOUT, start-up
+ * times and the CCP protection of the registers.
+ *
+ * CPUINT: the registers mirror the AVRxt CPU's interrupt state, which
+ * target/avr uses to take interrupts (levels, LVL1VEC, LVL0PRI with round
+ * robin, IVSEL). Not modelled: the compact vector table (CVT), NMI.
+ *
+ * NVMCTRL: CTRLB.FLMAP selects the flash section in the data space ("flmap"
+ * output). Commands (CTRLA.CMD: page buffer, erase, write) are not
+ * modelled and are logged; STATUS always reads ready.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qapi/error.h"
+#include "hw/avr/avr8x_periph.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/mchp/gen/clkctrl_avrea.h"
+#include "hw/mchp/gen/cpuint_int_8bit_v3.h"
+#include "hw/mchp/gen/nvmctrl_nvm_ctrl_avr_v3.h"
+#include "migration/vmstate.h"
+#include "target/avr/cpu.h"
+
+#define AVR8X_OSC32K_HZ     32768
+
+/* ---------------------------------------------------------------- CLKCTRL */
+
+OBJECT_DECLARE_SIMPLE_TYPE(Avr8xClkctrlState, AVR8X_CLKCTRL)
+
+struct Avr8xClkctrlState {
+    MchpRegBlock parent_obj;
+
+    Clock *clk_per;
+    uint32_t oschf_hz;
+    uint32_t xoschf_hz;
+};
+
+static uint8_t avr8x_clkctrl_reg(Avr8xClkctrlState *s, hwaddr reg)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, reg, 1);
+}
+
+static uint64_t avr8x_clkctrl_main_hz(Avr8xClkctrlState *s)
+{
+    uint8_t a = avr8x_clkctrl_reg(s, A_MCHP_CLKCTRL_MCLKCTRLA);
+
+    switch (FIELD_EX8(a, MCHP_CLKCTRL_MCLKCTRLA, CLKSEL)) {
+    case 0:
+        return s->oschf_hz;
+    case 1:
+        return AVR8X_OSC32K_HZ;
+    case 2:
+        return AVR8X_OSC32K_HZ;         /* the 32.768 kHz crystal */
+    case 3:
+        return s->xoschf_hz;
+    default:
+        return 0;
+    }
+}
+
+static unsigned avr8x_clkctrl_div(uint8_t b)
+{
+    static const uint8_t div[16] = {
+        2, 4, 8, 16, 32, 64, 0, 0, 6, 10, 12, 24, 48, 0, 0, 0,
+    };
+
+    if (!FIELD_EX8(b, MCHP_CLKCTRL_MCLKCTRLB, PEN)) {
+        return 1;
+    }
+    return div[FIELD_EX8(b, MCHP_CLKCTRL_MCLKCTRLB, PDIV)];
+}
+
+static void avr8x_clkctrl_update(Avr8xClkctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint8_t b = avr8x_clkctrl_reg(s, A_MCHP_CLKCTRL_MCLKCTRLB);
+    unsigned div = avr8x_clkctrl_div(b);
+    uint64_t hz = avr8x_clkctrl_main_hz(s);
+
+    if (!div) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.MCLKCTRLB: reserved PDIV 0x%x\n",
+                      rb->name, FIELD_EX8(b, MCHP_CLKCTRL_MCLKCTRLB, PDIV));
+        div = 1;
+    }
+    if (!hz) {
+        qemu_log_mask(LOG_UNIMP, "%s: main clock source has no frequency "
+                      "on this board\n", rb->name);
+    }
+    mchp_regblock_set_clock(rb, s->clk_per, hz / div);
+}
+
+static uint32_t avr8x_clkctrl_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                       unsigned idx, uint32_t stored,
+                                       bool side_effects)
+{
+    Avr8xClkctrlState *s = AVR8X_CLKCTRL(rf->opaque);
+    uint8_t x32 = avr8x_clkctrl_reg(s, A_MCHP_CLKCTRL_XOSC32KCTRLA);
+    uint8_t xhf = avr8x_clkctrl_reg(s, A_MCHP_CLKCTRL_XOSCHFCTRLA);
+
+    if (ri->offset != A_MCHP_CLKCTRL_MCLKSTATUS) {
+        return stored;
+    }
+    return R_MCHP_CLKCTRL_MCLKSTATUS_OSCHFS_MASK |
+           R_MCHP_CLKCTRL_MCLKSTATUS_OSC32KS_MASK |
+           (FIELD_EX8(x32, MCHP_CLKCTRL_XOSC32KCTRLA, ENABLE) ?
+            R_MCHP_CLKCTRL_MCLKSTATUS_XOSC32KS_MASK : 0) |
+           (FIELD_EX8(xhf, MCHP_CLKCTRL_XOSCHFCTRLA, ENABLE) && s->xoschf_hz ?
+            R_MCHP_CLKCTRL_MCLKSTATUS_EXTS_MASK : 0);
+}
+
+static void avr8x_clkctrl_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                     unsigned idx, uint32_t old,
+                                     uint32_t written, uint32_t we)
+{
+    avr8x_clkctrl_update(AVR8X_CLKCTRL(rf->opaque));
+}
+
+static void avr8x_clkctrl_reset_exit(MchpRegBlock *rb)
+{
+    avr8x_clkctrl_update(AVR8X_CLKCTRL(rb));
+}
+
+static void avr8x_clkctrl_init(Object *obj)
+{
+    Avr8xClkctrlState *s = AVR8X_CLKCTRL(obj);
+
+    s->clk_per = qdev_init_clock_out(DEVICE(obj), "clk_per");
+}
+
+static const VMStateDescription vmstate_avr8x_clkctrl = {
+    .name = TYPE_AVR8X_CLKCTRL,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, Avr8xClkctrlState, 1,
+                       vmstate_mchp_regblock, MchpRegBlock),
+        VMSTATE_CLOCK(clk_per, Avr8xClkctrlState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property avr8x_clkctrl_properties[] = {
+    DEFINE_PROP_UINT32("oschf-hz", Avr8xClkctrlState, oschf_hz, 20000000),
+    DEFINE_PROP_UINT32("xoschf-hz", Avr8xClkctrlState, xoschf_hz, 0),
+};
+
+static void avr8x_clkctrl_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    dc->vmsd = &vmstate_avr8x_clkctrl;
+    device_class_set_props(dc, avr8x_clkctrl_properties);
+    c->pre_read = avr8x_clkctrl_pre_read;
+    c->post_write = avr8x_clkctrl_post_write;
+    c->reset_exit = avr8x_clkctrl_reset_exit;
+    c->is_enabled = avr8x_never_enabled;
+    c->log_writes = false;
+}
+
+/* ----------------------------------------------------------------- CPUINT */
+
+OBJECT_DECLARE_SIMPLE_TYPE(Avr8xCpuintState, AVR8X_CPUINT)
+
+struct Avr8xCpuintState {
+    MchpRegBlock parent_obj;
+
+    AVRCPU *cpu;
+    uint32_t boot_size;
+};
+
+static uint32_t avr8x_cpuint_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                      unsigned idx, uint32_t stored,
+                                      bool side_effects)
+{
+    CPUAVRState *env = &AVR8X_CPUINT(rf->opaque)->cpu->env;
+
+    switch (ri->offset) {
+    case A_MCHP_CPUINT_CTRLA:
+        return env->cpuint_ctrla;
+    case A_MCHP_CPUINT_STATUS:
+        return env->cpuint_status;
+    case A_MCHP_CPUINT_LVL0PRI:
+        return env->cpuint_lvl0pri;
+    case A_MCHP_CPUINT_LVL1VEC:
+        return env->cpuint_lvl1vec;
+    }
+    return stored;
+}
+
+static void avr8x_cpuint_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                    unsigned idx, uint32_t old,
+                                    uint32_t written, uint32_t we)
+{
+    Avr8xCpuintState *s = AVR8X_CPUINT(rf->opaque);
+    CPUAVRState *env = &s->cpu->env;
+    uint8_t value = mchp_regfile_peek(rf, ri->offset, 1);
+
+    switch (ri->offset) {
+    case A_MCHP_CPUINT_CTRLA:
+        env->cpuint_ctrla = value;
+        env->vector_base = FIELD_EX8(value, MCHP_CPUINT_CTRLA, IVSEL) ?
+                           0 : s->boot_size;
+        if (FIELD_EX8(value, MCHP_CPUINT_CTRLA, CVT)) {
+            qemu_log_mask(LOG_UNIMP, "%s.CTRLA: compact vector table not "
+                          "modelled\n", MCHP_REGBLOCK(s)->name);
+        }
+        break;
+    case A_MCHP_CPUINT_LVL0PRI:
+        env->cpuint_lvl0pri = value;
+        break;
+    case A_MCHP_CPUINT_LVL1VEC:
+        env->cpuint_lvl1vec = value;
+        break;
+    }
+}
+
+static void avr8x_cpuint_reset_hold(MchpRegBlock *rb)
+{
+    Avr8xCpuintState *s = AVR8X_CPUINT(rb);
+
+    /* The CPU resets its copy; IVSEL 0 puts the vectors after BOOT */
+    s->cpu->env.vector_base = s->boot_size;
+}
+
+static bool avr8x_cpuint_realize(MchpRegBlock *rb, Error **errp)
+{
+    if (!AVR8X_CPUINT(rb)->cpu) {
+        error_setg(errp, "%s: link \"cpu\" not set", rb->name);
+        return false;
+    }
+    return true;
+}
+
+static const Property avr8x_cpuint_properties[] = {
+    DEFINE_PROP_LINK("cpu", Avr8xCpuintState, cpu, TYPE_AVR_CPU, AVRCPU *),
+    DEFINE_PROP_UINT32("boot-size", Avr8xCpuintState, boot_size, 0),
+};
+
+static void avr8x_cpuint_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    device_class_set_props(dc, avr8x_cpuint_properties);
+    c->realize = avr8x_cpuint_realize;
+    c->pre_read = avr8x_cpuint_pre_read;
+    c->post_write = avr8x_cpuint_post_write;
+    c->reset_hold = avr8x_cpuint_reset_hold;
+    c->is_enabled = avr8x_never_enabled;
+    c->log_writes = false;
+}
+
+/* ---------------------------------------------------------------- NVMCTRL */
+
+OBJECT_DECLARE_SIMPLE_TYPE(Avr8xNvmctrlState, AVR8X_NVMCTRL)
+
+struct Avr8xNvmctrlState {
+    MchpRegBlock parent_obj;
+
+    qemu_irq flmap;
+};
+
+static void avr8x_nvmctrl_update(Avr8xNvmctrlState *s)
+{
+    uint8_t b = mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf,
+                                  A_MCHP_NVMCTRL_CTRLB, 1);
+
+    qemu_set_irq(s->flmap, FIELD_EX8(b, MCHP_NVMCTRL_CTRLB, FLMAP));
+}
+
+static void avr8x_nvmctrl_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                     unsigned idx, uint32_t old,
+                                     uint32_t written, uint32_t we)
+{
+    Avr8xNvmctrlState *s = AVR8X_NVMCTRL(rf->opaque);
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint8_t cmd = FIELD_EX8(written, MCHP_NVMCTRL_CTRLA, CMD);
+
+    if (ri->offset == A_MCHP_NVMCTRL_CTRLA && cmd) {
+        qemu_log_mask(LOG_UNIMP, "%s.CTRLA: command 0x%02x not modelled\n",
+                      rb->name, cmd);
+    } else if (ri->offset == A_MCHP_NVMCTRL_CTRLB) {
+        if (FIELD_EX8(old, MCHP_NVMCTRL_CTRLB, FLMAPLOCK)) {
+            /* FLMAP is locked until reset */
+            mchp_regfile_poke(rf, A_MCHP_NVMCTRL_CTRLB, 1,
+                              deposit32(mchp_regfile_peek(rf, ri->offset, 1),
+                                        R_MCHP_NVMCTRL_CTRLB_FLMAP_SHIFT,
+                                        R_MCHP_NVMCTRL_CTRLB_FLMAP_LENGTH,
+                                        FIELD_EX8(old, MCHP_NVMCTRL_CTRLB,
+                                                  FLMAP)) |
+                              R_MCHP_NVMCTRL_CTRLB_FLMAPLOCK_MASK);
+        }
+        if ((written & we) & (R_MCHP_NVMCTRL_CTRLB_APPCODEWP_MASK |
+                              R_MCHP_NVMCTRL_CTRLB_BOOTRP_MASK |
+                              R_MCHP_NVMCTRL_CTRLB_APPDATAWP_MASK |
+                              R_MCHP_NVMCTRL_CTRLB_EEWP_MASK)) {
+            qemu_log_mask(LOG_UNIMP, "%s.CTRLB: write protection 0x%02x not "
+                          "modelled\n", rb->name, (uint8_t)written);
+        }
+        avr8x_nvmctrl_update(s);
+    }
+}
+
+static void avr8x_nvmctrl_reset_exit(MchpRegBlock *rb)
+{
+    avr8x_nvmctrl_update(AVR8X_NVMCTRL(rb));
+}
+
+static void avr8x_nvmctrl_init(Object *obj)
+{
+    Avr8xNvmctrlState *s = AVR8X_NVMCTRL(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), &s->flmap, AVR8X_NVMCTRL_FLMAP, 1);
+}
+
+static void avr8x_nvmctrl_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    c->post_write = avr8x_nvmctrl_post_write;
+    c->reset_exit = avr8x_nvmctrl_reset_exit;
+    c->is_enabled = avr8x_never_enabled;
+    c->log_writes = false;
+}
+
+/* --------------------------------------------------------------- NVMBYTES */
+
+OBJECT_DECLARE_SIMPLE_TYPE(Avr8xNvmbytesState, AVR8X_NVMBYTES)
+
+struct Avr8xNvmbytesState {
+    MchpRegBlock parent_obj;
+
+    uint8_t *image;
+    unsigned len;
+};
+
+void avr8x_nvmbytes_set_image(DeviceState *dev, const uint8_t *bytes,
+                              unsigned len)
+{
+    Avr8xNvmbytesState *s = AVR8X_NVMBYTES(dev);
+
+    assert(!dev->realized);
+    g_free(s->image);
+    s->image = g_memdup2(bytes, len);
+    s->len = len;
+}
+
+static void avr8x_nvmbytes_reset_hold(MchpRegBlock *rb)
+{
+    Avr8xNvmbytesState *s = AVR8X_NVMBYTES(rb);
+
+    for (unsigned i = 0; i < s->len && i < rb->rf.size; i++) {
+        mchp_regfile_poke(&rb->rf, i, 1, s->image[i]);
+    }
+}
+
+static void avr8x_nvmbytes_finalize(Object *obj)
+{
+    g_free(AVR8X_NVMBYTES(obj)->image);
+}
+
+static void avr8x_nvmbytes_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    c->reset_hold = avr8x_nvmbytes_reset_hold;
+    c->is_enabled = avr8x_never_enabled;
+}
+
+static const TypeInfo avr8x_periph_types[] = {
+    {
+        .name = TYPE_AVR8X_CLKCTRL,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(Avr8xClkctrlState),
+        .instance_init = avr8x_clkctrl_init,
+        .class_init = avr8x_clkctrl_class_init,
+    }, {
+        .name = TYPE_AVR8X_CPUINT,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(Avr8xCpuintState),
+        .class_init = avr8x_cpuint_class_init,
+    }, {
+        .name = TYPE_AVR8X_NVMCTRL,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(Avr8xNvmctrlState),
+        .instance_init = avr8x_nvmctrl_init,
+        .class_init = avr8x_nvmctrl_class_init,
+    }, {
+        .name = TYPE_AVR8X_NVMBYTES,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(Avr8xNvmbytesState),
+        .instance_finalize = avr8x_nvmbytes_finalize,
+        .class_init = avr8x_nvmbytes_class_init,
+    },
+};
+
+DEFINE_TYPES(avr8x_periph_types)
diff --git a/hw/avr/avr8x_soc.c b/hw/avr/avr8x_soc.c
new file mode 100644
index 0000000..cab02df
--- /dev/null
+++ b/hw/avr/avr8x_soc.c
@@ -0,0 +1,464 @@
+/*
+ * Microchip AVR8X SoCs (AVRxt core: AVR Dx, AVR Ex, ...)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Everything comes from the generated device descriptor: the memory map,
+ * one mchp-regblock (or dedicated subclass, see avr8x_models) per
+ * peripheral instance and the interrupt vectors of each instance. Adding
+ * a device takes its descriptor file (hw/avr/<device>.c) and an entry in
+ * avr8x_soc_types[].
+ *
+ * Data space (DS40002324, Memory Map): I/O registers from 0, NVM-backed
+ * rows (fuses, user row, signature row), EEPROM, SRAM and a 32 KB window
+ * on the flash that NVMCTRL.CTRLB.FLMAP selects. The CPU sees the data
+ * space at OFFSET_DATA and the flash at OFFSET_CODE. CCP (CPU.CCP) is
+ * stored, but protected registers accept writes without it.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "hw/avr/avr8x_soc.h"
+#include "hw/avr/avr8x_periph.h"
+#include "hw/char/avr8x_usart.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/misc/unimp.h"
+#include "system/address-spaces.h"
+
+/*
+ * The QOM type modelling each ATDF module. Every other instance is a
+ * generic mchp-regblock; a dedicated model only needs a line here.
+ */
+static const struct {
+    const char *module;
+    const char *type;
+} avr8x_models[] = {
+    { "CLKCTRL", TYPE_AVR8X_CLKCTRL },
+    { "CPUINT", TYPE_AVR8X_CPUINT },
+    { "FUSE", TYPE_AVR8X_NVMBYTES },
+    { "LOCK", TYPE_AVR8X_NVMBYTES },
+    { "NVMCTRL", TYPE_AVR8X_NVMCTRL },
+    { "SIGROW", TYPE_AVR8X_NVMBYTES },
+    { "SYSCFG", TYPE_AVR8X_NVMBYTES },
+    { "USART", TYPE_AVR8X_USART },
+    { "USERROW", TYPE_AVR8X_NVMBYTES },
+};
+
+static const char *avr8x_model_type(const MchpInstanceInfo *info)
+{
+    for (unsigned i = 0; i < ARRAY_SIZE(avr8x_models); i++) {
+        if (!strcmp(avr8x_models[i].module, info->module)) {
+            return avr8x_models[i].type;
+        }
+    }
+    return TYPE_MCHP_REGBLOCK;
+}
+
+/* PORT and VPORT instances are groups of the one avr8x-port device */
+static int avr8x_port_group(const MchpInstanceInfo *info)
+{
+    const char *name = info->name;
+
+    if (!strcmp(info->module, "VPORT")) {
+        name++;
+    } else if (strcmp(info->module, "PORT")) {
+        return -1;
+    }
+    return name[4] - 'A';
+}
+
+static bool avr8x_has_model(const MchpInstanceInfo *info)
+{
+    return !(info->flags & (MCHP_INST_CORE | MCHP_INST_NO_REGS)) &&
+           info->regs && info->slot_size && avr8x_port_group(info) < 0;
+}
+
+DeviceState *avr8x_soc_periph(Avr8xSocState *s, const char *name)
+{
+    for (unsigned i = 0; i < s->dev->ninstances; i++) {
+        if (!strcmp(s->dev->instances[i].name, name)) {
+            return s->periph[i];
+        }
+    }
+    return NULL;
+}
+
+MemoryRegion *avr8x_soc_flash(Avr8xSocState *s)
+{
+    return &s->flash;
+}
+
+void avr8x_soc_connect_serial(Avr8xSocState *s, unsigned usart, Chardev *chr)
+{
+    assert(usart < AVR8X_MAX_USART);
+    s->usart_chr[usart] = chr;
+}
+
+static void avr8x_soc_init(Object *obj)
+{
+    Avr8xSocState *s = AVR8X_SOC(obj);
+    const MchpAvrDeviceInfo *dev = AVR8X_SOC_GET_CLASS(obj)->dev;
+
+    s->dev = dev;
+    s->periph = g_new0(DeviceState *, dev->ninstances);
+    object_initialize_child(obj, "cpu", &s->cpu, AVR_CPU_TYPE_NAME("avrxt"));
+    object_initialize_child(obj, "port", &s->port, TYPE_AVR8X_PORT);
+
+    for (unsigned i = 0; i < dev->ninstances; i++) {
+        const MchpInstanceInfo *info = &dev->instances[i];
+        g_autofree char *name = g_ascii_strdown(info->name, -1);
+        Object *child;
+
+        if (!avr8x_has_model(info)) {
+            continue;
+        }
+        child = object_new(avr8x_model_type(info));
+        object_property_add_child(obj, name, child);
+        object_unref(child);
+        mchp_regblock_set_info(MCHP_REGBLOCK(child), info);
+        s->periph[i] = DEVICE(child);
+    }
+}
+
+static void avr8x_soc_finalize(Object *obj)
+{
+    g_free(AVR8X_SOC(obj)->periph);
+}
+
+static bool avr8x_revision(Avr8xSocState *s, uint8_t *rev, Error **errp)
+{
+    const MchpAvrDeviceInfo *dev = s->dev;
+
+    if (!s->silicon_rev) {
+        *rev = dev->revisions[0].revision;
+        return true;
+    }
+    for (unsigned i = 0; i < dev->nrevisions; i++) {
+        if (!g_ascii_strcasecmp(s->silicon_rev, dev->revisions[i].name)) {
+            *rev = dev->revisions[i].revision;
+            return true;
+        }
+    }
+    error_setg(errp, "%s: unknown silicon-rev '%s'", dev->name,
+               s->silicon_rev);
+    return false;
+}
+
+/* The bytes of data rows that fall into [@base, @base + @len) */
+static void avr8x_apply_rows(Avr8xSocState *s, uint8_t *buf, uint32_t base,
+                             uint32_t len)
+{
+    for (unsigned r = 0; r < s->dev->ndata_rows; r++) {
+        const MchpAvrDataRow *row = &s->dev->data_rows[r];
+
+        for (unsigned i = 0; i < row->len; i++) {
+            if (row->addr + i >= base && row->addr + i < base + len) {
+                buf[row->addr + i - base] = row->bytes[i];
+            }
+        }
+    }
+}
+
+/* EEPROM writes go through NVMCTRL commands, which are not modelled */
+static void avr8x_eeprom_write(void *opaque, hwaddr addr, uint64_t val,
+                               unsigned size)
+{
+    qemu_log_mask(LOG_UNIMP, "eeprom: write 0x%02" PRIx64 " at 0x%04"
+                  HWADDR_PRIx " not modelled (NVMCTRL commands)\n", val, addr);
+}
+
+static const MemoryRegionOps avr8x_eeprom_ops = {
+    .write = avr8x_eeprom_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+};
+
+static uint64_t avr8x_ccp_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return AVR8X_SOC(opaque)->ccp_value;
+}
+
+static void avr8x_ccp_write(void *opaque, hwaddr addr, uint64_t val,
+                            unsigned size)
+{
+    /* Protected registers do not check CCP: writes always succeed */
+    AVR8X_SOC(opaque)->ccp_value = val;
+}
+
+static const MemoryRegionOps avr8x_ccp_ops = {
+    .read = avr8x_ccp_read,
+    .write = avr8x_ccp_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+};
+
+/* NVMCTRL "flmap": the flash section the data-space window shows */
+static void avr8x_set_flmap(void *opaque, int n, int section)
+{
+    Avr8xSocState *s = opaque;
+    uint32_t window = s->dev->progmem_map_size;
+    unsigned sections = MAX(s->dev->flash_size / window, 1);
+
+    memory_region_set_alias_offset(&s->flash_map,
+                                   (section % sections) * window);
+}
+
+static bool avr8x_init_memory(Avr8xSocState *s, Error **errp)
+{
+    const MchpAvrDeviceInfo *dev = s->dev;
+    MemoryRegion *sysmem = get_system_memory();
+    Object *obj = OBJECT(s);
+    g_autofree uint8_t *erased = NULL;
+
+    if (!memory_region_init_rom(&s->flash, obj, "flash", dev->flash_size,
+                                errp) ||
+        !memory_region_init_ram(&s->sram, obj, "sram", dev->sram_size,
+                                errp) ||
+        !memory_region_init_rom_device(&s->eeprom, obj, &avr8x_eeprom_ops, s,
+                                       "eeprom", dev->eeprom_size, errp)) {
+        return false;
+    }
+    memory_region_add_subregion(sysmem, OFFSET_CODE, &s->flash);
+    memory_region_add_subregion(sysmem, OFFSET_DATA + dev->sram_base,
+                                &s->sram);
+
+    erased = g_malloc(dev->eeprom_size);
+    memset(erased, 0xff, dev->eeprom_size);
+    avr8x_apply_rows(s, erased, dev->eeprom_base, dev->eeprom_size);
+    memcpy(memory_region_get_ram_ptr(&s->eeprom), erased, dev->eeprom_size);
+    memory_region_add_subregion(sysmem, OFFSET_DATA + dev->eeprom_base,
+                                &s->eeprom);
+    memory_region_init_alias(&s->eeprom_elf, obj, "eeprom-elf", &s->eeprom,
+                             0, dev->eeprom_size);
+    memory_region_add_subregion(sysmem, OFFSET_DATA + AVR8X_ELF_EEPROM,
+                                &s->eeprom_elf);
+
+    memory_region_init_alias(&s->flash_map, obj, "flash-map", &s->flash, 0,
+                             MIN(dev->progmem_map_size, dev->flash_size));
+    memory_region_add_subregion(sysmem, OFFSET_DATA + dev->progmem_map_base,
+                                &s->flash_map);
+
+    /* Accesses to I/O addresses without a model are logged */
+    create_unimplemented_device("io", OFFSET_DATA, dev->io_size);
+    return true;
+}
+
+static bool avr8x_realize_cpu(Avr8xSocState *s, Error **errp)
+{
+    const MchpAvrDeviceInfo *dev = s->dev;
+
+    /* SP resets to the last SRAM byte (DS: CPU.SP reset value) */
+    qdev_prop_set_uint32(DEVICE(&s->cpu), "init-sp",
+                         dev->sram_base + dev->sram_size - 1);
+    return qdev_realize(DEVICE(&s->cpu), NULL, errp);
+}
+
+/* Connect the first @nirqs vectors of instance @info to sysbus IRQ 0.. */
+static void avr8x_connect_vectors(Avr8xSocState *s, SysBusDevice *sbd,
+                                  const MchpInstanceInfo *info,
+                                  unsigned nirqs)
+{
+    unsigned n = 0;
+
+    for (unsigned v = 0; v < s->dev->nvectors && n < nirqs; v++) {
+        const MchpAvrVector *vec = &s->dev->vectors[v];
+
+        if (vec->instance && !strcmp(vec->instance, info->name)) {
+            sysbus_connect_irq(sbd, n++,
+                               qdev_get_gpio_in(DEVICE(&s->cpu),
+                                                vec->vector));
+        }
+    }
+}
+
+static void avr8x_connect_ccp(Avr8xSocState *s, const MchpInstanceInfo *info)
+{
+    memory_region_init_io(&s->ccp, OBJECT(s), &avr8x_ccp_ops, s, "ccp", 1);
+    /* CPU.CCP at offset 4 of the CPU instance (SP and SREG are the CPU's) */
+    memory_region_add_subregion(get_system_memory(),
+                                OFFSET_DATA + info->base + 4, &s->ccp);
+}
+
+static bool avr8x_realize_port(Avr8xSocState *s, Error **errp)
+{
+    SysBusDevice *sbd = SYS_BUS_DEVICE(&s->port);
+    unsigned groups = 0;
+
+    for (unsigned i = 0; i < s->dev->ninstances; i++) {
+        const MchpInstanceInfo *info = &s->dev->instances[i];
+
+        if (!strcmp(info->module, "PORT")) {
+            groups = MAX(groups, avr8x_port_group(info) + 1);
+        }
+    }
+    qdev_prop_set_uint32(DEVICE(&s->port), "groups", groups);
+    if (!sysbus_realize(sbd, errp)) {
+        return false;
+    }
+    for (unsigned i = 0; i < s->dev->ninstances; i++) {
+        const MchpInstanceInfo *info = &s->dev->instances[i];
+        int g = avr8x_port_group(info);
+        bool vport = !strcmp(info->module, "VPORT");
+
+        if (g < 0 || g >= groups) {
+            continue;
+        }
+        sysbus_mmio_map(sbd, 2 * g + vport, OFFSET_DATA + info->base);
+        if (!vport) {
+            /* One PORT vector per group: sysbus IRQ g */
+            for (unsigned v = 0; v < s->dev->nvectors; v++) {
+                const MchpAvrVector *vec = &s->dev->vectors[v];
+
+                if (vec->instance && !strcmp(vec->instance, info->name)) {
+                    sysbus_connect_irq(sbd, g,
+                                       qdev_get_gpio_in(DEVICE(&s->cpu),
+                                                        vec->vector));
+                }
+            }
+        }
+    }
+    return true;
+}
+
+/* Reset contents of the NVM-backed blocks */
+static void avr8x_nvm_image(Avr8xSocState *s, DeviceState *dev,
+                            const MchpInstanceInfo *info, uint8_t rev)
+{
+    g_autofree uint8_t *buf = g_malloc0(info->slot_size);
+    bool image = true;
+
+    if (!strcmp(info->module, "SIGROW")) {
+        memcpy(buf, s->dev->signature, 3);
+    } else if (!strcmp(info->module, "SYSCFG")) {
+        buf[1] = rev;                   /* REVID */
+    } else if (!strcmp(info->module, "USERROW")) {
+        memset(buf, 0xff, info->slot_size);
+    } else {
+        image = false;                  /* FUSE, LOCK: ATDF reset values */
+    }
+    for (unsigned r = 0; r < s->dev->ndata_rows; r++) {
+        const MchpAvrDataRow *row = &s->dev->data_rows[r];
+
+        if (row->addr < info->base + info->slot_size &&
+            row->addr + row->len > info->base) {
+            image = true;
+        }
+    }
+    if (image) {
+        avr8x_apply_rows(s, buf, info->base, info->slot_size);
+        avr8x_nvmbytes_set_image(dev, buf, info->slot_size);
+    }
+}
+
+static bool avr8x_realize_periph(Avr8xSocState *s, uint8_t rev, Error **errp)
+{
+    DeviceState *clkctrl = avr8x_soc_periph(s, "CLKCTRL");
+    Clock *clk_per = clkctrl ? qdev_get_clock_out(clkctrl, "clk_per") : NULL;
+    DeviceState *nvmctrl = avr8x_soc_periph(s, "NVMCTRL");
+
+    for (unsigned i = 0; i < s->dev->ninstances; i++) {
+        const MchpInstanceInfo *info = &s->dev->instances[i];
+        DeviceState *dev = s->periph[i];
+        SysBusDevice *sbd;
+
+        if (!strcmp(info->module, "CPU")) {
+            avr8x_connect_ccp(s, info);
+            continue;
+        }
+        if (!dev) {
+            continue;
+        }
+        sbd = SYS_BUS_DEVICE(dev);
+        if (!strcmp(info->module, "USART")) {
+            unsigned n = info->name[strlen(info->name) - 1] - '0';
+
+            if (n < AVR8X_MAX_USART && s->usart_chr[n]) {
+                qdev_prop_set_chr(dev, "chardev", s->usart_chr[n]);
+            }
+        } else if (!strcmp(info->module, "CPUINT")) {
+            object_property_set_link(OBJECT(dev), "cpu", OBJECT(&s->cpu),
+                                     &error_abort);
+        } else if (!strcmp(info->module, "CLKCTRL")) {
+            qdev_prop_set_uint32(dev, "xoschf-hz", s->xoschf_hz);
+        } else if (object_dynamic_cast(OBJECT(dev), TYPE_AVR8X_NVMBYTES)) {
+            avr8x_nvm_image(s, dev, info, rev);
+        }
+        if (clk_per && dev != clkctrl) {
+            qdev_connect_clock_in(dev, "gclk", clk_per);
+        }
+        if (!sysbus_realize(sbd, errp)) {
+            return false;
+        }
+        sysbus_mmio_map(sbd, 0, OFFSET_DATA + info->base);
+        /* USART: RXC, DRE, TXC; generic blocks: their first vector */
+        avr8x_connect_vectors(s, sbd, info,
+                              object_dynamic_cast(OBJECT(dev),
+                                                  TYPE_AVR8X_USART) ? 3 : 1);
+    }
+    if (nvmctrl) {
+        qdev_connect_gpio_out_named(nvmctrl, AVR8X_NVMCTRL_FLMAP, 0,
+                                    qemu_allocate_irq(avr8x_set_flmap, s, 0));
+    }
+    return true;
+}
+
+static void avr8x_soc_realize(DeviceState *dev, Error **errp)
+{
+    Avr8xSocState *s = AVR8X_SOC(dev);
+    uint8_t rev;
+
+    if (!avr8x_revision(s, &rev, errp) || !avr8x_init_memory(s, errp) ||
+        !avr8x_realize_cpu(s, errp) || !avr8x_realize_port(s, errp) ||
+        !avr8x_realize_periph(s, rev, errp)) {
+        return;
+    }
+}
+
+static const Property avr8x_soc_properties[] = {
+    DEFINE_PROP_STRING("silicon-rev", Avr8xSocState, silicon_rev),
+    /* Frequency on XTALHF1 (external clock or crystal); 0: nothing fitted */
+    DEFINE_PROP_UINT32("xoschf-hz", Avr8xSocState, xoschf_hz, 0),
+};
+
+static void avr8x_soc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = avr8x_soc_realize;
+    device_class_set_props(dc, avr8x_soc_properties);
+    /* Reason: mapped at fixed addresses on the system bus */
+    dc->user_creatable = false;
+}
+
+/* @data points to the device's descriptor pointer (hw/avr/<device>.c) */
+static void avr8x_soc_device_class_init(ObjectClass *klass, const void *data)
+{
+    AVR8X_SOC_CLASS(klass)->dev = *(const MchpAvrDeviceInfo *const *)data;
+}
+
+static const TypeInfo avr8x_soc_types[] = {
+    {
+        .name = TYPE_AVR8X_SOC,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(Avr8xSocState),
+        .instance_init = avr8x_soc_init,
+        .instance_finalize = avr8x_soc_finalize,
+        .class_size = sizeof(Avr8xSocClass),
+        .class_init = avr8x_soc_class_init,
+        .abstract = true,
+    }, {
+        .name = TYPE_AVR64EA48_SOC,
+        .parent = TYPE_AVR8X_SOC,
+        .class_init = avr8x_soc_device_class_init,
+        .class_data = &avr64ea48_info,
+    },
+};
+
+DEFINE_TYPES(avr8x_soc_types)
