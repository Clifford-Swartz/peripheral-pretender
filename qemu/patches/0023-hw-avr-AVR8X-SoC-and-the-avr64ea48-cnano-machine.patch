diff --git a/include/hw/gpio/avr8x_port.h b/include/hw/gpio/avr8x_port.h
new file mode 100644
index 0000000..1a8db89
--- /dev/null
+++ b/include/hw/gpio/avr8x_port.h
@@ -0,0 +1,84 @@
+/*
+ * Microchip AVR8X I/O ports (PORT and VPORT, gpio_ports_avr_v3)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * One device for all port groups of a device (PORTA..PORTF with their
+ * VPORTs), so the board and the tools find every pad on one object.
+ *
+ * sysbus MMIO 2g: PORT group g (0x20 bytes); MMIO 2g + 1: VPORT group g
+ * (4 bytes). sysbus IRQ g: the PORT interrupt of group g.
+ * GPIO out "pad"[8g + n]: the level of pad n of group g while the PORT or
+ * a peripheral drives it (0/1), -1 while it floats.
+ * GPIO in "port-in"[8g + n]: an external driver; 0/1 drives the pad, a
+ * negative level releases it.
+ * GPIO in "periph-out"[8g + n]: a peripheral output that overrides OUT of
+ * an output pin (USART TX, SPI MOSI, TCA WOn); negative: no override.
+ * QOM "p<x>-levels" (uint32): every pad's level (pulls and externals too);
+ * "p<x>-stats" (str): "<ns> <high0> <low0> ... <high7> <low7>", the
+ * virtual time and each pad's driven-high and driven-low time.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_GPIO_AVR8X_PORT_H
+#define HW_GPIO_AVR8X_PORT_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_AVR8X_PORT "avr8x-port"
+
+#define AVR8X_PORT_GROUPS       6
+#define AVR8X_PORT_PINS         8
+#define AVR8X_PORT_NUM_PINS     (AVR8X_PORT_GROUPS * AVR8X_PORT_PINS)
+#define AVR8X_PORT_GROUP_SIZE   0x20
+#define AVR8X_VPORT_SIZE        4
+
+#define AVR8X_PORT_PAD          "pad"
+#define AVR8X_PORT_IN           "port-in"
+#define AVR8X_PORT_PERIPH_OUT   "periph-out"
+
+typedef struct Avr8xPortState Avr8xPortState;
+
+typedef struct Avr8xPortGroup {
+    Avr8xPortState *owner;          /* for the MMIO callbacks */
+    unsigned index;
+    uint8_t dir;
+    uint8_t out;
+    uint8_t intflags;
+    uint8_t portctrl;
+    uint8_t pinconfig;
+    uint8_t pinctrl[AVR8X_PORT_PINS];
+    uint8_t evgenctrl;
+    /* External drivers and peripheral overrides: pins and levels */
+    uint8_t ext_mask;
+    uint8_t ext_level;
+    uint8_t per_mask;
+    uint8_t per_level;
+    /* Input as last sensed (after INVEN), for edge detection */
+    uint8_t in_last;
+    /* Driven pads as last signalled on "pad", and their accounting */
+    uint8_t pad_mask;
+    uint8_t pad_level;
+    int64_t acc_time;
+    uint64_t high_ns[AVR8X_PORT_PINS];
+    uint64_t low_ns[AVR8X_PORT_PINS];
+} Avr8xPortGroup;
+
+DECLARE_INSTANCE_CHECKER(Avr8xPortState, AVR8X_PORT, TYPE_AVR8X_PORT)
+
+struct Avr8xPortState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion port_mr[AVR8X_PORT_GROUPS];
+    MemoryRegion vport_mr[AVR8X_PORT_GROUPS];
+    qemu_irq irq[AVR8X_PORT_GROUPS];
+    qemu_irq pad[AVR8X_PORT_NUM_PINS];
+
+    uint32_t ngroups;
+    Avr8xPortGroup g[AVR8X_PORT_GROUPS];
+};
+
+#endif /* HW_GPIO_AVR8X_PORT_H */
diff --git a/tests/qtest/avr64ea48-cnano-test.c b/tests/qtest/avr64ea48-cnano-test.c
new file mode 100644
index 0000000..7330c4e
--- /dev/null
+++ b/tests/qtest/avr64ea48-cnano-test.c
@@ -0,0 +1,181 @@
+/*
+ * QTest for the AVR64EA48 Curiosity Nano machine (avr64ea48-cnano)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Device identity and reset values (DS40002324, silicon rev B1), the data
+ * space map (I/O, SIGROW, EEPROM, SRAM, the FLMAP flash window), PORT and
+ * VPORT, the board's LED0 (PB3) and SW0 (PB2), USART1 flags and CPUINT.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qobject/qdict.h"
+
+#define DATA            0x800000        /* data space in the system map */
+
+#define VPORTB          (DATA + 0x0004)
+#define CLKCTRL         (DATA + 0x0060)
+#define CPUINT          (DATA + 0x0110)
+#define PORTB           (DATA + 0x0420)
+#define USART1          (DATA + 0x0820)
+#define SYSCFG          (DATA + 0x0F00)
+#define NVMCTRL         (DATA + 0x1000)
+#define SIGROW          (DATA + 0x1100)
+#define EEPROM          (DATA + 0x1400)
+#define SRAM            (DATA + 0x6800)
+#define FLASH_MAP       (DATA + 0x8000)
+
+#define P_DIRSET        0x01
+#define P_OUT           0x04
+#define P_OUTCLR        0x06
+#define P_IN            0x08
+#define P_INTFLAGS      0x09
+#define P_PIN2CTRL      0x12
+#define PULLUPEN        0x08
+#define ISC_FALLING     0x03
+
+#define LED0            BIT(3)          /* PB3, active low */
+#define SW0             BIT(2)          /* PB2, to ground */
+
+/* A raw image: two words, then 0xA5 0x5A at the start of section 1 */
+static char *write_firmware(void)
+{
+    g_autofree uint8_t *image = g_malloc0(0x8002);
+    char *path = NULL;
+    int fd = g_file_open_tmp("avr64ea48-XXXXXX.bin", &path, NULL);
+
+    g_assert(fd >= 0);
+    image[0] = 0xff;                    /* rjmp .-2 */
+    image[1] = 0xcf;
+    image[0x8000] = 0xa5;
+    image[0x8001] = 0x5a;
+    g_assert(write(fd, image, 0x8002) == 0x8002);
+    close(fd);
+    return path;
+}
+
+static QTestState *start(const char *fw)
+{
+    return qtest_initf("-M avr64ea48-cnano -kernel %s", fw);
+}
+
+static uint32_t qom_uint(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': %s, 'property': %s } }", path, prop);
+    uint32_t value;
+
+    g_assert(qdict_haskey(rsp, "return"));
+    value = qdict_get_int(rsp, "return");
+    qobject_unref(rsp);
+    return value;
+}
+
+static void set_sw0(QTestState *qts, bool pressed)
+{
+    qobject_unref(qtest_qmp(qts, "{ 'execute': 'qom-set', 'arguments':"
+                            " { 'path': '/machine', 'property': "
+                            "'sw0-pressed', 'value': %i } }", pressed));
+}
+
+static void test_identity(const void *fw)
+{
+    QTestState *qts = start(fw);
+
+    g_assert_cmphex(qtest_readb(qts, SIGROW + 0), ==, 0x1e);
+    g_assert_cmphex(qtest_readb(qts, SIGROW + 1), ==, 0x96);
+    g_assert_cmphex(qtest_readb(qts, SIGROW + 2), ==, 0x1e);
+    g_assert_cmphex(qtest_readb(qts, SYSCFG + 1), ==, 0x21);   /* REVID B1 */
+    /* OSCHF 20 MHz / 6 after reset (DS: Main Clock After Reset) */
+    g_assert_cmphex(qtest_readb(qts, CLKCTRL + 0), ==, 0x00);
+    g_assert_cmphex(qtest_readb(qts, CLKCTRL + 1), ==, 0x11);
+    g_assert_cmphex(qtest_readb(qts, CLKCTRL + 5) & 0x02, ==, 0x02);
+    qtest_quit(qts);
+}
+
+static void test_memory(const void *fw)
+{
+    QTestState *qts = start(fw);
+
+    g_assert_cmphex(qtest_readb(qts, EEPROM), ==, 0xff);       /* erased */
+    qtest_writeb(qts, SRAM + 0x10, 0x42);
+    g_assert_cmphex(qtest_readb(qts, SRAM + 0x10), ==, 0x42);
+    /* FLMAP resets to 3: section 1 of 64 KB (32-64 KB) in the window */
+    g_assert_cmphex(qtest_readb(qts, NVMCTRL + 1), ==, 0x30);
+    g_assert_cmphex(qtest_readb(qts, FLASH_MAP), ==, 0xa5);
+    qtest_writeb(qts, NVMCTRL + 1, 0x00);
+    g_assert_cmphex(qtest_readb(qts, FLASH_MAP), ==, 0xff);
+    g_assert_cmphex(qtest_readb(qts, FLASH_MAP + 1), ==, 0xcf);
+    qtest_quit(qts);
+}
+
+static void test_port_led_sw0(const void *fw)
+{
+    QTestState *qts = start(fw);
+
+    /* LED0 pulls PB3 high through its resistor while undriven */
+    g_assert_cmphex(qom_uint(qts, "/machine/soc/port", "pb-levels") & LED0,
+                    ==, LED0);
+    qtest_writeb(qts, PORTB + P_DIRSET, LED0);
+    qtest_writeb(qts, PORTB + P_OUTCLR, LED0);
+    g_assert_cmphex(qom_uint(qts, "/machine/soc/port", "pb-levels") & LED0,
+                    ==, 0);
+    /* VPORT shows the same registers; writing IN toggles OUT */
+    g_assert_cmphex(qtest_readb(qts, VPORTB + 0) & LED0, ==, LED0);
+    qtest_writeb(qts, VPORTB + 2, LED0);
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_OUT) & LED0, ==, LED0);
+
+    /* SW0 has no external pull-up: floating reads 0 until PULLUPEN */
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_IN) & SW0, ==, 0);
+    qtest_writeb(qts, PORTB + P_PIN2CTRL, PULLUPEN | ISC_FALLING);
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_IN) & SW0, ==, SW0);
+    set_sw0(qts, true);
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_IN) & SW0, ==, 0);
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_INTFLAGS), ==, SW0);
+    qtest_writeb(qts, PORTB + P_INTFLAGS, SW0);                /* W1C */
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_INTFLAGS), ==, 0);
+    set_sw0(qts, false);
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_IN) & SW0, ==, SW0);
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_INTFLAGS), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_usart_cpuint(const void *fw)
+{
+    QTestState *qts = start(fw);
+
+    /* DREIF: the transmit buffer is empty */
+    g_assert_cmphex(qtest_readb(qts, USART1 + 4), ==, 0x20);
+    qtest_writeb(qts, USART1 + 6, 0x40);                        /* TXEN */
+    qtest_writeb(qts, USART1 + 2, 'A');
+    g_assert_cmphex(qtest_readb(qts, USART1 + 4), ==, 0x60);    /* +TXCIF */
+    qtest_writeb(qts, USART1 + 4, 0x40);
+    g_assert_cmphex(qtest_readb(qts, USART1 + 4), ==, 0x20);
+
+    qtest_writeb(qts, CPUINT + 3, 30);                          /* LVL1VEC */
+    g_assert_cmpuint(qtest_readb(qts, CPUINT + 3), ==, 30);
+    qtest_writeb(qts, CPUINT + 1, 0xff);            /* STATUS: read-only */
+    g_assert_cmphex(qtest_readb(qts, CPUINT + 1), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_autofree char *fw = write_firmware();
+    int ret;
+
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_data_func("avr64ea48-cnano/identity", fw, test_identity);
+    qtest_add_data_func("avr64ea48-cnano/memory", fw, test_memory);
+    qtest_add_data_func("avr64ea48-cnano/port", fw, test_port_led_sw0);
+    qtest_add_data_func("avr64ea48-cnano/usart-cpuint", fw,
+                        test_usart_cpuint);
+    ret = g_test_run();
+    unlink(fw);
+    return ret;
+}
