+#define MCP9600         0x60
+
+static uint32_t tk_reg(QTestState *qts, uint8_t reg, unsigned n)
+{
+    uint8_t d[3];
+    uint32_t v = 0;
+
+    i2c_rd(qts, MCP9600, reg, d, n);
+    for (unsigned i = 0; i < n; i++) {
+        v = v << 8 | d[i];
+    }
+    return v;
+}
+
+/*
+ * Thermo K Click on EXT1: MCP9600 at 0x60; ALERT1 on INT (PB02),
+ * push-pull
+ */
+static void test_thermok(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext1=thermok ");
+    uint8_t lim[2] = { 0x12, 0xc0 };            /* 300 degrees C */
+    uint8_t cfg = 0x09, zero = 0;               /* enable, rising, low */
+
+    g_assert_cmphex(tk_reg(qts, 0x20, 2), ==, 0x4010);
+    qom_set_int(qts, CLICK1, "temperature", 312500);
+    qom_set_int(qts, CLICK1, "cold", 24000);
+    qtest_clock_step(qts, 321 * 1000 * 1000);
+    g_assert_cmphex(tk_reg(qts, 0x00, 2), ==, 0x1388);      /* TH 312.5 */
+    g_assert_cmphex(tk_reg(qts, 0x02, 2), ==, 0x0180);      /* TC 24 */
+    g_assert_cmphex(tk_reg(qts, 0x01, 2), ==, 0x1208);      /* TDELTA */
+    g_assert_cmphex(tk_reg(qts, 0x03, 3), ==, 5914);        /* 11828 uV */
+    g_assert_cmphex(tk_reg(qts, 0x04, 1) & 0x40, ==, 0x40); /* TH Update */
+    g_assert_true(i2c_wr(qts, MCP9600, 0x04, &zero, 1));
+    g_assert_cmphex(tk_reg(qts, 0x04, 1) & 0x40, ==, 0);
+
+    /* ALERT1: rising at 300 degrees C, comparator, active low */
+    g_assert_true(int_high(qts));
+    g_assert_true(i2c_wr(qts, MCP9600, 0x10, lim, 2));
+    g_assert_true(i2c_wr(qts, MCP9600, 0x08, &cfg, 1));
+    g_assert_false(int_high(qts));
+    g_assert_cmphex(tk_reg(qts, 0x04, 1) & 0x0f, ==, 0x01);
+    qom_set_int(qts, CLICK1, "temperature", 290000);
+    qtest_clock_step(qts, 321 * 1000 * 1000);
+    g_assert_true(int_high(qts));
+    qom_set_int(qts, CLICK1, "temperature", -100000);
+    qtest_clock_step(qts, 321 * 1000 * 1000);
+    g_assert_cmphex(tk_reg(qts, 0x00, 2), ==, 0xf9c0);      /* -100 */
+    qtest_quit(qts);
+}
