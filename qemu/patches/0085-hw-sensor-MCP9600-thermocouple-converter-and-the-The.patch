+    qtest_writeb(qts, TWI0 + T_MCTRLA, 0x03);
+    qtest_writeb(qts, TWI0 + T_MSTATUS, 0x01);
+    qtest_clock_step(qts, 321 * 1000 * 1000LL);
+    twi_read(qts, 0x60, 0x00, d, 2);                    /* TH: 25 */
