new file mode 100644
index 0000000..fc148e8
--- /dev/null
+++ b/hw/sensor/mchp_mcp9600.c
@@ -0,0 +1,446 @@
+/*
+ * Microchip MCP9600 thermocouple EMF to temperature converter, and the
+ * Thermo K Click
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * MCP960X data sheet (DS20005426F), section 5:
+ *  - The first byte written sets the register pointer: TH 00h (hot
+ *    junction, cold-junction compensated), TDELTA 01h (TH - TC), TC 02h
+ *    (cold junction), raw ADC 03h (24 bits), STATUS 04h, sensor
+ *    configuration 05h (thermocouple type, filter), device configuration
+ *    06h (TC resolution, ADC resolution, burst samples, mode), alert
+ *    configuration 08h-0Bh, hysteresis 0Ch-0Fh, limits 10h-13h, device ID
+ *    and revision 20h (4010h). Temperatures are 1/16 degree C, two's
+ *    complement; limits drop the two low bits.
+ *  - Conversions repeat at the ADC resolution's rate (18/16/14/12 bits:
+ *    320/80/20/5 ms) in normal mode, stop in shutdown, and in burst mode
+ *    run the configured number of samples, set Burst Complete and shut
+ *    down. Each sets TH Update (Burst Complete and TH Update clear when
+ *    written with 0: the register is R/W, though its table says writing
+ *    0 "has no effect"). TC at 0.25 degree resolution clears its
+ *    two low bits. Input Range flags a hot junction outside type K's
+ *    -200 to 1372 degrees C.
+ *  - Each alert monitors TH or TC, rising (asserts at the limit, releases
+ *    below limit - hysteresis) or falling (asserts at the limit,
+ *    releases above limit + hysteresis); in interrupt mode an assertion
+ *    latches until Interrupt Clear is written. STATUS bits 3:0 show the
+ *    alerts; enabled outputs drive their active level (push-pull), the
+ *    inactive level otherwise.
+ * The model reports the temperatures it is given: the raw ADC holds the
+ * thermocouple's EMF approximated as 41 uV per degree of TH - TC (type K
+ * near room temperature) whatever the type selected; the filter, the
+ * other thermocouple types' ranges, and the alerts' 0.25 degree
+ * comparison steps are not modelled.
+ *
+ * Thermo K Click (MikroElektronika, schematic v102): ADDR to ground
+ * (0x60), ALERT1 on PWM, ALERT2 on INT, ALERT3 on RST, ALERT4 on AN, no
+ * pull resistors. Not checked against a physical Click.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/i2c/i2c.h"
+#include "hw/sensor/mchp_mcp9600.h"
+#include "migration/vmstate.h"
+
+#define REG_TH          0x00
+#define REG_TDELTA      0x01
+#define REG_TC          0x02
+#define REG_ADC         0x03
+#define REG_STATUS      0x04
+#define REG_SENSOR      0x05
+#define REG_DEVICE      0x06
+#define REG_ALERT_CFG   0x08
+#define REG_HYST        0x0c
+#define REG_LIMIT       0x10
+#define REG_ID          0x20
+
+#define ST_BURST        BIT(7)
+#define ST_UPDATE       BIT(6)
+#define ST_RANGE        BIT(4)
+
+#define DEV_TC_RES      BIT(7)          /* 0.25 degree */
+#define DEV_ADC_SHIFT   5
+#define DEV_BURST_SHIFT 2
+#define DEV_MODE        0x3
+#define MODE_SHUTDOWN   1
+#define MODE_BURST      2
+
+#define AL_CLEAR        BIT(7)
+#define AL_TC           BIT(4)
+#define AL_RISING       BIT(3)
+#define AL_HIGH         BIT(2)
+#define AL_INT          BIT(1)
+#define AL_ENABLE       BIT(0)
+
+#define NALERTS         4
+#define EMF_UV_PER_C    41
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpMcp9600State, MCHP_MCP9600)
+
+struct MchpMcp9600State {
+    I2CSlave parent_obj;
+
+    int16_t th, tdelta, tc;             /* 1/16 degree C */
+    int32_t adc;                        /* 24-bit raw */
+    uint8_t status;
+    uint8_t sensor;
+    uint8_t device;
+    uint8_t alert_cfg[NALERTS];
+    uint8_t hyst[NALERTS];
+    int16_t limit[NALERTS];
+    bool asserted[NALERTS];             /* the comparator */
+    bool latched[NALERTS];              /* interrupt mode */
+    uint8_t ptr;
+    bool ptr_set;
+    uint8_t wbuf;
+    uint8_t wcount;
+    uint8_t rcount;
+    uint8_t burst_left;
+
+    int32_t hot;                        /* milli-degrees C */
+    int32_t cold;
+    QEMUTimer *timer;
+    qemu_irq alert[NALERTS];
+};
+
+static void mcp9600_drive_alerts(MchpMcp9600State *s)
+{
+    for (unsigned i = 0; i < NALERTS; i++) {
+        uint8_t cfg = s->alert_cfg[i];
+        bool on = cfg & AL_INT ? s->latched[i] : s->asserted[i];
+        bool active = (cfg & AL_ENABLE) && on;
+
+        qemu_set_irq(s->alert[i], active == !!(cfg & AL_HIGH));
+    }
+}
+
+static void mcp9600_alerts(MchpMcp9600State *s)
+{
+    s->status &= ~0x0f;
+    for (unsigned i = 0; i < NALERTS; i++) {
+        uint8_t cfg = s->alert_cfg[i];
+        int t = cfg & AL_TC ? s->tc : s->th;
+        int lim = s->limit[i], hy = s->hyst[i] * 16;
+        bool was = s->asserted[i];
+
+        if (cfg & AL_RISING) {
+            s->asserted[i] = t >= lim || (was && t >= lim - hy);
+        } else {
+            s->asserted[i] = t <= lim || (was && t <= lim + hy);
+        }
+        if (s->asserted[i] && !was) {
+            s->latched[i] = true;
+        }
+        if (cfg & AL_INT ? s->latched[i] : s->asserted[i]) {
+            s->status |= BIT(i);
+        }
+    }
+    mcp9600_drive_alerts(s);
+}
+
+static int64_t mcp9600_period_ns(MchpMcp9600State *s)
+{
+    static const unsigned ms[4] = { 320, 80, 20, 5 };
+
+    return ms[(s->device >> DEV_ADC_SHIFT) & 3] * SCALE_MS;
+}
+
+static void mcp9600_arm(MchpMcp9600State *s)
+{
+    if ((s->device & DEV_MODE) == MODE_SHUTDOWN ||
+        ((s->device & DEV_MODE) == MODE_BURST && !s->burst_left)) {
+        timer_del(s->timer);
+        return;
+    }
+    timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              mcp9600_period_ns(s));
+}
+
+static void mcp9600_convert(void *opaque)
+{
+    MchpMcp9600State *s = opaque;
+    unsigned res = (s->device >> DEV_ADC_SHIFT) & 3;
+    int64_t emf_uv = (int64_t)(s->hot - s->cold) * EMF_UV_PER_C / 1000;
+    int32_t raw = emf_uv / 2;           /* 2 uV a count at 18 bits */
+
+    s->th = s->hot * 16 / 1000;
+    s->tc = s->cold * 16 / 1000;
+    if (s->device & DEV_TC_RES) {
+        s->tc &= ~3;
+    }
+    s->tdelta = s->th - s->tc;
+    raw &= ~((1 << (2 * res)) - 1);     /* fewer bits: low ones zero */
+    s->adc = raw & 0xffffff;
+    s->status |= ST_UPDATE;
+    s->status = (s->status & ~ST_RANGE) |
+                (s->hot < -200000 || s->hot > 1372000 ? ST_RANGE : 0);
+    mcp9600_alerts(s);
+    if ((s->device & DEV_MODE) == MODE_BURST && s->burst_left &&
+        !--s->burst_left) {
+        s->status |= ST_BURST;
+        s->device = (s->device & ~DEV_MODE) | MODE_SHUTDOWN;
+    }
+    mcp9600_arm(s);
+}
+
+static unsigned mcp9600_width(uint8_t reg)
+{
+    if (reg <= REG_TC || (reg >= REG_LIMIT && reg < REG_LIMIT + NALERTS) ||
+        reg == REG_ID) {
+        return 2;
+    }
+    return reg == REG_ADC ? 3 : 1;
+}
+
+static uint32_t mcp9600_read_reg(MchpMcp9600State *s, uint8_t reg)
+{
+    switch (reg) {
+    case REG_TH:
+        return (uint16_t)s->th;
+    case REG_TDELTA:
+        return (uint16_t)s->tdelta;
+    case REG_TC:
+        return (uint16_t)s->tc;
+    case REG_ADC:
+        return s->adc;
+    case REG_STATUS:
+        return s->status;
+    case REG_SENSOR:
+        return s->sensor;
+    case REG_DEVICE:
+        return s->device;
+    case REG_ID:
+        return 0x4010;
+    }
+    if (reg >= REG_ALERT_CFG && reg < REG_ALERT_CFG + NALERTS) {
+        return s->alert_cfg[reg - REG_ALERT_CFG] & ~AL_CLEAR;
+    }
+    if (reg >= REG_HYST && reg < REG_HYST + NALERTS) {
+        return s->hyst[reg - REG_HYST];
+    }
+    if (reg >= REG_LIMIT && reg < REG_LIMIT + NALERTS) {
+        return (uint16_t)s->limit[reg - REG_LIMIT];
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "mcp9600: read of register 0x%02x\n", reg);
+    return 0;
+}
+
+static void mcp9600_write_reg(MchpMcp9600State *s, uint8_t reg, uint32_t v)
+{
+    unsigned i;
+
+    switch (reg) {
+    case REG_STATUS:
+        /* Burst Complete and TH Update: writing 0 clears */
+        s->status &= v | ~(ST_BURST | ST_UPDATE);
+        return;
+    case REG_SENSOR:
+        s->sensor = v & 0x77;
+        return;
+    case REG_DEVICE:
+        s->device = v;
+        if ((v & DEV_MODE) == MODE_BURST) {
+            s->burst_left = 1 << ((v >> DEV_BURST_SHIFT) & 7);
+        }
+        mcp9600_arm(s);
+        return;
+    }
+    if (reg >= REG_ALERT_CFG && reg < REG_ALERT_CFG + NALERTS) {
+        i = reg - REG_ALERT_CFG;
+        s->alert_cfg[i] = v & 0x1f;
+        if (v & AL_CLEAR) {
+            s->latched[i] = false;
+        }
+        mcp9600_alerts(s);
+    } else if (reg >= REG_HYST && reg < REG_HYST + NALERTS) {
+        s->hyst[reg - REG_HYST] = v;
+    } else if (reg >= REG_LIMIT && reg < REG_LIMIT + NALERTS) {
+        s->limit[reg - REG_LIMIT] = v & 0xfffc;
+    } else {
+        qemu_log_mask(LOG_GUEST_ERROR, "mcp9600: write of register 0x%02x\n",
+                      reg);
+    }
+}
+
+static int mcp9600_event(I2CSlave *i2c, enum i2c_event event)
+{
+    MchpMcp9600State *s = MCHP_MCP9600(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->ptr_set = false;
+        s->wcount = 0;
+    } else if (event == I2C_START_RECV) {
+        s->rcount = 0;
+    }
+    return 0;
+}
+
+static int mcp9600_send(I2CSlave *i2c, uint8_t data)
+{
+    MchpMcp9600State *s = MCHP_MCP9600(i2c);
+    unsigned width;
+
+    if (!s->ptr_set) {
+        s->ptr = data & 0x3f;
+        s->ptr_set = true;
+        return 0;
+    }
+    width = mcp9600_width(s->ptr);
+    if (width == 1) {
+        mcp9600_write_reg(s, s->ptr, data);
+    } else if (s->wcount++ % 2 == 0) {
+        s->wbuf = data;
+    } else {
+        mcp9600_write_reg(s, s->ptr, s->wbuf << 8 | data);
+    }
+    return 0;
+}
+
+static uint8_t mcp9600_recv(I2CSlave *i2c)
+{
+    MchpMcp9600State *s = MCHP_MCP9600(i2c);
+    unsigned width = mcp9600_width(s->ptr), n = s->rcount++;
+    uint32_t v = mcp9600_read_reg(s, s->ptr);
+
+    if (n >= width) {
+        return 0;
+    }
+    return v >> (8 * (width - 1 - n));
+}
+
+static void mcp9600_get_temp(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, opaque, errp);
+}
+
+static void mcp9600_set_temp(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    MchpMcp9600State *s = MCHP_MCP9600(obj);
+    int32_t *t = opaque, value;
+    bool cold = t == &s->cold;
+
+    if (!visit_type_int32(v, name, &value, errp)) {
+        return;
+    }
+    if (cold ? (value < -40000 || value > 125000)
+             : (value < -200000 || value > 1372000)) {
+        error_setg(errp, "%s must be %s milli-degrees C", name,
+                   cold ? "-40000 to 125000" : "-200000 to 1372000");
+        return;
+    }
+    *t = value;
+}
+
+static void mcp9600_reset(DeviceState *dev)
+{
+    MchpMcp9600State *s = MCHP_MCP9600(dev);
+
+    s->th = s->tdelta = s->tc = 0;
+    s->adc = 0;
+    s->status = 0;
+    s->sensor = 0;
+    s->device = 0;
+    memset(s->alert_cfg, 0, sizeof(s->alert_cfg));
+    memset(s->hyst, 0, sizeof(s->hyst));
+    memset(s->limit, 0, sizeof(s->limit));
+    memset(s->asserted, 0, sizeof(s->asserted));
+    memset(s->latched, 0, sizeof(s->latched));
+    s->ptr = 0;
+    s->ptr_set = false;
+    s->burst_left = 0;
+    mcp9600_drive_alerts(s);
+    mcp9600_arm(s);                     /* normal mode at power-on */
+}
+
+static void mcp9600_init(Object *obj)
+{
+    MchpMcp9600State *s = MCHP_MCP9600(obj);
+    static const char *const names[NALERTS] = {
+        MCHP_MCP9600_ALERT1, MCHP_MCP9600_ALERT2, MCHP_MCP9600_ALERT3,
+        MCHP_MCP9600_ALERT4,
+    };
+
+    s->hot = 25000;
+    s->cold = 25000;
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, mcp9600_convert, s);
+    for (unsigned i = 0; i < NALERTS; i++) {
+        qdev_init_gpio_out_named(DEVICE(obj), &s->alert[i], names[i], 1);
+    }
+    object_property_add(obj, "temperature", "int32", mcp9600_get_temp,
+                        mcp9600_set_temp, NULL, &s->hot);
+    object_property_add(obj, "cold", "int32", mcp9600_get_temp,
+                        mcp9600_set_temp, NULL, &s->cold);
+}
+
+static void mcp9600_finalize(Object *obj)
+{
+    timer_free(MCHP_MCP9600(obj)->timer);
+}
+
+static const VMStateDescription vmstate_mcp9600 = {
+    .name = TYPE_MCHP_MCP9600,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, MchpMcp9600State),
+        VMSTATE_INT16(th, MchpMcp9600State),
+        VMSTATE_INT16(tdelta, MchpMcp9600State),
+        VMSTATE_INT16(tc, MchpMcp9600State),
+        VMSTATE_INT32(adc, MchpMcp9600State),
+        VMSTATE_UINT8(status, MchpMcp9600State),
+        VMSTATE_UINT8(sensor, MchpMcp9600State),
+        VMSTATE_UINT8(device, MchpMcp9600State),
+        VMSTATE_UINT8_ARRAY(alert_cfg, MchpMcp9600State, NALERTS),
+        VMSTATE_UINT8_ARRAY(hyst, MchpMcp9600State, NALERTS),
+        VMSTATE_INT16_ARRAY(limit, MchpMcp9600State, NALERTS),
+        VMSTATE_BOOL_ARRAY(asserted, MchpMcp9600State, NALERTS),
+        VMSTATE_BOOL_ARRAY(latched, MchpMcp9600State, NALERTS),
+        VMSTATE_UINT8(ptr, MchpMcp9600State),
+        VMSTATE_BOOL(ptr_set, MchpMcp9600State),
+        VMSTATE_UINT8(wbuf, MchpMcp9600State),
+        VMSTATE_UINT8(wcount, MchpMcp9600State),
+        VMSTATE_UINT8(rcount, MchpMcp9600State),
+        VMSTATE_UINT8(burst_left, MchpMcp9600State),
+        VMSTATE_INT32(hot, MchpMcp9600State),
+        VMSTATE_INT32(cold, MchpMcp9600State),
+        VMSTATE_TIMER_PTR(timer, MchpMcp9600State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mcp9600_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->desc = "MCP9600 thermocouple EMF to temperature converter";
+    dc->vmsd = &vmstate_mcp9600;
+    device_class_set_legacy_reset(dc, mcp9600_reset);
+    k->event = mcp9600_event;
+    k->send = mcp9600_send;
+    k->recv = mcp9600_recv;
+}
+
+static const TypeInfo mcp9600_types[] = {
+    {
+        .name = TYPE_MCHP_MCP9600,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(MchpMcp9600State),
+        .instance_init = mcp9600_init,
+        .instance_finalize = mcp9600_finalize,
+        .class_init = mcp9600_class_init,
+    },
+};
+
+DEFINE_TYPES(mcp9600_types)
