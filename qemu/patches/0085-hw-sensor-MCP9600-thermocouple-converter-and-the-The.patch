+/*
+ * Microchip MCP9600 thermocouple EMF to temperature converter
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * "mchp-mcp9600": an I2C target (0x60-0x67 by its ADDR pin, set by the
+ * board). GPIO outputs "alert1".."alert4" (push-pull 0/1). QOM properties
+ * "temperature" (the thermocouple's hot junction, milli-degrees C,
+ * -200000 to 1372000, default 25000) and "cold" (the cold junction, the
+ * chip's own temperature, -40000 to 125000, default 25000), also at run
+ * time.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SENSOR_MCHP_MCP9600_H
+#define HW_SENSOR_MCHP_MCP9600_H
+
+#define TYPE_MCHP_MCP9600 "mchp-mcp9600"
+
+#define MCHP_MCP9600_ALERT1 "alert1"
+#define MCHP_MCP9600_ALERT2 "alert2"
+#define MCHP_MCP9600_ALERT3 "alert3"
+#define MCHP_MCP9600_ALERT4 "alert4"
+
+#endif /* HW_SENSOR_MCHP_MCP9600_H */
