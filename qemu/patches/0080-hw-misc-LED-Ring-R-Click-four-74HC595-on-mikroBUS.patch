+/* LED Ring R Click on mikroBUS 1: four 74HC595, LATCH on CS (PA7) */
+static void test_ledringr_mb1(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb1=ledringr "
+                                  "-kernel %s", (const char *)fw);
+
+    qtest_writeb(qts, PORTA + 0x06, BIT(7));                    /* OUTCLR */
+    qtest_writeb(qts, PORTA + 0x01, BIT(4) | BIT(6) | BIT(7));  /* DIRSET */
+    qtest_writeb(qts, SPI0 + 0, 0x21);                  /* MASTER, ENABLE */
+    spi0_xfer(qts, 0x0f);                               /* LED1-LED4 */
+    spi0_xfer(qts, 0x00);
+    spi0_xfer(qts, 0x00);
+    spi0_xfer(qts, 0x00);
+    qtest_writeb(qts, PORTA + 0x05, BIT(7));            /* LATCH rises */
+    g_assert_cmphex(qom_uint(qts, "/machine/mb1-click", "outputs"), ==,
+                    0x0f000000);
+    qtest_quit(qts);
+}
