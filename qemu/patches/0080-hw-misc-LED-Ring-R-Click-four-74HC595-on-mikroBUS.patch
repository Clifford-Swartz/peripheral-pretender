+/*
+ * LED Ring R Click on EXT1: four 74HC595, LATCH on CS (PA17). Byte 0
+ * (LED1-8) ends in the last register, bits 31:24 of "outputs"
+ */
+static void test_ledringr(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=ledringr ");
+    static const uint8_t ring[4] = { 0x01, 0x00, 0x00, 0x80 };
+
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);   /* host, DOPO 1 */
+    qtest_writel(qts, SERCOM1 + 0x04, BIT(17));            /* RXEN */
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, PA + P_OUTCLR, BIT(17));
+    qtest_writel(qts, PA + P_DIRSET, BIT(17));
+    for (unsigned i = 0; i < 4; i++) {
+        spi_byte(qts, ring[i]);
+    }
+    g_assert_cmphex(qom_int(qts, CLICK1, "outputs"), ==, 0);   /* latched */
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));             /* LATCH rises */
+    g_assert_cmphex(qom_int(qts, CLICK1, "outputs"), ==, 0x01000080);
+    qtest_quit(qts);
+}
+
 /* ADC Click on EXT1: MCP3204 on SPI (CS# PA17), inputs on terminals */
 static void test_adc(void)
 {
@@ -1477,6 +1500,7 @@ int main(int argc, char **argv)
     qtest_add_func("pic32cm-click/oledc", test_oledc);
     qtest_add_func("pic32cm-click/thumbstick", test_thumbstick);
     qtest_add_func("pic32cm-click/adc", test_adc);
+    qtest_add_func("pic32cm-click/ledringr", test_ledringr);
     qtest_add_func("pic32cm-click/accel", test_accel);
     qtest_add_func("pic32cm-click/rtc6-time", test_rtc6_time);
     qtest_add_func("pic32cm-click/rtc6-alarm", test_rtc6_alarm);
