index 147d291..0000000
--- a/include/hw/arm/pic32cm_jh_soc.h
+++ /dev/null
@@ -1,66 +0,0 @@
-/*
- * Microchip PIC32CM JH01 SoC (PIC32CM5164JH01100)
- *
- * Peripheral Pretender: a personal project. AI-assisted code;
- * not for submission to upstream QEMU.
- *
- * Built from the generated device description (pic32cm5164jh01100_gen.h):
- * a Cortex-M0 armv7m, the memories, and one child per ATDF peripheral
- * instance named after it in lowercase ("sercom4", "gclk", ...).
- *
- * Clock inputs "xosc" and "xosc32k": the board's crystals on XIN/XOUT and
- * XIN32/XOUT32 (leave unconnected when not fitted).
- * Properties: "silicon-rev" ("B0" default, or "C0"), "serial-number"
- * (32 hex digits: the words at 0x0080A00C, 0x0080A040, 0x0080A044 and
- * 0x0080A048, in that order).
- *
- * SPDX-License-Identifier: GPL-2.0-or-later
- */
-
-#ifndef HW_ARM_PIC32CM_JH_SOC_H
-#define HW_ARM_PIC32CM_JH_SOC_H
-
-#include "hw/arm/armv7m.h"
-#include "hw/arm/pic32cm5164jh01100_gen.h"
-#include "hw/core/or-irq.h"
-#include "hw/core/sysbus.h"
-#include "qom/object.h"
-
-#define TYPE_PIC32CM5164JH01100_SOC "pic32cm5164jh01100-soc"
-OBJECT_DECLARE_SIMPLE_TYPE(Pic32cmJhSocState, PIC32CM5164JH01100_SOC)
-
-#define PIC32CM_JH_NUM_SERCOM   8
-
-/*
- * SCB->CPUID of the Cortex-M0+ r0p1 core (ATDF __CM0P_REV 0x0001); the
- * board applies it to QEMU's cortex-m0 as a "midr" global property.
- */
-#define PIC32CM_JH_CPUID        0x410CC601
-
-struct Pic32cmJhSocState {
-    SysBusDevice parent_obj;
-
-    ARMv7MState armv7m;
-    /* OR gates of the shared NVIC lines, indexed by line */
