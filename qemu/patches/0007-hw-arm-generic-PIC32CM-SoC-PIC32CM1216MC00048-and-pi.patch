diff --git a/include/hw/arm/pic32cm_soc.h b/include/hw/arm/pic32cm_soc.h
new file mode 100644
index 0000000..e5da315
--- /dev/null
+++ b/include/hw/arm/pic32cm_soc.h
@@ -0,0 +1,86 @@
+/*
+ * Microchip PIC32CM SoCs (PIC32CM5164JH01100, PIC32CM1216MC00048)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * One model for every PIC32CM device, built from the generated device
+ * descriptor (MchpDeviceInfo in hw/arm/<device>_device.h): a Cortex-M0
+ * armv7m, the memories, and one child per ATDF peripheral instance named
+ * after it in lowercase ("sercom4", "gclk", ...). Each device is a subtype
+ * of the abstract TYPE_PIC32CM_SOC.
+ *
+ * Clock inputs "xosc" and "xosc32k": the board's crystals or oscillators
+ * on XIN and XIN32 (leave unconnected when not fitted).
+ * Properties: "silicon-rev" (a revision name of the device; the default is
+ * the first in its profile), "serial-number" (32 hex digits: the four
+ * serial-number words, in address order).
+ *
