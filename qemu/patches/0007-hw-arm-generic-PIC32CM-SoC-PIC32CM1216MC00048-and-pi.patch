+/*
+ * PIC32CM1216MC00048 default NVM rows image (0x00800000-0x0080FFFF)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * GENERATED by generator/atdf2qemu.py from PIC32CM1216MC00048.atdf
+ * (PIC32CM-MC_DFP 1.4.67). Do not edit.
+ * Calibration and serial-number values are placeholders;
+ * dump real ones from silicon before trusting them.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_ARM_PIC32CM1216MC00048_NVMROWS_H
+#define HW_ARM_PIC32CM1216MC00048_NVMROWS_H
+
+#include "qemu/bswap.h"
+
+#define PIC32CM1216MC00048_NVMROWS_BASE 0x00800000
+#define PIC32CM1216MC00048_NVMROWS_SIZE 0x10000
+#define PIC32CM1216MC00048_NVMROWS_USER_PAGE_OFFSET 0x4000
+#define PIC32CM1216MC00048_NVMROWS_OTP5_OFFSET 0x6020
+#define PIC32CM1216MC00048_NVMROWS_TEMP_LOG_OFFSET 0x6030
+
+/* Production user row (profiles/pic32cm1216mc00048.yaml) */
+#define PIC32CM1216MC00048_USER_ROW_WORD0 0xB15088FF
+#define PIC32CM1216MC00048_USER_ROW_WORD1 0xFFFFF8BB
+
+/* Serial number word addresses (DS 10.3) and default value */
+static const uint32_t pic32cm1216mc00048_serial_addr[4] = {
+    0x0080A00C, 0x0080A040, 0x0080A044, 0x0080A048,
+};
+static const uint32_t pic32cm1216mc00048_serial_default[4] = {
+    0x50500000, 0x00000001, 0x00000002, 0x00000003,
+};
+
+/*
+ * Fill @buf (PIC32CM1216MC00048_NVMROWS_SIZE bytes, mapped at
+ * PIC32CM1216MC00048_NVMROWS_BASE) with the default image: erased (0xFF)
+ * rows, production user row, NVM geometry in OTP1, a plausible
+ * calibration row, and @serial as the four serial-number words.
+ */
+static inline void pic32cm1216mc00048_nvmrows_fill(uint8_t *buf,
+                                                   const uint32_t serial[4])
+{
+    static const struct {
+        uint32_t addr;
+        uint32_t value;
+    } words[] = {
+        /* USER row word 0 (production) */
+        { 0x00804000, 0xB15088FF },
+        /* USER row word 1 (production) */
+        { 0x00804004, 0xFFFFF8BB },
+        /* OTP1 word 0 (silicon) */
+        { 0x00806000, 0x08000300 },
+        /* OTP1 word 1 (silicon) */
+        { 0x00806004, 0x00000040 },
+        /* OTP5 word 0: calibration (silicon), CAL48M low */
+        { 0x00806020, 0x1904FFBE },
+        /* OTP5 word 1: calibration (silicon), CAL48M high */
+        { 0x00806024, 0xC2064108 },
+        /* TEMP_LOG word 0 (silicon) */
+        { 0x00806030, 0x14421ADF },
+        /* TEMP_LOG word 1 (silicon) */
+        { 0x00806034, 0xF0024420 },
+    };
+    const uint32_t base = PIC32CM1216MC00048_NVMROWS_BASE;
+    unsigned i;
+
+    memset(buf, 0xFF, PIC32CM1216MC00048_NVMROWS_SIZE);
+    for (i = 0; i < ARRAY_SIZE(words); i++) {
+        stl_le_p(buf + words[i].addr - base, words[i].value);
+    }
+    for (i = 0; i < 4; i++) {
+        stl_le_p(buf + pic32cm1216mc00048_serial_addr[i] - base, serial[i]);
+    }
+}
