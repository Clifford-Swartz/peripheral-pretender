-    /* Peripheral models by instance index; NULL when not a regblock */
-    DeviceState *periph[PIC32CM5164JH01100_NUM_INSTANCES];
-    Chardev *sercom_chr[PIC32CM_JH_NUM_SERCOM];
-
-    MemoryRegion flash;
-    MemoryRegion dataflash;
-    MemoryRegion nvm_rows;
-    MemoryRegion sram;
-
-    char *silicon_rev;
-    char *serial_number;
-};
-
-/*
- * Attach @chr to SERCOM@sercom; call before realize. The chardev reaches
- * the SERCOM model through its "chardev" property, if the model has one.
- */
-void pic32cm_jh_soc_connect_serial(Pic32cmJhSocState *s, unsigned sercom,
-                                   Chardev *chr);
