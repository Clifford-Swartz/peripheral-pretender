diff --git a/tests/qtest/pic32cm-mc00-test.c b/tests/qtest/pic32cm-mc00-test.c
new file mode 100644
index 0000000..8fc722e
--- /dev/null
+++ b/tests/qtest/pic32cm-mc00-test.c
@@ -0,0 +1,189 @@
+/*
+ * QTest for the PIC32CM MC00 Curiosity Pro machine (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * What differs from the PIC32CM JH01 (pic32cm-jh-test covers the shared
+ * models): device identity and reset values from DS60001638E and errata
+ * DS80000905G, two PORT groups, 35 GCLK channels, the board's 12 MHz
+ * oscillator on XIN, SERCOM0 on the EDBG VCOM and LED0/SW0 on PA24/PA25
+ * (board user guide DS70005440A).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qemu/sockets.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro "
+
+#define MCLK            0x40000800
+#define OSCCTRL         0x40001000
+#define SUPC            0x40001800
+#define GCLK            0x40001C00
+#define PORT            0x41000000
+#define DSU             0x41002000
+#define NVMCTRL         0x41004000
+#define SERCOM0         0x42000400
+#define USER_ROW        0x00804000
+#define SCB_CPUID       0xE000ED00
+
+#define PA              (PORT + 0x00)
+#define PB              (PORT + 0x80)
+#define P_DIRSET        0x08
+#define P_OUTSET        0x18
+#define P_OUTTGL        0x1C
+#define P_IN            0x20
+#define P_PINCFG        0x40
+
+#define LED0_PIN        24      /* PA24, active low */
+#define SW0_PIN         25      /* PA25, to ground */
+
+/* Frequency of a QOM Clock object, from its period in 2^-32 ns. */
+static uint64_t clock_hz(QTestState *qts, const char *path)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': %s,"
+                           " 'property': 'qtest-clock-period' } }", path);
+    uint64_t period;
+
+    g_assert(qdict_haskey(rsp, "return"));
+    period = qdict_get_int(rsp, "return");
+    qobject_unref(rsp);
+    return period ? (1000000000ULL << 32) / period : 0;
+}
+
+static bool port_has_prop(QTestState *qts, const char *name)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': '/machine/soc/port',"
+                           " 'property': %s } }", name);
+    bool ok = qdict_haskey(rsp, "return");
+
+    qobject_unref(rsp);
+    return ok;
+}
+
+static void test_identity(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* Rev A2 by default (SERIES 7, DEVSEL 0x06), Cortex-M0+ r0p1 */
+    g_assert_cmphex(qtest_readl(qts, DSU + 0x18), ==, 0x11070106);
+    g_assert_cmphex(qtest_readl(qts, SCB_CPUID), ==, 0x410CC601);
+    qtest_quit(qts);
+
+    qts = qtest_init(MACHINE
+                     "-global pic32cm1216mc00048-soc.silicon-rev=A1");
+    g_assert_cmphex(qtest_readl(qts, DSU + 0x18), ==, 0x11070006);
+    qtest_quit(qts);
+}
+
+static void test_reset_values(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* 2048 pages of 64 bytes, 64 data-flash pages */
+    g_assert_cmphex(qtest_readl(qts, NVMCTRL + 0x08), ==, 0x04030800);
+    /* Data sheet values where the ATDF disagrees */
+    g_assert_cmphex(qtest_readl(qts, SUPC + 0x18), ==, 0x00000002);
+    g_assert_cmphex(qtest_readl(qts, MCLK + 0x10), ==, 0x000005FF);
+    /* Generator 0 runs from OSC48M, at 4 MHz out of reset */
+    g_assert_cmphex(qtest_readl(qts, GCLK + 0x20), ==, 0x00000106);
+    g_assert_cmphex(qtest_readb(qts, OSCCTRL + 0x15), ==, 0x0B);
+    /* Production user row */
+    g_assert_cmphex(qtest_readl(qts, USER_ROW), ==, 0xB15088FF);
+    g_assert_cmphex(qtest_readl(qts, USER_ROW + 4), ==, 0xFFFFF8BB);
+    qtest_quit(qts);
+}
+
+static void test_port_groups(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, PB + P_DIRSET, BIT(3));
+    g_assert_cmphex(qtest_readl(qts, PB), ==, BIT(3));
+    g_assert_true(port_has_prop(qts, "pb-out"));
+    g_assert_false(port_has_prop(qts, "pc-out"));
+    qtest_quit(qts);
+}
+
+static void test_clocks(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/mclk/cpu"), ==, 4000000);
+    qtest_writeb(qts, OSCCTRL + 0x15, 0);                   /* OSC48MDIV */
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/mclk/cpu"), ==, 48000000);
+
+    /* XOSC: the board's 12 MHz oscillator (external clock, XTALEN = 0) */
+    qtest_writew(qts, OSCCTRL + 0x10, 0x0002);               /* ENABLE */
+    qtest_writel(qts, GCLK + 0x24, 0x00010100);              /* gen1: XOSC */
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/gclk/gen[1]"), ==,
+                     12000000);
+
+    /* The last of the 35 peripheral channels */
+    qtest_writel(qts, GCLK + 0x80 + 4 * 34, 0x41);
+    g_assert_cmphex(qtest_readl(qts, GCLK + 0x80 + 4 * 34), ==, 0x41);
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/gclk/pch[34]"), ==,
+                     12000000);
+    qtest_quit(qts);
+}
+
+static void test_vcom(void)
+{
+    int sock;
+    QTestState *qts = qtest_init_with_serial(MACHINE, &sock);
+    char c;
+
+    qtest_writel(qts, SERCOM0 + 0x00, 0x40310004);
+    qtest_writew(qts, SERCOM0 + 0x0C, 63019);
+    qtest_writel(qts, SERCOM0 + 0x04, 0x00030000);
+    qtest_writel(qts, SERCOM0 + 0x00, 0x40310006);
+    g_assert_cmphex(qtest_readb(qts, SERCOM0 + 0x18) & 1, ==, 1);    /* DRE */
+    qtest_writew(qts, SERCOM0 + 0x28, 'M');
+    g_assert_cmpint(recv(sock, &c, 1, 0), ==, 1);
+    g_assert_cmpint(c, ==, 'M');
+
+    closesocket(sock);
+    qtest_quit(qts);
+}
+
+static void test_led0_sw0(void)
+{
+    QTestState *qts = qtest_init(MACHINE "-machine sw0-pressed=on");
+
+    qtest_irq_intercept_out_named(qts, "/machine/soc/port", "port-out");
+    qtest_writel(qts, PA + P_OUTSET, BIT(LED0_PIN));
+    qtest_writel(qts, PA + P_DIRSET, BIT(LED0_PIN));
+    g_assert_true(qtest_get_irq(qts, LED0_PIN));
+    qtest_writel(qts, PA + P_OUTTGL, BIT(LED0_PIN));
+    g_assert_false(qtest_get_irq(qts, LED0_PIN));
+
+    /* SW0 has no external pull-up: firmware enables the internal one */
+    qtest_writeb(qts, PA + P_PINCFG + SW0_PIN, 0x06);       /* INEN, PULLEN */
+    qtest_writel(qts, PA + P_OUTSET, BIT(SW0_PIN));
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(SW0_PIN), ==, 0);
+    qtest_qom_set_bool(qts, "/machine", "sw0-pressed", false);
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(SW0_PIN), ==,
+                    BIT(SW0_PIN));
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-mc00/identity", test_identity);
+    qtest_add_func("pic32cm-mc00/reset-values", test_reset_values);
+    qtest_add_func("pic32cm-mc00/port-groups", test_port_groups);
+    qtest_add_func("pic32cm-mc00/clocks", test_clocks);
+    qtest_add_func("pic32cm-mc00/vcom", test_vcom);
+    qtest_add_func("pic32cm-mc00/led0-sw0", test_led0_sw0);
+
+    return g_test_run();
+}
