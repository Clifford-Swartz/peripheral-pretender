diff --git a/hw/misc/mchp_clock.c b/hw/misc/mchp_clock.c
index 7854171..de71b58 100644
--- a/hw/misc/mchp_clock.c
+++ b/hw/misc/mchp_clock.c
@@ -559,61 +559,70 @@ struct MchpGclkState {
     MchpClkSettle settle;
 };
 
-static uint64_t mchp_gclk_src_hz(MchpGclkState *s, int idx)
+static uint64_t mchp_gclk_src_period(MchpGclkState *s, int idx)
 {
     if (idx < 0 || idx >= MCHP_GCLK_NSRC) {
         return 0;
     }
-    return clock_get_hz(s->src[idx]);
+    return clock_get(s->src[idx]);
 }
 
-static uint64_t mchp_gclk_gen_hz(MchpGclkState *s, unsigned n,
-                                 uint64_t gen1_hz)
+/*
+ * Generator @n's period (Clock units, 0: stopped): the source's period
+ * times the divider, so that every division stays exact (FREQM measures
+ * 48 MHz / 2^17 as silicon does)
+ */
+static uint64_t mchp_gclk_gen_period(MchpGclkState *s, unsigned n,
+                                     uint64_t gen1)
 {
     uint32_t ctrl = mchp_clk_reg(MCHP_REGBLOCK(s),
                                  A_MCHP_GCLK_GENCTRL + 4 * n, 4);
     uint32_t src = FIELD_EX32(ctrl, MCHP_GCLK_GENCTRL, SRC);
     uint32_t div = FIELD_EX32(ctrl, MCHP_GCLK_GENCTRL, DIV);
     int idx = s->src_map[src & (MCHP_GCLK_MAX_SRC - 1)];
-    uint64_t hz;
+    uint64_t period, hi, lo;
 
     if (!FIELD_EX32(ctrl, MCHP_GCLK_GENCTRL, GENEN)) {
         return 0;
     }
     if (idx == MCHP_GCLK_SRC_GEN1) {
-        hz = n == MCHP_GCLK_GEN1 ? 0 : gen1_hz;
+        period = n == MCHP_GCLK_GEN1 ? 0 : gen1;
     } else {
-        hz = mchp_gclk_src_hz(s, idx);
+        period = mchp_gclk_src_period(s, idx);
     }
     if (FIELD_EX32(ctrl, MCHP_GCLK_GENCTRL, DIVSEL)) {
-        return div + 1 < 64 ? hz >> (div + 1) : 0;
+        if (div + 1 >= 64 || period >> (63 - div)) {
+            return 0;                       /* far below 1 Hz */
+        }
+        return period << (div + 1);
     }
-    return div > 1 ? hz / div : hz;
+    mulu64(&lo, &hi, period, div > 1 ? div : 1);
+    return hi ? 0 : lo;
 }
 
 static void mchp_gclk_compute(MchpRegBlock *rb)
 {
     MchpGclkState *s = MCHP_GCLK(rb);
-    uint64_t hz[MCHP_GCLK_GENCTRL_COUNT];
+    uint64_t period[MCHP_GCLK_GENCTRL_COUNT];
 
-    memset(hz, 0, sizeof(hz));
+    memset(period, 0, sizeof(period));
     if (s->ngen > MCHP_GCLK_GEN1) {         /* 0 until realized */
-        hz[MCHP_GCLK_GEN1] = mchp_gclk_gen_hz(s, MCHP_GCLK_GEN1, 0);
+        period[MCHP_GCLK_GEN1] = mchp_gclk_gen_period(s, MCHP_GCLK_GEN1, 0);
     }
     for (unsigned n = 0; n < s->ngen; n++) {
         if (n != MCHP_GCLK_GEN1) {
-            hz[n] = mchp_gclk_gen_hz(s, n, hz[MCHP_GCLK_GEN1]);
+            period[n] = mchp_gclk_gen_period(s, n, period[MCHP_GCLK_GEN1]);
         }
     }
     for (unsigned n = 0; n < MCHP_GCLK_GENCTRL_COUNT; n++) {
-        mchp_regblock_set_clock(rb, s->gen[n], hz[n]);
+        mchp_regblock_set_clock_period(rb, s->gen[n], period[n]);
     }
     for (unsigned m = 0; m < s->npch; m++) {
         uint32_t ctrl = mchp_clk_reg(rb, A_MCHP_GCLK_PCHCTRL + 4 * m, 4);
         uint32_t gen = FIELD_EX32(ctrl, MCHP_GCLK_PCHCTRL, GEN);
         bool on = FIELD_EX32(ctrl, MCHP_GCLK_PCHCTRL, CHEN) && gen < s->ngen;
 
-        mchp_regblock_set_clock(rb, s->pch[m], on ? hz[gen] : 0);
+        mchp_regblock_set_clock_period(rb, s->pch[m], on ? period[gen] : 0);
     }
 }
 
diff --git a/hw/misc/mchp_freqm.c b/hw/misc/mchp_freqm.c
new file mode 100644
index 0000000..bd91db1
--- /dev/null
+++ b/hw/misc/mchp_freqm.c
@@ -0,0 +1,275 @@
+/*
+ * Microchip SAM/PIC32CM frequency meter (FREQM U2257)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Counts periods of GCLK_FREQM_MSR (the regblock's "gclk") during REFNUM
+ * periods of GCLK_FREQM_REF ("gclk-ref"); the SoC wires both from the
+ * device's GCLK_ID_MSR/GCLK_ID_REF channels. One model for the PIC32CM
+ * JH01/MC00 (1.0.1) and SAM E51 (1.1.0).
+ *
+ * What the PIC32CM MC00 (rev A1, firmware/hello APP=freqmprobe) showed,
+ * and the model does:
+ *
+ *   - VALUE = REFNUM * f_MSR / f_REF, rounded down (48 MHz against
+ *     46,875 Hz, REFNUM 255: 261,120 exactly); REFNUM = 0 counts as 512.
+ *     A count beyond 24 bits keeps its low 24 bits and sets STATUS.OVF,
+ *     which disabling clears.
+ *   - A measurement lasts REFNUM + 2.5 reference periods from START;
+ *     BUSY reads 1 meanwhile and VALUE the count so far; at the end DONE
+ *     sets, whatever INTENSET says.
+ *   - START while busy or disabled is ignored. Disabling aborts: BUSY and
+ *     VALUE read 0, no DONE. Without a reference clock the measurement
+ *     waits for it and then takes the whole window; without a measured
+ *     clock VALUE is 0.
+ *   - CFGA bits 15:8 (DIVREF on later FREQMs) do not exist.
+ *
+ * Not modelled: the synchronizer's error of a count or two (silicon: MSR
+ * and REF from one generator read REFNUM - 1), SYNCBUSY (silicon: about 3
+ * reference periods), a CTRLB read's PAC error, clock changes during a
+ * window (the end uses the rates of that moment).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/host-utils.h"
+#include "qemu/timer.h"
+#include "hw/core/clock.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/misc/mchp_freqm.h"
+#include "hw/mchp/gen/freqm_u2257.h"
+#include "migration/vmstate.h"
+
+#define VALUE_MASK          0xFFFFFF
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpFreqmState, MCHP_FREQM)
+
+struct MchpFreqmState {
+    MchpRegBlock parent_obj;
+
+    bool busy;
+    bool waiting;               /* started, no reference clock yet */
+    int64_t window_ns;          /* virtual time the counting began */
+    QEMUTimer *timer;
+    Clock *ref;
+};
+
+static uint32_t fm_reg(MchpFreqmState *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static void fm_set_reg(MchpFreqmState *s, hwaddr off, unsigned size,
+                       uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
+static bool fm_on(MchpFreqmState *s)
+{
+    return fm_reg(s, A_MCHP_FREQM_CTRLA, 1) & R_MCHP_FREQM_CTRLA_ENABLE_MASK;
+}
+
+static uint64_t fm_refnum(MchpFreqmState *s)
+{
+    uint32_t n = FIELD_EX32(fm_reg(s, A_MCHP_FREQM_CFGA, 2), MCHP_FREQM_CFGA,
+                            REFNUM);
+
+    return n ? n : 512;                 /* silicon */
+}
+
+static void fm_set_busy(MchpFreqmState *s, bool busy)
+{
+    uint8_t st = fm_reg(s, A_MCHP_FREQM_STATUS, 1);
+
+    s->busy = busy;
+    fm_set_reg(s, A_MCHP_FREQM_STATUS, 1,
+               busy ? st | R_MCHP_FREQM_STATUS_BUSY_MASK :
+                      st & ~R_MCHP_FREQM_STATUS_BUSY_MASK);
+}
+
+/*
+ * Periods of the measured clock in @len of the reference clock's periods
+ * (2^-32 ns units, so that dividers such as 2^17 stay exact)
+ */
+static uint64_t fm_count(MchpFreqmState *s, uint64_t len)
+{
+    uint64_t msr = clock_get(MCHP_REGBLOCK(s)->gclk);
+    uint64_t lo, hi;
+
+    if (!msr) {
+        return 0;
+    }
+    /* to nearest: whole ratios on silicon stay whole after period rounding */
+    mulu64(&lo, &hi, len, clock_get(s->ref));
+    hi += uadd64_overflow(lo, msr / 2, &lo);
+    divu128(&lo, &hi, msr);
+    return lo;
+}
+
+/* The window from now: counting after 2.5 reference periods, REFNUM long */
+static void fm_arm(MchpFreqmState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    s->waiting = !clock_get(s->ref);
+    if (s->waiting) {
+        return;
+    }
+    s->window_ns = now + clock_ticks_to_ns(s->ref, 5) / 2;
+    timer_mod(s->timer, s->window_ns +
+              clock_ticks_to_ns(s->ref, fm_refnum(s)));
+}
+
+static void fm_done(void *opaque)
+{
+    MchpFreqmState *s = opaque;
+    uint64_t count = fm_count(s, fm_refnum(s));
+
+    if (count > VALUE_MASK) {
+        fm_set_reg(s, A_MCHP_FREQM_STATUS, 1,
+                   fm_reg(s, A_MCHP_FREQM_STATUS, 1) |
+                   R_MCHP_FREQM_STATUS_OVF_MASK);
+    }
+    fm_set_reg(s, A_MCHP_FREQM_VALUE, 4, count & VALUE_MASK);
+    fm_set_busy(s, false);
+    fm_set_reg(s, A_MCHP_FREQM_INTFLAG, 1,
+               fm_reg(s, A_MCHP_FREQM_INTFLAG, 1) |
+               R_MCHP_FREQM_INTFLAG_DONE_MASK);
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void fm_abort(MchpFreqmState *s)
+{
+    timer_del(s->timer);
+    s->waiting = false;
+    fm_set_busy(s, false);
+}
+
+static uint32_t fm_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                            unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpFreqmState *s = MCHP_FREQM(rf->opaque);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    /* VALUE: the count so far while measuring */
+    if (s->busy) {
+        uint64_t msr = clock_get(MCHP_REGBLOCK(s)->gclk);
+        uint64_t lo, hi;
+
+        if (s->waiting || now < s->window_ns || !msr) {
+            return 0;
+        }
+        mulu64(&lo, &hi, now - s->window_ns, 1ULL << 32);
+        divu128(&lo, &hi, msr);
+        return lo & VALUE_MASK;
+    }
+    return stored;
+}
+
+static void fm_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                          unsigned idx, uint32_t old, uint32_t written,
+                          uint32_t we)
+{
+    MchpFreqmState *s = MCHP_FREQM(rf->opaque);
+
+    switch (ri->offset) {
+    case A_MCHP_FREQM_CTRLA:
+        if (!fm_on(s) && (old & R_MCHP_FREQM_CTRLA_ENABLE_MASK)) {
+            /* Silicon: no DONE, VALUE and OVF cleared */
+            fm_abort(s);
+            fm_set_reg(s, A_MCHP_FREQM_VALUE, 4, 0);
+            fm_set_reg(s, A_MCHP_FREQM_STATUS, 1, 0);
+        }
+        break;
+    case A_MCHP_FREQM_CTRLB:
+        if ((written & we & R_MCHP_FREQM_CTRLB_START_MASK) && fm_on(s) &&
+            !s->busy) {
+            fm_set_busy(s, true);
+            fm_arm(s);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void fm_ref_update(void *opaque, ClockEvent event)
+{
+    MchpFreqmState *s = opaque;
+
+    if (!s->busy) {
+        return;
+    }
+    if (!clock_get(s->ref)) {
+        timer_del(s->timer);            /* stalls until it runs again */
+        s->waiting = true;
+    } else if (s->waiting) {
+        fm_arm(s);                      /* the whole window from now */
+    }
+}
+
+static void fm_reset_hold(MchpRegBlock *rb)
+{
+    MchpFreqmState *s = MCHP_FREQM(rb);
+
+    timer_del(s->timer);
+    s->busy = false;
+    s->waiting = false;
+}
+
+static void fm_init(Object *obj)
+{
+    MchpFreqmState *s = MCHP_FREQM(obj);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, fm_done, s);
+    s->ref = qdev_init_clock_in(DEVICE(obj), MCHP_FREQM_REF_CLOCK,
+                                fm_ref_update, s, ClockUpdate);
+}
+
+static void fm_finalize(Object *obj)
+{
+    timer_free(MCHP_FREQM(obj)->timer);
+}
+
+static const VMStateDescription vmstate_mchp_freqm = {
+    .name = TYPE_MCHP_FREQM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpFreqmState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_BOOL(busy, MchpFreqmState),
+        VMSTATE_BOOL(waiting, MchpFreqmState),
+        VMSTATE_INT64(window_ns, MchpFreqmState),
+        VMSTATE_TIMER_PTR(timer, MchpFreqmState),
+        VMSTATE_CLOCK(ref, MchpFreqmState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void fm_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_freqm;
+    c->pre_read = fm_pre_read;
+    c->post_write = fm_post_write;
+    c->reset_hold = fm_reset_hold;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_freqm_types[] = {
+    {
+        .name = TYPE_MCHP_FREQM,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpFreqmState),
+        .instance_init = fm_init,
+        .instance_finalize = fm_finalize,
+        .class_init = fm_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_freqm_types)
