 }
 
+void mchp_regblock_set_clock_period(MchpRegBlock *s, Clock *out,
+                                    uint64_t period)
+{
+    if (clock_set(out, period)) {
+        trace_mchp_clk_update(s->name,
+                              object_get_canonical_path_component(OBJECT(out)),
+                              clock_get_hz(out));
+        clock_propagate(out);
+    }
+}
+
