diff --git a/tests/qtest/pic32cm-freqm-test.c b/tests/qtest/pic32cm-freqm-test.c
new file mode 100644
index 0000000..ed8968d
--- /dev/null
+++ b/tests/qtest/pic32cm-freqm-test.c
@@ -0,0 +1,111 @@
+/*
+ * QTest for the frequency meter of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The FREQM model on stepped virtual time: the count, the window, a
+ * missing reference clock, and the exact generator periods it relies on.
+ * firmware/hello APP=freqm checks the rest against silicon.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+
+#define OSCCTRL         0x40001000
+#define GCLK            0x40001C00
+#define FREQM           0x40002C00
+#define PCH_MSR         3
+#define PCH_REF         4
+
+#define R_CTRLA         0x00
+#define R_CTRLB         0x01
+#define R_CFGA          0x02
+#define R_INTFLAG       0x0A
+#define R_STATUS        0x0B
+#define R_VALUE         0x10
+
+#define GEN_OSC48M      (6 | BIT(8))    /* SRC OSC48M, GENEN */
+#define DIVSEL          BIT(12)
+#define DIV(n)          ((uint32_t)(n) << 16)
+#define CHEN            BIT(6)
+#define BUSY            0x01
+#define OVF             0x02
+
+/* 48 MHz on GCLK2 (MSR), @ref_genctrl on GCLK1 (REF), REFNUM @refnum */
+static QTestState *freqm_init(uint32_t ref_genctrl, uint8_t refnum)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writeb(qts, OSCCTRL + 0x15, 0);                   /* 48 MHz */
+    qtest_writel(qts, GCLK + 0x20 + 4 * 1, ref_genctrl);
+    qtest_writel(qts, GCLK + 0x20 + 4 * 2, GEN_OSC48M);
+    qtest_writel(qts, GCLK + 0x80 + 4 * PCH_MSR, CHEN | 2);
+    qtest_writel(qts, GCLK + 0x80 + 4 * PCH_REF, CHEN | 1);
+    qtest_writew(qts, FREQM + R_CFGA, refnum);
+    qtest_writeb(qts, FREQM + R_CTRLA, 0x02);
+    return qts;
+}
+
+/* REFNUM * f_MSR / f_REF after REFNUM + 2.5 reference periods */
+static void test_measure(void)
+{
+    QTestState *qts = freqm_init(GEN_OSC48M | DIV(1024), 255);
+
+    qtest_writeb(qts, FREQM + R_CTRLB, 1);
+    g_assert_cmphex(qtest_readb(qts, FREQM + R_STATUS), ==, BUSY);
+    qtest_clock_step(qts, 5480000);             /* 257.5 / 46875 Hz: 5.493 ms */
+    g_assert_cmphex(qtest_readb(qts, FREQM + R_STATUS), ==, BUSY);
+    g_assert_cmpuint(qtest_readl(qts, FREQM + R_VALUE), >, 250000);
+    qtest_clock_step(qts, 20000);
+    g_assert_cmphex(qtest_readb(qts, FREQM + R_STATUS), ==, 0);
+    g_assert_cmphex(qtest_readb(qts, FREQM + R_INTFLAG), ==, 1);
+    g_assert_cmpuint(qtest_readl(qts, FREQM + R_VALUE), ==, 261120);
+    qtest_quit(qts);
+}
+
+/* 48 MHz / 2^17 stays exact through the generator: 0xFE0000 and OVF */
+static void test_overflow(void)
+{
+    QTestState *qts = freqm_init(GEN_OSC48M | DIVSEL | DIV(16), 255);
+
+    qtest_writeb(qts, FREQM + R_CTRLB, 1);
+    qtest_clock_step(qts, 800000000);
+    g_assert_cmphex(qtest_readl(qts, FREQM + R_VALUE), ==, 0xFE0000);
+    g_assert_cmphex(qtest_readb(qts, FREQM + R_STATUS), ==, OVF);
+    qtest_writeb(qts, FREQM + R_CTRLA, 0);       /* disabling clears OVF */
+    g_assert_cmphex(qtest_readb(qts, FREQM + R_STATUS), ==, 0);
+    qtest_quit(qts);
+}
+
+/* Without a reference clock it waits, then measures a whole window */
+static void test_no_reference(void)
+{
+    QTestState *qts = freqm_init(GEN_OSC48M | DIV(1024), 16);
+
+    qtest_writel(qts, GCLK + 0x80 + 4 * PCH_REF, 1);         /* CHEN off */
+    qtest_writeb(qts, FREQM + R_CTRLB, 1);
+    qtest_clock_step(qts, 100000000);
+    g_assert_cmphex(qtest_readb(qts, FREQM + R_STATUS), ==, BUSY);
+    qtest_writel(qts, GCLK + 0x80 + 4 * PCH_REF, CHEN | 1);
+    qtest_clock_step(qts, 390000);              /* 18.5 periods: 394.7 us */
+    g_assert_cmphex(qtest_readb(qts, FREQM + R_STATUS), ==, BUSY);
+    qtest_clock_step(qts, 10000);
+    g_assert_cmphex(qtest_readb(qts, FREQM + R_STATUS), ==, 0);
+    g_assert_cmpuint(qtest_readl(qts, FREQM + R_VALUE), ==, 16 * 1024);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-freqm/measure", test_measure);
+    qtest_add_func("pic32cm-freqm/overflow", test_overflow);
+    qtest_add_func("pic32cm-freqm/no-reference", test_no_reference);
+    return g_test_run();
+}
