diff --git a/tests/qtest/pic32cm-dac-test.c b/tests/qtest/pic32cm-dac-test.c
new file mode 100644
index 0000000..3e7b26c
--- /dev/null
+++ b/tests/qtest/pic32cm-dac-test.c
@@ -0,0 +1,219 @@
+/*
+ * QTest for the DAC of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The U2214 model's DATABUF path: EMPTY at the enable, START events,
+ * UNDERRUN, SYNCBUSY while DATABUF is full, dithering's rhythm and the
+ * EMPTY DMA request. firmware/hello APP=dacbuf checks the same against
+ * silicon.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qemu/bswap.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+
+#define DAC             0x42005400
+#define DAC_PATH        "/machine/soc/dac"
+#define R_CTRLA         0x00
+#define R_CTRLB         0x01
+#define R_EVCTRL        0x02
+#define R_INTFLAG       0x06
+#define R_DATA          0x08
+#define R_DATABUF       0x0C
+#define R_SYNCBUSY      0x10
+
+#define ENABLE          BIT(1)
+#define OUT_VDD         0x41            /* EOEN, REFSEL VDDANA */
+#define DITHER          BIT(5)
+#define STARTEI         BIT(0)
+#define EMPTYEO         BIT(1)
+#define INVEI           BIT(2)
+#define UNDERRUN        BIT(0)
+#define EMPTY           BIT(1)
+#define SB_DATA_BUF     0x0C            /* SYNCBUSY.DATA | DATABUF */
+
+#define DMAC            0x41006000
+#define DESC            0x20001000
+#define WB              0x20001100
+#define SRC             0x20001200
+#define TRIG_DAC_EMPTY  39
+
+static QTestState *dac_init(uint8_t ctrlb, uint8_t evctrl)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writeb(qts, DAC + R_CTRLB, ctrlb);
+    qtest_writeb(qts, DAC + R_EVCTRL, evctrl);
+    qtest_writeb(qts, DAC + R_CTRLA, ENABLE);
+    return qts;
+}
+
+static int vout(QTestState *qts)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': '" DAC_PATH "',"
+                           " 'property': 'vout' } }");
+    int mv = qdict_get_int(rsp, "return");
+
+    qobject_unref(rsp);
+    return mv;
+}
+
+/* VDDANA 3.3 V: @code16 sixteenths of a code in mV */
+static int mv16(int code16)
+{
+    return (int64_t)code16 * 3300 / (1023 * 16);
+}
+
+static void start(QTestState *qts)
+{
+    qtest_set_irq_in(qts, DAC_PATH, "start-event-in", 0, 1);
+    qtest_set_irq_in(qts, DAC_PATH, "start-event-in", 0, 0);
+}
+
+/* @flags were set, then cleared */
+static uint8_t flags(QTestState *qts)
+{
+    uint8_t f = qtest_readb(qts, DAC + R_INTFLAG);
+
+    qtest_writeb(qts, DAC + R_INTFLAG, f);
+    return f;
+}
+
+/* Every enable sets EMPTY; a DATA write clears it */
+static void test_empty_at_enable(void)
+{
+    QTestState *qts = dac_init(OUT_VDD, 0);
+
+    g_assert_cmphex(flags(qts), ==, EMPTY);
+    qtest_writeb(qts, DAC + R_CTRLA, 0);
+    g_assert_cmphex(flags(qts), ==, 0);
+    qtest_writeb(qts, DAC + R_CTRLA, ENABLE);
+    g_assert_cmphex(qtest_readb(qts, DAC + R_INTFLAG), ==, EMPTY);
+    qtest_writew(qts, DAC + R_DATA, 200);
+    g_assert_cmphex(qtest_readb(qts, DAC + R_INTFLAG), ==, 0);
+    g_assert_cmpint(vout(qts), ==, mv16(200 << 4));
+    qtest_quit(qts);
+}
+
+/*
+ * DATABUF waits for START, SYNCBUSY.DATA/DATABUF set meanwhile and DATA
+ * writes dropped; a START with DATABUF empty underruns
+ */
+static void test_databuf_start(void)
+{
+    QTestState *qts = dac_init(OUT_VDD, STARTEI);
+
+    flags(qts);
+    qtest_writew(qts, DAC + R_DATABUF, 700);
+    g_assert_cmphex(qtest_readl(qts, DAC + R_SYNCBUSY), ==, SB_DATA_BUF);
+    qtest_writew(qts, DAC + R_DATA, 100);           /* dropped */
+    qtest_writew(qts, DAC + R_DATABUF, 900);        /* dropped */
+    g_assert_cmpint(vout(qts), ==, 0);
+    start(qts);
+    g_assert_cmpint(vout(qts), ==, mv16(700 << 4));
+    g_assert_cmphex(qtest_readl(qts, DAC + R_SYNCBUSY), ==, 0);
+    g_assert_cmphex(flags(qts), ==, EMPTY);
+    start(qts);
+    g_assert_cmphex(flags(qts), ==, EMPTY | UNDERRUN);
+    g_assert_cmpint(vout(qts), ==, mv16(700 << 4));
+    qtest_quit(qts);
+}
+
+/* INVEI: the falling edge starts */
+static void test_invei(void)
+{
+    QTestState *qts = dac_init(OUT_VDD, STARTEI | INVEI);
+
+    qtest_writew(qts, DAC + R_DATABUF, 300);
+    qtest_set_irq_in(qts, DAC_PATH, "start-event-in", 0, 1);
+    g_assert_cmpint(vout(qts), ==, 0);
+    qtest_set_irq_in(qts, DAC_PATH, "start-event-in", 0, 0);
+    g_assert_cmpint(vout(qts), ==, mv16(300 << 4));
+    qtest_quit(qts);
+}
+
+/*
+ * DITHER: the code in sixteenths; DATABUF moves at any START, EMPTY every
+ * 16th START, UNDERRUN on the START opening a group
+ */
+static void test_dither(void)
+{
+    QTestState *qts = dac_init(OUT_VDD | DITHER, STARTEI);
+    uint32_t e = 0, u = 0;
+
+    qtest_writew(qts, DAC + R_DATABUF, (300 << 4) | 8);
+    flags(qts);
+    for (unsigned k = 0; k < 32; k++) {
+        uint8_t f;
+
+        start(qts);
+        f = flags(qts);
+        e |= (uint32_t)!!(f & EMPTY) << k;
+        u |= (uint32_t)!!(f & UNDERRUN) << k;
+        if (k == 0) {
+            g_assert_cmpint(vout(qts), ==, mv16((300 << 4) | 8));
+            qtest_writew(qts, DAC + R_DATABUF, (600 << 4) | 4);
+        } else if (k == 1) {
+            g_assert_cmpint(vout(qts), ==, mv16((600 << 4) | 4));
+        }
+    }
+    g_assert_cmphex(e, ==, 0x80008000);
+    g_assert_cmphex(u, ==, 0x00010000);
+    qtest_quit(qts);
+}
+
+/* EMPTY requests DMA: a beat at the enable, then one per START */
+static void test_dma(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    uint8_t d[16];
+
+    for (unsigned i = 0; i < 4; i++) {
+        qtest_writew(qts, SRC + 2 * i, 100 + 200 * i);
+    }
+    stw_le_p(&d[0], 0x0401 | (1 << 8));     /* VALID, HWORD, SRCINC */
+    stw_le_p(&d[2], 4);
+    stl_le_p(&d[4], SRC + 8);
+    stl_le_p(&d[8], DAC + R_DATABUF);
+    stl_le_p(&d[12], 0);
+    qtest_memwrite(qts, DESC, d, sizeof(d));
+    qtest_writel(qts, DMAC + 0x34, DESC);
+    qtest_writel(qts, DMAC + 0x38, WB);
+    qtest_writew(qts, DMAC + 0x00, 0x0F02);
+    qtest_writeb(qts, DMAC + 0x3F, 0);
+    qtest_writel(qts, DMAC + 0x44, (TRIG_DAC_EMPTY << 8) | (2 << 22));
+    qtest_writeb(qts, DMAC + 0x40, 0x02);
+    qtest_writeb(qts, DAC + R_CTRLB, OUT_VDD);
+    qtest_writeb(qts, DAC + R_EVCTRL, STARTEI);
+    qtest_writeb(qts, DAC + R_CTRLA, ENABLE);
+    qtest_clock_step(qts, 1000);
+    g_assert_cmphex(qtest_readl(qts, DAC + R_SYNCBUSY), ==, SB_DATA_BUF);
+    for (unsigned i = 0; i < 4; i++) {
+        start(qts);
+        qtest_clock_step(qts, 1000);
+        g_assert_cmpint(vout(qts), ==, mv16((100 + 200 * i) << 4));
+    }
+    g_assert_cmphex(qtest_readb(qts, DMAC + 0x4E), ==, 0x02);     /* TCMPL */
+    g_assert_cmphex(qtest_readb(qts, DAC + R_INTFLAG), ==, EMPTY);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-dac/empty-at-enable", test_empty_at_enable);
+    qtest_add_func("pic32cm-dac/databuf-start", test_databuf_start);
+    qtest_add_func("pic32cm-dac/invei", test_invei);
+    qtest_add_func("pic32cm-dac/dither", test_dither);
+    qtest_add_func("pic32cm-dac/dma", test_dma);
+    return g_test_run();
+}
