diff --git a/hw/misc/mchp_dac_u2214.c b/hw/misc/mchp_dac_u2214.c
index 4d382b3..91cd506 100644
--- a/hw/misc/mchp_dac_u2214.c
+++ b/hw/misc/mchp_dac_u2214.c
@@ -12,15 +12,34 @@
  * parts: the ADC reads it back there, see mchp_dac_u2214_vout_mv()); with
  * IOEN it feeds the ADC as its DAC reference and the AC as its DAC input
  * (mchp_dac_u2214_add_notifier() hears of changes). STATUS.READY reads 1
- * while enabled, and SYNCBUSY never shows busy. "vout" (read-only) is the
- * VOUT pin's voltage in mV, -1 while the DAC does not drive it.
+ * while enabled. "vout" (read-only) is the VOUT pin's voltage in mV, -1
+ * while the DAC does not drive it.
  *
- * Checked on PIC32CM MC00 silicon (firmware/hello APP=dac, read back by
- * ADC0 on PA02): linear from 0 to 1023 against VDDANA, INTREF full scale
- * at 1.02 V, READY set at once after enable. Silicon's offset of about 15
- * mV at code 0 is not modelled. Not modelled: DATABUF with START events
- * (logged), the EMPTY and UNDERRUN flags, dithering, VPD, the
- * conversion time.
+ * DATABUF and START, as PIC32CM MC00 silicon did (firmware/hello
+ * APP=dacprobe..dacprobe3):
+ *
+ *   - Every enable sets INTFLAG.EMPTY, whatever DATABUF holds.
+ *   - A DATABUF write (enabled or not) fills the buffer and clears EMPTY;
+ *     SYNCBUSY.DATA and DATABUF then read 1 until a START event moves it
+ *     into DATA, and DATA or DATABUF writes meanwhile are dropped (the
+ *     data sheet's rule for writes during synchronization). A DATA write
+ *     clears EMPTY too.
+ *   - A START event (EVCTRL.STARTEI; rising edge, falling with INVEI)
+ *     moves a full DATABUF into DATA. Without dithering every START sets
+ *     EMPTY, and one finding DATABUF empty sets UNDERRUN as well.
+ *   - CTRLB.DITHER: DATA[13:0] (DATA[15:2] with LEFTADJ) is the code in
+ *     sixteenths; the output is their average. A full DATABUF still moves
+ *     at any START, but EMPTY comes every 16th START from the enable, and
+ *     UNDERRUN only on the START opening a group of 16 with DATABUF empty.
+ *   - Setting EMPTY pulses "empty-event" (with EVCTRL.EMPTYEO) and is the
+ *     EMPTY DMA request (a level, wired by the SoC).
+ *
+ * Checked on PIC32CM MC00 silicon (APP=dac, read back by ADC0 on PA02):
+ * linear from 0 to 1023 against VDDANA, INTREF full scale at 1.02 V,
+ * READY set at once after enable. Silicon's offset of about 15 mV at code
+ * 0 is not modelled. Not modelled: the dithered output's sub-conversion
+ * steps (the average only), VPD, the conversion time, standby (EMPTY set
+ * on wake-up), the bus error of a write dropped during synchronization.
  *
  * SPDX-License-Identifier: GPL-2.0-or-later
  */
@@ -29,6 +48,8 @@
 #include "qapi/error.h"
 #include "qapi/visitor.h"
 #include "qemu/log.h"
+#include "hw/core/irq.h"
+#include "hw/dma/mchp_dmac.h"
 #include "hw/misc/mchp_dac.h"
 #include "hw/misc/mchp_sysctrl.h"
 #include "hw/mchp/gen/dac_u2214.h"
@@ -37,13 +58,19 @@
 /* SUPC VREF (hw/mchp/gen/supc_u2117.h): SEL bits 16-19 */
 #define SUPC_VREF_OFFSET    0x1C
 #define SUPC_VREF_SEL(v)    extract32(v, 16, 4)
+#define DAC_GROUP           16          /* dithered sub-conversions */
 
 OBJECT_DECLARE_SIMPLE_TYPE(MchpDacU2214State, MCHP_DAC_U2214)
 
 struct MchpDacU2214State {
     MchpRegBlock parent_obj;
 
-    uint16_t code;              /* the converted 10-bit code */
+    uint16_t code16;            /* the converted code, in sixteenths */
+    uint16_t databuf;           /* DATABUF as written */
+    bool full;                  /* DATABUF waits for a START */
+    uint8_t sub;                /* STARTs into the dithering group */
+    bool start_level;           /* the START event input */
+    qemu_irq empty_event;
     int32_t vdd_mv;
     int32_t vrefa_mv;           /* < 0: VDDANA */
     MchpRegBlock *supc;         /* the SUPC, for VREF (found on first use) */
@@ -55,6 +82,12 @@ static uint32_t dac_reg(MchpDacU2214State *s, hwaddr off, unsigned size)
     return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
 }
 
+static void dac_set(MchpDacU2214State *s, hwaddr off, unsigned size,
+                    uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
 static int32_t dac_ref_mv(MchpDacU2214State *s)
 {
     uint32_t vref;
@@ -84,10 +117,28 @@ static bool dac_enabled(MchpDacU2214State *s)
                       ENABLE);
 }
 
+static bool dac_dither(MchpDacU2214State *s)
+{
+    return FIELD_EX32(dac_reg(s, A_MCHP_DAC_CTRLB, 1), MCHP_DAC_CTRLB,
+                      DITHER);
+}
+
+/* A DATA or DATABUF value in sixteenths of a code (DS Table 39-1) */
+static uint16_t dac_value16(MchpDacU2214State *s, uint16_t v)
+{
+    bool left = FIELD_EX32(dac_reg(s, A_MCHP_DAC_CTRLB, 1), MCHP_DAC_CTRLB,
+                           LEFTADJ);
+
+    if (dac_dither(s)) {
+        return (left ? v >> 2 : v) & 0x3FFF;
+    }
+    return (left ? v >> 6 : v & 0x3FF) << 4;
+}
+
 /* The output voltage while enabled, in mV */
 static int32_t dac_out_mv(MchpDacU2214State *s)
 {
-    return (int64_t)s->code * dac_ref_mv(s) / 1023;
+    return (int64_t)s->code16 * dac_ref_mv(s) / (1023 * DAC_GROUP);
 }
 
 int32_t mchp_dac_u2214_vout_mv(DeviceState *dev)
@@ -113,15 +164,74 @@ void mchp_dac_u2214_add_notifier(DeviceState *dev, Notifier *n)
     notifier_list_add(&MCHP_DAC_U2214(dev)->changed, n);
 }
 
+static void dac_flags(MchpDacU2214State *s, uint8_t set, uint8_t clear)
+{
+    dac_set(s, A_MCHP_DAC_INTFLAG, 1,
+            (dac_reg(s, A_MCHP_DAC_INTFLAG, 1) & ~clear) | set);
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+/* DATABUF can take new data: the flag, the event and the DMA request */
+static void dac_empty(MchpDacU2214State *s)
+{
+    dac_flags(s, R_MCHP_DAC_INTFLAG_EMPTY_MASK, 0);
+    if (FIELD_EX32(dac_reg(s, A_MCHP_DAC_EVCTRL, 1), MCHP_DAC_EVCTRL,
+                   EMPTYEO)) {
+        qemu_irq_pulse(s->empty_event);
+    }
+    mchp_dmac_kick_machine();
+}
+
+static void dac_start(MchpDacU2214State *s)
+{
+    bool dither = dac_dither(s);
+    bool opens = s->sub == 0;           /* the first START of a group */
+
+    if (s->full) {
+        s->code16 = dac_value16(s, s->databuf);
+        s->full = false;
+        notifier_list_notify(&s->changed, NULL);
+    } else if (!dither || opens) {
+        dac_flags(s, R_MCHP_DAC_INTFLAG_UNDERRUN_MASK, 0);
+    }
+    if (dither) {
+        s->sub = (s->sub + 1) % DAC_GROUP;
+        if (s->sub == 0) {
+            dac_empty(s);               /* every 16th START */
+        }
+    } else {
+        dac_empty(s);
+    }
+}
+
+/* "start-event-in": the START event, on the edge EVCTRL.INVEI selects */
+static void dac_start_event(void *opaque, int n, int level)
+{
+    MchpDacU2214State *s = opaque;
+    uint8_t ev = dac_reg(s, A_MCHP_DAC_EVCTRL, 1);
+    bool edge = FIELD_EX32(ev, MCHP_DAC_EVCTRL, INVEI) ?
+                s->start_level && level <= 0 : !s->start_level && level > 0;
+
+    s->start_level = level > 0;
+    if (edge && dac_enabled(s) && FIELD_EX32(ev, MCHP_DAC_EVCTRL, STARTEI)) {
+        dac_start(s);
+    }
+}
+
 static uint32_t dac_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
                              unsigned idx, uint32_t stored, bool side_effects)
 {
     MchpDacU2214State *s = MCHP_DAC_U2214(rf->opaque);
 
-    if (ri->offset == A_MCHP_DAC_STATUS) {
+    switch (ri->offset) {
+    case A_MCHP_DAC_STATUS:
         return dac_enabled(s) ? R_MCHP_DAC_STATUS_READY_MASK : 0;
+    case A_MCHP_DAC_SYNCBUSY:
+        return s->full ? R_MCHP_DAC_SYNCBUSY_DATA_MASK |
+                         R_MCHP_DAC_SYNCBUSY_DATABUF_MASK : 0;
+    default:
+        return stored;
     }
-    return stored;              /* SYNCBUSY: idle, writes are instant */
 }
 
 static void dac_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
@@ -129,14 +239,33 @@ static void dac_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
                            uint32_t we)
 {
     MchpDacU2214State *s = MCHP_DAC_U2214(rf->opaque);
-    uint16_t data = dac_reg(s, A_MCHP_DAC_DATA, 2);
-
-    if (ri->offset == A_MCHP_DAC_DATA) {
-        s->code = FIELD_EX32(dac_reg(s, A_MCHP_DAC_CTRLB, 1), MCHP_DAC_CTRLB,
-                             LEFTADJ) ? data >> 6 : data & 0x3FF;
-    } else if (ri->offset == A_MCHP_DAC_DATABUF) {
-        qemu_log_mask(LOG_UNIMP, "%s: DATABUF (START events) not "
-                      "modelled\n", MCHP_REGBLOCK(s)->name);
+    uint16_t v = written & we;
+
+    switch (ri->offset) {
+    case A_MCHP_DAC_CTRLA:
+        if (!(written & we & R_MCHP_DAC_CTRLA_SWRST_MASK) &&
+            !(old & R_MCHP_DAC_CTRLA_ENABLE_MASK) && dac_enabled(s)) {
+            s->sub = 0;
+            dac_empty(s);               /* DATABUF counts as empty */
+        }
+        break;
+    case A_MCHP_DAC_DATA:
+        if (s->full) {
+            break;                      /* dropped: DATA synchronizes */
+        }
+        s->code16 = dac_value16(s, v);
+        dac_flags(s, 0, R_MCHP_DAC_INTFLAG_EMPTY_MASK);
+        break;
+    case A_MCHP_DAC_DATABUF:
+        if (s->full) {
+            break;                      /* dropped: DATABUF synchronizes */
+        }
+        s->databuf = v;
+        s->full = true;
+        dac_flags(s, 0, R_MCHP_DAC_INTFLAG_EMPTY_MASK);
+        break;
+    default:
+        break;
     }
     notifier_list_notify(&s->changed, NULL);    /* DATA, CTRLA, CTRLB */
 }
@@ -145,7 +274,10 @@ static void dac_reset_hold(MchpRegBlock *rb)
 {
     MchpDacU2214State *s = MCHP_DAC_U2214(rb);
 
-    s->code = 0;
+    s->code16 = 0;
+    s->databuf = 0;
+    s->full = false;
+    s->sub = 0;
     notifier_list_notify(&s->changed, NULL);
 }
 
@@ -176,6 +308,10 @@ static void dac_init(Object *obj)
     s->vdd_mv = 3300;
     s->vrefa_mv = -1;
     notifier_list_init(&s->changed);
+    qdev_init_gpio_in_named(DEVICE(obj), dac_start_event,
+                            MCHP_DAC_START_EVENT_IN, 1);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->empty_event,
+                             MCHP_DAC_EMPTY_EVENT, 1);
     object_property_add(obj, "vout", "int32", dac_get_vout, NULL, NULL,
                         NULL);
     object_property_add(obj, "vdd", "int32", dac_get_i32, dac_set_i32, NULL,
@@ -186,12 +322,16 @@ static void dac_init(Object *obj)
 
 static const VMStateDescription vmstate_mchp_dac_u2214 = {
     .name = TYPE_MCHP_DAC_U2214,
-    .version_id = 1,
-    .minimum_version_id = 1,
+    .version_id = 2,
+    .minimum_version_id = 2,
     .fields = (const VMStateField[]) {
         VMSTATE_STRUCT(parent_obj, MchpDacU2214State, 1,
                        vmstate_mchp_regblock, MchpRegBlock),
-        VMSTATE_UINT16(code, MchpDacU2214State),
+        VMSTATE_UINT16(code16, MchpDacU2214State),
+        VMSTATE_UINT16(databuf, MchpDacU2214State),
+        VMSTATE_BOOL(full, MchpDacU2214State),
+        VMSTATE_UINT8(sub, MchpDacU2214State),
+        VMSTATE_BOOL(start_level, MchpDacU2214State),
         VMSTATE_INT32(vdd_mv, MchpDacU2214State),
         VMSTATE_INT32(vrefa_mv, MchpDacU2214State),
         VMSTATE_END_OF_LIST()
