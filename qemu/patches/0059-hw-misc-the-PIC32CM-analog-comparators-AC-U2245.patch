diff --git a/hw/gpio/mchp_port.c b/hw/gpio/mchp_port.c
index 46e2545..e703902 100644
--- a/hw/gpio/mchp_port.c
+++ b/hw/gpio/mchp_port.c
@@ -636,6 +636,24 @@ void mchp_port_watch(DeviceState *port, unsigned pin, MchpPadWatchFn *fn,
     }
 }
 
+bool mchp_port_pad_driven(DeviceState *port, unsigned pin, bool *level)
+{
+    MchpPortState *s = MCHP_PORT(port);
+    unsigned g = pin / MCHP_PORT_GROUP_PINS, bit = pin % MCHP_PORT_GROUP_PINS;
+    uint32_t plevel, driven;
+
+    *level = false;
+    if (g >= s->ngroups) {
+        return false;
+    }
+    driven = mchp_port_drive_mask(s, g) | mchp_port_periph(s, g, &plevel);
+    if (!extract32(driven, bit, 1)) {
+        return false;
+    }
+    *level = extract32(mchp_port_pads(s, g), bit, 1);
+    return true;
+}
