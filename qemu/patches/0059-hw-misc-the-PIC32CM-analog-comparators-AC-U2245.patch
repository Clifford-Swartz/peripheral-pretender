+static void ac_init(Object *obj)
+{
+    MchpAcU2245State *s = MCHP_AC_U2245(obj);
+    static QEMUTimerCB *const cbs[AC_MAX] = {
+        ac_start_timer0, ac_start_timer1, ac_start_timer2, ac_start_timer3,
+    };
+
+    for (unsigned n = 0; n < AC_MAX; n++) {
+        s->start_timer[n] = timer_new_ns(QEMU_CLOCK_VIRTUAL, cbs[n], s);
+    }
+    for (unsigned i = 0; i < AC_NAIN; i++) {
+        s->ain_mv[i] = -1;
+        s->ain_pad[i] = -1;
+    }
+    s->vdd_mv = 3300;
+    qdev_init_gpio_out_named(DEVICE(obj), s->comp_event, MCHP_AC_COMP_EVENT,
+                             AC_MAX);
+    qdev_init_gpio_out_named(DEVICE(obj), s->win_event, MCHP_AC_WIN_EVENT,
+                             AC_MAX / 2);
+    qdev_init_gpio_out_named(DEVICE(obj), s->pad_cmp, MCHP_AC_PAD_CMP,
+                             AC_MAX);
+    qdev_init_gpio_in_named(DEVICE(obj), ac_soc_event, MCHP_AC_SOC_EVENT_IN,
+                            AC_MAX);
+    object_property_add_str(obj, "ain", ac_get_ain, ac_set_ain);
+    object_property_add_str(obj, "ain-pads", ac_get_pads, ac_set_pads);
+    object_property_add(obj, "ain-default", "int32", ac_get_i32, ac_set_i32,
+                        NULL, &s->ain_default);
+    object_property_add(obj, "vdd", "int32", ac_get_i32, ac_set_i32, NULL,
+                        &s->vdd_mv);
+}
+
+static void ac_finalize(Object *obj)
+{
+    MchpAcU2245State *s = MCHP_AC_U2245(obj);
+
+    for (unsigned n = 0; n < AC_MAX; n++) {
+        timer_free(s->start_timer[n]);
+    }
