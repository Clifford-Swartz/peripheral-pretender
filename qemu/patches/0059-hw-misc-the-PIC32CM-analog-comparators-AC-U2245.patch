+/*
+ * Analog inputs on the pads: a model with a string property "group-pads"
+ * (lower case, for example the AC's "ain-pads") gets the PORT pin of each
+ * of its signals GROUP[0], GROUP[1], ... as "pin,pin,...", -1 where the
+ * device has none. It reads the pad's level when the PORT drives it.
+ */
+static void pic32cm_analog_pads(Pic32cmSocState *s)
+{
+    for (unsigned i = 0; i < s->dev->ninstances; i++) {
+        DeviceState *dev = s->periph[i];
+        const char *inst = s->dev->instances[i].name;
+        g_autoptr(GHashTable) done = g_hash_table_new_full(g_str_hash,
+                                                           g_str_equal,
+                                                           g_free, NULL);
+
+        for (unsigned j = 0; dev && j < s->dev->nsignals; j++) {
+            const MchpSignalInfo *sig = &s->dev->signals[j];
+            g_autofree char *grp = g_ascii_strdown(sig->group, -1);
+            g_autofree char *prop = g_strdup_printf("%s-pads", grp);
+            g_autoptr(GString) val = NULL;
+            int pins[32];
+            int max = -1;
+
+            if (strcmp(sig->instance, inst) ||
+                g_hash_table_contains(done, prop) ||
+                !object_property_find(OBJECT(dev), prop)) {
+                continue;
+            }
+            for (unsigned k = 0; k < ARRAY_SIZE(pins); k++) {
+                pins[k] = -1;
+            }
+            for (unsigned k = j; k < s->dev->nsignals; k++) {
+                const MchpSignalInfo *o = &s->dev->signals[k];
+
+                if (!strcmp(o->instance, inst) &&
+                    !strcmp(o->group, sig->group) && o->index >= 0 &&
+                    o->index < ARRAY_SIZE(pins) && o->pin >= 0 &&
+                    pins[o->index] < 0) {
+                    pins[o->index] = o->pin;
+                    max = MAX(max, o->index);
+                }
+            }
+            val = g_string_new(NULL);
+            for (int k = 0; k <= max; k++) {
+                g_string_append_printf(val, "%s%d", k ? "," : "", pins[k]);
+            }
+            object_property_set_str(OBJECT(dev), prop, val->str,
+                                    &error_abort);
+            g_hash_table_add(done, g_steal_pointer(&prop));
+        }
+    }
+}
