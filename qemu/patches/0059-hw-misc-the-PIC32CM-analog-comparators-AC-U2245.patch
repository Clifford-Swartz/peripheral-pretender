diff --git a/tests/qtest/pic32cm-ac-test.c b/tests/qtest/pic32cm-ac-test.c
new file mode 100644
index 0000000..1bb255b
--- /dev/null
+++ b/tests/qtest/pic32cm-ac-test.c
@@ -0,0 +1,209 @@
+/*
+ * QTest for the analog comparators of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The board side of the AC model: pad voltages from the "ain" property,
+ * the machine's vcc option, a GPIO-driven pad, start-up times on stepped
+ * virtual time and the interrupt. firmware/hello APP=ac checks the rest
+ * against silicon.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+#define AC_PATH         "/machine/soc/ac"
+
+#define AC              0x42005000
+#define PA              0x41000000
+#define NVIC_ISPR       0xE000E200
+#define AC_IRQ          23
+
+#define R_CTRLA         0x00
+#define R_INTENSET      0x05
+#define R_INTFLAG       0x06
+#define R_STATUSA       0x07
+#define R_STATUSB       0x08
+#define R_SCALER0       0x0C
+#define R_COMPCTRL0     0x10
+
+#define P_DIRSET        0x08
+#define P_OUTCLR        0x14
+#define P_OUTSET        0x18
+
+#define CTRLA_ENABLE    BIT(1)
+#define EN              BIT(1)
+#define INTSEL(x)       ((x) << 3)
+#define NEG(x)          ((x) << 8)
+#define POS(x)          ((x) << 12)
+#define HIGH            (3 << 16)
+#define HYSTEN          BIT(19)
+#define AIN0            0
+#define AIN1            1
+#define VSCALE_POS      4
+#define VSCALE_NEG      5
+
+static void set_ain(QTestState *qts, const char *value)
+{
+    qtest_qmp_assert_success(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '" AC_PATH "',"
+        " 'property': 'ain', 'value': %s } }", value);
+}
+
+static int64_t qom_int(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments': {"
+                           " 'path': %s, 'property': %s } }", path, prop);
+    int64_t v = qdict_get_int(rsp, "return");
+
+    qobject_unref(rsp);
+    return v;
+}
+
+/* COMP0 on with @compctrl, the AC enabled; past the start-up */
+static void comp0_on(QTestState *qts, uint32_t compctrl)
+{
+    qtest_writel(qts, AC + R_COMPCTRL0, compctrl);
+    qtest_writel(qts, AC + R_COMPCTRL0, compctrl | EN);
+    qtest_writeb(qts, AC + R_CTRLA, CTRLA_ENABLE);
+    qtest_clock_step(qts, 10000);
+    g_assert_cmphex(qtest_readb(qts, AC + R_STATUSB) & 1, ==, 1);
+}
+
+static unsigned state0(QTestState *qts)
+{
+    return qtest_readb(qts, AC + R_STATUSA) & 1;
+}
+
+/* AIN0 against AIN1, both from "ain"; unset inputs read "ain-default" */
+static void test_board_inputs(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    set_ain(qts, "0=2000,1=1000");
+    comp0_on(qts, POS(AIN0) | NEG(AIN1) | HIGH);
+    g_assert_cmpuint(state0(qts), ==, 1);
+    set_ain(qts, "0=500");
+    g_assert_cmpuint(state0(qts), ==, 0);
+    set_ain(qts, "0=-1");
+    qtest_qmp_assert_success(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '" AC_PATH "',"
+        " 'property': 'ain-default', 'value': 1500 } }");
+    g_assert_cmpuint(state0(qts), ==, 1);
+    qtest_quit(qts);
+}
+
+/* VSCALE follows VDDANA, which the machine's vcc sets for every model */
+static void test_vcc(void)
+{
+    QTestState *qts = qtest_init(MACHINE ",vcc=5000");
+
+    g_assert_cmpint(qom_int(qts, AC_PATH, "vdd"), ==, 5000);
+    g_assert_cmpint(qom_int(qts, "/machine/soc/adc0", "vdd"), ==, 5000);
+    g_assert_cmpint(qom_int(qts, "/machine/soc/dac", "vdd"), ==, 5000);
+    /* SCALER 31: VDDANA / 2 = 2500 mV */
+    qtest_writeb(qts, AC + R_SCALER0, 31);
+    set_ain(qts, "0=2400");
+    comp0_on(qts, POS(VSCALE_POS) | NEG(AIN0) | HIGH);
+    g_assert_cmpuint(state0(qts), ==, 1);
+    set_ain(qts, "0=2600");
+    g_assert_cmpuint(state0(qts), ==, 0);
+    qtest_quit(qts);
+
+    qts = qtest_init(MACHINE);
+    g_assert_cmpint(qom_int(qts, AC_PATH, "vdd"), ==, 3300);
+    qtest_quit(qts);
+}
+
+/* Hysteresis: 60 mV either side of the threshold */
+static void test_hysteresis(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    set_ain(qts, "0=1600,1=1500");
+    comp0_on(qts, POS(AIN0) | NEG(AIN1) | HIGH | HYSTEN);
+    g_assert_cmpuint(state0(qts), ==, 1);
+    set_ain(qts, "0=1460");                 /* inside the band: stays */
+    g_assert_cmpuint(state0(qts), ==, 1);
+    set_ain(qts, "0=1430");
+    g_assert_cmpuint(state0(qts), ==, 0);
+    set_ain(qts, "0=1550");
+    g_assert_cmpuint(state0(qts), ==, 0);
+    set_ain(qts, "0=1570");
+    g_assert_cmpuint(state0(qts), ==, 1);
+    qtest_quit(qts);
+}
+
+/* A GPIO output on PA04 (AIN0) puts VDDANA or GND there, whatever "ain" */
+static void test_gpio_pad(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    set_ain(qts, "0=1000,1=1650");
+    comp0_on(qts, POS(AIN0) | NEG(AIN1) | HIGH);
+    g_assert_cmpuint(state0(qts), ==, 0);
+    qtest_writel(qts, PA + P_OUTSET, BIT(4));
+    qtest_writel(qts, PA + P_DIRSET, BIT(4));
+    g_assert_cmpuint(state0(qts), ==, 1);
+    qtest_writel(qts, PA + P_OUTCLR, BIT(4));
+    g_assert_cmpuint(state0(qts), ==, 0);
+    qtest_quit(qts);
+}
+
+/* READY after 7.5 us at SPEED 0 and 2.8 us at SPEED 3 (silicon) */
+static void test_startup(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writeb(qts, AC + R_CTRLA, CTRLA_ENABLE);
+    qtest_writel(qts, AC + R_COMPCTRL0, POS(VSCALE_POS) | NEG(4) | EN);
+    qtest_clock_step(qts, 7000);
+    g_assert_cmphex(qtest_readb(qts, AC + R_STATUSB), ==, 0);
+    qtest_clock_step(qts, 600);
+    g_assert_cmphex(qtest_readb(qts, AC + R_STATUSB), ==, 1);
+    qtest_writel(qts, AC + R_COMPCTRL0, 0);
+    g_assert_cmphex(qtest_readb(qts, AC + R_STATUSB), ==, 0);
+    qtest_writel(qts, AC + R_COMPCTRL0, POS(VSCALE_POS) | NEG(4) | HIGH);
+    qtest_writel(qts, AC + R_COMPCTRL0, POS(VSCALE_POS) | NEG(4) | HIGH | EN);
+    qtest_clock_step(qts, 2500);
+    g_assert_cmphex(qtest_readb(qts, AC + R_STATUSB), ==, 0);
+    qtest_clock_step(qts, 400);
+    g_assert_cmphex(qtest_readb(qts, AC + R_STATUSB), ==, 1);
+    qtest_quit(qts);
+}
+
+/* A board voltage change raises the interrupt with no AC access */
+static void test_interrupt(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    set_ain(qts, "0=2000,1=1000");
+    comp0_on(qts, POS(AIN0) | NEG(AIN1) | HIGH | INTSEL(2));  /* falling */
+    qtest_writeb(qts, AC + R_INTENSET, 1);
+    g_assert_false(qtest_readl(qts, NVIC_ISPR) & BIT(AC_IRQ));
+    set_ain(qts, "0=500");
+    g_assert_true(qtest_readl(qts, NVIC_ISPR) & BIT(AC_IRQ));
+    g_assert_cmphex(qtest_readb(qts, AC + R_INTFLAG), ==, 1);
+    qtest_writeb(qts, AC + R_INTFLAG, 1);
+    set_ain(qts, "0=2000");                 /* rising: no flag */
+    g_assert_cmphex(qtest_readb(qts, AC + R_INTFLAG), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-ac/board-inputs", test_board_inputs);
+    qtest_add_func("pic32cm-ac/vcc", test_vcc);
+    qtest_add_func("pic32cm-ac/hysteresis", test_hysteresis);
+    qtest_add_func("pic32cm-ac/gpio-pad", test_gpio_pad);
+    qtest_add_func("pic32cm-ac/startup", test_startup);
+    qtest_add_func("pic32cm-ac/interrupt", test_interrupt);
+    return g_test_run();
+}
-- 
