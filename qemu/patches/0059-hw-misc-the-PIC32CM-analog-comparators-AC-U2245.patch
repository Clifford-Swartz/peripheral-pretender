index 0000000..c2c35f1
--- /dev/null
+++ b/include/hw/misc/mchp_ac.h
@@ -0,0 +1,32 @@
+/*
+ * Microchip PIC32CM JH/MC analog comparators (AC U2245)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An mchp-regblock (see mchp_ac_u2245.c). GPIO outputs "comp-event"[n]
+ * and "win-event"[w] (EVSYS generators COMP_n, WIN_w), "pad-cmp"[n] (the
+ * CMPn pads); inputs "soc-event-in"[n] (EVSYS users SOC_n). Properties:
+ *   "ain"          str: "channel=mV,...", the board's voltage on AINx (as
+ *                  the ADC models; -1 unsets)
+ *   "ain-default"  int32: the voltage of AIN inputs "ain" leaves unset
+ *   "ain-pads"     str: the PORT pin of AIN0, AIN1, ... (-1: none); the SoC
+ *                  sets it from the device's signals
+ *   "vdd"          int32: VDDANA in mV (3300)
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_AC_H
+#define HW_MISC_MCHP_AC_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_AC_U2245 "mchp-ac-u2245"
+
+#define MCHP_AC_COMP_EVENT "comp-event"
+#define MCHP_AC_WIN_EVENT "win-event"
+#define MCHP_AC_SOC_EVENT_IN "soc-event-in"
+#define MCHP_AC_PAD_CMP "pad-cmp"
+
+#endif /* HW_MISC_MCHP_AC_H */
