+ * Microchip PIC32CM JH/MC analog comparators (AC U2245)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Two comparators on the MC00, four on the JH01 (one window pair per two;
+ * the count comes from COMPCTRL's element count). Comparator n compares
+ * MUXPOS (AIN0-3 of its pair, VSCALE) with MUXNEG (AIN0-3, GND, VSCALE,
+ * INTREF, DAC); STATE is 1 while the positive input is the higher. SWAP
+ * swaps the inputs and inverts the output, so the logical result stays.
+ * The inputs:
+ *
+ *   AINx    the pad's voltage: VDDANA or 0 while the PORT drives it (a GPIO
+ *           output reaches the AC whatever its PMUX, silicon), else the
+ *           board's ("ain", channel=mV, as the ADC models; unset inputs
+ *           read "ain-default")
+ *   VSCALE  VDDANA * (SCALERn + 1) / 64, per comparator, live
+ *   INTREF  the SUPC's VREF.SEL level (1.024, 2.048, 4.096 V; silicon: no
+ *           VREFOE needed, and no sign of erratum 1.4.1 on the desk A1)
+ *   DAC     the DAC output while the DAC has CTRLB.IOEN; without IOEN the
+ *           input reads high (silicon), modelled as VDDANA
+ *
+ * What the PIC32CM MC00 (rev A1, firmware/hello APP=acprobe, acprobe2)
+ * showed, and the model does:
+ *
+ *   - COMPCTRL is locked by its own ENABLE: while it is set, a write
+ *     changes ENABLE only (a disable with new fields keeps the old ones);
+ *     a write with ENABLE while disabled takes the new fields. Bits 21:20
+ *     are writable and do nothing. EVCTRL ignores writes while CTRLA is
+ *     enabled; SCALER and WINCTRL are live.
+ *   - READY sets after the start-up time, 7.5 us at SPEED 0 and 2.8 us at
+ *     SPEED 3; a single shot (CTRLB.STARTn or the SOC event with COMPEIn)
+ *     clears READY and completes after 7 / 2.6 us. Disabling clears READY
+ *     and keeps STATE.
+ *   - The first comparison after enable raises no TOGGLE/RISING/FALLING
+ *     flag; INTSEL EOC flags it once in continuous mode, and every shot in
+ *     single-shot mode. Later changes flag per INTSEL; a shot compares with
+ *     the previous result.
+ *   - Hysteresis (HYSTEN, continuous mode): about 60 mV either side of the
+ *     threshold at both speeds.
+ *   - Window (WINCTRL.WENx): STATE pair 11 = ABOVE, 00 = BELOW, mixed =
+ *     INSIDE; WINx sets when the window enters the WINTSEL region (OUTSIDE:
+ *     ABOVE or BELOW), not while it stays there, and not at all while one
+ *     comparator of the pair is single-shot and the other continuous.
+ *   - The COMP event is a copy of STATE (COMPEOn); the CMP pad (OUT ASYNC
+ *     or SYNC) follows STATE and reads 0 with OUT OFF. An inverted SOC
+ *     event still starts one shot per pulse.
+ *
+ * Continuous comparators compare again on every AC access and whenever
+ * the DAC output or an AIN pad's level changes (not when the SUPC's VREF
+ * changes, until the next access). VDDANA is "vdd" (the SoC's "vddana"; the
+ * desk board's VCC_SEL at 5 V gave 4.89 V). Not modelled: offset and
+ * scaler error (silicon: within 2 DAC codes), the filter (FLEN), SPEED
+ * beyond the start-up time, standby, SYNCBUSY (silicon: about 1 us per
+ * write), the window's WIN event as a pulse (it is the INSIDE level).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/cutils.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/gpio/mchp_port.h"
+#include "hw/misc/mchp_ac.h"
+#include "hw/misc/mchp_dac.h"
+#include "hw/misc/mchp_sysctrl.h"
+#include "hw/mchp/gen/ac_u2245.h"
+#include "migration/vmstate.h"
+
+#define AC_MAX              4
+#define AC_NAIN             8
+#define AC_MUX_PINS         4           /* AIN codes per pair */
+#define COMPCTRL_MASK       0x373BF75Eu /* silicon: incl. bits 21:20 */
+#define HYST_MV             60
+
+/* SUPC VREF (hw/mchp/gen/supc_u2117.h): SEL bits 16-19 */
+#define SUPC_VREF_OFFSET    0x1C
+#define SUPC_VREF_SEL(v)    extract32(v, 16, 4)
+/* DAC U2214 CTRLB.IOEN */
+#define DAC_CTRLB_OFFSET    0x01
+#define DAC_CTRLB_IOEN      BIT(1)
+
+enum { WS_ABOVE, WS_INSIDE, WS_BELOW };
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpAcU2245State, MCHP_AC_U2245)
+
+struct MchpAcU2245State {
+    MchpRegBlock parent_obj;
+
+    unsigned ncmp;
+    uint32_t compctrl[AC_MAX];
+    bool state[AC_MAX];
+    bool ready[AC_MAX];
+    bool evaluated[AC_MAX];     /* a comparison has run since enable */
+    bool shot[AC_MAX];          /* a single shot is under way */
+    uint8_t wstate[AC_MAX / 2];
+    bool wvalid[AC_MAX / 2];
+    bool soc_level[AC_MAX];
+    int32_t ain_mv[AC_NAIN];    /* < 0: unset */
+    int32_t ain_default;
+    int32_t vdd_mv;
+    int32_t ain_pad[AC_NAIN];   /* pad of AINx, -1: none ("ain-pads") */
+
+    QEMUTimer *start_timer[AC_MAX];
+    qemu_irq comp_event[AC_MAX];
+    qemu_irq win_event[AC_MAX / 2];
+    qemu_irq pad_cmp[AC_MAX];
+    DeviceState *port;
+    MchpRegBlock *supc;
+    MchpRegBlock *dac;
+    Notifier dac_changed;
+    bool listening;             /* to the DAC */
+    bool watching;              /* the AIN pads */
+};
+
+static uint32_t ac_reg(MchpAcU2245State *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static void ac_set_reg(MchpAcU2245State *s, hwaddr off, unsigned size,
+                       uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
+static void ac_update(MchpAcU2245State *s);
+static void ac_listen(MchpAcU2245State *s);
+
+static bool ac_on(MchpAcU2245State *s)
+{
+    return ac_reg(s, A_MCHP_AC_CTRLA, 1) & R_MCHP_AC_CTRLA_ENABLE_MASK;
+}
+
+static bool ac_cmp_on(MchpAcU2245State *s, unsigned n)
+{
+    return ac_on(s) && (s->compctrl[n] & R_MCHP_AC_COMPCTRL_ENABLE_MASK);
+}
+
+static unsigned ac_field(MchpAcU2245State *s, unsigned n, unsigned shift,
+                         unsigned len)
+{
+    return extract32(s->compctrl[n], shift, len);
+}
+
+#define CMP(s, n, f) ac_field(s, n, R_MCHP_AC_COMPCTRL_##f##_SHIFT, \
+                              R_MCHP_AC_COMPCTRL_##f##_LENGTH)
+
+static bool ac_single(MchpAcU2245State *s, unsigned n)
+{
+    return CMP(s, n, SINGLE);
+}
+
+/* The voltage on AIN code @code of comparator @n's pair */
+static int32_t ac_ain_mv(MchpAcU2245State *s, unsigned n, unsigned code)
+{
+    unsigned ain = (n / 2) * AC_MUX_PINS + code;
+    bool level;
+
+    if (ain >= AC_NAIN) {
+        return 0;
+    }
+    if (s->port && s->ain_pad[ain] >= 0 &&
+        mchp_port_pad_driven(s->port, s->ain_pad[ain], &level)) {
+        return level ? s->vdd_mv : 0;
+    }
+    return s->ain_mv[ain] >= 0 ? s->ain_mv[ain] : s->ain_default;
+}
+
+static int32_t ac_vscale_mv(MchpAcU2245State *s, unsigned n)
+{
+    uint32_t v = ac_reg(s, A_MCHP_AC_SCALER + n, 1) & 0x3F;
+
+    return (int64_t)s->vdd_mv * (v + 1) / 64;
+}
+
+static int32_t ac_intref_mv(MchpAcU2245State *s)
+{
+    uint32_t vref = s->supc ? mchp_regfile_peek(&s->supc->rf,
+                                                SUPC_VREF_OFFSET, 4) : 0;
+
+    return SUPC_VREF_SEL(vref) == 2 ? 2048 :
+           SUPC_VREF_SEL(vref) == 3 ? 4096 : 1024;
+}
+
+static int32_t ac_dac_mv(MchpAcU2245State *s)
+{
+    if (!s->dac || !(mchp_regfile_peek(&s->dac->rf, DAC_CTRLB_OFFSET, 1) &
+                     DAC_CTRLB_IOEN)) {
+        return s->vdd_mv;           /* silicon: reads high without IOEN */
+    }
+    return mchp_dac_u2214_internal_mv(DEVICE(s->dac));
+}
+
+static int32_t ac_pos_mv(MchpAcU2245State *s, unsigned n)
+{
+    unsigned m = CMP(s, n, MUXPOS);
+
+    return m < AC_MUX_PINS ? ac_ain_mv(s, n, m) :
+           m == 4 ? ac_vscale_mv(s, n) : 0;
+}
+
+static int32_t ac_neg_mv(MchpAcU2245State *s, unsigned n)
+{
+    unsigned m = CMP(s, n, MUXNEG);
+
+    switch (m) {
+    case 4:
+        return 0;
+    case 5:
+        return ac_vscale_mv(s, n);
+    case 6:
+        return ac_intref_mv(s);
+    case 7:
+        return ac_dac_mv(s);
+    default:
+        return ac_ain_mv(s, n, m);
+    }
+}
+
+/* The comparator's output now; hysteresis around the previous state */
+static bool ac_compare(MchpAcU2245State *s, unsigned n, bool hyst)
+{
+    int32_t pos = ac_pos_mv(s, n), neg = ac_neg_mv(s, n);
+
+    if (hyst && s->evaluated[n] && CMP(s, n, HYSTEN)) {
+        return s->state[n] ? pos >= neg - HYST_MV : pos > neg + HYST_MV;
+    }
+    return pos > neg;
+}
+
+static void ac_flag(MchpAcU2245State *s, uint8_t bits)
+{
+    ac_set_reg(s, A_MCHP_AC_INTFLAG, 1,
+               ac_reg(s, A_MCHP_AC_INTFLAG, 1) | bits);
+}
+
+static void ac_outputs(MchpAcU2245State *s, unsigned n)
+{
+    uint16_t ev = ac_reg(s, A_MCHP_AC_EVCTRL, 2);
+    bool on = ac_cmp_on(s, n);
+
+    qemu_set_irq(s->comp_event[n], (ev & BIT(n)) && s->state[n]);
+    qemu_set_irq(s->pad_cmp[n], on && CMP(s, n, OUT) && s->state[n]);
+}
+
+/* Window pair @w: the state, the flag on entering the WINTSEL region */
+static void ac_window(MchpAcU2245State *s, unsigned w)
+{
+    uint8_t winctrl = ac_reg(s, A_MCHP_AC_WINCTRL, 1);
+    bool wen = extract32(winctrl, w * 4, 1);
+    unsigned sel = extract32(winctrl, w * 4 + 1, 2);
+    uint16_t ev = ac_reg(s, A_MCHP_AC_EVCTRL, 2);
+    unsigned a = 2 * w, b = 2 * w + 1;
+    uint8_t ws;
+
+    if (!wen || !s->ready[a] || !s->ready[b]) {
+        s->wvalid[w] = false;
+        qemu_set_irq(s->win_event[w], 0);
+        return;
+    }
+    ws = s->state[a] && s->state[b] ? WS_ABOVE :
+         !s->state[a] && !s->state[b] ? WS_BELOW : WS_INSIDE;
+    /* Silicon: no flag while one is single-shot and the other is not */
+    if (s->wvalid[w] && ws != s->wstate[w] &&
+        ac_single(s, a) == ac_single(s, b)) {
+        bool hit = sel == 3 ? ws != WS_INSIDE : ws == sel;
+
+        if (hit) {
+            ac_flag(s, BIT(4 + w));
+        }
+    }
+    s->wstate[w] = ws;
+    s->wvalid[w] = true;
+    qemu_set_irq(s->win_event[w], (ev & BIT(4 + w)) && ws == WS_INSIDE);
+}
+
+/* A comparison of @n with result @st: flags, outputs */
+static void ac_result(MchpAcU2245State *s, unsigned n, bool st)
+{
+    unsigned intsel = CMP(s, n, INTSEL);
+    bool first = !s->evaluated[n];
+    bool changed = st != s->state[n];
+
+    if (intsel == 3) {
+        if (first || ac_single(s, n)) {
+            ac_flag(s, BIT(n));                     /* EOC */
+        }
+    } else if (!first && changed) {
+        if (intsel == 0 || (intsel == 1 && st) || (intsel == 2 && !st)) {
+            ac_flag(s, BIT(n));
+        }
+    }
+    s->state[n] = st;
+    s->evaluated[n] = true;
+    ac_outputs(s, n);
+    ac_window(s, n / 2);
+}
+
+static int64_t ac_startup_ns(MchpAcU2245State *s, unsigned n, bool shot)
+{
+    bool fast = CMP(s, n, SPEED) == 3;
+
+    return shot ? (fast ? 2600 : 7000) : (fast ? 2800 : 7500);
+}
+
+/* Start-up over (continuous: ready) or a single shot done */
+static void ac_started(void *opaque, unsigned n)
+{
+    MchpAcU2245State *s = opaque;
+
+    if (!ac_cmp_on(s, n)) {
+        return;
+    }
+    s->ready[n] = true;
+    if (s->shot[n] || !ac_single(s, n)) {
+        s->shot[n] = false;
+        ac_result(s, n, ac_compare(s, n, !ac_single(s, n)));
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void ac_start_timer0(void *o) { ac_started(o, 0); }
+static void ac_start_timer1(void *o) { ac_started(o, 1); }
+static void ac_start_timer2(void *o) { ac_started(o, 2); }
+static void ac_start_timer3(void *o) { ac_started(o, 3); }
+
+/*
+ * Bring the comparators up to now: a start-up or shot whose time has come
+ * completes (the guest may poll faster than the host's timers fire), and
+ * the continuous ones compare again
+ */
+static void ac_update(MchpAcU2245State *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    ac_listen(s);
+    for (unsigned n = 0; n < s->ncmp; n++) {
+        if (timer_expired(s->start_timer[n], now)) {
+            timer_del(s->start_timer[n]);
+            ac_started(s, n);
+        }
+        if (ac_cmp_on(s, n) && s->ready[n] && !ac_single(s, n)) {
+            ac_result(s, n, ac_compare(s, n, true));
+        }
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void ac_dac_changed(Notifier *n, void *data)
+{
+    ac_update(container_of(n, MchpAcU2245State, dac_changed));
+}
+
+static void ac_pad_changed(void *opaque, unsigned line, bool level)
+{
+    ac_update(opaque);
+}
+
+/* The DAC's output changes without an AC access: hear of it (once) */
+static void ac_listen(MchpAcU2245State *s)
+{
+    Object *o;
+
+    if (s->listening) {
+        return;
+    }
+    s->listening = true;
+    o = object_resolve_path_type("", TYPE_MCHP_PORT, NULL);
+    s->port = o ? DEVICE(o) : NULL;
+    o = object_resolve_path_type("", TYPE_MCHP_SUPC, NULL);
+    s->supc = o ? MCHP_REGBLOCK(o) : NULL;
+    o = object_resolve_path_type("", TYPE_MCHP_DAC_U2214, NULL);
+    s->dac = o ? MCHP_REGBLOCK(o) : NULL;
+    if (s->dac) {
+        s->dac_changed.notify = ac_dac_changed;
+        mchp_dac_u2214_add_notifier(DEVICE(s->dac), &s->dac_changed);
+    }
+}
+
+/* @n was enabled (with CTRLA): power up, READY after the start-up */
+static void ac_power_up(MchpAcU2245State *s, unsigned n)
+{
+    s->ready[n] = false;
+    s->evaluated[n] = false;
+    s->shot[n] = false;
+    timer_mod(s->start_timer[n], qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              ac_startup_ns(s, n, false));
+}
+
+static void ac_power_down(MchpAcU2245State *s, unsigned n)
+{
+    s->ready[n] = false;
+    s->shot[n] = false;
+    timer_del(s->start_timer[n]);
+    ac_outputs(s, n);
+    ac_window(s, n / 2);
+}
+
+/* A single-shot start of @n (and its window partner) */
+static void ac_shoot(MchpAcU2245State *s, unsigned n)
+{
+    if (!ac_cmp_on(s, n) || !ac_single(s, n)) {
+        return;
+    }
+    s->ready[n] = false;
+    s->shot[n] = true;
+    timer_mod(s->start_timer[n], qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              ac_startup_ns(s, n, true));
+}
+
+static void ac_start(MchpAcU2245State *s, unsigned n)
+{
+    unsigned w = n / 2;
+
+    ac_shoot(s, n);
+    if (extract32(ac_reg(s, A_MCHP_AC_WINCTRL, 1), w * 4, 1)) {
+        ac_shoot(s, n ^ 1);                 /* a window starts both */
+    }
+}
+
+static void ac_soc_event(void *opaque, int n, int level)
+{
+    MchpAcU2245State *s = opaque;
+    uint16_t ev = ac_reg(s, A_MCHP_AC_EVCTRL, 2);
+    bool lvl = (level > 0) ^ extract32(ev, 12 + n, 1);
+    bool rose = lvl && !s->soc_level[n];
+
+    s->soc_level[n] = lvl;
+    if (extract32(ev, 8 + n, 1) && (rose || level > 1)) {
+        ac_start(s, n);
+    }
+}
+
+static uint32_t ac_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                            unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpAcU2245State *s = MCHP_AC_U2245(rf->opaque);
+    uint32_t v = 0;
+
+    if (side_effects) {
+        ac_update(s);
+    }
+    switch (ri->offset) {
+    case A_MCHP_AC_STATUSA:
+        for (unsigned n = 0; n < s->ncmp; n++) {
+            v |= s->state[n] ? BIT(n) : 0;
+        }
+        for (unsigned w = 0; w < s->ncmp / 2; w++) {
+            if (s->wvalid[w]) {
+                v |= (uint32_t)s->wstate[w] << (4 + 2 * w);
+            }
+        }
+        return v;
+    case A_MCHP_AC_STATUSB:
+        for (unsigned n = 0; n < s->ncmp; n++) {
+            v |= s->ready[n] ? BIT(n) : 0;
+        }
+        return v;
+    case A_MCHP_AC_SYNCBUSY:
+        return 0;
+    case A_MCHP_AC_COMPCTRL:
+        return idx < s->ncmp ? s->compctrl[idx] : 0;
+    default:
+        /* INTFLAG: as the update above left it */
+        return mchp_regfile_peek(rf, mchp_regfile_elem_offset(ri, idx),
+                                 ri->size);
+    }
+}
+
+static void ac_compctrl_write(MchpAcU2245State *s, unsigned n,
+                              uint32_t written, uint32_t we)
+{
+    uint32_t old = s->compctrl[n], val;
+    bool was_on = ac_cmp_on(s, n);
+
+    if (old & R_MCHP_AC_COMPCTRL_ENABLE_MASK) {
+        /* Locked: only ENABLE changes */
+        val = (old & ~R_MCHP_AC_COMPCTRL_ENABLE_MASK) |
+              (((old & ~we) | (written & we)) &
+               R_MCHP_AC_COMPCTRL_ENABLE_MASK);
+    } else {
+        val = ((old & ~we) | (written & we)) & COMPCTRL_MASK;
+    }
+    s->compctrl[n] = val;
+    ac_set_reg(s, A_MCHP_AC_COMPCTRL + 4 * n, 4, val);
+    if (ac_cmp_on(s, n) && !was_on) {
+        ac_power_up(s, n);
+    } else if (!ac_cmp_on(s, n) && was_on) {
+        ac_power_down(s, n);
+    }
+}
+
+static void ac_reset_state(MchpAcU2245State *s)
+{
+    for (unsigned n = 0; n < AC_MAX; n++) {
+        s->compctrl[n] = 0;
+        s->state[n] = false;
+        s->ready[n] = false;
+        s->evaluated[n] = false;
+        s->shot[n] = false;
+        s->soc_level[n] = false;
+        timer_del(s->start_timer[n]);
+        qemu_set_irq(s->comp_event[n], 0);
+        qemu_set_irq(s->pad_cmp[n], 0);
+    }
+    for (unsigned w = 0; w < AC_MAX / 2; w++) {
+        s->wvalid[w] = false;
+        s->wstate[w] = 0;
+        qemu_set_irq(s->win_event[w], 0);
+    }
+}
+
+static void ac_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                          unsigned idx, uint32_t old, uint32_t written,
+                          uint32_t we)
+{
+    MchpAcU2245State *s = MCHP_AC_U2245(rf->opaque);
+
+    switch (ri->offset) {
+    case A_MCHP_AC_CTRLA:
+        if (written & we & R_MCHP_AC_CTRLA_ENABLE_MASK &&
+            !(old & R_MCHP_AC_CTRLA_ENABLE_MASK)) {
+            for (unsigned n = 0; n < s->ncmp; n++) {
+                if (ac_cmp_on(s, n)) {
+                    ac_power_up(s, n);
+                }
+            }
+        } else if (!ac_on(s) && (old & R_MCHP_AC_CTRLA_ENABLE_MASK)) {
+            for (unsigned n = 0; n < s->ncmp; n++) {
+                ac_power_down(s, n);
+            }
+        }
+        break;
+    case A_MCHP_AC_CTRLB:
+        for (unsigned n = 0; n < s->ncmp; n++) {
+            if (written & we & BIT(n)) {
+                ac_start(s, n);
+            }
+        }
+        break;
+    case A_MCHP_AC_COMPCTRL:
+        if (idx < s->ncmp) {
+            ac_compctrl_write(s, idx, written, we);
+        }
+        break;
+    default:
+        break;                      /* SCALER, WINCTRL: live */
+    }
+    ac_update(s);
+    for (unsigned n = 0; n < s->ncmp; n++) {
+        ac_outputs(s, n);
+    }
+}
+
+static void ac_reset_hold(MchpRegBlock *rb)
+{
+    ac_reset_state(MCHP_AC_U2245(rb));
+}
+
+static bool ac_realize(MchpRegBlock *rb, Error **errp)
+{
+    MchpAcU2245State *s = MCHP_AC_U2245(rb);
+
+    for (unsigned i = 0; i < rb->rf.nregs; i++) {
+        if (rb->rf.regs[i].offset == A_MCHP_AC_COMPCTRL) {
+            s->ncmp = MIN(rb->rf.regs[i].count, AC_MAX);
+        }
+    }
+    if (!s->ncmp) {
+        error_setg(errp, "%s: no COMPCTRL", rb->name);
+        return false;
+    }
+    return true;
