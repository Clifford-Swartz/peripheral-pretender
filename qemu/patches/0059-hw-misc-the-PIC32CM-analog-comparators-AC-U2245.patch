+/* "ain": "channel=mV,..." (channel=-1 unsets), as the ADC models */
+static char *ac_get_ain(Object *obj, Error **errp)
+{
+    MchpAcU2245State *s = MCHP_AC_U2245(obj);
+    GString *g = g_string_new(NULL);
+
+    for (unsigned i = 0; i < AC_NAIN; i++) {
+        if (s->ain_mv[i] >= 0) {
+            g_string_append_printf(g, "%s%u=%d", g->len ? "," : "", i,
+                                   s->ain_mv[i]);
+        }
+    }
+    return g_string_free(g, false);
+}
+
+static void ac_set_ain(Object *obj, const char *value, Error **errp)
+{
+    MchpAcU2245State *s = MCHP_AC_U2245(obj);
+    g_auto(GStrv) items = g_strsplit(value, ",", -1);
+
+    for (unsigned i = 0; items[i]; i++) {
+        unsigned ch;
+        int mv;
+
+        if (!*items[i]) {
+            continue;
+        }
+        if (sscanf(items[i], "%u=%d", &ch, &mv) != 2 || ch >= AC_NAIN) {
+            error_setg(errp, "ain items must be channel=millivolts, "
+                       "channel 0-%d", AC_NAIN - 1);
+            return;
+        }
+        s->ain_mv[ch] = mv < 0 ? -1 : mv;
+    }
+    ac_update(s);
+}
+
+/* "ain-pads": the pads of AIN0.. as PORT pin numbers, -1: none */
+static char *ac_get_pads(Object *obj, Error **errp)
+{
+    MchpAcU2245State *s = MCHP_AC_U2245(obj);
+    GString *g = g_string_new(NULL);
+
+    for (unsigned i = 0; i < AC_NAIN; i++) {
+        g_string_append_printf(g, "%s%d", i ? "," : "", s->ain_pad[i]);
+    }
+    return g_string_free(g, false);
+}
+
+static void ac_set_pads(Object *obj, const char *value, Error **errp)
+{
+    MchpAcU2245State *s = MCHP_AC_U2245(obj);
+    Object *o;
+    g_auto(GStrv) items = g_strsplit(value, ",", -1);
+    unsigned n = g_strv_length(items);
+
+    for (unsigned i = 0; i < AC_NAIN; i++) {
+        int pin = -1;
+
+        if (i < n && *items[i] && qemu_strtoi(items[i], NULL, 0, &pin)) {
+            error_setg(errp, "ain-pads: comma-separated pin numbers");
+            return;
+        }
+        s->ain_pad[i] = pin;
+    }
+    /* The pads' levels change without an AC access: hear of them */
+    o = s->watching ? NULL : object_resolve_path_type("", TYPE_MCHP_PORT,
+                                                      NULL);
+    for (unsigned i = 0; o && i < AC_NAIN; i++) {
+        s->watching = true;
+        if (s->ain_pad[i] >= 0) {
+            mchp_port_watch(DEVICE(o), s->ain_pad[i], ac_pad_changed, s, i);
+        }
+    }
+}
