+
+static void adc_set_pads(Object *obj, const char *value, Error **errp)
+{
+    MchpAdcU2247State *s = MCHP_ADC_U2247(obj);
+    g_auto(GStrv) items = g_strsplit(value, ",", -1);
+    unsigned n = g_strv_length(items);
+
+    for (unsigned i = 0; i < ADC_NAIN; i++) {
+        int pin = -1;
+
+        if (i < n && *items[i] && qemu_strtoi(items[i], NULL, 0, &pin)) {
+            error_setg(errp, "ain-pads: comma-separated pin numbers");
+            return;
+        }
+        s->ain_pad[i] = pin;
+    }
