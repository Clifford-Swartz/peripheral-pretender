+/*
+ * 74HC595 8-bit shift register with output latch, in a daisy chain
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * TI SN74HC595 data sheet: data (DS) shifts in on each rising SHCP edge,
+ * Q7S shifts out to the next register, a rising STCP edge copies the shift
+ * register to the outputs, MR# low clears the shift register (not the
+ * outputs), OE# low drives the outputs. Here a chain of "length" registers
+ * sits on a QEMU SSI bus: each transfer clocks 8 bits MSB first (SPI mode
+ * 0, the data sheet's timing), so the first byte of a 2-byte transfer ends
+ * in the last register; the byte returned is what came out of the last
+ * Q7S. GPIO inputs "latch" (STCP) and "mr" (MR#) take 0/1, or -1 for an
+ * undriven pin: MR# then reads high (the usual pull-up), STCP keeps its
+ * level. QOM property "outputs" (read-only): the latched outputs, register
+ * 0 (the first after DS) in bits 7:0. OE# is assumed tied low.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/ssi/ssi.h"
+#include "hw/ssi/ti_74hc595.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define HC595_MAX_CHAIN 4
+
+OBJECT_DECLARE_SIMPLE_TYPE(Ti74hc595State, TI_74HC595)
+
+struct Ti74hc595State {
+    SSIPeripheral parent_obj;
+
+    uint32_t length;            /* registers in the chain */
+    uint32_t shift;             /* register 0 in bits 7:0 */
+    uint32_t outputs;
+    bool latch;
+    bool mr;
+};
+
+static uint32_t hc595_mask(Ti74hc595State *s)
+{
+    return s->length >= 4 ? UINT32_MAX : (1u << (8 * s->length)) - 1;
+}
+
+/* Clock 8 bits in: the chain moves one register up, the byte enters at 0 */
+static uint32_t hc595_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    Ti74hc595State *s = TI_74HC595(dev);
+    uint32_t out = (s->shift >> (8 * (s->length - 1))) & 0xFF;
+
+    if (s->mr) {
+        s->shift = ((s->shift << 8) | (val & 0xFF)) & hc595_mask(s);
+    }
+    trace_ti_74hc595_shift(val & 0xFF, s->shift);
+    return out;
+}
+
+static void hc595_set_latch(void *opaque, int n, int level)
+{
+    Ti74hc595State *s = opaque;
+    bool high = level > 0 || (level < 0 && s->latch);
+
+    if (high && !s->latch) {
+        s->outputs = s->shift;
+        trace_ti_74hc595_latch(s->outputs);
+    }
+    s->latch = high;
+}
+
+static void hc595_set_mr(void *opaque, int n, int level)
+{
+    Ti74hc595State *s = opaque;
+
+    s->mr = level != 0;             /* -1: undriven, pulled up */
+    if (!s->mr) {
+        s->shift = 0;
+    }
+}
+
+static void hc595_get_outputs(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    uint32_t value = TI_74HC595(obj)->outputs;
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void hc595_realize(SSIPeripheral *dev, Error **errp)
+{
+    Ti74hc595State *s = TI_74HC595(dev);
+
+    if (s->length < 1 || s->length > HC595_MAX_CHAIN) {
+        error_setg(errp, "length must be 1 to %d", HC595_MAX_CHAIN);
+        return;
+    }
+    qdev_init_gpio_in_named(DEVICE(dev), hc595_set_latch,
+                            TI_74HC595_LATCH, 1);
+    qdev_init_gpio_in_named(DEVICE(dev), hc595_set_mr, TI_74HC595_MR, 1);
+}
+
+static void hc595_reset(DeviceState *dev)
+{
+    Ti74hc595State *s = TI_74HC595(dev);
+
+    s->shift = 0;
+    s->outputs = 0;
+    s->latch = false;
+    s->mr = true;
+}
+
+static void hc595_init(Object *obj)
+{
+    object_property_add(obj, "outputs", "uint32", hc595_get_outputs,
+                        NULL, NULL, NULL);
+}
+
+static const Property hc595_properties[] = {
+    DEFINE_PROP_UINT32("length", Ti74hc595State, length, 1),
+};
+
+static const VMStateDescription vmstate_hc595 = {
+    .name = TYPE_TI_74HC595,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, Ti74hc595State),
+        VMSTATE_UINT32(shift, Ti74hc595State),
+        VMSTATE_UINT32(outputs, Ti74hc595State),
+        VMSTATE_BOOL(latch, Ti74hc595State),
+        VMSTATE_BOOL(mr, Ti74hc595State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void hc595_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    dc->desc = "74HC595 shift register chain";
+    dc->vmsd = &vmstate_hc595;
+    device_class_set_props(dc, hc595_properties);
+    device_class_set_legacy_reset(dc, hc595_reset);
+    k->realize = hc595_realize;
+    k->transfer = hc595_transfer;
+    k->cs_polarity = SSI_CS_NONE;   /* shifts on every clock; STCP latches */
+}
+
+static const TypeInfo hc595_types[] = {
+    {
+        .name = TYPE_TI_74HC595,
+        .parent = TYPE_SSI_PERIPHERAL,
+        .instance_size = sizeof(Ti74hc595State),
+        .instance_init = hc595_init,
+        .class_init = hc595_class_init,
+    },
+};
+
+DEFINE_TYPES(hc595_types)
