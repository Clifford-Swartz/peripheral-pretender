diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index 58b1586..0e904fa 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -263,9 +263,86 @@ static void test_shutdown_lock(void)
     qtest_quit(qts);
 }
 
+#define PA              (PORT + 0x00)
+#define P_DIRSET        0x08
+#define P_OUTCLR        0x14
+#define P_OUTSET        0x18
+#define SERCOM1         0x42000800
+#define CLICK2          "/machine/ext2-click"
+
+static bool pin_high(QTestState *qts, uint32_t group, unsigned pin)
+{
+    qtest_writeb(qts, group + P_PINCFG + pin, 0x02);       /* INEN, no pull */
+    return qtest_readl(qts, group + P_IN) & BIT(pin);
+}
+
+/* Button G Click: INT (PB02) pulled low by R2/R3, high while pressed */
+static void test_button_g(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=buttong ");
+
+    g_assert_false(pin_high(qts, PB, INT1_PIN));
+    qtest_qom_set_bool(qts, CLICK1, "pressed", true);
+    g_assert_true(pin_high(qts, PB, INT1_PIN));
+    qtest_qom_set_bool(qts, CLICK1, "pressed", false);
+    g_assert_false(pin_high(qts, PB, INT1_PIN));
+    qtest_quit(qts);
+}
+
+static void spi_byte(QTestState *qts, uint8_t v)
+{
+    qtest_writel(qts, SERCOM1 + 0x28, v);
+}
+
+/*
+ * 7seg Click on EXT2: two 74HC595 on SERCOM1 (MOSI on PAD2: DOPO 1),
+ * LATCH on CS (PA15), MR# on RST (PA10, pulled up), PWM (PB22) pulled up
+ */
+static void test_7seg(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext2=7seg ");
+
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);   /* host, DOPO 1 */
+    qtest_writel(qts, SERCOM1 + 0x04, BIT(17));            /* RXEN */
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, PA + P_OUTCLR, BIT(15));
+    qtest_writel(qts, PA + P_DIRSET, BIT(15));
+    spi_byte(qts, 0x12);                    /* ends in U2: the right digit */
+    spi_byte(qts, 0x34);                    /* U1: the left digit */
+    g_assert_cmphex(qom_int(qts, CLICK2, "outputs"), ==, 0);   /* unlatched */
+    qtest_writel(qts, PA + P_OUTSET, BIT(15));
+    g_assert_cmphex(qom_int(qts, CLICK2, "outputs"), ==, 0x1234);
+    /* What falls out of the last Q7S comes back on MISO */
+    qtest_readl(qts, SERCOM1 + 0x28);
+    qtest_readl(qts, SERCOM1 + 0x28);
+    spi_byte(qts, 0x56);
+    g_assert_cmphex(qtest_readl(qts, SERCOM1 + 0x28) & 0xFF, ==, 0x12);
+    /* MR# low clears the shift register, not the outputs */
+    qtest_writel(qts, PA + P_OUTCLR, BIT(10) | BIT(15));
+    qtest_writel(qts, PA + P_DIRSET, BIT(10));
+    g_assert_cmphex(qom_int(qts, CLICK2, "outputs"), ==, 0x1234);
+    qtest_writel(qts, PA + P_OUTSET, BIT(10) | BIT(15));
+    g_assert_cmphex(qom_int(qts, CLICK2, "outputs"), ==, 0);
+    g_assert_true(pin_high(qts, PB, 22));   /* PWM pulled up: digits on */
+    qtest_quit(qts);
+}
+
+/* Relay Click on EXT1: PWM (PB10) and CS (PA17) pulled low */
+static void test_relay(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=relay ");
+
+    g_assert_false(pin_high(qts, PB, 10));
+    g_assert_false(pin_high(qts, PA, 17));
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-click/button-g", test_button_g);
+    qtest_add_func("pic32cm-click/7seg", test_7seg);
+    qtest_add_func("pic32cm-click/relay", test_relay);
     qtest_add_func("pic32cm-click/thermo8-identity", test_identity);
     qtest_add_func("pic32cm-click/not-fitted", test_not_fitted);
     qtest_add_func("pic32cm-click/thermo8-int-pullup", test_int_pullup);
