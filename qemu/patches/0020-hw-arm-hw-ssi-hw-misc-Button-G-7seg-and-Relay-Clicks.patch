+++ b/include/hw/ssi/ti_74hc595.h
@@ -0,0 +1,20 @@
+/*
+ * 74HC595 8-bit shift register with output latch, in a daisy chain
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An SSI peripheral. Property "length": registers in the chain (1-4).
+ * GPIO inputs "latch" (STCP) and "mr" (MR#); QOM property "outputs".
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SSI_TI_74HC595_H
+#define HW_SSI_TI_74HC595_H
+
+#define TYPE_TI_74HC595 "74hc595"
+#define TI_74HC595_LATCH "latch"
+#define TI_74HC595_MR "mr"
