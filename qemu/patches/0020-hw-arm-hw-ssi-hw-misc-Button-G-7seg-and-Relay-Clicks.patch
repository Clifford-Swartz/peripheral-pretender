diff --git a/hw/misc/click_button.c b/hw/misc/click_button.c
new file mode 100644
index 0000000..0fc2146
--- /dev/null
+++ b/hw/misc/click_button.c
@@ -0,0 +1,99 @@
+/*
+ * A pushbutton on a Click board, driving one header pin
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * QOM property "pressed" (bool, settable while running). GPIO output
+ * "out": "pressed-level" (default 1) while pressed, "released-level"
+ * (default -1: let go, so the Click's pull resistor sets the pin) while
+ * released.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/misc/click_button.h"
+#include "migration/vmstate.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(ClickButtonState, CLICK_BUTTON)
+
+struct ClickButtonState {
+    DeviceState parent_obj;
+
+    qemu_irq out;
+    bool pressed;
+    int32_t pressed_level;
+    int32_t released_level;
+};
+
+static void click_button_update(ClickButtonState *s)
+{
+    qemu_set_irq(s->out, s->pressed ? s->pressed_level : s->released_level);
+}
+
+static bool click_button_get_pressed(Object *obj, Error **errp)
+{
+    return CLICK_BUTTON(obj)->pressed;
+}
+
+static void click_button_set_pressed(Object *obj, bool value, Error **errp)
+{
+    ClickButtonState *s = CLICK_BUTTON(obj);
+
+    s->pressed = value;
+    click_button_update(s);
+}
+
+static void click_button_reset(DeviceState *dev)
+{
+    click_button_update(CLICK_BUTTON(dev));     /* held across resets */
+}
+
+static void click_button_init(Object *obj)
+{
+    ClickButtonState *s = CLICK_BUTTON(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), &s->out, CLICK_BUTTON_OUT, 1);
+    object_property_add_bool(obj, "pressed", click_button_get_pressed,
+                             click_button_set_pressed);
+}
+
+static const Property click_button_properties[] = {
+    DEFINE_PROP_INT32("pressed-level", ClickButtonState, pressed_level, 1),
+    DEFINE_PROP_INT32("released-level", ClickButtonState, released_level, -1),
+};
+
+static const VMStateDescription vmstate_click_button = {
+    .name = TYPE_CLICK_BUTTON,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(pressed, ClickButtonState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void click_button_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "Click board pushbutton";
+    dc->vmsd = &vmstate_click_button;
+    device_class_set_props(dc, click_button_properties);
+    device_class_set_legacy_reset(dc, click_button_reset);
+}
+
+static const TypeInfo click_button_types[] = {
+    {
+        .name = TYPE_CLICK_BUTTON,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(ClickButtonState),
+        .instance_init = click_button_init,
+        .class_init = click_button_class_init,
+    },
+};
+
+DEFINE_TYPES(click_button_types)
