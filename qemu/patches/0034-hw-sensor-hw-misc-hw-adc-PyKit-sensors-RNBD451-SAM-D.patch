diff --git a/hw/misc/rnbd451.c b/hw/misc/rnbd451.c
new file mode 100644
index 0000000..f367155
--- /dev/null
+++ b/hw/misc/rnbd451.c
@@ -0,0 +1,346 @@
+/*
+ * Microchip RNBD451 Bluetooth Low Energy module on a UART
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A chardev the board connects to the UART the module sits on: what the
+ * MCU sends reaches the module, what the module answers reaches the MCU.
+ * Modelled after the RNBD451 user's guide (DS50003253) as firmware drives
+ * it: "%REBOOT%" after a reset pulse (rnbd451_reset_pin()) or R,1 (the
+ * power-on one goes out while the MCU is still in reset, so it is not
+ * sent); "$$$" enters command mode ("CMD> " prompt), "---" leaves it
+ * ("END"); V answers the firmware version ("version" property), D the
+ * device information (name, SA, SR and SS as last set); set commands
+ * (S..., U,Z, A, Y, ...) answer "AOK"; unknown commands "Err". Replies
+ * as from the kit on the desk (firmware V1.0.0.10, read through its
+ * REPL on 2026-10-14). In data mode bytes go to the connected
+ * central, if any.
+ *
+ * The central (a phone, for the web board view) is QOM properties of
+ * this chardev (/chardevs/<id>): "connected" (set true: %CONNECT% and
+ * %STREAM_OPEN%, false: %DISCONNECT%), "central-rx" (the last data-mode
+ * bytes the module sent to it), "central-rx-gen" (bumped per chunk) and
+ * "central-tx" (set: bytes the central sends, delivered to the MCU while
+ * connected). Not modelled: radio timing, bonding, scanning, connecting
+ * out, GATT services, settings that persist across resets.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "chardev/char.h"
+#include "hw/core/irq.h"
+#include "hw/misc/rnbd451.h"
+
+#define RNBD_LINE           128
+#define RNBD_CENTRAL_RX     512
+#define RNBD_OUT            1024
+
+OBJECT_DECLARE_SIMPLE_TYPE(Rnbd451Chardev, CHARDEV_RNBD451)
+
+struct Rnbd451Chardev {
+    Chardev parent_obj;
+
+    bool cmd_mode;
+    bool connected;
+    bool in_reset;
+    char line[RNBD_LINE];
+    unsigned nline;
+    unsigned dollars;           /* consecutive '$' in data mode */
+    char *version;
+    char *name;
+    uint16_t features;          /* SR */
+    uint8_t services;           /* SS */
+    uint8_t authen;             /* SA */
+
+    GString *central_rx;
+    uint32_t central_rx_gen;
+
+    uint8_t out[RNBD_OUT];      /* module to MCU, not yet accepted */
+    unsigned nout;
+    QEMUTimer *tx_timer;        /* answers go out after the access */
+};
+
+#define RNBD_REPLY_NS       50000
+
+static void rnbd_flush(Rnbd451Chardev *s)
+{
+    Chardev *chr = CHARDEV(s);
+    int n;
+
+    while (s->nout && (n = qemu_chr_be_can_write(chr)) > 0) {
+        n = MIN(n, (int)s->nout);
+        qemu_chr_be_write(chr, s->out, n);
+        memmove(s->out, s->out + n, s->nout - n);
+        s->nout -= n;
+    }
+}
+
+static void rnbd_say(Rnbd451Chardev *s, const char *text)
+{
+    size_t len = strlen(text);
+
+    if (s->in_reset) {
+        return;
+    }
+    len = MIN(len, RNBD_OUT - s->nout);
+    memcpy(s->out + s->nout, text, len);
+    s->nout += len;
+    /* Not from inside the UART model's own write: a little later */
+    if (!timer_pending(s->tx_timer)) {
+        timer_mod(s->tx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  RNBD_REPLY_NS);
+    }
+}
+
+static void rnbd_tx_timer(void *opaque)
+{
+    rnbd_flush(opaque);
+}
+
+static void rnbd_reboot(Rnbd451Chardev *s)
+{
+    s->cmd_mode = false;
+    s->nline = 0;
+    s->dollars = 0;
+    if (s->connected) {
+        s->connected = false;
+    }
+    rnbd_say(s, "%REBOOT%");
+}
+
+static void rnbd_command(Rnbd451Chardev *s, const char *cmd)
+{
+    g_autofree char *reply = NULL;
+
+    if (!*cmd) {
+        return;
+    }
+    if (!strcmp(cmd, "---")) {
+        s->cmd_mode = false;
+        rnbd_say(s, "END\r\n");
+        return;
+    }
+    if (!strcmp(cmd, "R,1")) {
+        rnbd_say(s, "Rebooting\r\n");
+        rnbd_reboot(s);
+        return;
+    }
+    if (!strcmp(cmd, "V")) {
+        reply = g_strdup_printf("%s\r\nCMD> ", s->version);
+    } else if (!strcmp(cmd, "D")) {
+        reply = g_strdup_printf("BTA=%s\r\nName=%s\r\nConnected=%s\r\n"
+                                "Authen=%u\r\nFeatures=%04X\r\n"
+                                "Services=%02X\r\nCMD> ", "D88039FA0000",
+                                s->name, s->connected ? "yes" : "no",
+                                s->authen, s->features, s->services);
+    } else if (!strncmp(cmd, "SN,", 3)) {
+        g_free(s->name);
+        s->name = g_strndup(cmd + 3, 20);
+        reply = g_strdup("AOK\r\nCMD> ");
+    } else if (!strncmp(cmd, "SR,", 3)) {
+        s->features = strtoul(cmd + 3, NULL, 16);
+        reply = g_strdup("AOK\r\nCMD> ");
+    } else if (!strncmp(cmd, "SS,", 3)) {
+        s->services = strtoul(cmd + 3, NULL, 16);
+        reply = g_strdup("AOK\r\nCMD> ");
+    } else if (!strncmp(cmd, "SA,", 3)) {
+        s->authen = strtoul(cmd + 3, NULL, 10);
+        reply = g_strdup("AOK\r\nCMD> ");
+    } else if (cmd[0] == 'S' || cmd[0] == 'U' || cmd[0] == 'A' ||
+               cmd[0] == 'Y' || cmd[0] == 'N' || cmd[0] == 'Z') {
+        reply = g_strdup("AOK\r\nCMD> ");
+    } else if (!strcmp(cmd, "GK")) {
+        reply = g_strdup_printf("%s\r\nCMD> ", s->connected ?
+                                "1,0,D88039FA0001" : "none");
+    } else {
+        qemu_log_mask(LOG_UNIMP, "rnbd451: command \"%s\" not modelled\n",
+                      cmd);
+        reply = g_strdup("Err\r\nCMD> ");
+    }
+    rnbd_say(s, reply);
+}
+
+/* MCU to module */
+static int rnbd_chr_write(Chardev *chr, const uint8_t *buf, int len)
+{
+    Rnbd451Chardev *s = CHARDEV_RNBD451(chr);
+
+    if (s->in_reset) {
+        return len;
+    }
+    for (int i = 0; i < len; i++) {
+        char c = buf[i];
+
+        if (!s->cmd_mode) {
+            s->dollars = c == '$' ? s->dollars + 1 : 0;
+            if (s->dollars == 3) {
+                s->dollars = 0;
+                s->cmd_mode = true;
+                s->nline = 0;
+                rnbd_say(s, "CMD> ");
+                continue;
+            }
+            if (s->connected && c != '$') {
+                g_string_append_c(s->central_rx, c);
+                if (s->central_rx->len > RNBD_CENTRAL_RX) {
+                    g_string_erase(s->central_rx, 0,
+                                   s->central_rx->len - RNBD_CENTRAL_RX);
+                }
+                s->central_rx_gen++;
+            }
+            continue;
+        }
+        if (c == '\r' || c == '\n') {
+            s->line[s->nline] = 0;
+            s->nline = 0;
+            rnbd_command(s, s->line);
+        } else if (s->nline < RNBD_LINE - 1) {
+            s->line[s->nline++] = c;
+        }
+    }
+    return len;
+}
+
+static void rnbd_chr_accept_input(Chardev *chr)
+{
+    rnbd_flush(CHARDEV_RNBD451(chr));
+}
+
+void rnbd451_reset_pin(void *opaque, int n, int level)
+{
+    Rnbd451Chardev *s = opaque;
+    bool low = level == 0;
+
+    if (s->in_reset && !low) {
+        s->in_reset = false;
+        rnbd_reboot(s);         /* released: boots */
+    } else if (low) {
+        s->in_reset = true;
+        s->nout = 0;
+    }
+}
+
+static bool rnbd_get_connected(Object *obj, Error **errp)
+{
+    return CHARDEV_RNBD451(obj)->connected;
+}
+
+static void rnbd_set_connected(Object *obj, bool value, Error **errp)
+{
+    Rnbd451Chardev *s = CHARDEV_RNBD451(obj);
+
+    if (value == s->connected) {
+        return;
+    }
+    s->connected = value;
+    if (value) {
+        rnbd_say(s, "%CONNECT,0,D88039FA0001%%STREAM_OPEN%");
+    } else {
+        rnbd_say(s, "%DISCONNECT%");
+    }
+}
+
+static char *rnbd_get_central_rx(Object *obj, Error **errp)
+{
+    return g_strdup(CHARDEV_RNBD451(obj)->central_rx->str);
+}
+
+static void rnbd_get_gen(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &CHARDEV_RNBD451(obj)->central_rx_gen, errp);
+}
+
+static char *rnbd_get_central_tx(Object *obj, Error **errp)
+{
+    return g_strdup("");
+}
+
+static void rnbd_set_central_tx(Object *obj, const char *value, Error **errp)
+{
+    Rnbd451Chardev *s = CHARDEV_RNBD451(obj);
+
+    if (s->connected && !s->cmd_mode) {
+        rnbd_say(s, value);
+    }
+}
+
+static char *rnbd_get_version(Object *obj, Error **errp)
+{
+    return g_strdup(CHARDEV_RNBD451(obj)->version);
+}
+
+static void rnbd_set_version(Object *obj, const char *value, Error **errp)
+{
+    Rnbd451Chardev *s = CHARDEV_RNBD451(obj);
+
+    g_free(s->version);
+    s->version = g_strdup(value);
+}
+
+static bool rnbd_chr_open(Chardev *chr, ChardevBackend *backend,
+                          Error **errp)
+{
+    return true;
+}
+
+static void rnbd_init(Object *obj)
+{
+    Rnbd451Chardev *s = CHARDEV_RNBD451(obj);
+
+    /* The kit on the desk answers V with this (2026-10-14) */
+    s->version = g_strdup("RNBD451 V1.0.0.10 Jul 20 2022 (c)Microchip "
+                          "Technology Inc");
+    s->services = 0xC0;
+    s->authen = 2;
+    s->name = g_strdup("RNBD451_0001");
+    s->central_rx = g_string_new(NULL);
+    s->tx_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rnbd_tx_timer, s);
+    object_property_add_bool(obj, "connected", rnbd_get_connected,
+                             rnbd_set_connected);
+    object_property_add_str(obj, "central-rx", rnbd_get_central_rx, NULL);
+    object_property_add(obj, "central-rx-gen", "uint32", rnbd_get_gen, NULL,
+                        NULL, NULL);
+    object_property_add_str(obj, "central-tx", rnbd_get_central_tx,
+                            rnbd_set_central_tx);
+    object_property_add_str(obj, "version", rnbd_get_version,
+                            rnbd_set_version);
+}
+
+static void rnbd_finalize(Object *obj)
+{
+    Rnbd451Chardev *s = CHARDEV_RNBD451(obj);
+
+    g_free(s->version);
+    g_free(s->name);
+    g_string_free(s->central_rx, true);
+    timer_free(s->tx_timer);
+}
+
+static void rnbd_class_init(ObjectClass *oc, const void *data)
+{
+    ChardevClass *cc = CHARDEV_CLASS(oc);
+
+    cc->chr_open = rnbd_chr_open;
+    cc->chr_write = rnbd_chr_write;
+    cc->chr_accept_input = rnbd_chr_accept_input;
+}
+
+static const TypeInfo rnbd_types[] = {
+    {
+        .name = TYPE_CHARDEV_RNBD451,
+        .parent = TYPE_CHARDEV,
+        .instance_size = sizeof(Rnbd451Chardev),
+        .instance_init = rnbd_init,
+        .instance_finalize = rnbd_finalize,
+        .class_init = rnbd_class_init,
+    },
+};
+
+DEFINE_TYPES(rnbd_types)
