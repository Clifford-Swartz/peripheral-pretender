diff --git a/hw/sensor/bno085.c b/hw/sensor/bno085.c
new file mode 100644
index 0000000..ec7aa51
--- /dev/null
+++ b/hw/sensor/bno085.c
@@ -0,0 +1,504 @@
+/*
+ * CEVA (Hillcrest) BNO085 9-axis sensor hub with SH-2 over SHTP on I2C
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SH-2 Reference Manual (1000-3625) and SHTP (1000-3535), I2C transport
+ * (BNO08X data sheet 1000-3927): every transfer carries a 4-byte header
+ * (length with bit 15 for continuations, channel, sequence number) and
+ * the cargo. Modelled as the Adafruit CircuitPython and Arduino drivers
+ * use it:
+ *
+ * - Channel 1 (executable) reset command 01h: the hub restarts, queues
+ *   its SHTP advertisement (channel 0) and the reset-complete message
+ *   (channel 1), and forgets the enabled features.
+ * - Channel 2 (control): product ID request F9h answered with F8h (part
+ *   10003608, version 3.2.7), Set Feature FDh answered with Get Feature
+ *   Response FCh, after which that report arrives on channel 3 every
+ *   report interval (a base timestamp FBh then the report), whenever the
+ *   host reads. Command requests F2h get a success response F1h.
+ * - Reports: accelerometer (01h, Q8 m/s^2), gyroscope (02h, Q9 rad/s),
+ *   magnetometer (03h, Q4 uT), linear acceleration (04h), rotation and
+ *   game rotation vectors (05h, 08h, Q14 quaternions), gravity (06h),
+ *   geomagnetic rotation vector (09h, Q12). They come from the "accel"
+ *   (mg), "gyro" (mdps), "mag" (nT) properties and "yaw" (millidegrees):
+ *   the orientation is roll and pitch from the gravity vector plus yaw.
+ *   Other reports are acknowledged and never sent.
+ *
+ * A read returns the oldest queued packet from its start and consumes it
+ * only when the host read it whole; with nothing queued it returns an
+ * empty header. Not modelled: FRS records, calibration, the activity and
+ * stability classifiers, step counter, H_INTN, the wake channel. Not
+ * checked against a physical part.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include <math.h>
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/i2c/i2c.h"
+#include "hw/sensor/bno085.h"
+#include "migration/vmstate.h"
+
+#define BNO_MAX_PACKET      256
+#define BNO_QUEUE           8
+#define BNO_NREPORTS        0x30
+
+#define CH_COMMAND          0
+#define CH_EXE              1
+#define CH_CONTROL          2
+#define CH_REPORTS          3
+
+#define R_COMMAND_RESP      0xF1
+#define R_COMMAND_REQ       0xF2
+#define R_PRODUCT_ID_RESP   0xF8
+#define R_PRODUCT_ID_REQ    0xF9
+#define R_BASE_TIMESTAMP    0xFB
+#define R_FEATURE_RESP      0xFC
+#define R_SET_FEATURE       0xFD
+#define R_GET_FEATURE       0xFE
+
+#define G_MPS2              9.80665
+
+typedef struct BnoPacket {
+    uint16_t len;               /* header included */
+    uint8_t data[BNO_MAX_PACKET];
+} BnoPacket;
+
+OBJECT_DECLARE_SIMPLE_TYPE(Bno085State, BNO085)
+
+struct Bno085State {
+    I2CSlave parent_obj;
+
+    BnoPacket queue[BNO_QUEUE];
+    uint8_t qhead;
+    uint8_t qcount;
+    uint16_t rpos;              /* bytes of the head packet read */
+    uint8_t seq_out[6];
+
+    uint8_t rx[BNO_MAX_PACKET];
+    uint16_t rxlen;
+
+    uint32_t interval_us[BNO_NREPORTS];  /* 0: off */
+    int64_t next_ns[BNO_NREPORTS];
+    uint8_t report_seq[BNO_NREPORTS];
+    uint8_t cmd_seq;
+
+    int32_t accel[3];           /* mg */
+    int32_t gyro[3];            /* mdps */
+    int32_t mag[3];             /* nT */
+    int32_t yaw;                /* millidegrees */
+};
+
+static void bno_queue(Bno085State *s, unsigned channel, const uint8_t *cargo,
+                      unsigned len)
+{
+    BnoPacket *p;
+
+    if (s->qcount == BNO_QUEUE || len + 4 > BNO_MAX_PACKET) {
+        qemu_log_mask(LOG_GUEST_ERROR, "bno085: output queue full, packet on"
+                      " channel %u dropped\n", channel);
+        return;
+    }
+    p = &s->queue[(s->qhead + s->qcount) % BNO_QUEUE];
+    p->len = len + 4;
+    stw_le_p(&p->data[0], p->len);
+    p->data[2] = channel;
+    p->data[3] = s->seq_out[channel]++;
+    memcpy(&p->data[4], cargo, len);
+    s->qcount++;
+}
+
+static void bno_restart(Bno085State *s)
+{
+    /* Advertisement: abbreviated tag list (version tag only) */
+    static const uint8_t advert[] = { 0x00, 0x01, 0x01, 0x80, 0x06, 0x31,
+                                      0x2E, 0x30, 0x2E, 0x30, 0x00 };
+    static const uint8_t reset_done[] = { 0x01 };
+
+    s->qhead = s->qcount = 0;
+    s->rpos = 0;
+    memset(s->seq_out, 0, sizeof(s->seq_out));
+    memset(s->interval_us, 0, sizeof(s->interval_us));
+    bno_queue(s, CH_COMMAND, advert, sizeof(advert));
+    bno_queue(s, CH_EXE, reset_done, sizeof(reset_done));
+}
+
+/* Orientation as a quaternion (w, x, y, z): roll/pitch from gravity, yaw */
+static void bno_quaternion(Bno085State *s, double q[4])
+{
+    double ax = s->accel[0], ay = s->accel[1], az = s->accel[2];
+    double roll = atan2(ay, az);
+    double pitch = atan2(-ax, sqrt(ay * ay + az * az));
+    double yaw = s->yaw / 1000.0 * M_PI / 180.0;
+    double cr = cos(roll / 2), sr = sin(roll / 2);
+    double cp = cos(pitch / 2), sp = sin(pitch / 2);
+    double cy = cos(yaw / 2), sy = sin(yaw / 2);
+
+    q[0] = cr * cp * cy + sr * sp * sy;
+    q[1] = sr * cp * cy - cr * sp * sy;
+    q[2] = cr * sp * cy + sr * cp * sy;
+    q[3] = cr * cp * sy - sr * sp * cy;
+}
+
+static int16_t bno_q(double v, int qpoint)
+{
+    double r = round(v * (1 << qpoint));
+
+    return MIN(MAX(r, INT16_MIN), INT16_MAX);
+}
+
+/* One input report into @out; returns its length (0: not produced) */
+static unsigned bno_report(Bno085State *s, uint8_t id, uint8_t *out)
+{
+    int16_t v[4] = { 0 };
+    unsigned n = 3, len = 10;
+    double q[4], g;
+
+    switch (id) {
+    case 0x01:                  /* accelerometer */
+    case 0x06:                  /* gravity */
+        for (unsigned i = 0; i < 3; i++) {
+            v[i] = bno_q(s->accel[i] / 1000.0 * G_MPS2, 8);
+        }
+        break;
+    case 0x04:                  /* linear acceleration: still */
+        break;
+    case 0x02:                  /* gyroscope */
+        for (unsigned i = 0; i < 3; i++) {
+            v[i] = bno_q(s->gyro[i] / 1000.0 * M_PI / 180.0, 9);
+        }
+        break;
+    case 0x03:                  /* magnetometer */
+        for (unsigned i = 0; i < 3; i++) {
+            v[i] = bno_q(s->mag[i] / 1000.0, 4);
+        }
+        break;
+    case 0x05:                  /* rotation vector */
+    case 0x08:                  /* game rotation vector */
+    case 0x09:                  /* geomagnetic rotation vector */
+        bno_quaternion(s, q);
+        g = id == 0x09 ? 12 : 14;
+        v[0] = bno_q(q[1], g);
+        v[1] = bno_q(q[2], g);
+        v[2] = bno_q(q[3], g);
+        v[3] = bno_q(q[0], g);
+        n = 4;
+        len = id == 0x08 ? 12 : 14;
+        break;
+    default:
+        return 0;
+    }
+    memset(out, 0, len);
+    out[0] = id;
+    out[1] = s->report_seq[id]++;
+    out[2] = 0x03;              /* status: high accuracy */
+    out[3] = 0;                 /* delay */
+    for (unsigned i = 0; i < n; i++) {
+        stw_le_p(&out[4 + 2 * i], v[i]);
+    }
+    return len;
+}
+
+/* Queue the reports that are due, in one packet */
+static void bno_produce(Bno085State *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint8_t cargo[BNO_MAX_PACKET - 4];
+    unsigned len = 5;
+
+    cargo[0] = R_BASE_TIMESTAMP;
+    stl_le_p(&cargo[1], 0);
+    for (unsigned id = 1; id < BNO_NREPORTS; id++) {
+        if (!s->interval_us[id] || now < s->next_ns[id] ||
+            len + 16 > sizeof(cargo)) {
+            continue;
+        }
+        len += bno_report(s, id, &cargo[len]);
+        s->next_ns[id] = now + (int64_t)s->interval_us[id] * 1000;
+    }
+    if (len > 5) {
+        bno_queue(s, CH_REPORTS, cargo, len);
+    }
+}
+
+static void bno_control(Bno085State *s, const uint8_t *c, unsigned len)
+{
+    uint8_t resp[20] = { 0 };
+
+    switch (c[0]) {
+    case R_PRODUCT_ID_REQ:
+        resp[0] = R_PRODUCT_ID_RESP;
+        resp[1] = 0x01;                 /* reset cause: power on */
+        resp[2] = 3;                    /* SW version major */
+        resp[3] = 2;                    /* minor */
+        stl_le_p(&resp[4], 10003608);   /* part number */
+        stl_le_p(&resp[8], 324);        /* build */
+        stw_le_p(&resp[12], 7);         /* patch */
+        bno_queue(s, CH_CONTROL, resp, 16);
+        break;
+    case R_SET_FEATURE:
+        if (len < 17) {
+            break;
+        }
+        if (c[1] < BNO_NREPORTS) {
+            uint32_t us = ldl_le_p(&c[5]);
+
+            s->interval_us[c[1]] = us ? MAX(us, 1000) : 0;
+            s->next_ns[c[1]] = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        }
+        memcpy(resp, c, 17);
+        resp[0] = R_FEATURE_RESP;
+        bno_queue(s, CH_CONTROL, resp, 17);
+        break;
+    case R_GET_FEATURE:
+        resp[0] = R_FEATURE_RESP;
+        resp[1] = c[1];
+        if (c[1] < BNO_NREPORTS) {
+            stl_le_p(&resp[5], s->interval_us[c[1]]);
+        }
+        bno_queue(s, CH_CONTROL, resp, 17);
+        break;
+    case R_COMMAND_REQ:
+        resp[0] = R_COMMAND_RESP;
+        resp[1] = s->cmd_seq++;
+        resp[2] = len > 2 ? c[2] : 0;   /* command */
+        resp[3] = len > 1 ? c[1] : 0;   /* its sequence number */
+        resp[4] = 0;
+        resp[5] = 0;                    /* status: success */
+        bno_queue(s, CH_CONTROL, resp, 16);
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "bno085: control report 0x%02x not "
+                      "modelled\n", c[0]);
+        break;
+    }
+}
+
+/* A complete packet from the host */
+static void bno_received(Bno085State *s)
+{
+    uint16_t len;
+
+    if (s->rxlen < 4) {
+        return;
+    }
+    len = MIN(lduw_le_p(s->rx) & 0x7FFF, s->rxlen);
+    if (len <= 4) {
+        return;
+    }
+    switch (s->rx[2]) {
+    case CH_EXE:
+        if (s->rx[4] == 1) {
+            bno_restart(s);
+        }
+        break;
+    case CH_CONTROL:
+        bno_control(s, &s->rx[4], len - 4);
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "bno085: write on channel %u not "
+                      "modelled\n", s->rx[2]);
+        break;
+    }
+}
+
+static int bno_event(I2CSlave *i2c, enum i2c_event event)
+{
+    Bno085State *s = BNO085(i2c);
+
+    switch (event) {
+    case I2C_START_SEND:
+        s->rxlen = 0;
+        break;
+    case I2C_START_RECV:
+        s->rpos = 0;
+        if (!s->qcount) {
+            bno_produce(s);
+        }
+        break;
+    case I2C_FINISH:
+        if (s->rxlen) {
+            bno_received(s);
+            s->rxlen = 0;
+        }
+        /* A read that covered the whole packet consumes it */
+        if (s->qcount && s->rpos >= s->queue[s->qhead].len) {
+            s->qhead = (s->qhead + 1) % BNO_QUEUE;
+            s->qcount--;
+        }
+        s->rpos = 0;
+        break;
+    default:
+        break;
+    }
+    return 0;
+}
+
+static int bno_send(I2CSlave *i2c, uint8_t data)
+{
+    Bno085State *s = BNO085(i2c);
+
+    if (s->rxlen < sizeof(s->rx)) {
+        s->rx[s->rxlen++] = data;
+    }
+    return 0;
+}
+
+static uint8_t bno_recv(I2CSlave *i2c)
+{
+    Bno085State *s = BNO085(i2c);
+    BnoPacket *p = &s->queue[s->qhead];
+    uint8_t v = 0;
+
+    if (!s->qcount) {
+        return 0;               /* empty header: no packet */
+    }
+    if (s->rpos < p->len) {
+        v = p->data[s->rpos];
+    }
+    s->rpos++;
+    return v;
+}
+
+static char *bno_get_vec(int32_t *v)
+{
+    return g_strdup_printf("%d %d %d", v[0], v[1], v[2]);
+}
+
+static void bno_set_vec(int32_t *dst, const char *value, Error **errp)
+{
+    int v[3];
+    char end;
+
+    if (sscanf(value, "%d %d %d %c", &v[0], &v[1], &v[2], &end) != 3) {
+        error_setg(errp, "expected three integers: \"x y z\"");
+        return;
+    }
+    memcpy(dst, v, sizeof(v));
+}
+
+static char *bno_get_accel(Object *obj, Error **errp)
+{
+    return bno_get_vec(BNO085(obj)->accel);
+}
+
+static void bno_set_accel(Object *obj, const char *v, Error **errp)
+{
+    bno_set_vec(BNO085(obj)->accel, v, errp);
+}
+
+static char *bno_get_gyro(Object *obj, Error **errp)
+{
+    return bno_get_vec(BNO085(obj)->gyro);
+}
+
+static void bno_set_gyro(Object *obj, const char *v, Error **errp)
+{
+    bno_set_vec(BNO085(obj)->gyro, v, errp);
+}
+
+static char *bno_get_mag(Object *obj, Error **errp)
+{
+    return bno_get_vec(BNO085(obj)->mag);
+}
+
+static void bno_set_mag(Object *obj, const char *v, Error **errp)
+{
+    bno_set_vec(BNO085(obj)->mag, v, errp);
+}
+
+static void bno_get_yaw(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, &BNO085(obj)->yaw, errp);
+}
+
+static void bno_set_yaw(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    int32_t yaw;
+
+    if (visit_type_int32(v, name, &yaw, errp)) {
+        BNO085(obj)->yaw = yaw;
+    }
+}
+
+static void bno_reset(DeviceState *dev)
+{
+    Bno085State *s = BNO085(dev);
+
+    s->rxlen = 0;
+    s->cmd_seq = 0;
+    memset(s->report_seq, 0, sizeof(s->report_seq));
+    bno_restart(s);
+}
+
+static void bno_init(Object *obj)
+{
+    Bno085State *s = BNO085(obj);
+
+    s->accel[2] = 1000;
+    s->mag[0] = 20000;
+    s->mag[2] = -40000;
+    object_property_add_str(obj, "accel", bno_get_accel, bno_set_accel);
+    object_property_add_str(obj, "gyro", bno_get_gyro, bno_set_gyro);
+    object_property_add_str(obj, "mag", bno_get_mag, bno_set_mag);
+    object_property_add(obj, "yaw", "int32", bno_get_yaw, bno_set_yaw, NULL,
+                        NULL);
+}
+
+static const VMStateDescription vmstate_bno085 = {
+    .name = TYPE_BNO085,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, Bno085State),
+        VMSTATE_UINT8(qhead, Bno085State),
+        VMSTATE_UINT8(qcount, Bno085State),
+        VMSTATE_UINT16(rpos, Bno085State),
+        VMSTATE_UINT8_ARRAY(seq_out, Bno085State, 6),
+        VMSTATE_UINT8_ARRAY(rx, Bno085State, BNO_MAX_PACKET),
+        VMSTATE_UINT16(rxlen, Bno085State),
+        VMSTATE_UINT32_ARRAY(interval_us, Bno085State, BNO_NREPORTS),
+        VMSTATE_INT64_ARRAY(next_ns, Bno085State, BNO_NREPORTS),
+        VMSTATE_UINT8_ARRAY(report_seq, Bno085State, BNO_NREPORTS),
+        VMSTATE_UINT8(cmd_seq, Bno085State),
+        VMSTATE_INT32_ARRAY(accel, Bno085State, 3),
+        VMSTATE_INT32_ARRAY(gyro, Bno085State, 3),
+        VMSTATE_INT32_ARRAY(mag, Bno085State, 3),
+        VMSTATE_INT32(yaw, Bno085State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void bno_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->desc = "BNO085 9-axis sensor hub (SH-2 over SHTP)";
+    dc->vmsd = &vmstate_bno085;
+    device_class_set_legacy_reset(dc, bno_reset);
+    k->event = bno_event;
+    k->send = bno_send;
+    k->recv = bno_recv;
+}
+
+static const TypeInfo bno_types[] = {
+    {
+        .name = TYPE_BNO085,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(Bno085State),
+        .instance_init = bno_init,
+        .class_init = bno_class_init,
+    },
+};
+
+DEFINE_TYPES(bno_types)
diff --git a/hw/sensor/icm20948.c b/hw/sensor/icm20948.c
new file mode 100644
index 0000000..66a2638
--- /dev/null
+++ b/hw/sensor/icm20948.c
@@ -0,0 +1,435 @@
+/*
+ * TDK InvenSense ICM-20948 9-axis motion sensor (I2C) with its AK09916
+ * magnetometer
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * ICM-20948 data sheet DS-000189 rev 1.3: four user banks of registers
+ * selected by REG_BANK_SEL (7Fh), I2C with a register address byte and
+ * auto-increment. Modelled: WHO_AM_I (EAh), PWR_MGMT_1 (DEVICE_RESET,
+ * SLEEP), the accelerometer, gyroscope and temperature outputs computed at
+ * read time from the "accel" (mg), "gyro" (mdps) and "temperature"
+ * (millidegrees C) properties with the full scales of ACCEL_CONFIG and
+ * GYRO_CONFIG_1 (bank 2), INT_STATUS_1.RAW_DATA_0_RDY while awake, and
+ * the auxiliary I2C master as far as drivers use it for the internal
+ * AK09916 (address 0Ch): SLV4 single transfers (I2C_MST_STATUS.SLV4_DONE)
+ * and SLV0 reads into EXT_SLV_SENS_DATA_xx. The AK09916 (data sheet
+ * 015007259-E-02): WIA1/WIA2 (48h/09h), CNTL2 modes, CNTL3 soft reset,
+ * ST1.DRDY in the measurement modes, HX..HZ at 0.15 uT/LSB from the
+ * "mag" property (nT). Everything else stores and reads back: the DMP,
+ * FIFO, low-power cycling, sample rate dividers, interrupts on INT1 and
+ * the other auxiliary slaves are not modelled. Not checked against a
+ * physical part.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "hw/i2c/i2c.h"
+#include "hw/sensor/icm20948.h"
+#include "migration/vmstate.h"
+
+#define BANKS               4
+#define BANK_SIZE           0x80
+
+/* Bank 0 */
+#define B0_WHO_AM_I         0x00
+#define B0_USER_CTRL        0x03
+#define B0_PWR_MGMT_1       0x06
+#define B0_I2C_MST_STATUS   0x17
+#define B0_INT_STATUS_1     0x1A
+#define B0_ACCEL_XOUT_H     0x2D
+#define B0_GYRO_XOUT_H      0x33
+#define B0_TEMP_OUT_H       0x39
+#define B0_EXT_SENS_00      0x3B
+#define B0_EXT_SENS_23      0x52
+#define REG_BANK_SEL        0x7F
+/* Bank 2 */
+#define B2_GYRO_CONFIG_1    0x01
+#define B2_ACCEL_CONFIG     0x14
+/* Bank 3 */
+#define B3_SLV0_ADDR        0x03
+#define B3_SLV0_REG         0x04
+#define B3_SLV0_CTRL        0x05
+#define B3_SLV4_ADDR        0x13
+#define B3_SLV4_REG         0x14
+#define B3_SLV4_CTRL        0x15
+#define B3_SLV4_DO          0x16
+#define B3_SLV4_DI          0x17
+
+#define WHO_AM_I            0xEA
+#define PWR_RESET           BIT(7)
+#define PWR_SLEEP           BIT(6)
+#define SLV_EN              BIT(7)
+#define SLV4_DONE           BIT(6)
+#define AK09916_ADDR        0x0C
+
+/* AK09916 */
+#define AK_WIA1             0x00
+#define AK_WIA2             0x01
+#define AK_ST1              0x10
+#define AK_HXL              0x11
+#define AK_ST2              0x18
+#define AK_CNTL2            0x31
+#define AK_CNTL3            0x32
+
+OBJECT_DECLARE_SIMPLE_TYPE(Icm20948State, ICM20948)
+
+struct Icm20948State {
+    I2CSlave parent_obj;
+
+    uint8_t regs[BANKS][BANK_SIZE];
+    uint8_t pointer;
+    bool addressed;
+    uint8_t ak_cntl2;
+
+    int32_t accel[3];           /* mg */
+    int32_t gyro[3];            /* mdps */
+    int32_t mag[3];             /* nT */
+    int32_t temperature;        /* millidegrees C */
+};
+
+static unsigned icm_bank(Icm20948State *s)
+{
+    return (s->regs[0][REG_BANK_SEL] >> 4) & 3;
+}
+
+static void icm_reset_regs(Icm20948State *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0][B0_WHO_AM_I] = WHO_AM_I;
+    s->regs[0][B0_PWR_MGMT_1] = 0x41;       /* SLEEP, CLKSEL 1 */
+    s->regs[0][0x05] = 0x40;                /* LP_CONFIG */
+    s->regs[2][B2_GYRO_CONFIG_1] = 0x01;
+    s->regs[2][B2_ACCEL_CONFIG] = 0x01;
+    s->ak_cntl2 = 0;
+}
+
+static int16_t icm_clamp16(int64_t v)
+{
+    return MIN(MAX(v, INT16_MIN), INT16_MAX);
+}
+
+/* AK09916 registers */
+static uint8_t ak_read(Icm20948State *s, uint8_t reg)
+{
+    bool measuring = s->ak_cntl2 & 0x1F;
+
+    switch (reg) {
+    case AK_WIA1:
+        return 0x48;
+    case AK_WIA2:
+        return 0x09;
+    case AK_ST1:
+        return measuring ? 0x01 : 0x00;
+    case AK_HXL ... AK_HXL + 5: {
+        unsigned axis = (reg - AK_HXL) / 2;
+        int16_t v = icm_clamp16(s->mag[axis] / 150);   /* 0.15 uT/LSB */
+
+        return (reg - AK_HXL) & 1 ? (uint16_t)v >> 8 : v & 0xFF;
+    }
+    case AK_ST2:
+        return 0x00;
+    case AK_CNTL2:
+        return s->ak_cntl2;
+    default:
+        return 0x00;
+    }
+}
+
+static void ak_write(Icm20948State *s, uint8_t reg, uint8_t val)
+{
+    if (reg == AK_CNTL2) {
+        s->ak_cntl2 = val & 0x1F;
+    } else if (reg == AK_CNTL3 && (val & 1)) {
+        s->ak_cntl2 = 0;
+    }
+}
+
+/* SLV4: one byte to or from the auxiliary bus, done at once */
+static void icm_slv4(Icm20948State *s)
+{
+    uint8_t addr = s->regs[3][B3_SLV4_ADDR];
+    uint8_t reg = s->regs[3][B3_SLV4_REG];
+
+    if ((addr & 0x7F) == AK09916_ADDR) {
+        if (addr & 0x80) {
+            s->regs[3][B3_SLV4_DI] = ak_read(s, reg);
+        } else {
+            ak_write(s, reg, s->regs[3][B3_SLV4_DO]);
+        }
+    } else {
+        qemu_log_mask(LOG_GUEST_ERROR, "icm20948: SLV4 to absent auxiliary "
+                      "device 0x%02x\n", addr & 0x7F);
+    }
+    s->regs[3][B3_SLV4_CTRL] &= ~SLV_EN;
+    s->regs[0][B0_I2C_MST_STATUS] |= SLV4_DONE;
+}
+
+/* SLV0 reads land in EXT_SLV_SENS_DATA (refreshed when read) */
+static uint8_t icm_ext_sens(Icm20948State *s, unsigned n)
+{
+    uint8_t addr = s->regs[3][B3_SLV0_ADDR];
+    uint8_t ctrl = s->regs[3][B3_SLV0_CTRL];
+
+    if (!(ctrl & SLV_EN) || !(addr & 0x80) ||
+        (addr & 0x7F) != AK09916_ADDR || n >= (ctrl & 0x0F) ||
+        !(s->regs[0][B0_USER_CTRL] & BIT(5))) {
+        return s->regs[0][B0_EXT_SENS_00 + n];
+    }
+    return ak_read(s, s->regs[3][B3_SLV0_REG] + n);
+}
+
+static uint8_t icm_read(Icm20948State *s, uint8_t reg)
+{
+    unsigned bank = icm_bank(s);
+    bool awake = !(s->regs[0][B0_PWR_MGMT_1] & PWR_SLEEP);
+    uint8_t val;
+
+    if (reg == REG_BANK_SEL) {
+        return s->regs[0][REG_BANK_SEL];
+    }
+    if (bank != 0) {
+        return s->regs[bank][reg & 0x7F];
+    }
+    switch (reg) {
+    case B0_ACCEL_XOUT_H ... B0_ACCEL_XOUT_H + 5: {
+        unsigned axis = (reg - B0_ACCEL_XOUT_H) / 2;
+        unsigned fs = (s->regs[2][B2_ACCEL_CONFIG] >> 1) & 3;
+        int16_t v = awake ? icm_clamp16((int64_t)s->accel[axis] *
+                                        (16384 >> fs) / 1000) : 0;
+
+        return (reg - B0_ACCEL_XOUT_H) & 1 ? v & 0xFF : (uint16_t)v >> 8;
+    }
+    case B0_GYRO_XOUT_H ... B0_GYRO_XOUT_H + 5: {
+        unsigned axis = (reg - B0_GYRO_XOUT_H) / 2;
+        unsigned fs = (s->regs[2][B2_GYRO_CONFIG_1] >> 1) & 3;
+        /* 131 LSB/dps at +-250 dps, halved per range step */
+        int16_t v = awake ? icm_clamp16((int64_t)s->gyro[axis] * 131 /
+                                        (1000 << fs)) : 0;
+
+        return (reg - B0_GYRO_XOUT_H) & 1 ? v & 0xFF : (uint16_t)v >> 8;
+    }
+    case B0_TEMP_OUT_H:
+    case B0_TEMP_OUT_H + 1: {
+        /* TEMP_degC = (TEMP_OUT - RoomTemp_Offset) / 333.87 + 21 */
+        int16_t v = icm_clamp16((int64_t)(s->temperature - 21000) * 33387 /
+                                100000);
+
+        return reg == B0_TEMP_OUT_H ? (uint16_t)v >> 8 : v & 0xFF;
+    }
+    case B0_EXT_SENS_00 ... B0_EXT_SENS_23:
+        return icm_ext_sens(s, reg - B0_EXT_SENS_00);
+    case B0_INT_STATUS_1:
+        return awake ? 0x01 : 0x00;
+    case B0_I2C_MST_STATUS:
+        val = s->regs[0][reg];
+        s->regs[0][reg] &= ~SLV4_DONE;      /* cleared by the read */
+        return val;
+    default:
+        return s->regs[0][reg & 0x7F];
+    }
+}
+
+static void icm_write(Icm20948State *s, uint8_t reg, uint8_t val)
+{
+    unsigned bank = icm_bank(s);
+
+    if (reg == REG_BANK_SEL) {
+        s->regs[0][REG_BANK_SEL] = val & 0x30;
+        return;
+    }
+    if (bank == 0) {
+        switch (reg) {
+        case B0_WHO_AM_I:
+        case B0_ACCEL_XOUT_H ... B0_EXT_SENS_23:
+            return;                 /* read-only */
+        case B0_PWR_MGMT_1:
+            if (val & PWR_RESET) {
+                icm_reset_regs(s);  /* the bit reads 0 again at once */
+                return;
+            }
+            break;
+        }
+    }
+    s->regs[bank][reg & 0x7F] = val;
+    if (bank == 3 && reg == B3_SLV4_CTRL && (val & SLV_EN)) {
+        icm_slv4(s);
+    }
+}
+
+static int icm_event(I2CSlave *i2c, enum i2c_event event)
+{
+    Icm20948State *s = ICM20948(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->addressed = false;
+    }
+    return 0;
+}
+
+static int icm_send(I2CSlave *i2c, uint8_t data)
+{
+    Icm20948State *s = ICM20948(i2c);
+
+    if (!s->addressed) {
+        s->pointer = data & 0x7F;
+        s->addressed = true;
+        return 0;
+    }
+    icm_write(s, s->pointer, data);
+    s->pointer = (s->pointer + 1) & 0x7F;
+    return 0;
+}
+
+static uint8_t icm_recv(I2CSlave *i2c)
+{
+    Icm20948State *s = ICM20948(i2c);
+    uint8_t val = icm_read(s, s->pointer);
+
+    s->pointer = (s->pointer + 1) & 0x7F;
+    return val;
+}
+
+/* "accel", "gyro", "mag": three integers "x y z" */
+static char *icm_get_vec(int32_t *v)
+{
+    return g_strdup_printf("%d %d %d", v[0], v[1], v[2]);
+}
+
+static bool icm_set_vec(int32_t *dst, const char *value, int32_t limit,
+                        const char *name, Error **errp)
+{
+    int v[3];
+    char end;
+
+    if (sscanf(value, "%d %d %d %c", &v[0], &v[1], &v[2], &end) != 3) {
+        error_setg(errp, "%s must be three integers: \"x y z\"", name);
+        return false;
+    }
+    for (unsigned i = 0; i < 3; i++) {
+        if (v[i] < -limit || v[i] > limit) {
+            error_setg(errp, "%s values must be within +-%d", name, limit);
+            return false;
+        }
+    }
+    memcpy(dst, v, sizeof(v));
+    return true;
+}
+
+static char *icm_get_accel(Object *obj, Error **errp)
+{
+    return icm_get_vec(ICM20948(obj)->accel);
+}
+
+static void icm_set_accel(Object *obj, const char *value, Error **errp)
+{
+    icm_set_vec(ICM20948(obj)->accel, value, 16000, "accel (mg)", errp);
+}
+
+static char *icm_get_gyro(Object *obj, Error **errp)
+{
+    return icm_get_vec(ICM20948(obj)->gyro);
+}
+
+static void icm_set_gyro(Object *obj, const char *value, Error **errp)
+{
+    icm_set_vec(ICM20948(obj)->gyro, value, 2000000, "gyro (mdps)", errp);
+}
+
+static char *icm_get_mag(Object *obj, Error **errp)
+{
+    return icm_get_vec(ICM20948(obj)->mag);
+}
+
+static void icm_set_mag(Object *obj, const char *value, Error **errp)
+{
+    icm_set_vec(ICM20948(obj)->mag, value, 4900000, "mag (nT)", errp);
+}
+
+static void icm_get_temp(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, &ICM20948(obj)->temperature, errp);
+}
+
+static void icm_set_temp(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    int32_t t;
+
+    if (visit_type_int32(v, name, &t, errp)) {
+        ICM20948(obj)->temperature = t;
+    }
+}
+
+static void icm_reset(DeviceState *dev)
+{
+    Icm20948State *s = ICM20948(dev);
+
+    icm_reset_regs(s);
+    s->pointer = 0;
+    s->addressed = false;
+}
+
+static void icm_init(Object *obj)
+{
+    Icm20948State *s = ICM20948(obj);
+
+    s->accel[2] = 1000;             /* flat, face up */
+    s->mag[0] = 20000;              /* a plausible earth field (nT) */
+    s->mag[2] = -40000;
+    s->temperature = 25000;
+    object_property_add_str(obj, "accel", icm_get_accel, icm_set_accel);
+    object_property_add_str(obj, "gyro", icm_get_gyro, icm_set_gyro);
+    object_property_add_str(obj, "mag", icm_get_mag, icm_set_mag);
+    object_property_add(obj, "temperature", "int32", icm_get_temp,
+                        icm_set_temp, NULL, NULL);
+}
