+/*
+ * Microchip RNBD451 Bluetooth Low Energy module on a UART
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A chardev type: create it with qemu_chardev_new(id, TYPE_CHARDEV_RNBD451,
+ * NULL, NULL, errp) and give it to the UART model. rnbd451_reset_pin() is
+ * a qemu_irq handler (opaque: the chardev) for the module's active-low
+ * reset (NMCLR).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_RNBD451_H
+#define HW_MISC_RNBD451_H
+
+#define TYPE_CHARDEV_RNBD451 "chardev-rnbd451"
+
+void rnbd451_reset_pin(void *opaque, int n, int level);
+
+#endif /* HW_MISC_RNBD451_H */
