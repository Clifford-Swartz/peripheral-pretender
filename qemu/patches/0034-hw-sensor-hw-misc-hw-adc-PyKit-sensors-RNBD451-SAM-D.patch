new file mode 100644
index 0000000..b5db2a5
--- /dev/null
+++ b/hw/adc/mchp_adc.c
@@ -0,0 +1,357 @@
+/*
+ * Microchip SAM D5x/E5x ADC (ADC U2500)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Conversions as in DS60001507 (ADC chapter), completed at once: a start
+ * (SWTRIG.START, or each RESULT read in free-running mode) converts
+ * INPUTCTRL.MUXPOS (minus MUXNEG in differential mode) against
+ * REFCTRL.REFSEL into RESULT with the resolution of CTRLB.RESSEL, the
+ * accumulation and right shift of AVGCTRL and LEFTADJ, and sets
+ * INTFLAG.RESRDY (cleared by reading RESULT; OVERRUN when a result
+ * replaces an unread one). Inputs:
+ *
+ * - AIN0..AIN23: the "ain" property ("channel=millivolts,..."; the board
+ *   sets the pins' voltages; unset inputs read "ain-default", 0 mV);
+ * - SCALEDIOVCC, SCALEDCOREVCC, SCALEDVBAT: "vdd" / 4, 1.2 V / 4, VBAT
+ *   ("vdd") / 4; BANDGAP: 1.0 V;
+ * - PTAT, CTAT: the die temperature ("temperature", millidegrees C)
+ *   interpolated between the factory points of the device's TEMP_LOG row
+ *   (read from the NVM rows at 0x00800100), so that the data sheet's
+ *   formula gives that temperature back.
+ *
+ * References: INTREF 1.0 V (SUPC VREF.SEL at reset), INTVCC0 = VDDANA / 2,
+ * INTVCC1 = VDDANA, AREFx = VDDANA. Not modelled: gain and offset
+ * correction (logged), window monitor, DMA sequencing, events, the
+ * conversion time, dual mode.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "hw/adc/mchp_adc.h"
+#include "hw/mchp/gen/adc_u2500.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+#include "system/dma.h"
+
+#define ADC_NAIN            32
+#define TEMP_LOG_ADDR       0x00800100
+#define BANDGAP_MV          1000
+#define CORE_MV             1200
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpAdcState, MCHP_ADC)
+
+struct MchpAdcState {
+    MchpRegBlock parent_obj;
+
+    int32_t ain_mv[ADC_NAIN];   /* < 0: unset */
+    int32_t ain_default;
+    int32_t vdd_mv;
+    int32_t temperature;        /* millidegrees C */
+    bool unread;                /* a result not read yet */
+};
+
+static uint32_t adc_reg(MchpAdcState *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static void adc_set(MchpAdcState *s, hwaddr off, unsigned size, uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
+/* The factory temperature points: TL, TH in tenths of a degree, codes */
+static void adc_temp_log(int32_t *tl, int32_t *th, uint32_t *vpl,
+                         uint32_t *vph, uint32_t *vcl, uint32_t *vch)
+{
+    uint32_t w[3];
+
+    dma_memory_read(&address_space_memory, TEMP_LOG_ADDR, w, sizeof(w),
+                    MEMTXATTRS_UNSPECIFIED);
+    for (unsigned i = 0; i < 3; i++) {
+        w[i] = le32_to_cpu(w[i]);
+    }
+    *tl = (w[0] & 0xFF) * 10 + ((w[0] >> 8) & 0xF);
+    *th = ((w[0] >> 12) & 0xFF) * 10 + ((w[0] >> 20) & 0xF);
+    *vpl = (w[1] >> 8) & 0xFFF;
+    *vph = (w[1] >> 20) & 0xFFF;
+    *vcl = w[2] & 0xFFF;
+    *vch = (w[2] >> 12) & 0xFFF;
+}
+
+/* 12-bit PTAT or CTAT code at the die temperature (as calibrated) */
+static uint32_t adc_temp_code(MchpAdcState *s, bool ctat)
+{
+    int32_t tl, th;
+    uint32_t vpl, vph, vcl, vch;
+    int64_t t10 = s->temperature / 100;     /* tenths */
+    int64_t lo, hi;
+
+    adc_temp_log(&tl, &th, &vpl, &vph, &vcl, &vch);
+    if (th <= tl) {
+        return 2048;            /* no calibration: mid scale */
+    }
+    lo = ctat ? vcl : vpl;
+    hi = ctat ? vch : vph;
+    return MIN(MAX(lo + (hi - lo) * (t10 - tl) / (th - tl), 0), 4095);
+}
+
+static int32_t adc_input_mv(MchpAdcState *s, unsigned mux)
+{
+    switch (mux) {
+    case MCHP_ADC_INPUTCTRL_MUXPOS_SCALEDCOREVCC:
+        return CORE_MV / 4;
+    case MCHP_ADC_INPUTCTRL_MUXPOS_SCALEDVBAT:
+    case MCHP_ADC_INPUTCTRL_MUXPOS_SCALEDIOVCC:
+        return s->vdd_mv / 4;
+    case MCHP_ADC_INPUTCTRL_MUXPOS_BANDGAP:
+        return BANDGAP_MV;
+    case MCHP_ADC_INPUTCTRL_MUXPOS_DAC:
+    case MCHP_ADC_INPUTCTRL_MUXPOS_PTC:
+        return 0;
+    default:
+        if (mux < ADC_NAIN) {
+            return s->ain_mv[mux] >= 0 ? s->ain_mv[mux] : s->ain_default;
+        }
+        return 0;
+    }
+}
+
+static int32_t adc_ref_mv(MchpAdcState *s)
+{
+    switch (FIELD_EX32(adc_reg(s, A_MCHP_ADC_REFCTRL, 1), MCHP_ADC_REFCTRL,
+                       REFSEL)) {
+    case MCHP_ADC_REFCTRL_REFSEL_INTREF:
+        return 1000;
+    case MCHP_ADC_REFCTRL_REFSEL_INTVCC0:
+        return s->vdd_mv / 2;
+    default:
+        return s->vdd_mv;
+    }
+}
+
+static void adc_convert(MchpAdcState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t in = adc_reg(s, A_MCHP_ADC_INPUTCTRL, 2);
+    uint32_t ctrlb = adc_reg(s, A_MCHP_ADC_CTRLB, 2);
+    uint32_t avg = adc_reg(s, A_MCHP_ADC_AVGCTRL, 1);
+    unsigned pos = FIELD_EX32(in, MCHP_ADC_INPUTCTRL, MUXPOS);
+    unsigned res = FIELD_EX32(ctrlb, MCHP_ADC_CTRLB, RESSEL);
+    unsigned bits = res == 2 ? 10 : res == 3 ? 8 : 12;
+    unsigned n = FIELD_EX32(avg, MCHP_ADC_AVGCTRL, SAMPLENUM);
+    unsigned adj = FIELD_EX32(avg, MCHP_ADC_AVGCTRL, ADJRES);
+    bool diff = FIELD_EX32(in, MCHP_ADC_INPUTCTRL, DIFFMODE);
+    int64_t code, vref = adc_ref_mv(s);
+
+    if (!FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLA, 2), MCHP_ADC_CTRLA,
+                    ENABLE)) {
+        return;
+    }
+    if (pos == MCHP_ADC_INPUTCTRL_MUXPOS_PTAT ||
+        pos == MCHP_ADC_INPUTCTRL_MUXPOS_CTAT) {
+        code = adc_temp_code(s, pos == MCHP_ADC_INPUTCTRL_MUXPOS_CTAT);
+        code >>= 12 - bits;
+    } else {
+        int64_t mv = adc_input_mv(s, pos);
+        int64_t full = (1 << bits) - 1;
+
+        if (diff) {
+            mv -= adc_input_mv(s, FIELD_EX32(in, MCHP_ADC_INPUTCTRL, MUXNEG));
+            code = vref ? mv * (full / 2) / vref : 0;
+            code = MIN(MAX(code, -full / 2 - 1), full / 2);
+        } else {
+            code = vref ? (mv * full + vref / 2) / vref : 0;
+            code = MIN(MAX(code, 0), full);
+        }
+    }
+    if (res == 1) {             /* 16-bit: accumulate 2^n, shift ADJRES */
+        code = (code << n) >> adj;
+    }
+    if (FIELD_EX32(ctrlb, MCHP_ADC_CTRLB, LEFTADJ)) {
+        code <<= 16 - (res == 1 ? 16 : bits);
+    }
+    if (FIELD_EX32(ctrlb, MCHP_ADC_CTRLB, CORREN)) {
+        qemu_log_mask(LOG_UNIMP, "%s: gain/offset correction not "
+                      "modelled\n", rb->name);
+    }
+    if (s->unread) {
+        adc_set(s, A_MCHP_ADC_INTFLAG, 1, adc_reg(s, A_MCHP_ADC_INTFLAG, 1) |
+                R_MCHP_ADC_INTFLAG_OVERRUN_MASK);
+    }
+    adc_set(s, A_MCHP_ADC_RESULT, 2, (uint16_t)code);
+    adc_set(s, A_MCHP_ADC_INTFLAG, 1, adc_reg(s, A_MCHP_ADC_INTFLAG, 1) |
+            R_MCHP_ADC_INTFLAG_RESRDY_MASK);
+    s->unread = true;
+    mchp_regblock_update_irq(rb);
+}
+
+static uint32_t adc_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                             unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpAdcState *s = MCHP_ADC(rf->opaque);
+
+    if (ri->offset == A_MCHP_ADC_RESULT && side_effects) {
+        s->unread = false;
+        adc_set(s, A_MCHP_ADC_INTFLAG, 1, adc_reg(s, A_MCHP_ADC_INTFLAG, 1) &
+                ~R_MCHP_ADC_INTFLAG_RESRDY_MASK);
+        mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+        if (FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLB, 2), MCHP_ADC_CTRLB,
+                       FREERUN)) {
+            uint32_t v = stored;
+
+            adc_convert(s);     /* the next conversion is ready */
+            s->unread = true;
+            return v;
+        }
+    }
+    return stored;              /* STATUS, SYNCBUSY: idle and instant */
+}
+
+static void adc_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                           unsigned idx, uint32_t old, uint32_t written,
+                           uint32_t we)
+{
+    MchpAdcState *s = MCHP_ADC(rf->opaque);
+
+    if (ri->offset == A_MCHP_ADC_SWTRIG) {
+        if (written & we & R_MCHP_ADC_SWTRIG_FLUSH_MASK) {
+            s->unread = false;
+        }
+        if (written & we & R_MCHP_ADC_SWTRIG_START_MASK) {
+            adc_convert(s);
+        }
+        adc_set(s, A_MCHP_ADC_SWTRIG, 1, 0);
+    } else if (ri->offset == A_MCHP_ADC_CTRLB &&
+               FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLB, 2), MCHP_ADC_CTRLB,
+                          FREERUN)) {
+        adc_convert(s);
+    }
+}
+
+/* Two lines: 0 = OVERRUN, WINMON; 1 = RESRDY */
+static uint32_t adc_irq_lines(MchpRegBlock *rb)
+{
+    uint32_t pend = mchp_regfile_peek(&rb->rf, A_MCHP_ADC_INTFLAG, 1) &
+                    mchp_regfile_peek(&rb->rf, A_MCHP_ADC_INTENSET, 1);
+
+    return (pend & R_MCHP_ADC_INTFLAG_RESRDY_MASK ? 2 : 0) |
+           (pend & ~R_MCHP_ADC_INTFLAG_RESRDY_MASK ? 1 : 0);
+}
+
+static void adc_reset_hold(MchpRegBlock *rb)
+{
+    MCHP_ADC(rb)->unread = false;
+}
+
+/* "ain": "channel=mV,channel=mV" (a channel=-1 unsets it) */
+static char *adc_get_ain(Object *obj, Error **errp)
+{
+    MchpAdcState *s = MCHP_ADC(obj);
+    g_autoptr(GString) str = g_string_new(NULL);
+
+    for (unsigned i = 0; i < ADC_NAIN; i++) {
+        if (s->ain_mv[i] >= 0) {
+            g_string_append_printf(str, "%s%u=%d", str->len ? "," : "", i,
+                                   s->ain_mv[i]);
+        }
+    }
+    return g_string_free(g_steal_pointer(&str), false);
+}
+
+static void adc_set_ain(Object *obj, const char *value, Error **errp)
+{
+    MchpAdcState *s = MCHP_ADC(obj);
+    g_auto(GStrv) items = g_strsplit(value, ",", -1);
+
+    for (unsigned i = 0; items[i]; i++) {
+        unsigned ch;
+        int mv;
+
+        if (!*items[i]) {
+            continue;
+        }
+        if (sscanf(items[i], "%u=%d", &ch, &mv) != 2 || ch >= ADC_NAIN) {
+            error_setg(errp, "ain items must be channel=millivolts, "
+                       "channel 0-%d", ADC_NAIN - 1);
+            return;
+        }
+        s->ain_mv[ch] = mv < 0 ? -1 : mv;
+    }
+}
+
+static void adc_get_i32(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, opaque, errp);
+}
+
+static void adc_set_i32(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, opaque, errp);
+}
+
+static void adc_init(Object *obj)
+{
+    MchpAdcState *s = MCHP_ADC(obj);
+
+    for (unsigned i = 0; i < ADC_NAIN; i++) {
+        s->ain_mv[i] = -1;
+    }
+    s->vdd_mv = 3300;
+    s->temperature = 25000;
+    object_property_add_str(obj, "ain", adc_get_ain, adc_set_ain);
+    object_property_add(obj, "ain-default", "int32", adc_get_i32,
+                        adc_set_i32, NULL, &s->ain_default);
+    object_property_add(obj, "vdd", "int32", adc_get_i32, adc_set_i32, NULL,
+                        &s->vdd_mv);
+    object_property_add(obj, "temperature", "int32", adc_get_i32,
+                        adc_set_i32, NULL, &s->temperature);
+}
+
+static const VMStateDescription vmstate_mchp_adc = {
+    .name = TYPE_MCHP_ADC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpAdcState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_INT32_ARRAY(ain_mv, MchpAdcState, ADC_NAIN),
+        VMSTATE_INT32(ain_default, MchpAdcState),
+        VMSTATE_INT32(vdd_mv, MchpAdcState),
+        VMSTATE_INT32(temperature, MchpAdcState),
+        VMSTATE_BOOL(unread, MchpAdcState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void adc_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_adc;
+    c->pre_read = adc_pre_read;
+    c->post_write = adc_post_write;
+    c->reset_hold = adc_reset_hold;
+    c->irq_lines = adc_irq_lines;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_adc_types[] = {
+    {
+        .name = TYPE_MCHP_ADC,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpAdcState),
+        .instance_init = adc_init,
+        .class_init = adc_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_adc_types)
