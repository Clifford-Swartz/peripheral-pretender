+        VMSTATE_INT32_ARRAY(mag, Icm20948State, 3),
+        VMSTATE_INT32(temperature, Icm20948State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void icm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
