+/* Expand 2 Click on mikroBUS 2: MCP23017 at 0x20 on TWI0 */
+static void test_expand2_mb2(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb2=expand2 "
+                                  "-kernel %s", (const char *)fw);
+    uint8_t d[1];
+
+    qtest_writeb(qts, TWI0 + T_MCTRLA, 0x03);
+    qtest_writeb(qts, TWI0 + T_MSTATUS, 0x01);
+    qtest_writeb(qts, TWI0 + T_MADDR, 0x20 << 1);       /* GPPUB = FFh */
+    qtest_writeb(qts, TWI0 + T_MDATA, 0x0d);
+    qtest_writeb(qts, TWI0 + T_MDATA, 0xff);
+    qtest_writeb(qts, TWI0 + T_MCTRLB, 0x03);
+    qtest_qmp_assert_success(qts, "{ 'execute': 'qom-set', 'arguments': {"
+                             " 'path': '/machine/mb2-click',"
+                             " 'property': 'pb1', 'value': true } }");
+    twi_read(qts, 0x20, 0x13, d, 1);                    /* GPIOB */
+    g_assert_cmphex(d[0], ==, 0xfd);
+    qtest_quit(qts);
+}
