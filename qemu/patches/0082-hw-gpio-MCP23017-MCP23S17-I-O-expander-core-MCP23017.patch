diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index dbee6c7..991de65 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -820,6 +820,84 @@ static void i2c_rd(QTestState *qts, uint8_t addr, uint8_t reg, uint8_t *d,
     i2c_stop(qts);
 }
 
+#define MCP23017        0x20
+
+static uint8_t exp_reg(QTestState *qts, uint8_t reg)
+{
+    uint8_t v;
+
+    i2c_rd(qts, MCP23017, reg, &v, 1);
+    return v;
+}
+
+static void exp_set(QTestState *qts, uint8_t reg, uint8_t v)
+{
+    g_assert_true(i2c_wr(qts, MCP23017, reg, &v, 1));
+}
+
+/*
+ * Expand 2 Click on EXT1: MCP23017 at 0x20 on SERCOM2, INTA on INT
+ * (PB02), RESET# on RST (PA20)
+ */
+static void test_expand2(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext1=expand2 ");
+    uint8_t d[2];
+
+    i2c_rd(qts, MCP23017, 0x00, d, 2);                  /* IODIRA, IODIRB */
+    g_assert_cmphex(d[0], ==, 0xff);
+    g_assert_cmphex(d[1], ==, 0xff);
+    g_assert_true(int_high(qts));                       /* INTA inactive */
+    exp_set(qts, 0x0c, 0xff);                           /* GPPUA */
+    g_assert_cmphex(exp_reg(qts, 0x12), ==, 0xff);      /* GPIOA pulled */
+    qtest_qom_set_bool(qts, CLICK1, "pa3", true);
+    g_assert_cmphex(exp_reg(qts, 0x12), ==, 0xf7);
+    qtest_qom_set_bool(qts, CLICK1, "pa3", false);
+    exp_set(qts, 0x02, 0x01);                           /* IPOLA bit 0 */
+    g_assert_cmphex(exp_reg(qts, 0x12), ==, 0xfe);
+    exp_set(qts, 0x02, 0x00);
+
+    exp_set(qts, 0x01, 0x00);                           /* IODIRB: out */
+    exp_set(qts, 0x15, 0xa5);                           /* OLATB */
+    g_assert_cmphex(qom_int(qts, CLICK1, "levels") >> 8, ==, 0xa5);
+    g_assert_cmphex(exp_reg(qts, 0x13), ==, 0xa5);      /* GPIOB */
+
+    /* Interrupt on change of GPA3: INTF, INTCAP, cleared by INTCAP */
+    exp_set(qts, 0x04, 0x08);                           /* GPINTENA */
+    g_assert_true(int_high(qts));
+    qtest_qom_set_bool(qts, CLICK1, "pa3", true);
+    g_assert_false(int_high(qts));
+    qtest_qom_set_bool(qts, CLICK1, "pa3", false);      /* still latched */
+    g_assert_false(int_high(qts));
+    g_assert_cmphex(exp_reg(qts, 0x0e), ==, 0x08);      /* INTFA */
+    g_assert_cmphex(exp_reg(qts, 0x10), ==, 0xf7);      /* INTCAPA */
+    g_assert_true(int_high(qts));
+    /* Against DEFVAL: active as long as the pin differs */
+    exp_set(qts, 0x06, 0x08);                           /* DEFVALA */
+    exp_set(qts, 0x08, 0x08);                           /* INTCONA */
+    qtest_qom_set_bool(qts, CLICK1, "pa3", true);
+    g_assert_false(int_high(qts));
+    exp_reg(qts, 0x12);
+    g_assert_false(int_high(qts));                      /* raised again */
+    qtest_qom_set_bool(qts, CLICK1, "pa3", false);
+    exp_reg(qts, 0x12);
+    g_assert_true(int_high(qts));
+
+    /* BANK = 1: port B at 10h; sequential reads wrap */
+    exp_set(qts, 0x0a, 0x80);
+    g_assert_cmphex(exp_reg(qts, 0x10), ==, 0x00);      /* IODIRB */
+    g_assert_cmphex(exp_reg(qts, 0x1a), ==, 0xa5);      /* OLATB */
+    exp_set(qts, 0x05, 0x00);                           /* IOCON: BANK 0 */
+    g_assert_cmphex(exp_reg(qts, 0x0a), ==, 0x00);
+
+    /* RESET# low: the power-on state */
+    qtest_writel(qts, PA + P_OUTCLR, BIT(20));
+    qtest_writel(qts, PA + P_DIRSET, BIT(20));
+    qtest_writel(qts, PA + P_OUTSET, BIT(20));
+    g_assert_cmphex(exp_reg(qts, 0x01), ==, 0xff);
+    qtest_quit(qts);
+}
