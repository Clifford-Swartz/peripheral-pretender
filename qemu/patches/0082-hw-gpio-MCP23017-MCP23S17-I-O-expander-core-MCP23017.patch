diff --git a/include/hw/gpio/mchp_mcp23x17.h b/include/hw/gpio/mchp_mcp23x17.h
new file mode 100644
index 0000000..22bb529
--- /dev/null
+++ b/include/hw/gpio/mchp_mcp23x17.h
@@ -0,0 +1,79 @@
+/*
+ * Microchip MCP23017/MCP23S17 16-bit I/O expanders
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Mcp23x17 is the register file, pins and interrupt logic both parts
+ * share; the bus side (I2C for the MCP23017, SPI for the MCP23S17) sets
+ * the address pointer and moves bytes through mcp23x17_read() and
+ * mcp23x17_write().
+ *
+ * "mchp-mcp23017": an I2C target (address 0x20 + A2..A0, set by the
+ * board). GPIO outputs "inta" and "intb" (0/1 push-pull, or 0 and -1
+ * open-drain with IOCON.ODR); GPIO input "reset" (RESET#: low holds the
+ * registers at their power-on values; undriven reads high). QOM
+ * properties: "levels" (read-only uint32: the pads, GPA in bits 7:0, GPB
+ * in 15:8), "drive" ("<mask> <level>" in hex: external drivers on the
+ * pads) and "pa0".."pa7", "pb0".."pb7" (bool: that pad held to ground,
+ * as a button on the Expand 2 Click's header would).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_GPIO_MCHP_MCP23X17_H
+#define HW_GPIO_MCHP_MCP23X17_H
+
+#include "hw/core/irq.h"
+
+#define TYPE_MCHP_MCP23017 "mchp-mcp23017"
+
+#define MCHP_MCP23X17_INTA  "inta"
+#define MCHP_MCP23X17_INTB  "intb"
+#define MCHP_MCP23X17_RESET "reset"
+
+/* Register order within a port (the BANK = 1 layout) */
+enum {
+    MCP23X17_IODIR, MCP23X17_IPOL, MCP23X17_GPINTEN, MCP23X17_DEFVAL,
+    MCP23X17_INTCON, MCP23X17_IOCON, MCP23X17_GPPU, MCP23X17_INTF,
+    MCP23X17_INTCAP, MCP23X17_GPIO, MCP23X17_OLAT, MCP23X17_NREGS
+};
+
+#define MCP23X17_IOCON_BANK     0x80
+#define MCP23X17_IOCON_MIRROR   0x40
+#define MCP23X17_IOCON_SEQOP    0x20
+#define MCP23X17_IOCON_HAEN     0x08
+#define MCP23X17_IOCON_ODR      0x04
+#define MCP23X17_IOCON_INTPOL   0x02
+
+/* Called whenever a port's pads may have changed: @levels are its pads */
+typedef void Mcp23x17PinsFn(void *opaque, unsigned port, uint8_t levels);
+
+typedef struct Mcp23x17 {
+    uint8_t reg[2][MCP23X17_NREGS];     /* IOCON is shared: reg[0] */
+    uint8_t ptr;                        /* address pointer */
+    uint8_t ext_mask[2];                /* external drivers on the pads */
+    uint8_t ext_level[2];
+    uint8_t ref[2];                     /* pin-change reference */
+    uint8_t levels[2];                  /* pads as last reported */
+    bool pending[2];                    /* a port's interrupt */
+    bool in_reset;
+    qemu_irq intpin[2];                 /* INTA, INTB */
+    Mcp23x17PinsFn *pins_changed;
+    void *opaque;
+} Mcp23x17;
+
+void mcp23x17_reset(Mcp23x17 *c);
+/* Register and port of address @addr; false for an unused address */
+bool mcp23x17_decode(Mcp23x17 *c, uint8_t addr, unsigned *reg,
+                     unsigned *port);
+void mcp23x17_set_ptr(Mcp23x17 *c, uint8_t addr);
+uint8_t mcp23x17_read(Mcp23x17 *c);         /* at the pointer, advances */
+void mcp23x17_write(Mcp23x17 *c, uint8_t val);
+void mcp23x17_set_reset(Mcp23x17 *c, bool low);
+void mcp23x17_drive(Mcp23x17 *c, unsigned port, uint8_t mask, uint8_t level);
+uint8_t mcp23x17_pads(Mcp23x17 *c, unsigned port);
+void mcp23x17_update(Mcp23x17 *c);
+extern const VMStateDescription vmstate_mcp23x17;
+
+#endif /* HW_GPIO_MCHP_MCP23X17_H */
