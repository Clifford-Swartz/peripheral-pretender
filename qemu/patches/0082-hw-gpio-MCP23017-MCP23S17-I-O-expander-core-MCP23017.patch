index 0000000..41de6a4
--- /dev/null
+++ b/hw/gpio/mchp_mcp23x17.c
@@ -0,0 +1,450 @@
+/*
+ * Microchip MCP23017/MCP23S17 16-bit I/O expanders, and the Expand 2 Click
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * MCP23017/MCP23S17 data sheet (DS20001952D), section 3:
+ *  - Registers in two layouts: IOCON.BANK = 0 pairs each port A register
+ *    with its port B twin (00h IODIRA, 01h IODIRB ... 15h OLATB), BANK = 1
+ *    puts port A at 00h-0Ah and port B at 10h-1Ah. IOCON appears at both
+ *    of its addresses. Power-on: IODIR FFh, everything else 0.
+ *  - The address pointer advances after each byte (IOCON.SEQOP = 0),
+ *    rolling over to 00h after the last register; in byte mode (SEQOP = 1)
+ *    it stays, except that with BANK = 0 it toggles within an A/B pair.
+ *  - Pads: an output (IODIR 0) drives OLAT; an input reads an external
+ *    driver, else its 100 kOhm pull-up (GPPU), else it floats (read as 0
+ *    here). GPIO reads the pads, inputs inverted by IPOL; writing GPIO
+ *    writes OLAT.
+ *  - Interrupt on change, for inputs with GPINTEN set: against the
+ *    previous value (INTCON 0) or against DEFVAL (INTCON 1). The first
+ *    event captures GPIO into INTCAP and sets INTF; the port's interrupt
+ *    stays active until GPIO or INTCAP of that port is read, which also
+ *    takes the pads as the new previous value. A pin that still differs
+ *    from DEFVAL raises it again at once.
+ *  - INTA follows port A, INTB port B, or either with IOCON.MIRROR;
+ *    active-low push-pull, active-high with INTPOL, open-drain (active
+ *    low, released otherwise) with ODR. RESET# low holds the power-on
+ *    state.
+ *  - On the MCP23017, GPA7 and GPB7 are outputs only (revision D, section
+ *    3.5.1: IO7 must be written 0). They still work as inputs here, and a
+ *    write of IODIR with IO7 set logs a guest error.
+ * Not modelled: the slew-rate control (DISSLW), the I2C general call and
+ * the 1.7 MHz high-speed mode.
+ *
+ * Expand 2 Click (MikroElektronika, schematic v100): an MCP23017 at 0x20
+ * (A2..A0 to ground through J3-J5, 100 kOhm pull-ups for the other
+ * position), INTA on INT (J2), RESET# on RST with no pull resistor, the
+ * ports on two headers. Not checked against a physical Click.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/gpio/mchp_mcp23x17.h"
+#include "hw/i2c/i2c.h"
+#include "migration/vmstate.h"
+
+#define IOCON(c)    ((c)->reg[0][MCP23X17_IOCON])
+
+bool mcp23x17_decode(Mcp23x17 *c, uint8_t addr, unsigned *reg,
+                     unsigned *port)
+{
+    if (IOCON(c) & MCP23X17_IOCON_BANK) {
+        *port = (addr >> 4) & 1;
+        *reg = addr & 0x0f;
+        return addr < 0x20 && *reg < MCP23X17_NREGS;
+    }
+    *port = addr & 1;
+    *reg = addr >> 1;
+    return addr < 2 * MCP23X17_NREGS;
+}
+
+static void mcp23x17_advance(Mcp23x17 *c)
+{
+    bool bank = IOCON(c) & MCP23X17_IOCON_BANK;
+
+    if (IOCON(c) & MCP23X17_IOCON_SEQOP) {
+        if (!bank) {
+            c->ptr ^= 1;                /* toggle within the A/B pair */
+        }
+        return;
+    }
+    if (!bank) {
+        c->ptr = (c->ptr + 1) % (2 * MCP23X17_NREGS);
+    } else if ((c->ptr & 0x0f) + 1 < MCP23X17_NREGS) {
+        c->ptr++;
+    } else {
+        c->ptr = c->ptr & 0x10 ? 0x00 : 0x10;
+    }
+}
+
+uint8_t mcp23x17_pads(Mcp23x17 *c, unsigned port)
+{
+    uint8_t *r = c->reg[port];
+    uint8_t in = r[MCP23X17_IODIR];
+    uint8_t ext = c->ext_mask[port] & in;
+    uint8_t pull = r[MCP23X17_GPPU] & in & ~ext;
+
+    return (r[MCP23X17_OLAT] & ~in) | (c->ext_level[port] & ext) | pull;
+}
+
+static uint8_t mcp23x17_gpio(Mcp23x17 *c, unsigned port)
+{
+    uint8_t *r = c->reg[port];
+
+    return mcp23x17_pads(c, port) ^ (r[MCP23X17_IPOL] & r[MCP23X17_IODIR]);
+}
+
+static void mcp23x17_drive_int(Mcp23x17 *c, unsigned pin, bool active)
+{
+    uint8_t iocon = IOCON(c);
+    int level;
+
+    if (iocon & MCP23X17_IOCON_ODR) {
+        level = active ? 0 : -1;
+    } else if (iocon & MCP23X17_IOCON_INTPOL) {
+        level = active;
+    } else {
+        level = !active;
+    }
+    qemu_set_irq(c->intpin[pin], level);
+}
+
+void mcp23x17_update(Mcp23x17 *c)
+{
+    bool mirror = IOCON(c) & MCP23X17_IOCON_MIRROR;
+
+    for (unsigned port = 0; port < 2; port++) {
+        uint8_t *r = c->reg[port];
+        uint8_t pads = mcp23x17_pads(c, port);
+        uint8_t armed = r[MCP23X17_GPINTEN] & r[MCP23X17_IODIR];
+        uint8_t against = (r[MCP23X17_DEFVAL] & r[MCP23X17_INTCON]) |
+                          (c->ref[port] & ~r[MCP23X17_INTCON]);
+        uint8_t hit = (pads ^ against) & armed;
+
+        if (!c->pending[port] && hit && !c->in_reset) {
+            c->pending[port] = true;
+            r[MCP23X17_INTF] = hit;
+            r[MCP23X17_INTCAP] = mcp23x17_gpio(c, port);
+        }
+        if (pads != c->levels[port]) {
+            c->levels[port] = pads;
+            if (c->pins_changed) {
+                c->pins_changed(c->opaque, port, pads);
+            }
+        }
+    }
+    mcp23x17_drive_int(c, 0, c->pending[0] || (mirror && c->pending[1]));
+    mcp23x17_drive_int(c, 1, c->pending[1] || (mirror && c->pending[0]));
+}
+
+static void mcp23x17_clear_int(Mcp23x17 *c, unsigned port)
+{
+    c->pending[port] = false;
+    c->reg[port][MCP23X17_INTF] = 0;
+    c->ref[port] = mcp23x17_pads(c, port);
+}
+
+void mcp23x17_reset(Mcp23x17 *c)
+{
+    memset(c->reg, 0, sizeof(c->reg));
+    c->reg[0][MCP23X17_IODIR] = 0xff;
+    c->reg[1][MCP23X17_IODIR] = 0xff;
+    c->ptr = 0;
+    for (unsigned port = 0; port < 2; port++) {
+        c->pending[port] = false;
+        c->ref[port] = mcp23x17_pads(c, port);
+    }
+    mcp23x17_update(c);
+}
+
+void mcp23x17_set_ptr(Mcp23x17 *c, uint8_t addr)
+{
+    c->ptr = addr;
+}
+
+uint8_t mcp23x17_read(Mcp23x17 *c)
+{
+    unsigned reg, port;
+    uint8_t val = 0;
+
+    if (!mcp23x17_decode(c, c->ptr, &reg, &port)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "mcp23x17: read of unused address "
+                      "0x%02x\n", c->ptr);
+    } else if (reg == MCP23X17_GPIO) {
+        val = mcp23x17_gpio(c, port);
+        mcp23x17_clear_int(c, port);
+        mcp23x17_update(c);
+    } else if (reg == MCP23X17_INTCAP) {
+        val = c->reg[port][reg];
+        mcp23x17_clear_int(c, port);
+        mcp23x17_update(c);
+    } else if (reg == MCP23X17_IOCON) {
+        val = IOCON(c);
+    } else {
+        val = c->reg[port][reg];
+    }
+    mcp23x17_advance(c);
+    return val;
+}
+
+void mcp23x17_write(Mcp23x17 *c, uint8_t val)
+{
+    unsigned reg, port;
+
+    if (c->in_reset) {
+        return;
+    }
+    if (!mcp23x17_decode(c, c->ptr, &reg, &port)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "mcp23x17: write of unused address "
+                      "0x%02x\n", c->ptr);
+    } else {
+        switch (reg) {
+        case MCP23X17_INTF:
+        case MCP23X17_INTCAP:
+            break;                      /* read-only */
+        case MCP23X17_IOCON:
+            IOCON(c) = val & 0xfe;
+            break;
+        case MCP23X17_GPIO:
+            c->reg[port][MCP23X17_OLAT] = val;
+            break;
+        default:
+            c->reg[port][reg] = val;
+            break;
+        }
+        mcp23x17_update(c);
+    }
+    mcp23x17_advance(c);
+}
+
+void mcp23x17_set_reset(Mcp23x17 *c, bool low)
+{
+    if (low) {
+        c->in_reset = false;
+        mcp23x17_reset(c);
+    }
+    c->in_reset = low;
+}
+
+void mcp23x17_drive(Mcp23x17 *c, unsigned port, uint8_t mask, uint8_t level)
+{
+    c->ext_mask[port] = mask;
+    c->ext_level[port] = level & mask;
+    mcp23x17_update(c);
+}
+
+const VMStateDescription vmstate_mcp23x17 = {
+    .name = "mcp23x17",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8_2DARRAY(reg, Mcp23x17, 2, MCP23X17_NREGS),
+        VMSTATE_UINT8(ptr, Mcp23x17),
+        VMSTATE_UINT8_ARRAY(ext_mask, Mcp23x17, 2),
+        VMSTATE_UINT8_ARRAY(ext_level, Mcp23x17, 2),
+        VMSTATE_UINT8_ARRAY(ref, Mcp23x17, 2),
+        VMSTATE_UINT8_ARRAY(levels, Mcp23x17, 2),
+        VMSTATE_BOOL_ARRAY(pending, Mcp23x17, 2),
+        VMSTATE_BOOL(in_reset, Mcp23x17),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+/* The MCP23017 on I2C: the first byte written sets the pointer */
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpMcp23017State, MCHP_MCP23017)
+
+struct MchpMcp23017State {
+    I2CSlave parent_obj;
+
+    Mcp23x17 core;
+    bool want_ptr;                      /* next byte written: the pointer */
+    uint16_t grounded;                  /* "pa0".."pb7" held down */
+    uint16_t drive_mask;                /* "drive" */
+    uint16_t drive_level;
+};
+
+static void mcp23017_apply(MchpMcp23017State *s)
+{
+    uint16_t mask = s->drive_mask | s->grounded;
+    uint16_t level = s->drive_level & ~s->grounded;
+
+    mcp23x17_drive(&s->core, 0, mask & 0xff, level & 0xff);
+    mcp23x17_drive(&s->core, 1, mask >> 8, level >> 8);
+}
+
+static int mcp23017_event(I2CSlave *i2c, enum i2c_event event)
+{
+    MchpMcp23017State *s = MCHP_MCP23017(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->want_ptr = true;
+    }
+    return 0;
+}
+
+static int mcp23017_send(I2CSlave *i2c, uint8_t data)
+{
+    MchpMcp23017State *s = MCHP_MCP23017(i2c);
+
+    if (s->want_ptr) {
+        s->want_ptr = false;
+        mcp23x17_set_ptr(&s->core, data);
+    } else {
+        unsigned reg, port;
+
+        if (mcp23x17_decode(&s->core, s->core.ptr, &reg, &port) &&
+            reg == MCP23X17_IODIR && (data & 0x80)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "mcp23017: IODIR%c with IO7 set: "
+                          "GP%c7 is an output only on the MCP23017\n",
+                          'A' + port, 'A' + port);
+        }
+        mcp23x17_write(&s->core, data);
+    }
+    return 0;
+}
+
+static uint8_t mcp23017_recv(I2CSlave *i2c)
+{
+    return mcp23x17_read(&MCHP_MCP23017(i2c)->core);
+}
+
+static void mcp23017_set_reset(void *opaque, int n, int level)
+{
+    MchpMcp23017State *s = opaque;
+
+    mcp23x17_set_reset(&s->core, level == 0);
+}
+
+static void mcp23017_get_levels(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    MchpMcp23017State *s = MCHP_MCP23017(obj);
+    uint32_t levels = mcp23x17_pads(&s->core, 0) |
+                      mcp23x17_pads(&s->core, 1) << 8;
+
+    visit_type_uint32(v, name, &levels, errp);
+}
+
+static char *mcp23017_get_drive(Object *obj, Error **errp)
+{
+    MchpMcp23017State *s = MCHP_MCP23017(obj);
+
+    return g_strdup_printf("%x %x", s->drive_mask, s->drive_level);
+}
+
+static void mcp23017_set_drive(Object *obj, const char *value, Error **errp)
+{
+    MchpMcp23017State *s = MCHP_MCP23017(obj);
+    unsigned mask, level;
+
+    if (sscanf(value, "%x %x", &mask, &level) != 2 || mask > 0xffff) {
+        error_setg(errp, "drive must be \"<mask> <level>\" in hex");
+        return;
+    }
+    s->drive_mask = mask;
+    s->drive_level = level & mask;
+    mcp23017_apply(s);
+}
+
+static void mcp23017_get_pad(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    MchpMcp23017State *s = MCHP_MCP23017(obj);
+    bool held = s->grounded & BIT(GPOINTER_TO_UINT(opaque));
+
+    visit_type_bool(v, name, &held, errp);
+}
+
+static void mcp23017_set_pad(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    MchpMcp23017State *s = MCHP_MCP23017(obj);
+    unsigned bit = GPOINTER_TO_UINT(opaque);
+    bool held;
+
+    if (!visit_type_bool(v, name, &held, errp)) {
+        return;
+    }
+    s->grounded = deposit32(s->grounded, bit, 1, held);
+    mcp23017_apply(s);
+}
+
+static void mcp23017_reset(DeviceState *dev)
+{
+    MchpMcp23017State *s = MCHP_MCP23017(dev);
+
+    s->want_ptr = false;
+    mcp23x17_reset(&s->core);
+}
+
+static void mcp23017_init(Object *obj)
+{
+    MchpMcp23017State *s = MCHP_MCP23017(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), &s->core.intpin[0],
+                             MCHP_MCP23X17_INTA, 1);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->core.intpin[1],
+                             MCHP_MCP23X17_INTB, 1);
+    qdev_init_gpio_in_named(DEVICE(obj), mcp23017_set_reset,
+                            MCHP_MCP23X17_RESET, 1);
+    object_property_add(obj, "levels", "uint32", mcp23017_get_levels, NULL,
+                        NULL, NULL);
+    object_property_add_str(obj, "drive", mcp23017_get_drive,
+                            mcp23017_set_drive);
+    for (unsigned bit = 0; bit < 16; bit++) {
+        g_autofree char *name = g_strdup_printf("p%c%u", 'a' + bit / 8,
+                                                bit % 8);
+
+        object_property_add(obj, name, "bool", mcp23017_get_pad,
+                            mcp23017_set_pad, NULL, GUINT_TO_POINTER(bit));
+    }
+}
+
+static const VMStateDescription vmstate_mcp23017 = {
+    .name = TYPE_MCHP_MCP23017,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, MchpMcp23017State),
+        VMSTATE_STRUCT(core, MchpMcp23017State, 1, vmstate_mcp23x17,
+                       Mcp23x17),
+        VMSTATE_BOOL(want_ptr, MchpMcp23017State),
+        VMSTATE_UINT16(grounded, MchpMcp23017State),
+        VMSTATE_UINT16(drive_mask, MchpMcp23017State),
+        VMSTATE_UINT16(drive_level, MchpMcp23017State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mcp23017_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->desc = "MCP23017 16-bit I2C I/O expander";
+    dc->vmsd = &vmstate_mcp23017;
+    device_class_set_legacy_reset(dc, mcp23017_reset);
+    k->event = mcp23017_event;
+    k->send = mcp23017_send;
+    k->recv = mcp23017_recv;
+}
+
+static const TypeInfo mcp23017_types[] = {
+    {
+        .name = TYPE_MCHP_MCP23017,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(MchpMcp23017State),
+        .instance_init = mcp23017_init,
+        .class_init = mcp23017_class_init,
+    },
+};
+
+DEFINE_TYPES(mcp23017_types)
