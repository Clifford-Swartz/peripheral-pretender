+++ b/include/hw/timer/mchp_tcc.h
@@ -0,0 +1,32 @@
+/*
+ * Microchip SAM/PIC32CM Timer/Counter for Control (TCC U2213)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A TYPE_MCHP_REGBLOCK subclass configured with mchp_regblock_set_info();
+ * the counter width comes from MchpInstanceInfo.counter_bits. GPIO lines:
+ *   "ovf-event", "trg-event", "cnt-event", "mc-event"[4]   out: a pulse per
+ *                  event with its EVCTRL output enable set
+ *   "ev-event-in"[2]       in: the event inputs TCCx_EV0 and TCCx_EV1
+ *   "ev-event-busy"[2]     out: 1 while the TCC cannot take events
+ * sysbus IRQ 0 is the TCC interrupt (INTFLAG & INTENSET).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_TIMER_MCHP_TCC_H
+#define HW_TIMER_MCHP_TCC_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_TCC "mchp-tcc"
+
+#define MCHP_TCC_OVF_EVENT "ovf-event"
+#define MCHP_TCC_TRG_EVENT "trg-event"
+#define MCHP_TCC_CNT_EVENT "cnt-event"
+#define MCHP_TCC_MC_EVENT "mc-event"
+#define MCHP_TCC_EV_EVENT_IN "ev-event-in"
+#define MCHP_TCC_EV_BUSY "ev-event-busy"
+
+#endif /* HW_TIMER_MCHP_TCC_H */
