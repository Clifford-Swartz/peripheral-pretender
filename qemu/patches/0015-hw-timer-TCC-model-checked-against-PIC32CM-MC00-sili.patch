diff --git a/hw/timer/mchp_tcc.c b/hw/timer/mchp_tcc.c
new file mode 100644
index 0000000..c3b89e7
--- /dev/null
+++ b/hw/timer/mchp_tcc.c
@@ -0,0 +1,1137 @@
+/*
+ * Microchip SAM/PIC32CM Timer/Counter for Control (TCC U2213)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Follows DS60001638E chapter 31 (PIC32CM MC00): counting from GCLK_TCC
+ * through the prescaler, up or down, in the single-slope (NFRQ, MFRQ,
+ * NPWM) and dual-slope (DSCRITICAL, DSBOTTOM, DSBOTH, DSTOP) waveform
+ * modes, TOP from PER (CC0 in MFRQ), the overflow and compare-match flags,
+ * one-shot, the RETRIGGER/STOP/UPDATE/READSYNC commands, double buffering
+ * of PER and CCx (updated at the wrap, or at ZERO in dual slope), the
+ * waveform output state in STATUS.CMPx, and the events: OVF, TRG, CNT and
+ * MCx out; RETRIGGER, COUNTEV, START, INC, COUNT, DIR, STOP and DEC in.
+ * COUNT reads return the last synchronized value (READSYNC first).
+ *
+ * Behaviour the data sheet leaves open follows PIC32CM MC00 silicon
+ * (firmware/hello/tests/tccprobe.c):
+ *  - MCx is set on the tick the counter becomes CCx; NPWM never flags
+ *    CCx = 0, dual slope flags only on the up-count for 0 < CCx < TOP.
+ *  - STATUS.CMPx changes on the tick the counter leaves the value of the
+ *    event (one tick after the waveform event of the data sheet), and reads
+ *    0 until the first tick after a start and while stopped.
+ *  - The dual-slope direction (CTRLBSET.DIR) and the OVF at TOP or ZERO
+ *    change on the tick that leaves TOP or ZERO.
+ *  - A PERBUF or CCBUFx write keeps SYNCBUSY.PER or SYNCBUSY.CCx set until
+ *    the buffer is copied (UPDATE condition or command); with CTRLB.LUPD
+ *    set it stays set. PERBUF written in NFRQ/MFRQ or when counting down
+ *    in PWM goes to PER at once (DS 31.6.2.6).
+ *  - STOP clears COUNT (TOP when counting down) and keeps the outputs;
+ *    one-shot stops with the outputs cleared.
+ *  - CNT (EVCTRL.CNTSEL): START at the first tick after a start (single
+ *    slope only) and at each new cycle; END at each cycle end; BETWEEN at
+ *    each cycle end but the last (one-shot); BOUNDARY at the first tick
+ *    and at a stop.
+ *  - With EVACT0 COUNTEV or INC the prescaled clock never moves the
+ *    counter, whatever TCEI0 says. INC counts up from COUNT without the
+ *    TOP wrap when CTRLB.DIR is set, except that from ZERO it loads TOP.
+ *    The EV1 STOP action sets STATUS.STOP. The start's CNT comes at
+ *    once in NFRQ, MFRQ and NPWM counting down.
+ * Not modelled: faults, dead-time insertion, pattern generation, output
+ * matrix, swap, dithering (CTRLA.RESOLUTION), circular buffers, capture,
+ * waveform pins, the DSCRITICAL waveform (counted as DSBOTTOM), sleep.
+ *
+ * Counting is event driven on QEMU_CLOCK_VIRTUAL: the timer fires at the
+ * next tick that can change something and jumps over the rest.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/clock.h"
+#include "hw/core/irq.h"
+#include "hw/timer/mchp_tcc.h"
+#include "hw/mchp/gen/tcc_u2213.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define A_CTRLA         A_MCHP_TCC_CTRLA
+#define A_CTRLBCLR      A_MCHP_TCC_CTRLBCLR
+#define A_CTRLBSET      A_MCHP_TCC_CTRLBSET
+#define A_SYNCBUSY      A_MCHP_TCC_SYNCBUSY
+#define A_FCTRLA        A_MCHP_TCC_FCTRLA
+#define A_FCTRLB        A_MCHP_TCC_FCTRLB
+#define A_WEXCTRL       A_MCHP_TCC_WEXCTRL
+#define A_DRVCTRL       A_MCHP_TCC_DRVCTRL
+#define A_EVCTRL        A_MCHP_TCC_EVCTRL
+#define A_INTFLAG       A_MCHP_TCC_INTFLAG
+#define A_STATUS        A_MCHP_TCC_STATUS
+#define A_COUNT         A_MCHP_TCC_COUNT
+#define A_PATT          A_MCHP_TCC_PATT
+#define A_WAVE          A_MCHP_TCC_WAVE
+#define A_PER           A_MCHP_TCC_PER
+#define A_CC            A_MCHP_TCC_CC
+#define A_PERBUF        A_MCHP_TCC_PERBUF
+#define A_CCBUF         A_MCHP_TCC_CCBUF
+
+#define F(reg, field)   R_MCHP_TCC_##reg##_##field##_MASK
+
+#define MCHP_TCC_CHANNELS   4
+#define MCHP_TCC_MAX_STEPS  64
+#define NEVER               UINT64_MAX
+
+enum {
+    NFRQ = MCHP_TCC_WAVE_WAVEGEN_NFRQ,
+    MFRQ = MCHP_TCC_WAVE_WAVEGEN_MFRQ,
+    NPWM = MCHP_TCC_WAVE_WAVEGEN_NPWM,
+    DSCRITICAL = MCHP_TCC_WAVE_WAVEGEN_DSCRITICAL,
+    DSBOTTOM = MCHP_TCC_WAVE_WAVEGEN_DSBOTTOM,
+    DSBOTH = MCHP_TCC_WAVE_WAVEGEN_DSBOTH,
+    DSTOP = MCHP_TCC_WAVE_WAVEGEN_DSTOP,
+};
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpTccState, MCHP_TCC)
+
+struct MchpTccState {
+    MchpRegBlock parent_obj;
+
+    QEMUTimer *timer;
+    qemu_irq ovf_event;
+    qemu_irq trg_event;
+    qemu_irq cnt_event;
+    qemu_irq mc_event[MCHP_TCC_CHANNELS];
+    qemu_irq ev_busy[2];
+
+    bool running;               /* counting (started, not stopped) */
+    bool moved;                 /* ticked since the start */
+    bool cnt_pending;           /* the start's CNT comes with the 1st tick */
+    uint8_t frozen_cmp;         /* STATUS.CMPx while stopped */
+    uint32_t buf_busy;          /* SYNCBUSY bits of buffers not yet copied */
+    bool down;                  /* direction of the last tick */
+    bool ev_level[2];           /* event inputs */
+    uint8_t toggle;             /* NFRQ/MFRQ outputs, per channel */
+    uint32_t count;             /* counter value at t_base */
+    uint32_t prev;              /* counter value before the last tick */
+    uint32_t sync_pending;      /* SYNCBUSY bits waiting for GCLK_TCC */
+    int64_t t_base;             /* QEMU_CLOCK_VIRTUAL ns */
+
+    /* Counting geometry, refreshed from the registers after each change */
+    uint8_t wavegen;
+    bool dir;                   /* CTRLB.DIR */
+    uint32_t top;
+    uint32_t cc[MCHP_TCC_CHANNELS];
+};
+
+static const uint16_t mchp_tcc_prescale[] = { 1, 2, 4, 8, 16, 64, 256, 1024 };
+
+static uint32_t tcc_reg(MchpTccState *s, hwaddr offset, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, offset, size);
+}
+
+static void tcc_set_reg(MchpTccState *s, hwaddr offset, unsigned size,
+                        uint32_t val)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, offset, size, val);
+}
+
+static void tcc_mod_reg(MchpTccState *s, hwaddr offset, unsigned size,
+                        uint32_t clear, uint32_t set)
+{
+    tcc_set_reg(s, offset, size, (tcc_reg(s, offset, size) & ~clear) | set);
+}
+
+static uint32_t tcc_max(MchpTccState *s)
+{
+    unsigned bits = MCHP_REGBLOCK(s)->info->counter_bits;
+
+    return MAKE_64BIT_MASK(0, bits ? bits : 32);
+}
+
+static bool tcc_enabled(MchpTccState *s)
+{
+    return tcc_reg(s, A_CTRLA, 4) & F(CTRLA, ENABLE);
+}
+
+static bool tcc_ds(MchpTccState *s)
+{
+    return s->wavegen >= DSCRITICAL;
+}
+
+/* The direction the clock counts in now */
+static bool tcc_counting_down(MchpTccState *s)
+{
+    return tcc_ds(s) ? s->down : s->dir;
+}
+
+static void tcc_refresh(MchpTccState *s)
+{
+    uint32_t max = tcc_max(s);
+
+    s->wavegen = FIELD_EX32(tcc_reg(s, A_WAVE, 4), MCHP_TCC_WAVE, WAVEGEN);
+    s->dir = tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, DIR);
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        s->cc[ch] = tcc_reg(s, A_CC + 4 * ch, 4) & max;
+    }
+    s->top = s->wavegen == MFRQ ? s->cc[0] : tcc_reg(s, A_PER, 4) & max;
+}
+
+static unsigned tcc_evact(MchpTccState *s, unsigned n)
+{
+    uint32_t ev = tcc_reg(s, A_EVCTRL, 4);
+
+    return n ? FIELD_EX32(ev, MCHP_TCC_EVCTRL, EVACT1)
+             : FIELD_EX32(ev, MCHP_TCC_EVCTRL, EVACT0);
+}
+
+static bool tcc_ev_enabled(MchpTccState *s, unsigned n)
+{
+    return tcc_reg(s, A_EVCTRL, 4) & (F(EVCTRL, TCEI0) << n);
+}
+
+/* The event input level after TCINVn */
+static bool tcc_ev_active(MchpTccState *s, unsigned n)
+{
+    return s->ev_level[n] ^
+           !!(tcc_reg(s, A_EVCTRL, 4) & (F(EVCTRL, TCINV0) << n));
+}
+
+static uint64_t tcc_hz(MchpTccState *s)
+{
+    return clock_get_hz(MCHP_REGBLOCK(s)->gclk);
+}
+
+/* The prescaled clock moves the counter (not events) */
+static bool tcc_clock_counts(MchpTccState *s)
+{
+    if (!s->running || !tcc_hz(s)) {
+        return false;
+    }
+    switch (tcc_evact(s, 0)) {
+    case MCHP_TCC_EVCTRL_EVACT0_COUNTEV:
+    case MCHP_TCC_EVCTRL_EVACT0_INC:
+        return false;           /* events are the clock (silicon) */
+    case MCHP_TCC_EVCTRL_EVACT0_COUNT:
+        return tcc_ev_enabled(s, 0) && tcc_ev_active(s, 0);
+    }
+    return true;
+}
+
+static uint64_t tcc_prescaler(MchpTccState *s)
+{
+    return mchp_tcc_prescale[FIELD_EX32(tcc_reg(s, A_CTRLA, 4),
+                                        MCHP_TCC_CTRLA, PRESCALER)];
+}
+
+/* Whole counter ticks between t_base and @now */
+static uint64_t tcc_ticks(MchpTccState *s, int64_t now)
+{
+    if (!tcc_clock_counts(s) || now <= s->t_base) {
+        return 0;
+    }
+    return clock_ns_to_ticks(MCHP_REGBLOCK(s)->gclk, now - s->t_base) /
+           tcc_prescaler(s);
+}
+
+/* A time by which tick @n after t_base has happened */
+static int64_t tcc_tick_time(MchpTccState *s, uint64_t n)
+{
+    if (!n) {
+        return s->t_base;
+    }
+    return s->t_base + clock_ticks_to_ns(MCHP_REGBLOCK(s)->gclk,
+                                         n * tcc_prescaler(s)) + 1;
+}
+
+/* -- Counter position ------------------------------------------------- */
+
+/*
+ * Dual slope: the phase in a period of 2 * TOP ticks (0..TOP counting up,
+ * then down), after first coming down from above TOP (*excess ticks)
+ */
+static uint64_t tcc_ds_phase(MchpTccState *s, uint64_t *excess)
+{
+    uint64_t top = s->top;
+
+    *excess = 0;
+    if (s->count > top) {
+        *excess = s->count - top;
+        return top;
+    }
+    return s->down && s->count ? 2 * top - s->count : s->count;
+}
+
+/* The value @k ticks after t_base, and whether the last tick went down */
+static uint32_t tcc_after(MchpTccState *s, uint64_t k, bool *down)
+{
+    uint64_t top = s->top, count = s->count, excess, period, p;
+
+    *down = tcc_counting_down(s);
+    if (!k) {
+        *down = s->down;
+        return count;
+    }
+    if (!tcc_ds(s)) {
+        period = top + 1;
+        if (*down) {
+            return k <= count ? count - k : top - (k - count - 1) % period;
+        }
+        if (count <= top) {
+            return (count + k) % period;
+        } else {
+            uint64_t wrap = (uint64_t)tcc_max(s) - count + 1;
+
+            return k < wrap ? count + k : (k - wrap) % period;
+        }
+    }
+    if (!top) {
+        *down = false;
+        return 0;
+    }
+    p = tcc_ds_phase(s, &excess);
+    if (k <= excess) {
+        *down = true;
+        return count - k;
+    }
+    period = 2 * top;
+    p = (p + k - excess) % period;
+    *down = p == 0 || p > top;
+    return p <= top ? p : period - p;
+}
+
+/* Ticks from t_base until the counter becomes @v, or NEVER */
+static uint64_t tcc_ticks_to(MchpTccState *s, uint32_t v)
+{
+    uint64_t top = s->top, count = s->count, max = tcc_max(s);
+    uint64_t excess, p0, period, best = NEVER;
+
+    if (!tcc_ds(s)) {
+        period = top + 1;
+        if (tcc_counting_down(s)) {
+            if (v < count) {
+                return count - v;
+            }
+            return v <= top ? count + 1 + top - v : NEVER;
+        }
+        if (count <= top) {
+            return v <= top ? (v + period - count - 1) % period + 1 : NEVER;
+        }
+        if (v > count) {
+            return v <= max ? v - count : NEVER;
+        }
+        return v <= top ? max - count + 1 + v : NEVER;
+    }
+    if (!top) {
+        return v == 0 ? 1 : NEVER;
+    }
+    p0 = tcc_ds_phase(s, &excess);
+    if (v > top) {
+        return excess && v < count ? count - v : NEVER;
+    }
+    if (excess && v == top) {
+        return excess;
+    }
+    period = 2 * top;
+    for (int i = 0; i < 2; i++) {
+        uint64_t tp = i ? period - v : v, d;
+
+        if (i && (v == 0 || v == top)) {
+            break;
+        }
+        d = (tp + period - p0) % period;
+        best = MIN(best, excess + (d ? d : period));
+    }
+    return best;
+}
+
+/* Ticks until the counter leaves @v (the tick after it becomes @v) */
+static uint64_t tcc_ticks_to_leave(MchpTccState *s, uint32_t v)
+{
+    uint64_t n;
+
+    if (s->count == v) {
+        return 1;
+    }
+    n = tcc_ticks_to(s, v);
+    return n == NEVER ? NEVER : n + 1;
+}
+
+/* The next tick that can set a flag or change an output */
+static uint64_t tcc_next(MchpTccState *s)
+{
+    uint64_t n = NEVER;
+    uint32_t vals[2 + MCHP_TCC_CHANNELS] = { 0, s->top };
+
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        vals[2 + ch] = s->cc[ch];
+    }
+    for (unsigned i = 0; i < ARRAY_SIZE(vals); i++) {
+        n = MIN(n, tcc_ticks_to(s, vals[i]));
+        n = MIN(n, tcc_ticks_to_leave(s, vals[i]));
+    }
+    return n;
+}
+
+/* -- Ticks -------------------------------------------------------------- */
+
+/* Whether a tick onto @b from @a sets MCx for compare value @c */
+static bool tcc_match(MchpTccState *s, uint32_t a, uint32_t b, uint32_t c)
+{
+    if (b != c) {
+        return false;
+    }
+    if (tcc_ds(s)) {
+        return b > a && c > 0 && c < s->top;
+    }
+    return !(s->wavegen == NPWM && c == 0);
+}
+
+/* Whether MCx can ever be set in the current geometry */
+static bool tcc_match_possible(MchpTccState *s, uint32_t c)
+{
+    if (tcc_ds(s)) {
+        return c > 0 && c < s->top;
+    }
+    return c <= MAX(s->top, s->count) && !(s->wavegen == NPWM && c == 0);
+}
+
+/* Copy the valid buffers into PER/CCx (UPDATE condition or command) */
+static void tcc_update_buffers(MchpTccState *s)
+{
+    uint32_t status = tcc_reg(s, A_STATUS, 4);
+
+    if (status & F(STATUS, PERBUFV)) {
+        tcc_set_reg(s, A_PER, 4, tcc_reg(s, A_PERBUF, 4));
+    }
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        if (status & (F(STATUS, CCBUFV0) << ch)) {
+            tcc_set_reg(s, A_CC + 4 * ch, 4, tcc_reg(s, A_CCBUF + 4 * ch, 4));
+        }
+    }
+    tcc_mod_reg(s, A_STATUS, 4, F(STATUS, PERBUFV) | (0xF << 16), 0);
+    s->buf_busy = 0;
+    tcc_refresh(s);
+}
+
+static void tcc_flag(MchpTccState *s, uint32_t flags)
+{
+    uint32_t ev = tcc_reg(s, A_EVCTRL, 4);
+
+    if ((flags & F(INTFLAG, OVF)) && (ev & F(EVCTRL, OVFEO))) {
+        qemu_irq_pulse(s->ovf_event);
+    }
+    if ((flags & F(INTFLAG, TRG)) && (ev & F(EVCTRL, TRGEO))) {
+        qemu_irq_pulse(s->trg_event);
+    }
+    if ((flags & F(INTFLAG, CNT)) && (ev & F(EVCTRL, CNTEO))) {
+        qemu_irq_pulse(s->cnt_event);
+    }
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        if ((flags & (F(INTFLAG, MC0) << ch)) &&
+            (ev & (F(EVCTRL, MCEO0) << ch))) {
+            qemu_irq_pulse(s->mc_event[ch]);
+        }
+    }
+    tcc_mod_reg(s, A_INTFLAG, 4, 0, flags);
+}
+
+static unsigned tcc_cntsel(MchpTccState *s)
+{
+    return FIELD_EX32(tcc_reg(s, A_EVCTRL, 4), MCHP_TCC_EVCTRL, CNTSEL);
+}
+
+/* CNT at a start (first tick), a new cycle, or a stop (silicon) */
+static uint32_t tcc_cnt_start(MchpTccState *s)
+{
+    unsigned sel = tcc_cntsel(s);
+
+    return sel == MCHP_TCC_EVCTRL_CNTSEL_BOUNDARY ||
+           (sel == MCHP_TCC_EVCTRL_CNTSEL_START && !tcc_ds(s)) ?
+           F(INTFLAG, CNT) : 0;
+}
+
+/* At the end of the last cycle (one-shot) only END: no new cycle starts */
+static uint32_t tcc_cnt_cycle(MchpTccState *s, bool last)
+{
+    unsigned sel = tcc_cntsel(s);
+
+    if (sel == MCHP_TCC_EVCTRL_CNTSEL_BOUNDARY ||
+        (last && sel != MCHP_TCC_EVCTRL_CNTSEL_END)) {
+        return 0;
+    }
+    return F(INTFLAG, CNT);
+}
+
+static uint32_t tcc_cnt_stop(MchpTccState *s)
+{
+    return tcc_cntsel(s) == MCHP_TCC_EVCTRL_CNTSEL_BOUNDARY ?
+           F(INTFLAG, CNT) : 0;
+}
+
+static uint32_t tcc_cmp(MchpTccState *s, int64_t now);
+
+/* Stop counting; the outputs keep their state, or clear for one-shot */
+static void tcc_stop(MchpTccState *s, bool oneshot)
+{
+    s->frozen_cmp = oneshot ? 0 : tcc_cmp(s, s->t_base);
+    s->running = false;
+    timer_del(s->timer);
+    tcc_mod_reg(s, A_STATUS, 4, 0, F(STATUS, STOP));
+    tcc_flag(s, tcc_cnt_stop(s));
+}
+
+/* Jump @k ticks without flags or output events (none can happen) */
+static void tcc_jump(MchpTccState *s, uint64_t k)
+{
+    bool down;
+
+    if (!k) {
+        return;
+    }
+    s->prev = tcc_after(s, k - 1, &down);
+    s->count = tcc_after(s, k, &down);
+    s->down = down;
+    s->moved = true;
+    s->t_base = tcc_tick_time(s, k);
+}
+
+/* One tick, in the current direction or @force_down when 0/1 */
+static void tcc_tick(MchpTccState *s, int force_down)
+{
+    uint32_t a = s->count, b, flags = 0;
+    bool down, ovf = false, update = false;
+
+    if (force_down >= 0 && !tcc_ds(s)) {
+        bool save = s->dir;
+
+        s->dir = force_down;
+        b = tcc_after(s, 1, &down);
+        s->dir = save;
+    } else {
+        b = tcc_after(s, 1, &down);
+    }
+    if (tcc_ds(s)) {
+        bool leave_top = a == s->top && b < a;
+        bool leave_zero = a == 0 && b > a;
+
+        /* Not when leaving ZERO on the first tick after a start (silicon) */
+        leave_zero &= s->moved;
+        ovf = (leave_top && (s->wavegen == DSTOP || s->wavegen == DSBOTH)) ||
+              (leave_zero && s->wavegen != DSTOP);
+        update = leave_zero;
+    } else {
+        ovf = down ? a == 0 : b == 0 && (a == s->top || a == tcc_max(s));
+        update = ovf;
+    }
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        if (tcc_match(s, a, b, s->cc[ch])) {
+            flags |= F(INTFLAG, MC0) << ch;
+        }
+        if ((s->wavegen == NFRQ || s->wavegen == MFRQ) && a == s->cc[ch]) {
+            s->toggle ^= BIT(ch);
+        }
+    }
+    s->prev = a;
+    s->count = b;
+    s->down = down;
+    s->moved = true;
+    if (s->cnt_pending) {
+        s->cnt_pending = false;
+        flags |= tcc_cnt_start(s);
+    }
+    if (update) {
+        flags |= tcc_cnt_cycle(s, ovf && (tcc_reg(s, A_CTRLBSET, 1) &
+                                          F(CTRLBSET, ONESHOT)));
+    }
+    if (ovf) {
+        flags |= F(INTFLAG, OVF);
+    }
+    trace_mchp_tcc_tick(MCHP_REGBLOCK(s)->name, b, flags);
+    tcc_flag(s, flags);
+    if (update && !(tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, LUPD))) {
+        tcc_update_buffers(s);
+    }
+    if (ovf && (tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, ONESHOT))) {
+        tcc_stop(s, true);
+    }
+}
+
+/*
+ * Firing the timer changes nothing: every flag it would set is set, and
+ * there is no one-shot, pending buffer, toggling output or event output
+ */
+static bool tcc_quiet(MchpTccState *s)
+{
+    uint32_t flags = tcc_reg(s, A_INTFLAG, 4), want = F(INTFLAG, OVF);
+    uint32_t ev = tcc_reg(s, A_EVCTRL, 4);
+
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        if (tcc_match_possible(s, s->cc[ch])) {
+            want |= F(INTFLAG, MC0) << ch;
+        }
+    }
+    return (flags & want) == want && !s->cnt_pending &&
+           s->wavegen != NFRQ && s->wavegen != MFRQ &&
+           !(tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, ONESHOT)) &&
+           !(tcc_reg(s, A_STATUS, 4) & (F(STATUS, PERBUFV) | (0xF << 16))) &&
+           !(ev & (F(EVCTRL, OVFEO) | (0xF << 24)));
+}
+
+/* Bring the counter up to @now and schedule the next tick that matters */
+static void tcc_advance(MchpTccState *s, int64_t now)
+{
+    for (unsigned steps = 0; tcc_clock_counts(s); steps++) {
+        uint64_t n;
+
+        if (tcc_quiet(s) || steps >= MCHP_TCC_MAX_STEPS) {
+            tcc_jump(s, tcc_ticks(s, now));
+            if (steps >= MCHP_TCC_MAX_STEPS) {
+                /* Flags that a long gap set at least once */
+                tcc_mod_reg(s, A_INTFLAG, 4, 0, F(INTFLAG, OVF));
+            }
+            break;
+        }
+        n = tcc_next(s);
+        if (n == NEVER) {
+            tcc_jump(s, tcc_ticks(s, now));
+            break;
+        }
+        if (tcc_tick_time(s, n) > now) {
+            timer_mod(s->timer, tcc_tick_time(s, n));
+            return;
+        }
+        tcc_jump(s, n - 1);
+        s->t_base = tcc_tick_time(s, 1);
+        tcc_tick(s, -1);
+    }
+    timer_del(s->timer);
+}
+
+static void tcc_sync(MchpTccState *s)
+{
+    tcc_advance(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void tcc_timer_cb(void *opaque)
+{
+    tcc_sync(opaque);
+}
+
+/* -- Starting, stopping, commands --------------------------------------- */
+
+static uint32_t tcc_start_value(MchpTccState *s)
+{
+    return !tcc_ds(s) && s->dir ? s->top : 0;
+}
+
+/*
+ * The start's CNT flag: at once, or with the first tick in NPWM counting
+ * up and in dual slope (silicon)
+ */
+static uint32_t tcc_start_cnt(MchpTccState *s)
+{
+    s->cnt_pending = tcc_ds(s) || (s->wavegen == NPWM && !s->dir);
+    return s->cnt_pending ? 0 : tcc_cnt_start(s);
+}
+
+/* Count on from COUNT; starting is an UPDATE condition */
+static void tcc_start(MchpTccState *s)
+{
+    uint32_t flags = tcc_start_cnt(s);
+
+    tcc_mod_reg(s, A_STATUS, 4, F(STATUS, STOP), 0);
+    if (!(tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, LUPD))) {
+        tcc_update_buffers(s);
+    }
+    s->running = true;
+    s->moved = false;
+    s->down = s->dir;
+    s->t_base = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    /* NFRQ/MFRQ: a start on CCx is a match (silicon) */
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        if ((s->wavegen == NFRQ || s->wavegen == MFRQ) &&
+            s->count == s->cc[ch]) {
+            flags |= F(INTFLAG, MC0) << ch;
+        }
+    }
+    tcc_flag(s, flags);
+}
+
+static void tcc_retrigger(MchpTccState *s)
+{
+    if (!s->running) {
+        tcc_start(s);           /* resume from COUNT */
+        return;
+    }
+    s->count = tcc_start_value(s);
+    s->down = s->dir;
+    s->moved = false;
+    s->t_base = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (!(tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, LUPD))) {
+        tcc_update_buffers(s);
+    }
+    tcc_flag(s, F(INTFLAG, TRG));
+}
+
+static void tcc_command(MchpTccState *s, unsigned cmd)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (!tcc_enabled(s)) {
+        return;                 /* commands need the TCC enabled */
+    }
+    tcc_advance(s, now);
+    switch (cmd) {
+    case MCHP_TCC_CTRLBSET_CMD_RETRIGGER:
+        tcc_retrigger(s);
+        break;
+    case MCHP_TCC_CTRLBSET_CMD_STOP:
+        if (s->running) {
+            tcc_jump(s, tcc_ticks(s, now));
+            tcc_stop(s, false);
+            s->count = tcc_start_value(s);  /* silicon: not kept */
+        }
+        break;
+    case MCHP_TCC_CTRLBSET_CMD_UPDATE:
+        tcc_update_buffers(s);
+        break;
+    case MCHP_TCC_CTRLBSET_CMD_READSYNC: {
+        bool down;
+
+        tcc_set_reg(s, A_COUNT, 4, tcc_after(s, tcc_ticks(s, now), &down));
+        break;
+    }
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s.CTRLBSET: command %u not modelled\n",
+                      MCHP_REGBLOCK(s)->name, cmd);
+        break;
+    }
+}
+
+static void tcc_report_unimp(MchpTccState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ctrla = tcc_reg(s, A_CTRLA, 4);
+    static const struct {
+        hwaddr offset;
+        const char *name;
+    } unimp[] = {
+        { A_FCTRLA, "FCTRLA: faults" }, { A_FCTRLB, "FCTRLB: faults" },
+        { A_WEXCTRL, "WEXCTRL: output matrix and dead time" },
+        { A_PATT, "PATT: pattern generation" },
+    };
+
+    for (unsigned i = 0; i < ARRAY_SIZE(unimp); i++) {
+        if (tcc_reg(s, unimp[i].offset, 4) & (i == 3 ? 0xFFFF : ~0u)) {
+            qemu_log_mask(LOG_UNIMP, "%s.%s not modelled\n", rb->name,
+                          unimp[i].name);
+        }
+    }
+    if (FIELD_EX32(ctrla, MCHP_TCC_CTRLA, RESOLUTION) || (ctrla & 0x0F000000)) {
+        qemu_log_mask(LOG_UNIMP, "%s.CTRLA: dithering and capture not "
+                      "modelled\n", rb->name);
+    }
+    if (tcc_evact(s, 0) > MCHP_TCC_EVCTRL_EVACT0_COUNT ||
+        tcc_evact(s, 1) > MCHP_TCC_EVCTRL_EVACT1_DEC) {
+        qemu_log_mask(LOG_UNIMP, "%s.EVCTRL: capture and fault event "
+                      "actions not modelled\n", rb->name);
+    }
+}
+
+/* -- Events in ---------------------------------------------------------- */
+
+static void tcc_update_busy(MchpTccState *s)
+{
+    for (unsigned n = 0; n < 2; n++) {
+        qemu_set_irq(s->ev_busy[n], !tcc_enabled(s));
+    }
+}
+
+/* "ev-event-in": TCCx_EV0 and TCCx_EV1 */
+static void tcc_set_event(void *opaque, int n, int level)
+{
+    MchpTccState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    bool was;
+
+    if (s->ev_level[n] == (level > 0)) {
+        return;
+    }
+    was = tcc_ev_active(s, n);
+    tcc_advance(s, now);
+    s->ev_level[n] = level > 0;
+    if (!tcc_ev_enabled(s, n) || !tcc_enabled(s)) {
+        return;
+    }
+    if (!n) {
+        switch (tcc_evact(s, 0)) {
+        case MCHP_TCC_EVCTRL_EVACT0_RETRIGGER:
+            if (!was && tcc_ev_active(s, 0)) {
+                tcc_retrigger(s);
+            }
+            break;
+        case MCHP_TCC_EVCTRL_EVACT0_COUNTEV:
+            if (!was && tcc_ev_active(s, 0) && s->running && tcc_hz(s)) {
+                tcc_tick(s, -1);
+                s->t_base = now;
+            }
+            break;
+        case MCHP_TCC_EVCTRL_EVACT0_START:
+            if (!was && tcc_ev_active(s, 0) && !s->running) {
+                tcc_start(s);
+            }
+            break;
+        case MCHP_TCC_EVCTRL_EVACT0_INC:
+            if (!was && tcc_ev_active(s, 0) && s->running) {
+                if (!s->dir || tcc_ds(s)) {
+                    tcc_tick(s, 0);
+                } else {
+                    /* Counting down: up without the TOP wrap (silicon) */
+                    s->prev = s->count;
+                    s->count = s->count ? (s->count + 1) & tcc_max(s)
+                                        : s->top;
+                    s->moved = true;
+                }
+                s->t_base = now;
+            }
+            break;
+        case MCHP_TCC_EVCTRL_EVACT0_COUNT:
+            s->t_base = now;    /* counts while the event is active */
+            break;
+        }
+    } else {
+        switch (tcc_evact(s, 1)) {
+        case MCHP_TCC_EVCTRL_EVACT1_RETRIGGER:
+            if (!was && tcc_ev_active(s, 1)) {
+                tcc_retrigger(s);
+            }
+            break;
+        case MCHP_TCC_EVCTRL_EVACT1_DIR:
+            /* The event level overrides CTRLB.DIR */
+            tcc_mod_reg(s, A_CTRLBSET, 1, F(CTRLBSET, DIR),
+                        tcc_ev_active(s, 1) ? F(CTRLBSET, DIR) : 0);
+            tcc_refresh(s);
+            s->t_base = now;
+            break;
+        case MCHP_TCC_EVCTRL_EVACT1_STOP:
+            /* Pause: the count and the outputs stay until a START */
+            if (!was && tcc_ev_active(s, 1) && s->running) {
+                s->frozen_cmp = tcc_cmp(s, now);
+                s->running = false;
+                timer_del(s->timer);
+                tcc_mod_reg(s, A_STATUS, 4, 0, F(STATUS, STOP));
+            }
+            break;
+        case MCHP_TCC_EVCTRL_EVACT1_DEC:
+            if (!was && tcc_ev_active(s, 1) && s->running) {
+                tcc_tick(s, 1);
+                s->t_base = now;
+            }
+            break;
+        }
+    }
+    trace_mchp_tcc_event_in(MCHP_REGBLOCK(s)->name, n, level, s->count);
+    tcc_advance(s, now);
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+/* -- Registers ---------------------------------------------------------- */
+
+/* STATUS.CMPx: the waveform output state of each channel */
+static uint32_t tcc_cmp(MchpTccState *s, int64_t now)
+{
+    uint32_t drv = tcc_reg(s, A_DRVCTRL, 4);
+    uint32_t pol = extract32(tcc_reg(s, A_WAVE, 4),
+                             R_MCHP_TCC_WAVE_POL0_SHIFT, 4);
+    uint64_t k = tcc_ticks(s, now);
+    uint32_t a, out = 0;
+    bool down;
+
+    if (tcc_reg(s, A_STATUS, 4) & F(STATUS, STOP)) {
+        /* Kept, or the non-recoverable state (DRVCTRL.NREx/NRVx) */
+        uint32_t nre = extract32(drv, 0, 4);
+
+        return (s->frozen_cmp & ~nre) | (extract32(drv, 8, 4) & nre);
+    }
+    if (!s->moved && !k) {
+        return 0;
+    }
+    if (k) {
+        a = tcc_after(s, k - 1, &down);
+        tcc_after(s, k, &down);
+    } else {
+        a = s->prev;
+        down = s->down;
+    }
+    for (unsigned ch = 0; ch < MCHP_TCC_CHANNELS; ch++) {
+        uint32_t c = s->cc[ch];
+        bool on;
+
+        switch (s->wavegen) {
+        case NFRQ:
+        case MFRQ:
+            on = s->toggle & BIT(ch);
+            break;
+        case NPWM:
+            /* Counting down, a CCx above TOP never sets (silicon) */
+            on = s->dir ? a > 0 && a <= c && c <= s->top : a < c;
+            break;
+        default:
+            on = down ? a > c : a >= c;
+            break;
+        }
+        out |= (on ^ extract32(pol, ch, 1)) << ch;
+    }
+    return out;
+}
+
+static uint32_t tcc_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                             unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpTccState *s = MCHP_TCC(rf->opaque);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (side_effects) {
+        tcc_sync(s);            /* flags due by now */
+    }
+    switch (ri->offset) {
+    case A_CTRLBCLR:
+    case A_CTRLBSET:
+        /* In dual slope DIR shows the counting direction (silicon) */
+        if (tcc_ds(s) && s->running) {
+            bool down;
+
+            tcc_after(s, tcc_ticks(s, now), &down);
+            return deposit32(stored, R_MCHP_TCC_CTRLBSET_DIR_SHIFT, 1, down);
+        }
+        return stored;
+    case A_SYNCBUSY:
+        /* Synchronization is instant once GCLK_TCC runs */
+        if (tcc_hz(s)) {
+            s->sync_pending = 0;
+        }
+        return s->sync_pending | s->buf_busy;
+    case A_STATUS:
+        return deposit32(stored, R_MCHP_TCC_STATUS_CMP0_SHIFT, 4,
+                         tcc_cmp(s, now));
+    case A_COUNT:
+        return stored;          /* the last synchronized value */
+    case A_PER:
+        /* While PERBUFV is set, PER reads show PERBUF (silicon) */
+        if (tcc_reg(s, A_STATUS, 4) & F(STATUS, PERBUFV)) {
+            return tcc_reg(s, A_PERBUF, 4);
+        }
+        return stored;
+    case A_CC:
+        if (tcc_reg(s, A_STATUS, 4) & (F(STATUS, CCBUFV0) << idx)) {
+            return tcc_reg(s, A_CCBUF + 4 * idx, 4);
+        }
+        return stored;
+    default:
+        return stored;
+    }
+}
+
+static void tcc_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                           unsigned idx, uint32_t old, uint32_t written,
+                           uint32_t we)
+{
+    MchpTccState *s = MCHP_TCC(rf->opaque);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint32_t val = mchp_regfile_get(rf, ri, idx);
+    uint32_t ctrlb = tcc_reg(s, A_CTRLBSET, 1);
+
+    if (ri->syncbusy && !tcc_hz(s)) {
+        /* CTRLA.SWRST/ENABLE sit at their SYNCBUSY bits; only written ones */
+        s->sync_pending |= ri->offset == A_CTRLA ?
+                           written & we & ri->syncbusy :
+                           ri->syncbusy << (ri->count > 1 ? idx : 0);
+    }
+    /* Count up to now with the geometry before the write */
+    tcc_advance(s, now);
+    switch (ri->offset) {
+    case A_CTRLA:
+        if (written & we & F(CTRLA, SWRST)) {
+            return;             /* mchp-regblock resets the TCC next */
+        }
+        if (val & ~old & F(CTRLA, ENABLE)) {
+            unsigned ev0 = tcc_evact(s, 0), ev1 = tcc_evact(s, 1);
+
+            tcc_report_unimp(s);
+            tcc_refresh(s);
+            s->toggle = 0;
+            /* RETRIGGER/START event actions wait for an event */
+            if (ev0 != MCHP_TCC_EVCTRL_EVACT0_RETRIGGER &&
+                ev0 != MCHP_TCC_EVCTRL_EVACT0_START &&
+                ev1 != MCHP_TCC_EVCTRL_EVACT1_RETRIGGER) {
+                tcc_start(s);
+            }
+        } else if (old & ~val & F(CTRLA, ENABLE)) {
+            tcc_jump(s, tcc_ticks(s, now));
+            s->running = false;
+            timer_del(s->timer);
+        }
+        tcc_update_busy(s);
+        break;
+    case A_CTRLBSET:
+    case A_CTRLBCLR: {
+        unsigned cmd = FIELD_EX32(ctrlb, MCHP_TCC_CTRLBSET, CMD);
+
+        tcc_jump(s, tcc_ticks(s, now));
+        tcc_mod_reg(s, A_CTRLBSET, 1, F(CTRLBSET, CMD), 0);
+        if (tcc_ds(s) && (written & we & F(CTRLBSET, DIR))) {
+            s->down = ri->offset == A_CTRLBSET;
+        }
+        tcc_refresh(s);
+        if (cmd) {
+            tcc_command(s, cmd);
+        }
+        break;
+    }
+    case A_COUNT:
+        s->count = val & tcc_max(s);
+        s->t_base = now;
+        break;
+    case A_PERBUF:
+    case A_CCBUF:
+        tcc_mod_reg(s, A_STATUS, 4, 0, ri->offset == A_PERBUF ?
+                    F(STATUS, PERBUFV) : F(STATUS, CCBUFV0) << idx);
+        /* Synchronized when copied (silicon) */
+        s->buf_busy |= ri->offset == A_PERBUF ?
+                       R_MCHP_TCC_SYNCBUSY_PER_MASK :
+                       R_MCHP_TCC_SYNCBUSY_CC0_MASK << idx;
+        /* NFRQ, MFRQ and PWM counting down: copied at once (DS 31.6.2.6) */
+        if (ri->offset == A_PERBUF && !(ctrlb & F(CTRLBSET, LUPD)) &&
+            (s->wavegen == NFRQ || s->wavegen == MFRQ ||
+             (s->wavegen == NPWM && s->dir))) {
+            tcc_set_reg(s, A_PER, 4, val);
+            tcc_mod_reg(s, A_STATUS, 4, F(STATUS, PERBUFV), 0);
+            s->buf_busy &= ~R_MCHP_TCC_SYNCBUSY_PER_MASK;
+        }
+        /* fall through */
+    case A_WAVE:
+    case A_PER:
+    case A_CC:
+        /* Whole ticks so far: the phase of the current tick is kept */
+        tcc_jump(s, tcc_ticks(s, now));
+        tcc_refresh(s);
+        break;
