diff --git a/tests/qtest/pic32cm-tcc-test.c b/tests/qtest/pic32cm-tcc-test.c
new file mode 100644
index 0000000..420279c
--- /dev/null
+++ b/tests/qtest/pic32cm-tcc-test.c
@@ -0,0 +1,306 @@
+/*
+ * QTest for the TCC of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * GCLK0 runs at 4 MHz out of reset (OSC48M / 12); with the /1024
+ * prescaler a TCC tick is 256 us. Virtual time is stepped explicitly.
+ * Behaviour the data sheet leaves open follows PIC32CM MC00 silicon
+ * (firmware/hello/tests/tccprobe.c and tcc.c).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro "
+
+#define GCLK_PCHCTRL    0x40001C80
+#define TCC0            0x42002400
+#define TCC2            0x42002C00
+#define NVIC_ISPR       0xE000E200
+
+#define R_CTRLA         0x00
+#define R_CTRLBCLR      0x04
+#define R_CTRLBSET      0x05
+#define R_EVCTRL        0x20
+#define R_INTENSET      0x28
+#define R_INTFLAG       0x2C
+#define R_STATUS        0x30
+#define R_COUNT         0x34
+#define R_WAVE          0x3C
+#define R_PER           0x40
+#define R_CC(n)         (0x44 + 4 * (n))
+#define R_PERBUF        0x6C
+#define R_CCBUF(n)      (0x70 + 4 * (n))
+
+#define ENABLE          BIT(1)
+#define DIV1024         (7 << 8)
+#define DIR             BIT(0)
+#define LUPD            BIT(1)
+#define ONESHOT         BIT(2)
+#define CMD_RETRIGGER   (1 << 5)
+#define CMD_STOP        (2 << 5)
+#define CMD_UPDATE      (3 << 5)
+#define CMD_READSYNC    (4 << 5)
+
+#define NFRQ            0
+#define NPWM            2
+#define DSBOTTOM        5
+#define DSTOP           7
+#define POL(n)          BIT(16 + (n))
+
+#define OVF             BIT(0)
+#define TRG             BIT(1)
+#define CNT             BIT(2)
+#define MC(n)           BIT(16 + (n))
+#define STOP            BIT(0)
+#define CCBUFV0         BIT(16)
+
+#define TICK_NS         256000
+#define TCC0_GCLK_ID    23
+#define TCC2_GCLK_ID    24
+#define TCC0_IRQ        13
+
+/* TCC0 with PER 9 and CC0-CC3 = 3, 0, 9, 10 */
+static QTestState *tcc_init(uint32_t wave, uint8_t ctrlb)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * TCC0_GCLK_ID, 0x40);
+    qtest_writel(qts, TCC0 + R_CTRLA, DIV1024);
+    qtest_writel(qts, TCC0 + R_WAVE, wave);
+    qtest_writel(qts, TCC0 + R_PER, 9);
+    qtest_writel(qts, TCC0 + R_CC(0), 3);
+    qtest_writel(qts, TCC0 + R_CC(1), 0);
+    qtest_writel(qts, TCC0 + R_CC(2), 9);
+    qtest_writel(qts, TCC0 + R_CC(3), 10);
+    if (ctrlb) {
+        qtest_writeb(qts, TCC0 + R_CTRLBSET, ctrlb);
+    }
+    qtest_writel(qts, TCC0 + R_INTFLAG, 0xFFFFFFFF);
+    return qts;
+}
+
+static void tcc_enable(QTestState *qts)
+{
+    qtest_writel(qts, TCC0 + R_CTRLA, DIV1024 | ENABLE);
+}
+
+/* Step to the middle of tick @n after the previous step point */
+static void ticks(QTestState *qts, unsigned n)
+{
+    qtest_clock_step(qts, (int64_t)n * TICK_NS);
+}
+
+static uint32_t readsync(QTestState *qts)
+{
+    qtest_writeb(qts, TCC0 + R_CTRLBSET, CMD_READSYNC);
+    return qtest_readl(qts, TCC0 + R_COUNT);
+}
+
+static uint32_t cmp(QTestState *qts)
+{
+    return extract32(qtest_readl(qts, TCC0 + R_STATUS), 24, 4);
+}
+
+static uint32_t flags(QTestState *qts)
+{
+    uint32_t f = qtest_readl(qts, TCC0 + R_INTFLAG);
+
+    qtest_writel(qts, TCC0 + R_INTFLAG, f);
+    return f;
+}
+
+static void test_reset(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_STATUS), ==, STOP);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_PER), ==, 0xFFFFFF);
+    g_assert_cmphex(qtest_readl(qts, TCC2 + R_PER), ==, 0xFFFF);
+    qtest_quit(qts);
+}
+
+/* NPWM up: CMPx = previous COUNT < CCx; MCx when COUNT becomes CCx */
+static void test_npwm(void)
+{
+    QTestState *qts = tcc_init(NPWM, 0);
+
+    tcc_enable(qts);
+    g_assert_cmphex(cmp(qts), ==, 0);       /* before the first tick */
+    qtest_clock_step(qts, TICK_NS / 2);
+    ticks(qts, 2);                          /* COUNT 2 */
+    g_assert_cmpuint(readsync(qts), ==, 2);
+    g_assert_cmphex(cmp(qts), ==, 0xD);
+    ticks(qts, 3);                          /* COUNT 5 */
+    g_assert_cmphex(cmp(qts), ==, 0xC);
+    flags(qts);
+    ticks(qts, 10);
+    /* CNTSEL START: CNT at each new cycle */
+    g_assert_cmphex(flags(qts), ==, OVF | CNT | MC(0) | MC(2));
+    qtest_quit(qts);
+
+    /* Down: 0 < previous COUNT <= CCx, CCx above TOP never sets */
+    qts = tcc_init(NPWM, DIR);
+    tcc_enable(qts);
+    qtest_clock_step(qts, TICK_NS / 2);
+    ticks(qts, 5);                          /* 0, 9, 8, 7, 6, 5 */
+    g_assert_cmpuint(readsync(qts), ==, 5);
+    g_assert_cmphex(cmp(qts), ==, 0x4);
+    ticks(qts, 3);                          /* COUNT 2 */
+    g_assert_cmphex(cmp(qts), ==, 0x5);
+    qtest_quit(qts);
+}
+
+static void test_nfrq(void)
+{
+    QTestState *qts = tcc_init(NFRQ | POL(3), 0);
+
+    tcc_enable(qts);
+    qtest_clock_step(qts, TICK_NS / 2);
+    ticks(qts, 2);
+    g_assert_cmphex(cmp(qts), ==, 0xA);     /* CMP1 toggled; POL3 */
+    ticks(qts, 3);
+    g_assert_cmphex(cmp(qts), ==, 0xB);
+    ticks(qts, 7);                          /* next period, COUNT 2 */
+    g_assert_cmphex(cmp(qts), ==, 0xD);
+    qtest_quit(qts);
+}
+
+/* Dual slope: set leaving CCx up, cleared leaving it down; DIR reads */
+static void test_dual(void)
+{
+    QTestState *qts = tcc_init(DSBOTTOM, 0);
+
+    tcc_enable(qts);
+    qtest_clock_step(qts, TICK_NS / 2);
+    ticks(qts, 5);
+    g_assert_cmphex(cmp(qts), ==, 0x3);
+    g_assert_cmphex(flags(qts), ==, MC(0));
+    ticks(qts, 6);                          /* 6, 7, 8, 9, 8, 7 */
+    g_assert_cmpuint(readsync(qts), ==, 7);
+    g_assert_cmphex(qtest_readb(qts, TCC0 + R_CTRLBSET) & DIR, ==, DIR);
+    ticks(qts, 5);                          /* 6, 5, 4, 3, 2 */
+    g_assert_cmphex(cmp(qts), ==, 0x2);
+    g_assert_cmphex(flags(qts), ==, 0);
+    ticks(qts, 4);                          /* 1, 0, 1, 2 */
+    g_assert_cmphex(flags(qts) & OVF, ==, OVF);
+    qtest_quit(qts);
+
+    qts = tcc_init(DSTOP, 0);
+    tcc_enable(qts);
+    qtest_clock_step(qts, TICK_NS / 2);
+    ticks(qts, 9);
+    g_assert_cmphex(flags(qts) & OVF, ==, 0);
+    ticks(qts, 1);                          /* leaves TOP */
+    g_assert_cmphex(flags(qts) & OVF, ==, OVF);
+    qtest_quit(qts);
+}
+
+static void test_oneshot(void)
+{
+    QTestState *qts = tcc_init(NPWM, ONESHOT);
+
+    tcc_enable(qts);
+    ticks(qts, 15);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_STATUS) & STOP, ==, STOP);
+    g_assert_cmphex(cmp(qts), ==, 0);
+    g_assert_cmpuint(readsync(qts), ==, 0);
+    qtest_writeb(qts, TCC0 + R_CTRLBSET, CMD_RETRIGGER);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_STATUS) & STOP, ==, 0);
+    qtest_quit(qts);
+}
+
+/*
+ * CC0 buffered: reads show CCBUF0, CC0 changes at the wrap; SYNCBUSY.CC0
+ * stays set until then (silicon)
+ */
+static void test_buffers(void)
+{
+    QTestState *qts = tcc_init(NPWM, 0);
+
+    tcc_enable(qts);
+    qtest_clock_step(qts, TICK_NS / 2);
+    ticks(qts, 2);
+    qtest_writel(qts, TCC0 + R_CCBUF(0), 6);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + 0x08), ==, BIT(8));
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_STATUS) & CCBUFV0, ==, CCBUFV0);
+    g_assert_cmpuint(qtest_readl(qts, TCC0 + R_CC(0)), ==, 6);
+    ticks(qts, 10);                         /* past the wrap, COUNT 2 */
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_STATUS) & CCBUFV0, ==, 0);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + 0x08), ==, 0);
+    ticks(qts, 3);                          /* COUNT 5 */
+    g_assert_cmphex(cmp(qts) & 1, ==, 1);
+    qtest_quit(qts);
+}
+
+/* STOP clears COUNT and keeps the outputs; RETRIGGER resumes */
+static void test_stop(void)
+{
+    QTestState *qts = tcc_init(NPWM, 0);
+
+    tcc_enable(qts);
+    qtest_clock_step(qts, TICK_NS / 2);
+    ticks(qts, 5);
+    qtest_writeb(qts, TCC0 + R_CTRLBSET, CMD_STOP);
+    g_assert_cmpuint(readsync(qts), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_STATUS) & STOP, ==, STOP);
+    g_assert_cmphex(cmp(qts), ==, 0xC);
+    ticks(qts, 3);
+    g_assert_cmpuint(readsync(qts), ==, 0);
+    flags(qts);
+    qtest_writeb(qts, TCC0 + R_CTRLBSET, CMD_RETRIGGER);
+    qtest_clock_step(qts, TICK_NS + TICK_NS / 2);
+    g_assert_cmpuint(readsync(qts), ==, 1);
+    g_assert_cmphex(flags(qts), ==, CNT);
+    qtest_quit(qts);
+}
+
+static void test_counter_width(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * TCC2_GCLK_ID, 0x40);
+    qtest_writel(qts, TCC2 + R_CTRLA, DIV1024);
+    qtest_writel(qts, TCC2 + R_COUNT, 0xFFFE);
+    qtest_writel(qts, TCC2 + R_CTRLA, DIV1024 | ENABLE);
+    qtest_clock_step(qts, TICK_NS + TICK_NS / 2);
+    g_assert_cmphex(qtest_readl(qts, TCC2 + R_INTFLAG) & OVF, ==, 0);
+    qtest_clock_step(qts, TICK_NS);
+    g_assert_cmphex(qtest_readl(qts, TCC2 + R_INTFLAG) & OVF, ==, OVF);
+    qtest_quit(qts);
+}
+
+static void test_irq(void)
+{
+    QTestState *qts = tcc_init(NPWM, 0);
+
+    qtest_writel(qts, TCC0 + R_INTENSET, OVF);
+    tcc_enable(qts);
+    ticks(qts, 5);
+    g_assert_false(qtest_readl(qts, NVIC_ISPR) & BIT(TCC0_IRQ));
+    ticks(qts, 6);
+    g_assert_true(qtest_readl(qts, NVIC_ISPR) & BIT(TCC0_IRQ));
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-tcc/reset", test_reset);
+    qtest_add_func("pic32cm-tcc/npwm", test_npwm);
+    qtest_add_func("pic32cm-tcc/nfrq", test_nfrq);
+    qtest_add_func("pic32cm-tcc/dual", test_dual);
+    qtest_add_func("pic32cm-tcc/oneshot", test_oneshot);
+    qtest_add_func("pic32cm-tcc/buffers", test_buffers);
+    qtest_add_func("pic32cm-tcc/stop", test_stop);
+    qtest_add_func("pic32cm-tcc/counter-width", test_counter_width);
+    qtest_add_func("pic32cm-tcc/irq", test_irq);
+
+    return g_test_run();
+}
-- 
