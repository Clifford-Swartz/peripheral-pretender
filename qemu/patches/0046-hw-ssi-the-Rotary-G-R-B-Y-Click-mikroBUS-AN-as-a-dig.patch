+++ b/tests/qtest/pic32cm-click-test.c
@@ -957,6 +957,37 @@ static void test_8x8_variants(void)
     }
 }
 
+/*
+ * Rotary G Click: A on PWM (PB10), B on AN (PB08) as a digital pin; at a
+ * detent A = B, clockwise A moves first, 1 ms per edge; the switch on INT
+ * (PB02) drives high while pressed and floats while released
+ */
+static void test_rotary(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=rotaryg ");
+    static const bool cw[][2] = {
+        { 0, 1 }, { 0, 0 }, { 1, 0 }, { 1, 1 },        /* two detents */
+    };
+    static const bool ccw[][2] = { { 1, 0 }, { 0, 0 } };   /* one back */
+
+    g_assert_true(pin_high(qts, PB, 10) && pin_high(qts, PB, 8));
+    qom_set_int(qts, CLICK1, "position", 2);
+    for (unsigned i = 0; i < ARRAY_SIZE(cw); i++) {
+        qtest_clock_step(qts, 1000000);
+        g_assert_cmpint(pin_high(qts, PB, 10), ==, cw[i][0]);
+        g_assert_cmpint(pin_high(qts, PB, 8), ==, cw[i][1]);
+    }
+    qom_set_int(qts, CLICK1, "position", 1);
+    for (unsigned i = 0; i < ARRAY_SIZE(ccw); i++) {
+        qtest_clock_step(qts, 1000000);
+        g_assert_cmpint(pin_high(qts, PB, 10), ==, ccw[i][0]);
+        g_assert_cmpint(pin_high(qts, PB, 8), ==, ccw[i][1]);
+    }
+    qtest_qom_set_bool(qts, CLICK1, "pressed", true);
+    g_assert_true(pin_high(qts, PB, 2));
+    qtest_quit(qts);
+}
+
 /*
  * POT Click: the knob's voltage (0-2.048 V) on the socket's AN pin, which
  * is ADC0 AIN2 and ADC1 AIN4 on EXT1 (PB08), AIN8/AIN10 on EXT2 (PA08)
@@ -994,6 +1025,7 @@ int main(int argc, char **argv)
     qtest_add_func("pic32cm-click/button-variants", test_button_variants);
     qtest_add_func("pic32cm-click/8x8-variants", test_8x8_variants);
     qtest_add_func("pic32cm-click/pot", test_pot);
+    qtest_add_func("pic32cm-click/rotary", test_rotary);
     qtest_add_func("pic32cm-click/thermo8-identity", test_identity);
     qtest_add_func("pic32cm-click/not-fitted", test_not_fitted);
     qtest_add_func("pic32cm-click/thermo8-int-pullup", test_int_pullup);
