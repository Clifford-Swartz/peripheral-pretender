diff --git a/hw/ssi/ti_74hc595.c b/hw/ssi/ti_74hc595.c
index d70c086..7c66984 100644
--- a/hw/ssi/ti_74hc595.c
+++ b/hw/ssi/ti_74hc595.c
@@ -16,6 +16,18 @@
  * level. QOM property "outputs" (read-only): the latched outputs, register
  * 0 (the first after DS) in bits 7:0. OE# is assumed tied low.
  *
+ * "click-rotary" is the Rotary G/R/B/O/Y Click (v100): two 74HC595 (length
+ * 2; bit n of "outputs" lights LED n+1, LED1 at six o'clock, clockwise)
+ * and an EC12D incremental encoder with push switch. The encoder has 30
+ * detents and 15 pulses a turn: at each detent A = B (both high, then both
+ * low, alternating); turning one detent clockwise moves A, then B
+ * (counter-clockwise B, then A), 1 ms apart, so polled firmware sees every
+ * edge; through the Click's 74LVC1T45 level shifters "enc-a" (on PWM) and
+ * "enc-b" (on AN) drive 0/1. The switch "sw" (on INT) drives 1 while
+ * pressed and nothing (-1) while released: the Click has no pull on INT.
+ * QOM properties: "position" (detents, the encoder turns to it one detent
+ * at a time; clockwise counts up), "pressed". No physical Click checked it.
+ *
  * SPDX-License-Identifier: GPL-2.0-or-later
  */
 
@@ -27,6 +39,7 @@
 #include "hw/ssi/ssi.h"
 #include "hw/ssi/ti_74hc595.h"
 #include "migration/vmstate.h"
+#include "qemu/timer.h"
 #include "trace.h"
 
 #define HC595_MAX_CHAIN 4
@@ -152,6 +165,157 @@ static void hc595_class_init(ObjectClass *klass, const void *data)
     k->cs_polarity = SSI_CS_NONE;   /* shifts on every clock; STCP latches */
 }
 
+/* The Rotary Click: the chain plus the encoder and its switch */
+OBJECT_DECLARE_SIMPLE_TYPE(ClickRotaryState, CLICK_ROTARY)
+
+#define ROTARY_EDGE_NS      (1 * SCALE_MS)
+
+struct ClickRotaryState {
+    Ti74hc595State parent_obj;
+
+    qemu_irq enc_a;
+    qemu_irq enc_b;
+    qemu_irq sw;
+    int32_t position;           /* where the knob is going (detents) */
+    int32_t at;                 /* the detent the contacts show */
+    bool half;                  /* between detents: the first edge done */
+    bool pressed;
+    QEMUTimer *timer;
+};
+
+/* Contact levels: at even detents both high, at odd ones both low */
+static void rotary_drive(ClickRotaryState *s)
+{
+    bool rest = !(s->at & 1);
+    bool cw = s->position > s->at;
+    bool a = rest, b = rest;
+
+    if (s->half) {
+        /* clockwise A has moved, counter-clockwise B */
+        if (cw) {
+            a = !rest;
+        } else {
+            b = !rest;
+        }
+    }
+    qemu_set_irq(s->enc_a, a);
+    qemu_set_irq(s->enc_b, b);
+}
+
+static void rotary_step(void *opaque)
+{
+    ClickRotaryState *s = opaque;
+
+    if (s->at == s->position) {
+        s->half = false;
+        return;
+    }
+    if (!s->half) {
+        s->half = true;             /* the leading contact */
+    } else {
+        s->half = false;            /* the other one: the next detent */
+        s->at += s->position > s->at ? 1 : -1;
+    }
+    rotary_drive(s);
+    if (s->at != s->position || s->half) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  ROTARY_EDGE_NS);
+    }
+}
+
+static void rotary_get_position(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, &CLICK_ROTARY(obj)->position, errp);
+}
+
+static void rotary_set_position(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    ClickRotaryState *s = CLICK_ROTARY(obj);
+    int32_t value;
+
+    if (!visit_type_int32(v, name, &value, errp)) {
+        return;
+    }
+    s->position = value;
+    if (!timer_pending(s->timer)) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  ROTARY_EDGE_NS);
+    }
+}
+
+static bool rotary_get_pressed(Object *obj, Error **errp)
+{
+    return CLICK_ROTARY(obj)->pressed;
+}
+
+static void rotary_set_pressed(Object *obj, bool value, Error **errp)
+{
+    ClickRotaryState *s = CLICK_ROTARY(obj);
+
+    s->pressed = value;
+    qemu_set_irq(s->sw, value ? 1 : -1);
+}
+
+static void rotary_reset(DeviceState *dev)
+{
+    ClickRotaryState *s = CLICK_ROTARY(dev);
+
+    hc595_reset(dev);
+    /* The knob stays where it is: the contacts at its detent */
+    timer_del(s->timer);
+    s->at = s->position;
+    s->half = false;
+    rotary_drive(s);
+    qemu_set_irq(s->sw, s->pressed ? 1 : -1);
+}
+
+static void rotary_init(Object *obj)
+{
+    ClickRotaryState *s = CLICK_ROTARY(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    qdev_init_gpio_out_named(dev, &s->enc_a, CLICK_ROTARY_ENC_A, 1);
+    qdev_init_gpio_out_named(dev, &s->enc_b, CLICK_ROTARY_ENC_B, 1);
+    qdev_init_gpio_out_named(dev, &s->sw, CLICK_ROTARY_SW, 1);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rotary_step, s);
+    object_property_add(obj, "position", "int32", rotary_get_position,
+                        rotary_set_position, NULL, NULL);
+    object_property_add_bool(obj, "pressed", rotary_get_pressed,
+                             rotary_set_pressed);
+}
+
+static void rotary_finalize(Object *obj)
+{
+    timer_free(CLICK_ROTARY(obj)->timer);
+}
+
+static const VMStateDescription vmstate_rotary = {
+    .name = TYPE_CLICK_ROTARY,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, ClickRotaryState, 1, vmstate_hc595,
+                       Ti74hc595State),
+        VMSTATE_INT32(position, ClickRotaryState),
+        VMSTATE_INT32(at, ClickRotaryState),
+        VMSTATE_BOOL(half, ClickRotaryState),
+        VMSTATE_BOOL(pressed, ClickRotaryState),
+        VMSTATE_TIMER_PTR(timer, ClickRotaryState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void rotary_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "Rotary Click: LED ring on two 74HC595, encoder, switch";
+    dc->vmsd = &vmstate_rotary;
+    device_class_set_legacy_reset(dc, rotary_reset);
+}
+
 static const TypeInfo hc595_types[] = {
     {
         .name = TYPE_TI_74HC595,
@@ -160,6 +324,14 @@ static const TypeInfo hc595_types[] = {
         .instance_init = hc595_init,
         .class_init = hc595_class_init,
     },
+    {
+        .name = TYPE_CLICK_ROTARY,
+        .parent = TYPE_TI_74HC595,
+        .instance_size = sizeof(ClickRotaryState),
+        .instance_init = rotary_init,
+        .instance_finalize = rotary_finalize,
+        .class_init = rotary_class_init,
+    },
 };
 
 DEFINE_TYPES(hc595_types)
