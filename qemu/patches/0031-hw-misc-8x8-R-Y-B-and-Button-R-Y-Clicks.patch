diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index 302d7e8..001c751 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -917,6 +917,46 @@ static void test_rtc6_memories(void)
     qtest_quit(qts);
 }
 
+/* Button R and Button Y Clicks: as Button G (INT pulled low by R3) */
+static void test_button_variants(void)
+{
+    static const char *const names[] = { "buttonr", "buttony" };
+
+    for (unsigned i = 0; i < ARRAY_SIZE(names); i++) {
+        QTestState *qts = qtest_initf("-M pic32cm-mc00-cpro,ext1=%s",
+                                      names[i]);
+
+        g_assert_false(pin_high(qts, PB, INT1_PIN));
+        qtest_qom_set_bool(qts, CLICK1, "pressed", true);
+        g_assert_true(pin_high(qts, PB, INT1_PIN));
+        qtest_quit(qts);
+    }
+}
+
+/* 8x8 R, Y and B Clicks: as 8x8 G (MAX7219 on SPI, LOAD on CS PA17) */
+static void test_8x8_variants(void)
+{
+    static const char *const names[] = { "8x8r", "8x8y", "8x8b" };
+
+    for (unsigned i = 0; i < ARRAY_SIZE(names); i++) {
+        QTestState *qts = qtest_initf("-M pic32cm-mc00-cpro,ext1=%s",
+                                      names[i]);
+        g_autofree char *test = NULL;
+
+        qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);
+        qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+        qtest_writel(qts, PA + P_OUTSET, BIT(17));
+        qtest_writel(qts, PA + P_DIRSET, BIT(17));
+        qtest_writel(qts, PA + P_OUTCLR, BIT(17));
+        spi_byte(qts, 0x0F);                            /* display test */
+        spi_byte(qts, 0x01);
+        qtest_writel(qts, PA + P_OUTSET, BIT(17));
+        test = qom_str(qts, CLICK1, "display");
+        g_assert_cmpstr(test, ==, "ff ff ff ff ff ff ff ff");
+        qtest_quit(qts);
+    }
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
@@ -931,6 +971,8 @@ int main(int argc, char **argv)
     qtest_add_func("pic32cm-click/rtc6-time", test_rtc6_time);
