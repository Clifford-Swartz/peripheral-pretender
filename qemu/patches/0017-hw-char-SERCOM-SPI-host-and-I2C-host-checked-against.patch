+
+/* I2C: STATUS.BUSSTATE, CLKHOLD and RXNACK (@nack < 0: unchanged) */
+static void mchp_sercom_i2c_status(MchpSercomState *s, unsigned bus,
+                                   bool clkhold, int nack)
+{
+    uint32_t st = mchp_sercom_reg(s, A_STATUS, 2);
+
+    s->i2c_bus = bus;
+    st = FIELD_DP32(st, MCHP_SERCOM_I2CM_STATUS, BUSSTATE, bus);
+    st = FIELD_DP32(st, MCHP_SERCOM_I2CM_STATUS, CLKHOLD, clkhold);
+    if (nack >= 0) {
+        st = FIELD_DP32(st, MCHP_SERCOM_I2CM_STATUS, RXNACK, nack);
+    }
+    mchp_sercom_set_reg(s, A_STATUS, 2, st);
+}
+
 /* INTFLAG.DRE and RXC mirror the buffers; the IRQ follows INTFLAG. */
 static void mchp_sercom_update(MchpSercomState *s)
 {
