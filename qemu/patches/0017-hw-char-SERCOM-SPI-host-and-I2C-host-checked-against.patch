+#define I2CM(reg, f)            R_MCHP_SERCOM_I2CM_##reg##_##f##_MASK
+#define SPIM(reg, f)            R_MCHP_SERCOM_SPIM_##reg##_##f##_MASK
+
 /* Receive errors that disabling the receiver clears (DS 30.7.2) */
