+                           s->rx_count != 0);
+        mchp_sercom_set_reg(s, A_INTFLAG, 1, flags);
+    } else if (mchp_sercom_is_usart(mchp_sercom_reg(s, A_CTRLA, 4))) {
         flags = FIELD_DP32(flags, MCHP_SERCOM_USART_INT_INTFLAG, DRE,
                            mchp_sercom_tx_enabled(s) && !s->tx_buf_full);
         flags = FIELD_DP32(flags, MCHP_SERCOM_USART_INT_INTFLAG, RXC,
@@ -335,15 +409,214 @@ static uint32_t mchp_sercom_data_read(MchpSercomState *s, bool side_effects)
     return data;
 }
 
+/* -- SPI host ------------------------------------------------------------ */
+
+/* The pad CTRLA.DOPO puts the data output on (DS 32.8.1) */
+static unsigned mchp_sercom_spi_do_pad(uint32_t ctrla)
+{
+    static const uint8_t pad[] = { 0, 2, 3, 0 };
+
+    return pad[FIELD_EX32(ctrla, MCHP_SERCOM_SPIM_CTRLA, DOPO)];
+}
+
+/* One character out on DATA's write, the reply into the buffer */
+static void mchp_sercom_spi_write(MchpSercomState *s, uint32_t data)
+{
+    uint32_t ctrla = mchp_sercom_reg(s, A_CTRLA, 4);
+    uint32_t ctrlb = mchp_sercom_reg(s, A_CTRLB, 4);
+    unsigned bits = FIELD_EX32(ctrlb, MCHP_SERCOM_SPIM_CTRLB, CHSIZE) ? 9 : 8;
+    uint32_t tx = data & MAKE_64BIT_MASK(0, bits), rx;
+
+    if (!mchp_sercom_enabled(s)) {
+        return;
+    }
+    if (FIELD_EX32(ctrla, MCHP_SERCOM_SPIM_CTRLA, DIPO) ==
+        mchp_sercom_spi_do_pad(ctrla)) {
+        rx = tx;                /* the input pad is the output pad */
+    } else if (QTAILQ_EMPTY(&BUS(s->spi)->children)) {
+        rx = MAKE_64BIT_MASK(0, bits);  /* nothing drives MISO */
+    } else {
+        rx = ssi_transfer(s->spi, tx) & MAKE_64BIT_MASK(0, bits);
+    }
+    trace_mchp_sercom_spi(MCHP_REGBLOCK(s)->name, tx, rx);
+    if (FIELD_EX32(ctrlb, MCHP_SERCOM_SPIM_CTRLB, RXEN)) {
+        if (s->rx_count < MCHP_SERCOM_RX_DEPTH) {
+            s->rx_buf[s->rx_count++] = rx;
+        } else {
+            s->rx_overflow = true;
+        }
+    }
+    mchp_sercom_set_reg(s, A_INTFLAG, 1,
+                        mchp_sercom_reg(s, A_INTFLAG, 1) |
+                        SPIM(INTFLAG, TXC));
+}
+
+/* DATA read: the oldest character; a lost one is flagged when emptied */
+static uint32_t mchp_sercom_spi_read(MchpSercomState *s, bool side_effects)
+{
+    uint32_t data;
+
+    if (!s->rx_count) {
+        return 0;
+    }
+    data = s->rx_buf[0];
+    if (side_effects) {
+        s->rx_buf[0] = s->rx_buf[1];
+        if (!--s->rx_count && s->rx_overflow) {
+            /* The lost character leaves a 0 behind, with RXC (silicon) */
+            s->rx_overflow = false;
+            s->rx_buf[s->rx_count++] = 0;
+            mchp_sercom_set_reg(s, A_STATUS, 2,
+                                mchp_sercom_reg(s, A_STATUS, 2) |
+                                SPIM(STATUS, BUFOVF));
+            mchp_sercom_set_reg(s, A_INTFLAG, 1,
+                                mchp_sercom_reg(s, A_INTFLAG, 1) |
+                                SPIM(INTFLAG, ERROR));
+        }
+        mchp_sercom_update(s);
+    }
+    return data;
+}
+
+/* -- I2C host ------------------------------------------------------------ */
+
+static void mchp_sercom_i2c_flag(MchpSercomState *s, uint32_t flag)
+{
+    uint32_t f = mchp_sercom_reg(s, A_INTFLAG, 1);
+
+    f &= ~(I2CM(INTFLAG, MB) | I2CM(INTFLAG, SB));
+    mchp_sercom_set_reg(s, A_INTFLAG, 1, f | flag);
+}
+
+/* ADDR: start (or repeat) a transfer to the address in ADDR */
+static void mchp_sercom_i2c_start(MchpSercomState *s)
+{
+    uint32_t addr = mchp_sercom_reg(s, A_MCHP_SERCOM_I2CM_ADDR, 4);
+    uint8_t dev = extract32(addr, 1, 7);
+    int nack;
+
+    if (!mchp_sercom_enabled(s)) {
+        return;
+    }
+    timer_del(s->i2c_stop_timer);
+    s->i2c_read = addr & 1;
+    s->i2c_active = true;
+    if (s->i2c_read) {
+        nack = i2c_start_recv(s->i2c, dev) != 0;
+        if (!nack) {
+            s->i2c_rx = i2c_recv(s->i2c);
+        }
+        mchp_sercom_i2c_flag(s, nack ? I2CM(INTFLAG, MB) : I2CM(INTFLAG, SB));
+    } else {
+        nack = i2c_start_send(s->i2c, dev) != 0;
+        mchp_sercom_i2c_flag(s, I2CM(INTFLAG, MB));
+    }
+    trace_mchp_sercom_i2c_start(MCHP_REGBLOCK(s)->name, dev, s->i2c_read,
+                                nack);
+    mchp_sercom_i2c_status(s, I2C_BUS_OWNER, true, nack);
+}
+
+static void mchp_sercom_i2c_write(MchpSercomState *s, uint8_t data)
+{
+    int nack;
+
+    if (!s->i2c_active || s->i2c_read) {
+        return;
+    }
+    nack = i2c_send(s->i2c, data) != 0;
+    trace_mchp_sercom_i2c_byte(MCHP_REGBLOCK(s)->name, data, nack);
+    mchp_sercom_i2c_flag(s, I2CM(INTFLAG, MB));
+    mchp_sercom_i2c_status(s, I2C_BUS_OWNER, true, nack);
+}
+
+/* Receive the next byte (after the ACK of the last one) */
+static void mchp_sercom_i2c_next(MchpSercomState *s)
+{
+    s->i2c_rx = i2c_recv(s->i2c);
+    trace_mchp_sercom_i2c_byte(MCHP_REGBLOCK(s)->name, s->i2c_rx, 0);
+    mchp_sercom_i2c_flag(s, I2CM(INTFLAG, SB));
+    mchp_sercom_i2c_status(s, I2C_BUS_OWNER, true, -1);
+}
+
+static void mchp_sercom_i2c_stop_done(void *opaque)
+{
+    MchpSercomState *s = opaque;
+
+    if (!s->i2c_active && s->i2c_bus == I2C_BUS_OWNER) {
+        mchp_sercom_i2c_status(s, I2C_BUS_IDLE, false, -1);
+    }
+}
+
+/* CTRLB.CMD: the acknowledge action, then repeated start/read/stop */
+static void mchp_sercom_i2c_command(MchpSercomState *s, unsigned cmd)
+{
+    bool nack = FIELD_EX32(mchp_sercom_reg(s, A_CTRLB, 4),
+                           MCHP_SERCOM_I2CM_CTRLB, ACKACT);
+
+    if (!s->i2c_active) {
+        return;
+    }
+    if (s->i2c_read && nack && cmd != 2) {
+        i2c_nack(s->i2c);
+    }
+    switch (cmd) {
+    case 1:
+        mchp_sercom_i2c_start(s);
+        break;
+    case 2:
+        if (s->i2c_read) {
+            mchp_sercom_i2c_next(s);
+        }
+        break;
+    case 3:
+        i2c_end_transfer(s->i2c);
+        s->i2c_active = false;
+        mchp_sercom_i2c_flag(s, 0);
+        mchp_sercom_i2c_status(s, I2C_BUS_OWNER, false, -1);
+        timer_mod(s->i2c_stop_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + I2C_STOP_NS);
+        break;
+    }
+}
+
+/* DATA read: the received byte; smart mode acknowledges and goes on */
+static uint32_t mchp_sercom_i2c_read(MchpSercomState *s, bool side_effects)
+{
+    uint32_t data = s->i2c_rx;
+
+    if (side_effects && s->i2c_active && s->i2c_read) {
+        mchp_sercom_i2c_flag(s, 0);
+        if (FIELD_EX32(mchp_sercom_reg(s, A_CTRLB, 4),
+                       MCHP_SERCOM_I2CM_CTRLB, SMEN)) {
+            if (FIELD_EX32(mchp_sercom_reg(s, A_CTRLB, 4),
+                           MCHP_SERCOM_I2CM_CTRLB, ACKACT)) {
+                i2c_nack(s->i2c);
+            } else {
+                mchp_sercom_i2c_next(s);
+            }
+        }
+        mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+    }
+    return data;
+}
