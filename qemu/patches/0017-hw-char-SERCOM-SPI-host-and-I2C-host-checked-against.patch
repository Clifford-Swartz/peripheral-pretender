diff --git a/hw/misc/mchp_edbg_dgi.c b/hw/misc/mchp_edbg_dgi.c
new file mode 100644
index 0000000..484d64a
--- /dev/null
+++ b/hw/misc/mchp_edbg_dgi.c
@@ -0,0 +1,63 @@
+/*
+ * Microchip EDBG data gateway (DGI) as seen on a Curiosity Pro I2C bus
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The board's debugger listens on the target's I2C bus (address 0x28 on
+ * the PIC32CM MC00 Curiosity Pro). As the target sees it on silicon, it
+ * acknowledges its address and every byte written, reads return 0x00, and
+ * it does not answer the general call (address 0). The gateway protocol
+ * itself is not modelled.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/i2c.h"
+#include "hw/misc/mchp_edbg_dgi.h"
+
+/* Its own address only: the general call goes unanswered (silicon) */
+static bool mchp_edbg_dgi_match(I2CSlave *candidate, uint8_t address,
+                                bool broadcast, I2CNodeList *current_devs)
+{
+    I2CNode *node;
+
+    if (broadcast || candidate->address != address) {
+        return false;
+    }
+    node = g_new(struct I2CNode, 1);
+    node->elt = candidate;
+    QLIST_INSERT_HEAD(current_devs, node, next);
+    return true;
+}
+
+static uint8_t mchp_edbg_dgi_recv(I2CSlave *i2c)
+{
+    return 0x00;
+}
+
+static int mchp_edbg_dgi_send(I2CSlave *i2c, uint8_t data)
+{
+    return 0;                   /* ACK */
+}
+
+static void mchp_edbg_dgi_class_init(ObjectClass *klass, const void *data)
+{
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    k->match_and_add = mchp_edbg_dgi_match;
+    k->recv = mchp_edbg_dgi_recv;
+    k->send = mchp_edbg_dgi_send;
+}
+
+static const TypeInfo mchp_edbg_dgi_types[] = {
+    {
+        .name = TYPE_MCHP_EDBG_DGI,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(I2CSlave),
+        .class_init = mchp_edbg_dgi_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_edbg_dgi_types)
