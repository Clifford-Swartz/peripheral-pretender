+/*
+ * Microchip EDBG data gateway (DGI) as seen on a Curiosity Pro I2C bus
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An I2C target that acknowledges everything and reads 0x00.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_EDBG_DGI_H
+#define HW_MISC_MCHP_EDBG_DGI_H
+
+#define TYPE_MCHP_EDBG_DGI "mchp-edbg-dgi"
+
+#endif /* HW_MISC_MCHP_EDBG_DGI_H */
diff --git a/tests/qtest/pic32cm-mc00-test.c b/tests/qtest/pic32cm-mc00-test.c
index 8c8d1af..263a196 100644
--- a/tests/qtest/pic32cm-mc00-test.c
+++ b/tests/qtest/pic32cm-mc00-test.c
@@ -29,6 +29,8 @@
 #define DSU             0x41002000
 #define NVMCTRL         0x41004000
 #define SERCOM0         0x42000400
+#define SERCOM1         0x42000800
+#define SERCOM2         0x42000C00
 #define USER_ROW        0x00804000
 #define SCB_CPUID       0xE000ED00
 
@@ -176,10 +178,64 @@ static void test_led0_sw0(void)
     qtest_quit(qts);
 }
 
+/* SERCOM2 I2C host: the EDBG data gateway at 0x28 is the only device */
+static void test_i2c_dgi(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, SERCOM2 + 0x00, 5 << 2);             /* I2C host */
+    qtest_writel(qts, SERCOM2 + 0x04, BIT(8));             /* SMEN */
+    qtest_writel(qts, SERCOM2 + 0x00, 5 << 2 | 0x02);      /* ENABLE */
+    g_assert_cmphex(qtest_readw(qts, SERCOM2 + 0x1A), ==, 0x00);
+    qtest_writew(qts, SERCOM2 + 0x1A, 0x10);               /* force IDLE */
+    g_assert_cmphex(qtest_readw(qts, SERCOM2 + 0x1A), ==, 0x10);
+
+    qtest_writel(qts, SERCOM2 + 0x24, 0x10 << 1);          /* no device */
+    g_assert_cmphex(qtest_readb(qts, SERCOM2 + 0x18), ==, 0x01);    /* MB */
+    g_assert_cmphex(qtest_readw(qts, SERCOM2 + 0x1A), ==, 0xA4);
+    qtest_writel(qts, SERCOM2 + 0x04, BIT(8) | 3 << 16);   /* stop */
+    g_assert_cmphex(qtest_readw(qts, SERCOM2 + 0x1A), ==, 0x24);
+    qtest_clock_step(qts, 20000);
+    g_assert_cmphex(qtest_readw(qts, SERCOM2 + 0x1A), ==, 0x14);
+
+    qtest_writel(qts, SERCOM2 + 0x24, 0x28 << 1 | 1);      /* read DGI */
+    g_assert_cmphex(qtest_readb(qts, SERCOM2 + 0x18), ==, 0x02);    /* SB */
+    g_assert_cmphex(qtest_readw(qts, SERCOM2 + 0x1A), ==, 0xA0);
+    g_assert_cmphex(qtest_readb(qts, SERCOM2 + 0x28), ==, 0x00);
+    g_assert_cmphex(qtest_readb(qts, SERCOM2 + 0x18), ==, 0x02);    /* next */
+    qtest_writel(qts, SERCOM2 + 0x04, BIT(8) | BIT(18) | 3 << 16);
+    qtest_quit(qts);
+}
+
+/* SERCOM1 SPI host: MISO on the MOSI pad loops back; elsewhere reads 0xFF */
+static void test_spi_loopback(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* DOPO 1 (DO on PAD2), DIPO 2, RXEN */
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 2 << 20);
+    qtest_writel(qts, SERCOM1 + 0x04, BIT(17));
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 2 << 20 | 0x02);
+    g_assert_cmphex(qtest_readb(qts, SERCOM1 + 0x18), ==, 0x01);    /* DRE */
+    qtest_writel(qts, SERCOM1 + 0x28, 0x5A);
+    g_assert_cmphex(qtest_readb(qts, SERCOM1 + 0x18), ==, 0x07);
+    g_assert_cmphex(qtest_readl(qts, SERCOM1 + 0x28), ==, 0x5A);
+
+    qtest_writel(qts, SERCOM1 + 0x00, 0x01);               /* SWRST */
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);   /* DIPO 0 */
+    qtest_writel(qts, SERCOM1 + 0x04, BIT(17));
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, SERCOM1 + 0x28, 0x5A);
+    g_assert_cmphex(qtest_readl(qts, SERCOM1 + 0x28), ==, 0xFF);
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
 
+    qtest_add_func("pic32cm-mc00/i2c-dgi", test_i2c_dgi);
+    qtest_add_func("pic32cm-mc00/spi-loopback", test_spi_loopback);
     qtest_add_func("pic32cm-mc00/identity", test_identity);
     qtest_add_func("pic32cm-mc00/reset-values", test_reset_values);
     qtest_add_func("pic32cm-mc00/port-groups", test_port_groups);
