+static unsigned mchp_sercom_mode(MchpSercomState *s)
+{
+    return FIELD_EX32(mchp_sercom_reg(s, A_CTRLA, 4),
+                      MCHP_SERCOM_USART_INT_CTRLA, MODE);
+}
+
+static bool mchp_sercom_enabled(MchpSercomState *s)
+{
+    return FIELD_EX32(mchp_sercom_reg(s, A_CTRLA, 4),
+                      MCHP_SERCOM_USART_INT_CTRLA, ENABLE);
