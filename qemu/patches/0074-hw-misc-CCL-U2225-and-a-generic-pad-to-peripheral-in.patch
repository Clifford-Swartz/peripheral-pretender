+ *                  the SoC wires it to the models that take that signal
  *   "ev-event-in"[4] in: EVSYS event inputs (EVCTRL PORTEIn)
  *   "pmux-in"[n * 16 + f]  in: peripheral function f (PMUX value) drives
  *                  pad n: 0 or 1, -1 when it does not drive, or
@@ -57,6 +60,7 @@
 #define MCHP_PORT_OUT "port-out"
 #define MCHP_PORT_IN "port-in"
 #define MCHP_PORT_FUNC_A "func-a"
+#define MCHP_PORT_FUNC_IN "func-in"
