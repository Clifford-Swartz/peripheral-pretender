diff --git a/hw/misc/mchp_ccl.c b/hw/misc/mchp_ccl.c
new file mode 100644
index 0000000..3f4f0a5
--- /dev/null
+++ b/hw/misc/mchp_ccl.c
@@ -0,0 +1,599 @@
+/*
+ * Microchip configurable custom logic (CCL U2225)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Four LUTs and two sequencers, as PIC32CM MC00 silicon showed them
+ * (firmware/hello APP=cclprobe and cclprobe2, checked by ccl;
+ * docs/research/peripherals/ccl-u2225.md):
+ *
+ *   - OUTn = TRUTH[IN2 << 2 | IN1 << 1 | IN0], each input selected by
+ *     LUTCTRLn.INSELx: MASK 0; FEEDBACK the pair's sequencer output (0
+ *     without one); LINK the output of LUT n + 1 (LUT3: LUT0); EVENT a
+ *     strobe three GCLK_CCL edges after a rising edge of LUTn's event
+ *     input (falling with INVEI; LUTEI on); IO the pad of IN[3n + x]
+ *     while muxed to the CCL; AC comparator n % "ac-count"; TC the WO[0]
+ *     of TCn, ALTTC of TC(n + 1); TCC WO[x] of TCC(n % "tcc-count");
+ *     SERCOM reads 1 (idle, also while the SERCOM is off: the TX bit
+ *     stream is not modelled). The tapped waveform outputs need no pads.
+ *   - FILTSEL SYNCH passes a change at the second GCLK_CCL edge after it,
+ *     FILTER at the fourth if it held until then; EDGESEL turns a rising
+ *     edge into a one-cycle pulse.
+ *   - Sequencer N (SEQCTRLN) takes LUT 2N (D, J, S) and LUT 2N + 1 (G, K,
+ *     R): DFF and JK change at GCLK_CCL edges (J = K = 1 toggles at half
+ *     the clock), LATCH and RS at once (S = R = 1 sets); a disabled even
+ *     LUT clears it. OUT2N is then the sequencer's output, OUT2N+1 stays
+ *     the odd LUT's own.
+ *   - A disabled LUT or CCL outputs 0 and drives its pad to 0.
+ *     "lutout-event"[n] carries OUTn's level while LUTEO; the CCL tells
+ *     the TC and TCC when a LUT reads their outputs ("tap-*-active"), so
+ *     that they stop coasting over output changes.
+ *   - Registers: SEQCTRLx and CTRL.RUNSTDBY take writes only while
+ *     CTRL.ENABLE is 0 (overlay); LUTCTRLn's bits but ENABLE only while
+ *     CTRL.ENABLE is 0 and the LUT was disabled before the write, so a
+ *     write that enables a LUT can configure it and one that disables it
+ *     cannot.
+ *
+ * Not modelled: the SERCOM TX bit stream, ALT2TC and ASYNCEVENT (JH01
+ * INSEL 0xA, 0xB), standby (clocked LUTs forced to 0), SYNCH passing a
+ * pulse shorter than two edges, the sub-cycle width of an EVENT strobe
+ * (silicon: very short; here zero-width).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/misc/mchp_ccl.h"
+#include "hw/mchp/gen/ccl_u2225.h"
+#include "migration/vmstate.h"
+
+#define CCL_NIN             12
+#define CCL_PASSES          8       /* LINK chains settle within this */
+#define CCL_SYNCH_EDGES     2
+#define CCL_FILTER_EDGES    4
+#define CCL_EVENT_EDGES     3
+
+enum {
+    INSEL_MASK, INSEL_FEEDBACK, INSEL_LINK, INSEL_EVENT, INSEL_IO, INSEL_AC,
+    INSEL_TC, INSEL_ALTTC, INSEL_TCC, INSEL_SERCOM,
+};
+
+enum { SEQ_DISABLE, SEQ_DFF, SEQ_JK, SEQ_LATCH, SEQ_RS };
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpCclState, MCHP_CCL)
+
+struct MchpCclState {
+    MchpRegBlock parent_obj;
+
+    qemu_irq pad_out[MCHP_CCL_LUTS];
+    qemu_irq event_out[MCHP_CCL_LUTS];
+    qemu_irq tc_active[MCHP_CCL_TAP_TC];
+    qemu_irq tcc_active[MCHP_CCL_TAP_TCC];
+    uint32_t tcc_count;
+    uint32_t ac_count;
+    QEMUTimer *timer;
+    bool busy, dirty;           /* re-entry through our own outputs */
+
+    /* Input lines */
+    uint16_t io;                /* IN0-11 pads */
+    uint8_t ev;                 /* event inputs */
+    uint8_t tc;                 /* TCm WO[0] */
+    uint16_t tcc;               /* TCCm WO[x] at 3m + x */
+    uint8_t ac;                 /* comparator outputs */
+    uint8_t strobe;             /* EVENT inputs reading 1 at this instant */
+    int64_t ev_at[MCHP_CCL_LUTS];       /* a strobe due, INT64_MAX: none */
+
+    /* Per-LUT pipeline */
+    uint8_t comb;               /* truth-table outputs */
+    uint8_t filt;               /* after FILTSEL */
+    int64_t filt_at[MCHP_CCL_LUTS];     /* filt takes comb then */
+    uint8_t pulse;              /* EDGESEL pulses */
+    int64_t pulse_end[MCHP_CCL_LUTS];
+    uint8_t seq;                /* sequencer outputs, bit N */
+    int64_t seq_at[2];          /* the next clocked sequencer update */
+    uint8_t out;                /* OUTn */
+
+    /* As last signalled */
+    uint8_t out_sig;
+    uint8_t evo_sig;
+    uint8_t tc_sig;
+    uint16_t tcc_sig;
+};
+
+static uint32_t ccl_reg(MchpCclState *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static uint32_t ccl_lut(MchpCclState *s, unsigned n)
+{
+    return ccl_reg(s, A_MCHP_CCL_LUTCTRL + 4 * n, 4);
+}
+
+static unsigned ccl_seqsel(MchpCclState *s, unsigned pair)
+{
+    return FIELD_EX32(ccl_reg(s, A_MCHP_CCL_SEQCTRL + pair, 1),
+                      MCHP_CCL_SEQCTRL, SEQSEL);
+}
+
+static bool ccl_on(MchpCclState *s)
+{
+    return FIELD_EX32(ccl_reg(s, A_MCHP_CCL_CTRL, 1), MCHP_CCL_CTRL, ENABLE);
+}
+
+static bool ccl_lut_on(MchpCclState *s, unsigned n)
+{
+    return ccl_on(s) && FIELD_EX32(ccl_lut(s, n), MCHP_CCL_LUTCTRL, ENABLE);
+}
+
+/* The @k-th GCLK_CCL edge after @t; INT64_MAX while the clock stops */
+static int64_t ccl_edge(MchpCclState *s, int64_t t, unsigned k)
+{
+    Clock *clk = MCHP_REGBLOCK(s)->gclk;
+    int64_t p;
+
+    if (!clock_is_enabled(clk)) {
+        return INT64_MAX;
+    }
+    p = MAX(clock_ticks_to_ns(clk, 1), 1);
+    return (t / p + k) * p;
+}
+
+static bool ccl_input(MchpCclState *s, unsigned n, unsigned x)
+{
+    uint32_t ctrl = ccl_lut(s, n);
+
+    switch (extract32(ctrl, R_MCHP_CCL_LUTCTRL_INSEL0_SHIFT + 4 * x, 4)) {
+    case INSEL_FEEDBACK:
+        return extract32(s->seq, n / 2, 1);
+    case INSEL_LINK:
+        return extract32(s->out, (n + 1) % MCHP_CCL_LUTS, 1);
+    case INSEL_EVENT:
+        return FIELD_EX32(ctrl, MCHP_CCL_LUTCTRL, LUTEI) &&
+               extract32(s->strobe, n, 1);
+    case INSEL_IO:
+        return extract32(s->io, 3 * n + x, 1);
+    case INSEL_AC:
+        return s->ac_count && extract32(s->ac, n % s->ac_count, 1);
+    case INSEL_TC:
+        return extract32(s->tc, n, 1);
+    case INSEL_ALTTC:
+        return extract32(s->tc, n + 1, 1);
+    case INSEL_TCC:
+        return s->tcc_count &&
+               extract32(s->tcc, 3 * (n % s->tcc_count) + x, 1);
+    case INSEL_SERCOM:
+        return true;            /* idle */
+    default:
+        return false;           /* MASK, reserved */
+    }
+}
+
+/* LUTn after its filter and edge detector */
+static bool ccl_value(MchpCclState *s, unsigned n)
+{
+    uint32_t ctrl = ccl_lut(s, n);
+
+    if (FIELD_EX32(ctrl, MCHP_CCL_LUTCTRL, EDGESEL)) {
+        return extract32(s->pulse, n, 1);
+    }
+    return extract32(FIELD_EX32(ctrl, MCHP_CCL_LUTCTRL, FILTSEL) ?
+                     s->filt : s->comb, n, 1);
+}
+
+/* One step of LUTn's pipeline at @now */
+static void ccl_step_lut(MchpCclState *s, unsigned n, int64_t now)
+{
+    uint32_t ctrl = ccl_lut(s, n);
+    unsigned filtsel = FIELD_EX32(ctrl, MCHP_CCL_LUTCTRL, FILTSEL);
+    bool on = ccl_lut_on(s, n);
+    unsigned idx = 0;
+    bool comb, filt;
+
+    for (unsigned x = 0; x < 3; x++) {
+        idx |= ccl_input(s, n, x) << x;
+    }
+    comb = on && extract32(FIELD_EX32(ctrl, MCHP_CCL_LUTCTRL, TRUTH), idx, 1);
+    if (comb != extract32(s->comb, n, 1)) {
+        s->comb = deposit32(s->comb, n, 1, comb);
+        if (filtsel && on) {
+            s->filt_at[n] = ccl_edge(s, now, filtsel == 2 ? CCL_FILTER_EDGES
+                                                          : CCL_SYNCH_EDGES);
+        }
+    }
+    filt = extract32(s->filt, n, 1);
+    if (!filtsel || !on) {
+        filt = comb;
+        s->filt_at[n] = INT64_MAX;
+    } else if (s->filt_at[n] <= now) {
+        /* comb held since it last changed (a later change rescheduled) */
+        filt = comb;
+        s->filt_at[n] = INT64_MAX;
+    }
+    if (filt != extract32(s->filt, n, 1)) {
+        s->filt = deposit32(s->filt, n, 1, filt);
+        if (filt && on && FIELD_EX32(ctrl, MCHP_CCL_LUTCTRL, EDGESEL)) {
+            s->pulse |= BIT(n);
+            s->pulse_end[n] = ccl_edge(s, now, 1);
+        }
+    }
+    if (extract32(s->pulse, n, 1) && (!on || s->pulse_end[n] <= now)) {
+        s->pulse &= ~BIT(n);
+        s->pulse_end[n] = INT64_MAX;
+    }
+}
+
+/* The clocked sequencer's next state from D/J (@a), G/K (@b) and @q */
+static bool ccl_seq_next(unsigned mode, bool a, bool b, bool q)
+{
+    if (mode == SEQ_DFF) {
+        return b ? a : q;
+    }
+    return a && b ? !q : a ? true : b ? false : q;          /* JK */
+}
+
+static void ccl_step_seq(MchpCclState *s, unsigned pair, int64_t now)
+{
+    unsigned mode = ccl_seqsel(s, pair);
+    bool a = ccl_value(s, 2 * pair), b = ccl_value(s, 2 * pair + 1);
+    bool q = extract32(s->seq, pair, 1);
+
+    if (!ccl_lut_on(s, 2 * pair) || mode < SEQ_DFF || mode > SEQ_RS) {
+        q = false;
+        s->seq_at[pair] = INT64_MAX;
+    } else if (mode == SEQ_LATCH) {
+        q = b ? a : q;
+    } else if (mode == SEQ_RS) {
+        q = a ? true : b ? false : q;
+    } else {
+        if (s->seq_at[pair] <= now) {
+            q = ccl_seq_next(mode, a, b, q);        /* a clock edge */
+            s->seq_at[pair] = INT64_MAX;
+        }
+        if (ccl_seq_next(mode, a, b, q) == q) {
+            s->seq_at[pair] = INT64_MAX;
+        } else if (s->seq_at[pair] == INT64_MAX) {
+            s->seq_at[pair] = ccl_edge(s, now, 1);
+        }
+    }
+    s->seq = deposit32(s->seq, pair, 1, q);
+}
+
+static uint8_t ccl_outputs(MchpCclState *s)
+{
+    uint8_t out = 0;
+
+    for (unsigned n = 0; n < MCHP_CCL_LUTS; n++) {
+        bool v;
+
+        if (!ccl_lut_on(s, n)) {
+            v = false;
+        } else if (!(n & 1) && ccl_seqsel(s, n / 2)) {
+            v = extract32(s->seq, n / 2, 1);
+        } else {
+            v = ccl_value(s, n);
+        }
+        out |= v << n;
+    }
+    return out;
+}
+
+static void ccl_signal(MchpCclState *s)
+{
+    uint8_t evo = 0, tc = 0;
+    uint16_t tcc = 0;
+
+    for (unsigned n = 0; n < MCHP_CCL_LUTS; n++) {
+        uint32_t ctrl = ccl_lut(s, n);
+
+        if (FIELD_EX32(ctrl, MCHP_CCL_LUTCTRL, LUTEO)) {
+            evo |= s->out & BIT(n);
+        }
+        if (!ccl_lut_on(s, n)) {
+            continue;
+        }
+        for (unsigned x = 0; x < 3; x++) {
+            switch (extract32(ctrl, R_MCHP_CCL_LUTCTRL_INSEL0_SHIFT + 4 * x,
+                              4)) {
+            case INSEL_TC:
+                tc |= BIT(n);
+                break;
+            case INSEL_ALTTC:
+                tc |= BIT(n + 1);
+                break;
+            case INSEL_TCC:
+                if (s->tcc_count) {
+                    tcc |= BIT(3 * (n % s->tcc_count) + x);
+                }
+                break;
+            default:
+                break;
+            }
+        }
+    }
+    /* Taps first: a TC or TCC must stop coasting before we read it */
+    for (unsigned m = 0; m < MCHP_CCL_TAP_TC; m++) {
+        if (extract32(tc ^ s->tc_sig, m, 1)) {
+            qemu_set_irq(s->tc_active[m], extract32(tc, m, 1));
+        }
+    }
+    for (unsigned m = 0; m < MCHP_CCL_TAP_TCC; m++) {
+        if (extract32(tcc ^ s->tcc_sig, m, 1)) {
+            qemu_set_irq(s->tcc_active[m], extract32(tcc, m, 1));
+        }
+    }
+    s->tc_sig = tc;
+    s->tcc_sig = tcc;
+    for (unsigned n = 0; n < MCHP_CCL_LUTS; n++) {
+        if (extract32(s->out ^ s->out_sig, n, 1)) {
+            qemu_set_irq(s->pad_out[n], extract32(s->out, n, 1));
+        }
+        if (extract32(evo ^ s->evo_sig, n, 1)) {
+            qemu_set_irq(s->event_out[n], extract32(evo, n, 1));
+        }
+    }
+    s->out_sig = s->out;
+    s->evo_sig = evo;
+}
+
+static void ccl_eval(MchpCclState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t next = INT64_MAX;
+
+    if (s->busy) {
+        s->dirty = true;
+        return;
+    }
+    s->busy = true;
+    do {
+        unsigned pass;
+
+        s->dirty = false;
+        for (unsigned n = 0; n < MCHP_CCL_LUTS; n++) {
+            if (s->ev_at[n] <= now) {
+                s->ev_at[n] = INT64_MAX;
+                s->strobe |= BIT(n);
+            }
+        }
+        for (pass = 0; pass < CCL_PASSES; pass++) {
+            uint8_t before = s->comb ^ (s->filt << 4);
+            uint8_t out;
+
+            for (unsigned n = 0; n < MCHP_CCL_LUTS; n++) {
+                ccl_step_lut(s, n, now);
+            }
+            for (unsigned pair = 0; pair < 2; pair++) {
+                ccl_step_seq(s, pair, now);
+            }
+            out = ccl_outputs(s);
+            if (out == s->out && before == (s->comb ^ (s->filt << 4))) {
+                break;
+            }
+            s->out = out;
+        }
+        if (pass == CCL_PASSES) {
+            qemu_log_mask(LOG_GUEST_ERROR, "%s: the LUTs form a loop with no "
+                          "clocked stage; outputs held\n",
+                          MCHP_REGBLOCK(s)->name);
+        }
+        ccl_signal(s);
+        if (s->strobe) {
+            s->strobe = 0;              /* the strobe lasts an instant */
+            s->dirty = true;
+        }
+    } while (s->dirty);
+    for (unsigned n = 0; n < MCHP_CCL_LUTS; n++) {
+        next = MIN(next, MIN(s->filt_at[n], s->pulse_end[n]));
+        next = MIN(next, s->ev_at[n]);
+    }
+    next = MIN(next, MIN(s->seq_at[0], s->seq_at[1]));
+    if (next == INT64_MAX) {
+        timer_del(s->timer);
+    } else {
+        timer_mod(s->timer, MAX(next, now));
+    }
+    s->busy = false;
+}
+
+static void ccl_tick(void *opaque)
+{
+    ccl_eval(opaque);
+}
+
+static void ccl_set_bit16(MchpCclState *s, uint16_t *bits, int n, int level)
+{
+    *bits = deposit32(*bits, n, 1, level > 0);
+    ccl_eval(s);
+}
+
+static void ccl_io_in(void *opaque, int n, int level)
+{
+    MchpCclState *s = opaque;
+
+    ccl_set_bit16(s, &s->io, n, level);
+}
+
+static void ccl_tcc_in(void *opaque, int n, int level)
+{
+    MchpCclState *s = opaque;
+
+    ccl_set_bit16(s, &s->tcc, n, level);
+}
+
+static void ccl_tc_in(void *opaque, int n, int level)
+{
+    MchpCclState *s = opaque;
+
+    s->tc = deposit32(s->tc, n, 1, level > 0);
+    ccl_eval(s);
+}
+
+static void ccl_ac_in(void *opaque, int n, int level)
+{
+    MchpCclState *s = opaque;
+
+    s->ac = deposit32(s->ac, n, 1, level > 0);
+    ccl_eval(s);
+}
+
+/* "lutin-event-in": an edge (rising, falling with INVEI) strobes later */
+static void ccl_event_in(void *opaque, int n, int level)
+{
+    MchpCclState *s = opaque;
+    uint32_t ctrl = ccl_lut(s, n);
+    bool old = extract32(s->ev, n, 1), lvl = level > 0;
+
+    s->ev = deposit32(s->ev, n, 1, lvl);
+    if (old != lvl && lvl != FIELD_EX32(ctrl, MCHP_CCL_LUTCTRL, INVEI) &&
+        FIELD_EX32(ctrl, MCHP_CCL_LUTCTRL, LUTEI) && ccl_lut_on(s, n)) {
+        int64_t at = ccl_edge(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                              CCL_EVENT_EDGES);
+
+        s->ev_at[n] = MIN(s->ev_at[n], at);
+        ccl_eval(s);
+    }
+}
+
+static void ccl_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                           unsigned idx, uint32_t old, uint32_t written,
+                           uint32_t we)
+{
+    MchpCclState *s = MCHP_CCL(rf->opaque);
+
+    if (ri->offset == A_MCHP_CCL_CTRL &&
+        (written & we & R_MCHP_CCL_CTRL_SWRST_MASK)) {
+        return;                 /* mchp-regblock resets the CCL next */
+    }
+    if (ri->offset == A_MCHP_CCL_LUTCTRL &&
+        (ccl_on(s) || (old & R_MCHP_CCL_LUTCTRL_ENABLE_MASK))) {
+        /* Only ENABLE takes (silicon) */
+        uint32_t val = mchp_regfile_get(rf, ri, idx);
+
+        mchp_regfile_set(rf, ri, idx,
+                         (old & ~R_MCHP_CCL_LUTCTRL_ENABLE_MASK) |
+                         (val & R_MCHP_CCL_LUTCTRL_ENABLE_MASK));
+    }
+    ccl_eval(s);
+}
+
+static void ccl_gclk_update(MchpRegBlock *rb, ClockEvent event)
+{
+    if (event == ClockUpdate) {
+        ccl_eval(MCHP_CCL(rb));
+    }
+}
+
+static void ccl_reset_hold(MchpRegBlock *rb)
+{
+    MchpCclState *s = MCHP_CCL(rb);
+
+    s->strobe = 0;
+    s->comb = s->filt = s->pulse = s->seq = s->out = 0;
+    for (unsigned n = 0; n < MCHP_CCL_LUTS; n++) {
+        s->ev_at[n] = s->filt_at[n] = s->pulse_end[n] = INT64_MAX;
+    }
+    s->seq_at[0] = s->seq_at[1] = INT64_MAX;
+    timer_del(s->timer);
+    ccl_signal(s);
+}
+
+static void ccl_init(Object *obj)
+{
+    MchpCclState *s = MCHP_CCL(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, ccl_tick, s);
+    for (unsigned n = 0; n < MCHP_CCL_LUTS; n++) {
+        s->ev_at[n] = s->filt_at[n] = s->pulse_end[n] = INT64_MAX;
+    }
+    s->seq_at[0] = s->seq_at[1] = INT64_MAX;
+    qdev_init_gpio_out_named(dev, s->pad_out, "pad-out", MCHP_CCL_LUTS);
+    qdev_init_gpio_in_named(dev, ccl_io_in, "pad-in-in", CCL_NIN);
+    qdev_init_gpio_out_named(dev, s->event_out, "lutout-event",
+                             MCHP_CCL_LUTS);
+    qdev_init_gpio_in_named(dev, ccl_event_in, "lutin-event-in",
+                            MCHP_CCL_LUTS);
+    qdev_init_gpio_in_named(dev, ccl_tc_in, MCHP_CCL_TAP_TC_IN,
+                            MCHP_CCL_TAP_TC);
+    qdev_init_gpio_out_named(dev, s->tc_active, MCHP_CCL_TAP_TC_ACTIVE,
+                             MCHP_CCL_TAP_TC);
+    qdev_init_gpio_in_named(dev, ccl_tcc_in, MCHP_CCL_TAP_TCC_IN,
+                            MCHP_CCL_TAP_TCC);
+    qdev_init_gpio_out_named(dev, s->tcc_active, MCHP_CCL_TAP_TCC_ACTIVE,
+                             MCHP_CCL_TAP_TCC);
+    qdev_init_gpio_in_named(dev, ccl_ac_in, MCHP_CCL_TAP_AC_IN,
+                            MCHP_CCL_TAP_AC);
+}
+
+static void ccl_finalize(Object *obj)
+{
+    timer_free(MCHP_CCL(obj)->timer);
+}
+
+static const Property ccl_properties[] = {
+    DEFINE_PROP_UINT32("tcc-count", MchpCclState, tcc_count, 0),
+    DEFINE_PROP_UINT32("ac-count", MchpCclState, ac_count, 0),
+};
+
+static const VMStateDescription vmstate_mchp_ccl = {
+    .name = TYPE_MCHP_CCL,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpCclState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_TIMER_PTR(timer, MchpCclState),
+        VMSTATE_UINT16(io, MchpCclState),
+        VMSTATE_UINT8(ev, MchpCclState),
+        VMSTATE_UINT8(tc, MchpCclState),
+        VMSTATE_UINT16(tcc, MchpCclState),
+        VMSTATE_UINT8(ac, MchpCclState),
+        VMSTATE_INT64_ARRAY(ev_at, MchpCclState, MCHP_CCL_LUTS),
+        VMSTATE_UINT8(comb, MchpCclState),
+        VMSTATE_UINT8(filt, MchpCclState),
+        VMSTATE_INT64_ARRAY(filt_at, MchpCclState, MCHP_CCL_LUTS),
+        VMSTATE_UINT8(pulse, MchpCclState),
+        VMSTATE_INT64_ARRAY(pulse_end, MchpCclState, MCHP_CCL_LUTS),
+        VMSTATE_UINT8(seq, MchpCclState),
+        VMSTATE_INT64_ARRAY(seq_at, MchpCclState, 2),
+        VMSTATE_UINT8(out, MchpCclState),
+        VMSTATE_UINT8(out_sig, MchpCclState),
+        VMSTATE_UINT8(evo_sig, MchpCclState),
+        VMSTATE_UINT8(tc_sig, MchpCclState),
+        VMSTATE_UINT16(tcc_sig, MchpCclState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void ccl_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_mchp_ccl;
+    device_class_set_props(dc, ccl_properties);
+    c->post_write = ccl_post_write;
+    c->reset_hold = ccl_reset_hold;
+    c->gclk_update = ccl_gclk_update;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_ccl_types[] = {
+    {
+        .name = TYPE_MCHP_CCL,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpCclState),
+        .instance_init = ccl_init,
+        .instance_finalize = ccl_finalize,
+        .class_init = ccl_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_ccl_types)
