                 qdev_connect_gpio_out_named(port, MCHP_PORT_PMUX_ACTIVE,
                                             pins[k],
                                             qdev_get_gpio_in_named(dev, act,
@@ -1070,6 +1159,64 @@ static void pic32cm_connect_pads(Pic32cmSocState *s)
     }
 }
 
+/*
+ * Pads to peripheral inputs: signal GROUP[n] of an instance whose model
+ * has the GPIO input "pad-<group>-in"[n] (lower case) takes PORT
+ * "func-in" of every pad and function that carry it: the pad's level
+ * while the pin is muxed to that function (an OR gate when several do).
+ * The EIC has its own path (pic32cm_connect_eic()).
+ */
+static void pic32cm_connect_pad_inputs(Pic32cmSocState *s)
+{
+    DeviceState *port = pic32cm_periph(s, "PORT");
+    g_autoptr(GHashTable) seen = g_hash_table_new_full(g_str_hash,
+                                                       g_str_equal, g_free,
+                                                       NULL);
+
+    for (unsigned i = 0; i < s->dev->nsignals && port; i++) {
+        const MchpSignalInfo *sig = &s->dev->signals[i];
+        DeviceState *dev = pic32cm_soc_periph(s, sig->instance);
+        g_autofree char *grp = g_ascii_strdown(sig->group, -1);
+        g_autofree char *name = g_strdup_printf("pad-%s-in", grp);
+        g_autofree char *key = NULL;
+        unsigned lines[16], n = 0;
+        qemu_irq in;
+
+        if (!dev || sig->pmux < 0 || sig->pin < 0 || sig->index < 0 ||
+            !pic32cm_has_gpio(dev, name, true, sig->index)) {
+            continue;
+        }
+        key = g_strdup_printf("%s.%s[%d]", sig->instance, grp, sig->index);
+        if (g_hash_table_contains(seen, key)) {
+            continue;
+        }
+        for (unsigned j = i; j < s->dev->nsignals && n < ARRAY_SIZE(lines);
+             j++) {
+            const MchpSignalInfo *o = &s->dev->signals[j];
+
+            if (!strcmp(o->instance, sig->instance) &&
+                !strcmp(o->group, sig->group) && o->index == sig->index &&
+                o->pmux >= 0 && o->pin >= 0) {
+                lines[n++] = o->pin * MCHP_PORT_FUNCS + o->pmux;
+            }
+        }
+        in = qdev_get_gpio_in_named(dev, name, sig->index);
+        if (n > 1) {
+            g_autofree char *oname = g_strdup_printf("%s-in-or", key);
+            DeviceState *or = pic32cm_gate(s, TYPE_OR_IRQ, oname, n);
+
+            qdev_connect_gpio_out(or, 0, in);
+            for (unsigned k = 0; k < n; k++) {
+                qdev_connect_gpio_out_named(port, MCHP_PORT_FUNC_IN, lines[k],
+                                            qdev_get_gpio_in(or, k));
+            }
+        } else {
+            qdev_connect_gpio_out_named(port, MCHP_PORT_FUNC_IN, lines[0], in);
+        }
+        g_hash_table_add(seen, g_steal_pointer(&key));
+    }
+}
+
 /* Reset sources that RSTC records in RCAUSE */
