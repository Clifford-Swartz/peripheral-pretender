--- /dev/null
+++ b/include/hw/misc/mchp_ccl.h
@@ -0,0 +1,41 @@
+/*
+ * Microchip configurable custom logic (CCL U2225)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An mchp-regblock (see mchp_ccl.c). GPIO lines:
+ *   "pad-out"[4]         out: OUTn on its pads (0 while disabled)
+ *   "pad-in-in"[12]      in: the pad of IN[x] while muxed to the CCL
+ *   "lutout-event"[4]    out: OUTn's level while LUTCTRLn.LUTEO
+ *   "lutin-event-in"[4]  in: LUTn's event input
+ *   "tap-tc"[8]          in: TCm's WO[0] (INSEL TC, ALTTC)
+ *   "tap-tc-active"[8]   out: 1 while a LUT reads TCm's WO[0]
+ *   "tap-tcc"[12]        in: TCCm's WO[x] at 3m + x (INSEL TCC)
+ *   "tap-tcc-active"[12] out: 1 while a LUT reads it
+ *   "tap-ac"[4]          in: comparator m's output (INSEL AC)
+ * Properties "tcc-count" and "ac-count": the TCC instances and comparator
+ * outputs the SoC wired, for LUTn's TCC(n % count) and AC(n % count).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_CCL_H
+#define HW_MISC_MCHP_CCL_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_CCL "mchp-ccl"
+
+#define MCHP_CCL_LUTS 4
+#define MCHP_CCL_TAP_TC 8
+#define MCHP_CCL_TAP_TCC 12
+#define MCHP_CCL_TAP_AC 4
+
+#define MCHP_CCL_TAP_TC_IN "tap-tc"
+#define MCHP_CCL_TAP_TC_ACTIVE "tap-tc-active"
+#define MCHP_CCL_TAP_TCC_IN "tap-tcc"
+#define MCHP_CCL_TAP_TCC_ACTIVE "tap-tcc-active"
+#define MCHP_CCL_TAP_AC_IN "tap-ac"
+
+#endif /* HW_MISC_MCHP_CCL_H */
