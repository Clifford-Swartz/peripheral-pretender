@@ -995,6 +1019,59 @@ static DeviceState *pic32cm_gate(Pic32cmSocState *s, const char *type,
  * follows PORT "pmux-active". A signal on several pads fans out through a
  * split-irq, and their "active" lines are OR-ed.
  */
+/* A CCL input that copies a signal, and its "...-active" line (or NULL) */
+typedef struct Pic32cmTap {
+    qemu_irq in;
+    DeviceState *ccl;
+    const char *active;
+    int line;
+} Pic32cmTap;
+
+/*
+ * The CCL inputs that tap signal @sig of @dev: TCCm WO[0..2] (an instance
+ * with fewer outputs repeats them: TCC2's WO[2] is its WO[0], silicon),
+ * TCm WO[0], the AC's CMPm. The CCL reads them without a pad (silicon:
+ * cclprobe2).
+ */
+static unsigned pic32cm_ccl_taps(Pic32cmSocState *s, const MchpSignalInfo *sig,
+                                 DeviceState *dev, Pic32cmTap *tap)
+{
+    DeviceState *ccl = pic32cm_periph(s, "CCL");
+    unsigned m, n = 0;
+
+    if (!ccl || !object_dynamic_cast(OBJECT(ccl), TYPE_MCHP_CCL) ||
+        !object_dynamic_cast(OBJECT(dev), TYPE_MCHP_REGBLOCK)) {
+        return 0;
+    }
+    if (!strcmp(sig->group, "WO") && sscanf(sig->instance, "TCC%u", &m) == 1 &&
+        m < MCHP_CCL_TAP_TCC / 3) {
+        unsigned nout = MCHP_REGBLOCK(dev)->info->outputs ?: 8;
+
+        for (unsigned x = 0; x < 3; x++) {
+            if (x % nout == sig->index) {
+                tap[n++] = (Pic32cmTap) {
+                    qdev_get_gpio_in_named(ccl, MCHP_CCL_TAP_TCC_IN,
+                                           3 * m + x),
+                    ccl, MCHP_CCL_TAP_TCC_ACTIVE, 3 * m + x,
+                };
+            }
+        }
+    } else if (!strcmp(sig->group, "WO") && sig->index == 0 &&
+               sscanf(sig->instance, "TC%u", &m) == 1 &&
+               m < MCHP_CCL_TAP_TC) {
+        tap[n++] = (Pic32cmTap) {
+            qdev_get_gpio_in_named(ccl, MCHP_CCL_TAP_TC_IN, m),
+            ccl, MCHP_CCL_TAP_TC_ACTIVE, m,
+        };
+    } else if (!strcmp(sig->group, "CMP") && !strcmp(sig->instance, "AC") &&
+               sig->index < MCHP_CCL_TAP_AC) {
+        tap[n++] = (Pic32cmTap) {
+            qdev_get_gpio_in_named(ccl, MCHP_CCL_TAP_AC_IN, sig->index),
+        };
+    }
+    return n;
+}
