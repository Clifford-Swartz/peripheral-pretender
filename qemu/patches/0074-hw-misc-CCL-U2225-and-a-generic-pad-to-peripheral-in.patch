diff --git a/tests/qtest/pic32cm-ccl-test.c b/tests/qtest/pic32cm-ccl-test.c
new file mode 100644
index 0000000..35e977a
--- /dev/null
+++ b/tests/qtest/pic32cm-ccl-test.c
@@ -0,0 +1,171 @@
+/*
+ * QTest for the CCL of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The mchp-ccl model through its lines: the truth table on pad inputs,
+ * the LUTCTRL protection, LINK, the filter's GCLK edges and a clocked
+ * sequencer. firmware/hello APP=ccl checks the same against silicon.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+#define CCL             0x42005C00
+#define CCL_PATH        "/machine/soc/ccl"
+#define GCLK_PCHCTRL    0x40001C80
+#define CCL_GCLK_ID     32
+#define R_CTRL          0x00
+#define R_SEQCTRL(n)    (0x04 + (n))
+#define R_LUTCTRL(n)    (0x08 + 4 * (n))
+#define C_SWRST         0x01
+#define C_ENABLE        0x02
+#define L_ENABLE        BIT(1)
+#define L_SYNCH         (1 << 4)
+#define L_FILTER        (2 << 4)
+#define LINK            2
+#define IO              4
+#define DFF             1
+#define CYCLE_NS        250             /* GCLK0: 4 MHz */
+
+static uint32_t lut(uint32_t in0, uint32_t in1, uint32_t in2, uint32_t truth,
+                    uint32_t extra)
+{
+    return (in0 << 8) | (in1 << 12) | (in2 << 16) | (truth << 24) | extra;
+}
+
+static QTestState *ccl_init(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * CCL_GCLK_ID, 0x40);
+    qtest_irq_intercept_out_named(qts, CCL_PATH, "pad-out");
+    return qts;
+}
+
+static void io(QTestState *qts, int n, int level)
+{
+    qtest_set_irq_in(qts, CCL_PATH, "pad-in-in", n, level);
+}
+
+/* OUTn = TRUTH[IN2 IN1 IN0], IN0 = IN[3n] */
+static void test_truth(void)
+{
+    QTestState *qts = ccl_init();
+
+    qtest_writel(qts, CCL + R_LUTCTRL(1), lut(IO, IO, IO, 0x96, L_ENABLE));
+    qtest_writeb(qts, CCL + R_CTRL, C_ENABLE);
+    for (unsigned v = 0; v < 8; v++) {
+        io(qts, 3, v & 1);
+        io(qts, 4, (v >> 1) & 1);
+        io(qts, 5, (v >> 2) & 1);
+        g_assert_cmpint(qtest_get_irq(qts, 1), ==, (0x96 >> v) & 1);
+    }
+    qtest_quit(qts);
+}
+
+/* LUTCTRL takes its other bits only with the CCL and the LUT off */
+static void test_protection(void)
+{
+    QTestState *qts = ccl_init();
+
+    qtest_writel(qts, CCL + R_LUTCTRL(0), lut(0, 0, 0, 0x11, L_ENABLE));
+    qtest_writel(qts, CCL + R_LUTCTRL(0), lut(0, 0, 0, 0x22, 0));
+    g_assert_cmphex(qtest_readl(qts, CCL + R_LUTCTRL(0)), ==, 0x11000000);
+    qtest_writel(qts, CCL + R_LUTCTRL(0), lut(0, 0, 0, 0x33, L_ENABLE));
+    g_assert_cmphex(qtest_readl(qts, CCL + R_LUTCTRL(0)), ==, 0x33000002);
+    qtest_writeb(qts, CCL + R_CTRL, C_ENABLE);
+    qtest_writel(qts, CCL + R_LUTCTRL(0), lut(0, 0, 0, 0x44, 0));
+    g_assert_cmphex(qtest_readl(qts, CCL + R_LUTCTRL(0)), ==, 0x33000000);
+    qtest_writeb(qts, CCL + R_SEQCTRL(0), 2);
+    g_assert_cmphex(qtest_readb(qts, CCL + R_SEQCTRL(0)), ==, 0);
+    qtest_quit(qts);
+}
+
+/* LINK: LUT3 reads LUT0, LUT0 reads LUT1 */
+static void test_link(void)
+{
+    QTestState *qts = ccl_init();
+
+    qtest_writel(qts, CCL + R_LUTCTRL(1), lut(IO, 0, 0, 0xAA, L_ENABLE));
+    qtest_writel(qts, CCL + R_LUTCTRL(0), lut(LINK, 0, 0, 0xAA, L_ENABLE));
+    qtest_writel(qts, CCL + R_LUTCTRL(3), lut(LINK, 0, 0, 0x55, L_ENABLE));
+    qtest_writeb(qts, CCL + R_CTRL, C_ENABLE);
+    io(qts, 3, 1);
+    g_assert_cmpint(qtest_get_irq(qts, 0), ==, 1);
+    g_assert_cmpint(qtest_get_irq(qts, 3), ==, 0);
+    io(qts, 3, 0);
+    g_assert_cmpint(qtest_get_irq(qts, 0), ==, 0);
+    g_assert_cmpint(qtest_get_irq(qts, 3), ==, 1);
+    qtest_quit(qts);
+}
+
+/* SYNCH passes a change at the second GCLK edge, FILTER at the fourth */
+static void test_filter(void)
+{
+    QTestState *qts = ccl_init();
+
+    qtest_writel(qts, CCL + R_LUTCTRL(1),
+                 lut(IO, 0, 0, 0xAA, L_ENABLE | L_SYNCH));
+    qtest_writel(qts, CCL + R_LUTCTRL(2),
+                 lut(IO, 0, 0, 0xAA, L_ENABLE | L_FILTER));
+    qtest_writeb(qts, CCL + R_CTRL, C_ENABLE);
+    qtest_clock_step(qts, CYCLE_NS / 2);        /* mid-cycle */
+    io(qts, 3, 1);
+    io(qts, 6, 1);
+    qtest_clock_step(qts, CYCLE_NS);            /* first edge passed */
+    g_assert_cmpint(qtest_get_irq(qts, 1), ==, 0);
+    qtest_clock_step(qts, CYCLE_NS);            /* second */
+    g_assert_cmpint(qtest_get_irq(qts, 1), ==, 1);
+    g_assert_cmpint(qtest_get_irq(qts, 2), ==, 0);
+    qtest_clock_step(qts, 2 * CYCLE_NS);        /* fourth */
+    g_assert_cmpint(qtest_get_irq(qts, 2), ==, 1);
+    /* a two-cycle pulse does not pass FILTER */
+    io(qts, 6, 0);
+    qtest_clock_step(qts, 2 * CYCLE_NS);
+    io(qts, 6, 1);
+    qtest_clock_step(qts, 8 * CYCLE_NS);
+    g_assert_cmpint(qtest_get_irq(qts, 2), ==, 1);
+    qtest_quit(qts);
+}
+
+/* DFF: Q takes D at the GCLK edge after G rises; OUT1 stays the odd LUT */
+static void test_dff(void)
+{
+    QTestState *qts = ccl_init();
+
+    qtest_writeb(qts, CCL + R_SEQCTRL(0), DFF);
+    qtest_writel(qts, CCL + R_LUTCTRL(1), lut(IO, 0, 0, 0xAA, L_ENABLE));
+    qtest_writel(qts, CCL + R_LUTCTRL(0), lut(IO, 0, 0, 0xAA, L_ENABLE));
+    qtest_writeb(qts, CCL + R_CTRL, C_ENABLE);
+    qtest_clock_step(qts, CYCLE_NS / 2);
+    io(qts, 0, 1);                              /* D */
+    io(qts, 3, 1);                              /* G */
+    g_assert_cmpint(qtest_get_irq(qts, 0), ==, 0);
+    g_assert_cmpint(qtest_get_irq(qts, 1), ==, 1);
+    qtest_clock_step(qts, CYCLE_NS);
+    g_assert_cmpint(qtest_get_irq(qts, 0), ==, 1);
+    io(qts, 3, 0);                              /* hold */
+    io(qts, 0, 0);
+    qtest_clock_step(qts, 2 * CYCLE_NS);
+    g_assert_cmpint(qtest_get_irq(qts, 0), ==, 1);
+    qtest_writel(qts, CCL + R_LUTCTRL(0), lut(IO, 0, 0, 0xAA, 0));
+    g_assert_cmpint(qtest_get_irq(qts, 0), ==, 0);   /* cleared */
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-ccl/truth", test_truth);
+    qtest_add_func("pic32cm-ccl/protection", test_protection);
+    qtest_add_func("pic32cm-ccl/link", test_link);
+    qtest_add_func("pic32cm-ccl/filter", test_filter);
+    qtest_add_func("pic32cm-ccl/dff", test_dff);
+    return g_test_run();
+}
-- 
