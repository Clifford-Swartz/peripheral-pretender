+/* The CCL's sources: how many TCCs and AC comparator outputs there are */
+static void pic32cm_ccl_counts(Pic32cmSocState *s, DeviceState *ccl)
+{
+    uint32_t ntcc = 0, ncmp = 0;
+
+    for (unsigned i = 0; i < s->dev->ninstances; i++) {
+        ntcc += !strcmp(s->dev->instances[i].module, "TCC");
+    }
+    for (unsigned i = 0; i < s->dev->nsignals; i++) {
+        const MchpSignalInfo *sig = &s->dev->signals[i];
+
+        if (!strcmp(sig->instance, "AC") && !strcmp(sig->group, "CMP") &&
+            sig->index >= 0) {
+            ncmp = MAX(ncmp, (uint32_t)sig->index + 1);
+        }
+    }
+    qdev_prop_set_uint32(ccl, "tcc-count", ntcc);
+    qdev_prop_set_uint32(ccl, "ac-count", ncmp);
+}
