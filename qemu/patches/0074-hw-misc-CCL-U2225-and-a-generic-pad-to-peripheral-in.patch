@@ -1201,6 +1348,7 @@ static void pic32cm_soc_realize(DeviceState *dev, Error **errp)
     pic32cm_connect_events(s);
     pic32cm_dmac_pulses(s);
     pic32cm_connect_pads(s);
+    pic32cm_connect_pad_inputs(s);
     pic32cm_analog_pads(s);
     s->armv7m.cpu->sleep_hook = pic32cm_sleep;
     s->armv7m.cpu->sleep_opaque = s;
