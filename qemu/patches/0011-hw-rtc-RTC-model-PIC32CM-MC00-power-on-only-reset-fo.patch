diff --git a/hw/rtc/mchp_rtc.c b/hw/rtc/mchp_rtc.c
new file mode 100644
index 0000000..491b82c
--- /dev/null
+++ b/hw/rtc/mchp_rtc.c
@@ -0,0 +1,566 @@
+/*
+ * Microchip SAM/PIC32CM Real-Time Counter (RTC U2250, PIC32CM MC00)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Follows DS60001638E chapter 23. The "gclk" input carries CLK_RTC_OSC
+ * (OSC32KCTRL.RTCCTRL). A 10-bit prescaler divides it by 2^(PRESCALER-1)
+ * into the counter (PRESCALER 0: off); its bits 2-9 rising set PER0-7.
+ *   MODE0  32-bit COUNT, COMP0, MATCHCLR
+ *   MODE1  16-bit COUNT wrapping at PER, COMP0/1
+ *   MODE2  CLOCK (seconds .. year 0-63, leap years every 4) with ALARM0,
+ *          MASK0.SEL and MATCHCLR; 24-hour format only
+ * Compare and alarm flags are set on the counter tick after the match, as
+ * is the clearing by MATCHCLR (which also sets OVF). COUNT/CLOCK reads are
+ * current only with CTRLA.COUNTSYNC/CLOCKSYNC; otherwise they show the
+ * last synchronized value. Only power-on resets the RTC: it keeps counting
+ * across system resets (silicon). Synchronized writes without CLK_RTC_OSC keep
+ * their SYNCBUSY bits until it runs. Not modelled: FREQCORR, CLKREP (12-hour
+ * format), event outputs to the event system, tamper.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/clock.h"
+#include "hw/core/irq.h"
+#include "hw/rtc/mchp_rtc.h"
+#include "hw/mchp/gen/rtc_u2250.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+/* Offsets and the shared fields are the same in the three modes */
+#define A_CTRLA         A_MCHP_RTC_MODE0_CTRLA
+#define A_EVCTRL        A_MCHP_RTC_MODE0_EVCTRL
+#define A_INTFLAG       A_MCHP_RTC_MODE0_INTFLAG
+#define A_SYNCBUSY      A_MCHP_RTC_MODE0_SYNCBUSY
+#define A_COUNT         A_MCHP_RTC_MODE0_COUNT      /* CLOCK in MODE2 */
+#define A_PER           A_MCHP_RTC_MODE1_PER
+#define A_COMP          A_MCHP_RTC_MODE0_COMP       /* ALARM in MODE2 */
+#define A_MASK          A_MCHP_RTC_MODE2_MASK
+#define A_FREQCORR      A_MCHP_RTC_MODE0_FREQCORR
+
+#define MODE0           0
+#define MODE1           1
+#define MODE2           2
+
+#define FLAG_CMP0       R_MCHP_RTC_MODE1_INTFLAG_CMP0_MASK  /* ALARM0 */
+#define FLAG_OVF        R_MCHP_RTC_MODE0_INTFLAG_OVF_MASK
+#define CTRLA_ENABLE    R_MCHP_RTC_MODE0_CTRLA_ENABLE_MASK
+#define CTRLA_SWRST     R_MCHP_RTC_MODE0_CTRLA_SWRST_MASK
+#define CTRLA_MATCHCLR  R_MCHP_RTC_MODE0_CTRLA_MATCHCLR_MASK
+#define CTRLA_COUNTSYNC R_MCHP_RTC_MODE0_CTRLA_COUNTSYNC_MASK
+
+/* MODE2: year values 0-63 of a leap-year reference */
+#define RTC_YEARS       64
+#define SECS_PER_DAY    86400ULL
+
+#define MCHP_RTC_MAX_STEPS 64
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpRtcState, MCHP_RTC)
+
+struct MchpRtcState {
+    MchpRegBlock parent_obj;
+
+    QEMUTimer *timer;
+    bool running;
+    uint64_t value;             /* counter (MODE0/1) or seconds (MODE2) */
+    uint64_t osc;               /* CLK_RTC_OSC ticks since enable at t_base */
+    int64_t t_base;
+    uint32_t sync_pending;
+};
+
+static uint32_t rtc_reg(MchpRtcState *s, hwaddr offset, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, offset, size);
+}
+
+static void rtc_set_reg(MchpRtcState *s, hwaddr offset, unsigned size,
+                        uint32_t val)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, offset, size, val);
+}
+
+static unsigned rtc_mode(MchpRtcState *s)
+{
+    return FIELD_EX32(rtc_reg(s, A_CTRLA, 2), MCHP_RTC_MODE0_CTRLA, MODE);
+}
+
+static unsigned rtc_prescaler(MchpRtcState *s)
+{
+    return FIELD_EX32(rtc_reg(s, A_CTRLA, 2), MCHP_RTC_MODE0_CTRLA, PRESCALER);
+}
+
+static Clock *rtc_clk(MchpRtcState *s)
+{
+    return MCHP_REGBLOCK(s)->gclk;
+}
+
+/* -- MODE2 calendar ------------------------------------------------------ */
+
+static unsigned rtc_days_in_month(unsigned year, unsigned month)
+{
+    static const uint8_t days[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31,
+                                    30, 31 };
+
+    return month == 2 && year % 4 == 0 ? 29 : days[month - 1];
+}
+
+/* CLOCK -> seconds since year 0, January 1st, 00:00:00 */
+static uint64_t rtc_clock_to_secs(uint32_t clock)
+{
+    unsigned year = FIELD_EX32(clock, MCHP_RTC_MODE2_CLOCK, YEAR);
+    unsigned month = MAX(1, MIN(12, FIELD_EX32(clock, MCHP_RTC_MODE2_CLOCK,
+                                               MONTH)));
+    unsigned day = MAX(1, FIELD_EX32(clock, MCHP_RTC_MODE2_CLOCK, DAY));
+    uint64_t days = 0;
+
+    for (unsigned y = 0; y < year; y++) {
+        days += y % 4 == 0 ? 366 : 365;
+    }
+    for (unsigned m = 1; m < month; m++) {
+        days += rtc_days_in_month(year, m);
+    }
+    days += day - 1;
+    return days * SECS_PER_DAY +
+           FIELD_EX32(clock, MCHP_RTC_MODE2_CLOCK, HOUR) * 3600 +
+           FIELD_EX32(clock, MCHP_RTC_MODE2_CLOCK, MINUTE) * 60 +
+           FIELD_EX32(clock, MCHP_RTC_MODE2_CLOCK, SECOND);
+}
+
+static uint32_t rtc_secs_to_clock(uint64_t secs)
+{
+    uint64_t days = secs / SECS_PER_DAY, sod = secs % SECS_PER_DAY;
+    unsigned year = 0, month = 1;
+    uint32_t clock = 0;
+
+    while (days >= (year % 4 == 0 ? 366U : 365U)) {
+        days -= year % 4 == 0 ? 366 : 365;
+        year++;
+    }
+    while (days >= rtc_days_in_month(year, month)) {
+        days -= rtc_days_in_month(year, month);
+        month++;
+    }
+    clock = FIELD_DP32(clock, MCHP_RTC_MODE2_CLOCK, YEAR, year);
+    clock = FIELD_DP32(clock, MCHP_RTC_MODE2_CLOCK, MONTH, month);
+    clock = FIELD_DP32(clock, MCHP_RTC_MODE2_CLOCK, DAY, days + 1);
+    clock = FIELD_DP32(clock, MCHP_RTC_MODE2_CLOCK, HOUR, sod / 3600);
+    clock = FIELD_DP32(clock, MCHP_RTC_MODE2_CLOCK, MINUTE, sod / 60 % 60);
+    return FIELD_DP32(clock, MCHP_RTC_MODE2_CLOCK, SECOND, sod % 60);
+}
+
+/* Seconds from year 0 up to and including 23:59:59 December 31st, 63 */
+static uint64_t rtc_secs_span(void)
+{
+    uint32_t last = 0;
+
+    last = FIELD_DP32(last, MCHP_RTC_MODE2_CLOCK, YEAR, RTC_YEARS - 1);
+    last = FIELD_DP32(last, MCHP_RTC_MODE2_CLOCK, MONTH, 12);
+    last = FIELD_DP32(last, MCHP_RTC_MODE2_CLOCK, DAY, 31);
+    return rtc_clock_to_secs(last) + SECS_PER_DAY;
+}
+
+static bool rtc_alarm_match(MchpRtcState *s, uint64_t secs);
+
+/* Seconds from @v to the next second (>= v) matching the alarm, or -1 */
+static int64_t rtc_alarm_distance(MchpRtcState *s, uint64_t v)
+{
+    static const uint64_t period[] = { 0, 60, 3600, SECS_PER_DAY };
+    unsigned sel = FIELD_EX32(rtc_reg(s, A_MASK, 1), MCHP_RTC_MODE2_MASK, SEL);
+    uint32_t alarm = rtc_reg(s, A_COMP, 4);
+    uint64_t tod = FIELD_EX32(alarm, MCHP_RTC_MODE2_CLOCK, HOUR) * 3600 +
+                   FIELD_EX32(alarm, MCHP_RTC_MODE2_CLOCK, MINUTE) * 60 +
+                   FIELD_EX32(alarm, MCHP_RTC_MODE2_CLOCK, SECOND);
+
+    if (sel == 0 || sel > 6) {
+        return -1;
+    }
+    if (sel <= 3) {
+        /* Seconds, minutes:seconds or the time of day: periodic */
+        uint64_t p = period[sel], want = tod % p;
+
+        return (want + p - v % p) % p;
+    }
+    /* A date part too: the alarm's time of day on a matching day */
+    for (uint64_t day = v / SECS_PER_DAY, k = 0; k <= 4 * 366; k++) {
+        uint64_t t = (day + k) * SECS_PER_DAY + tod;
+
+        if (t >= v && rtc_alarm_match(s, t)) {
+            return t - v;
+        }
+    }
+    return -1;
+}
+
+/* Does second @secs match ALARM0 under MASK0.SEL? */
+static bool rtc_alarm_match(MchpRtcState *s, uint64_t secs)
+{
+    static const uint32_t sel_mask[] = {
+        0, 0x0000003F, 0x00000FFF, 0x0001FFFF, 0x003FFFFF, 0x03FFFFFF,
+        0xFFFFFFFF,
+    };
+    unsigned sel = FIELD_EX32(rtc_reg(s, A_MASK, 1), MCHP_RTC_MODE2_MASK, SEL);
+    uint32_t m = sel < ARRAY_SIZE(sel_mask) ? sel_mask[sel] : 0;
+
+    return m && ((rtc_secs_to_clock(secs) ^ rtc_reg(s, A_COMP, 4)) & m) == 0;
+}
+
+/* -- counting ------------------------------------------------------------- */
+
+static uint64_t rtc_top(MchpRtcState *s)
+{
+    switch (rtc_mode(s)) {
+    case MODE1:
+        return s->value > rtc_reg(s, A_PER, 2) ? 0xFFFF : rtc_reg(s, A_PER, 2);
+    case MODE2:
+        return rtc_secs_span() - 1;
+    default:
+        return 0xFFFFFFFFULL;
+    }
+}
+
+/*
+ * Counter ticks until the next flagging tick (the tick after a match, or
+ * a wrap), and which flags it sets; 0 when no tick flags anything soon.
+ */
+static uint64_t rtc_next_count_event(MchpRtcState *s, uint32_t *flags)
+{
+    uint64_t top = rtc_top(s), v = s->value, best = top - v + 1;
+    unsigned mode = rtc_mode(s);
+
+    *flags = FLAG_OVF;
+    if (mode == MODE2) {
+        int64_t d = rtc_alarm_distance(s, v);
+
+        if (d >= 0 && (uint64_t)d + 1 <= best) {
+            *flags = (uint64_t)d + 1 == best ? FLAG_CMP0 | FLAG_OVF : FLAG_CMP0;
+            best = d + 1;
+        }
+        return best;
+    }
+    for (unsigned ch = 0; ch < (mode == MODE1 ? 2U : 1U); ch++) {
+        unsigned size = mode == MODE1 ? 2 : 4;
+        uint64_t cmp = rtc_reg(s, A_COMP + ch * size, size), n;
+
+        if (cmp < v || cmp > top) {
+            continue;           /* reached only after a wrap: skip */
+        }
+        n = cmp - v + 1;
+        if (n < best) {
+            best = n;
+            *flags = FLAG_CMP0 << ch;
+        } else if (n == best) {
+            *flags |= FLAG_CMP0 << ch;
+        }
+    }
+    return best;
+}
+
+/* The flagging counter tick: apply @flags and move the counter */
+static void rtc_count_event(MchpRtcState *s, uint32_t flags)
+{
+    bool matchclr = rtc_mode(s) != MODE1 &&
+                    (rtc_reg(s, A_CTRLA, 2) & CTRLA_MATCHCLR);
+
+    if ((flags & FLAG_CMP0) && matchclr) {
+        flags |= FLAG_OVF;
+        s->value = 0;
+    } else if (flags & FLAG_OVF) {
+        s->value = 0;
+    } else {
+        s->value++;
+    }
+    trace_mchp_rtc_event(s->value, flags);
+    rtc_set_reg(s, A_INTFLAG, 2, rtc_reg(s, A_INTFLAG, 2) | flags);
+}
+
+/* The counter after @n plain ticks (no flagging tick among them) */
+static uint64_t rtc_plain(MchpRtcState *s, uint64_t n)
+{
+    uint64_t top = rtc_top(s);
+
+    /* Quiet jumps may wrap: the counter is periodic over 0..TOP, or over
+     * 0..COMP0 when MODE0 clears on match */
+    if (rtc_mode(s) == MODE0 && (rtc_reg(s, A_CTRLA, 2) & CTRLA_MATCHCLR) &&
+        s->value <= rtc_reg(s, A_COMP, 4)) {
+        top = rtc_reg(s, A_COMP, 4);
+    }
+    if (s->value + n <= top) {
+        return s->value + n;
+    }
+    return (s->value + n - top - 1) % (top + 1);
+}
+
+/* OSC tick of the next rising edge of prescaler bit @bit after @osc */
+static uint64_t rtc_next_edge(uint64_t osc, unsigned bit)
+{
+    uint64_t period = 2ULL << bit, phase = 1ULL << bit;
+    uint64_t base = osc - osc % period + phase;
+
+    return base > osc ? base : base + period;
+}
+
+/*
+ * Earliest OSC tick of a PER edge whose flag is clear or whose event is
+ * enabled (*per: the flags it sets), or UINT64_MAX.
+ */
+static uint64_t rtc_next_per(MchpRtcState *s, uint64_t osc, uint32_t *per)
+{
+    uint32_t flags = rtc_reg(s, A_INTFLAG, 2), ev = rtc_reg(s, A_EVCTRL, 4);
+    uint64_t best = UINT64_MAX;
+
+    *per = 0;
+    if (!rtc_prescaler(s)) {
+        return best;            /* no periodic events (DS 23.5.8.1) */
+    }
+    for (unsigned n = 0; n < 8; n++) {
+        uint64_t e;
+
+        if ((flags & BIT(n)) && !(ev & BIT(n))) {
+            continue;
+        }
+        e = rtc_next_edge(osc, n + 2);
+        if (e < best) {
+            best = e;
+        }
+    }
+    for (unsigned n = 0; n < 8 && best != UINT64_MAX; n++) {
+        if (best % (2ULL << (n + 2)) == (1ULL << (n + 2))) {
+            *per |= BIT(n);
+        }
+    }
+    return best;
+}
+
+static uint64_t rtc_osc_at(MchpRtcState *s, int64_t now)
+{
+    return s->osc + clock_ns_to_ticks(rtc_clk(s), MAX(0, now - s->t_base));
+}
+
+static int64_t rtc_time_of(MchpRtcState *s, uint64_t osc)
+{
+    return s->t_base + clock_ticks_to_ns(rtc_clk(s), osc - s->osc) + 1;
+}
+
+/* Bring the RTC up to @now and schedule the next event that matters */
+static void rtc_advance(MchpRtcState *s, int64_t now)
+{
+    unsigned presc = rtc_prescaler(s);
+
+    for (unsigned steps = 0;; steps++) {
+        uint64_t osc, div, cnt_e = UINT64_MAX, per_e, e, ticks;
+        uint32_t cflags = 0, pflags;
+        bool flagging;
+
+        if (!s->running || !clock_get_hz(rtc_clk(s))) {
+            s->t_base = now;
+            break;
+        }
+        osc = rtc_osc_at(s, now);
+        div = presc ? 1ULL << (presc - 1) : 0;
+        if (div) {
+            uint64_t n = rtc_next_count_event(s, &cflags);
+
+            cnt_e = (s->osc / div + n) * div;
+        }
+        per_e = rtc_next_per(s, s->osc, &pflags);
+        /* A counter event changes something unless its flags are set */
+        flagging = (cflags & ~rtc_reg(s, A_INTFLAG, 2)) ||
+                   (rtc_reg(s, A_EVCTRL, 4) & 0x8300) ||
+                   ((cflags & FLAG_CMP0) &&
+                    (rtc_reg(s, A_CTRLA, 2) & CTRLA_MATCHCLR) &&
+                    rtc_mode(s) == MODE2);
+        e = MIN(flagging ? cnt_e : UINT64_MAX, per_e);
+        if (e == UINT64_MAX || steps >= MCHP_RTC_MAX_STEPS) {
+            ticks = div ? osc / div - s->osc / div : 0;
+            s->value = rtc_plain(s, ticks);
+            s->t_base += clock_ticks_to_ns(rtc_clk(s), osc - s->osc);
+            s->osc = osc;
+            timer_del(s->timer);
+            break;
+        }
+        if (e > osc) {
+            /* Bring the counter up to now (no event on the way), then wait */
+            ticks = div ? osc / div - s->osc / div : 0;
+            s->value = rtc_plain(s, ticks);
+            s->t_base += clock_ticks_to_ns(rtc_clk(s), osc - s->osc);
+            s->osc = osc;
+            timer_mod(s->timer, rtc_time_of(s, e));
+            break;
+        }
+        /* Plain counter ticks before e, then the event itself */
+        ticks = div ? e / div - s->osc / div : 0;
+        if (flagging && e == cnt_e) {
+            s->value = rtc_plain(s, ticks - 1);
+            rtc_count_event(s, cflags);
+        } else {
+            s->value = rtc_plain(s, ticks);
+        }
+        if (e == per_e) {
+            rtc_set_reg(s, A_INTFLAG, 2, rtc_reg(s, A_INTFLAG, 2) | pflags);
+        }
+        s->t_base = rtc_time_of(s, e) - 1;
+        s->osc = e;
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void rtc_tick(void *opaque)
+{
+    MchpRtcState *s = opaque;
+
+    rtc_advance(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+}
+
+/* COUNT/CLOCK register image of the current value */
+static uint32_t rtc_image(MchpRtcState *s)
+{
+    return rtc_mode(s) == MODE2 ? rtc_secs_to_clock(s->value) : s->value;
+}
+
+static uint32_t rtc_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                             unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpRtcState *s = MCHP_RTC(rf->opaque);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (side_effects) {
+        rtc_advance(s, now);
+    }
+    switch (ri->offset) {
+    case A_COUNT:
+        /* Valid only with read synchronization on (DS 23.5.2.3) */
+        if (rtc_reg(s, A_CTRLA, 2) & CTRLA_COUNTSYNC) {
+            rtc_set_reg(s, A_COUNT, ri->size, rtc_image(s));
+        }
+        return rtc_reg(s, A_COUNT, ri->size);
+    case A_SYNCBUSY:
+        if (clock_get_hz(rtc_clk(s))) {
+            s->sync_pending = 0;
+        }
+        return s->sync_pending;
+    default:
+        return stored;
+    }
+}
+
+static void rtc_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                           unsigned idx, uint32_t old, uint32_t written,
+                           uint32_t we)
+{
+    MchpRtcState *s = MCHP_RTC(rf->opaque);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint32_t val = mchp_regfile_get(rf, ri, idx);
+
+    if (ri->syncbusy && !clock_get_hz(rtc_clk(s))) {
+        s->sync_pending |= ri->offset == A_CTRLA ?
+                           written & we & ri->syncbusy :
+                           ri->syncbusy << (ri->count > 1 ? idx : 0);
+    }
+    switch (ri->offset) {
+    case A_CTRLA:
+        if (written & we & CTRLA_SWRST) {
+            return;             /* mchp-regblock resets the RTC next */
+        }
+        if (val & ~old & CTRLA_ENABLE) {
+            if (rtc_reg(s, A_CTRLA, 2) & 0x0040) {
+                qemu_log_mask(LOG_UNIMP, "%s.CTRLA: 12-hour clock not "
+                              "modelled\n", MCHP_REGBLOCK(s)->name);
+            }
+            s->running = true;
+            s->osc = 0;         /* the prescaler starts with the RTC */
+            s->t_base = now;
+        } else if (old & ~val & CTRLA_ENABLE) {
+            rtc_advance(s, now);
+            s->running = false;
+        }
+        break;
+    case A_COUNT:
+        rtc_advance(s, now);
+        s->value = rtc_mode(s) == MODE2 ? rtc_clock_to_secs(val) : val;
+        break;
+    case A_FREQCORR:
+        if (val) {
+            qemu_log_mask(LOG_UNIMP, "%s.FREQCORR: correction not "
+                          "modelled\n", MCHP_REGBLOCK(s)->name);
+        }
+        break;
+    }
+    rtc_advance(s, now);
+}
+
+static void rtc_gclk_update(MchpRegBlock *rb, ClockEvent event)
+{
+    rtc_advance(MCHP_RTC(rb), qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+}
+
+static void rtc_reset_hold(MchpRegBlock *rb)
+{
+    MchpRtcState *s = MCHP_RTC(rb);
+
+    timer_del(s->timer);
+    s->running = false;
+    s->value = 0;
+    s->osc = 0;
+    s->sync_pending = 0;
+}
+
+static bool rtc_realize(MchpRegBlock *rb, Error **errp)
+{
+    MchpRtcState *s = MCHP_RTC(rb);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rtc_tick, s);
+    return true;
+}
+
+static void rtc_finalize(Object *obj)
+{
+    timer_free(MCHP_RTC(obj)->timer);
+}
+
+static const VMStateDescription vmstate_mchp_rtc = {
+    .name = TYPE_MCHP_RTC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpRtcState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_TIMER_PTR(timer, MchpRtcState),
+        VMSTATE_BOOL(running, MchpRtcState),
+        VMSTATE_UINT64(value, MchpRtcState),
+        VMSTATE_UINT64(osc, MchpRtcState),
+        VMSTATE_INT64(t_base, MchpRtcState),
+        VMSTATE_UINT32(sync_pending, MchpRtcState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void rtc_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_rtc;
+    c->realize = rtc_realize;
+    c->pre_read = rtc_pre_read;
+    c->post_write = rtc_post_write;
+    c->reset_hold = rtc_reset_hold;
+    c->gclk_update = rtc_gclk_update;
+    c->por_only = true;         /* keeps running across system resets */
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_rtc_types[] = {
+    {
+        .name = TYPE_MCHP_RTC,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpRtcState),
+        .instance_finalize = rtc_finalize,
+        .class_init = rtc_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_rtc_types)
