diff --git a/hw/misc/mchp_clock.c b/hw/misc/mchp_clock.c
index 2d3e98a..8357342 100644
--- a/hw/misc/mchp_clock.c
+++ b/hw/misc/mchp_clock.c
@@ -325,6 +325,7 @@ struct MchpOsc32kctrlState {
     Clock *xosc32k;
     Clock *osc32k;
     Clock *osculp32k;
+    Clock *rtc;                 /* CLK_RTC_OSC, selected by RTCCTRL.RTCSEL */
 
     uint32_t status;            /* STATUS when last updated, for flag edges */
