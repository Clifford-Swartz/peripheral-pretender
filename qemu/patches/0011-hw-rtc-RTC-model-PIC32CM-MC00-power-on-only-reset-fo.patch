diff --git a/tests/qtest/pic32cm-rtc-test.c b/tests/qtest/pic32cm-rtc-test.c
new file mode 100644
index 0000000..85c6540
--- /dev/null
+++ b/tests/qtest/pic32cm-rtc-test.c
@@ -0,0 +1,207 @@
+/*
+ * QTest for the RTC of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * CLK_RTC_OSC is ULP1K (1024 Hz) out of reset; virtual time is stepped
+ * explicitly. Expected behaviour from DS60001638E chapter 23 and from
+ * PIC32CM MC00 silicon (power-on-only reset, the clock rule of
+ * synchronization).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro "
+
+#define OSC32KCTRL      0x40001400
+#define RTC             0x40002400
+#define NVIC_ISPR       0xE000E200
+
+#define R_CTRLA         0x00
+#define R_INTENSET      0x0A
+#define R_INTFLAG       0x0C
+#define R_SYNCBUSY      0x10
+#define R_COUNT         0x18
+#define R_PER           0x1C
+#define R_COMP          0x20
+#define R_MASK          0x24
+
+#define ENABLE          0x0002
+#define MODE1           (1 << 2)
+#define MODE2           (2 << 2)
+#define MATCHCLR        0x0080
+#define DIV(n)          ((n) << 8)      /* 1: /1 ... 11: /1024 */
+#define COUNTSYNC       0x8000
+
+#define F_CMP0          0x0100
+#define F_CMP1          0x0200
+#define F_OVF           0x8000
+
+#define SEC_NS          1000000000LL
+#define TICK_NS         (SEC_NS / 1024)
+#define RTC_IRQ         2
+
+static uint32_t clock_value(unsigned y, unsigned mo, unsigned d, unsigned h,
+                            unsigned mi, unsigned s)
+{
+    return y << 26 | mo << 22 | d << 17 | h << 12 | mi << 6 | s;
+}
+
+static void test_mode0_rate(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writew(qts, RTC + R_CTRLA, DIV(1) | COUNTSYNC);
+    qtest_writew(qts, RTC + R_CTRLA, DIV(1) | COUNTSYNC | ENABLE);
+    qtest_clock_step(qts, SEC_NS);
+    g_assert_cmpuint(qtest_readl(qts, RTC + R_COUNT), ==, 1024);
+    qtest_clock_step(qts, SEC_NS / 2);
+    g_assert_cmpuint(qtest_readl(qts, RTC + R_COUNT), ==, 1536);
+    qtest_quit(qts);
+
+    /* DIV1024: one count per second */
+    qts = qtest_init(MACHINE);
+    qtest_writew(qts, RTC + R_CTRLA, DIV(11) | COUNTSYNC | ENABLE);
+    qtest_clock_step(qts, 5 * SEC_NS + SEC_NS / 2);
+    g_assert_cmpuint(qtest_readl(qts, RTC + R_COUNT), ==, 5);
+    qtest_quit(qts);
+}
+
+/* PERn every 2^(n+3) cycles: PER0 at 128 Hz, PER7 at 1 Hz */
+static void test_periodic(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writew(qts, RTC + R_CTRLA, DIV(1) | ENABLE);
+    qtest_clock_step(qts, 5 * TICK_NS);
+    g_assert_cmphex(qtest_readw(qts, RTC + R_INTFLAG) & 0xFF, ==, 0x01);  /* @4 */
+    qtest_clock_step(qts, 4 * TICK_NS);
+    g_assert_cmphex(qtest_readw(qts, RTC + R_INTFLAG) & 0xFF, ==, 0x03);  /* @8 */
+    qtest_clock_step(qts, SEC_NS);
+    g_assert_cmphex(qtest_readw(qts, RTC + R_INTFLAG) & 0xFF, ==, 0xFF);
+    qtest_quit(qts);
+}
+
+/* Flags on the tick after the match; MATCHCLR also sets OVF */
+static void test_compare(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, RTC + R_COMP, 10);
+    qtest_writew(qts, RTC + R_CTRLA, DIV(1) | MATCHCLR | COUNTSYNC | ENABLE);
+    qtest_clock_step(qts, 10 * TICK_NS + TICK_NS / 2);
+    g_assert_cmphex(qtest_readw(qts, RTC + R_INTFLAG) & F_CMP0, ==, 0);
+    qtest_clock_step(qts, TICK_NS);
+    g_assert_cmphex(qtest_readw(qts, RTC + R_INTFLAG) & (F_CMP0 | F_OVF), ==,
+                    F_CMP0 | F_OVF);
+    g_assert_cmpuint(qtest_readl(qts, RTC + R_COUNT), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_mode1(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writew(qts, RTC + R_CTRLA, MODE1 | DIV(1));
+    qtest_writew(qts, RTC + R_PER, 50);
+    qtest_writew(qts, RTC + R_COMP, 10);
+    qtest_writew(qts, RTC + R_COMP + 2, 60);              /* above PER */
+    qtest_writew(qts, RTC + R_CTRLA, MODE1 | DIV(1) | ENABLE);
+    qtest_clock_step(qts, 51 * TICK_NS + TICK_NS / 2);
+    g_assert_cmphex(qtest_readw(qts, RTC + R_INTFLAG) & 0xFF00, ==,
+                    F_CMP0 | F_OVF);
+    qtest_quit(qts);
+}
+
+static void test_calendar(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writew(qts, RTC + R_CTRLA, MODE2 | DIV(11) | COUNTSYNC);
+    qtest_writel(qts, RTC + R_COUNT, clock_value(0, 2, 28, 23, 59, 58));
+    qtest_writel(qts, RTC + R_COMP, clock_value(0, 0, 0, 0, 0, 3));
+    qtest_writeb(qts, RTC + R_MASK, 3);                   /* HH:MM:SS */
+    qtest_writew(qts, RTC + R_CTRLA, MODE2 | DIV(11) | COUNTSYNC | ENABLE);
+    qtest_clock_step(qts, 2 * SEC_NS + SEC_NS / 2);
+    g_assert_cmphex(qtest_readl(qts, RTC + R_COUNT), ==,
+                    clock_value(0, 2, 29, 0, 0, 0));      /* leap year */
+    qtest_clock_step(qts, 3 * SEC_NS);
+    g_assert_cmphex(qtest_readw(qts, RTC + R_INTFLAG) & F_CMP0, ==, 0);
+    qtest_clock_step(qts, SEC_NS);                        /* tick after */
+    g_assert_cmphex(qtest_readw(qts, RTC + R_INTFLAG) & F_CMP0, ==, F_CMP0);
+    qtest_quit(qts);
+
+    qts = qtest_init(MACHINE);
+    qtest_writew(qts, RTC + R_CTRLA, MODE2 | DIV(11) | COUNTSYNC);
+    qtest_writel(qts, RTC + R_COUNT, clock_value(1, 2, 28, 23, 59, 59));
+    qtest_writew(qts, RTC + R_CTRLA, MODE2 | DIV(11) | COUNTSYNC | ENABLE);
+    qtest_clock_step(qts, SEC_NS + SEC_NS / 2);
+    g_assert_cmphex(qtest_readl(qts, RTC + R_COUNT), ==,
+                    clock_value(1, 3, 1, 0, 0, 0));
+    qtest_quit(qts);
+}
+
+static void test_irq(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, RTC + R_COMP, 4);
+    qtest_writew(qts, RTC + R_INTENSET, F_CMP0);
+    qtest_writew(qts, RTC + R_CTRLA, DIV(1) | ENABLE);
+    g_assert_false(qtest_readl(qts, NVIC_ISPR) & BIT(RTC_IRQ));
+    qtest_clock_step(qts, 6 * TICK_NS);
+    g_assert_true(qtest_readl(qts, NVIC_ISPR) & BIT(RTC_IRQ));
+    qtest_quit(qts);
+}
+
+/* Only power-on resets the RTC; it keeps counting across system resets */
+static void test_reset(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    QDict *rsp;
+
+    qtest_writew(qts, RTC + R_CTRLA, DIV(1) | COUNTSYNC | ENABLE);
+    qtest_clock_step(qts, SEC_NS);
+    rsp = qtest_qmp(qts, "{ 'execute': 'system_reset' }");
+    qobject_unref(rsp);
+    qtest_clock_step(qts, SEC_NS);
+    g_assert_cmphex(qtest_readw(qts, RTC + R_CTRLA), ==,
+                    DIV(1) | COUNTSYNC | ENABLE);
+    g_assert_cmpuint(qtest_readl(qts, RTC + R_COUNT), >=, 2048);
+    qtest_quit(qts);
+}
+
+/* CLK_RTC_OSC off (OSC1K, OSC32K disabled): ENABLE stays in SYNCBUSY */
+static void test_noclock(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, OSC32KCTRL + 0x10, 2);                /* OSC1K */
+    qtest_writew(qts, RTC + R_CTRLA, DIV(1) | ENABLE);
+    g_assert_cmphex(qtest_readl(qts, RTC + R_SYNCBUSY), ==, 0x2);
+    qtest_writel(qts, OSC32KCTRL + 0x10, 0);                /* ULP1K */
+    g_assert_cmphex(qtest_readl(qts, RTC + R_SYNCBUSY), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-rtc/mode0-rate", test_mode0_rate);
+    qtest_add_func("pic32cm-rtc/periodic", test_periodic);
+    qtest_add_func("pic32cm-rtc/compare", test_compare);
+    qtest_add_func("pic32cm-rtc/mode1", test_mode1);
+    qtest_add_func("pic32cm-rtc/calendar", test_calendar);
+    qtest_add_func("pic32cm-rtc/irq", test_irq);
+    qtest_add_func("pic32cm-rtc/reset", test_reset);
+    qtest_add_func("pic32cm-rtc/noclock", test_noclock);
+
+    return g_test_run();
+}
