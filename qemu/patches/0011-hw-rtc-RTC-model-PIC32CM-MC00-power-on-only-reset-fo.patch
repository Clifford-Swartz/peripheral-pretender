@@ -350,6 +351,51 @@ static uint32_t mchp_osc32kctrl_status(MchpOsc32kctrlState *s)
     return status;
 }
 
+/*
+ * CLK_RTC_OSC (DS 16.6.6): the 1.024 kHz or 32.768 kHz output RTCCTRL
+ * selects, each needing its oscillator ready and its EN1K/EN32K bit
+ * (the JH01 OSCULP32K has no enable bits: its outputs always run).
+ */
+static uint64_t mchp_osc32kctrl_rtc_hz(MchpOsc32kctrlState *s,
+                                       uint32_t status)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ulp = mchp_clk_reg(rb, A_MCHP_OSC32KCTRL_OSCULP32K, 4);
+    uint32_t osc = mchp_clk_reg(rb, A_MCHP_OSC32KCTRL_OSC32K, 4);
+    uint32_t xosc = mchp_clk_reg(rb, A_MCHP_OSC32KCTRL_XOSC32K, 2);
+    bool ulp_gated = (ulp & (R_MCHP_OSC32KCTRL_OSCULP32K_EN1K_MASK |
+                             R_MCHP_OSC32KCTRL_OSCULP32K_EN32K_MASK)) != 0;
+    bool osc_on = status & R_MCHP_OSC32KCTRL_STATUS_OSC32KRDY_MASK;
+    bool xosc_on = status & R_MCHP_OSC32KCTRL_STATUS_XOSC32KRDY_MASK;
+    uint64_t xhz = clock_get_hz(s->xtal32k);
+
+    switch (FIELD_EX32(mchp_clk_reg(rb, A_MCHP_OSC32KCTRL_RTCCTRL, 4),
+                       MCHP_OSC32KCTRL_RTCCTRL, RTCSEL)) {
+    case MCHP_OSC32KCTRL_RTCCTRL_RTCSEL_ULP1K:
+        return !ulp_gated ||
+               FIELD_EX32(ulp, MCHP_OSC32KCTRL_OSCULP32K, EN1K) ?
+               MCHP_OSC32K_HZ / 32 : 0;
+    case MCHP_OSC32KCTRL_RTCCTRL_RTCSEL_ULP32K:
+        return !ulp_gated ||
+               FIELD_EX32(ulp, MCHP_OSC32KCTRL_OSCULP32K, EN32K) ?
+               MCHP_OSC32K_HZ : 0;
+    case MCHP_OSC32KCTRL_RTCCTRL_RTCSEL_OSC1K:
+        return osc_on && FIELD_EX32(osc, MCHP_OSC32KCTRL_OSC32K, EN1K) ?
+               MCHP_OSC32K_HZ / 32 : 0;
+    case MCHP_OSC32KCTRL_RTCCTRL_RTCSEL_OSC32K:
+        return osc_on && FIELD_EX32(osc, MCHP_OSC32KCTRL_OSC32K, EN32K) ?
+               MCHP_OSC32K_HZ : 0;
+    case MCHP_OSC32KCTRL_RTCCTRL_RTCSEL_XOSC1K:
+        return xosc_on && FIELD_EX32(xosc, MCHP_OSC32KCTRL_XOSC32K, EN1K) ?
+               xhz / 32 : 0;
+    case MCHP_OSC32KCTRL_RTCCTRL_RTCSEL_XOSC32K:
+        return xosc_on && FIELD_EX32(xosc, MCHP_OSC32KCTRL_XOSC32K, EN32K) ?
+               xhz : 0;
+    default:
+        return 0;               /* reserved */
+    }
+}
+
 /* The 32.768 kHz outputs also need EN32K (DS 16.6.2, 16.6.4). */
 static void mchp_osc32kctrl_update(MchpOsc32kctrlState *s)
 {
@@ -370,6 +416,7 @@ static void mchp_osc32kctrl_update(MchpOsc32kctrlState *s)
         FIELD_EX32(osc32k, MCHP_OSC32KCTRL_OSC32K, EN32K) ?
         MCHP_OSC32K_HZ : 0);
     mchp_regblock_set_clock(rb, s->osculp32k, MCHP_OSC32K_HZ);
+    mchp_regblock_set_clock(rb, s->rtc, mchp_osc32kctrl_rtc_hz(s, status));
     mchp_regblock_update_irq(rb);
 }
 
