+/*
+ * Microchip SAM/PIC32CM Real-Time Counter (RTC U2250, PIC32CM MC00)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A TYPE_MCHP_REGBLOCK subclass configured with mchp_regblock_set_info();
+ * CTRLA.MODE selects the MODE0/1/2 register view. Its "gclk" clock input
+ * carries CLK_RTC_OSC, wired by the SoC to the OSC32KCTRL "rtc" output.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_RTC_MCHP_RTC_H
+#define HW_RTC_MCHP_RTC_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_RTC "mchp-rtc"
+
+#endif /* HW_RTC_MCHP_RTC_H */
