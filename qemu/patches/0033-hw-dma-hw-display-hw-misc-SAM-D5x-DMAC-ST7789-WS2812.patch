+/*
+ * Board glue from a PORT "pad" output (0, 1, or -1 while nothing drives
+ * it) to a logic input, with the level a pull resistor gives an undriven
+ * pad
+ */
+typedef struct CuriosityCpPad {
+    qemu_irq out;
+    int undriven;
+    bool invert;
+} CuriosityCpPad;
+
+static void curiosity_cp_pad(void *opaque, int n, int level)
+{
+    CuriosityCpPad *p = opaque;
+    int v = level < 0 ? p->undriven : level > 0;
+
+    qemu_set_irq(p->out, p->invert ? !v : v);
+}
+
+static void curiosity_cp_wire_pad(DeviceState *port, int pin, qemu_irq out,
+                                  int undriven, bool invert)
+{
+    CuriosityCpPad *p = g_new0(CuriosityCpPad, 1);
+
+    p->out = out;
+    p->undriven = undriven;
+    p->invert = invert;
+    qdev_connect_gpio_out_named(port, MCHP_PORT_PAD, pin,
+                                qemu_allocate_irq(curiosity_cp_pad, p, 0));
+    qemu_set_irq(out, invert ? !undriven : undriven);
+}
+
 /* A pressed USER button pulls PA27 low; released, R20 pulls it high. */
 static void curiosity_cp_update_user(CuriosityCpState *s)
 {
@@ -114,6 +171,40 @@ static void curiosity_cp_add_flash(CuriosityCpState *s)
                                                        0));
 }
 
+/* The PyKit Ruler's display and NeoPixels */
+static void curiosity_cp_add_ruler(CuriosityCpState *s)
+{
+    DeviceState *port = pic32cm_soc_periph(&s->soc, "PORT");
+    DeviceState *sercom = pic32cm_soc_periph(&s->soc, CCP_LCD_SPI);
+    SSIBus *spi = (SSIBus *)qdev_get_child_bus(sercom, "sercom0.spi");
+
+    s->lcd = qdev_new(TYPE_ST7789);
+    object_property_add_child(OBJECT(s), "lcd", OBJECT(s->lcd));
+    qdev_realize_and_unref(s->lcd, BUS(spi), &error_fatal);
+    /* TFT_CS idles high (R17); the backlight gate idles high (R23): dark */
+    curiosity_cp_wire_pad(port, CCP_LCD_CS_PIN,
+                          qdev_get_gpio_in_named(s->lcd, SSI_GPIO_CS, 0),
+                          1, false);
+    curiosity_cp_wire_pad(port, CCP_LCD_DC_PIN,
+                          qdev_get_gpio_in_named(s->lcd, ST7789_DC, 0),
+                          0, false);
+    curiosity_cp_wire_pad(port, CCP_LCD_BL_PIN,
+                          qdev_get_gpio_in_named(s->lcd, ST7789_BACKLIGHT, 0),
+                          1, true);
+    qemu_set_irq(qdev_get_gpio_in_named(port, MCHP_PORT_IN, CCP_LCD_CS_PIN),
+                 1);
+    qemu_set_irq(qdev_get_gpio_in_named(port, MCHP_PORT_IN, CCP_LCD_BL_PIN),
+                 1);
+
+    s->neopixels = qdev_new(TYPE_WS2812);
+    object_property_add_child(OBJECT(s), "neopixels", OBJECT(s->neopixels));
+    qdev_prop_set_uint32(s->neopixels, "count", CCP_NEOPIXELS);
+    qdev_realize_and_unref(s->neopixels, NULL, &error_fatal);
+    curiosity_cp_wire_pad(port, CCP_NEOPIXEL_PIN,
+                          qdev_get_gpio_in_named(s->neopixels, WS2812_DIN, 0),
+                          0, false);
+}
+
 /*
