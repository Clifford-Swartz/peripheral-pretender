+ * A chain of WS2812-compatible RGB LEDs (NeoPixels) on one data line
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Property "count": LEDs in the chain. GPIO input "din": the data line.
+ * Read-only properties "pixels" (RRGGBB per LED, space separated) and
+ * "gen" (bumped when a latched colour changes).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_WS2812_H
+#define HW_MISC_WS2812_H
+
+#define TYPE_WS2812 "ws2812"
+#define WS2812_DIN "din"
+
+#endif /* HW_MISC_WS2812_H */
