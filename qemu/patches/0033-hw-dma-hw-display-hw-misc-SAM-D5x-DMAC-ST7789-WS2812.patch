new file mode 100644
index 0000000..9ab08b0
--- /dev/null
+++ b/hw/display/st7789.c
@@ -0,0 +1,417 @@
+/*
+ * Sitronix ST7789V 240x320 RGB TFT driver on an SSI bus
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * ST7789V data sheet v1.0 (2016), 4-line serial interface: a byte is a
+ * command while D/CX is low, its parameters and pixel data while D/CX is
+ * high. Modelled: SWRESET (01h), SLPIN/SLPOUT (10h/11h), INVOFF/INVON
+ * (20h/21h), DISPOFF/DISPON (28h/29h), CASET/RASET (2Ah/2Bh), RAMWR (2Ch)
+ * and RAMWRC (3Ch) into the 240 x 320 frame memory, MADCTL (36h: MY, MX,
+ * MV, RGB order) and COLMOD (3Ah: 16-bit 565 and 18-bit 666 pixels).
+ * Other commands take any parameters and leave the picture alone (porch,
+ * gate, power and gamma settings, partial and idle modes, scrolling).
+ * Frame memory write order (data sheet 8.12): the column counter runs
+ * first, MV exchanges the counters' axes, then MX and MY mirror them.
+ *
+ * The panel: "width" x "height" visible pixels starting at frame memory
+ * column "col-offset" and row "row-offset", shown "rotation" degrees
+ * clockwise (0, 90, 180, 270). The defaults are the PyKit Ruler's 1.14"
+ * IPS glass ER-TFT1.14-2 (135 x 240 at column 52, row 40, mounted
+ * landscape). "inverted" (default on, as on that IPS glass) shows the
+ * frame memory complemented unless INVON is set, which is why its
+ * drivers send INVON. Nothing is visible in reset, in sleep, with the
+ * display off or the backlight off. Not checked against a physical
+ * display.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/display/pp_panel.h"
+#include "hw/display/st7789.h"
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+
+#define ST7789_COLS         240
+#define ST7789_ROWS         320
+
+#define MADCTL_MY           BIT(7)
+#define MADCTL_MX           BIT(6)
+#define MADCTL_MV           BIT(5)
+#define MADCTL_BGR          BIT(3)
+
+OBJECT_DECLARE_SIMPLE_TYPE(St7789State, ST7789)
+
+struct St7789State {
+    SSIPeripheral parent_obj;
+
+    PpPanel panel;
+    uint32_t width;
+    uint32_t height;
+    uint32_t col_offset;
+    uint32_t row_offset;
+    uint32_t rotation;
+    bool inverted;
+
+    uint16_t ram[ST7789_COLS * ST7789_ROWS];   /* RGB565 */
+    uint8_t cmd;
+    uint8_t argc;
+    uint8_t args[4];
+    bool writing;               /* after RAMWR/RAMWRC */
+    uint8_t pix[3];
+    uint8_t npix;
+    uint16_t xs, xe, ys, ye;    /* CASET, RASET windows */
+    uint16_t x, y;              /* counters */
+    uint8_t madctl;
+    uint8_t colmod;
+    bool sleeping;
+    bool display_on;
+    bool invert_on;
+
+    bool dc;
+    bool in_reset;
+    bool backlight;
+};
+
+static void st7789_registers_reset(St7789State *s)
+{
+    s->cmd = 0;
+    s->argc = 0;
+    s->writing = false;
+    s->npix = 0;
+    s->xs = 0;
+    s->xe = ST7789_COLS - 1;
+    s->ys = 0;
+    s->ye = ST7789_ROWS - 1;
+    s->x = s->y = 0;
+    s->madctl = 0;
+    s->colmod = 0x66;
+    s->sleeping = true;
+    s->display_on = false;
+    s->invert_on = false;
+}
+
+/* The pixel at the counters into frame memory, then advance them */
+static void st7789_store(St7789State *s, uint16_t rgb)
+{
+    unsigned px, py;
+
+    if (s->madctl & MADCTL_MV) {
+        px = s->y;
+        py = s->x;
+    } else {
+        px = s->x;
+        py = s->y;
+    }
+    if (s->madctl & MADCTL_MX) {
+        px = ST7789_COLS - 1 - px;
+    }
+    if (s->madctl & MADCTL_MY) {
+        py = ST7789_ROWS - 1 - py;
+    }
+    if (s->madctl & MADCTL_BGR) {
+        rgb = (rgb & 0x07E0) | (rgb >> 11) | (rgb << 11);
+    }
+    if (px < ST7789_COLS && py < ST7789_ROWS) {
+        s->ram[py * ST7789_COLS + px] = rgb;
+    }
+    if (s->x < s->xe) {
+        s->x++;
+    } else {
+        s->x = s->xs;
+        s->y = s->y < s->ye ? s->y + 1 : s->ys;
+    }
+}
+
+static void st7789_data(St7789State *s, uint8_t val)
+{
+    if (s->writing) {
+        bool p18 = (s->colmod & 0x7) == 0x6;
+
+        s->pix[s->npix++] = val;
+        if (!p18 && s->npix == 2) {
+            st7789_store(s, s->pix[0] << 8 | s->pix[1]);
+            s->npix = 0;
+        } else if (p18 && s->npix == 3) {
+            st7789_store(s, pp_panel_rgb565(s->pix[0], s->pix[1], s->pix[2]));
+            s->npix = 0;
+        }
+        pp_panel_changed(&s->panel);
+        return;
+    }
+    if (s->argc < sizeof(s->args)) {
+        s->args[s->argc] = val;
+    }
+    s->argc++;
+    switch (s->cmd) {
+    case 0x2A:
+        if (s->argc == 4) {
+            s->xs = s->args[0] << 8 | s->args[1];
+            s->xe = s->args[2] << 8 | s->args[3];
+        }
+        break;
+    case 0x2B:
+        if (s->argc == 4) {
+            s->ys = s->args[0] << 8 | s->args[1];
+            s->ye = s->args[2] << 8 | s->args[3];
+        }
+        break;
+    case 0x36:
+        if (s->argc == 1) {
+            s->madctl = val;
+            pp_panel_changed(&s->panel);
+        }
+        break;
+    case 0x3A:
+        if (s->argc == 1) {
+            s->colmod = val;
+        }
+        break;
+    }
+}
+
+static void st7789_command(St7789State *s, uint8_t cmd)
+{
+    s->cmd = cmd;
+    s->argc = 0;
+    s->writing = false;
+    s->npix = 0;
+    switch (cmd) {
+    case 0x01:                  /* SWRESET: frame memory kept */
+        st7789_registers_reset(s);
+        break;
+    case 0x10:
+        s->sleeping = true;
+        break;
+    case 0x11:
+        s->sleeping = false;
+        break;
+    case 0x20:
+        s->invert_on = false;
+        break;
+    case 0x21:
+        s->invert_on = true;
+        break;
+    case 0x28:
+        s->display_on = false;
+        break;
+    case 0x29:
+        s->display_on = true;
+        break;
+    case 0x2C:                  /* RAMWR: from the window's start */
+        s->x = s->xs;
+        s->y = s->ys;
+        s->writing = true;
+        break;
+    case 0x3C:                  /* RAMWRC: where the last write stopped */
+        s->writing = true;
+        break;
+    }
+    pp_panel_changed(&s->panel);
+}
+
+static uint32_t st7789_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    St7789State *s = ST7789(dev);
+
+    if (s->in_reset) {
+        return 0;
+    }
+    if (s->dc) {
+        st7789_data(s, val);
+    } else {
+        st7789_command(s, val);
+    }
+    return 0;
+}
+
+static void st7789_render(void *opaque, uint16_t *fb)
+{
+    St7789State *s = opaque;
+    bool lit = s->backlight && !s->in_reset && !s->sleeping && s->display_on;
+    uint32_t pw = s->width, ph = s->height;     /* glass, unrotated */
+    uint32_t vw = s->panel.width;               /* view */
+
+    for (uint32_t gy = 0; gy < ph; gy++) {
+        for (uint32_t gx = 0; gx < pw; gx++) {
+            uint32_t vx, vy, col = s->col_offset + gx, row = s->row_offset + gy;
+            uint16_t v = 0;
+
+            if (lit && col < ST7789_COLS && row < ST7789_ROWS) {
+                v = s->ram[row * ST7789_COLS + col];
+                if (s->inverted != s->invert_on) {
+                    v = ~v;
+                }
+            }
+            switch (s->rotation) {
+            case 90:
+                vx = ph - 1 - gy;
+                vy = gx;
+                break;
+            case 180:
+                vx = pw - 1 - gx;
+                vy = ph - 1 - gy;
+                break;
+            case 270:
+                vx = gy;
+                vy = pw - 1 - gx;
+                break;
+            default:
+                vx = gx;
+                vy = gy;
+                break;
+            }
+            fb[vy * vw + vx] = v;
+        }
+    }
+}
+
+static void st7789_set_dc(void *opaque, int n, int level)
+{
+    ST7789(opaque)->dc = level > 0;
+}
+
+static void st7789_set_reset(void *opaque, int n, int level)
+{
+    St7789State *s = opaque;
+    bool low = level == 0;
+
+    if (low && !s->in_reset) {
+        st7789_registers_reset(s);
+    }
+    s->in_reset = low;
+    pp_panel_changed(&s->panel);
+}
+
+static void st7789_set_backlight(void *opaque, int n, int level)
+{
+    St7789State *s = opaque;
+
+    s->backlight = level > 0;
+    pp_panel_changed(&s->panel);
+}
+
+static void st7789_realize(SSIPeripheral *dev, Error **errp)
+{
+    St7789State *s = ST7789(dev);
+    bool sideways = s->rotation == 90 || s->rotation == 270;
+
+    if (!s->width || !s->height ||
+        s->col_offset + s->width > ST7789_COLS ||
+        s->row_offset + s->height > ST7789_ROWS ||
+        s->rotation % 90 || s->rotation > 270) {
+        error_setg(errp, "the panel must lie within the 240 x 320 frame "
+                   "memory, rotated by 0, 90, 180 or 270 degrees");
+        return;
+    }
+    s->panel.width = sideways ? s->height : s->width;
+    s->panel.height = sideways ? s->width : s->height;
+    g_free(s->panel.fb);
+    s->panel.fb = g_new0(uint16_t, s->width * s->height);
+    qdev_init_gpio_in_named(DEVICE(dev), st7789_set_dc, ST7789_DC, 1);
+    qdev_init_gpio_in_named(DEVICE(dev), st7789_set_reset, ST7789_RESET, 1);
+    qdev_init_gpio_in_named(DEVICE(dev), st7789_set_backlight,
+                            ST7789_BACKLIGHT, 1);
+}
+
+static void st7789_reset(DeviceState *dev)
+{
+    St7789State *s = ST7789(dev);
+
+    st7789_registers_reset(s);
+    memset(s->ram, 0, sizeof(s->ram));
+    s->parent_obj.cs = true;
+    s->in_reset = false;
+}
+
+static void st7789_init(Object *obj)
+{
+    St7789State *s = ST7789(obj);
+
+    pp_panel_init(&s->panel, obj, 1, 1, st7789_render, s);
+}
+
+static void st7789_finalize(Object *obj)
+{
+    g_free(ST7789(obj)->panel.fb);
+}
+
+static int st7789_post_load(void *opaque, int version_id)
+{
+    pp_panel_changed(&ST7789(opaque)->panel);
+    return 0;
+}
+
+static const Property st7789_properties[] = {
+    DEFINE_PROP_UINT32("width", St7789State, width, 135),
+    DEFINE_PROP_UINT32("height", St7789State, height, 240),
+    DEFINE_PROP_UINT32("col-offset", St7789State, col_offset, 52),
+    DEFINE_PROP_UINT32("row-offset", St7789State, row_offset, 40),
+    DEFINE_PROP_UINT32("rotation", St7789State, rotation, 90),
+    DEFINE_PROP_BOOL("inverted", St7789State, inverted, true),
+};
+
+static const VMStateDescription vmstate_st7789 = {
+    .name = TYPE_ST7789,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = st7789_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, St7789State),
+        VMSTATE_UINT16_ARRAY(ram, St7789State, ST7789_COLS * ST7789_ROWS),
+        VMSTATE_UINT8(cmd, St7789State),
+        VMSTATE_UINT8(argc, St7789State),
+        VMSTATE_UINT8_ARRAY(args, St7789State, 4),
+        VMSTATE_BOOL(writing, St7789State),
+        VMSTATE_UINT8_ARRAY(pix, St7789State, 3),
+        VMSTATE_UINT8(npix, St7789State),
+        VMSTATE_UINT16(xs, St7789State),
+        VMSTATE_UINT16(xe, St7789State),
+        VMSTATE_UINT16(ys, St7789State),
+        VMSTATE_UINT16(ye, St7789State),
+        VMSTATE_UINT16(x, St7789State),
+        VMSTATE_UINT16(y, St7789State),
+        VMSTATE_UINT8(madctl, St7789State),
+        VMSTATE_UINT8(colmod, St7789State),
+        VMSTATE_BOOL(sleeping, St7789State),
+        VMSTATE_BOOL(display_on, St7789State),
+        VMSTATE_BOOL(invert_on, St7789State),
+        VMSTATE_BOOL(dc, St7789State),
+        VMSTATE_BOOL(in_reset, St7789State),
+        VMSTATE_BOOL(backlight, St7789State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void st7789_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    dc->desc = "ST7789V 240x320 RGB TFT driver";
+    dc->vmsd = &vmstate_st7789;
+    device_class_set_props(dc, st7789_properties);
+    device_class_set_legacy_reset(dc, st7789_reset);
+    k->realize = st7789_realize;
+    k->transfer = st7789_transfer;
+    k->cs_polarity = SSI_CS_LOW;
+}
+
+static const TypeInfo st7789_types[] = {
+    {
+        .name = TYPE_ST7789,
+        .parent = TYPE_SSI_PERIPHERAL,
+        .instance_size = sizeof(St7789State),
+        .instance_init = st7789_init,
+        .instance_finalize = st7789_finalize,
+        .class_init = st7789_class_init,
+    },
+};
+
+DEFINE_TYPES(st7789_types)
diff --git a/hw/dma/mchp_dmac.c b/hw/dma/mchp_dmac.c
new file mode 100644
index 0000000..77eb04d
--- /dev/null
+++ b/hw/dma/mchp_dmac.c
@@ -0,0 +1,572 @@
+/*
+ * Microchip SAM D5x/E5x DMA controller (DMAC U2503)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Channels follow DS60001507 (DMAC chapter): enabling a channel fetches
+ * its first descriptor (BASEADDR + 16 * channel) into the write-back
+ * memory (WRBADDR + 16 * channel); each trigger then moves a burst
+ * (TRIGACT BURST, BURSTLEN + 1 beats), a block (BLOCK) or every block
+ * (TRANSACTION). With SRCINC/DSTINC the descriptor addresses are the end
+ * of the block. At the end of a block BLOCKACT may raise TCMPL and
+ * suspend the channel; the next descriptor (DESCADDR) is fetched, or, at
+ * the end of the transfer (DESCADDR 0), TCMPL is set and the channel
+ * disables itself (CircuitPython waits for TCMPL with BLOCKACT NOACT).
+ * An invalid descriptor raises TERR and CHSTATUS.FERR.
+ *
+ * A started transfer runs at the next read of a DMAC status register
+ * (CHINTFLAG, CHSTATUS, INTPEND, ...), or 20 us of virtual time later at
+ * the latest; never during the write that started it, because firmware
+ * clears CHINTFLAG right after setting ENABLE (CircuitPython, Harmony).
+ * It runs as fast as the triggers allow, at most a budget of beats per
+ * run; channels waiting for a trigger are looked at again every 100 us. Not
+ * modelled: priorities and arbitration (lowest channel first), CRC,
+ * events, the threshold, beat timing.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/dma/mchp_dmac.h"
+#include "hw/mchp/gen/dmac_u2503.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+#include "system/dma.h"
+
+#define DMAC_NCH            MCHP_DMAC_CHANNEL_COUNT
+#define DMAC_CH(ch, r)      (MCHP_DMAC_CHANNEL_OFFSET + \
+                             (ch) * MCHP_DMAC_CHANNEL_STRIDE + (r))
+#define DMAC_START_NS       20000       /* unless a status read comes first */
+#define DMAC_POLL_NS        100000      /* while waiting for a trigger */
+#define DMAC_BUDGET         65536       /* beats per run */
+
+#define CH_TERR             R_MCHP_DMAC_CHANNEL_CHINTFLAG_TERR_MASK
+#define CH_TCMPL            R_MCHP_DMAC_CHANNEL_CHINTFLAG_TCMPL_MASK
+#define CH_SUSP             R_MCHP_DMAC_CHANNEL_CHINTFLAG_SUSP_MASK
+
+#define TRIGACT_BLOCK       0
+#define TRIGACT_BURST       2
+#define TRIGACT_TRANSACTION 3
+
+typedef struct DmacTrigger {
+    hwaddr flag_addr;
+    uint8_t mask;               /* 0: not described, never ready */
+} DmacTrigger;
+
+/* A descriptor as in memory */
+typedef struct DmacDesc {
+    uint16_t btctrl;
+    uint16_t btcnt;
+    uint32_t srcaddr;
+    uint32_t dstaddr;
+    uint32_t descaddr;
+} DmacDesc;
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpDmacState, MCHP_DMAC)
+
+struct MchpDmacState {
+    MchpRegBlock parent_obj;
+
+    QEMUTimer *timer;
+    DmacTrigger trig[MCHP_DMAC_MAX_TRIGGERS];
+
+    uint32_t active;            /* channels with a fetched descriptor */
+    uint32_t suspended;
+    uint32_t ferr;              /* fetch error, CHSTATUS.FERR */
+    uint16_t block_beats[DMAC_NCH]; /* BTCNT of the current block */
+};
+
+static uint32_t dmac_reg(MchpDmacState *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static void dmac_set_reg(MchpDmacState *s, hwaddr off, unsigned size,
+                         uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
+static bool dmac_ch_enabled(MchpDmacState *s, unsigned ch)
+{
+    return FIELD_EX32(dmac_reg(s, DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHCTRLA), 4),
+                      MCHP_DMAC_CHANNEL_CHCTRLA, ENABLE);
+}
+
+static void dmac_ch_disable(MchpDmacState *s, unsigned ch)
+{
+    hwaddr off = DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHCTRLA);
+
+    dmac_set_reg(s, off, 4, dmac_reg(s, off, 4) &
+                 ~R_MCHP_DMAC_CHANNEL_CHCTRLA_ENABLE_MASK);
+    s->active &= ~BIT(ch);
+}
+
+static void dmac_ch_flag(MchpDmacState *s, unsigned ch, uint8_t flags)
+{
+    hwaddr off = DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHINTFLAG);
+
+    dmac_set_reg(s, off, 1, dmac_reg(s, off, 1) | flags);
+}
+
+static hwaddr dmac_wb(MchpDmacState *s, unsigned ch)
+{
+    return dmac_reg(s, A_MCHP_DMAC_WRBADDR, 4) + 16 * ch;
+}
+
+static void dmac_load(hwaddr addr, DmacDesc *d)
+{
+    uint8_t b[16];
+
+    dma_memory_read(&address_space_memory, addr, b, sizeof(b),
+                    MEMTXATTRS_UNSPECIFIED);
+    d->btctrl = lduw_le_p(&b[0]);
+    d->btcnt = lduw_le_p(&b[2]);
+    d->srcaddr = ldl_le_p(&b[4]);
+    d->dstaddr = ldl_le_p(&b[8]);
+    d->descaddr = ldl_le_p(&b[12]);
+}
+
+static void dmac_store(hwaddr addr, const DmacDesc *d)
+{
+    uint8_t b[16];
+
+    stw_le_p(&b[0], d->btctrl);
+    stw_le_p(&b[2], d->btcnt);
+    stl_le_p(&b[4], d->srcaddr);
+    stl_le_p(&b[8], d->dstaddr);
+    stl_le_p(&b[12], d->descaddr);
+    dma_memory_write(&address_space_memory, addr, b, sizeof(b),
+                     MEMTXATTRS_UNSPECIFIED);
+}
+
+/* Fetch the descriptor at @addr into the write-back memory of @ch. */
+static bool dmac_fetch(MchpDmacState *s, unsigned ch, hwaddr addr)
+{
+    DmacDesc d;
+
+    dmac_load(addr, &d);
+    if (!FIELD_EX32(d.btctrl, MCHP_DMAC_DESCRIPTOR_BTCTRL, VALID)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: channel %u: invalid descriptor"
+                      " at 0x%" HWADDR_PRIx "\n", MCHP_REGBLOCK(s)->name, ch,
+                      addr);
+        s->ferr |= BIT(ch);
+        dmac_ch_flag(s, ch, CH_TERR);
+        dmac_ch_disable(s, ch);
+        return false;
+    }
+    dmac_store(dmac_wb(s, ch), &d);
+    s->block_beats[ch] = d.btcnt;
+    s->active |= BIT(ch);
+    return true;
+}
+
+static bool dmac_trigger_ready(MchpDmacState *s, unsigned ch)
+{
+    uint32_t ctrla = dmac_reg(s, DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHCTRLA), 4);
+    unsigned src = FIELD_EX32(ctrla, MCHP_DMAC_CHANNEL_CHCTRLA, TRIGSRC);
+    uint8_t flags = 0;
+
+    if (dmac_reg(s, A_MCHP_DMAC_SWTRIGCTRL, 4) & BIT(ch)) {
+        return true;
+    }
+    if (!src || src >= MCHP_DMAC_MAX_TRIGGERS || !s->trig[src].mask) {
+        return false;
+    }
+    dma_memory_read(&address_space_memory, s->trig[src].flag_addr, &flags, 1,
+                    MEMTXATTRS_UNSPECIFIED);
+    return flags & s->trig[src].mask;
+}
+
+/* One beat of @ch; false: the channel ended or failed */
+static bool dmac_beat(MchpDmacState *s, unsigned ch, DmacDesc *d)
+{
+    unsigned size = 1 << FIELD_EX32(d->btctrl, MCHP_DMAC_DESCRIPTOR_BTCTRL,
+                                    BEATSIZE);
+    bool stepsrc = FIELD_EX32(d->btctrl, MCHP_DMAC_DESCRIPTOR_BTCTRL, STEPSEL);
+    unsigned step = 1 << FIELD_EX32(d->btctrl, MCHP_DMAC_DESCRIPTOR_BTCTRL,
+                                    STEPSIZE);
+    uint32_t total = s->block_beats[ch];
+    uint32_t k = total - d->btcnt;
+    uint32_t src = d->srcaddr, dst = d->dstaddr;
+    uint8_t buf[4];
+
+    if (size > 4) {
+        size = 4;               /* reserved BEATSIZE */
+    }
+    if (FIELD_EX32(d->btctrl, MCHP_DMAC_DESCRIPTOR_BTCTRL, SRCINC)) {
+        uint32_t inc = size * (stepsrc ? step : 1);
+
+        src = d->srcaddr - total * inc + k * inc;
+    }
+    if (FIELD_EX32(d->btctrl, MCHP_DMAC_DESCRIPTOR_BTCTRL, DSTINC)) {
+        uint32_t inc = size * (stepsrc ? 1 : step);
+
+        dst = d->dstaddr - total * inc + k * inc;
+    }
+    dma_memory_read(&address_space_memory, src, buf, size,
+                    MEMTXATTRS_UNSPECIFIED);
+    dma_memory_write(&address_space_memory, dst, buf, size,
+                     MEMTXATTRS_UNSPECIFIED);
+    d->btcnt--;
+    return true;
+}
+
+/* The block of @ch ended: block action, next descriptor or the end */
+static void dmac_block_end(MchpDmacState *s, unsigned ch, DmacDesc *d)
+{
+    unsigned act = FIELD_EX32(d->btctrl, MCHP_DMAC_DESCRIPTOR_BTCTRL,
+                              BLOCKACT);
+
+    dmac_store(dmac_wb(s, ch), d);
+    if (!d->descaddr) {
+        dmac_ch_flag(s, ch, CH_TCMPL);
+        dmac_ch_disable(s, ch);
+        return;
+    }
+    if (act & 1) {
+        dmac_ch_flag(s, ch, CH_TCMPL);
+    }
+    if (act & 2) {
+        dmac_ch_flag(s, ch, CH_SUSP);
+        s->suspended |= BIT(ch);
+    }
+    dmac_fetch(s, ch, d->descaddr);
+}
+
+/* Serve one trigger of @ch; returns the beats moved */
+static unsigned dmac_serve(MchpDmacState *s, unsigned ch, unsigned budget)
+{
+    uint32_t ctrla = dmac_reg(s, DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHCTRLA), 4);
+    unsigned trigact = FIELD_EX32(ctrla, MCHP_DMAC_CHANNEL_CHCTRLA, TRIGACT);
+    unsigned beats = 0, limit;
+    DmacDesc d;
+
+    /* Taking a software trigger clears it */
+    dmac_set_reg(s, A_MCHP_DMAC_SWTRIGCTRL, 4,
+                 dmac_reg(s, A_MCHP_DMAC_SWTRIGCTRL, 4) & ~BIT(ch));
+    limit = trigact == TRIGACT_BURST ?
+            FIELD_EX32(ctrla, MCHP_DMAC_CHANNEL_CHCTRLA, BURSTLEN) + 1 :
+            budget;
+    while (beats < MIN(limit, budget) && (s->active & BIT(ch)) &&
+           !(s->suspended & BIT(ch))) {
+        dmac_load(dmac_wb(s, ch), &d);
+        if (d.btcnt) {
+            dmac_beat(s, ch, &d);
+            beats++;
+            dmac_store(dmac_wb(s, ch), &d);
+        }
+        if (!d.btcnt) {
+            dmac_block_end(s, ch, &d);
+            if (trigact == TRIGACT_BLOCK || trigact == TRIGACT_BURST) {
+                break;
+            }
+        }
+    }
+    return beats ? beats : 1;
+}
+
+static bool dmac_runnable(MchpDmacState *s, unsigned ch)
+{
+    return dmac_ch_enabled(s, ch) && (s->active & BIT(ch)) &&
+           !(s->suspended & BIT(ch));
+}
+
+static void dmac_run(MchpDmacState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    unsigned budget = DMAC_BUDGET;
+    bool waiting = false, progress = true;
+
+    if (!FIELD_EX32(dmac_reg(s, A_MCHP_DMAC_CTRL, 2), MCHP_DMAC_CTRL,
+                    DMAENABLE)) {
+        return;
+    }
+    while (progress && budget) {
+        progress = false;
+        for (unsigned ch = 0; ch < DMAC_NCH && budget; ch++) {
+            unsigned n;
+
+            if (!dmac_runnable(s, ch)) {
+                continue;
+            }
+            if (!dmac_trigger_ready(s, ch)) {
+                waiting = true;
+                continue;
+            }
+            n = dmac_serve(s, ch, budget);
+            budget -= MIN(n, budget);
+            progress = true;
+        }
+    }
+    mchp_regblock_update_irq(rb);
+    if (waiting || !budget) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  (budget ? DMAC_POLL_NS : DMAC_START_NS));
+    }
+}
+
+static void dmac_timer(void *opaque)
+{
+    dmac_run(MCHP_DMAC(opaque));
+}
+
+static void dmac_schedule(MchpDmacState *s)
+{
+    int64_t when = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + DMAC_START_NS;
+
+    if (!timer_pending(s->timer) || timer_expire_time_ns(s->timer) > when) {
+        timer_mod(s->timer, when);
+    }
+}
+
+void mchp_dmac_kick(DeviceState *dev)
+{
+    dmac_schedule(MCHP_DMAC(dev));
+}
+
+void mchp_dmac_set_trigger(DeviceState *dev, unsigned id, hwaddr flag_addr,
+                           uint8_t mask)
+{
+    MchpDmacState *s = MCHP_DMAC(dev);
+
+    assert(id < MCHP_DMAC_MAX_TRIGGERS);
+    s->trig[id].flag_addr = flag_addr;
+    s->trig[id].mask = mask;
+}
+
+static uint8_t dmac_ch_pending(MchpDmacState *s, unsigned ch)
+{
+    return dmac_reg(s, DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHINTFLAG), 1) &
+           dmac_reg(s, DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHINTENSET), 1);
+}
+
+/* Lines 0-3: channels 0-3; line 4: channels 4-31 */
+static uint32_t dmac_irq_lines(MchpRegBlock *rb)
+{
+    MchpDmacState *s = MCHP_DMAC(rb);
+    uint32_t lines = 0;
+
+    for (unsigned ch = 0; ch < DMAC_NCH; ch++) {
+        if (dmac_ch_pending(s, ch)) {
+            lines |= BIT(MIN(ch, 4));
+        }
+    }
+    return lines;
+}
+
+static bool dmac_irq_pending(MchpRegBlock *rb)
+{
+    return dmac_irq_lines(rb) != 0;
+}
+
+static uint32_t dmac_chstatus(MchpDmacState *s, unsigned ch)
+{
+    uint32_t st = 0;
+
+    if (dmac_runnable(s, ch)) {
+        st |= R_MCHP_DMAC_CHANNEL_CHSTATUS_BUSY_MASK;
+        if (dmac_trigger_ready(s, ch)) {
+            st |= R_MCHP_DMAC_CHANNEL_CHSTATUS_PEND_MASK;
+        }
+    }
+    if (s->ferr & BIT(ch)) {
+        st |= R_MCHP_DMAC_CHANNEL_CHSTATUS_FERR_MASK;
+    }
+    return st;
+}
+
+static uint32_t dmac_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                              unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpDmacState *s = MCHP_DMAC(rf->opaque);
+    uint32_t off = mchp_regfile_elem_offset(ri, idx);
+    uint32_t v = 0;
+
+    if (side_effects && timer_pending(s->timer)) {
+        /* Firmware looks: what was started has run by now */
+        timer_del(s->timer);
+        dmac_run(s);
+        stored = mchp_regfile_peek(rf, off, ri->size);
+    }
+
+    switch (off) {
+    case A_MCHP_DMAC_INTPEND:
+        for (unsigned ch = 0; ch < DMAC_NCH; ch++) {
+            uint8_t f = dmac_ch_pending(s, ch);
+
+            if (f) {
+                uint32_t st = dmac_chstatus(s, ch);
+
+                return ch | (uint32_t)f << R_MCHP_DMAC_INTPEND_TERR_SHIFT |
+                       (st & R_MCHP_DMAC_CHANNEL_CHSTATUS_PEND_MASK ?
+                        R_MCHP_DMAC_INTPEND_PEND_MASK : 0) |
+                       (st & R_MCHP_DMAC_CHANNEL_CHSTATUS_BUSY_MASK ?
+                        R_MCHP_DMAC_INTPEND_BUSY_MASK : 0) |
+                       (st & R_MCHP_DMAC_CHANNEL_CHSTATUS_FERR_MASK ?
+                        R_MCHP_DMAC_INTPEND_FERR_MASK : 0);
+            }
+        }
+        return 0;
+    case A_MCHP_DMAC_INTSTATUS:
+        for (unsigned ch = 0; ch < DMAC_NCH; ch++) {
+            v |= dmac_ch_pending(s, ch) ? BIT(ch) : 0;
+        }
+        return v;
+    case A_MCHP_DMAC_BUSYCH:
+    case A_MCHP_DMAC_PENDCH:
+        for (unsigned ch = 0; ch < DMAC_NCH; ch++) {
+            uint32_t st = dmac_chstatus(s, ch);
+
+            if (st & (off == A_MCHP_DMAC_BUSYCH ?
+                      R_MCHP_DMAC_CHANNEL_CHSTATUS_BUSY_MASK :
+                      R_MCHP_DMAC_CHANNEL_CHSTATUS_PEND_MASK)) {
+                v |= BIT(ch);
+            }
+        }
+        return v;
+    case A_MCHP_DMAC_ACTIVE:
+        return 0;               /* transfers run between accesses */
+    default:
+        break;
+    }
+    if (off >= MCHP_DMAC_CHANNEL_OFFSET &&
+        (off - MCHP_DMAC_CHANNEL_OFFSET) % MCHP_DMAC_CHANNEL_STRIDE ==
+        A_MCHP_DMAC_CHANNEL_CHSTATUS) {
+        return dmac_chstatus(s, (off - MCHP_DMAC_CHANNEL_OFFSET) /
+                                MCHP_DMAC_CHANNEL_STRIDE);
+    }
+    return stored;
+}
+
+static void dmac_ch_reset(MchpDmacState *s, unsigned ch)
+{
+    static const hwaddr regs[] = {
+        A_MCHP_DMAC_CHANNEL_CHCTRLA, A_MCHP_DMAC_CHANNEL_CHCTRLB,
+        A_MCHP_DMAC_CHANNEL_CHPRILVL, A_MCHP_DMAC_CHANNEL_CHEVCTRL,
+        A_MCHP_DMAC_CHANNEL_CHINTENSET, A_MCHP_DMAC_CHANNEL_CHINTFLAG,
+    };
+
+    for (unsigned i = 0; i < ARRAY_SIZE(regs); i++) {
+        dmac_set_reg(s, DMAC_CH(ch, regs[i]), 1, 0);
+    }
+    dmac_set_reg(s, DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHCTRLA), 4, 0);
+    s->active &= ~BIT(ch);
+    s->suspended &= ~BIT(ch);
+    s->ferr &= ~BIT(ch);
+}
+
+static void dmac_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                            unsigned idx, uint32_t old, uint32_t written,
+                            uint32_t we)
+{
+    MchpDmacState *s = MCHP_DMAC(rf->opaque);
+    uint32_t off = mchp_regfile_elem_offset(ri, idx);
+    unsigned ch;
+    uint32_t reg;
+
+    if (off == A_MCHP_DMAC_INTPEND) {
+        /* Writing TERR/TCMPL/SUSP clears them in channel ID */
+        ch = FIELD_EX32(written, MCHP_DMAC_INTPEND, ID);
+        reg = DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHINTFLAG);
+        dmac_set_reg(s, reg, 1, dmac_reg(s, reg, 1) &
+                     ~((written & we) >> R_MCHP_DMAC_INTPEND_TERR_SHIFT & 7));
+        dmac_set_reg(s, A_MCHP_DMAC_INTPEND, 2, 0);
+    } else if (off >= MCHP_DMAC_CHANNEL_OFFSET) {
+        ch = (off - MCHP_DMAC_CHANNEL_OFFSET) / MCHP_DMAC_CHANNEL_STRIDE;
+        reg = (off - MCHP_DMAC_CHANNEL_OFFSET) % MCHP_DMAC_CHANNEL_STRIDE;
+        if (reg == A_MCHP_DMAC_CHANNEL_CHCTRLA) {
+            uint32_t now = dmac_reg(s, off, 4);
+
+            if (written & we & R_MCHP_DMAC_CHANNEL_CHCTRLA_SWRST_MASK) {
+                dmac_ch_reset(s, ch);
+            } else if ((now & R_MCHP_DMAC_CHANNEL_CHCTRLA_ENABLE_MASK) &&
+                       !(old & R_MCHP_DMAC_CHANNEL_CHCTRLA_ENABLE_MASK)) {
+                s->ferr &= ~BIT(ch);
+                s->suspended &= ~BIT(ch);
+                dmac_fetch(s, ch, dmac_reg(s, A_MCHP_DMAC_BASEADDR, 4) +
+                                  16 * ch);
+            } else if (!(now & R_MCHP_DMAC_CHANNEL_CHCTRLA_ENABLE_MASK)) {
+                s->active &= ~BIT(ch);
+            }
+        } else if (reg == A_MCHP_DMAC_CHANNEL_CHCTRLB) {
+            switch (FIELD_EX32(written, MCHP_DMAC_CHANNEL_CHCTRLB, CMD)) {
+            case 1:                     /* SUSPEND */
+                s->suspended |= BIT(ch);
+                dmac_ch_flag(s, ch, CH_SUSP);
+                break;
+            case 2:                     /* RESUME */
+                s->suspended &= ~BIT(ch);
+                break;
+            }
+            dmac_set_reg(s, off, 1, 0);
+        }
+    }
+    dmac_schedule(s);
+}
+
+static void dmac_reset_hold(MchpRegBlock *rb)
+{
+    MchpDmacState *s = MCHP_DMAC(rb);
+
+    timer_del(s->timer);
+    s->active = s->suspended = s->ferr = 0;
+    memset(s->block_beats, 0, sizeof(s->block_beats));
+}
+
+static void dmac_init(Object *obj)
+{
+    MchpDmacState *s = MCHP_DMAC(obj);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, dmac_timer, s);
+}
+
+static void dmac_finalize(Object *obj)
+{
+    timer_free(MCHP_DMAC(obj)->timer);
+}
+
+static const VMStateDescription vmstate_mchp_dmac = {
+    .name = TYPE_MCHP_DMAC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpDmacState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_TIMER_PTR(timer, MchpDmacState),
+        VMSTATE_UINT32(active, MchpDmacState),
+        VMSTATE_UINT32(suspended, MchpDmacState),
+        VMSTATE_UINT32(ferr, MchpDmacState),
+        VMSTATE_UINT16_ARRAY(block_beats, MchpDmacState, DMAC_NCH),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void dmac_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_dmac;
+    c->pre_read = dmac_pre_read;
+    c->post_write = dmac_post_write;
+    c->reset_hold = dmac_reset_hold;
+    c->irq_pending = dmac_irq_pending;
+    c->irq_lines = dmac_irq_lines;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_dmac_types[] = {
+    {
+        .name = TYPE_MCHP_DMAC,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpDmacState),
+        .instance_init = dmac_init,
+        .instance_finalize = dmac_finalize,
+        .class_init = dmac_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_dmac_types)
