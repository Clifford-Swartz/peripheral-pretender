+/*
+ * Sitronix ST7789V 240x320 RGB TFT driver on an SSI bus
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * GPIO inputs: "dc" (D/CX: 1 data, 0 command), "reset" (RESX, active
+ * low), "backlight" (1: lit), plus the SSI chip select. The panel picture
+ * is a PpPanel ("frame", "frame-gen"; see pp_panel.h).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_DISPLAY_ST7789_H
+#define HW_DISPLAY_ST7789_H
+
+#define TYPE_ST7789 "st7789"
+
+#define ST7789_DC "dc"
+#define ST7789_RESET "reset"
+#define ST7789_BACKLIGHT "backlight"
+
+#endif /* HW_DISPLAY_ST7789_H */
diff --git a/include/hw/dma/mchp_dmac.h b/include/hw/dma/mchp_dmac.h
new file mode 100644
index 0000000..f1c1569
--- /dev/null
+++ b/include/hw/dma/mchp_dmac.h
@@ -0,0 +1,35 @@
+/*
+ * Microchip SAM D5x/E5x DMA controller (DMAC U2503)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An mchp-regblock (five NVIC lines: channels 0-3, then the rest). A
+ * peripheral trigger is ready while the trigger's flag reads set in the
+ * peripheral's register (SERCOM INTFLAG.DRE for TX, RXC for RX); the SoC
+ * describes each trigger with mchp_dmac_set_trigger() before realize.
+ * Triggers nobody described never fire; software triggers always work.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_DMA_MCHP_DMAC_H
+#define HW_DMA_MCHP_DMAC_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_DMAC "mchp-dmac"
+
+#define MCHP_DMAC_MAX_TRIGGERS  128
+
+/*
+ * Trigger @id (CHCTRLA.TRIGSRC) is ready while the byte at @flag_addr has
+ * a bit of @mask set.
+ */
+void mchp_dmac_set_trigger(DeviceState *dmac, unsigned id, hwaddr flag_addr,
+                           uint8_t mask);
+
+/* Look again at the triggers (a peripheral's flags may have changed). */
+void mchp_dmac_kick(DeviceState *dmac);
+
+#endif /* HW_DMA_MCHP_DMAC_H */
