+/*
+ * DMAC triggers the model can pace: SERCOM TX while INTFLAG.DRE is set, RX
+ * while INTFLAG.RXC is (INTFLAG at 0x18 in every SERCOM mode)
+ */
+static void pic32cm_dmac_triggers(Pic32cmSocState *s, DeviceState *dmac)
+{
+    for (unsigned i = 0; i < s->dev->ndmac_triggers; i++) {
+        const MchpPeriphRef *ref = &s->dev->dmac_triggers[i];
+        const MchpInstanceInfo *info = pic32cm_info(s, ref->instance);
+
+        if (ref->id >= MCHP_DMAC_MAX_TRIGGERS ||
+            strcmp(info->module, "SERCOM")) {
+            continue;
+        }
+        if (!strcmp(ref->param, "DMAC_ID_TX")) {
+            mchp_dmac_set_trigger(dmac, ref->id, info->base + 0x18, 0x01);
+        } else if (!strcmp(ref->param, "DMAC_ID_RX")) {
+            mchp_dmac_set_trigger(dmac, ref->id, info->base + 0x18, 0x04);
+        }
+    }
+}
+
 static bool pic32cm_realize_periph(Pic32cmSocState *s, uint8_t rev,
                                    Error **errp)
 {
@@ -583,6 +607,8 @@ static bool pic32cm_realize_periph(Pic32cmSocState *s, uint8_t rev,
             qdev_prop_set_uint8(dev, "revision", rev);
