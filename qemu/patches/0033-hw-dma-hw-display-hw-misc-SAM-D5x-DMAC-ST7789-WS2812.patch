+/* Memory to memory with a software trigger, block action interrupt */
+static void test_dmac(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    uint32_t desc = SRAM + 0x1000, wb = SRAM + 0x1200;
+    uint32_t src = SRAM + 0x2000, dst = SRAM + 0x3000;
+
+    for (unsigned i = 0; i < 16; i++) {
+        qtest_writeb(qts, src + i, 0xA0 + i);
+    }
+    /* Channel 0 descriptor: VALID, BLOCKACT INT, bytes, SRCINC, DSTINC */
+    qtest_writew(qts, desc + 0x0, 0x0C09);
+    qtest_writew(qts, desc + 0x2, 16);
+    qtest_writel(qts, desc + 0x4, src + 16);    /* end addresses */
+    qtest_writel(qts, desc + 0x8, dst + 16);
+    qtest_writel(qts, desc + 0xC, 0);
+    qtest_writel(qts, DMAC + 0x34, desc);       /* BASEADDR */
+    qtest_writel(qts, DMAC + 0x38, wb);         /* WRBADDR */
+    qtest_writew(qts, DMAC + 0x00, 0x0F02);     /* DMAENABLE, all levels */
+    qtest_writel(qts, DMAC + 0x40, 0x00300002); /* TRANSACTION, ENABLE */
+    qtest_writeb(qts, DMAC + 0x4E, 0xFF);       /* clear old flags */
+    g_assert_cmphex(qtest_readb(qts, dst), ==, 0);
+    qtest_writel(qts, DMAC + 0x10, 1);          /* SWTRIG0 */
+    qtest_clock_step(qts, 100000);
+    for (unsigned i = 0; i < 16; i++) {
+        g_assert_cmphex(qtest_readb(qts, dst + i), ==, 0xA0 + i);
+    }
+    g_assert_cmphex(qtest_readb(qts, DMAC + 0x4E) & 0x2, ==, 0x2);  /* TCMPL */
+    g_assert_cmphex(qtest_readl(qts, DMAC + 0x40) & 0x2, ==, 0);    /* off */
+    g_assert_cmphex(qtest_readw(qts, wb + 0x2), ==, 0);             /* BTCNT */
+    qtest_quit(qts);
+}
+
+/* NeoPixel chain on PB22: one 24-bit GRB word per LED */
+static void ws2812_send(QTestState *qts, const uint8_t *grb, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++) {
+        for (int b = 7; b >= 0; b--) {
+            bool one = grb[i] >> b & 1;
+
+            qtest_writel(qts, PB + P_OUTSET, 1u << 22);
+            qtest_clock_step(qts, one ? 700 : 350);
+            qtest_writel(qts, PB + P_OUTCLR, 1u << 22);
+            qtest_clock_step(qts, one ? 550 : 900);
+        }
+    }
+    qtest_clock_step(qts, 100000);              /* reset: latch */
+}
+
+static void test_neopixels(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    static const uint8_t grb[] = {
+        0x00, 0xFF, 0x00,   0xFF, 0x00, 0x00,   0x00, 0x00, 0xFF,
+        0x10, 0x20, 0x30,   0x80, 0x01, 0x7F,
+    };
+    QDict *rsp;
+
+    qtest_writel(qts, PB + P_DIRSET, 1u << 22);
+    ws2812_send(qts, grb, sizeof(grb));
+    rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                    " { 'path': '/machine/neopixels', 'property': 'pixels' } }");
+    g_assert_cmpstr(qdict_get_str(rsp, "return"), ==,
+                    "FF0000 00FF00 0000FF 201030 01807F");
+    qobject_unref(rsp);
+    qtest_quit(qts);
+}
+
