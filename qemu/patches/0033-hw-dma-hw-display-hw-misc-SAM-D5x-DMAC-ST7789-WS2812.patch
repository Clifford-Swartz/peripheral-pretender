diff --git a/hw/misc/ws2812.c b/hw/misc/ws2812.c
new file mode 100644
index 0000000..0821f79
--- /dev/null
+++ b/hw/misc/ws2812.c
@@ -0,0 +1,234 @@
+/*
+ * A chain of WS2812-compatible RGB LEDs (NeoPixels) on one data line
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The data line ("din", a GPIO input fed from a pad) carries 24 bits per
+ * LED, green, red, blue, most significant bit first; each bit is a high
+ * pulse whose length gives its value (about 0.3 of the bit period for a
+ * 0, 0.6 for a 1). The first LED keeps the first 24 bits and passes the
+ * rest on; a low line for longer than the reset time latches every LED.
+ *
+ * Bits are told apart by the share of the bit period the line is high
+ * (rising edge to rising edge), so the absolute speed does not matter:
+ * firmware that bit-bangs the line at a tenth of the real rate still
+ * decodes. Times are QEMU_CLOCK_VIRTUAL; run with -icount for
+ * instruction-exact pulses (otherwise host time, which a translation
+ * stall can distort). Front ends poll "gen" and read "pixels": one
+ * RRGGBB hex value per LED, separated by spaces. The colour each LED
+ * shows is the latched value (FR5050RGB4C-F1A: WS2812B timing). Not
+ * modelled: the 280 us reset of newer parts, the data-out line.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/misc/ws2812.h"
+#include "migration/vmstate.h"
+
+#define WS2812_MAX_LEDS     64
+#define WS2812_RESET_NS     50000       /* latch after 50 us low */
+#define WS2812_ONE_SHARE    45          /* % of the period: 1 above */
+
+OBJECT_DECLARE_SIMPLE_TYPE(Ws2812State, WS2812)
+
+struct Ws2812State {
+    DeviceState parent_obj;
+
+    uint32_t count;
+    QEMUTimer *latch;
+
+    uint32_t shown[WS2812_MAX_LEDS];    /* latched 0xRRGGBB */
+    uint32_t shift[WS2812_MAX_LEDS];    /* GRB words being received */
+    uint32_t nbits;
+    uint32_t gen;
+
+    bool level;
+    int64_t rise;                       /* last rising edge */
+    int64_t high_ns;                    /* high time of the pending bit */
+    int64_t period_ns;                  /* last measured bit period */
+    bool pending;                       /* a bit waits for its period */
+};
+
+static void ws2812_push(Ws2812State *s, bool one)
+{
+    uint32_t led = s->nbits / 24;
+
+    if (led < s->count) {
+        s->shift[led] = s->shift[led] << 1 | one;
+    }
+    s->nbits++;
+}
+
+static void ws2812_classify(Ws2812State *s, int64_t period)
+{
+    if (period > 0) {
+        ws2812_push(s, s->high_ns * 100 > period * WS2812_ONE_SHARE);
+        s->period_ns = period;
+    }
+    s->pending = false;
+}
+
+/* The line stayed low: latch what arrived */
+static void ws2812_latch(void *opaque)
+{
+    Ws2812State *s = opaque;
+    uint32_t leds;
+
+    if (s->pending) {
+        /* The last bit has no next edge: its period is the previous one */
+        ws2812_classify(s, s->period_ns ? s->period_ns : 3 * s->high_ns);
+    }
+    leds = MIN(s->nbits / 24, s->count);
+    for (uint32_t i = 0; i < leds; i++) {
+        uint32_t grb = s->shift[i] & 0xFFFFFF;
+        uint32_t rgb = (grb & 0x00FF00) << 8 | (grb & 0xFF0000) >> 8 |
+                       (grb & 0x0000FF);
+
+        if (s->shown[i] != rgb) {
+            s->shown[i] = rgb;
+            s->gen++;
+        }
+    }
+    s->nbits = 0;
+    memset(s->shift, 0, sizeof(s->shift));
+}
+
+static void ws2812_din(void *opaque, int n, int level)
+{
+    Ws2812State *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    bool high = level > 0;
+
+    if (high == s->level) {
+        return;
+    }
+    s->level = high;
+    if (high) {
+        timer_del(s->latch);
+        if (s->pending) {
+            ws2812_classify(s, now - s->rise);
+        }
+        s->rise = now;
+    } else {
+        s->high_ns = now - s->rise;
+        s->pending = true;
+        timer_mod(s->latch, now + WS2812_RESET_NS);
+    }
+}
+
+static void ws2812_get_pixels(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    Ws2812State *s = WS2812(obj);
+    g_autoptr(GString) str = g_string_new(NULL);
+    char *p;
+
+    for (uint32_t i = 0; i < s->count; i++) {
+        g_string_append_printf(str, "%s%06X", i ? " " : "", s->shown[i]);
+    }
+    p = str->str;
+    visit_type_str(v, name, &p, errp);
+}
+
+static void ws2812_get_gen(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    uint32_t gen = WS2812(obj)->gen;
+
+    visit_type_uint32(v, name, &gen, errp);
+}
+
+static void ws2812_realize(DeviceState *dev, Error **errp)
+{
+    Ws2812State *s = WS2812(dev);
+
+    if (!s->count || s->count > WS2812_MAX_LEDS) {
+        error_setg(errp, "count must be 1-%d", WS2812_MAX_LEDS);
+    }
+}
+
+static void ws2812_reset(DeviceState *dev)
+{
+    Ws2812State *s = WS2812(dev);
+
+    timer_del(s->latch);
+    memset(s->shown, 0, sizeof(s->shown));
+    memset(s->shift, 0, sizeof(s->shift));
+    s->nbits = 0;
+    s->level = false;
+    s->pending = false;
+    s->period_ns = 0;
+    s->gen++;
+}
+
+static void ws2812_init(Object *obj)
+{
+    Ws2812State *s = WS2812(obj);
+
+    s->latch = timer_new_ns(QEMU_CLOCK_VIRTUAL, ws2812_latch, s);
+    qdev_init_gpio_in_named(DEVICE(obj), ws2812_din, WS2812_DIN, 1);
