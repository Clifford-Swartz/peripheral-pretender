+/* The LCD's lines on port B */
+#define LCD_RS          BIT(2)
+#define LCD_E           BIT(3)
+
+#define LCD_COLS        16
+#define LCD_LINES       2
+#define LCD_DDRAM       80
+#define LCD_CGRAM       64
+#define LCD_BLINK_NS    (409 * SCALE_MS)
+
+/* The picture: 3-pixel dots (2 lit, 1 gap), cells of 5x8 dots */
+#define DOT             3
+#define CELL_W          (6 * DOT)
+#define CELL_H          (10 * DOT)
+#define FRAME_W         296
+#define FRAME_H         82
+#define TEXT_X          6
+#define TEXT_Y          14
