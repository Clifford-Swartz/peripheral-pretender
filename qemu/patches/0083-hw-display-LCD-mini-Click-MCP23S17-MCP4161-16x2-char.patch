+#define POT_WIPER_MAX   256
+
+OBJECT_DECLARE_SIMPLE_TYPE(ClickLcdminiState, CLICK_LCDMINI)
+
+struct ClickLcdminiState {
+    SSIPeripheral parent_obj;
+
+    Mcp23x17 io;
+    bool cs;                            /* CS# levels */
+    bool cs2;
+    uint8_t io_phase;                   /* 0 opcode, 1 address, 2 data */
+    bool io_read;
+    bool io_ignore;
+    uint8_t pot_phase;                  /* 0 command, 1 data */
+    uint8_t pot_cmd;
+    uint16_t wiper;
+    bool backlight;
+    uint8_t portb;                      /* port B as last seen */
+
+    /* ST7066U */
+    uint8_t ddram[LCD_DDRAM];
+    uint8_t cgram[LCD_CGRAM];
+    uint8_t ac;                         /* address counter */
+    bool ac_cgram;                      /* AC addresses CGRAM */
+    bool bus8;                          /* 8-bit interface */
+    bool nibble_low;                    /* 4-bit: the high nibble came */
+    uint8_t nibble;
+    bool two_lines;
+    bool increment;
+    bool shift_on_write;
+    bool display_on;
+    bool cursor_on;
+    bool blink_on;
+    bool blink_phase;
+    bool initialised;                   /* an instruction arrived */
+    uint8_t shift;                      /* display shift, 0..39 */
+
+    QEMUTimer *blink;
+    PpPanel panel;
+};
