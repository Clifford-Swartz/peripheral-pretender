+/* LCD mini Click on mikroBUS 1: MCP23S17 CS# on PA7 */
+static void lcd_reg_mb1(QTestState *qts, uint8_t reg, uint8_t val)
+{
+    qtest_writeb(qts, PORTA + 0x06, BIT(7));                    /* OUTCLR */
+    spi0_xfer(qts, 0x40);
+    spi0_xfer(qts, reg);
+    spi0_xfer(qts, val);
+    qtest_writeb(qts, PORTA + 0x05, BIT(7));                    /* OUTSET */
+}
+
+static void lcd_byte_mb1(QTestState *qts, uint8_t b, bool data)
+{
+    uint8_t rs = data ? 0x04 : 0;
+
+    for (unsigned half = 0; half < 2; half++) {
+        uint8_t nib = (half ? b << 4 : b) & 0xf0;
+
+        lcd_reg_mb1(qts, 0x15, nib | rs | 0x08);
+        lcd_reg_mb1(qts, 0x15, nib | rs);
+    }
+}
+
+static void test_lcdmini_mb1(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb1=lcdmini "
+                                  "-kernel %s", (const char *)fw);
+    static const uint8_t init[] = { 0x02, 0x28, 0x0c, 0x01, 0x06 };
+    g_autofree char *text = NULL;
+
+    qtest_writeb(qts, PORTA + 0x05, BIT(7));
+    qtest_writeb(qts, PORTA + 0x01, BIT(4) | BIT(6) | BIT(7));  /* DIRSET */
+    qtest_writeb(qts, SPI0 + 0, 0x21);                  /* MASTER, ENABLE */
+    lcd_reg_mb1(qts, 0x01, 0x00);                       /* IODIRB */
+    for (unsigned i = 0; i < ARRAY_SIZE(init); i++) {
+        lcd_byte_mb1(qts, init[i], false);
+    }
+    lcd_byte_mb1(qts, 'A', true);
+    lcd_byte_mb1(qts, 'V', true);
+    lcd_byte_mb1(qts, 'R', true);
+    text = qom_str(qts, "/machine/mb1-click", "text");
+    g_assert_cmpstr(text, ==, "AVR             \n                ");
+    qtest_quit(qts);
+}
