+
+static void lcdmini_changed(ClickLcdminiState *s)
+{
+    pp_panel_changed(&s->panel);
+}
+
+static void lcdmini_blink_arm(ClickLcdminiState *s)
+{
+    if (s->display_on && s->blink_on) {
+        timer_mod(s->blink, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  LCD_BLINK_NS);
+    } else {
+        timer_del(s->blink);
+        s->blink_phase = false;
+    }
+}
+
+static void lcdmini_blink(void *opaque)
+{
+    ClickLcdminiState *s = opaque;
+
+    s->blink_phase = !s->blink_phase;
+    lcdmini_changed(s);
+    lcdmini_blink_arm(s);
+}
+
+static uint8_t lcdmini_wrap(ClickLcdminiState *s, int addr)
+{
+    if (!s->two_lines) {
+        return (addr + LCD_DDRAM) % LCD_DDRAM;
+    }
+    /* Two lines: 00h-27h and 40h-67h */
+    if (addr < 0) {
+        return 0x67;
+    }
+    if (addr > 0x67) {
+        return 0x00;
+    }
+    if (addr > 0x27 && addr < 0x40) {
+        return s->increment ? 0x40 : 0x27;
+    }
+    return addr;
+}
+
+static unsigned lcdmini_index(ClickLcdminiState *s, uint8_t addr)
+{
+    return s->two_lines && addr >= 0x40 ? 40 + (addr - 0x40) : addr;
+}
+
+static void lcdmini_shift_display(ClickLcdminiState *s, bool right)
+{
+    unsigned width = s->two_lines ? 40 : LCD_DDRAM;
+
+    s->shift = (s->shift + (right ? width - 1 : 1)) % width;
+}
+
+static void lcdmini_step(ClickLcdminiState *s)
+{
+    if (s->ac_cgram) {
+        s->ac = (s->ac + (s->increment ? 1 : LCD_CGRAM - 1)) % LCD_CGRAM;
+    } else {
+        s->ac = lcdmini_wrap(s, s->ac + (s->increment ? 1 : -1));
+    }
+}
+
+static void lcdmini_instruction(ClickLcdminiState *s, uint8_t op)
+{
+    s->initialised = true;
+    if (op & 0x80) {                    /* set DDRAM address */
+        s->ac = lcdmini_wrap(s, op & 0x7f);
+        s->ac_cgram = false;
+    } else if (op & 0x40) {             /* set CGRAM address */
+        s->ac = op & 0x3f;
+        s->ac_cgram = true;
+    } else if (op & 0x20) {             /* function set */
+        s->bus8 = op & 0x10;
+        s->two_lines = op & 0x08;
+        s->nibble_low = false;
+    } else if (op & 0x10) {             /* cursor or display shift */
+        bool right = op & 0x04;
+
+        if (op & 0x08) {
+            lcdmini_shift_display(s, right);
+        } else if (!s->ac_cgram) {
+            s->ac = lcdmini_wrap(s, s->ac + (right ? 1 : -1));
+        }
+    } else if (op & 0x08) {             /* display on/off control */
+        s->display_on = op & 0x04;
+        s->cursor_on = op & 0x02;
+        s->blink_on = op & 0x01;
+        lcdmini_blink_arm(s);
+    } else if (op & 0x04) {             /* entry mode set */
+        s->increment = op & 0x02;
+        s->shift_on_write = op & 0x01;
+    } else if (op & 0x02) {             /* return home */
+        s->ac = 0;
+        s->ac_cgram = false;
+        s->shift = 0;
+    } else if (op & 0x01) {             /* clear display */
+        memset(s->ddram, ' ', sizeof(s->ddram));
+        s->ac = 0;
+        s->ac_cgram = false;
+        s->shift = 0;
+        s->increment = true;
+    }
+    lcdmini_changed(s);
+}
+
+static void lcdmini_data(ClickLcdminiState *s, uint8_t val)
+{
+    if (s->ac_cgram) {
+        s->cgram[s->ac] = val & 0x1f;
+    } else {
+        s->ddram[lcdmini_index(s, s->ac)] = val;
+        if (s->shift_on_write) {
+            lcdmini_shift_display(s, !s->increment);
+        }
+    }
+    lcdmini_step(s);
+    lcdmini_changed(s);
+}
+
+/* A falling E: DB7-DB4 from GPB7-GPB4, DB3-DB0 tied low */
+static void lcdmini_latch(ClickLcdminiState *s, uint8_t portb)
+{
+    uint8_t nibble = portb >> 4, val;
+
+    if (s->bus8) {
+        val = nibble << 4;
+    } else if (!s->nibble_low) {
+        s->nibble = nibble;
+        s->nibble_low = true;
+        return;
+    } else {
+        val = s->nibble << 4 | nibble;
+        s->nibble_low = false;
+    }
+    if (portb & LCD_RS) {
+        lcdmini_data(s, val);
+    } else {
+        lcdmini_instruction(s, val);
+    }
+}
+
+static void lcdmini_pins(void *opaque, unsigned port, uint8_t levels)
+{
+    ClickLcdminiState *s = opaque;
+
+    if (port != 1) {
+        return;
+    }
+    if ((s->portb & LCD_E) && !(levels & LCD_E)) {
+        lcdmini_latch(s, s->portb);     /* data stable before E fell */
+    }
+    s->portb = levels;
+}
+
+/* The character cell's dots: bit c of row r is column c from the left */
+static void lcdmini_glyph(ClickLcdminiState *s, uint8_t code, uint8_t *rows)
+{
+    memset(rows, 0, 8);
+    if (code < 0x10) {
+        for (unsigned r = 0; r < 8; r++) {
+            uint8_t line = s->cgram[(code & 7) * 8 + r];
+
+            for (unsigned c = 0; c < 5; c++) {
+                rows[r] |= ((line >> (4 - c)) & 1) << c;
+            }
+        }
+    } else if (code >= 0x20 && code < 0x80) {
+        const uint8_t *g = lcdmini_font[code - 0x20];
+
+        for (unsigned c = 0; c < 5; c++) {
+            for (unsigned r = 0; r < 7; r++) {
+                rows[r] |= ((g[c] >> r) & 1) << c;
+            }
+        }
+    }
+}
+
+static uint8_t lcdmini_visible(ClickLcdminiState *s, unsigned line,
+                               unsigned col)
+{
+    unsigned width = s->two_lines ? 40 : LCD_DDRAM;
+    unsigned base = s->two_lines ? line * 40 : 0;
+
+    if (line && !s->two_lines) {
+        return ' ';
+    }
+    return s->ddram[base + (col + s->shift) % width];
+}
+
+static uint16_t lcdmini_mix(const uint8_t *a, const uint8_t *b, unsigned k)
+{
+    return pp_panel_rgb565(a[0] + (b[0] - a[0]) * (int)k / 256,
+                           a[1] + (b[1] - a[1]) * (int)k / 256,
+                           a[2] + (b[2] - a[2]) * (int)k / 256);
+}
+
+static void lcdmini_render(void *opaque, uint16_t *fb)
+{
+    ClickLcdminiState *s = opaque;
+    static const uint8_t bg_lit[3] = { 36, 72, 222 };
+    static const uint8_t bg_dark[3] = { 14, 22, 66 };
+    static const uint8_t dot_lit[3] = { 236, 242, 255 };
+    static const uint8_t dot_dark[3] = { 70, 80, 120 };
+    const uint8_t *bg = s->backlight ? bg_lit : bg_dark;
+    const uint8_t *on = s->backlight ? dot_lit : dot_dark;
+    /* Contrast: a low wiper is a low LCD voltage, a strong picture */
+    unsigned k = MIN(256, (POT_WIPER_MAX - s->wiper) * 360 / POT_WIPER_MAX);
+    uint16_t back = pp_panel_rgb565(bg[0], bg[1], bg[2]);
+    uint16_t dot_off = lcdmini_mix(bg, on, 24);
+    uint16_t dot_on = lcdmini_mix(bg, on, k);
+    unsigned cursor = s->two_lines && s->ac >= 0x40 ?
+                      40 + s->ac - 0x40 : s->ac;
+
+    for (unsigned i = 0; i < FRAME_W * FRAME_H; i++) {
+        fb[i] = back;
+    }
+    for (unsigned line = 0; line < LCD_LINES; line++) {
+        for (unsigned col = 0; col < LCD_COLS; col++) {
+            unsigned width = s->two_lines ? 40 : LCD_DDRAM;
+            unsigned at = (s->two_lines ? line * 40 : 0) +
+                          (col + s->shift) % width;
+            bool here = !s->ac_cgram && at == cursor &&
+                        (line == 0 || s->two_lines);
+            uint8_t rows[8];
+
+            if (!s->initialised) {
+                memset(rows, line == 0 ? 0x1f : 0, sizeof(rows));
+            } else if (!s->display_on) {
+                memset(rows, 0, sizeof(rows));
+            } else {
+                lcdmini_glyph(s, lcdmini_visible(s, line, col), rows);
+                if (here && s->cursor_on) {
+                    rows[7] = 0x1f;
+                }
+                if (here && s->blink_on && s->blink_phase) {
+                    memset(rows, 0x1f, sizeof(rows));
+                }
+            }
+            for (unsigned r = 0; r < 8; r++) {
+                for (unsigned c = 0; c < 5; c++) {
+                    uint16_t px = rows[r] >> c & 1 ? dot_on : dot_off;
+                    unsigned x = TEXT_X + col * CELL_W + c * DOT;
+                    unsigned y = TEXT_Y + line * CELL_H + r * DOT;
+
+                    for (unsigned dy = 0; dy < DOT - 1; dy++) {
+                        for (unsigned dx = 0; dx < DOT - 1; dx++) {
+                            fb[(y + dy) * FRAME_W + x + dx] = px;
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+static uint32_t lcdmini_io_byte(ClickLcdminiState *s, uint8_t val)
+{
+    uint8_t ret = 0;
+
+    switch (s->io_phase) {
+    case 0:
+        s->io_read = val & 1;
+        s->io_ignore = (val & 0xf0) != 0x40 ||
+                       ((s->io.reg[0][MCP23X17_IOCON] &
+                         MCP23X17_IOCON_HAEN) && (val & 0x0e));
+        s->io_phase = 1;
+        break;
+    case 1:
+        if (!s->io_ignore) {
+            mcp23x17_set_ptr(&s->io, val);
+        }
+        s->io_phase = 2;
+        break;
+    default:
+        if (s->io_ignore) {
+            break;
+        }
+        if (s->io_read) {
+            ret = mcp23x17_read(&s->io);
+        } else {
+            mcp23x17_write(&s->io, val);
+        }
+        break;
+    }
+    return ret;
+}
+
+static void lcdmini_pot_byte(ClickLcdminiState *s, uint8_t val)
+{
+    unsigned addr, op;
+
+    if (s->pot_phase == 1) {
+        addr = s->pot_cmd >> 4;
+        if ((s->pot_cmd & 0x0c) == 0x0c) {
+            /* the read's data byte: the Click has no SDO */
+        } else if (addr == 0) {
+            s->wiper = MIN(POT_WIPER_MAX, (s->pot_cmd & 3) << 8 | val);
+            lcdmini_changed(s);
+        } else {
+            qemu_log_mask(LOG_UNIMP, "click-lcdmini: MCP4161 write to "
+                          "address %u\n", addr);
+        }
+        s->pot_phase = 0;
+        return;
+    }
+    addr = val >> 4;
+    op = (val >> 2) & 3;
+    switch (op) {
+    case 0:                             /* write: a data byte follows */
+    case 3:                             /* read: no SDO on the Click */
+        s->pot_cmd = val;
+        s->pot_phase = 1;
+        break;
+    default:                            /* increment, decrement */
+        if (addr == 0) {
+            if (op == 1 && s->wiper < POT_WIPER_MAX) {
+                s->wiper++;
+            } else if (op == 2 && s->wiper > 0) {
+                s->wiper--;
+            }
+            lcdmini_changed(s);
+        }
+        break;
+    }
+}
+
+static uint32_t lcdmini_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    ClickLcdminiState *s = CLICK_LCDMINI(dev);
+    uint32_t ret = 0;
+
+    if (!s->cs) {
+        ret = lcdmini_io_byte(s, val);
+    }
+    if (!s->cs2) {
+        lcdmini_pot_byte(s, val);
+    }
+    return ret;
+}
+
+static void lcdmini_set_cs(void *opaque, int n, int level)
+{
+    ClickLcdminiState *s = opaque;
+    bool high = level != 0;             /* undriven: the pull-up */
+
+    if (s->cs && !high) {
+        s->io_phase = 0;
+    }
+    s->cs = high;
+}
+
+static void lcdmini_set_cs2(void *opaque, int n, int level)
+{
+    ClickLcdminiState *s = opaque;
+    bool high = level != 0;
+
+    if (s->cs2 && !high) {
+        s->pot_phase = 0;
+    }
+    s->cs2 = high;
+}
+
+static void lcdmini_set_reset(void *opaque, int n, int level)
+{
+    ClickLcdminiState *s = opaque;
+
+    mcp23x17_set_reset(&s->io, level == 0);
+}
+
+static void lcdmini_set_backlight(void *opaque, int n, int level)
+{
+    ClickLcdminiState *s = opaque;
+    bool on = level != 0;               /* R1 pulls it on */
+
+    if (on != s->backlight) {
+        s->backlight = on;
+        lcdmini_changed(s);
+    }
+}
+
+static char *lcdmini_get_text(Object *obj, Error **errp)
+{
+    ClickLcdminiState *s = CLICK_LCDMINI(obj);
+    GString *text = g_string_new(NULL);
+
+    for (unsigned line = 0; line < LCD_LINES; line++) {
+        for (unsigned col = 0; col < LCD_COLS; col++) {
+            uint8_t code = s->display_on ? lcdmini_visible(s, line, col)
+                                         : ' ';
+
+            g_string_append_c(text, code >= 0x20 && code < 0x7f ? code
+                                                                : '?');
+        }
+        if (!line) {
+            g_string_append_c(text, '\n');
+        }
+    }
+    return g_string_free(text, false);
+}
+
+static void lcdmini_get_contrast(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    uint32_t wiper = CLICK_LCDMINI(obj)->wiper;
+
+    visit_type_uint32(v, name, &wiper, errp);
+}
+
+static bool lcdmini_get_backlight(Object *obj, Error **errp)
+{
+    return CLICK_LCDMINI(obj)->backlight;
+}
+
+static void lcdmini_realize(SSIPeripheral *dev, Error **errp)
+{
+}
+
+static void lcdmini_reset(DeviceState *dev)
+{
+    ClickLcdminiState *s = CLICK_LCDMINI(dev);
+
+    /* Idle levels of the pulled pins: CS# and CS2# high, backlight on */
+    s->cs = true;
+    s->cs2 = true;
+    s->io_phase = 0;
+    s->pot_phase = 0;
+    s->wiper = POT_WIPER_MAX / 2;
+    s->backlight = true;
+    s->portb = 0;
+    mcp23x17_reset(&s->io);
+    s->io.in_reset = false;
+
+    /* ST7066U power-on: 8-bit, one line, display off, increment */
+    memset(s->ddram, ' ', sizeof(s->ddram));
+    memset(s->cgram, 0, sizeof(s->cgram));
+    s->ac = 0;
+    s->ac_cgram = false;
+    s->bus8 = true;
+    s->nibble_low = false;
+    s->two_lines = false;
+    s->increment = true;
+    s->shift_on_write = false;
+    s->display_on = false;
+    s->cursor_on = false;
+    s->blink_on = false;
+    s->blink_phase = false;
+    s->initialised = false;
+    s->shift = 0;
+    timer_del(s->blink);
+    lcdmini_changed(s);
+}
+
+static void lcdmini_init(Object *obj)
+{
+    ClickLcdminiState *s = CLICK_LCDMINI(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    s->io.pins_changed = lcdmini_pins;
+    s->io.opaque = s;
+    qdev_init_gpio_out_named(dev, &s->io.intpin[1], CLICK_LCDMINI_INT, 1);
+    qdev_init_gpio_in_named(dev, lcdmini_set_cs, CLICK_LCDMINI_CS, 1);
+    qdev_init_gpio_in_named(dev, lcdmini_set_cs2, CLICK_LCDMINI_CS2, 1);
+    qdev_init_gpio_in_named(dev, lcdmini_set_reset, CLICK_LCDMINI_RESET, 1);
+    qdev_init_gpio_in_named(dev, lcdmini_set_backlight,
+                            CLICK_LCDMINI_BACKLIGHT, 1);
+    s->blink = timer_new_ns(QEMU_CLOCK_VIRTUAL, lcdmini_blink, s);
+    pp_panel_init(&s->panel, obj, FRAME_W, FRAME_H, lcdmini_render, s);
+    object_property_add_str(obj, "text", lcdmini_get_text, NULL);
+    object_property_add(obj, "contrast", "uint32", lcdmini_get_contrast,
+                        NULL, NULL, NULL);
+    object_property_add_bool(obj, "backlight-on", lcdmini_get_backlight,
+                             NULL);
+}
+
+static void lcdmini_finalize(Object *obj)
+{
+    timer_free(CLICK_LCDMINI(obj)->blink);
+}
+
+static int lcdmini_post_load(void *opaque, int version_id)
+{
+    ClickLcdminiState *s = opaque;
+
+    lcdmini_blink_arm(s);
+    lcdmini_changed(s);
+    return 0;
+}
