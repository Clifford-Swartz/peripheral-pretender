@@ -0,0 +1,29 @@
+/*
+ * LCD mini Click: a 16x2 character LCD behind an MCP23S17
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * "click-lcdmini": an SSI peripheral that watches its own chip selects.
+ * GPIO inputs "cs" (the MCP23S17's CS#), "cs2" (the MCP4161's CS#),
+ * "reset" (the MCP23S17's RESET#) and "backlight" (the backlight switch:
+ * on unless driven low); GPIO output "int" (INTB). QOM properties: those
+ * of pp_panel_init() ("frame", "frame-gen", ...), and read-only "text"
+ * (the two visible lines, separated by a newline), "contrast" (the
+ * MCP4161's wiper, 0-256) and "backlight-on".
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_DISPLAY_CLICK_LCDMINI_H
+#define HW_DISPLAY_CLICK_LCDMINI_H
+
+#define TYPE_CLICK_LCDMINI "click-lcdmini"
+
+#define CLICK_LCDMINI_CS        "cs"
+#define CLICK_LCDMINI_CS2       "cs2"
+#define CLICK_LCDMINI_RESET     "reset"
+#define CLICK_LCDMINI_BACKLIGHT "backlight"
+#define CLICK_LCDMINI_INT       "int"
+
+#endif /* HW_DISPLAY_CLICK_LCDMINI_H */
