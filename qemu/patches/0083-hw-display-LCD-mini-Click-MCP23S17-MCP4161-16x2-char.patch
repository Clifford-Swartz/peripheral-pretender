+/* LCD mini Click on EXT1: MCP23S17 CS# PA17, MCP4161 CS# on AN (PB08) */
+static void lcd_reg(QTestState *qts, uint8_t reg, uint8_t val)
+{
+    qtest_writel(qts, PA + P_OUTCLR, BIT(17));
+    spi_byte(qts, 0x40);                        /* opcode: write, A = 0 */
+    spi_byte(qts, reg);
+    spi_byte(qts, val);
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));
+}
+
+/* One byte to the LCD as MikroElektronika's driver sends it: OLATB */
+static void lcd_byte(QTestState *qts, uint8_t b, bool data)
+{
+    uint8_t rs = data ? 0x04 : 0;
+
+    for (unsigned half = 0; half < 2; half++) {
+        uint8_t nib = (half ? b << 4 : b) & 0xf0;
+
+        lcd_reg(qts, 0x15, nib | rs);
+        lcd_reg(qts, 0x15, nib | rs | 0x08);    /* E high */
+        lcd_reg(qts, 0x15, nib | rs);           /* E falls: latched */
+    }
+}
+
+static void lcd_text(QTestState *qts, uint8_t addr, const char *text)
+{
+    lcd_byte(qts, 0x80 | addr, false);
+    while (*text) {
+        lcd_byte(qts, *text++, true);
+    }
+}
+
+static void test_lcdmini(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=lcdmini ");
+    g_autofree char *blank = NULL, *shown = NULL, *shifted = NULL;
+    static const uint8_t init[] = { 0x02, 0x28, 0x08, 0x01, 0x0c, 0x06 };
+
+    blank = qom_str(qts, CLICK1, "text");
+    g_assert_cmpstr(blank, ==, "                \n                ");
+    g_assert_cmpuint(qom_int(qts, CLICK1, "contrast"), ==, 128);
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, PA + P_OUTSET, BIT(17) | BIT(20));
+    qtest_writel(qts, PA + P_DIRSET, BIT(17) | BIT(20));
+    lcd_reg(qts, 0x0a, 0x00);                   /* IOCON */
+    lcd_reg(qts, 0x01, 0x00);                   /* IODIRB: outputs */
+    for (unsigned i = 0; i < ARRAY_SIZE(init); i++) {
+        lcd_byte(qts, init[i], false);          /* 02h: into 4-bit mode */
+    }
+    lcd_text(qts, 0x05, "Mikro E");
+    lcd_text(qts, 0x41, "LCD mini Click");
+    shown = qom_str(qts, CLICK1, "text");
+    g_assert_cmpstr(shown, ==, "     Mikro E    \n LCD mini Click ");
+    lcd_byte(qts, 0x18, false);                 /* shift the display left */
+    shifted = qom_str(qts, CLICK1, "text");
+    g_assert_cmpstr(shifted, ==, "    Mikro E     \nLCD mini Click  ");
+
+    /* Contrast: [00h, ~200] to the MCP4161 */
+    qtest_writel(qts, PB + P_OUTCLR, BIT(8));
+    qtest_writel(qts, PB + P_DIRSET, BIT(8));
+    spi_byte(qts, 0x00);
+    spi_byte(qts, (uint8_t)~200);
+    qtest_writel(qts, PB + P_OUTSET, BIT(8));
+    g_assert_cmpuint(qom_int(qts, CLICK1, "contrast"), ==, 55);
+    /* Backlight: on while PWM (PB10) floats, off when driven low */
+    g_assert_true(qtest_qom_get_bool(qts, CLICK1, "backlight-on"));
+    qtest_writel(qts, PB + P_OUTCLR, BIT(10));
+    qtest_writel(qts, PB + P_DIRSET, BIT(10));
+    g_assert_false(qtest_qom_get_bool(qts, CLICK1, "backlight-on"));
+    qtest_quit(qts);
+}
