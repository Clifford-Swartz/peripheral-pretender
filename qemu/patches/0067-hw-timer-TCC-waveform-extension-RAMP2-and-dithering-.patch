+/*
+ * PATT forces WO[0] to 1 and WO[4] to 0; PATT reads PATTBUF while
+ * STATUS.PATTBUFV, and the update copies it
+ */
+static void test_pattern(void)
+{
+    QTestState *qts = wave_init(NPWM, 0);
+
+    qtest_writew(qts, TCC0 + R_PATT, PGE(0) | PGE(4) | PGV(0));
+    wave_enable(qts, 0);
+    wave_tick(qts, 10);                     /* WO[4] would be high */
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x01);
+    wave_tick(qts, 30);                     /* WO[0] would be low */
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x01);
+    qtest_writew(qts, TCC0 + R_PATTBUF, 0);
+    g_assert_cmphex(qtest_readw(qts, TCC0 + R_PATT), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_STATUS) & PATTBUFV, ==,
+                    PATTBUFV);
+    wave_tick(qts, 50);
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x01);
+    wave_tick(qts, 110);                    /* copied at the wrap */
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x11);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_STATUS) & PATTBUFV, ==, 0);
+    qtest_quit(qts);
