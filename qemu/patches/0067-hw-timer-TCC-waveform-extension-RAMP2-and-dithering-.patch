@@ -232,27 +233,67 @@ static uint64_t mchp_tc_hz(MchpTcState *s)
     return clock_get_hz(MCHP_REGBLOCK(s)->gclk);
 }
 
+/*
+ * Tick instants are kept exact: t_base plus t_frac (2^-32 ns) is the
+ * instant of the tick last counted, and the instant @n ticks on is t_base
+ * + t_frac + @n * prescaler * the GCLK period. Rounding each one to whole
+ * nanoseconds would lose up to a nanosecond per event.
+ */
+static void mchp_tc_tick_at(MchpTcState *s, uint64_t n, int64_t *ns,
+                            uint32_t *frac)
+{
+    uint64_t lo, hi;
+
+    mulu64(&lo, &hi, clock_get(MCHP_REGBLOCK(s)->gclk),
+           n * mchp_tc_prescaler(s));
+    lo += s->t_frac;
+    hi += lo < s->t_frac;
+    *frac = (uint32_t)lo;
+    *ns = s->t_base + (int64_t)(hi << 32 | lo >> 32);
+}
+
+/* t_base onto the instant of tick @n after it */
+static void mchp_tc_base_tick(MchpTcState *s, uint64_t n)
+{
+    mchp_tc_tick_at(s, n, &s->t_base, &s->t_frac);
+}
+
+/* t_base at @now, a whole nanosecond */
+static void mchp_tc_base_set(MchpTcState *s, int64_t now)
+{
+    s->t_base = now;
+    s->t_frac = 0;
+}
+
 /* Whole counter ticks between t_base and @now */
 static uint64_t mchp_tc_ticks(MchpTcState *s, int64_t now)
 {
-    Clock *clk = MCHP_REGBLOCK(s)->gclk;
+    uint64_t d, lo, hi;
 
     if (!s->running || !mchp_tc_hz(s) || mchp_tc_counts_events(s) ||
         now <= s->t_base) {
         return 0;
     }
-    return clock_ns_to_ticks(clk, now - s->t_base) / mchp_tc_prescaler(s);
+    d = now - s->t_base;
+    lo = d << 32;
+    hi = d >> 32;
+    hi -= lo < s->t_frac;
+    lo -= s->t_frac;
+    divu128(&lo, &hi, clock_get(MCHP_REGBLOCK(s)->gclk));
+    return lo / mchp_tc_prescaler(s);
 }
 
 /* A time by which tick @n after t_base has happened */
 static int64_t mchp_tc_tick_time(MchpTcState *s, uint64_t n)
 {
-    Clock *clk = MCHP_REGBLOCK(s)->gclk;
+    int64_t ns;
+    uint32_t frac;
 
     if (!n) {
         return s->t_base;
     }
-    return s->t_base + clock_ticks_to_ns(clk, n * mchp_tc_prescaler(s)) + 1;
+    mchp_tc_tick_at(s, n, &ns, &frac);
+    return ns + (frac != 0);
 }
 
