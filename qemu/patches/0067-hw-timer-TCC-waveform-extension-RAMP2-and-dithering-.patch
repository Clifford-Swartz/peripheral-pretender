     bool ev_level[2];           /* event inputs */
@@ -129,6 +164,7 @@ struct MchpTccState {
     uint32_t prev;              /* counter value before the last tick */
     uint32_t sync_pending;      /* SYNCBUSY bits waiting for GCLK_TCC */
     int64_t t_base;             /* QEMU_CLOCK_VIRTUAL ns */
+    uint32_t t_frac;            /* and 2^-32 ns (exact tick instants) */
 
     /* Counting geometry, refreshed from the registers after each change */
     uint8_t wavegen;
@@ -156,11 +192,47 @@ static void tcc_mod_reg(MchpTccState *s, hwaddr offset, unsigned size,
     tcc_set_reg(s, offset, size, (tcc_reg(s, offset, size) & ~clear) | set);
 }
 
+/* Low bits of COUNT, PER and CCx that dithering takes (DITHERCY) */
+static unsigned tcc_dith_bits(MchpTccState *s)
+{
+    unsigned res = FIELD_EX32(tcc_reg(s, A_CTRLA, 4), MCHP_TCC_CTRLA,
+                              RESOLUTION);
+
+    return res ? res + 3 : 0;
+}
+
 static uint32_t tcc_max(MchpTccState *s)
 {
     unsigned bits = MCHP_REGBLOCK(s)->info->counter_bits;
 
-    return MAKE_64BIT_MASK(0, bits ? bits : 32);
+    return MAKE_64BIT_MASK(0, (bits ? bits : 32) - tcc_dith_bits(s));
+}
+
+static unsigned tcc_ramp(MchpTccState *s)
+{
+    return FIELD_EX32(tcc_reg(s, A_WAVE, 4), MCHP_TCC_WAVE, RAMP) & 3;
+}
+
+/* The extra tick of cycle @cycle for @dithercy (DS 34.6.3.3) */
+static uint32_t tcc_dith_extra(unsigned bits, uint32_t dithercy,
+                               unsigned cycle)
+{
+    uint32_t mask = MAKE_64BIT_MASK(0, bits);
+
+    return ((cycle * dithercy) & mask) + dithercy > mask;
+}
+
+/* PER or CCx as the counter uses it this cycle */
+static uint32_t tcc_value(MchpTccState *s, uint32_t raw)
+{
+    unsigned bits = tcc_dith_bits(s);
+
+    if (!bits) {
+        return raw & tcc_max(s);
+    }
+    return ((raw >> bits) & tcc_max(s)) +
+           tcc_dith_extra(bits, raw & MAKE_64BIT_MASK(0, bits),
+                          s->dith_cycle);
 }
 
