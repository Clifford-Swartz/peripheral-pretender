+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_SYNCBUSY), ==, 0);
+    qtest_writel(qts, TCC0 + R_WAVE, NPWM | POL(0));
+    g_assert_cmphex(qtest_readl(qts, TCC0 + R_WAVE), ==, NPWM | POL(0));
