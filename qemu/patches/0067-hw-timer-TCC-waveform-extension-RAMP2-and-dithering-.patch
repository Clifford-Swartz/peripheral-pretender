+/*
+ * DTIEN0, DTLS 5, DTHS 10: WO[0] (the low side) rises 5 GCLK cycles after
+ * CMP0 does, WO[4] (the inverted high side) 10 after CMP0 falls; both
+ * are off before the first tick
+ */
+static void test_dti(void)
+{
+    QTestState *qts = wave_init(NPWM, DTIEN0 | DTLS(5) | DTHS(10));
+
+    wave_enable(qts, 0);
+    wave_tick(qts, 3);                      /* CMP0 rose at 1 */
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x00);
+    wave_tick(qts, 10);
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x01);
+    wave_tick(qts, 25);                     /* CMP0 fell at 21 */
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x00);
+    wave_tick(qts, 35);
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x10);
+    wave_tick(qts, 103);                    /* CMP0 rose at 101 */
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x00);
+    wave_tick(qts, 110);
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x01);
+    qtest_quit(qts);
+}
+
+/* SWAP0 exchanges WO[0] and WO[4] (OTMX 3: CC0 and CC1) */
+static void test_swap(void)
+{
+    QTestState *qts = wave_init(NPWM | SWAP(0), OTMX(3));
+
+    wave_enable(qts, 0);
+    wave_tick(qts, 30);
+    g_assert_cmphex(wo(qts) & 0x11, ==, 0x01);
+    qtest_quit(qts);
+}
