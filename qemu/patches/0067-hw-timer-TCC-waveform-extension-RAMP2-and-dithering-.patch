+ * The waveform outputs drive the pads muxed to them, and the counter only
+ * stops coasting over output changes while a pad selects one. Each output
+ * goes through the waveform extension as on a PIC32CM MC00
+ * (firmware/hello/tests/tccprobe2.c, tccprobe3.c): the output matrix
+ * (WEXCTRL.OTMX) routes the channels' STATUS.CMPx to the outputs; dead
+ * time (DTIENx) turns slice x into WO[x], the low side, and
+ * WO[x + outputs/2], the inverted high side, each rising DTLS or DTHS
+ * GCLK_TCC cycles after its edge, both off before the first tick; SWAPx
+ * exchanges the slice's outputs; PATT forces outputs (PATTBUF copied at an
+ * update); DRVCTRL.INVENx inverts last. A STOP command or the end of a
+ * one-shot puts each output in its non-recoverable state (DS 31.6.2.4):
+ * NRVx when DRVCTRL.NREx is set, else floating (silicon: the pads stop
+ * being driven); the EV1 STOP action (pause) keeps the outputs.
+ * DSCRITICAL sets channel x (x < channels/2) on CCx counting up and clears
+ * it on CC(x + channels/2) counting down; the other channels count as
+ * DSBOTTOM. RAMP2 enables even channels in cycle A and odd ones in cycle
+ * B; RAMP2A drives WO[0] and WO[1] from CC0; RAMP2C counts cycle A to CC0
+ * and cycle B to PER, WO[0] high in cycle A until CC2. STATUS.IDX is the
+ * cycle. Dithering (CTRLA.RESOLUTION) adds the extra ticks of PER and CCx
+ * the data sheet's algorithm gives, cycle by cycle. The units an instance
+ * lacks (MchpInstanceInfo.features, .outputs, .channels) keep their bits
+ * at zero, as on silicon. WAVE and PATT synchronize for 4 GCLK_TCC
+ * cycles, and silicon drops a write made meanwhile.
+ * Not modelled: faults, circular buffers, capture, CTRLBSET.IDXCMD,
+ * sleep.
  *
  * Counting is event driven on QEMU_CLOCK_VIRTUAL: the timer fires at the
  * next tick that can change something and jumps over the rest.
@@ -81,6 +99,7 @@
 #define A_PER           A_MCHP_TCC_PER
 #define A_CC            A_MCHP_TCC_CC
 #define A_PERBUF        A_MCHP_TCC_PERBUF
+#define A_PATTBUF       A_MCHP_TCC_PATTBUF
 #define A_CCBUF         A_MCHP_TCC_CCBUF
 
 #define F(reg, field)   R_MCHP_TCC_##reg##_##field##_MASK
@@ -88,8 +107,17 @@
 #define MCHP_TCC_CHANNELS   4
 #define MCHP_TCC_OUTPUTS    8
 #define MCHP_TCC_MAX_STEPS  64
+#define MCHP_TCC_SLICES     4
+#define MCHP_TCC_WSYNC      4       /* GCLK_TCC cycles a WAVE/PATT write */
 #define NEVER               UINT64_MAX
 
+enum {
+    RAMP1 = 0,
+    RAMP2A = 1,
+    RAMP2 = 2,
+    RAMP2C = 3,
+};
+
 enum {
     NFRQ = MCHP_TCC_WAVE_WAVEGEN_NFRQ,
     MFRQ = MCHP_TCC_WAVE_WAVEGEN_MFRQ,
@@ -114,13 +142,20 @@ struct MchpTccState {
     qemu_irq wo[MCHP_TCC_OUTPUTS];
     uint8_t wo_active;          /* outputs a pad is muxed to */
     uint8_t wo_level;           /* levels last driven */
-    bool wo_restart;            /* stopped by STOP: outputs at COUNT */
-    bool wo_driven;
+    uint8_t wo_hiz;             /* outputs last left floating */
+    QEMUTimer *dti_timer;       /* the end of a dead time */
+    uint8_t dti_in;             /* output matrix level each slice saw */
+    int64_t dti_until[MCHP_TCC_SLICES];     /* dead time to, ns */
+    int64_t wsync_until[2];     /* WAVE, PATT synchronizing to, ns */
+    bool ramp_idx;              /* RAMP2 cycle: false A, true B */
+    uint8_t dith_cycle;         /* dithering: the cycle in the frame */
 
