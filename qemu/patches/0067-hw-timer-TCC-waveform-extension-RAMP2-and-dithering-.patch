+/*
+ * DSCRITICAL, PER 49, CC 10/20/30/40: CMP0 set on CC0 counting up and
+ * cleared on CC2 counting down, CMP1 on CC1 and CC3; CMP2 and CMP3 as in
+ * DSBOTTOM
+ */
+static void test_dscritical(void)
+{
+    QTestState *qts = wave_init(DSCRITICAL, 0);
+
+    qtest_writel(qts, TCC0 + R_PER, 49);
+    for (unsigned n = 0; n < 4; n++) {
+        qtest_writel(qts, TCC0 + R_CC(n), 10 * (n + 1));
+    }
+    wave_enable(qts, 0);
+    wave_tick(qts, 15);                     /* up, 15 */
+    g_assert_cmphex(cmp(qts), ==, 0x1);
+    wave_tick(qts, 60);                     /* down, 38 */
+    g_assert_cmphex(cmp(qts), ==, 0x5);
+    wave_tick(qts, 75);                     /* down, 23 */
+    g_assert_cmphex(cmp(qts), ==, 0x0);
