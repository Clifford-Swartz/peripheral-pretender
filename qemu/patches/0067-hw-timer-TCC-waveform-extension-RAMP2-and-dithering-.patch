+static uint32_t tcc_wmask(MchpTccState *s, hwaddr offset)
+{
+    const MchpInstanceInfo *info = MCHP_REGBLOCK(s)->info;
+    uint32_t chm = MAKE_64BIT_MASK(0, info->channels ?: MCHP_TCC_CHANNELS);
+    uint32_t om = MAKE_64BIT_MASK(0, info->outputs ?: MCHP_TCC_OUTPUTS);
+    uint8_t f = info->outputs ? info->features : 0xFF;
+
+    switch (offset) {
+    case A_WEXCTRL:
+        return (f & MCHP_TCC_FEAT_OTMX ? R_MCHP_TCC_WEXCTRL_OTMX_MASK : 0) |
+               (f & MCHP_TCC_FEAT_DTI ? 0xFFFF0F00 : 0);
+    case A_DRVCTRL:
+        return om | om << 8 | om << 16 | 0xFF000000;
+    case A_PATT:
+    case A_PATTBUF:
+        return f & MCHP_TCC_FEAT_PG ? om | om << 8 : 0;
+    case A_WAVE:
+        return 0xF7 | chm << 8 | chm << 16 |
+               (f & MCHP_TCC_FEAT_SWAP ? chm << 24 : 0);
+    }
+    return UINT32_MAX;
