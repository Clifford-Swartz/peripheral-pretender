+/*
+ * STOP puts output x at NRVx when DRVCTRL.NREx is set and leaves it
+ * floating otherwise; with DIV1 STATUS.CMPx reads 0 eight GCLK_TCC
+ * cycles later (silicon). A RETRIGGER drives the outputs again
+ */
+static void test_stop_state(void)
+{
+    QTestState *qts = wave_init(NPWM, 0);
+    uint64_t h0, l0, h1, l1;
+
+    qtest_writel(qts, TCC0 + R_DRVCTRL, NRE(0) | NRV(0) | NRE(1));
+    wave_enable(qts, 0);
+    wave_tick(qts, 30);
+    g_assert_cmphex(wo(qts) & 0x3, ==, 0x2);
+    qtest_writeb(qts, TCC0 + R_CTRLBSET, CMD_STOP);
+    g_assert_cmphex(wo(qts) & 0x3, ==, 0x1);
+    g_assert_cmphex(cmp(qts), ==, 0xE);
+    pa_stats(qts, 18, &h0, &l0);            /* WO[2] */
+    wave_tick(qts, 40);
+    g_assert_cmphex(cmp(qts), ==, 0);
+    pa_stats(qts, 18, &h1, &l1);
+    g_assert_cmpuint(h1 - h0 + l1 - l0, ==, 0);
+    qtest_writeb(qts, TCC0 + R_CTRLBSET, CMD_RETRIGGER);
+    wave_tick(qts, 45);                     /* COUNT 5 */
+    g_assert_cmphex(wo(qts) & 0xF, ==, 0xF);
+    qtest_quit(qts);
+}
