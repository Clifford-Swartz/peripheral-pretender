+/*
+ * TCC0 WO[0..7] on PA04, PA05 (function E), PA18, PA19, PA22, PA23, PA16
+ * and PA17 (function F)
+ */
+static const uint8_t wo_pin[8] = { 4, 5, 18, 19, 22, 23, 16, 17 };
+static int64_t wave_ns;         /* virtual time since wave_enable() */
+
+/* TCC0 at DIV1: PER 99, CC 20/40/60/80, the outputs on their pads */
+static QTestState *wave_init(uint32_t wave, uint32_t wexctrl)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * TCC0_GCLK_ID, 0x40);
+    qtest_writel(qts, TCC0 + R_WEXCTRL, wexctrl);
+    qtest_writel(qts, TCC0 + R_WAVE, wave);
+    qtest_writel(qts, TCC0 + R_PER, 99);
+    for (unsigned n = 0; n < 4; n++) {
+        qtest_writel(qts, TCC0 + R_CC(n), 20 * (n + 1));
+    }
+    for (unsigned x = 0; x < 8; x++) {
+        unsigned pin = wo_pin[x], f = x < 2 ? 4 : 5;
+        uint8_t pmux = qtest_readb(qts, PORT + 0x30 + pin / 2);
+
+        pmux = pin & 1 ? (pmux & 0x0F) | f << 4 : (pmux & 0xF0) | f;
+        qtest_writeb(qts, PORT + 0x30 + pin / 2, pmux);
+        qtest_writeb(qts, PORT + 0x40 + pin, 0x03);   /* PMUXEN, INEN */
+    }
+    return qts;
+}
+
+static void wave_enable(QTestState *qts, uint32_t ctrla)
+{
+    qtest_writel(qts, TCC0 + R_CTRLA, ctrla | ENABLE);
+    wave_ns = 0;
+}
+
+/* Step to the middle of DIV1 tick @n after the enable */
+static void wave_tick(QTestState *qts, unsigned n)
+{
+    int64_t t = (int64_t)n * TICK1_NS + TICK1_NS / 2;
+
+    g_assert_cmpint(t, >, wave_ns);
+    qtest_clock_step(qts, t - wave_ns);
+    wave_ns = t;
+}
+
+/* The pad levels of the outputs, bit x = WO[x] */
+static uint32_t wo(QTestState *qts)
+{
+    uint32_t in = qtest_readl(qts, PORT + 0x20), v = 0;
+
+    for (unsigned x = 0; x < 8; x++) {
+        v |= extract32(in, wo_pin[x], 1) << x;
+    }
+    return v;
+}
+
+/*
+ * The units each instance has, as silicon keeps them (tccprobe2 B0):
+ * TCC1 and TCC2 lack OTMX, DTI and SWAP, TCC2 the pattern generator
+ */
+static void test_units(void)
+{
+    static const uint32_t base[3] = { TCC0, TCC1, TCC2 };
+    static const uint32_t wex[3] = { 0xFFFF0F03, 0, 0 };
+    static const uint32_t drv[3] = { 0xFFFFFFFF, 0xFF0F0F0F, 0xFF030303 };
+    static const uint32_t patt[3] = { 0xFFFF, 0x0F0F, 0 };
+    static const uint32_t wave[3] = { 0x0F0F0FF7, 0x000303F7, 0x000303F7 };
+    QTestState *qts = qtest_init(MACHINE);
+
+    for (unsigned i = 0; i < 3; i++) {
+        qtest_writel(qts, base[i] + R_WEXCTRL, 0xFFFFFFFF);
+        qtest_writel(qts, base[i] + R_DRVCTRL, 0xFFFFFFFF);
+        qtest_writew(qts, base[i] + R_PATT, 0xFFFF);
+        qtest_writel(qts, base[i] + R_WAVE, 0xFFFFFFFF);
+        g_assert_cmphex(qtest_readl(qts, base[i] + R_WEXCTRL), ==, wex[i]);
+        g_assert_cmphex(qtest_readl(qts, base[i] + R_DRVCTRL), ==, drv[i]);
+        g_assert_cmphex(qtest_readw(qts, base[i] + R_PATT), ==, patt[i]);
+        g_assert_cmphex(qtest_readl(qts, base[i] + R_WAVE), ==, wave[i]);
+    }
+    qtest_quit(qts);
+}
+
+/*
+ * The output matrix: OTMX 0 WO[x] = CC(x % 4), 1 CC0 to even outputs and
+ * CC1 to odd ones, 3 CC0 to WO[0] and CC1 to the rest
+ */
+static void test_otmx(void)
+{
+    QTestState *qts = wave_init(NPWM, OTMX(0));
+
+    wave_enable(qts, 0);
+    wave_tick(qts, 50);
+    g_assert_cmphex(wo(qts), ==, 0xCC);
+    qtest_quit(qts);
+
+    qts = wave_init(NPWM, OTMX(1));
+    wave_enable(qts, 0);
+    wave_tick(qts, 10);
+    g_assert_cmphex(wo(qts), ==, 0xFF);
+    wave_tick(qts, 30);                     /* past CC0, before CC1 */
+    g_assert_cmphex(wo(qts), ==, 0xAA);
+    wave_tick(qts, 50);
+    g_assert_cmphex(wo(qts), ==, 0x00);
+    qtest_quit(qts);
+
+    qts = wave_init(NPWM, OTMX(3));
+    wave_enable(qts, 0);
+    wave_tick(qts, 30);
+    g_assert_cmphex(wo(qts), ==, 0xFE);
+    qtest_quit(qts);
+}
