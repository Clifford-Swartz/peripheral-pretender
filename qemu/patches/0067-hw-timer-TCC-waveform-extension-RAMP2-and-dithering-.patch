 /* Whole counter ticks between t_base and @now */
 static uint64_t tcc_ticks(MchpTccState *s, int64_t now)
 {
+    uint64_t d, lo, hi;
+
     if (!tcc_clock_counts(s) || now <= s->t_base) {
         return 0;
     }
-    return clock_ns_to_ticks(MCHP_REGBLOCK(s)->gclk, now - s->t_base) /
-           tcc_prescaler(s);
+    d = now - s->t_base;
+    lo = d << 32;
+    hi = d >> 32;
