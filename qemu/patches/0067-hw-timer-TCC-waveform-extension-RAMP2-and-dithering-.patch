+/*
+ * DITH4: PER 49 + 8/16 makes 16 cycles 808 ticks long; CC0 20 + 4/16
+ * holds WO[0] high 324 ticks in every 16 cycles of 50
+ */
+static void test_dither(void)
+{
+    QTestState *qts = wave_init(NPWM, 0);
+    uint64_t h0, l0, h1, l1;
+
+    qtest_writel(qts, TCC0 + R_CTRLA, DITH4);
+    qtest_writel(qts, TCC0 + R_PER, 49 << 4 | 8);
+    qtest_writel(qts, TCC0 + R_CC(0), 20 << 4);
+    wave_enable(qts, DITH4);
+    wave_tick(qts, 808);
+    g_assert_cmpuint(readsync(qts) >> 4, ==, 0);
+    wave_tick(qts, 812);
+    g_assert_cmpuint(readsync(qts) >> 4, ==, 4);
+    qtest_quit(qts);
+
+    qts = wave_init(NPWM, 0);
+    qtest_writel(qts, TCC0 + R_CTRLA, DITH4);
+    qtest_writel(qts, TCC0 + R_PER, 49 << 4);
+    qtest_writel(qts, TCC0 + R_CC(0), 20 << 4 | 4);
+    wave_enable(qts, DITH4);
+    wave_tick(qts, 800);
+    pa_stats(qts, 4, &h0, &l0);
+    wave_tick(qts, 1600);
+    pa_stats(qts, 4, &h1, &l1);
+    g_assert_cmpuint(h1 - h0, ==, 324 * TICK1_NS);
+    g_assert_cmpuint(l1 - l0, ==, 476 * TICK1_NS);
+    qtest_quit(qts);
+}
