+static void tcc_tick_at(MchpTccState *s, uint64_t n, int64_t *ns,
+                        uint32_t *frac)
+{
+    uint64_t lo, hi;
+
+    mulu64(&lo, &hi, clock_get(MCHP_REGBLOCK(s)->gclk),
+           n * tcc_prescaler(s));
+    lo += s->t_frac;
+    hi += lo < s->t_frac;
