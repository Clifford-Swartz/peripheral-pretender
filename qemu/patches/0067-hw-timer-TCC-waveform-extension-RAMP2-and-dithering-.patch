@@ -465,8 +506,8 @@ static void mchp_tc_step(MchpTcState *s, uint64_t n, bool ovf,
     uint32_t flags = 0, evctrl = mchp_tc_reg(s, A_EVCTRL, 2);
     bool down = mchp_tc_down(s);
 
-    s->t_base = mchp_tc_tick_time(s, n);
-    mchp_event_time_set(s->t_base);
+    mchp_tc_base_tick(s, n);
+    mchp_event_time_set(s->t_base + (s->t_frac != 0));
     if (ovf) {
         s->count = down ? mchp_tc_top(s) : 0;
