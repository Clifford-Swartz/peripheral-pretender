     mchp_tc_update_pads(s);
@@ -729,7 +770,7 @@ static void mchp_tc_count_event(MchpTcState *s, int64_t now)
         wat[ch] = wom[ch] == 1;
     }
     mchp_tc_step(s, 1, ovf == 1, at, wat);
-    s->t_base = now;
+    mchp_tc_base_set(s, now);
