diff --git a/hw/misc/rn2903.c b/hw/misc/rn2903.c
new file mode 100644
index 0000000..24cde54
--- /dev/null
+++ b/hw/misc/rn2903.c
@@ -0,0 +1,948 @@
+/*
+ * Microchip RN2903 LoRa(WAN) module on a UART
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A chardev the board connects to the UART the module sits on (57600 8N1).
+ * Commands end in CR LF, as every reply does. Modelled after the RN2903
+ * command reference (DS40001811A) as firmware drives it:
+ *
+ *   sys get ver / sys reset / sys factoryRESET   the version line
+ *   sys get hweui | vdd, sys sleep <ms>          ("ok" when it wakes)
+ *   mac reset, mac get/set deveui appeui devaddr dr adr pwridx ...,
+ *   mac set appkey nwkskey appskey, mac save, mac pause, mac resume
+ *   mac join otaa|abp      "ok", then "accepted" or "denied" (OTAA after
+ *                          the 5 s join-accept window, ABP at once)
+ *   mac tx cnf|uncnf <port> <hex>  "ok", then "mac_tx_ok", or "mac_rx
+ *                          <port> <hex>" when the network has a downlink,
+ *                          after the 1 s receive window
+ *   radio set/get mod freq pwr sf bw cr crc iqi sync prlen wdt
+ *   radio tx <hex>         "ok", then "radio_tx_ok" after the time on air
+ *                          (the LoRa formula with the radio settings)
+ *   radio rx <n>           "ok", then "radio_rx  <hex>" (two spaces, as
+ *                          the module sends it) when the other radio
+ *                          sends, or "radio_err" when the watchdog (wdt
+ *                          ms; 0: never) runs out
+ *
+ * with the documented errors: "invalid_param" (unknown commands, bad
+ * arguments), "busy", "not_joined", "keys_not_init", "mac_paused" (MAC
+ * commands while paused), "invalid_data_len" (US902-928 payload limits
+ * per data rate), and "busy" for radio commands until "mac pause". The
+ * version line goes out after a reset pulse (rn2903_reset_pin()), sys
+ * reset and factoryRESET; the power-on one goes out while the MCU is in
+ * reset, so it is not sent.
+ *
+ * The network and the other radio are QOM properties of this chardev
+ * (/chardevs/<id>, linked as /machine/<socket>-click): "join-accept"
+ * (bool, default true: OTAA joins are accepted), "downlink" (set text: it
+ * comes back once, as hex on port 1, on the next uplink), "peer-send"
+ * (set text: the other radio sends it, received by a pending radio rx or
+ * the next one), and "air" (read: the last lines of what went over the
+ * air, for front ends), "air-gen" (bumped per line). Not modelled:
+ * autobaud, the break, channels and their duty cycle, ADR, the frame
+ * counters' effect, retransmissions, the GPIOs and the EEPROM.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/cutils.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "chardev/char.h"
+#include "hw/core/irq.h"
+#include "hw/misc/rn2903.h"
+#include <math.h>
+
+#define RN_LINE             600
+#define RN_OUT              2048
+#define RN_AIR_LINES        12
+#define RN_REPLY_NS         50000
+#define RN_JOIN_NS          (5 * NANOSECONDS_PER_SECOND)
+#define RN_RX1_NS           NANOSECONDS_PER_SECOND
+
+typedef enum {
+    OP_NONE,
+    OP_JOIN,
+    OP_MAC_TX,
+    OP_RADIO_TX,
+    OP_RADIO_RX,
+    OP_SLEEP,
+} RnOp;
+
+OBJECT_DECLARE_SIMPLE_TYPE(Rn2903Chardev, CHARDEV_RN2903)
+
+struct Rn2903Chardev {
+    Chardev parent_obj;
+
+    bool in_reset;
+    char line[RN_LINE];
+    unsigned nline;
+    char *version;
+
+    /* MAC */
+    char deveui[17], appeui[17], devaddr[9];
+    bool appkey_set, nwkskey_set, appskey_set;
+    unsigned dr, pwridx;
+    bool adr, ar;
+    uint32_t upctr, dnctr;
+    bool joined, paused;
+    bool join_otaa;
+
+    /* Radio */
+    bool fsk;
+    uint32_t freq, bw, wdt;
+    int pwr;
+    unsigned sf, cr, prlen;     /* cr: 5..8 for 4/5..4/8 */
+    bool crc, iqi;
+    uint8_t sync;
+
+    /* What runs */
+    RnOp op;
+    char tx_data[512];          /* the uplink's or radio tx's hex */
+    unsigned tx_port;
+    bool tx_cnf;
+    QEMUTimer *op_timer;
+    QEMUTimer *wdt_timer;
+
+    /* The network and the other radio */
+    bool join_accept;
+    char *downlink;             /* text for the next uplink, or NULL */
+    char *peer_pending;         /* text sent before a radio rx */
+    GQueue *air;                /* char * lines */
+    uint32_t air_gen;
+
+    uint8_t out[RN_OUT];
+    unsigned nout;
+    QEMUTimer *tx_timer;
+};
+
+/* ---- output ---- */
+
+static void rn_flush(Rn2903Chardev *s)
+{
+    Chardev *chr = CHARDEV(s);
+    int n;
+
+    while (s->nout && (n = qemu_chr_be_can_write(chr)) > 0) {
+        n = MIN(n, (int)s->nout);
+        qemu_chr_be_write(chr, s->out, n);
+        memmove(s->out, s->out + n, s->nout - n);
+        s->nout -= n;
+    }
+}
+
+static void rn_tx_timer(void *opaque)
+{
+    rn_flush(opaque);
+}
+
+/* One reply line, CR LF added */
+static void rn_say(Rn2903Chardev *s, const char *text)
+{
+    size_t len = strlen(text);
+
+    if (s->in_reset || s->nout + len + 2 > RN_OUT) {
+        return;
+    }
+    memcpy(s->out + s->nout, text, len);
+    s->nout += len;
+    s->out[s->nout++] = '\r';
+    s->out[s->nout++] = '\n';
+    if (!timer_pending(s->tx_timer)) {
+        timer_mod(s->tx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  RN_REPLY_NS);
+    }
+}
+
+static void rn_air(Rn2903Chardev *s, const char *fmt, ...)
+    G_GNUC_PRINTF(2, 3);
+
+static void rn_air(Rn2903Chardev *s, const char *fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    g_queue_push_tail(s->air, g_strdup_vprintf(fmt, ap));
+    va_end(ap);
+    while (g_queue_get_length(s->air) > RN_AIR_LINES) {
+        g_free(g_queue_pop_head(s->air));
+    }
+    s->air_gen++;
+}
+
+/* ---- hex and text ---- */
+
+static bool is_hex(const char *p, size_t len)
+{
+    if (strlen(p) != len) {
+        return false;
+    }
+    for (; *p; p++) {
+        if (!g_ascii_isxdigit(*p)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool is_hex_bytes(const char *p)
+{
+    size_t n = strlen(p);
+
+    return n % 2 == 0 && is_hex(p, n);
+}
+
+static char *text_to_hex(const char *t)
+{
+    GString *g = g_string_new(NULL);
+
+    for (; *t; t++) {
+        g_string_append_printf(g, "%02X", (uint8_t)*t);
+    }
+    return g_string_free(g, false);
+}
+
+/* For the air log: printable as text, else the hex */
+static char *hex_to_text(const char *h)
+{
+    GString *g = g_string_new(NULL);
+
+    for (; h[0] && h[1]; h += 2) {
+        unsigned v = g_ascii_xdigit_value(h[0]) << 4 |
+                     g_ascii_xdigit_value(h[1]);
+
+        if (v == '\r' || v == '\n') {
+            continue;
+        }
+        g_string_append_c(g, v >= 0x20 && v < 0x7F ? v : '.');
+    }
+    return g_string_free(g, false);
+}
+
+/* ---- the radio ---- */
+
+/* LoRa time on air (Semtech AN1200.13) in ns, for @bytes of payload */
+static int64_t rn_airtime(Rn2903Chardev *s, unsigned bytes)
+{
+    double ts, sym, payload;
+    bool ldro;
+
+    if (s->fsk) {
+        return (int64_t)(bytes + 8) * 8 * 20 * SCALE_US;   /* 50 kbps */
+    }
+    ts = (double)(1 << s->sf) / (s->bw * 1000.0);          /* s */
+    ldro = ts > 0.016;
+    sym = ceil((8.0 * bytes - 4 * s->sf + 28 + (s->crc ? 16 : 0)) /
+               (4.0 * (s->sf - (ldro ? 2 : 0))));
+    payload = 8 + MAX(sym * s->cr, 0);
+    return (int64_t)(((s->prlen + 4.25) + payload) * ts * 1e9);
+}
+
+static void rn_defaults(Rn2903Chardev *s)
+{
+    memset(s->deveui, '0', 16);
+    s->deveui[16] = 0;
+    memset(s->appeui, '0', 16);
+    s->appeui[16] = 0;
+    memset(s->devaddr, '0', 8);
+    s->devaddr[8] = 0;
+    s->appkey_set = s->nwkskey_set = s->appskey_set = false;
+    s->dr = 3;
+    s->pwridx = 8;
+    s->adr = s->ar = false;
+    s->upctr = s->dnctr = 0;
+    s->joined = false;
+    s->fsk = false;
+    s->freq = 923300000;
+    s->pwr = 2;
+    s->sf = 12;
+    s->bw = 125;
+    s->cr = 5;
+    s->crc = true;
+    s->iqi = false;
+    s->sync = 0x34;
+    s->prlen = 8;
+    s->wdt = 15000;
+}
+
+static void rn_stop_ops(Rn2903Chardev *s)
+{
+    s->op = OP_NONE;
+    timer_del(s->op_timer);
+    timer_del(s->wdt_timer);
+}
+
+static void rn_reboot(Rn2903Chardev *s)
+{
+    rn_stop_ops(s);
+    s->nline = 0;
+    s->paused = false;
+    s->joined = false;
+    rn_say(s, s->version);
+}
+
+static void rn_after(Rn2903Chardev *s, RnOp op, int64_t ns)
+{
+    s->op = op;
+    timer_mod(s->op_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ns);
+}
+
+static void rn_radio_rx_done(Rn2903Chardev *s, const char *text)
+{
+    g_autofree char *hex = text_to_hex(text);
+    g_autofree char *reply = g_strdup_printf("radio_rx  %s", hex);
+
+    timer_del(s->wdt_timer);
+    s->op = OP_NONE;
+    rn_air(s, "P2P in: %s", text);
+    rn_say(s, reply);
+}
+
+static void rn_op_timer(void *opaque)
+{
+    Rn2903Chardev *s = opaque;
+    RnOp op = s->op;
+
+    s->op = OP_NONE;
+    switch (op) {
+    case OP_JOIN:
+        if (!s->join_otaa || s->join_accept) {
+            s->joined = true;
+            if (s->join_otaa) {
+                g_strlcpy(s->devaddr, "260B1A2C", sizeof(s->devaddr));
+            }
+            rn_air(s, "join (%s): accepted", s->join_otaa ? "OTAA" : "ABP");
+            rn_say(s, "accepted");
+        } else {
+            rn_air(s, "join (OTAA): denied");
+            rn_say(s, "denied");
+        }
+        break;
+    case OP_MAC_TX:
+        s->upctr++;
+        if (s->downlink) {
+            g_autofree char *hex = text_to_hex(s->downlink);
+            g_autofree char *reply = g_strdup_printf("mac_rx 1 %s", hex);
+
+            rn_air(s, "downlink (port 1): %s", s->downlink);
+            g_free(s->downlink);
+            s->downlink = NULL;
+            s->dnctr++;
+            rn_say(s, reply);
+        } else {
+            rn_say(s, "mac_tx_ok");
+        }
+        break;
+    case OP_RADIO_TX:
+        timer_del(s->wdt_timer);
+        rn_say(s, "radio_tx_ok");
+        break;
+    case OP_SLEEP:
+        rn_say(s, "ok");
+        break;
+    default:
+        break;
+    }
+}
+
+static void rn_wdt_timer(void *opaque)
+{
+    Rn2903Chardev *s = opaque;
+
+    if (s->op == OP_RADIO_RX || s->op == OP_RADIO_TX) {
+        rn_stop_ops(s);
+        rn_say(s, "radio_err");
+    }
+}
+
+static void rn_arm_wdt(Rn2903Chardev *s)
+{
+    if (s->wdt) {
+        timer_mod(s->wdt_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  (int64_t)s->wdt * SCALE_MS);
+    }
+}
+
+/* ---- commands ---- */
+
+/* US902-928 maximum application payload per data rate */
+static unsigned rn_max_len(unsigned dr)
+{
+    static const unsigned max[5] = { 11, 53, 125, 242, 242 };
+
+    return dr < 5 ? max[dr] : 0;
+}
+
+static bool rn_uint(const char *p, uint64_t *v)
+{
+    return p && *p && !qemu_strtou64(p, NULL, 10, v);
+}
+
+static const char *rn_mac_set(Rn2903Chardev *s, char **a, int n)
+{
+    uint64_t v;
+
+    if (n < 4) {
+        return "invalid_param";
+    }
+    if (!strcmp(a[2], "deveui") || !strcmp(a[2], "appeui")) {
+        if (!is_hex(a[3], 16)) {
+            return "invalid_param";
+        }
+        g_strlcpy(a[2][0] == 'd' ? s->deveui : s->appeui, a[3], 17);
+    } else if (!strcmp(a[2], "devaddr")) {
+        if (!is_hex(a[3], 8)) {
+            return "invalid_param";
+        }
+        g_strlcpy(s->devaddr, a[3], sizeof(s->devaddr));
+    } else if (!strcmp(a[2], "appkey") || !strcmp(a[2], "nwkskey") ||
+               !strcmp(a[2], "appskey")) {
+        if (!is_hex(a[3], 32)) {
+            return "invalid_param";
+        }
+        *(a[2][0] == 'n' ? &s->nwkskey_set :
+          a[2][3] == 'k' ? &s->appkey_set : &s->appskey_set) = true;
+    } else if (!strcmp(a[2], "dr")) {
+        if (!rn_uint(a[3], &v) || v > 4) {
+            return "invalid_param";
+        }
+        s->dr = v;
+    } else if (!strcmp(a[2], "pwridx")) {
+        if (!rn_uint(a[3], &v) || v < 5 || v > 10 || v == 6) {
+            return "invalid_param";
+        }
+        s->pwridx = v;
+    } else if (!strcmp(a[2], "adr") || !strcmp(a[2], "ar")) {
+        bool on = !g_ascii_strcasecmp(a[3], "on");
+
+        if (!on && g_ascii_strcasecmp(a[3], "off")) {
+            return "invalid_param";
+        }
+        *(a[2][1] == 'd' ? &s->adr : &s->ar) = on;
+    } else if (!strcmp(a[2], "upctr") || !strcmp(a[2], "dnctr")) {
+        if (!rn_uint(a[3], &v) || v > UINT32_MAX) {
+            return "invalid_param";
+        }
+        *(a[2][0] == 'u' ? &s->upctr : &s->dnctr) = v;
+    } else if (!strcmp(a[2], "retx") || !strcmp(a[2], "rxdelay1") ||
+               !strcmp(a[2], "linkchk") || !strcmp(a[2], "rx2") ||
+               !strcmp(a[2], "ch") || !strcmp(a[2], "sync") ||
+               !strcmp(a[2], "bat")) {
+        return "ok";                    /* accepted, not modelled */
+    } else {
+        return "invalid_param";
+    }
+    return "ok";
+}
+
+static char *rn_mac_get(Rn2903Chardev *s, char **a, int n)
+{
+    if (n < 3) {
+        return NULL;
+    }
+    if (!strcmp(a[2], "deveui")) {
+        return g_strdup(s->deveui);
+    } else if (!strcmp(a[2], "appeui")) {
+        return g_strdup(s->appeui);
+    } else if (!strcmp(a[2], "devaddr")) {
+        return g_strdup(s->devaddr);
+    } else if (!strcmp(a[2], "dr")) {
+        return g_strdup_printf("%u", s->dr);
+    } else if (!strcmp(a[2], "pwridx")) {
+        return g_strdup_printf("%u", s->pwridx);
+    } else if (!strcmp(a[2], "adr")) {
+        return g_strdup(s->adr ? "on" : "off");
+    } else if (!strcmp(a[2], "ar")) {
+        return g_strdup(s->ar ? "on" : "off");
+    } else if (!strcmp(a[2], "upctr")) {
+        return g_strdup_printf("%u", s->upctr);
+    } else if (!strcmp(a[2], "dnctr")) {
+        return g_strdup_printf("%u", s->dnctr);
+    } else if (!strcmp(a[2], "status")) {
+        return g_strdup_printf("%04X", s->joined ? 1 : 0);
+    }
+    return NULL;
+}
+
+static const char *rn_radio_set(Rn2903Chardev *s, char **a, int n)
+{
+    uint64_t v;
+
+    if (n < 4) {
+        return "invalid_param";
+    }
+    if (!strcmp(a[2], "mod")) {
+        if (strcmp(a[3], "lora") && strcmp(a[3], "fsk")) {
+            return "invalid_param";
+        }
+        s->fsk = a[3][0] == 'f';
+    } else if (!strcmp(a[2], "freq")) {
+        if (!rn_uint(a[3], &v) || v < 902000000 || v > 928000000) {
+            return "invalid_param";
+        }
+        s->freq = v;
+    } else if (!strcmp(a[2], "pwr")) {
+        if (!rn_uint(a[3], &v) || v < 2 || v > 20) {
+            return "invalid_param";
+        }
+        s->pwr = v;
+    } else if (!strcmp(a[2], "sf")) {
+        if (strncmp(a[3], "sf", 2) || !rn_uint(a[3] + 2, &v) ||
+            v < 7 || v > 12) {
+            return "invalid_param";
+        }
+        s->sf = v;
+    } else if (!strcmp(a[2], "bw")) {
+        if (!rn_uint(a[3], &v) || (v != 125 && v != 250 && v != 500)) {
+            return "invalid_param";
+        }
+        s->bw = v;
+    } else if (!strcmp(a[2], "cr")) {
+        if (strncmp(a[3], "4/", 2) || !rn_uint(a[3] + 2, &v) ||
+            v < 5 || v > 8) {
+            return "invalid_param";
+        }
+        s->cr = v;
+    } else if (!strcmp(a[2], "crc") || !strcmp(a[2], "iqi")) {
+        bool on = !g_ascii_strcasecmp(a[3], "on");
+
+        if (!on && g_ascii_strcasecmp(a[3], "off")) {
+            return "invalid_param";
+        }
+        *(a[2][0] == 'c' ? &s->crc : &s->iqi) = on;
+    } else if (!strcmp(a[2], "sync")) {
+        if (!is_hex_bytes(a[3]) || strlen(a[3]) > 16) {
+            return "invalid_param";
+        }
+        s->sync = g_ascii_xdigit_value(a[3][0]) << 4 |
+                  g_ascii_xdigit_value(a[3][1]);
+    } else if (!strcmp(a[2], "prlen")) {
+        if (!rn_uint(a[3], &v) || v > 65535) {
+            return "invalid_param";
+        }
+        s->prlen = v;
+    } else if (!strcmp(a[2], "wdt")) {
+        if (!rn_uint(a[3], &v) || v > UINT32_MAX) {
+            return "invalid_param";
+        }
+        s->wdt = v;
+    } else if (!strcmp(a[2], "bitrate") || !strcmp(a[2], "fdev") ||
+               !strcmp(a[2], "rxbw") || !strcmp(a[2], "afcbw") ||
+               !strcmp(a[2], "bt")) {
+        return "ok";                    /* FSK: accepted, not modelled */
+    } else {
+        return "invalid_param";
+    }
+    return "ok";
+}
+
+static char *rn_radio_get(Rn2903Chardev *s, char **a, int n)
+{
+    if (n < 3) {
+        return NULL;
+    }
+    if (!strcmp(a[2], "mod")) {
+        return g_strdup(s->fsk ? "fsk" : "lora");
+    } else if (!strcmp(a[2], "freq")) {
+        return g_strdup_printf("%u", s->freq);
+    } else if (!strcmp(a[2], "pwr")) {
+        return g_strdup_printf("%d", s->pwr);
+    } else if (!strcmp(a[2], "sf")) {
+        return g_strdup_printf("sf%u", s->sf);
+    } else if (!strcmp(a[2], "bw")) {
+        return g_strdup_printf("%u", s->bw);
+    } else if (!strcmp(a[2], "cr")) {
+        return g_strdup_printf("4/%u", s->cr);
+    } else if (!strcmp(a[2], "crc")) {
+        return g_strdup(s->crc ? "on" : "off");
+    } else if (!strcmp(a[2], "iqi")) {
+        return g_strdup(s->iqi ? "on" : "off");
+    } else if (!strcmp(a[2], "sync")) {
+        return g_strdup_printf("%02X", s->sync);
+    } else if (!strcmp(a[2], "prlen")) {
+        return g_strdup_printf("%u", s->prlen);
+    } else if (!strcmp(a[2], "wdt")) {
+        return g_strdup_printf("%u", s->wdt);
+    } else if (!strcmp(a[2], "snr")) {
+        return g_strdup("10");
+    }
+    return NULL;
+}
+
+static const char *rn_mac(Rn2903Chardev *s, char **a, int n)
+{
+    uint64_t port;
+    size_t len;
+
+    if (n < 2) {
+        return "invalid_param";
+    }
+    if (!strcmp(a[1], "pause")) {
+        if (s->op == OP_JOIN || s->op == OP_MAC_TX) {
+            return "0";
+        }
+        s->paused = true;
+        return "4294967295";
+    }
+    if (!strcmp(a[1], "resume")) {
+        s->paused = false;
+        return "ok";
+    }
+    if (s->paused && strcmp(a[1], "get")) {
+        return "mac_paused";
+    }
+    if (!strcmp(a[1], "reset")) {
+        rn_defaults(s);
+        return "ok";
+    }
+    if (!strcmp(a[1], "save")) {
+        return "ok";
+    }
+    if (!strcmp(a[1], "set")) {
+        return rn_mac_set(s, a, n);
+    }
+    if (!strcmp(a[1], "join")) {
+        bool otaa;
+
+        if (n < 3) {
+            return "invalid_param";
+        }
+        otaa = !g_ascii_strcasecmp(a[2], "otaa");
+        if (!otaa && g_ascii_strcasecmp(a[2], "abp")) {
+            return "invalid_param";
+        }
+        if (s->op != OP_NONE) {
+            return "busy";
+        }
+        if (otaa ? !s->appkey_set :
+                   !(s->nwkskey_set && s->appskey_set)) {
+            return "keys_not_init";
+        }
+        s->join_otaa = otaa;
+        s->joined = false;
+        rn_after(s, OP_JOIN, (otaa ? RN_JOIN_NS : 0) +
+                 rn_airtime(s, otaa ? 23 : 0));
+        return "ok";
+    }
+    if (!strcmp(a[1], "tx")) {
+        if (n < 5 || (strcmp(a[2], "cnf") && strcmp(a[2], "uncnf")) ||
+            !rn_uint(a[3], &port) || port < 1 || port > 223 ||
+            !is_hex_bytes(a[4])) {
+            return "invalid_param";
+        }
+        if (!s->joined) {
+            return "not_joined";
+        }
+        if (s->op != OP_NONE) {
+            return "busy";
+        }
+        len = strlen(a[4]) / 2;
+        if (len > rn_max_len(s->dr)) {
+            return "invalid_data_len";
+        }
+        g_strlcpy(s->tx_data, a[4], sizeof(s->tx_data));
+        s->tx_port = port;
+        s->tx_cnf = a[2][0] == 'c';
+        {
+            g_autofree char *text = hex_to_text(a[4]);
+
+            rn_air(s, "uplink (%s, port %u): %s",
+                   s->tx_cnf ? "cnf" : "uncnf", (unsigned)port, text);
+        }
+        rn_after(s, OP_MAC_TX, rn_airtime(s, len + 13) + RN_RX1_NS);
+        return "ok";
+    }
+    return "invalid_param";
+}
+
+static const char *rn_radio(Rn2903Chardev *s, char **a, int n)
+{
+    uint64_t v;
+
+    if (n < 2) {
+        return "invalid_param";
+    }
+    if (!strcmp(a[1], "set")) {
+        return rn_radio_set(s, a, n);
+    }
+    if (!strcmp(a[1], "cw")) {
+        if (n < 3) {
+            return "invalid_param";
+        }
+        if (!strcmp(a[2], "off")) {
+            rn_reboot(s);
+            return NULL;
+        }
+        return strcmp(a[2], "on") ? "invalid_param" : "ok";
+    }
+    if (!strcmp(a[1], "tx")) {
+        if (n < 3 || !is_hex_bytes(a[2]) || strlen(a[2]) > 510) {
+            return "invalid_param";
+        }
+        if (!s->paused || s->op != OP_NONE) {
+            return "busy";
+        }
+        {
+            g_autofree char *text = hex_to_text(a[2]);
+
+            rn_air(s, "P2P out: %s", text);
+        }
+        rn_after(s, OP_RADIO_TX, rn_airtime(s, strlen(a[2]) / 2));
+        rn_arm_wdt(s);
+        return "ok";
+    }
+    if (!strcmp(a[1], "rx")) {
+        if (n < 3 || !rn_uint(a[2], &v) || v > 65535) {
+            return "invalid_param";
+        }
+        if (!s->paused || s->op != OP_NONE) {
+            return "busy";
+        }
+        s->op = OP_RADIO_RX;
+        rn_arm_wdt(s);
+        if (s->peer_pending) {
+            g_autofree char *text = s->peer_pending;
+
+            s->peer_pending = NULL;
+            rn_say(s, "ok");
+            rn_radio_rx_done(s, text);
+            return NULL;
+        }
+        return "ok";
+    }
+    return "invalid_param";
+}
+
+static void rn_command(Rn2903Chardev *s, const char *cmd)
+{
+    g_auto(GStrv) a = g_strsplit(cmd, " ", 6);
+    int n = g_strv_length(a);
+    g_autofree char *got = NULL;
+    const char *reply = "invalid_param";
+
+    if (n == 0 || !*a[0]) {
+        return;
+    }
+    if (!strcmp(a[0], "sys")) {
+        if (n >= 3 && !strcmp(a[1], "get") && !strcmp(a[2], "ver")) {
+            reply = s->version;
+        } else if (n >= 3 && !strcmp(a[1], "get") &&
+                   !strcmp(a[2], "hweui")) {
+            reply = "0004A30B001A2B3C";
+        } else if (n >= 3 && !strcmp(a[1], "get") && !strcmp(a[2], "vdd")) {
+            reply = "3300";
+        } else if (n >= 2 && !strcmp(a[1], "reset")) {
+            rn_reboot(s);
+            return;
+        } else if (n >= 2 && !strcmp(a[1], "factoryRESET")) {
+            rn_defaults(s);
+            rn_reboot(s);
+            return;
+        } else if (n >= 3 && !strcmp(a[1], "sleep")) {
+            uint64_t ms;
+
+            if (!rn_uint(a[2], &ms) || ms < 100 || ms > UINT32_MAX) {
+                reply = "invalid_param";
+            } else {
+                rn_after(s, OP_SLEEP, ms * SCALE_MS);
+                return;
+            }
+        }
+    } else if (!strcmp(a[0], "mac")) {
+        if (n >= 2 && !strcmp(a[1], "get")) {
+            got = rn_mac_get(s, a, n);
+            reply = got ? got : "invalid_param";
+        } else {
+            reply = rn_mac(s, a, n);
+        }
+    } else if (!strcmp(a[0], "radio")) {
+        if (n >= 2 && !strcmp(a[1], "get")) {
+            got = rn_radio_get(s, a, n);
+            reply = got ? got : "invalid_param";
+        } else {
+            reply = rn_radio(s, a, n);
+        }
+    }
+    if (reply) {
+        rn_say(s, reply);
+    }
+}
+
+/* MCU to module */
+static int rn_chr_write(Chardev *chr, const uint8_t *buf, int len)
+{
+    Rn2903Chardev *s = CHARDEV_RN2903(chr);
+
+    if (s->in_reset) {
+        return len;
+    }
+    for (int i = 0; i < len; i++) {
+        char c = buf[i];
+
+        if (c == '\n') {
+            s->line[s->nline] = 0;
+            s->nline = 0;
+            rn_command(s, s->line);
+        } else if (c != '\r' && s->nline < RN_LINE - 1) {
+            s->line[s->nline++] = c;
+        }
+    }
+    return len;
+}
+
+static void rn_chr_accept_input(Chardev *chr)
+{
+    rn_flush(CHARDEV_RN2903(chr));
+}
+
+void rn2903_reset_pin(void *opaque, int n, int level)
+{
+    Rn2903Chardev *s = opaque;
+    bool low = level == 0;
+
+    if (s->in_reset && !low) {
+        s->in_reset = false;
+        rn_reboot(s);
+    } else if (low && !s->in_reset) {
+        s->in_reset = true;
+        s->nout = 0;
+        rn_stop_ops(s);
+    }
+}
+
+/* ---- the network and the other radio ---- */
+
+static bool rn_get_join_accept(Object *obj, Error **errp)
+{
+    return CHARDEV_RN2903(obj)->join_accept;
+}
+
+static void rn_set_join_accept(Object *obj, bool value, Error **errp)
+{
+    CHARDEV_RN2903(obj)->join_accept = value;
+}
+
+static char *rn_get_empty(Object *obj, Error **errp)
+{
+    return g_strdup("");
+}
+
+static void rn_set_downlink(Object *obj, const char *value, Error **errp)
+{
+    Rn2903Chardev *s = CHARDEV_RN2903(obj);
+
+    g_free(s->downlink);
+    s->downlink = *value ? g_strdup(value) : NULL;
+}
+
+static void rn_set_peer_send(Object *obj, const char *value, Error **errp)
+{
+    Rn2903Chardev *s = CHARDEV_RN2903(obj);
+
+    if (!*value) {
+        return;
+    }
+    if (s->op == OP_RADIO_RX) {
+        rn_radio_rx_done(s, value);
+    } else {
+        g_free(s->peer_pending);
+        s->peer_pending = g_strdup(value);
+    }
+}
+
+static char *rn_get_air(Object *obj, Error **errp)
+{
+    Rn2903Chardev *s = CHARDEV_RN2903(obj);
+    GString *g = g_string_new(NULL);
+
+    for (GList *l = s->air->head; l; l = l->next) {
+        g_string_append_printf(g, "%s%s", g->len ? "\n" : "",
+                               (char *)l->data);
+    }
+    return g_string_free(g, false);
+}
+
+static void rn_get_air_gen(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &CHARDEV_RN2903(obj)->air_gen, errp);
+}
+
+static char *rn_get_version(Object *obj, Error **errp)
+{
+    return g_strdup(CHARDEV_RN2903(obj)->version);
+}
+
+static void rn_set_version(Object *obj, const char *value, Error **errp)
+{
+    Rn2903Chardev *s = CHARDEV_RN2903(obj);
+
+    g_free(s->version);
+    s->version = g_strdup(value);
+}
+
+static bool rn_chr_open(Chardev *chr, ChardevBackend *backend, Error **errp)
+{
+    return true;
+}
+
+static void rn_init(Object *obj)
+{
+    Rn2903Chardev *s = CHARDEV_RN2903(obj);
+
+    s->version = g_strdup("RN2903 1.0.5 Nov 06 2018 10:45:27");
+    s->join_accept = true;
+    s->air = g_queue_new();
+    rn_defaults(s);
+    s->tx_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rn_tx_timer, s);
+    s->op_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rn_op_timer, s);
+    s->wdt_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rn_wdt_timer, s);
+    object_property_add_bool(obj, "join-accept", rn_get_join_accept,
+                             rn_set_join_accept);
+    object_property_add_str(obj, "downlink", rn_get_empty, rn_set_downlink);
+    object_property_add_str(obj, "peer-send", rn_get_empty,
+                            rn_set_peer_send);
+    object_property_add_str(obj, "air", rn_get_air, NULL);
+    object_property_add(obj, "air-gen", "uint32", rn_get_air_gen, NULL,
+                        NULL, NULL);
+    object_property_add_str(obj, "version", rn_get_version, rn_set_version);
+}
+
+static void rn_finalize(Object *obj)
+{
+    Rn2903Chardev *s = CHARDEV_RN2903(obj);
+
+    g_free(s->version);
+    g_free(s->downlink);
+    g_free(s->peer_pending);
+    g_queue_free_full(s->air, g_free);
+    timer_free(s->tx_timer);
+    timer_free(s->op_timer);
+    timer_free(s->wdt_timer);
+}
+
+static void rn_class_init(ObjectClass *oc, const void *data)
+{
+    ChardevClass *cc = CHARDEV_CLASS(oc);
+
+    cc->chr_open = rn_chr_open;
+    cc->chr_write = rn_chr_write;
+    cc->chr_accept_input = rn_chr_accept_input;
+}
