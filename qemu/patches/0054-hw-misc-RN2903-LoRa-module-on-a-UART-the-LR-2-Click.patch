+static const TypeInfo rn_types[] = {
+    {
+        .name = TYPE_CHARDEV_RN2903,
+        .parent = TYPE_CHARDEV,
+        .instance_size = sizeof(Rn2903Chardev),
+        .instance_init = rn_init,
+        .instance_finalize = rn_finalize,
+        .class_init = rn_class_init,
+    },
+};
