diff --git a/include/hw/misc/mchp_dac.h b/include/hw/misc/mchp_dac.h
new file mode 100644
index 0000000..cc8610a
--- /dev/null
+++ b/include/hw/misc/mchp_dac.h
@@ -0,0 +1,23 @@
+/*
+ * Microchip SAM D5x/E5x DAC (DAC U2502)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An mchp-regblock. GPIO inputs "start-event-in"[0..1] (EVSYS users
+ * START0/1). Properties: "value0", "value1" (the outputs, 12-bit codes,
+ * read-only) and "audio" (channel 0 as sound, see mchp_dac.c), sampled at
+ * "audio-rate" Hz.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_DAC_H
+#define HW_MISC_MCHP_DAC_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_DAC "mchp-dac"
+#define MCHP_DAC_START_EVENT_IN "start-event-in"
+
+#endif /* HW_MISC_MCHP_DAC_H */
