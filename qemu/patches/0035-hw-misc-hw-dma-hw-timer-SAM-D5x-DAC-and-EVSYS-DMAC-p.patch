diff --git a/hw/misc/mchp_dac.c b/hw/misc/mchp_dac.c
new file mode 100644
index 0000000..9448c9f
--- /dev/null
+++ b/hw/misc/mchp_dac.c
@@ -0,0 +1,305 @@
+/*
+ * Microchip SAM D5x/E5x DAC (DAC U2502)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Two 12-bit channels as in DS60001507 (DAC chapter), converting at once:
+ * a write of DATAx sets output x; so does a write of DATABUFx, unless
+ * EVCTRL.STARTEIx is set, when the buffered value goes out at the next
+ * START event (EVSYS user START0/1; CircuitPython's audioio starts a
+ * conversion at every overflow of a TC and refills DATABUF by DMA). With
+ * DACCTRLx.LEFTADJ the code is the top 12 bits of the 16-bit value.
+ * STATUS.READYx reads 1 while the DAC and channel x are enabled; RESULTx
+ * is the output code. Not modelled: references (codes, not volts),
+ * oversampling and the interpolation filter, refresh, the EMPTY and
+ * RESRDY flags, events and DMA triggers, the conversion time.
+ *
+ * The page plays channel 0 as sound: every output change is kept with
+ * its virtual time (mchp_event_time_ns(): a late burst of TC overflows
+ * keeps its spacing); reading "audio" turns the changes since the last read
+ * into a sample-and-hold waveform at "audio-rate" Hz, as "<rate> <seq>
+ * <base64 of signed 16-bit little-endian samples>" (code 2048 is 0), at
+ * most the last 250 ms; it reads "" while the output does not change.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/misc/mchp_dac.h"
+#include "hw/mchp/gen/dac_u2502.h"
+#include "migration/vmstate.h"
+
+#define DAC_NCH             2
+#define DAC_RING            16384       /* output changes kept */
+#define DAC_AUDIO_SPAN_NS   (250 * SCALE_MS)
+#define DAC_MID             2048
+
+typedef struct DacChange {
+    int64_t t;                  /* QEMU_CLOCK_VIRTUAL ns */
+    uint16_t code;
+} DacChange;
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpDacState, MCHP_DAC)
+
+struct MchpDacState {
+    MchpRegBlock parent_obj;
+
+    uint16_t out[DAC_NCH];      /* output codes */
+    uint16_t databuf[DAC_NCH];  /* DATABUF waiting for START (write-only) */
+    uint32_t audio_rate;
+
+    /* Channel 0 changes not yet turned into audio */
+    DacChange ring[DAC_RING];
+    unsigned head, count;
+    uint16_t audio_code;        /* the output at audio_next */
+    int64_t audio_next;         /* time of the next audio sample */
+    uint32_t audio_seq;
+};
+
+static uint32_t dac_reg(MchpDacState *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static bool dac_enabled(MchpDacState *s)
+{
+    return FIELD_EX32(dac_reg(s, A_MCHP_DAC_CTRLA, 1), MCHP_DAC_CTRLA, ENABLE);
+}
+
+static uint32_t dac_dacctrl(MchpDacState *s, unsigned ch)
+{
+    return dac_reg(s, A_MCHP_DAC_DACCTRL + 2 * ch, 2);
+}
+
+static bool dac_ch_ready(MchpDacState *s, unsigned ch)
+{
+    return dac_enabled(s) &&
+           FIELD_EX32(dac_dacctrl(s, ch), MCHP_DAC_DACCTRL, ENABLE);
+}
+
+/* The 12-bit code of a DATA/DATABUF value of channel @ch */
+static uint16_t dac_code(MchpDacState *s, unsigned ch, uint32_t value)
+{
+    if (FIELD_EX32(dac_dacctrl(s, ch), MCHP_DAC_DACCTRL, LEFTADJ)) {
+        return (value >> 4) & 0xFFF;
+    }
+    return value & 0xFFF;
+}
+
+static void dac_output(MchpDacState *s, unsigned ch, uint16_t code)
+{
+    DacChange *c;
+
+    if (!dac_ch_ready(s, ch) || s->out[ch] == code) {
+        return;
+    }
+    s->out[ch] = code;
+    if (ch) {
+        return;
+    }
+    if (s->count == DAC_RING) {
+        /* Nobody listens: the oldest change is the past */
+        s->audio_code = s->ring[s->head].code;
+        s->head = (s->head + 1) % DAC_RING;
+        s->count--;
+    }
+    c = &s->ring[(s->head + s->count) % DAC_RING];
+    c->t = mchp_event_time_ns();
+    c->code = code;
+    s->count++;
+}
+
+static void dac_start_event(void *opaque, int ch, int level)
+{
+    MchpDacState *s = opaque;
+
+    if (level <= 0 || ch >= DAC_NCH) {
+        return;
+    }
+    if (!(dac_reg(s, A_MCHP_DAC_EVCTRL, 1) &
+          (R_MCHP_DAC_EVCTRL_STARTEI0_MASK << ch))) {
+        return;
+    }
+    dac_output(s, ch, dac_code(s, ch, s->databuf[ch]));
+}
+
+static uint32_t dac_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                             unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpDacState *s = MCHP_DAC(rf->opaque);
+    uint32_t v = 0;
+
+    switch (ri->offset) {
+    case A_MCHP_DAC_STATUS:
+        for (unsigned ch = 0; ch < DAC_NCH; ch++) {
+            if (dac_ch_ready(s, ch)) {
+                v |= (R_MCHP_DAC_STATUS_READY0_MASK |
+                      R_MCHP_DAC_STATUS_EOC0_MASK) << ch;
+            }
+        }
+        return v;
+    case A_MCHP_DAC_SYNCBUSY:
+        return 0;
+    case A_MCHP_DAC_RESULT:
+        return idx < DAC_NCH ? s->out[idx] : 0;
+    default:
+        return stored;
+    }
+}
+
+static void dac_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                           unsigned idx, uint32_t old, uint32_t written,
+                           uint32_t we)
+{
+    MchpDacState *s = MCHP_DAC(rf->opaque);
+    uint32_t v = mchp_regfile_get(rf, ri, idx);
+
+    if (idx >= DAC_NCH) {
+        return;
+    }
+    switch (ri->offset) {
+    case A_MCHP_DAC_DATA:
+        dac_output(s, idx, dac_code(s, idx, v));
+        break;
+    case A_MCHP_DAC_DATABUF:
+        s->databuf[idx] = v;
+        if (!(dac_reg(s, A_MCHP_DAC_EVCTRL, 1) &
+              (R_MCHP_DAC_EVCTRL_STARTEI0_MASK << idx))) {
+            dac_output(s, idx, dac_code(s, idx, v));
+        }
+        break;
+    }
+}
+
+static char *dac_get_audio(Object *obj, Error **errp)
+{
+    MchpDacState *s = MCHP_DAC(obj);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t start = MAX(s->audio_next, now - DAC_AUDIO_SPAN_NS);
+    uint64_t n, rate = MAX(s->audio_rate, 1000);
+    g_autofree uint8_t *pcm = NULL;
+    g_autofree char *b64 = NULL;
+
+    /* Changes before the window only set where it starts */
+    while (s->count && s->ring[s->head].t <= start) {
+        s->audio_code = s->ring[s->head].code;
+        s->head = (s->head + 1) % DAC_RING;
+        s->count--;
+    }
+    if (!s->count || now <= start) {
+        s->audio_next = MAX(start, now);
+        return g_strdup("");
+    }
+    n = muldiv64(now - start, rate, NANOSECONDS_PER_SECOND);
+    pcm = g_malloc(2 * n + 2);
+    for (uint64_t i = 0; i < n; i++) {
+        int64_t t = start + muldiv64(i, NANOSECONDS_PER_SECOND, rate);
+
+        while (s->count && s->ring[s->head].t <= t) {
+            s->audio_code = s->ring[s->head].code;
+            s->head = (s->head + 1) % DAC_RING;
+            s->count--;
+        }
+        stw_le_p(&pcm[2 * i], (uint16_t)(((int)s->audio_code - DAC_MID) * 16));
+    }
+    s->audio_next = start + muldiv64(n, NANOSECONDS_PER_SECOND, rate);
+    b64 = g_base64_encode(pcm, 2 * n);
+    return g_strdup_printf("%" PRIu64 " %u %s", rate, ++s->audio_seq, b64);
+}
+
+static void dac_get_value(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    uint32_t value = *(uint16_t *)opaque;
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void dac_get_rate(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &MCHP_DAC(obj)->audio_rate, errp);
+}
+
+static void dac_set_rate(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    uint32_t rate;
+
+    if (!visit_type_uint32(v, name, &rate, errp)) {
+        return;
+    }
+    if (rate < 1000 || rate > 192000) {
+        error_setg(errp, "audio-rate must be 1000-192000 Hz");
+        return;
+    }
+    MCHP_DAC(obj)->audio_rate = rate;
+}
+
+static void dac_reset_hold(MchpRegBlock *rb)
+{
+    MchpDacState *s = MCHP_DAC(rb);
+
+    memset(s->out, 0, sizeof(s->out));
+    memset(s->databuf, 0, sizeof(s->databuf));
+    s->head = s->count = 0;
+    s->audio_code = 0;
+    s->audio_next = 0;
+}
+
+static void dac_init(Object *obj)
+{
+    MchpDacState *s = MCHP_DAC(obj);
+
+    s->audio_rate = 22050;
+    qdev_init_gpio_in_named(DEVICE(obj), dac_start_event,
+                            MCHP_DAC_START_EVENT_IN, DAC_NCH);
+    object_property_add(obj, "value0", "uint32", dac_get_value, NULL, NULL,
+                        &s->out[0]);
+    object_property_add(obj, "value1", "uint32", dac_get_value, NULL, NULL,
+                        &s->out[1]);
+    object_property_add(obj, "audio-rate", "uint32", dac_get_rate,
+                        dac_set_rate, NULL, NULL);
+    object_property_add_str(obj, "audio", dac_get_audio, NULL);
+}
+
+static const VMStateDescription vmstate_mchp_dac = {
+    .name = TYPE_MCHP_DAC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpDacState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_UINT16_ARRAY(out, MchpDacState, DAC_NCH),
+        VMSTATE_UINT16_ARRAY(databuf, MchpDacState, DAC_NCH),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void dac_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_dac;
+    c->pre_read = dac_pre_read;
+    c->post_write = dac_post_write;
+    c->reset_hold = dac_reset_hold;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_dac_types[] = {
+    {
+        .name = TYPE_MCHP_DAC,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpDacState),
+        .instance_init = dac_init,
+        .class_init = dac_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_dac_types)
diff --git a/hw/misc/mchp_evsys5x.c b/hw/misc/mchp_evsys5x.c
new file mode 100644
index 0000000..efd5fc6
--- /dev/null
+++ b/hw/misc/mchp_evsys5x.c
@@ -0,0 +1,326 @@
+/*
+ * Microchip SAM D5x/E5x Event System (EVSYS U2504)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Follows DS60001507 (EVSYS chapter): channel n routes generator
+ * CHANNEL.EVGEN (or a software event, SWEVT) to the users whose USER
+ * register holds n + 1. On the asynchronous path the users follow the
+ * generator's level; on the synchronous and resynchronized paths an edge
+ * selected by EDGSEL is an event: it sets CHINTFLAG.EVD (OVR when EVD was
+ * still set) and pulses the users. IRQ lines: EVSYS_0..3 for channels
+ * 0-3, EVSYS_OTHER for the rest. Users are always ready (CHSTATUS.RDYUSR,
+ * READYUSR); channels never busy.
+ *
+ * Not modelled: the channels' generic clocks, priorities and INTPEND
+ * arbitration beyond the lowest channel, ONDEMAND and RUNSTDBY, event
+ * latency.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/core/irq.h"
+#include "hw/misc/mchp_evsys.h"
+#include "hw/mchp/gen/evsys_u2504.h"
+#include "migration/vmstate.h"
+
+#define EV_NCH          MCHP_EVSYS_CHANNEL_COUNT
+#define EV_NUSERS       MCHP_EVSYS_USER_COUNT
+#define EV_CH(ch, r)    (MCHP_EVSYS_CHANNEL_OFFSET + \
+                         (ch) * MCHP_EVSYS_CHANNEL_STRIDE + (r))
+#define EV_EVD          R_MCHP_EVSYS_CHANNEL_CHINTFLAG_EVD_MASK
+#define EV_OVR          R_MCHP_EVSYS_CHANNEL_CHINTFLAG_OVR_MASK
+
+enum {
+    EV_PATH_SYNC,
+    EV_PATH_RESYNC,
+    EV_PATH_ASYNC,
+};
+
+enum {
+    EV_EDGE_NONE,
+    EV_EDGE_RISING,
+    EV_EDGE_FALLING,
+    EV_EDGE_BOTH,
+};
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpEvsys5xState, MCHP_EVSYS_U2504)
+
+struct MchpEvsys5xState {
+    MchpRegBlock parent_obj;
+
+    qemu_irq user[EV_NUSERS];
+    uint64_t gen_level[MCHP_EVSYS_MAX_GENERATORS / 64];
+    uint8_t user_level[EV_NUSERS];
+};
+
+static uint32_t ev_reg(MchpEvsys5xState *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static void ev_set_reg(MchpEvsys5xState *s, hwaddr off, unsigned size,
+                       uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
+static uint32_t ev_channel(MchpEvsys5xState *s, unsigned ch)
+{
+    return ev_reg(s, EV_CH(ch, A_MCHP_EVSYS_CHANNEL_CHANNEL), 4);
+}
+
+static unsigned ev_path(MchpEvsys5xState *s, unsigned ch)
+{
+    return FIELD_EX32(ev_channel(s, ch), MCHP_EVSYS_CHANNEL_CHANNEL, PATH);
+}
+
+static bool ev_gen_level(MchpEvsys5xState *s, unsigned gen)
+{
+    return gen && gen < MCHP_EVSYS_MAX_GENERATORS &&
+           extract64(s->gen_level[gen / 64], gen % 64, 1);
+}
+
+static unsigned ev_user_channel(MchpEvsys5xState *s, unsigned u)
+{
+    return FIELD_EX32(ev_reg(s, A_MCHP_EVSYS_USER + 4 * u, 4),
+                      MCHP_EVSYS_USER, CHANNEL);
+}
+
+static void ev_set_user(MchpEvsys5xState *s, unsigned u, bool level)
+{
+    if (s->user_level[u] != level) {
+        s->user_level[u] = level;
+        qemu_set_irq(s->user[u], level);
+    }
+}
+
+/* Users of asynchronous channels follow the generator; others idle at 0 */
+static void ev_update_users(MchpEvsys5xState *s)
+{
+    for (unsigned u = 0; u < EV_NUSERS; u++) {
+        unsigned sel = ev_user_channel(s, u), ch = sel - 1;
+        bool level = sel && ch < EV_NCH && ev_path(s, ch) >= EV_PATH_ASYNC &&
+                     ev_gen_level(s, FIELD_EX32(ev_channel(s, ch),
+                                                MCHP_EVSYS_CHANNEL_CHANNEL,
+                                                EVGEN));
+
+        ev_set_user(s, u, level);
+    }
+}
+
+/* An event on synchronous/resynchronized channel @ch */
+static void ev_event(MchpEvsys5xState *s, unsigned ch)
+{
+    hwaddr off = EV_CH(ch, A_MCHP_EVSYS_CHANNEL_CHINTFLAG);
+    uint8_t flags = ev_reg(s, off, 1);
+
+    ev_set_reg(s, off, 1, flags | EV_EVD | (flags & EV_EVD ? EV_OVR : 0));
+    for (unsigned u = 0; u < EV_NUSERS; u++) {
+        if (ev_user_channel(s, u) == ch + 1) {
+            qemu_irq_pulse(s->user[u]);
+        }
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void ev_edge(MchpEvsys5xState *s, unsigned ch, bool rising)
+{
+    unsigned edge = FIELD_EX32(ev_channel(s, ch), MCHP_EVSYS_CHANNEL_CHANNEL,
+                               EDGSEL);
+
+    if (ev_path(s, ch) >= EV_PATH_ASYNC) {
+        return;
+    }
+    if (edge == EV_EDGE_BOTH ||
+        edge == (rising ? EV_EDGE_RISING : EV_EDGE_FALLING)) {
+        ev_event(s, ch);
+    }
+}
+
+static void ev_set_generator(void *opaque, int gen, int level)
+{
+    MchpEvsys5xState *s = opaque;
+
+    if (!gen || gen >= MCHP_EVSYS_MAX_GENERATORS ||
+        ev_gen_level(s, gen) == (level > 0)) {
+        return;
+    }
+    s->gen_level[gen / 64] = deposit64(s->gen_level[gen / 64], gen % 64, 1,
+                                       level > 0);
+    for (unsigned ch = 0; ch < EV_NCH; ch++) {
+        if (FIELD_EX32(ev_channel(s, ch), MCHP_EVSYS_CHANNEL_CHANNEL,
+                       EVGEN) == gen) {
+            ev_edge(s, ch, level > 0);
+        }
+    }
+    ev_update_users(s);
+}
+
+static void ev_set_user_busy(void *opaque, int u, int level)
+{
+    /* Users are always ready */
+}
+
+static void ev_swevt(MchpEvsys5xState *s, uint32_t channels)
+{
+    for (unsigned ch = 0; ch < EV_NCH; ch++) {
+        if (!(channels & BIT(ch))) {
+            continue;
+        }
+        if (ev_path(s, ch) >= EV_PATH_ASYNC) {
+            for (unsigned u = 0; u < EV_NUSERS; u++) {
+                if (ev_user_channel(s, u) == ch + 1) {
+                    qemu_irq_pulse(s->user[u]);
+                }
+            }
+            continue;
+        }
+        ev_edge(s, ch, true);
+        ev_edge(s, ch, false);
+    }
+}
+
+static uint8_t ev_pending(MchpEvsys5xState *s, unsigned ch)
+{
+    return ev_reg(s, EV_CH(ch, A_MCHP_EVSYS_CHANNEL_CHINTFLAG), 1) &
+           ev_reg(s, EV_CH(ch, A_MCHP_EVSYS_CHANNEL_CHINTENSET), 1);
+}
+
+static uint32_t ev_irq_lines(MchpRegBlock *rb)
+{
+    MchpEvsys5xState *s = MCHP_EVSYS_U2504(rb);
+    uint32_t lines = 0;
+
+    for (unsigned ch = 0; ch < EV_NCH; ch++) {
+        if (ev_pending(s, ch)) {
+            lines |= BIT(MIN(ch, 4));
+        }
+    }
+    return lines;
+}
+
+static bool ev_irq_pending(MchpRegBlock *rb)
+{
+    return ev_irq_lines(rb) != 0;
+}
+
+static uint32_t ev_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                            unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpEvsys5xState *s = MCHP_EVSYS_U2504(rf->opaque);
+    uint32_t off = mchp_regfile_elem_offset(ri, idx);
+    uint32_t v = 0;
+
+    switch (off) {
+    case A_MCHP_EVSYS_INTPEND:
+        for (unsigned ch = 0; ch < EV_NCH; ch++) {
+            uint8_t f = ev_reg(s, EV_CH(ch, A_MCHP_EVSYS_CHANNEL_CHINTFLAG), 1);
+
+            if (f) {
+                return ch | (f & EV_OVR ? R_MCHP_EVSYS_INTPEND_OVR_MASK : 0) |
+                       (f & EV_EVD ? R_MCHP_EVSYS_INTPEND_EVD_MASK : 0) |
+                       R_MCHP_EVSYS_INTPEND_READY_MASK;
+            }
+        }
+        return R_MCHP_EVSYS_INTPEND_READY_MASK;
+    case A_MCHP_EVSYS_INTSTATUS:
+        for (unsigned ch = 0; ch < EV_NCH; ch++) {
+            v |= ev_pending(s, ch) ? BIT(ch) : 0;
+        }
+        return v;
+    case A_MCHP_EVSYS_BUSYCH:
+        return 0;
+    case A_MCHP_EVSYS_READYUSR:
+        return UINT32_MAX;
+    default:
+        break;
+    }
