diff --git a/tests/qtest/curiosity-cp-test.c b/tests/qtest/curiosity-cp-test.c
index 85eb6bb..3e0c05d 100644
--- a/tests/qtest/curiosity-cp-test.c
+++ b/tests/qtest/curiosity-cp-test.c
@@ -27,6 +27,9 @@
 #define PORT            0x41008000
 #define TRNG            0x42002800
 #define DMAC            0x4100A000
+#define EVSYS           0x4100E000
+#define TC0             0x40003800
+#define DAC             0x43002400
 #define SRAM            0x20000000
 #define QSPI            0x42003400
 #define QSPI_AHB        0x04000000
@@ -288,6 +291,88 @@ static void test_neopixels(void)
     qtest_quit(qts);
 }
 
+static uint32_t qom_u32(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': %s, 'property': %s } }", path, prop);
+    uint32_t v = qdict_get_int(rsp, "return");
+
+    qobject_unref(rsp);
+    return v;
+}
+
+/*
+ * CircuitPython's audioio, by hand: TC0 overflows at 1 MHz; EVSYS channel
+ * 0 routes the overflow event (asynchronous path) to the DAC's START0;
+ * the overflow is also the DMAC trigger of channel 0, which loops over
+ * four samples into DATABUF0 and signals each block end through EVSYS
+ * channel 1 (synchronous, EVD interrupt). The DAC's output steps through
+ * the samples and its "audio" property carries them.
+ */
+static void test_dac_audio(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    uint32_t desc = SRAM + 0x1000, wb = SRAM + 0x1200, buf = SRAM + 0x2000;
+    static const uint16_t samples[] = { 0x1000, 0x5000, 0x9000, 0xD000 };
+    unsigned seen = 0;
+    QDict *rsp;
+    const char *audio;
+
+    for (unsigned i = 0; i < 4; i++) {
+        qtest_writew(qts, buf + 2 * i, samples[i]);
+    }
+    qtest_writeb(qts, DAC + 0x02, 0x01);            /* EVCTRL.STARTEI0 */
+    qtest_writew(qts, DAC + 0x0C, 0x0003);          /* DACCTRL0: on, LEFTADJ */
+    qtest_writeb(qts, DAC + 0x00, 0x02);            /* ENABLE */
+    g_assert_cmphex(qtest_readb(qts, DAC + 0x07) & 1, ==, 1);   /* READY0 */
+    qtest_writew(qts, DAC + 0x10, 0x8000);          /* DATA0: mid-scale */
+    g_assert_cmpuint(qom_u32(qts, "/machine/soc/dac", "value0"), ==, 0x800);
+
+    qtest_writel(qts, EVSYS + 0x120 + 4 * 61, 1);   /* USER DAC START0: ch 0 */
+    qtest_writel(qts, EVSYS + 0x20, 73 | 2 << 8);   /* TC0 OVF, async */
+    qtest_writel(qts, EVSYS + 0x28, 34 | 1 << 10);  /* DMAC CH0, sync, rise */
+    qtest_writeb(qts, EVSYS + 0x2D, 0x02);          /* CHINTENSET1.EVD */
+
