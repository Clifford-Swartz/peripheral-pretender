+/*
+ * DMAC triggers pulsed by their peripheral: a TC's overflow (DMAC_ID_OVF)
+ * goes to DMAC input "trigger"[id]; the DMAC tells the TC whether a
+ * channel waits for it, so that the TC only then runs to every overflow
+ */
+static void pic32cm_dmac_pulses(Pic32cmSocState *s)
+{
+    DeviceState *dmac = pic32cm_soc_periph(s, "DMAC");
+
+    if (!dmac || !object_dynamic_cast(OBJECT(dmac), TYPE_MCHP_DMAC)) {
+        return;
+    }
+    for (unsigned i = 0; i < s->dev->ndmac_triggers; i++) {
+        const MchpPeriphRef *ref = &s->dev->dmac_triggers[i];
+        DeviceState *dev = pic32cm_soc_periph(s, ref->instance);
+
+        if (ref->id >= MCHP_DMAC_MAX_TRIGGERS || !dev ||
+            !object_dynamic_cast(OBJECT(dev), TYPE_MCHP_TC) ||
+            strcmp(ref->param, "DMAC_ID_OVF")) {
+            continue;
+        }
+        qdev_connect_gpio_out_named(dev, MCHP_TC_OVF_DMA, 0,
+            qdev_get_gpio_in_named(dmac, MCHP_DMAC_TRIGGER, ref->id));
+        qdev_connect_gpio_out_named(dmac, MCHP_DMAC_TRIGGER_WANTED, ref->id,
+            qdev_get_gpio_in_named(dev, MCHP_TC_OVF_DMA_WANTED, 0));
+    }
+}
+
 static bool pic32cm_realize_periph(Pic32cmSocState *s, uint8_t rev,
                                    Error **errp)
 {
@@ -722,7 +753,9 @@ static void pic32cm_connect_events(Pic32cmSocState *s)
 {
     DeviceState *evsys = pic32cm_soc_periph(s, "EVSYS");
 
-    if (!evsys || !object_dynamic_cast(OBJECT(evsys), TYPE_MCHP_EVSYS)) {
+    if (!evsys || (!object_dynamic_cast(OBJECT(evsys), TYPE_MCHP_EVSYS) &&
+                   !object_dynamic_cast(OBJECT(evsys),
+                                        TYPE_MCHP_EVSYS_U2504))) {
         return;
     }
     for (unsigned i = 0; i < s->dev->nevents; i++) {
@@ -894,6 +927,7 @@ static void pic32cm_soc_realize(DeviceState *dev, Error **errp)
     pic32cm_connect_resets(s);
     pic32cm_connect_eic(s);
     pic32cm_connect_events(s);
+    pic32cm_dmac_pulses(s);
     pic32cm_connect_pads(s);
 }
 
