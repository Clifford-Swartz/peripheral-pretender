index 0393c90..6f0002f 100644
--- a/include/hw/misc/mchp_regblock.h
+++ b/include/hw/misc/mchp_regblock.h
@@ -109,6 +109,16 @@ void mchp_regblock_set_info(MchpRegBlock *s, const MchpInstanceInfo *info);
 /* Recompute the IRQ output after a state change made outside an access. */
 void mchp_regblock_update_irq(MchpRegBlock *s);
 
+/*
+ * The virtual time (ns) of what is happening now: QEMU_CLOCK_VIRTUAL,
+ * unless a model catching up on events (a TC serving overflows its timer
+ * fired late for) has set the time of the event it is serving. Models
+ * that keep a timeline of what they are driven to (the DAC's audio) use
+ * it, so that a burst of late events keeps its spacing.
+ */
+int64_t mchp_event_time_ns(void);
+void mchp_event_time_set(int64_t ns);   /* < 0: back to the clock */
+
 /* Set output clock @out of @s to @hz; a change is traced and propagated. */
 void mchp_regblock_set_clock(MchpRegBlock *s, Clock *out, uint64_t hz);
 
