+/* A pulsed trigger: one pending per channel that selects it */
+static void dmac_trigger_in(void *opaque, int id, int level)
+{
+    MchpDmacState *s = opaque;
+    uint32_t pulsed = 0;
+
+    if (level <= 0) {
+        return;
+    }
+    for (unsigned ch = 0; ch < DMAC_NCH; ch++) {
+        uint32_t ctrla = dmac_reg(s, DMAC_CH(ch, A_MCHP_DMAC_CHANNEL_CHCTRLA),
+                                  4);
+
+        if (dmac_runnable(s, ch) &&
+            FIELD_EX32(ctrla, MCHP_DMAC_CHANNEL_CHCTRLA, TRIGSRC) == id) {
+            s->pulses[ch] = 1;
+            pulsed |= BIT(ch);
+        }
+    }
+    if (pulsed) {
+        dmac_run_channels(s, pulsed);
+    }
+}
