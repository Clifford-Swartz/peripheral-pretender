+++ b/include/hw/misc/mchp_evsys.h
@@ -25,6 +25,8 @@
 #include "hw/misc/mchp_regblock.h"
 
 #define TYPE_MCHP_EVSYS "mchp-evsys"
+/* SAM D5x/E5x EVSYS U2504: same GPIO names (mchp_evsys5x.c) */
+#define TYPE_MCHP_EVSYS_U2504 "mchp-evsys-u2504"
 
 #define MCHP_EVSYS_GENERATOR "generator"
 #define MCHP_EVSYS_USER "user"
