+++ b/include/hw/timer/mchp_tc.h
@@ -24,6 +24,12 @@
 #define TYPE_MCHP_TC "mchp-tc"
 
 #define MCHP_TC_OVF_EVENT "ovf-event"
+/*
+ * Pulsed at every overflow while the input "ovf-dma-wanted" is high: the
+ * DMAC trigger OVF and whether an enabled DMAC channel selects it
+ */
+#define MCHP_TC_OVF_DMA "ovf-dma"
+#define MCHP_TC_OVF_DMA_WANTED "ovf-dma-wanted"
 #define MCHP_TC_MC_EVENT "mc-event"
