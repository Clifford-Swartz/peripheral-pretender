 /* Signal the pads of group @g whose drive changed on "port-out". */
+/* Pins of group @g handed to peripheral function A (PMUXEN, PMUX = 0) */
+static uint32_t mchp_port_func_a(MchpPortState *s, unsigned g)
+{
+    uint32_t pmuxen = mchp_port_pincfg(s, g,
+                                       R_MCHP_PORT_GROUP_PINCFG_PMUXEN_MASK);
+    uint32_t pins = 0;
+
+    for (unsigned pin = 0; pin < MCHP_PORT_GROUP_PINS; pin++) {
+        hwaddr pmux = mchp_port_offset(g, A_MCHP_PORT_GROUP_PMUX + pin / 2);
+
+        if (extract32(pmuxen, pin, 1) &&
+            !extract32(mchp_regfile_peek(mchp_port_rf(s), pmux, 1),
+                       (pin & 1) * 4, 4)) {
+            pins |= BIT(pin);
+        }
+    }
+    return pins;
+}
+
+/*
+ * Signal "func-a": the pad level of each pin muxed to function A (EIC
+ * EXTINT/NMI), 0 for the other pins.
+ */
+static void mchp_port_update_func(MchpPortState *s, unsigned g)
+{
+    uint32_t level = mchp_port_pads(s, g) & mchp_port_func_a(s, g);
+    uint32_t changed = level ^ s->func_level[g];
+
+    s->func_level[g] = level;
+    for (unsigned pin = 0; pin < MCHP_PORT_GROUP_PINS; pin++) {
+        if (extract32(changed, pin, 1)) {
+            qemu_set_irq(s->func_a[g * MCHP_PORT_GROUP_PINS + pin],
+                         extract32(level, pin, 1));
+        }
+    }
+}
+
 static void mchp_port_update(MchpPortState *s, unsigned g)
 {
     uint32_t mask = mchp_port_drive_mask(s, g);
@@ -139,6 +179,7 @@ static void mchp_port_update(MchpPortState *s, unsigned g)
             qemu_set_irq(s->out[g * MCHP_PORT_GROUP_PINS + pin], value);
         }
     }
+    mchp_port_update_func(s, g);
 }
 
 /* WRCONFIG: PINCFG and PMUX of up to 16 pins in one write (DS 27.7.11) */
