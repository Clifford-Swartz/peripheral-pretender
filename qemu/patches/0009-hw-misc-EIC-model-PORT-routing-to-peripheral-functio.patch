+/*
+ * Microchip SAM/PIC32CM External Interrupt Controller (EIC U2254)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A TYPE_MCHP_REGBLOCK subclass configured with mchp_regblock_set_info().
+ * GPIO lines:
+ *   "extint"[16]   in: level of the pad routed to EXTINTn (0 or 1)
+ *   "nmi-in"       in: level of the NMI pad
+ *   "nmi"          out: the CPU's NMI request (NMIFLAG.NMI)
+ *   "event"[16]    out: pulse per detection with EVCTRL.EXTINTEOn set
+ * sysbus IRQ 0 is the EIC interrupt (INTFLAG & INTENSET).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_EIC_H
+#define HW_MISC_MCHP_EIC_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_EIC "mchp-eic"
+
+#define MCHP_EIC_EXTINT "extint"
+#define MCHP_EIC_NMI_IN "nmi-in"
+#define MCHP_EIC_NMI_OUT "nmi"
+#define MCHP_EIC_EVENT "event"
+
+#endif /* HW_MISC_MCHP_EIC_H */
