diff --git a/tests/qtest/pic32cm-eic-test.c b/tests/qtest/pic32cm-eic-test.c
new file mode 100644
index 0000000..3c86bec
--- /dev/null
+++ b/tests/qtest/pic32cm-eic-test.c
@@ -0,0 +1,180 @@
+/*
+ * QTest for the EIC of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Pads are driven through the PORT's QOM properties (pa-in, pa-in-mask)
+ * and reach the EIC through function A. Expected behaviour from
+ * DS60001638E chapter 25 and from PIC32CM MC00 silicon (the clock rule of
+ * synchronization).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro "
+
+#define GCLK            0x40001C00
+#define EIC             0x40002800
+#define PA              0x41000000
+#define SCB_ICSR        0xE000ED04
+#define NVIC_ISPR       0xE000E200
+
+#define E_CTRLA         0x00
+#define E_NMICTRL       0x01
+#define E_NMIFLAG       0x02
+#define E_SYNCBUSY      0x04
+#define E_INTENSET      0x10
+#define E_INTFLAG       0x14
+#define E_ASYNCH        0x18
+#define E_CONFIG0       0x1C
+
+#define P_PMUX          0x30
+#define P_PINCFG        0x40
+
+#define EIC_IRQ         3
+#define EIC_GCLK_ID     2
+#define PIN             16      /* PA16: EXTINT0 */
+#define NMI_PIN         8       /* PA08: NMI */
+
+static void drive(QTestState *qts, uint32_t mask, uint32_t level)
+{
+    QDict *rsp;
+
+    rsp = qtest_qmp(qts, "{ 'execute': 'qom-set', 'arguments':"
+                    " { 'path': '/machine/soc/port', 'property': 'pa-in',"
+                    " 'value': %u } }", level);
+    qobject_unref(rsp);
+    rsp = qtest_qmp(qts, "{ 'execute': 'qom-set', 'arguments':"
+                    " { 'path': '/machine/soc/port', 'property': 'pa-in-mask',"
+                    " 'value': %u } }", mask);
+    qobject_unref(rsp);
+}
+
+/* Mux @pin to function A (EIC) */
+static void mux_a(QTestState *qts, unsigned pin)
+{
+    qtest_writeb(qts, PA + P_PINCFG + pin, 0x03);           /* PMUXEN, INEN */
+    qtest_writeb(qts, PA + P_PMUX + pin / 2, 0x00);
+}
+
+static void eic_on(QTestState *qts, uint32_t config0, uint32_t asynch)
+{
+    qtest_writeb(qts, EIC + E_CTRLA, 0);
+    qtest_writel(qts, EIC + E_CONFIG0, config0);
+    qtest_writel(qts, EIC + E_ASYNCH, asynch);
+    qtest_writeb(qts, EIC + E_CTRLA, 0x02);
+    qtest_writel(qts, EIC + E_INTFLAG, 0xFFFFFFFF);
+}
+
+static void test_edges_and_irq(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK + 0x80 + 4 * EIC_GCLK_ID, 0x40);   /* GCLK0 */
+    mux_a(qts, PIN);
+    drive(qts, BIT(PIN), 0);
+    eic_on(qts, 0x1, 0);                                      /* RISE */
+    qtest_writel(qts, EIC + E_INTENSET, BIT(0));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, 0);
+    drive(qts, BIT(PIN), BIT(PIN));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, BIT(0));
+    g_assert_true(qtest_readl(qts, NVIC_ISPR) & BIT(EIC_IRQ));
+    qtest_writel(qts, EIC + E_INTFLAG, BIT(0));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, 0);
+
+    /* Not muxed to the EIC: no input */
+    qtest_writeb(qts, PA + P_PINCFG + PIN, 0x02);
+    drive(qts, BIT(PIN), 0);
+    qtest_writeb(qts, PA + P_PINCFG + PIN, 0x03);
+    qtest_writel(qts, EIC + E_INTFLAG, BIT(0));
+    drive(qts, BIT(PIN), BIT(PIN));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, BIT(0));
+    qtest_quit(qts);
+}
+
+static void test_level(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    mux_a(qts, PIN);
+    drive(qts, BIT(PIN), BIT(PIN));
+    eic_on(qts, 0x4, 0);                                      /* HIGH */
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, BIT(0));
+    qtest_writel(qts, EIC + E_INTFLAG, BIT(0));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, BIT(0));
+    drive(qts, BIT(PIN), 0);
+    qtest_writel(qts, EIC + E_INTFLAG, BIT(0));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, 0);
+    qtest_quit(qts);
+}
+
+/* Synchronous edges and their CTRLA synchronization need GCLK_EIC */
+static void test_clock(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    mux_a(qts, PIN);
+    drive(qts, BIT(PIN), 0);
+    qtest_writel(qts, GCLK + 0x80 + 4 * EIC_GCLK_ID, 0x40);
+    eic_on(qts, 0x1, 0);
+    qtest_writel(qts, GCLK + 0x80 + 4 * EIC_GCLK_ID, 0);
+    drive(qts, BIT(PIN), BIT(PIN));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, 0);
+    qtest_writeb(qts, EIC + E_CTRLA, 0);
+    g_assert_cmphex(qtest_readl(qts, EIC + E_SYNCBUSY), ==, 0x2);
+    qtest_writel(qts, GCLK + 0x80 + 4 * EIC_GCLK_ID, 0x40);
+    g_assert_cmphex(qtest_readl(qts, EIC + E_SYNCBUSY), ==, 0);
+
+    /* Asynchronous: no clock needed, no stall */
+    qtest_writel(qts, GCLK + 0x80 + 4 * EIC_GCLK_ID, 0);
+    drive(qts, BIT(PIN), 0);
+    eic_on(qts, 0x1, BIT(0));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_SYNCBUSY), ==, 0);
+    drive(qts, BIT(PIN), BIT(PIN));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, BIT(0));
+
+    /* CTRLA.CKSEL: CLK_ULP32K always runs */
+    qtest_writeb(qts, EIC + E_CTRLA, 0);
+    qtest_writel(qts, EIC + E_ASYNCH, 0);
+    qtest_writeb(qts, EIC + E_CTRLA, 0x12);
+    qtest_writel(qts, EIC + E_INTFLAG, BIT(0));
+    drive(qts, BIT(PIN), 0);
+    drive(qts, BIT(PIN), BIT(PIN));
+    g_assert_cmphex(qtest_readl(qts, EIC + E_INTFLAG), ==, BIT(0));
+    qtest_quit(qts);
+}
+
+/* NMI works with the EIC disabled and pends the CPU's NMI */
+static void test_nmi(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    mux_a(qts, NMI_PIN);
+    drive(qts, BIT(NMI_PIN), 0);
+    qtest_writeb(qts, EIC + E_NMICTRL, 0x11);           /* RISE, NMIASYNCH */
+    g_assert_cmphex(qtest_readb(qts, EIC + E_NMIFLAG), ==, 0);
+    drive(qts, BIT(NMI_PIN), BIT(NMI_PIN));
+    g_assert_cmphex(qtest_readb(qts, EIC + E_NMIFLAG), ==, 1);
+    g_assert_true(qtest_readl(qts, SCB_ICSR) & BIT(31));    /* NMIPENDSET */
+    qtest_writeb(qts, EIC + E_NMIFLAG, 1);
+    g_assert_cmphex(qtest_readb(qts, EIC + E_NMIFLAG), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-eic/edges-and-irq", test_edges_and_irq);
+    qtest_add_func("pic32cm-eic/level", test_level);
+    qtest_add_func("pic32cm-eic/clock", test_clock);
+    qtest_add_func("pic32cm-eic/nmi", test_nmi);
+
+    return g_test_run();
+}
