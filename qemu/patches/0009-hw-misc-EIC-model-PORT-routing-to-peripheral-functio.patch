diff --git a/hw/misc/mchp_eic.c b/hw/misc/mchp_eic.c
new file mode 100644
index 0000000..2c65161
--- /dev/null
+++ b/hw/misc/mchp_eic.c
@@ -0,0 +1,326 @@
+/*
+ * Microchip SAM/PIC32CM External Interrupt Controller (EIC U2254)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Follows DS60001638E chapter 25 (PIC32CM MC00) and DS60001632H chapter 24
+ * (PIC32CM JH01). Each EXTINT input carries the level of the pad PORT
+ * routes to the EIC (function A); NMI likewise. Edge detection needs the
+ * EIC clock (GCLK_EIC, or CLK_ULP32K with CTRLA.CKSEL) unless the line is
+ * asynchronous; level detection does not. A change of CTRLA.ENABLE made
+ * while the configuration needs the EIC clock (synchronous edges,
+ * filtering) and the clock is off keeps SYNCBUSY.ENABLE set until the
+ * clock runs (PIC32CM MC00 silicon).
+ * Filtering and debouncing take effect at once. Register semantics (W1C, aliases, enable protection,
+ * SWRST) come from the generated tables through mchp-regblock.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/core/clock.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/misc/mchp_eic.h"
+#include "hw/mchp/gen/eic_u2254.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define MCHP_EIC_LINES          16
+
+/* CONFIGn.SENSEx and NMICTRL.NMISENSE (DS 25.7.10) */
+enum {
+    MCHP_EIC_SENSE_NONE,
+    MCHP_EIC_SENSE_RISE,
+    MCHP_EIC_SENSE_FALL,
+    MCHP_EIC_SENSE_BOTH,
+    MCHP_EIC_SENSE_HIGH,
+    MCHP_EIC_SENSE_LOW,
+};
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpEicState, MCHP_EIC)
+
+struct MchpEicState {
+    MchpRegBlock parent_obj;
+
+    qemu_irq nmi;
+    qemu_irq event[MCHP_EIC_LINES];
+    uint32_t level;             /* EXTINT input levels */
+    bool nmi_level;
+    uint32_t sync_pending;      /* SYNCBUSY bits waiting for the EIC clock */
+};
+
+static uint32_t mchp_eic_reg(MchpEicState *s, hwaddr offset, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, offset, size);
+}
+
+static void mchp_eic_set_reg(MchpEicState *s, hwaddr offset, unsigned size,
+                             uint32_t val)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, offset, size, val);
+}
+
+static bool mchp_eic_enabled(MchpEicState *s)
+{
+    return FIELD_EX32(mchp_eic_reg(s, A_MCHP_EIC_CTRLA, 1), MCHP_EIC_CTRLA,
+                      ENABLE);
+}
+
+/* The clock that synchronous edge detection and filtering sample with */
+static bool mchp_eic_clocked(MchpEicState *s)
+{
+    return FIELD_EX32(mchp_eic_reg(s, A_MCHP_EIC_CTRLA, 1), MCHP_EIC_CTRLA,
+                      CKSEL) ||
+           clock_get_hz(MCHP_REGBLOCK(s)->gclk) != 0;
+}
+
+static unsigned mchp_eic_sense(MchpEicState *s, unsigned line);
+static bool mchp_eic_is_level(unsigned sense);
+
+/*
+ * Whether the configuration makes the EIC request its clock (DS 25.6.3):
+ * synchronous edge detection or filtering on a line, or on NMI.
+ */
+static bool mchp_eic_needs_clock(MchpEicState *s)
+{
+    uint32_t asynch = mchp_eic_reg(s, A_MCHP_EIC_ASYNCH, 4);
+    uint32_t nmi = mchp_eic_reg(s, A_MCHP_EIC_NMICTRL, 1);
+    unsigned nmisense = FIELD_EX32(nmi, MCHP_EIC_NMICTRL, NMISENSE);
+
+    for (unsigned line = 0; line < MCHP_EIC_LINES; line++) {
+        hwaddr reg = line < 8 ? A_MCHP_EIC_CONFIG0 : A_MCHP_EIC_CONFIG1;
+        unsigned sense = mchp_eic_sense(s, line);
+
+        if (extract32(mchp_eic_reg(s, reg, 4), (line % 8) * 4 + 3, 1) ||
+            (sense && !mchp_eic_is_level(sense) &&
+             !extract32(asynch, line, 1))) {
+            return true;
+        }
+    }
+    return FIELD_EX32(nmi, MCHP_EIC_NMICTRL, NMIFILTEN) ||
+           (nmisense && !mchp_eic_is_level(nmisense) &&
+            !FIELD_EX32(nmi, MCHP_EIC_NMICTRL, NMIASYNCH));
+}
+
+static unsigned mchp_eic_sense(MchpEicState *s, unsigned line)
+{
+    hwaddr reg = line < 8 ? A_MCHP_EIC_CONFIG0 : A_MCHP_EIC_CONFIG1;
+
+    return extract32(mchp_eic_reg(s, reg, 4), (line % 8) * 4, 3);
+}
+
+static bool mchp_eic_is_level(unsigned sense)
+{
+    return sense == MCHP_EIC_SENSE_HIGH || sense == MCHP_EIC_SENSE_LOW;
+}
+
+/* Does a change from @old to @new (or the level @new) match @sense? */
+static bool mchp_eic_match(unsigned sense, bool old, bool new)
+{
+    switch (sense) {
+    case MCHP_EIC_SENSE_RISE:
+        return !old && new;
+    case MCHP_EIC_SENSE_FALL:
+        return old && !new;
+    case MCHP_EIC_SENSE_BOTH:
+        return old != new;
+    case MCHP_EIC_SENSE_HIGH:
+        return new;
+    case MCHP_EIC_SENSE_LOW:
+        return !new;
+    default:
+        return false;
+    }
+}
+
+/*
+ * Evaluate the EXTINT lines in @lines after their inputs changed from
+ * @old (edges), or re-evaluate the level-sensitive ones (@old == level).
+ */
+static void mchp_eic_detect(MchpEicState *s, uint32_t old, uint32_t lines)
+{
+    uint32_t flags = mchp_eic_reg(s, A_MCHP_EIC_INTFLAG, 4);
+    uint32_t asynch = mchp_eic_reg(s, A_MCHP_EIC_ASYNCH, 4);
+    uint32_t evctrl = mchp_eic_reg(s, A_MCHP_EIC_EVCTRL, 4);
+    bool clocked = mchp_eic_clocked(s);
+
+    if (!mchp_eic_enabled(s)) {
+        return;
+    }
+    for (unsigned line = 0; line < MCHP_EIC_LINES; line++) {
+        unsigned sense = mchp_eic_sense(s, line);
+        bool was = extract32(old, line, 1), now = extract32(s->level, line, 1);
+
+        if (!extract32(lines, line, 1) || !mchp_eic_match(sense, was, now)) {
+            continue;
+        }
+        if (!mchp_eic_is_level(sense) && !extract32(asynch, line, 1) &&
+            !clocked) {
+            continue;           /* synchronous edges need the EIC clock */
+        }
+        if (!extract32(flags, line, 1) || !mchp_eic_is_level(sense)) {
+            trace_mchp_eic_detect(line, sense, now);
+            if (extract32(evctrl, line, 1)) {
+                qemu_irq_pulse(s->event[line]);
+            }
+        }
+        flags |= BIT(line);
+    }
+    mchp_eic_set_reg(s, A_MCHP_EIC_INTFLAG, 4, flags);
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+/* NMI detection only depends on NMICTRL.NMISENSE (DS 25.6.4.1). */
+static void mchp_eic_detect_nmi(MchpEicState *s, bool old)
+{
+    uint32_t ctrl = mchp_eic_reg(s, A_MCHP_EIC_NMICTRL, 1);
+    unsigned sense = FIELD_EX32(ctrl, MCHP_EIC_NMICTRL, NMISENSE);
+    bool flag = mchp_eic_reg(s, A_MCHP_EIC_NMIFLAG, 1) &
+                R_MCHP_EIC_NMIFLAG_NMI_MASK;
+
+    if (mchp_eic_match(sense, old, s->nmi_level) &&
+        (mchp_eic_is_level(sense) ||
+         FIELD_EX32(ctrl, MCHP_EIC_NMICTRL, NMIASYNCH) ||
+         mchp_eic_clocked(s))) {
+        if (!flag) {
+            trace_mchp_eic_detect(MCHP_EIC_LINES, sense, s->nmi_level);
+        }
+        flag = true;
+        mchp_eic_set_reg(s, A_MCHP_EIC_NMIFLAG, 1,
+                         R_MCHP_EIC_NMIFLAG_NMI_MASK);
+    }
+    qemu_set_irq(s->nmi, flag);
+}
+
+static void mchp_eic_set_extint(void *opaque, int line, int level)
+{
+    MchpEicState *s = opaque;
+    uint32_t old = s->level;
+
+    s->level = deposit32(s->level, line, 1, level > 0);
+    if (s->level != old) {
+        mchp_eic_detect(s, old, BIT(line));
+    }
+}
+
+static void mchp_eic_set_nmi(void *opaque, int n, int level)
+{
+    MchpEicState *s = opaque;
+    bool old = s->nmi_level;
+
+    s->nmi_level = level > 0;
+    if (s->nmi_level != old) {
+        mchp_eic_detect_nmi(s, old);
+    }
+}
+
+static uint32_t mchp_eic_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                  unsigned idx, uint32_t stored,
+                                  bool side_effects)
+{
+    MchpEicState *s = MCHP_EIC(rf->opaque);
+
+    if (!strcmp(ri->name, "PINSTATE")) {
+        return s->level;        /* debouncing is instant */
+    }
+    if (ri->offset == A_MCHP_EIC_SYNCBUSY) {
+        /* Synchronization is instant, but needs the EIC clock (silicon) */
+        if (mchp_eic_clocked(s)) {
+            s->sync_pending = 0;
+        }
+        return s->sync_pending;
+    }
+    return stored;
+}
+
+static void mchp_eic_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                unsigned idx, uint32_t old, uint32_t written,
+                                uint32_t we)
+{
+    MchpEicState *s = MCHP_EIC(rf->opaque);
+
+    switch (ri->offset) {
+    case A_MCHP_EIC_CTRLA:
+        if (written & we & R_MCHP_EIC_CTRLA_SWRST_MASK) {
+            return;             /* mchp-regblock resets the EIC next */
+        }
+        /*
+         * Synchronization waits for the EIC clock when the configuration
+         * needs that clock (seen on silicon)
+         */
+        if ((written & we & R_MCHP_EIC_CTRLA_ENABLE_MASK) != (old & we &
+             R_MCHP_EIC_CTRLA_ENABLE_MASK) &&
+            mchp_eic_needs_clock(s) && !mchp_eic_clocked(s)) {
+            s->sync_pending |= R_MCHP_EIC_SYNCBUSY_ENABLE_MASK;
+        }
+        /* fall through: enabling starts level detection */
+    case A_MCHP_EIC_INTFLAG:
+        /* A cleared level flag is set again while the level persists. */
+        mchp_eic_detect(s, s->level, UINT32_MAX);
+        break;
+    case A_MCHP_EIC_NMICTRL:
+    case A_MCHP_EIC_NMIFLAG:
+        mchp_eic_detect_nmi(s, s->nmi_level);
+        break;
+    }
+}
+
+static void mchp_eic_reset_exit(MchpRegBlock *rb)
+{
+    MchpEicState *s = MCHP_EIC(rb);
+
+    s->sync_pending = 0;
+    qemu_set_irq(s->nmi, 0);
+}
+
+static void mchp_eic_init(Object *obj)
+{
+    MchpEicState *s = MCHP_EIC(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    qdev_init_gpio_in_named(dev, mchp_eic_set_extint, MCHP_EIC_EXTINT,
+                            MCHP_EIC_LINES);
+    qdev_init_gpio_in_named(dev, mchp_eic_set_nmi, MCHP_EIC_NMI_IN, 1);
+    qdev_init_gpio_out_named(dev, &s->nmi, MCHP_EIC_NMI_OUT, 1);
+    qdev_init_gpio_out_named(dev, s->event, MCHP_EIC_EVENT, MCHP_EIC_LINES);
+}
+
+static const VMStateDescription vmstate_mchp_eic = {
+    .name = TYPE_MCHP_EIC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpEicState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_UINT32(level, MchpEicState),
+        VMSTATE_BOOL(nmi_level, MchpEicState),
+        VMSTATE_UINT32(sync_pending, MchpEicState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_eic_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_eic;
+    c->pre_read = mchp_eic_pre_read;
+    c->post_write = mchp_eic_post_write;
+    c->reset_exit = mchp_eic_reset_exit;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_eic_types[] = {
+    {
+        .name = TYPE_MCHP_EIC,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpEicState),
+        .instance_init = mchp_eic_init,
+        .class_init = mchp_eic_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_eic_types)
