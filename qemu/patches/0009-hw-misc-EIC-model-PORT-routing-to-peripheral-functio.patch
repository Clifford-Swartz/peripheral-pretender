                              MCHP_PORT_NUM_PINS);
     qdev_init_gpio_in_named(DEVICE(obj), mchp_port_set_input, MCHP_PORT_IN,
                             MCHP_PORT_NUM_PINS);
+    qdev_init_gpio_out_named(DEVICE(obj), s->func_a, MCHP_PORT_FUNC_A,
+                             MCHP_PORT_NUM_PINS);
 }
 
