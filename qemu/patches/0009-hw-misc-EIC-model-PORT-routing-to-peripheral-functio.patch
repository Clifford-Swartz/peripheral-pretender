+/*
+ * Pads to the EIC: every pin whose function A is EXTINTn (or NMI) feeds
+ * that input through PORT "func-a". Pins sharing an input are OR-ed;
+ * PORT drives 0 for pins not muxed to function A, so the OR follows the
+ * pin that is (the data sheet keeps the first programmed one active).
+ */
+static void pic32cm_connect_eic(Pic32cmSocState *s)
+{
+    DeviceState *port = pic32cm_periph(s, "PORT");
+    DeviceState *eic = pic32cm_periph(s, "EIC");
+    unsigned npins[17] = { 0 };         /* EXTINT0-15, NMI */
+
+    for (int pass = 0; pass < 2; pass++) {
+        unsigned seen[17] = { 0 };
+        DeviceState *gate[17] = { NULL };
+
+        for (unsigned i = 0; i < s->dev->nsignals; i++) {
+            const MchpSignalInfo *sig = &s->dev->signals[i];
+            bool nmi = !strcmp(sig->group, "NMI");
+            unsigned n = nmi ? 16 : sig->index;
+            qemu_irq in;
+
+            if (strcmp(sig->instance, "EIC") || sig->pmux != 0 ||
+                sig->pin < 0 || (!nmi && n >= 16)) {
+                continue;
+            }
+            if (pass == 0) {
+                npins[n]++;
+                continue;
+            }
+            in = nmi ? qdev_get_gpio_in_named(eic, MCHP_EIC_NMI_IN, 0)
+                     : qdev_get_gpio_in_named(eic, MCHP_EIC_EXTINT, n);
+            if (npins[n] > 1) {
+                if (!gate[n]) {
+                    g_autofree char *name = g_strdup_printf("eic-in%u-or", n);
+                    Object *or = object_new(TYPE_OR_IRQ);
+
+                    object_property_add_child(OBJECT(s), name, or);
+                    object_unref(or);
+                    object_property_set_int(or, "num-lines", npins[n],
+                                            &error_abort);
+                    qdev_realize(DEVICE(or), NULL, &error_abort);
+                    qdev_connect_gpio_out(DEVICE(or), 0, in);
+                    gate[n] = DEVICE(or);
+                }
+                in = qdev_get_gpio_in(gate[n], seen[n]++);
+            }
+            qdev_connect_gpio_out_named(port, MCHP_PORT_FUNC_A, sig->pin, in);
+        }
+    }
+    qdev_connect_gpio_out_named(eic, MCHP_EIC_NMI_OUT, 0,
+                                qdev_get_gpio_in_named(DEVICE(&s->armv7m),
+                                                       "NMI", 0));
+}
+
 /* Reset sources that RSTC records in RCAUSE */
 static void pic32cm_connect_resets(Pic32cmSocState *s)
 {
@@ -465,6 +522,7 @@ static void pic32cm_soc_realize(DeviceState *dev, Error **errp)
         return;
     }
     pic32cm_connect_resets(s);
+    pic32cm_connect_eic(s);
 }
 
