diff --git a/tests/qtest/pic32cm-dmac-test.c b/tests/qtest/pic32cm-dmac-test.c
index 6c0630e..1ec99ba 100644
--- a/tests/qtest/pic32cm-dmac-test.c
+++ b/tests/qtest/pic32cm-dmac-test.c
@@ -41,6 +41,28 @@
 #define DMAENABLE       0x0002
 #define CRCENABLE       0x0004
 #define LVLEN_ALL       0x0F00
+#define TA_BEAT         (2 << 22)
+#define VALID           0x0001
+#define WORD            (2 << 8)
+#define SRCINC          0x0400
+#define DSTINC          0x0800
+#define TCMPL           0x02
+
+/* Peripheral triggers (the ATDF's DMAC_ID_* numbers) and their sources */
+#define TRIG_TSENS      1
+#define TRIG_TCC0_OVF   10
+#define TRIG_TCC0_MC(n) (11 + (n))
+#define TRIG_SDADC      38
+#define GCLK_PCHCTRL    0x40001C80
+#define TSENS           0x40003000
+#define TSENS_GCLK_ID   5
+#define TCC0            0x42002400
+#define TCC0_GCLK_ID    23
+#define TCC0_PATH       "/machine/soc/tcc0"
+#define SDADC           0x42004C00
+#define SDADC_GCLK_ID   30
+#define US              1000
+#define FILL            0xEEEEEEEE
 
 static QTestState *dmac_init(void)
 {
@@ -123,11 +145,177 @@ static void test_chid_alias(void)
     qtest_quit(qts);
 }
 
+/*
+ * Channel 0, a beat per trigger @trig: @n beats from @src to @dst (end
+ * addresses when incremented); @n words at DST and SRC read FILL first
+ */
+static void beat_channel(QTestState *qts, unsigned trig, uint16_t btctrl,
+                         uint16_t n, uint32_t src, uint32_t dst)
+{
+    uint8_t d[16];
+
+    for (unsigned i = 0; i < n; i++) {
+        qtest_writel(qts, DST + 4 * i, FILL);
+    }
+    stw_le_p(&d[0], btctrl);
+    stw_le_p(&d[2], n);
+    stl_le_p(&d[4], src);
+    stl_le_p(&d[8], dst);
+    stl_le_p(&d[12], 0);
+    qtest_memwrite(qts, DESC, d, sizeof(d));
+    qtest_writeb(qts, DMAC + R_CHID, 0);
+    qtest_writel(qts, DMAC + R_CHCTRLB, (trig << 8) | TA_BEAT);
+    qtest_writeb(qts, DMAC + R_CHCTRLA, 0x02);
+}
+
+static uint8_t chintflag(QTestState *qts)
+{
+    qtest_writeb(qts, DMAC + R_CHID, 0);
+    return qtest_readb(qts, DMAC + R_CHINTFLAG);
+}
+
+/* TCC0 on GCLK0 (4 MHz), DIV1, NPWM, PER 99 (25 us), CC1 50 */
+static void tcc0_start(QTestState *qts, uint32_t ctrla, uint32_t evctrl)
+{
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * TCC0_GCLK_ID, 0x40);
+    qtest_writel(qts, TCC0 + 0x00, ctrla);
+    qtest_writel(qts, TCC0 + 0x3C, 2);              /* WAVE: NPWM */
+    qtest_writel(qts, TCC0 + 0x40, 99);             /* PER */
+    qtest_writel(qts, TCC0 + 0x48, 50);             /* CC1 */
+    qtest_writel(qts, TCC0 + 0x20, evctrl);
+    qtest_writel(qts, TCC0 + 0x00, ctrla | BIT(1));
+}
+
+/* OVF requests a beat at each update: 25, 50, 75 and 100 us */
+static void test_tcc_ovf(void)
+{
+    QTestState *qts = dmac_init();
+
+    for (unsigned i = 0; i < 4; i++) {
+        qtest_writel(qts, SRC + 4 * i, 10 * (i + 1));
+    }
+    beat_channel(qts, TRIG_TCC0_OVF, VALID | WORD | SRCINC, 4, SRC + 16,
+                 DST);
+    tcc0_start(qts, 0, 0);
+    qtest_clock_step(qts, 90 * US);
+    g_assert_cmphex(qtest_readl(qts, DST), ==, 30);
+    g_assert_cmphex(chintflag(qts), ==, 0);
+    qtest_clock_step(qts, 20 * US);
+    g_assert_cmphex(qtest_readl(qts, DST), ==, 40);
+    g_assert_cmphex(chintflag(qts), ==, TCMPL);
+    qtest_quit(qts);
+}
+
+/* MC1 requests a beat at each compare match: 12.5, 37.5 and 62.5 us */
+static void test_tcc_compare(void)
+{
+    QTestState *qts = dmac_init();
+
+    for (unsigned i = 0; i < 3; i++) {
+        qtest_writel(qts, SRC + 4 * i, i + 1);
+    }
+    beat_channel(qts, TRIG_TCC0_MC(1), VALID | WORD | SRCINC, 3, SRC + 12,
+                 DST);
+    tcc0_start(qts, 0, 0);
+    qtest_clock_step(qts, 50 * US);
+    g_assert_cmphex(qtest_readl(qts, DST), ==, 2);
+    g_assert_cmphex(chintflag(qts), ==, 0);
+    qtest_clock_step(qts, 20 * US);
+    g_assert_cmphex(qtest_readl(qts, DST), ==, 3);
+    g_assert_cmphex(chintflag(qts), ==, TCMPL);
+    qtest_quit(qts);
+}
+
+/* A capture channel requests a beat for each capture; reading CC2 clears MC2 */
+static void test_tcc_capture(void)
+{
+    QTestState *qts = dmac_init();
+
+    beat_channel(qts, TRIG_TCC0_MC(2), VALID | WORD | DSTINC, 2,
+                 TCC0 + 0x4C, DST + 8);
+    tcc0_start(qts, BIT(26), BIT(18));              /* CPTEN2; MCEI2 */
+    qtest_clock_step(qts, 125);                     /* mid-tick */
+    for (unsigned i = 0; i < 2; i++) {
+        qtest_clock_step(qts, 5 * US);              /* 20 ticks */
+        qtest_set_irq_in(qts, TCC0_PATH, "mc-event-in", 2, 1);
+        qtest_clock_step(qts, 1 * US);
+        qtest_set_irq_in(qts, TCC0_PATH, "mc-event-in", 2, 0);
+    }
+    g_assert_cmpuint(qtest_readl(qts, DST), ==, 20);
+    g_assert_cmpuint(qtest_readl(qts, DST + 4), ==, 44);
+    g_assert_cmphex(chintflag(qts), ==, TCMPL);
+    g_assert_cmphex(qtest_readl(qts, TCC0 + 0x2C) & BIT(18), ==, 0);
+    qtest_quit(qts);
+}
+
+/* TSENS RESRDY is a level trigger: a beat per result, 1 ms apart */
+static void test_tsens(void)
+{
+    QTestState *qts = dmac_init();
+
+    beat_channel(qts, TRIG_TSENS, VALID | WORD | DSTINC, 3, TSENS + 0x0C,
+                 DST + 12);
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * TSENS_GCLK_ID, 0x40);
+    qtest_writel(qts, TSENS + 0x18, 1000);          /* GAIN: 4000 clocks */
+    qtest_writeb(qts, TSENS + 0x02, BIT(4));        /* CTRLC: FREERUN */
+    qtest_writeb(qts, TSENS + 0x00, BIT(1));        /* CTRLA: ENABLE */
+    qtest_writeb(qts, TSENS + 0x01, BIT(0));        /* CTRLB: START */
+    qtest_clock_step(qts, 2500 * US);
+    g_assert_cmphex(qtest_readl(qts, DST + 4), !=, FILL);
+    g_assert_cmphex(qtest_readl(qts, DST + 8), ==, FILL);
+    g_assert_cmphex(chintflag(qts), ==, 0);
+    qtest_clock_step(qts, 1000 * US);
+    g_assert_cmphex(qtest_readl(qts, DST + 8), !=, FILL);
+    g_assert_cmphex(chintflag(qts), ==, TCMPL);
+    qtest_quit(qts);
+}
+
+/* SDADC RESRDY: free running, each RESULT read brings the next result */
+static void test_sdadc(void)
+{
+    QTestState *qts = dmac_init();
+
+    beat_channel(qts, TRIG_SDADC, VALID | WORD | DSTINC, 4, SDADC + 0x24,
+                 DST + 16);
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * SDADC_GCLK_ID, 0x40);
+    qtest_writeb(qts, SDADC + 0x0A, BIT(0));        /* CTRLC: FREERUN */
+    qtest_writeb(qts, SDADC + 0x00, BIT(1));        /* CTRLA: ENABLE */
+    qtest_writeb(qts, SDADC + 0x1C, BIT(1));        /* SWTRIG: START */
+    qtest_clock_step(qts, 1000 * US);
+    for (unsigned i = 0; i < 4; i++) {
+        g_assert_cmphex(qtest_readl(qts, DST + 4 * i), ==, 0);  /* 0 mV */
+    }
+    g_assert_cmphex(chintflag(qts), ==, TCMPL);
+    qtest_quit(qts);
+}
+
+/* A level request already set when the channel is enabled runs at once */
+static void test_level_at_enable(void)
+{
+    QTestState *qts = dmac_init();
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * SDADC_GCLK_ID, 0x40);
+    qtest_writeb(qts, SDADC + 0x00, BIT(1));        /* CTRLA: ENABLE */
+    qtest_writeb(qts, SDADC + 0x1C, BIT(1));        /* SWTRIG: START */
+    g_assert_cmphex(qtest_readb(qts, SDADC + 0x07) & 1, ==, 1);  /* RESRDY */
+    beat_channel(qts, TRIG_SDADC, VALID | WORD, 1, SDADC + 0x24, DST);
+    qtest_clock_step(qts, 1 * US);  /* no DMAC read: within the 20 us batch */
+    g_assert_cmphex(qtest_readl(qts, DST), ==, 0);
+    g_assert_cmphex(qtest_readb(qts, SDADC + 0x07) & 1, ==, 0);
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
     qtest_add_func("pic32cm-dmac/copy", test_copy);
     qtest_add_func("pic32cm-dmac/crc", test_crc);
     qtest_add_func("pic32cm-dmac/chid-alias", test_chid_alias);
+    qtest_add_func("pic32cm-dmac/tcc-ovf", test_tcc_ovf);
+    qtest_add_func("pic32cm-dmac/tcc-compare", test_tcc_compare);
+    qtest_add_func("pic32cm-dmac/tcc-capture", test_tcc_capture);
+    qtest_add_func("pic32cm-dmac/tsens", test_tsens);
+    qtest_add_func("pic32cm-dmac/sdadc", test_sdadc);
+    qtest_add_func("pic32cm-dmac/level-at-enable", test_level_at_enable);
     return g_test_run();
 }
