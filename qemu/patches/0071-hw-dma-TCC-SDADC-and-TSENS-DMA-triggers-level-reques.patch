-        if (ref->id >= MCHP_DMAC_MAX_TRIGGERS || !dev ||
-            !object_dynamic_cast(OBJECT(dev), TYPE_MCHP_TC) ||
-            strcmp(ref->param, "DMAC_ID_OVF")) {
+        const char *out, *wanted;
+        int n = 0;
+
+        if (ref->id >= MCHP_DMAC_MAX_TRIGGERS || !dev) {
+            continue;
+        }
+        if (!strcmp(ref->param, "DMAC_ID_OVF")) {
+            out = "ovf-dma";
+            wanted = "ovf-dma-wanted";
+        } else if (sscanf(ref->param, "DMAC_ID_MC%d", &n) == 1) {
+            out = "mc-dma";
+            wanted = "mc-dma-wanted";
+        } else {
+            continue;
+        }
