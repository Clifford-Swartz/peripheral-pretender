+static void tcc_sync(MchpTccState *s);
+
+/* A DMAC channel waits for (or no longer for) request bit @bit */
+static void tcc_set_dma_wanted(MchpTccState *s, unsigned bit, int level)
+{
+    if (extract32(s->dma_wanted, bit, 1) != (level > 0)) {
+        tcc_sync(s);
+        s->dma_wanted = deposit32(s->dma_wanted, bit, 1, level > 0);
+        tcc_sync(s);
+    }
+}
+
+static void tcc_ovf_dma_wanted(void *opaque, int n, int level)
+{
+    tcc_set_dma_wanted(opaque, 0, level);
+}
+
+static void tcc_mc_dma_wanted(void *opaque, int n, int level)
+{
+    tcc_set_dma_wanted(opaque, 1 + n, level);
+}
