 }
 
+/* Kick the machine's DMAC, if it has one (found on first use) */
+void mchp_dmac_kick_machine(void)
+{
+    static DeviceState *dmac;
+    static bool looked;
+
+    if (!looked) {
+        Object *o = object_resolve_path_type("", TYPE_MCHP_DMAC_U2223, NULL);
+
+        if (!o) {
+            o = object_resolve_path_type("", TYPE_MCHP_DMAC, NULL);
+        }
+        dmac = o ? DEVICE(o) : NULL;
+        looked = true;
+    }
+    if (dmac) {
+        mchp_dmac_kick(dmac);
+    }
+}
+
