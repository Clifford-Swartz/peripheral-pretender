+/*
+ * Microchip generic register block: one peripheral instance as a register file
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "hw/core/irq.h"
+#include "hw/core/loader.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/misc/mchp_regblock.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+#include "trace.h"
+
+/* SAM convention for the control register at offset 0 */
+#define MCHP_CTRL_SWRST     BIT(0)
+#define MCHP_CTRL_ENABLE    BIT(1)
+
+/* A 32-bit word of the NVM rows (fuses) for reset values */
+static uint32_t mchp_regblock_nvm_word(hwaddr addr)
+{
+    /*
+     * At the first reset the loader has not copied the image's ROM blobs
+     * (for example user-row fuse words) into memory yet, so look at the
+     * blobs first, as the Arm CPU reset does for the vector table.
+     */
+    uint8_t *p = rom_ptr_for_as(&address_space_memory, addr, 4);
+
+    if (p) {
+        return ldl_le_p(p);
+    }
+    return address_space_ldl_le(&address_space_memory, addr,
+                                MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+void mchp_regblock_set_clock(MchpRegBlock *s, Clock *out, uint64_t hz)
+{
+    if (clock_set_hz(out, hz)) {
+        trace_mchp_clk_update(s->name,
+                              object_get_canonical_path_component(OBJECT(out)),
+                              hz);
+        clock_propagate(out);
+    }
+}
+
+/* The register holding the value of @ri: its alias target or itself. */
+static const MchpRegInfo *mchp_regblock_storage(MchpRegBlock *s,
+                                                const MchpRegInfo *ri)
+{
+    return ri->alias_of >= 0 ? &s->rf.regs[ri->alias_of] : ri;
+}
+
+static const MchpRegInfo *mchp_regblock_find_ctrl(MchpRegBlock *s)
+{
+    unsigned idx;
+    const MchpRegInfo *ri = mchp_regfile_lookup(&s->rf, 0, &idx);
+
+    if (ri && (!strcmp(ri->name, "CTRLA") || !strcmp(ri->name, "CTRL"))) {
+        return ri;
+    }
+    return NULL;
+}
+
+static void mchp_regblock_bind_table(MchpRegBlock *s,
+                                     const MchpRegInfo *regs, unsigned nregs,
+                                     const MchpResetOverride *ovr,
+                                     unsigned novr)
+{
+    mchp_regfile_set_table(&s->rf, regs, nregs);
+    mchp_regfile_set_overrides(&s->rf, ovr, novr);
+    s->ctrl = mchp_regblock_find_ctrl(s);
+    s->intflag = mchp_regfile_find(&s->rf, "INTFLAG");
+    s->intenset = mchp_regfile_find(&s->rf, "INTENSET");
+}
+
+static uint32_t mchp_regblock_view_selector(MchpRegBlock *s)
+{
+    const MchpInstanceInfo *info = s->info;
+    unsigned idx;
+    const MchpRegInfo *ri = mchp_regfile_lookup(&s->rf, info->view_sel_offset,
+                                                &idx);
+
+    if (!ri) {
+        return 0;
+    }
+    return extract32(mchp_regfile_get(&s->rf, ri, idx),
+                     info->view_sel_shift, info->view_sel_length);
+}
+
+/* Follow the mode selector (e.g. SERCOM CTRLA.MODE) to a register view. */
+static void mchp_regblock_select_view(MchpRegBlock *s)
+{
+    const MchpInstanceInfo *info = s->info;
+    uint32_t sel;
+
+    if (!info->nviews) {
+        return;
+    }
+    sel = mchp_regblock_view_selector(s);
+    if (sel == s->view_sel) {
+        return;
+    }
+    s->view_sel = sel;
+    for (unsigned i = 0; i < info->nviews; i++) {
+        const MchpRegView *v = &info->views[i];
+
+        if (v->value == sel) {
+            mchp_regblock_bind_table(s, v->regs, v->nregs, v->ovr, v->novr);
+            return;
+        }
+    }
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "%s: reserved mode %" PRIu32 " selected; register view"
+                  " unchanged\n", s->name, sel);
+}
+
+static void mchp_regblock_apply_fuses(MchpRegBlock *s)
+{
+    const MchpInstanceInfo *info = s->info;
+
+    for (unsigned i = 0; i < info->nreset_from; i++) {
+        const MchpFuseReset *f = &info->reset_from[i];
+        uint32_t field = f->fuse_mask >> ctz32(f->fuse_mask);
+        uint32_t v = (mchp_regblock_nvm_word(f->fuse_addr) & f->fuse_mask)
+                     >> ctz32(f->fuse_mask);
+        uint32_t reg = mchp_regfile_peek(&s->rf, f->reg_offset, f->reg_size);
+
+        if (f->invert) {
+            v = ~v & field;
+        }
+        reg = (reg & ~f->reg_mask) | ((v << ctz32(f->reg_mask)) & f->reg_mask);
+        mchp_regfile_poke(&s->rf, f->reg_offset, f->reg_size, reg);
+    }
+}
+
+/* Register reset values, then fields loaded from NVM fuses */
+static void mchp_regblock_reset_registers(MchpRegBlock *s)
+{
+    const MchpInstanceInfo *info = s->info;
+
+    mchp_regblock_bind_table(s, info->regs, info->nregs, info->ovr,
+                             info->novr);
+    mchp_regfile_reset(&s->rf);
+    mchp_regblock_apply_fuses(s);
+    if (info->nviews) {
+        s->view_sel = mchp_regblock_view_selector(s);
+    }
+}
+
+void mchp_regblock_update_irq(MchpRegBlock *s)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_GET_CLASS(s);
+    bool level = false;
+
+    if (c->irq_pending) {
+        level = c->irq_pending(s);
+    } else if (s->intflag && s->intenset) {
+        level = mchp_regfile_get(&s->rf, s->intflag, 0) &
+                mchp_regfile_get(&s->rf, mchp_regblock_storage(s, s->intenset),
+                                 0);
+    }
+    qemu_set_irq(s->irq, level);
+}
+
+static void mchp_regblock_soft_reset(MchpRegBlock *s)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_GET_CLASS(s);
+
+    mchp_regblock_reset_registers(s);
+    if (c->reset_hold) {
+        c->reset_hold(s);
+    }
+    if (c->reset_exit) {
+        c->reset_exit(s);
+    }
+    mchp_regblock_update_irq(s);
+}
+
+/* Interrupt enables and W1C/read-only registers are fully modelled. */
+static bool mchp_regblock_is_bookkeeping(MchpRegBlock *s,
+                                         const MchpRegInfo *ri)
+{
+    return !ri->wmask || mchp_regblock_storage(s, ri) == s->intenset;
+}
+
+static void mchp_regblock_log_write(MchpRegBlock *s, const MchpRegInfo *ri,
+                                    unsigned idx, uint32_t value)
+{
+    trace_mchp_regblock_unimp_write(s->name, ri->name, idx, value);
+    if (ri->count > 1) {
+        qemu_log_mask(LOG_UNIMP, "%s.%s[%u]: write 0x%" PRIx32
+                      " not modelled\n", s->name, ri->name, idx, value);
+    } else {
+        qemu_log_mask(LOG_UNIMP, "%s.%s: write 0x%" PRIx32 " not modelled\n",
+                      s->name, ri->name, value);
+    }
+}
+
+/* Report the registers of a generic block written by one access. */
+static void mchp_regblock_log_writes(MchpRegBlock *s, hwaddr addr,
+                                     uint64_t val, unsigned size)
+{
+    hwaddr pos = addr, end = addr + size;
+
+    while (pos < end) {
+        unsigned idx;
+        const MchpRegInfo *ri = mchp_regfile_lookup(&s->rf, pos, &idx);
+        uint32_t base, value = 0;
+        hwaddr stop;
+
+        if (!ri) {
+            pos++;
+            continue;
+        }
+        base = mchp_regfile_elem_offset(ri, idx);
+        stop = MIN(end, base + ri->size);
+        for (; pos < stop; pos++) {
+            value |= extract64(val, (pos - addr) * 8, 8) << ((pos - base) * 8);
+        }
+        if (!mchp_regblock_is_bookkeeping(s, ri)) {
+            mchp_regblock_log_write(s, ri, idx, value);
+        }
+    }
+}
+
+static MemTxResult mchp_regblock_read(void *opaque, hwaddr addr,
+                                      uint64_t *data, unsigned size,
+                                      MemTxAttrs attrs)
+{
+    MchpRegBlock *s = opaque;
+
+    *data = mchp_regfile_read(&s->rf, addr, size, attrs);
+    if (!attrs.debug && MCHP_REGBLOCK_GET_CLASS(s)->pre_read) {
+        mchp_regblock_update_irq(s);
+    }
+    return MEMTX_OK;
+}
+
+static MemTxResult mchp_regblock_write(void *opaque, hwaddr addr,
+                                       uint64_t val, unsigned size,
+                                       MemTxAttrs attrs)
+{
+    MchpRegBlock *s = opaque;
+
+    mchp_regfile_write(&s->rf, addr, val, size, attrs);
+
+    if (addr == 0 && (val & MCHP_CTRL_SWRST) && s->ctrl &&
+        (s->ctrl->rdz & MCHP_CTRL_SWRST)) {
+        mchp_regblock_soft_reset(s);
+        return MEMTX_OK;
+    }
+    if (MCHP_REGBLOCK_GET_CLASS(s)->log_writes) {
+        mchp_regblock_log_writes(s, addr, val, size);
+    }
+    mchp_regblock_select_view(s);
+    mchp_regblock_update_irq(s);
+    return MEMTX_OK;
+}
+
+static const MemoryRegionOps mchp_regblock_ops = {
+    .read_with_attrs = mchp_regblock_read,
+    .write_with_attrs = mchp_regblock_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+        .unaligned = false,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+        .unaligned = false,
+    },
+};
+
+static bool mchp_regblock_ctrl_enabled(MchpRegFile *rf)
+{
+    MchpRegBlock *s = rf->opaque;
+
+    return s->ctrl && (mchp_regfile_get(rf, s->ctrl, 0) & MCHP_CTRL_ENABLE);
+}
+
+void mchp_regblock_set_info(MchpRegBlock *s, const MchpInstanceInfo *info)
+{
+    assert(!DEVICE(s)->realized);
+    s->info = info;
+}
+
+static void mchp_regblock_reset_hold(Object *obj, ResetType type)
+{
+    MchpRegBlock *s = MCHP_REGBLOCK(obj);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_GET_CLASS(s);
+
+    mchp_regblock_reset_registers(s);
+    if (c->reset_hold) {
+        c->reset_hold(s);
+    }
+}
+
+static void mchp_regblock_reset_exit(Object *obj, ResetType type)
+{
+    MchpRegBlock *s = MCHP_REGBLOCK(obj);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_GET_CLASS(s);
+
+    if (c->reset_exit) {
+        c->reset_exit(s);
+    }
+    mchp_regblock_update_irq(s);
+}
+
+static void mchp_regblock_realize(DeviceState *dev, Error **errp)
+{
+    MchpRegBlock *s = MCHP_REGBLOCK(dev);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_GET_CLASS(s);
+    const MchpInstanceInfo *info = s->info;
+
+    if (!info) {
+        error_setg(errp, "%s: no instance selected",
+                   object_get_typename(OBJECT(dev)));
+        return;
+    }
+    if (!info->regs || !info->slot_size) {
+        error_setg(errp, "%s: instance %s has no register map",
+                   object_get_typename(OBJECT(dev)), info->name);
+        return;
+    }
+
+    s->name = g_ascii_strdown(info->name, -1);
+    mchp_regfile_init(&s->rf, s->name, info->regs_size, info->regs,
+                      info->nregs);
+    s->rf.opaque = s;
+    s->rf.pre_read = c->pre_read;
+    s->rf.post_write = c->post_write;
+    s->rf.is_enabled = c->is_enabled ? c->is_enabled
+                                     : mchp_regblock_ctrl_enabled;
+    mchp_regblock_bind_table(s, info->regs, info->nregs, info->ovr,
+                             info->novr);
+
+    memory_region_init_io(&s->iomem, OBJECT(s), &mchp_regblock_ops, s,
+                          s->name, info->slot_size);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    if (info->alias_size) {
+        g_autofree char *alias = g_ascii_strdown(info->alias_name, -1);
+
+        memory_region_init_alias(&s->alias, OBJECT(s), alias, &s->iomem, 0,
+                                 info->alias_size);
+        sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->alias);
+    }
+    if (c->realize) {
+        c->realize(s, errp);
+    }
+}
+
+static void mchp_regblock_init(Object *obj)
+{
+    MchpRegBlock *s = MCHP_REGBLOCK(obj);
+
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    s->gclk = qdev_init_clock_in(DEVICE(obj), "gclk", NULL, NULL, 0);
+}
+
+static void mchp_regblock_finalize(Object *obj)
+{
+    MchpRegBlock *s = MCHP_REGBLOCK(obj);
+
+    g_free(s->rf.storage);
+    g_free(s->name);
+}
+
+static int mchp_regblock_post_load(void *opaque, int version_id)
+{
+    MchpRegBlock *s = opaque;
+
+    if (s->info->nviews) {
+        s->view_sel = UINT32_MAX;
+        mchp_regblock_select_view(s);
+    }
+    return 0;
+}
+
+const VMStateDescription vmstate_mchp_regblock = {
+    .name = TYPE_MCHP_REGBLOCK,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = mchp_regblock_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_MCHP_REGFILE(rf, MchpRegBlock),
+        VMSTATE_CLOCK(gclk, MchpRegBlock),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_regblock_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    dc->realize = mchp_regblock_realize;
+    dc->vmsd = &vmstate_mchp_regblock;
+    /* Reason: configured from a generated SoC instance table */
+    dc->user_creatable = false;
+    rc->phases.hold = mchp_regblock_reset_hold;
+    rc->phases.exit = mchp_regblock_reset_exit;
+    c->log_writes = true;
+}
+
+static const TypeInfo mchp_regblock_types[] = {
+    {
+        .name = TYPE_MCHP_REGBLOCK,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(MchpRegBlock),
+        .instance_init = mchp_regblock_init,
+        .instance_finalize = mchp_regblock_finalize,
+        .class_size = sizeof(MchpRegBlockClass),
+        .class_init = mchp_regblock_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_regblock_types)
diff --git a/hw/misc/mchp_regfile.c b/hw/misc/mchp_regfile.c
new file mode 100644
index 0000000..bc65e8e
--- /dev/null
+++ b/hw/misc/mchp_regfile.c
@@ -0,0 +1,279 @@
+/*
+ * Microchip register file: byte-lane dispatcher over generated register tables
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "hw/misc/mchp_regfile.h"
+#include "trace.h"
+
+#define MCHP_F_ALIAS_ANY \
+    (MCHP_F_ALIAS_SET | MCHP_F_ALIAS_CLEAR | MCHP_F_ALIAS_TOGGLE)
+
+/* Catch generator mistakes at realize time rather than on a guest access. */
+static void mchp_regfile_check_table(MchpRegFile *rf)
+{
+    for (unsigned i = 0; i < rf->nregs; i++) {
+        const MchpRegInfo *ri = &rf->regs[i];
+
+        assert(ri->size == 1 || ri->size == 2 || ri->size == 4);
+        assert(ri->count >= 1 && ri->stride >= ri->size);
+        assert(mchp_regfile_elem_offset(ri, ri->count - 1) + ri->size <=
+               rf->size);
+        if (ri->alias_of >= 0) {
+            assert(ri->alias_of < rf->nregs);
+            assert(rf->regs[ri->alias_of].count == ri->count);
+        }
+    }
+}
+
+void mchp_regfile_init(MchpRegFile *rf, const char *name, uint32_t size,
+                       const MchpRegInfo *regs, unsigned nregs)
+{
+    rf->name = name;
+    rf->storage = g_malloc0(size);
+    rf->size = size;
+    rf->ovr = NULL;
+    rf->novr = 0;
+    rf->opaque = NULL;
+    rf->pre_read = NULL;
+    rf->post_write = NULL;
+    rf->is_enabled = NULL;
+    mchp_regfile_set_table(rf, regs, nregs);
+}
+
+void mchp_regfile_set_table(MchpRegFile *rf, const MchpRegInfo *regs,
+                            unsigned nregs)
+{
+    rf->regs = regs;
+    rf->nregs = nregs;
+    mchp_regfile_check_table(rf);
+}
+
+void mchp_regfile_set_overrides(MchpRegFile *rf, const MchpResetOverride *ovr,
+                                unsigned n)
+{
+    rf->ovr = ovr;
+    rf->novr = n;
+}
+
+uint32_t mchp_regfile_peek(MchpRegFile *rf, uint32_t offset, unsigned size)
+{
+    assert(offset + size <= rf->size);
+    return ldn_le_p(rf->storage + offset, size);
+}
+
+void mchp_regfile_poke(MchpRegFile *rf, uint32_t offset, unsigned size,
+                       uint32_t val)
+{
+    assert(offset + size <= rf->size);
+    stn_le_p(rf->storage + offset, size, val);
+}
+
+void mchp_regfile_reset(MchpRegFile *rf)
+{
+    memset(rf->storage, 0, rf->size);
+    for (unsigned i = 0; i < rf->nregs; i++) {
+        const MchpRegInfo *ri = &rf->regs[i];
+
+        /* Set/clear/toggle views have no storage of their own. */
+        if (ri->alias_of >= 0 && ri->alias_of != i) {
+            continue;
+        }
+        for (unsigned idx = 0; idx < ri->count; idx++) {
+            mchp_regfile_set(rf, ri, idx, ri->reset);
+        }
+    }
+    for (unsigned i = 0; i < rf->novr; i++) {
+        mchp_regfile_poke(rf, rf->ovr[i].offset, rf->ovr[i].size,
+                          rf->ovr[i].value);
+    }
+}
+
+const MchpRegInfo *mchp_regfile_find(MchpRegFile *rf, const char *name)
+{
+    for (unsigned i = 0; i < rf->nregs; i++) {
+        if (!strcmp(rf->regs[i].name, name)) {
+            return &rf->regs[i];
+        }
+    }
+    return NULL;
+}
+
+const MchpRegInfo *mchp_regfile_lookup(MchpRegFile *rf, uint32_t offset,
+                                       unsigned *idx)
+{
+    for (unsigned i = 0; i < rf->nregs; i++) {
+        const MchpRegInfo *ri = &rf->regs[i];
+        uint32_t rel = offset - ri->offset;
+
+        if (offset >= ri->offset && rel / ri->stride < ri->count &&
+            rel % ri->stride < ri->size) {
+            *idx = rel / ri->stride;
+            return ri;
+        }
+    }
+    return NULL;
+}
+
+static uint32_t mchp_regfile_read_elem(MchpRegFile *rf, const MchpRegInfo *ri,
+                                       unsigned idx, bool side_effects)
+{
+    const MchpRegInfo *src = ri->alias_of >= 0 ? &rf->regs[ri->alias_of] : ri;
+    uint32_t val;
+
+    if (ri->flags & MCHP_F_WRITE_ONLY) {
+        return 0;
+    }
+    val = mchp_regfile_get(rf, src, idx);
+    if ((ri->flags & (MCHP_F_DYNAMIC | MCHP_F_HOOK_PRE_READ)) && rf->pre_read) {
+        val = rf->pre_read(rf, ri, idx, val, side_effects);
+    }
+    return val & ~ri->rdz & ri->impl;
+}
+
+uint64_t mchp_regfile_read(MchpRegFile *rf, hwaddr addr, unsigned size,
+                           MemTxAttrs attrs)
+{
+    hwaddr pos = addr, end = addr + size;
+    uint64_t data = 0;
+    bool hit = false;
+
+    while (pos < end) {
+        unsigned idx;
+        const MchpRegInfo *ri = mchp_regfile_lookup(rf, pos, &idx);
+        uint32_t base, val;
+        hwaddr stop;
+
+        if (!ri) {
+            pos++;
+            continue;
+        }
+        base = mchp_regfile_elem_offset(ri, idx);
+        stop = MIN(end, base + ri->size);
+        val = mchp_regfile_read_elem(rf, ri, idx, !attrs.debug);
+        for (; pos < stop; pos++) {
+            data |= (uint64_t)extract32(val, (pos - base) * 8, 8)
+                    << ((pos - addr) * 8);
+        }
+        hit = true;
+    }
+
+    if (!hit && !attrs.debug) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: read of reserved offset 0x%" HWADDR_PRIx
+                      " (size %u)\n", rf->name, addr, size);
+    }
+    trace_mchp_regfile_read(rf->name, addr, size, data);
+    return data;
+}
+
+static void mchp_regfile_write_alias(MchpRegFile *rf, const MchpRegInfo *ri,
+                                     unsigned idx, uint32_t val, uint32_t we)
+{
+    const MchpRegInfo *target = &rf->regs[ri->alias_of];
+    uint32_t old = mchp_regfile_get(rf, target, idx);
+    uint32_t bits = val & we & ri->wmask;
+    uint32_t new;
+
+    if (ri->flags & MCHP_F_ALIAS_SET) {
+        new = old | bits;
+    } else if (ri->flags & MCHP_F_ALIAS_CLEAR) {
+        new = old & ~bits;
+    } else {
+        new = old ^ bits;
+    }
+    mchp_regfile_set(rf, target, idx, new);
+
+    if (((ri->flags | target->flags) & MCHP_F_HOOK_POST_WRITE) &&
+        rf->post_write) {
+        rf->post_write(rf, ri, idx, old, val, we);
+    }
+}
+
+/* Write the lanes @we of element @idx of @ri; @val is lane-aligned. */
+static void mchp_regfile_write_elem(MchpRegFile *rf, const MchpRegInfo *ri,
+                                    unsigned idx, uint32_t val, uint32_t we)
+{
+    uint32_t old, new, writable;
+
+    if (ri->flags & MCHP_F_READ_ONLY) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s.%s: write 0x%" PRIx32 " to read-only register"
+                      " (ignored)\n", rf->name, ri->name, val & we);
+        return;
+    }
+    if (ri->flags & MCHP_F_ALIAS_ANY) {
+        mchp_regfile_write_alias(rf, ri, idx, val, we);
+        return;
+    }
+
+    old = mchp_regfile_get(rf, ri, idx);
+    writable = ri->wmask & we;
+    if ((val ^ old) & ri->enprot & we && rf->is_enabled &&
+        rf->is_enabled(rf)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s.%s: write to enable-protected bits 0x%" PRIx32
+                      " while enabled (ignored)\n", rf->name, ri->name,
+                      (val ^ old) & ri->enprot & we);
+        writable &= ~ri->enprot;
+    }
+    new = (old & ~writable) | (val & writable);
+    new &= ~(val & we & ri->w1c);
+    mchp_regfile_set(rf, ri, idx, new);
+
+    if ((ri->flags & MCHP_F_HOOK_POST_WRITE) && rf->post_write) {
+        rf->post_write(rf, ri, idx, old, val, we);
+    }
+    if (ri->rdz) {
+        mchp_regfile_set(rf, ri, idx,
+                         mchp_regfile_get(rf, ri, idx) & ~ri->rdz);
+    }
+}
+
+void mchp_regfile_write(MchpRegFile *rf, hwaddr addr, uint64_t val,
+                        unsigned size, MemTxAttrs attrs)
+{
+    hwaddr pos = addr, end = addr + size;
+    uint64_t reserved = 0;
+    bool hit = false;
+
+    trace_mchp_regfile_write(rf->name, addr, size, val);
+    while (pos < end) {
+        unsigned idx;
+        const MchpRegInfo *ri = mchp_regfile_lookup(rf, pos, &idx);
+        uint32_t base, lanes = 0, lval = 0;
+        hwaddr stop;
+
+        if (!ri) {
+            reserved |= val & (0xffull << ((pos - addr) * 8));
+            pos++;
+            continue;
+        }
+        base = mchp_regfile_elem_offset(ri, idx);
+        stop = MIN(end, base + ri->size);
+        for (; pos < stop; pos++) {
+            unsigned lane = (pos - base) * 8;
+
+            lanes |= 0xffu << lane;
+            lval |= extract64(val, (pos - addr) * 8, 8) << lane;
+        }
+        mchp_regfile_write_elem(rf, ri, idx, lval, lanes);
+        hit = true;
+    }
+
+    /* Zeros written to reserved bytes next to a register are harmless. */
+    if (!hit || reserved) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: write 0x%" PRIx64 " to reserved offset 0x%"
+                      HWADDR_PRIx " (size %u, ignored)\n",
+                      rf->name, val, addr, size);
+    }
+}
diff --git a/hw/misc/mchp_sysctrl.c b/hw/misc/mchp_sysctrl.c
new file mode 100644
index 0000000..2fdb15f
--- /dev/null
+++ b/hw/misc/mchp_sysctrl.c
@@ -0,0 +1,616 @@
+/*
+ * Microchip SAM/PIC32CM system controllers: NVMCTRL, SUPC, RSTC, WDT, PM,
+ * PAC, DSU and DIVAS
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Each model only adds what the generated register tables cannot express;
+ * references are to DS60001632H (PIC32CM JH00/JH01 data sheet).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/mchp/gen/divas_u2258.h"
+#include "hw/mchp/gen/dsu_u2209.h"
+#include "hw/mchp/gen/nvmctrl_03929.h"
+#include "hw/mchp/gen/pac_u2120.h"
+#include "hw/mchp/gen/rstc_u2239.h"
+#include "hw/mchp/gen/supc_u2117.h"
+#include "hw/mchp/gen/wdt_u2251.h"
+#include "hw/misc/mchp_sysctrl.h"
+#include "migration/vmstate.h"
+#include "system/runstate.h"
+#include "trace.h"
+
+static uint32_t mchp_reg(MchpRegBlock *s, hwaddr offset, unsigned size)
+{
+    return mchp_regfile_peek(&s->rf, offset, size);
+}
+
+static void mchp_reg_set_bits(MchpRegBlock *s, hwaddr offset, unsigned size,
+                              uint32_t bits)
+{
+    mchp_regfile_poke(&s->rf, offset, size, mchp_reg(s, offset, size) | bits);
+}
+
+/* NVMCTRL */
+
+/*
+ * A command runs when CTRLA is written with the CMDEX key (DS 26.6.1);
+ * without it the write is dropped and STATUS.PROGE is set. The commands
+ * that need no flash array complete at once and READY stays 1.
+ */
+static void mchp_nvmctrl_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                    unsigned idx, uint32_t old,
+                                    uint32_t written, uint32_t we)
+{
+    MchpRegBlock *s = rf->opaque;
+    uint32_t cmd = FIELD_EX32(written, MCHP_NVMCTRL_CTRLA, CMD);
+
+    if (ri->offset != A_MCHP_NVMCTRL_CTRLA) {
+        return;
+    }
+    if (FIELD_EX32(written, MCHP_NVMCTRL_CTRLA, CMDEX) !=
+        MCHP_NVMCTRL_CTRLA_CMDEX_KEY) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.CTRLA: command 0x%" PRIx32
+                      " without the CMDEX key (PROGE)\n", s->name, cmd);
+        mchp_regfile_set(rf, ri, idx, old);
+        mchp_reg_set_bits(s, A_MCHP_NVMCTRL_STATUS, 2,
+                          R_MCHP_NVMCTRL_STATUS_PROGE_MASK);
+        mchp_reg_set_bits(s, A_MCHP_NVMCTRL_INTFLAG, 4,
+                          R_MCHP_NVMCTRL_INTFLAG_ERROR_MASK);
+        return;
+    }
+
+    switch (cmd) {
+    case MCHP_NVMCTRL_CTRLA_CMD_SPRM:
+        mchp_reg_set_bits(s, A_MCHP_NVMCTRL_STATUS, 2,
+                          R_MCHP_NVMCTRL_STATUS_PRM_MASK);
+        break;
+    case MCHP_NVMCTRL_CTRLA_CMD_CPRM:
+        mchp_regfile_poke(rf, A_MCHP_NVMCTRL_STATUS, 2,
+                          mchp_reg(s, A_MCHP_NVMCTRL_STATUS, 2) &
+                          ~R_MCHP_NVMCTRL_STATUS_PRM_MASK);
+        break;
+    case MCHP_NVMCTRL_CTRLA_CMD_PBC:
+    case MCHP_NVMCTRL_CTRLA_CMD_INVALL:
+        break;                  /* no page buffer or cache to clear */
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s.CTRLA: command 0x%" PRIx32
+                      " not modelled (flash programming)\n", s->name, cmd);
+        break;
+    }
+}
+
+static void mchp_nvmctrl_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    c->post_write = mchp_nvmctrl_post_write;
+    c->log_writes = false;
+}
+
+/* SUPC */
+
+/* Synchronization is instant, so BVDDSRDY always reads 1 (DS 18.6.4). */
+static uint32_t mchp_supc_status(MchpRegBlock *s)
+{
+    uint32_t bodvdd = mchp_reg(s, A_MCHP_SUPC_BODVDD, 4);
+    uint32_t status = R_MCHP_SUPC_STATUS_BVDDSRDY_MASK;
+
+    if (FIELD_EX32(bodvdd, MCHP_SUPC_BODVDD, ENABLE)) {
+        status |= R_MCHP_SUPC_STATUS_BODVDDRDY_MASK;
+    }
+    return status;
+}
+
+static bool mchp_supc_is_enabled(MchpRegFile *rf)
+{
+    return FIELD_EX32(mchp_regfile_peek(rf, A_MCHP_SUPC_BODVDD, 4),
+                      MCHP_SUPC_BODVDD, ENABLE);
+}
+
+static uint32_t mchp_supc_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                   unsigned idx, uint32_t stored,
+                                   bool side_effects)
+{
+    if (ri->offset == A_MCHP_SUPC_STATUS) {
+        return mchp_supc_status(rf->opaque);
+    }
+    return stored;
+}
+
+static void mchp_supc_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                 unsigned idx, uint32_t old,
+                                 uint32_t written, uint32_t we)
+{
+    MchpRegBlock *s = rf->opaque;
+    uint32_t flags = R_MCHP_SUPC_INTFLAG_BVDDSRDY_MASK;
+
+    if (ri->offset != A_MCHP_SUPC_BODVDD) {
+        return;
+    }
+    if (!FIELD_EX32(old, MCHP_SUPC_BODVDD, ENABLE) &&
+        mchp_supc_is_enabled(rf)) {
+        flags |= R_MCHP_SUPC_INTFLAG_BODVDDRDY_MASK;
+    }
+    mchp_reg_set_bits(s, A_MCHP_SUPC_INTFLAG, 4, flags);
+}
+
+/* The BOD was ready (and synchronized) when the device left reset. */
+static void mchp_supc_reset_hold(MchpRegBlock *s)
+{
+    mchp_regfile_poke(&s->rf, A_MCHP_SUPC_INTFLAG, 4, mchp_supc_status(s));
+}
+
+static void mchp_supc_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    c->pre_read = mchp_supc_pre_read;
+    c->post_write = mchp_supc_post_write;
+    c->is_enabled = mchp_supc_is_enabled;
+    c->reset_hold = mchp_supc_reset_hold;
+    c->log_writes = false;
+}
+
+/* RSTC */
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpRstcState, MCHP_RSTC)
+
+struct MchpRstcState {
+    MchpRegBlock parent_obj;
+
+    uint8_t cause;              /* RCAUSE after the next reset */
+};
+
+/* RCAUSE must describe the reset it survives (DS 20.7.1). */
+static void mchp_rstc_reset_request(void *opaque, int line, int level)
+{
+    MchpRstcState *s = MCHP_RSTC(opaque);
+
+    if (!level) {
+        return;
+    }
+    s->cause = BIT(line);
+    trace_mchp_rstc_reset_request(MCHP_REGBLOCK(s)->name, s->cause);
+    qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+}
+
+static void mchp_rstc_reset_hold(MchpRegBlock *rb)
+{
+    MchpRstcState *s = MCHP_RSTC(rb);
+
+    mchp_regfile_poke(&rb->rf, A_MCHP_RSTC_RCAUSE, 1, s->cause);
+    /* A later reset that no source announced came from the reset pin. */
+    s->cause = R_MCHP_RSTC_RCAUSE_EXT_MASK;
+}
+
+static void mchp_rstc_init(Object *obj)
+{
+    MchpRstcState *s = MCHP_RSTC(obj);
+
+    qdev_init_gpio_in_named(DEVICE(obj), mchp_rstc_reset_request,
+                            MCHP_RSTC_RESET_CAUSE, 8);
+    s->cause = R_MCHP_RSTC_RCAUSE_POR_MASK;
+}
+
+static const VMStateDescription vmstate_mchp_rstc = {
+    .name = TYPE_MCHP_RSTC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpRstcState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_UINT8(cause, MchpRstcState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_rstc_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_rstc;
+    c->reset_hold = mchp_rstc_reset_hold;
+    c->log_writes = false;
+}
+
+/* WDT */
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpWdtState, MCHP_WDT)
+
+struct MchpWdtState {
+    MchpRegBlock parent_obj;
+
+    qemu_irq system_reset;
+};
+
+#define MCHP_WDT_ON \
+    (R_MCHP_WDT_CTRLA_ENABLE_MASK | R_MCHP_WDT_CTRLA_ALWAYSON_MASK)
+
+static bool mchp_wdt_is_enabled(MchpRegFile *rf)
+{
+    return mchp_regfile_peek(rf, A_MCHP_WDT_CTRLA, 1) & MCHP_WDT_ON;
+}
+
+static void mchp_wdt_report_enabled(MchpRegBlock *s)
+{
+    qemu_log_mask(LOG_UNIMP, "%s.CTRLA: watchdog enabled; time-out not"
+                  " modelled\n", s->name);
+}
+
+static void mchp_wdt_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                unsigned idx, uint32_t old,
+                                uint32_t written, uint32_t we)
+{
+    MchpWdtState *s = MCHP_WDT(rf->opaque);
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t val = mchp_regfile_get(rf, ri, idx);
+
+    switch (ri->offset) {
+    case A_MCHP_WDT_CTRLA:
+        /* ALWAYSON holds until power-on reset and locks CTRLA (DS 22.6.1) */
+        if (old & R_MCHP_WDT_CTRLA_ALWAYSON_MASK) {
+            if (val != old) {
+                qemu_log_mask(LOG_GUEST_ERROR, "%s.CTRLA: read-only while"
+                              " ALWAYSON is set (ignored)\n", rb->name);
+                mchp_regfile_set(rf, ri, idx, old);
+            }
+        } else if ((val & MCHP_WDT_ON) && !(old & MCHP_WDT_ON)) {
+            mchp_wdt_report_enabled(rb);
+        }
+        break;
+    case A_MCHP_WDT_CLEAR:
+        /* Any value but the key resets the system at once (DS 22.6.8) */
+        if (mchp_wdt_is_enabled(rf) &&
+            FIELD_EX32(written, MCHP_WDT_CLEAR, CLEAR) !=
+            MCHP_WDT_CLEAR_CLEAR_KEY) {
+            qemu_log_mask(LOG_GUEST_ERROR, "%s.CLEAR: wrong key 0x%" PRIx32
+                          "; system reset\n", rb->name,
+                          FIELD_EX32(written, MCHP_WDT_CLEAR, CLEAR));
+            qemu_irq_pulse(s->system_reset);
+        }
+        break;
+    }
+}
+
+static void mchp_wdt_reset_exit(MchpRegBlock *rb)
+{
+    if (mchp_wdt_is_enabled(&rb->rf)) {
+        mchp_wdt_report_enabled(rb);
+    }
+}
+
+static void mchp_wdt_init(Object *obj)
+{
+    MchpWdtState *s = MCHP_WDT(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), &s->system_reset,
+                             MCHP_WDT_SYSTEM_RESET, 1);
+}
+
+static void mchp_wdt_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    c->post_write = mchp_wdt_post_write;
+    c->is_enabled = mchp_wdt_is_enabled;
+    c->reset_exit = mchp_wdt_reset_exit;
+    c->log_writes = false;
+}
+
+/* PM: SLEEPCFG and STDBYCFG only store; sleep is the CPU's WFI. */
+
+static void mchp_pm_class_init(ObjectClass *klass, const void *data)
+{
+    MCHP_REGBLOCK_CLASS(klass)->log_writes = false;
+}
+
+/* PAC */
+
+#define MCHP_PAC_NUM_BRIDGES        4
+#define MCHP_PAC_PERIDS_PER_BRIDGE  32
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpPacState, MCHP_PAC)
+
+struct MchpPacState {
+    MchpRegBlock parent_obj;
+
+    uint32_t locked[MCHP_PAC_NUM_BRIDGES];  /* SETLCK, until reset */
+};
+
+/* Errors of WRCTRL operations set INTFLAGA.PAC (DS 12.5.2.6). */
+static void mchp_pac_error(MchpRegBlock *s, const char *what, uint32_t perid)
+{
+    qemu_log_mask(LOG_GUEST_ERROR, "%s.WRCTRL: %s (PERID %" PRIu32 ")\n",
+                  s->name, what, perid);
+    mchp_reg_set_bits(s, A_MCHP_PAC_INTFLAGA, 4, BIT(0));
+}
+
+static void mchp_pac_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                unsigned idx, uint32_t old,
+                                uint32_t written, uint32_t we)
+{
+    MchpPacState *s = MCHP_PAC(rf->opaque);
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t key = FIELD_EX32(written, MCHP_PAC_WRCTRL, KEY);
+    uint32_t perid = FIELD_EX32(written, MCHP_PAC_WRCTRL, PERID);
+    unsigned bridge = perid / MCHP_PAC_PERIDS_PER_BRIDGE;
+    uint32_t bit = BIT(perid % MCHP_PAC_PERIDS_PER_BRIDGE);
+    hwaddr offset = A_MCHP_PAC_STATUSA + 4 * bridge;
+    const MchpRegInfo *status_ri;
+    unsigned status_idx;
+    uint32_t status;
+
+    if (we != UINT32_MAX) {
+        mchp_pac_error(rb, "only word writes change protection", perid);
+        return;
+    }
+    if (key == MCHP_PAC_WRCTRL_KEY_OFF) {
+        return;
+    }
+    status_ri = bridge < MCHP_PAC_NUM_BRIDGES ?
+                mchp_regfile_lookup(rf, offset, &status_idx) : NULL;
+    if (!status_ri || !(status_ri->impl & bit)) {
+        mchp_pac_error(rb, "no such peripheral", perid);
+        return;
+    }
+
+    status = mchp_reg(rb, offset, 4);
+    switch (key) {
+    case MCHP_PAC_WRCTRL_KEY_CLR:
+        if (s->locked[bridge] & bit) {
+            mchp_pac_error(rb, "protection is locked", perid);
+        } else if (!(status & bit)) {
+            mchp_pac_error(rb, "double clear", perid);
+        }
+        status &= ~bit | s->locked[bridge];
+        break;
+    case MCHP_PAC_WRCTRL_KEY_SET:
+    case MCHP_PAC_WRCTRL_KEY_SETLCK:
+        if (status & bit) {
+            mchp_pac_error(rb, "already protected", perid);
+            break;
+        }
+        status |= bit;
+        if (key == MCHP_PAC_WRCTRL_KEY_SETLCK) {
+            s->locked[bridge] |= bit;
+        }
+        break;
+    default:
+        mchp_pac_error(rb, "invalid key", perid);
+        break;
+    }
+    mchp_regfile_poke(rf, offset, 4, status);
+}
+
+static bool mchp_pac_irq_pending(MchpRegBlock *s)
+{
+    uint32_t flags = 0;
+
+    for (hwaddr off = A_MCHP_PAC_INTFLAGAHB; off <= A_MCHP_PAC_INTFLAGD;
+         off += 4) {
+        flags |= mchp_reg(s, off, 4);
+    }
+    return flags &&
+           (mchp_reg(s, A_MCHP_PAC_INTENSET, 1) & R_MCHP_PAC_INTENSET_ERR_MASK);
+}
+
+static void mchp_pac_reset_hold(MchpRegBlock *rb)
+{
+    MchpPacState *s = MCHP_PAC(rb);
+
+    memset(s->locked, 0, sizeof(s->locked));
+}
+
+static const VMStateDescription vmstate_mchp_pac = {
+    .name = TYPE_MCHP_PAC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpPacState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_UINT32_ARRAY(locked, MchpPacState, MCHP_PAC_NUM_BRIDGES),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_pac_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_pac;
+    c->post_write = mchp_pac_post_write;
+    c->irq_pending = mchp_pac_irq_pending;
+    c->reset_hold = mchp_pac_reset_hold;
+    c->log_writes = false;
+}
+
+/* DSU */
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpDsuState, MCHP_DSU)
+
+struct MchpDsuState {
+    MchpRegBlock parent_obj;
+
+    uint8_t revision;
+};
+
+static void mchp_dsu_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                unsigned idx, uint32_t old,
+                                uint32_t written, uint32_t we)
+{
+    MchpRegBlock *s = rf->opaque;
+
+    if (ri->offset != A_MCHP_DSU_CTRL) {
+        return;                 /* CTRL.SWRST is handled by mchp-regblock */
+    }
+    if (FIELD_EX32(written, MCHP_DSU_CTRL, CRC)) {
+        qemu_log_mask(LOG_UNIMP, "%s.CTRL: CRC32 not modelled\n", s->name);
+    }
+    if (FIELD_EX32(written, MCHP_DSU_CTRL, CE)) {
+        qemu_log_mask(LOG_UNIMP, "%s.CTRL: chip erase not modelled\n",
+                      s->name);
+    }
+}
+
+static void mchp_dsu_reset_hold(MchpRegBlock *rb)
+{
+    MchpDsuState *s = MCHP_DSU(rb);
+    uint32_t did = mchp_reg(rb, A_MCHP_DSU_DID, 4);
+
+    mchp_regfile_poke(&rb->rf, A_MCHP_DSU_DID, 4,
+                      FIELD_DP32(did, MCHP_DSU_DID, REVISION, s->revision));
+}
+
+static bool mchp_dsu_realize(MchpRegBlock *rb, Error **errp)
+{
+    MchpDsuState *s = MCHP_DSU(rb);
+
+    if (s->revision > R_MCHP_DSU_DID_REVISION_MASK >>
+                      R_MCHP_DSU_DID_REVISION_SHIFT) {
+        error_setg(errp, "%s: revision %u does not fit DID.REVISION",
+                   rb->name, s->revision);
+        return false;
+    }
+    return true;
+}
+
+static const Property mchp_dsu_properties[] = {
+    DEFINE_PROP_UINT8("revision", MchpDsuState, revision, 1),
+};
+
+static void mchp_dsu_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    device_class_set_props(dc, mchp_dsu_properties);
+    c->realize = mchp_dsu_realize;
+    c->post_write = mchp_dsu_post_write;
+    c->reset_hold = mchp_dsu_reset_hold;
+    c->log_writes = false;
+}
+
+/* DIVAS: operations complete instantly, so STATUS.BUSY stays 0. */
+
+static void mchp_divas_result(MchpRegFile *rf, uint32_t result, uint32_t rem)
+{
+    mchp_regfile_poke(rf, A_MCHP_DIVAS_RESULT, 4, result);
+    mchp_regfile_poke(rf, A_MCHP_DIVAS_REM, 4, rem);
+}
+
+/* DS 21.5.4.3-21.5.4.5 */
+static void mchp_divas_divide(MchpRegFile *rf)
+{
+    uint32_t ctrla = mchp_regfile_peek(rf, A_MCHP_DIVAS_CTRLA, 1);
+    uint32_t dividend = mchp_regfile_peek(rf, A_MCHP_DIVAS_DIVIDEND, 4);
+    uint32_t divisor = mchp_regfile_peek(rf, A_MCHP_DIVAS_DIVISOR, 4);
+    int32_t sdividend = dividend, sdivisor = divisor;
+
+    if (!divisor) {
+        mchp_reg_set_bits(rf->opaque, A_MCHP_DIVAS_STATUS, 1,
+                          R_MCHP_DIVAS_STATUS_DBZ_MASK);
+        mchp_divas_result(rf, 0, dividend);
+    } else if (!FIELD_EX32(ctrla, MCHP_DIVAS_CTRLA, SIGNED)) {
+        mchp_divas_result(rf, dividend / divisor, dividend % divisor);
+    } else if (sdividend == INT32_MIN && sdivisor == -1) {
+        /* The overflow returns the most negative number, no flag */
+        mchp_divas_result(rf, INT32_MIN, 0);
+    } else {
+        mchp_divas_result(rf, sdividend / sdivisor, sdividend % sdivisor);
+    }
+}
+
+/* Integer square root, one result bit per step */
+static uint32_t mchp_divas_isqrt(uint32_t x)
+{
+    uint32_t root = 0;
+
+    for (uint32_t bit = 1u << 30; bit; bit >>= 2) {
+        if (x >= root + bit) {
+            x -= root + bit;
+            root = (root >> 1) + bit;
+        } else {
+            root >>= 1;
+        }
+    }
+    return root;
+}
+
+static void mchp_divas_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                  unsigned idx, uint32_t old,
+                                  uint32_t written, uint32_t we)
+{
+    uint32_t num, root;
+
+    switch (ri->offset) {
+    case A_MCHP_DIVAS_DIVISOR:
+        mchp_divas_divide(rf);
+        break;
+    case A_MCHP_DIVAS_SQRNUM:
+        num = mchp_regfile_peek(rf, A_MCHP_DIVAS_SQRNUM, 4);
+        root = mchp_divas_isqrt(num);
+        mchp_divas_result(rf, root, num - root * root);
+        break;
+    }
+}
+
+static void mchp_divas_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    c->post_write = mchp_divas_post_write;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_sysctrl_types[] = {
+    {
+        .name = TYPE_MCHP_NVMCTRL,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .class_init = mchp_nvmctrl_class_init,
+    }, {
+        .name = TYPE_MCHP_SUPC,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .class_init = mchp_supc_class_init,
+    }, {
+        .name = TYPE_MCHP_RSTC,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpRstcState),
+        .instance_init = mchp_rstc_init,
+        .class_init = mchp_rstc_class_init,
+    }, {
+        .name = TYPE_MCHP_WDT,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpWdtState),
+        .instance_init = mchp_wdt_init,
+        .class_init = mchp_wdt_class_init,
+    }, {
+        .name = TYPE_MCHP_PM,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .class_init = mchp_pm_class_init,
+    }, {
+        .name = TYPE_MCHP_PAC,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpPacState),
+        .class_init = mchp_pac_class_init,
+    }, {
+        .name = TYPE_MCHP_DSU,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpDsuState),
+        .class_init = mchp_dsu_class_init,
+    }, {
+        .name = TYPE_MCHP_DIVAS,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .class_init = mchp_divas_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_sysctrl_types)
