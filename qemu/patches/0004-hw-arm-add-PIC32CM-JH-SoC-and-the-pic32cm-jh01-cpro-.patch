+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-jh/reset-values", test_reset_values);
+    qtest_add_func("pic32cm-jh/ready-bits", test_ready_bits);
+    qtest_add_func("pic32cm-jh/rcause", test_rcause);
+    qtest_add_func("pic32cm-jh/user-row-resets", test_user_row_resets);
+    qtest_add_func("pic32cm-jh/user-row-from-image", test_user_row_from_image);
+    qtest_add_func("pic32cm-jh/regfile-semantics", test_regfile_semantics);
+    qtest_add_func("pic32cm-jh/views-and-swrst", test_views_and_swrst);
+    qtest_add_func("pic32cm-jh/clock-tree", test_clock_tree);
+    qtest_add_func("pic32cm-jh/shared-irq", test_shared_irq);
+    qtest_add_func("pic32cm-jh/pac", test_pac);
+    qtest_add_func("pic32cm-jh/divas", test_divas);
+    qtest_add_func("pic32cm-jh/soc-properties", test_soc_properties);
+
+    return g_test_run();
+}
