diff --git a/hw/arm/pic32cm_jh01_cpro.c b/hw/arm/pic32cm_jh01_cpro.c
new file mode 100644
index 0000000..538bf5a
--- /dev/null
+++ b/hw/arm/pic32cm_jh01_cpro.c
@@ -0,0 +1,104 @@
+/*
+ * Microchip PIC32CM JH01 Curiosity Pro board (EV81X90A)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * PIC32CM5164JH01100 with a 32 MHz crystal on XIN/XOUT and a 32.768 kHz
+ * crystal on XIN32/XOUT32 (board user guide DS70005482B).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/arm/boot.h"
+#include "hw/arm/machines-qom.h"
+#include "hw/arm/pic32cm_jh_soc.h"
+#include "hw/core/boards.h"
+#include "hw/core/qdev-clock.h"
+#include "system/system.h"
+
+#define CPRO_XOSC_HZ        32000000
+#define CPRO_XOSC32K_HZ     32768
+
+/* serial_hd(i) is wired to SERCOM pic32cm_jh01_cpro_serial[i] */
+static const unsigned pic32cm_jh01_cpro_serial[] = {
+    4,                          /* EDBG virtual COM port (PB10/PB11) */
+    2,                          /* EXT1 */
+    3,                          /* EXT2 */
+    6,                          /* EXT3 */
+    0,                          /* LIN */
+};
+
+#define TYPE_PIC32CM_JH01_CPRO_MACHINE MACHINE_TYPE_NAME("pic32cm-jh01-cpro")
+OBJECT_DECLARE_SIMPLE_TYPE(Pic32cmJh01CproState, PIC32CM_JH01_CPRO_MACHINE)
+
+struct Pic32cmJh01CproState {
+    MachineState parent_obj;
+
+    Pic32cmJhSocState soc;
+    Clock *xosc;
+    Clock *xosc32k;
+};
+
+static void pic32cm_jh01_cpro_init(MachineState *machine)
+{
+    Pic32cmJh01CproState *s = PIC32CM_JH01_CPRO_MACHINE(machine);
+    DeviceState *soc;
+
+    s->xosc = clock_new(OBJECT(machine), "xosc");
+    clock_set_hz(s->xosc, CPRO_XOSC_HZ);
+    s->xosc32k = clock_new(OBJECT(machine), "xosc32k");
+    clock_set_hz(s->xosc32k, CPRO_XOSC32K_HZ);
+
+    object_initialize_child(OBJECT(machine), "soc", &s->soc,
+                            TYPE_PIC32CM5164JH01100_SOC);
+    soc = DEVICE(&s->soc);
+    qdev_connect_clock_in(soc, "xosc", s->xosc);
+    qdev_connect_clock_in(soc, "xosc32k", s->xosc32k);
+    for (unsigned i = 0; i < ARRAY_SIZE(pic32cm_jh01_cpro_serial); i++) {
+        pic32cm_jh_soc_connect_serial(&s->soc, pic32cm_jh01_cpro_serial[i],
+                                      serial_hd(i));
+    }
+    sysbus_realize(SYS_BUS_DEVICE(soc), &error_fatal);
+
+    armv7m_load_kernel(s->soc.armv7m.cpu, machine->kernel_filename,
+                       PIC32CM5164JH01100_FLASH_BASE,
+                       PIC32CM5164JH01100_FLASH_SIZE);
+}
+
+/* QEMU has no cortex-m0plus; give its cortex-m0 the M0+ CPUID */
+static GlobalProperty pic32cm_jh01_cpro_compat[] = {
+    { ARM_CPU_TYPE_NAME("cortex-m0"), "midr", stringify(PIC32CM_JH_CPUID) },
+};
+
+static void pic32cm_jh01_cpro_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    static const char *const valid_cpu_types[] = {
+        ARM_CPU_TYPE_NAME("cortex-m0"),
+        NULL
+    };
+
+    mc->desc = "Microchip PIC32CM JH01 Curiosity Pro (EV81X90A, Cortex-M0+)";
+    mc->init = pic32cm_jh01_cpro_init;
+    mc->max_cpus = 1;
+    mc->valid_cpu_types = valid_cpu_types;
+    /* SRAM is part of the SoC */
+    mc->default_ram_size = 0;
+    compat_props_add(mc->compat_props, pic32cm_jh01_cpro_compat,
+                     G_N_ELEMENTS(pic32cm_jh01_cpro_compat));
+}
+
+static const TypeInfo pic32cm_jh01_cpro_types[] = {
+    {
+        .name = TYPE_PIC32CM_JH01_CPRO_MACHINE,
+        .parent = TYPE_MACHINE,
+        .instance_size = sizeof(Pic32cmJh01CproState),
+        .class_init = pic32cm_jh01_cpro_class_init,
+        .interfaces = arm_machine_interfaces,
+    },
+};
+
+DEFINE_TYPES(pic32cm_jh01_cpro_types)
diff --git a/hw/arm/pic32cm_jh_soc.c b/hw/arm/pic32cm_jh_soc.c
new file mode 100644
index 0000000..099eab3
--- /dev/null
+++ b/hw/arm/pic32cm_jh_soc.c
@@ -0,0 +1,467 @@
+/*
+ * Microchip PIC32CM JH01 SoC (PIC32CM5164JH01100)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Everything comes from the generated device description: the memory map,
+ * one mchp-regblock (or dedicated subclass, see pic32cm_jh_models) per
+ * peripheral instance, the NVIC lines with OR gates for shared vectors and
+ * the GCLK channel of each instance.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/units.h"
+#include "hw/arm/pic32cm_jh_soc.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/misc/mchp_sysctrl.h"
+#include "hw/misc/unimp.h"
+#include "system/address-spaces.h"
+#include "target/arm/cpu-qom.h"
+#include "pic32cm5164jh01100_nvmrows.h"
+
+/*
+ * The QOM type modelling each ATDF module. Every other instance is a
+ * generic mchp-regblock; a dedicated model only needs a line here.
+ */
+static const struct {
+    const char *module;
+    const char *type;
+} pic32cm_jh_models[] = {
+    { "DIVAS", TYPE_MCHP_DIVAS },
+    { "DSU", TYPE_MCHP_DSU },
+    { "GCLK", TYPE_MCHP_GCLK },
+    { "MCLK", TYPE_MCHP_MCLK },
+    { "NVMCTRL", TYPE_MCHP_NVMCTRL },
+    { "OSC32KCTRL", TYPE_MCHP_OSC32KCTRL },
+    { "OSCCTRL", TYPE_MCHP_OSCCTRL },
+    { "PAC", TYPE_MCHP_PAC },
+    { "PM", TYPE_MCHP_PM },
+    { "RSTC", TYPE_MCHP_RSTC },
+    { "SUPC", TYPE_MCHP_SUPC },
+    { "WDT", TYPE_MCHP_WDT },
+};
+
+/* Oscillator outputs feeding the GCLK generator sources of the same name */
+static const struct {
+    int inst;
+    const char *clock;
+} pic32cm_jh_gclk_sources[] = {
+    { PIC32CM5164JH01100_INST_OSCCTRL, "xosc" },
+    { PIC32CM5164JH01100_INST_OSCCTRL, "osc48m" },
+    { PIC32CM5164JH01100_INST_OSCCTRL, "fdpll96m" },
+    { PIC32CM5164JH01100_INST_OSC32KCTRL, "xosc32k" },
+    { PIC32CM5164JH01100_INST_OSC32KCTRL, "osc32k" },
+    { PIC32CM5164JH01100_INST_OSC32KCTRL, "osculp32k" },
+};
+
+static const char *pic32cm_jh_model_type(const MchpInstanceInfo *info)
+{
+    for (unsigned i = 0; i < ARRAY_SIZE(pic32cm_jh_models); i++) {
+        if (!strcmp(pic32cm_jh_models[i].module, info->module)) {
+            return pic32cm_jh_models[i].type;
+        }
+    }
+    return TYPE_MCHP_REGBLOCK;
+}
+
+static bool pic32cm_jh_has_regs(const MchpInstanceInfo *info)
+{
+    return !(info->flags & (MCHP_INST_CORE | MCHP_INST_FUSES |
+                            MCHP_INST_NO_REGS));
+}
+
+static const MchpIrqLine *pic32cm_jh_irq_line(int line)
+{
+    for (unsigned i = 0; i < PIC32CM5164JH01100_NUM_IRQ_LINES; i++) {
+        if (pic32cm5164jh01100_irq_lines[i].line == line) {
+            return &pic32cm5164jh01100_irq_lines[i];
+        }
+    }
+    g_assert_not_reached();
+}
+
+static DeviceState *pic32cm_jh_periph(Pic32cmJhSocState *s, int inst)
+{
+    assert(s->periph[inst]);
+    return s->periph[inst];
+}
+
+/* The GCLK peripheral channel that @param of @instance names. */
+static Clock *pic32cm_jh_gclk_channel(Pic32cmJhSocState *s,
+                                      const char *instance, const char *param)
+{
+    DeviceState *gclk = pic32cm_jh_periph(s, PIC32CM5164JH01100_INST_GCLK);
+
+    for (unsigned i = 0; i < PIC32CM5164JH01100_NUM_GCLK_CHANNEL_USERS; i++) {
+        const MchpPeriphRef *ref = &pic32cm5164jh01100_gclk_channels[i];
+
+        if (!strcmp(ref->instance, instance) && !strcmp(ref->param, param)) {
+            g_autofree char *name = g_strdup_printf("pch[%u]", ref->id);
+
+            return qdev_get_clock_out(gclk, name);
+        }
+    }
+    g_assert_not_reached();
+}
+
+void pic32cm_jh_soc_connect_serial(Pic32cmJhSocState *s, unsigned sercom,
+                                   Chardev *chr)
+{
+    assert(sercom < PIC32CM_JH_NUM_SERCOM);
+    s->sercom_chr[sercom] = chr;
+}
+
+static void pic32cm_jh_soc_init(Object *obj)
+{
+    Pic32cmJhSocState *s = PIC32CM5164JH01100_SOC(obj);
+
+    object_initialize_child(obj, "armv7m", &s->armv7m, TYPE_ARMV7M);
+
+    for (unsigned i = 0; i < PIC32CM5164JH01100_NUM_IRQ_LINES; i++) {
+        const MchpIrqLine *line = &pic32cm5164jh01100_irq_lines[i];
+        g_autofree char *lower = NULL;
+        g_autofree char *name = NULL;
+
+        if (line->nsources < 2) {
+            continue;
+        }
+        lower = g_ascii_strdown(line->name, -1);
+        name = g_strdup_printf("%s-irq-or", lower);
+        object_initialize_child(obj, name, &s->irq_or[line->line],
+                                TYPE_OR_IRQ);
+    }
+
+    for (unsigned i = 0; i < PIC32CM5164JH01100_NUM_INSTANCES; i++) {
+        const MchpInstanceInfo *info = &pic32cm5164jh01100_instances[i];
+        g_autofree char *name = g_ascii_strdown(info->name, -1);
+        Object *child;
+
+        if (!pic32cm_jh_has_regs(info)) {
+            continue;
+        }
+        child = object_new(pic32cm_jh_model_type(info));
+        object_property_add_child(obj, name, child);
+        object_unref(child);
+        mchp_regblock_set_info(MCHP_REGBLOCK(child), info);
+        s->periph[i] = DEVICE(child);
+    }
+
+    qdev_alias_clock(pic32cm_jh_periph(s, PIC32CM5164JH01100_INST_OSCCTRL),
+                     "xtal", DEVICE(s), "xosc");
+    qdev_alias_clock(pic32cm_jh_periph(s, PIC32CM5164JH01100_INST_OSC32KCTRL),
+                     "xtal32k", DEVICE(s), "xosc32k");
+}
+
+/* "serial-number": 32 hex digits, word 0 first; default from the image */
+static bool pic32cm_jh_serial(Pic32cmJhSocState *s, uint32_t serial[4],
+                              Error **errp)
+{
+    const char *str = s->serial_number;
+
+    if (!str) {
+        memcpy(serial, pic32cm5164jh01100_serial_default,
+               sizeof(pic32cm5164jh01100_serial_default));
+        return true;
+    }
+    if (strlen(str) != 32) {
+        error_setg(errp, "serial-number must be 32 hex digits");
+        return false;
+    }
+    memset(serial, 0, 4 * sizeof(uint32_t));
+    for (unsigned i = 0; i < 32; i++) {
+        int digit = g_ascii_xdigit_value(str[i]);
+
+        if (digit < 0) {
+            error_setg(errp, "serial-number must be 32 hex digits");
+            return false;
+        }
+        serial[i / 8] = serial[i / 8] << 4 | digit;
+    }
+    return true;
+}
+
+/* "silicon-rev" -> DSU DID.REVISION (errata DS80001000 Table 2) */
+static bool pic32cm_jh_revision(Pic32cmJhSocState *s, uint8_t *rev,
+                                Error **errp)
+{
+    if (!s->silicon_rev || !strcmp(s->silicon_rev, "B0")) {
+        *rev = 1;
+    } else if (!strcmp(s->silicon_rev, "C0")) {
+        *rev = 2;
+    } else {
+        error_setg(errp, "silicon-rev must be \"B0\" or \"C0\"");
+        return false;
+    }
+    return true;
+}
+
+/* Erased flash reads as 0xFF; images are loaded over it at reset. */
+static bool pic32cm_jh_init_flash(Pic32cmJhSocState *s, MemoryRegion *mr,
+                                  const char *name, hwaddr base,
+                                  uint64_t size, Error **errp)
+{
+    if (!memory_region_init_rom(mr, OBJECT(s), name, size, errp)) {
+        return false;
+    }
+    memset(memory_region_get_ram_ptr(mr), 0xFF, size);
+    memory_region_add_subregion(get_system_memory(), base, mr);
+    return true;
+}
+
+static bool pic32cm_jh_init_memory(Pic32cmJhSocState *s, Error **errp)
+{
+    MemoryRegion *sysmem = get_system_memory();
+    uint32_t serial[4];
+
+    if (!pic32cm_jh_serial(s, serial, errp) ||
+        !pic32cm_jh_init_flash(s, &s->flash, "flash",
+                               PIC32CM5164JH01100_FLASH_BASE,
+                               PIC32CM5164JH01100_FLASH_SIZE, errp) ||
+        !pic32cm_jh_init_flash(s, &s->dataflash, "dataflash",
+                               PIC32CM5164JH01100_DATAFLASH_BASE,
+                               PIC32CM5164JH01100_DATAFLASH_SIZE, errp)) {
+        return false;
+    }
+
+    /* Calibration, lock, user and OTP rows plus the serial number */
+    if (!memory_region_init_rom(&s->nvm_rows, OBJECT(s), "nvm-rows",
+                                PIC32CM5164JH01100_NVMROWS_SIZE, errp)) {
+        return false;
+    }
+    pic32cm5164jh01100_nvmrows_fill(memory_region_get_ram_ptr(&s->nvm_rows),
+                                    serial);
+    memory_region_add_subregion(sysmem, PIC32CM5164JH01100_NVMROWS_BASE,
+                                &s->nvm_rows);
+
+    if (!memory_region_init_ram(&s->sram, OBJECT(s), "sram",
+                                PIC32CM5164JH01100_DRAM_SIZE, errp)) {
+        return false;
+    }
+    memory_region_add_subregion(sysmem, PIC32CM5164JH01100_DRAM_BASE,
+                                &s->sram);
+
+    /* Reserved space on the peripheral bridges */
+    for (unsigned i = 0; i < PIC32CM5164JH01100_NUM_MEM_SEGMENTS; i++) {
+        const MchpMemSegment *seg = &pic32cm5164jh01100_mem_segments[i];
+        g_autofree char *name = g_ascii_strdown(seg->name, -1);
+
+        if (g_str_has_prefix(seg->name, "HPB")) {
+            create_unimplemented_device(name, seg->base, seg->size);
+        }
+    }
+    return true;
+}
+
+static void pic32cm_jh_connect_clocks(Pic32cmJhSocState *s)
+{
+    DeviceState *oscctrl = pic32cm_jh_periph(s,
+                                             PIC32CM5164JH01100_INST_OSCCTRL);
+    DeviceState *osc32k = pic32cm_jh_periph(s,
+                                            PIC32CM5164JH01100_INST_OSC32KCTRL);
+    DeviceState *gclk = pic32cm_jh_periph(s, PIC32CM5164JH01100_INST_GCLK);
+    DeviceState *mclk = pic32cm_jh_periph(s, PIC32CM5164JH01100_INST_MCLK);
+
+    for (unsigned i = 0; i < ARRAY_SIZE(pic32cm_jh_gclk_sources); i++) {
+        const char *clock = pic32cm_jh_gclk_sources[i].clock;
+        DeviceState *osc = pic32cm_jh_periph(s,
+                                             pic32cm_jh_gclk_sources[i].inst);
+
+        qdev_connect_clock_in(gclk, clock, qdev_get_clock_out(osc, clock));
+    }
+    qdev_connect_clock_in(oscctrl, "dpll-ref-xosc32k",
+                          qdev_get_clock_out(osc32k, "xosc32k"));
+    qdev_connect_clock_in(oscctrl, "dpll-ref-gclk",
+                          pic32cm_jh_gclk_channel(s, "OSCCTRL",
+                                                  "GCLK_ID_FDPLL"));
+    qdev_connect_clock_in(mclk, "gclk-main",
+                          qdev_get_clock_out(gclk, "gen[0]"));
+
+    for (unsigned i = 0; i < PIC32CM5164JH01100_NUM_INSTANCES; i++) {
+        const MchpInstanceInfo *info = &pic32cm5164jh01100_instances[i];
+        g_autofree char *pch = NULL;
+
+        if (!s->periph[i] || info->gclk_core < 0) {
+            continue;
+        }
+        pch = g_strdup_printf("pch[%d]", info->gclk_core);
+        qdev_connect_clock_in(s->periph[i], "gclk",
+                              qdev_get_clock_out(gclk, pch));
+    }
+}
+
+static bool pic32cm_jh_realize_cpu(Pic32cmJhSocState *s, Error **errp)
+{
+    DeviceState *armv7m = DEVICE(&s->armv7m);
+    DeviceState *mclk = pic32cm_jh_periph(s, PIC32CM5164JH01100_INST_MCLK);
+
+    qdev_prop_set_string(armv7m, "cpu-type", ARM_CPU_TYPE_NAME("cortex-m0"));
+    qdev_prop_set_uint32(armv7m, "num-irq", PIC32CM5164JH01100_NUM_IRQ);
+    qdev_prop_set_uint32(armv7m, "num-prio-bits",
+                         PIC32CM5164JH01100_NVIC_PRIO_BITS);
+    /*
+     * The Cortex-M0+ MPU has 8 regions. QEMU's cortex-m0 has no
+     * pmsav7-dregion property (it is Armv7-M only), so armv7m drops this
+     * and MPU_TYPE reads 0; see docs/system/arm/pic32cm-jh01-cpro.rst.
+     */
+    qdev_prop_set_uint32(armv7m, "mpu-ns-regions", 8);
+    /* No Security Extension: the reset VTOR is the non-secure one */
+    qdev_prop_set_uint32(armv7m, "init-nsvtor", 0);
+    qdev_connect_clock_in(armv7m, "cpuclk", qdev_get_clock_out(mclk, "cpu"));
+    object_property_set_link(OBJECT(armv7m), "memory",
+                             OBJECT(get_system_memory()), &error_abort);
+    return sysbus_realize(SYS_BUS_DEVICE(armv7m), errp);
+}
+
+static bool pic32cm_jh_realize_irq_or(Pic32cmJhSocState *s, Error **errp)
+{
+    for (unsigned i = 0; i < PIC32CM5164JH01100_NUM_IRQ_LINES; i++) {
+        const MchpIrqLine *line = &pic32cm5164jh01100_irq_lines[i];
+        DeviceState *gate;
+
+        if (line->nsources < 2) {
+            continue;
+        }
+        gate = DEVICE(&s->irq_or[line->line]);
+        if (!object_property_set_int(OBJECT(gate), "num-lines",
+                                     line->nsources, errp) ||
+            !qdev_realize(gate, NULL, errp)) {
+            return false;
+        }
+        qdev_connect_gpio_out(gate, 0,
+                              qdev_get_gpio_in(DEVICE(&s->armv7m),
+                                               line->line));
+    }
+    return true;
+}
+
+static qemu_irq pic32cm_jh_irq_input(Pic32cmJhSocState *s,
+                                     const MchpInstanceInfo *info)
+{
+    if (pic32cm_jh_irq_line(info->irq)->nsources > 1) {
+        return qdev_get_gpio_in(DEVICE(&s->irq_or[info->irq]),
+                                info->irq_input);
+    }
+    return qdev_get_gpio_in(DEVICE(&s->armv7m), info->irq);
+}
+
+/* Board-level wiring of SERCOM<n>: its chardev, if the model takes one */
+static void pic32cm_jh_connect_sercom(Pic32cmJhSocState *s, DeviceState *dev,
+                                      const MchpInstanceInfo *info)
+{
+    unsigned n = info->name[strlen("SERCOM")] - '0';
+    Chardev *chr = s->sercom_chr[n];
+
+    if (!chr) {
+        return;
+    }
+    if (object_property_find(OBJECT(dev), "chardev")) {
+        qdev_prop_set_chr(dev, "chardev", chr);
+    } else {
+        qemu_log_mask(LOG_UNIMP, "sercom%u: no UART model; serial port not"
+                      " connected\n", n);
+    }
+}
+
+static bool pic32cm_jh_realize_periph(Pic32cmJhSocState *s, uint8_t rev,
+                                      Error **errp)
+{
+    for (unsigned i = 0; i < PIC32CM5164JH01100_NUM_INSTANCES; i++) {
+        const MchpInstanceInfo *info = &pic32cm5164jh01100_instances[i];
+        DeviceState *dev = s->periph[i];
+        SysBusDevice *sbd;
+
+        if (info->flags & MCHP_INST_NO_REGS) {
+            g_autofree char *name = g_ascii_strdown(info->name, -1);
+
+            create_unimplemented_device(name, info->base, info->slot_size);
+            continue;
+        }
+        if (!dev) {
+            continue;
+        }
+        sbd = SYS_BUS_DEVICE(dev);
+        if (i == PIC32CM5164JH01100_INST_DSU) {
+            qdev_prop_set_uint8(dev, "revision", rev);
+        } else if (!strcmp(info->module, "SERCOM")) {
+            pic32cm_jh_connect_sercom(s, dev, info);
+        }
+        if (!sysbus_realize(sbd, errp)) {
+            return false;
+        }
+        sysbus_mmio_map(sbd, 0, info->base);
+        if (info->alias_size) {
+            /* IOBUS views, and DSU_EXT inside the DSU slot */
+            sysbus_mmio_map_overlap(sbd, 1, info->alias_base, 1);
+        }
+        if (info->irq >= 0) {
+            sysbus_connect_irq(sbd, 0, pic32cm_jh_irq_input(s, info));
+        }
+    }
+    return true;
+}
+
+/* Reset sources that RSTC records in RCAUSE */
+static void pic32cm_jh_connect_resets(Pic32cmJhSocState *s)
+{
+    DeviceState *rstc = pic32cm_jh_periph(s, PIC32CM5164JH01100_INST_RSTC);
+    DeviceState *wdt = pic32cm_jh_periph(s, PIC32CM5164JH01100_INST_WDT);
+
+    qdev_connect_gpio_out_named(DEVICE(&s->armv7m), "SYSRESETREQ", 0,
+        qdev_get_gpio_in_named(rstc, MCHP_RSTC_RESET_CAUSE,
+                               R_MCHP_RSTC_RCAUSE_SYST_SHIFT));
+    qdev_connect_gpio_out_named(wdt, MCHP_WDT_SYSTEM_RESET, 0,
+        qdev_get_gpio_in_named(rstc, MCHP_RSTC_RESET_CAUSE,
+                               R_MCHP_RSTC_RCAUSE_WDT_SHIFT));
+}
+
+static void pic32cm_jh_soc_realize(DeviceState *dev, Error **errp)
+{
+    Pic32cmJhSocState *s = PIC32CM5164JH01100_SOC(dev);
+    uint8_t rev;
+
+    if (!pic32cm_jh_revision(s, &rev, errp) ||
+        !pic32cm_jh_init_memory(s, errp)) {
+        return;
+    }
+    pic32cm_jh_connect_clocks(s);
+    if (!pic32cm_jh_realize_cpu(s, errp) ||
+        !pic32cm_jh_realize_irq_or(s, errp) ||
+        !pic32cm_jh_realize_periph(s, rev, errp)) {
+        return;
+    }
+    pic32cm_jh_connect_resets(s);
+}
+
+static const Property pic32cm_jh_soc_properties[] = {
+    DEFINE_PROP_STRING("silicon-rev", Pic32cmJhSocState, silicon_rev),
+    DEFINE_PROP_STRING("serial-number", Pic32cmJhSocState, serial_number),
+};
+
+static void pic32cm_jh_soc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = pic32cm_jh_soc_realize;
+    device_class_set_props(dc, pic32cm_jh_soc_properties);
+    /* Reason: mapped at fixed addresses on the system bus */
+    dc->user_creatable = false;
+}
+
+static const TypeInfo pic32cm_jh_soc_types[] = {
+    {
+        .name = TYPE_PIC32CM5164JH01100_SOC,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(Pic32cmJhSocState),
+        .instance_init = pic32cm_jh_soc_init,
+        .class_init = pic32cm_jh_soc_class_init,
+    },
+};
+
+DEFINE_TYPES(pic32cm_jh_soc_types)
