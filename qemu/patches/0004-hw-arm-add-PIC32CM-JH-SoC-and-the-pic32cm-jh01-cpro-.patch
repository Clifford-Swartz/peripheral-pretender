diff --git a/tests/qtest/pic32cm-jh-test.c b/tests/qtest/pic32cm-jh-test.c
new file mode 100644
index 0000000..28a3a95
--- /dev/null
+++ b/tests/qtest/pic32cm-jh-test.c
@@ -0,0 +1,399 @@
+/*
+ * QTest for the PIC32CM JH01 Curiosity Pro machine (pic32cm-jh01-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Addresses and values come from DS60001632H (PIC32CM JH00/JH01 data
+ * sheet), not from the generated tables, so the test checks them.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M pic32cm-jh01-cpro "
+
+#define PAC             0x40000000
+#define MCLK            0x40000800
+#define RSTC            0x40000C00
+#define OSCCTRL         0x40001000
+#define OSC32KCTRL      0x40001400
+#define SUPC            0x40001800
+#define GCLK            0x40001C00
+#define WDT             0x40002000
+#define DSU             0x41002000
+#define DSU_EXT         0x41002100
+#define NVMCTRL         0x41004000
+#define SERCOM4         0x42001400
+#define TC0             0x42003000
+#define DIVAS           0x48000000
+#define DIVAS_IOBUS     0x60000200
+#define USER_ROW        0x00804000
+#define SERIAL_WORD0    0x0080A00C
+#define SERIAL_WORD1    0x0080A040
+#define SRAM            0x20000000
+
+#define NVIC_ISER       0xE000E100
+#define NVIC_ISPR       0xE000E200
+#define NVIC_ICPR       0xE000E280
+#define SCB_CPUID       0xE000ED00
+#define SCB_AIRCR       0xE000ED0C
+
+#define RCAUSE_POR      0x01
+#define RCAUSE_EXT      0x10
+#define RCAUSE_WDT      0x20
+#define RCAUSE_SYST     0x40
+
+/* Frequency of a QOM Clock object, from its period in 2^-32 ns. */
+static uint64_t clock_hz(QTestState *qts, const char *path)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': %s,"
+                           " 'property': 'qtest-clock-period' } }", path);
+    uint64_t period;
+
+    g_assert(qdict_haskey(rsp, "return"));
+    period = qdict_get_int(rsp, "return");
+    qobject_unref(rsp);
+    return period ? (1000000000ULL << 32) / period : 0;
+}
+
+static void test_reset_values(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* GCLK generator 0 runs from OSC48M (DS 14.7.3, ATDF says 0) */
+    g_assert_cmphex(qtest_readl(qts, GCLK + 0x20), ==, 0x00000106);
+    g_assert_cmphex(qtest_readl(qts, GCLK + 0x24), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, GCLK + 0x04), ==, 0);    /* SYNCBUSY */
+    /* NVMCTRL: PARAM, CTRLB.MANW, INTFLAG.READY */
+    g_assert_cmphex(qtest_readl(qts, NVMCTRL + 0x08), ==, 0x08032000);
+    g_assert_cmphex(qtest_readl(qts, NVMCTRL + 0x04), ==, 0x00000080);
+    g_assert_cmphex(qtest_readl(qts, NVMCTRL + 0x14), ==, 0x00000001);
+    /* DSU.DID of rev B0, also through DSU_EXT */
+    g_assert_cmphex(qtest_readl(qts, DSU + 0x18), ==, 0x11060100);
+    g_assert_cmphex(qtest_readl(qts, DSU_EXT + 0x18), ==, 0x11060100);
+    /* PAC: DSU and SMBIST (and bit 24) write-protected */
+    g_assert_cmphex(qtest_readl(qts, PAC + 0x34), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, PAC + 0x38), ==, 0x00000002);
+    g_assert_cmphex(qtest_readl(qts, PAC + 0x3C), ==, 0x09000000);
+    /* Production user row (DS Table 10-3) */
+    g_assert_cmphex(qtest_readl(qts, USER_ROW), ==, 0xB15088FB);
+    g_assert_cmphex(qtest_readl(qts, USER_ROW + 4), ==, 0xFFFFF8BB);
+    /* SYNCBUSY registers read 0 */
+    g_assert_cmphex(qtest_readl(qts, WDT + 0x08), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, SERCOM4 + 0x1C), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, OSCCTRL + 0x18), ==, 0);
+    g_assert_cmphex(qtest_readb(qts, OSCCTRL + 0x2C), ==, 0);
+    /* OSC48M on, divided by 12; MCLK.INTFLAG.CKRDY */
+    g_assert_cmphex(qtest_readb(qts, OSCCTRL + 0x14), ==, 0x82);
+    g_assert_cmphex(qtest_readb(qts, OSCCTRL + 0x15), ==, 0x0B);
+    g_assert_cmphex(qtest_readb(qts, MCLK + 0x03), ==, 0x01);
+    /* Cortex-M0+ r0p1 CPUID */
+    g_assert_cmphex(qtest_readl(qts, SCB_CPUID), ==, 0x410CC601);
+    qtest_quit(qts);
+}
+
+static void test_ready_bits(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* OSC48MRDY follows OSC48MCTRL.ENABLE */
+    g_assert_cmphex(qtest_readl(qts, OSCCTRL + 0x0C), ==, 0x10);
+    /* XOSC with the board's crystal */
+    qtest_writew(qts, OSCCTRL + 0x10, 0x0006);       /* ENABLE | XTALEN */
+    g_assert_cmphex(qtest_readl(qts, OSCCTRL + 0x0C), ==, 0x11);
+    g_assert_cmphex(qtest_readl(qts, OSCCTRL + 0x08) & 0x1, ==, 0x1);
+    /* XOSC32K and OSC32K */
+    g_assert_cmphex(qtest_readl(qts, OSC32KCTRL + 0x0C), ==, 0);
+    qtest_writew(qts, OSC32KCTRL + 0x14, 0x000E);    /* ENABLE, XTALEN, EN32K */
+    qtest_writel(qts, OSC32KCTRL + 0x18, 0x0006);    /* ENABLE, EN32K */
+    g_assert_cmphex(qtest_readl(qts, OSC32KCTRL + 0x0C), ==, 0x3);
+    g_assert_cmphex(qtest_readl(qts, OSC32KCTRL + 0x08), ==, 0x3);
+    /* SUPC: BODVDD enabled by the user row; BVDDSRDY always */
+    g_assert_cmphex(qtest_readl(qts, SUPC + 0x0C), ==, 0x5);
+    qtest_quit(qts);
+}
+
+static void test_rcause(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    g_assert_cmphex(qtest_readb(qts, RSTC), ==, RCAUSE_POR);
+
+    /* SYSRESETREQ: RCAUSE.SYST, SRAM survives the reset */
+    qtest_writel(qts, SRAM + 0x100, 0xC0FFEE00);
+    qtest_writel(qts, SCB_AIRCR, 0x05FA0004);
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_cmphex(qtest_readb(qts, RSTC), ==, RCAUSE_SYST);
+    g_assert_cmphex(qtest_readl(qts, SRAM + 0x100), ==, 0xC0FFEE00);
+
+    /* A wrong WDT.CLEAR key with the watchdog on: RCAUSE.WDT */
+    qtest_writeb(qts, WDT + 0x00, 0x02);             /* CTRLA.ENABLE */
+    qtest_writeb(qts, WDT + 0x0C, 0x5A);
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_cmphex(qtest_readb(qts, RSTC), ==, RCAUSE_WDT);
+    g_assert_cmphex(qtest_readb(qts, WDT + 0x00), ==, 0);
+
+    /* A reset nobody announced is an external one */
+    qtest_system_reset(qts);
+    g_assert_cmphex(qtest_readb(qts, RSTC), ==, RCAUSE_EXT);
+    qtest_quit(qts);
+}
+
+static void test_user_row_resets(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* WDT from the production row: off, PER/WINDOW/EWOFFSET 0xB */
+    g_assert_cmphex(qtest_readb(qts, WDT + 0x00), ==, 0x00);
+    g_assert_cmphex(qtest_readb(qts, WDT + 0x01), ==, 0xBB);
+    g_assert_cmphex(qtest_readb(qts, WDT + 0x02), ==, 0x0B);
+    /* SUPC.BODVDD: LEVEL 8, ACTION reset, enabled */
+    g_assert_cmphex(qtest_readl(qts, SUPC + 0x10), ==, 0x0008000A);
+    /* NVMCTRL.LOCK from the region lock bits */
+    g_assert_cmphex(qtest_readw(qts, NVMCTRL + 0x20), ==, 0xFFFF);
+    qtest_quit(qts);
+}
+
+/* Fuse words in the loaded image take effect at the first reset. */
+static void test_user_row_from_image(void)
+{
+    static const uint8_t row[8] = {
+        0xFB, 0xC8, 0x50, 0xB5,     /* 0xB550C8FB: WDT on, BODVDD off */
+        0xBB, 0xF8, 0xFF, 0xFF,
+    };
+    g_autofree char *path = NULL;
+    g_autoptr(GString) hex = g_string_new(":0200000400807A\n:08400000");
+    unsigned sum = 0x08 + 0x40;
+    QTestState *qts;
+    int fd;
+
+    if (!qtest_has_device("loader")) {
+        g_test_skip("generic loader not built");
+        return;
+    }
+    for (unsigned i = 0; i < sizeof(row); i++) {
+        g_string_append_printf(hex, "%02X", row[i]);
+        sum += row[i];
+    }
+    g_string_append_printf(hex, "%02X\n:00000001FF\n", (0x100 - sum) & 0xFF);
+    fd = g_file_open_tmp("pic32cm-user-row-XXXXXX.hex", &path, NULL);
+    g_assert(fd >= 0);
+    close(fd);
+    g_assert(g_file_set_contents(path, hex->str, hex->len, NULL));
+
+    qts = qtest_initf(MACHINE "-device loader,file=%s", path);
+    for (int reset = 0; reset < 2; reset++) {
+        g_assert_cmphex(qtest_readl(qts, USER_ROW), ==, 0xB550C8FB);
+        g_assert_cmphex(qtest_readb(qts, WDT + 0x00), ==, 0x02);
+        g_assert_cmphex(qtest_readl(qts, SUPC + 0x10) & 0x2, ==, 0);
+        g_assert_cmphex(qtest_readl(qts, SUPC + 0x0C), ==, 0x4);
+        qtest_system_reset(qts);
+    }
+    qtest_quit(qts);
+    unlink(path);
+}
+
+static void test_regfile_semantics(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* One access spanning three byte registers and a reserved byte */
+    g_assert_cmphex(qtest_readl(qts, OSCCTRL + 0x14), ==, 0x00070B82);
+    /* Read-only registers ignore writes */
+    qtest_writel(qts, NVMCTRL + 0x08, 0);
+    g_assert_cmphex(qtest_readl(qts, NVMCTRL + 0x08), ==, 0x08032000);
+    /* W1C clears CKRDY; a CPUDIV write sets it again */
+    qtest_writeb(qts, MCLK + 0x03, 0x01);
+    g_assert_cmphex(qtest_readb(qts, MCLK + 0x03), ==, 0x00);
+    qtest_writeb(qts, MCLK + 0x04, 0x01);
+    g_assert_cmphex(qtest_readb(qts, MCLK + 0x03), ==, 0x01);
+    /* INTENSET/INTENCLR share one storage */
+    qtest_writeb(qts, MCLK + 0x02, 0x01);
+    g_assert_cmphex(qtest_readb(qts, MCLK + 0x01), ==, 0x01);
+    qtest_writeb(qts, MCLK + 0x01, 0x01);
+    g_assert_cmphex(qtest_readb(qts, MCLK + 0x02), ==, 0x00);
+    /* Enable protection: BODVDD.LEVEL only changes while disabled */
+    qtest_writel(qts, SUPC + 0x10, 0x0010000A);
+    g_assert_cmphex(qtest_readl(qts, SUPC + 0x10), ==, 0x0008000A);
+    qtest_writel(qts, SUPC + 0x10, 0x00080008);
+    qtest_writel(qts, SUPC + 0x10, 0x00100008);
+    g_assert_cmphex(qtest_readl(qts, SUPC + 0x10), ==, 0x00100008);
+    g_assert_cmphex(qtest_readl(qts, SUPC + 0x0C), ==, 0x4);
+    /* NVMCTRL: no CMDEX key is a PROGE error; READY stays set */
+    qtest_writew(qts, NVMCTRL + 0x00, 0x0044);
+    g_assert_cmphex(qtest_readw(qts, NVMCTRL + 0x18) & 0x4, ==, 0x4);
+    g_assert_cmphex(qtest_readl(qts, NVMCTRL + 0x14), ==, 0x3);
+    qtest_writel(qts, NVMCTRL + 0x14, 0xFFFFFFFF);
+    g_assert_cmphex(qtest_readl(qts, NVMCTRL + 0x14), ==, 0x1);
+    qtest_writew(qts, NVMCTRL + 0x00, 0xA544);       /* page buffer clear */
+    g_assert_cmphex(qtest_readl(qts, NVMCTRL + 0x14), ==, 0x1);
+    qtest_quit(qts);
+}
+
+static void test_views_and_swrst(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* COUNT16 has no PER register at 0x1B; COUNT8 has */
+    qtest_writeb(qts, TC0 + 0x1B, 0x5A);
+    g_assert_cmphex(qtest_readb(qts, TC0 + 0x1B), ==, 0);
+    qtest_writel(qts, TC0 + 0x00, 1 << 2);           /* CTRLA.MODE COUNT8 */
+    qtest_writeb(qts, TC0 + 0x1B, 0x5A);
+    g_assert_cmphex(qtest_readb(qts, TC0 + 0x1B), ==, 0x5A);
+    /* SWRST resets the registers and the view */
+    qtest_writel(qts, TC0 + 0x00, 0x1);
+    g_assert_cmphex(qtest_readl(qts, TC0 + 0x00), ==, 0);
+    g_assert_cmphex(qtest_readb(qts, TC0 + 0x1B), ==, 0);
+
+    /* GCLK.SWRST restores GENCTRL0 */
+    qtest_writel(qts, GCLK + 0x20, 0x00010103);
+    qtest_writeb(qts, GCLK + 0x00, 0x01);
+    g_assert_cmphex(qtest_readl(qts, GCLK + 0x20), ==, 0x00000106);
+    g_assert_cmphex(qtest_readb(qts, GCLK + 0x00), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_clock_tree(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/armv7m/cpuclk"), ==, 4000000);
+
+    /* Harmony: OSC48MDIV = 0 */
+    qtest_writeb(qts, OSCCTRL + 0x15, 0x00);
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/armv7m/cpuclk"), ==,
+                     48000000);
+    qtest_writeb(qts, MCLK + 0x04, 0x02);            /* CPUDIV 2 */
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/mclk/cpu"), ==, 24000000);
+    qtest_writeb(qts, MCLK + 0x04, 0x03);            /* reserved: ignored */
+    g_assert_cmphex(qtest_readb(qts, MCLK + 0x04), ==, 0x02);
+
+    /* FDPLL96M: 32 MHz XOSC / 32 * 96 / 2 = 48 MHz */
+    qtest_writew(qts, OSCCTRL + 0x10, 0x0006);
+    qtest_writel(qts, OSCCTRL + 0x24, 0x000F0010);   /* REFCLK XOSC, DIV 15 */
+    qtest_writel(qts, OSCCTRL + 0x20, 95);           /* LDR */
+    qtest_writeb(qts, OSCCTRL + 0x28, 0x01);         /* PRESC /2 */
+    g_assert_cmphex(qtest_readb(qts, OSCCTRL + 0x30), ==, 0);
+    qtest_writeb(qts, OSCCTRL + 0x1C, 0x02);         /* ENABLE */
+    g_assert_cmphex(qtest_readb(qts, OSCCTRL + 0x30), ==, 0x3);
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/oscctrl/fdpll96m"), ==,
+                     48000000);
+
+    /* GCLK1 from FDPLL96M, GCLK2 = GCLK1 / 4 to SERCOM4's channel 22 */
+    qtest_writel(qts, GCLK + 0x24, 0x00000107);
+    qtest_writel(qts, GCLK + 0x28, 0x00040102);
+    qtest_writel(qts, GCLK + 0x80 + 22 * 4, 0x42);
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/gclk/gen[1]"), ==, 48000000);
+    g_assert_cmpuint(clock_hz(qts, "/machine/soc/sercom4/gclk"), ==,
+                     12000000);
+    g_assert_cmphex(qtest_readl(qts, GCLK + 0x80 + 22 * 4), ==, 0x42);
+    /* Channel write lock */
+    qtest_writel(qts, GCLK + 0x80 + 22 * 4, 0xC2);
+    qtest_writel(qts, GCLK + 0x80 + 22 * 4, 0x00);
+    g_assert_cmphex(qtest_readl(qts, GCLK + 0x80 + 22 * 4), ==, 0xC2);
+    qtest_quit(qts);
+}
+
+/* MCLK shares NVIC line 0 (SYSTEM) through an OR gate */
+static void test_shared_irq(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, NVIC_ISER, 1 << 0);
+    g_assert_cmphex(qtest_readl(qts, NVIC_ISPR) & 1, ==, 0);
+    qtest_writeb(qts, MCLK + 0x02, 0x01);            /* INTENSET.CKRDY */
+    g_assert_cmphex(qtest_readl(qts, NVIC_ISPR) & 1, ==, 1);
+    qtest_writeb(qts, MCLK + 0x03, 0x01);            /* W1C */
+    qtest_writel(qts, NVIC_ICPR, 1 << 0);
+    g_assert_cmphex(qtest_readl(qts, NVIC_ISPR) & 1, ==, 0);
+    qtest_writeb(qts, MCLK + 0x04, 0x01);            /* CKRDY again */
+    g_assert_cmphex(qtest_readl(qts, NVIC_ISPR) & 1, ==, 1);
+    qtest_quit(qts);
+}
+
+static void test_pac(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, PAC + 0x00, 0x00020009);       /* SET RTC (PERID 9) */
+    g_assert_cmphex(qtest_readl(qts, PAC + 0x34), ==, 1 << 9);
+    g_assert_cmphex(qtest_readl(qts, PAC + 0x14), ==, 0);
+    qtest_writel(qts, PAC + 0x00, 0x00020009);       /* double set */
+    g_assert_cmphex(qtest_readl(qts, PAC + 0x14), ==, 1);
+    qtest_writel(qts, PAC + 0x14, 1);
+    qtest_writel(qts, PAC + 0x00, 0x00010009);       /* CLR */
+    g_assert_cmphex(qtest_readl(qts, PAC + 0x34), ==, 0);
+    qtest_writel(qts, PAC + 0x00, 0x00030009);       /* SETLCK */
+    qtest_writel(qts, PAC + 0x00, 0x00010009);       /* CLR of a lock */
+    g_assert_cmphex(qtest_readl(qts, PAC + 0x34), ==, 1 << 9);
+    g_assert_cmphex(qtest_readl(qts, PAC + 0x14), ==, 1);
+    qtest_quit(qts);
+}
+
+static void test_divas(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writeb(qts, DIVAS + 0x00, 0x01);           /* SIGNED */
+    qtest_writel(qts, DIVAS + 0x08, (uint32_t)-100);
+    qtest_writel(qts, DIVAS + 0x0C, 7);
+    g_assert_cmpint((int32_t)qtest_readl(qts, DIVAS + 0x10), ==, -14);
+    g_assert_cmpint((int32_t)qtest_readl(qts, DIVAS + 0x14), ==, -2);
+    /* Divide by zero: RESULT 0, REM = DIVIDEND, DBZ (W1C) */
+    qtest_writel(qts, DIVAS + 0x0C, 0);
+    g_assert_cmphex(qtest_readl(qts, DIVAS + 0x10), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, DIVAS + 0x14), ==, (uint32_t)-100);
+    g_assert_cmphex(qtest_readb(qts, DIVAS + 0x04), ==, 0x02);
+    qtest_writeb(qts, DIVAS + 0x04, 0x02);
+    g_assert_cmphex(qtest_readb(qts, DIVAS + 0x04), ==, 0);
+    /* Square root through the IOBUS view */
+    qtest_writel(qts, DIVAS_IOBUS + 0x18, 1000001);
+    g_assert_cmpuint(qtest_readl(qts, DIVAS_IOBUS + 0x10), ==, 1000);
+    g_assert_cmpuint(qtest_readl(qts, DIVAS_IOBUS + 0x14), ==, 1);
+    qtest_quit(qts);
+}
+
+static void test_soc_properties(void)
+{
+    QTestState *qts = qtest_init(MACHINE
+        "-global pic32cm5164jh01100-soc.silicon-rev=C0 "
+        "-global pic32cm5164jh01100-soc.serial-number="
+        "00112233445566778899AABBCCDDEEFF");
+
+    g_assert_cmphex(qtest_readl(qts, DSU + 0x18), ==, 0x11060200);
+    g_assert_cmphex(qtest_readl(qts, SERIAL_WORD0), ==, 0x00112233);
+    g_assert_cmphex(qtest_readl(qts, SERIAL_WORD1), ==, 0x44556677);
+    g_assert_cmphex(qtest_readl(qts, SERIAL_WORD1 + 4), ==, 0x8899AABB);
+    g_assert_cmphex(qtest_readl(qts, SERIAL_WORD1 + 8), ==, 0xCCDDEEFF);
+    qtest_quit(qts);
+
+    qts = qtest_init(MACHINE);
+    g_assert_cmphex(qtest_readl(qts, SERIAL_WORD0), ==, 0x50500000);
+    g_assert_cmphex(qtest_readl(qts, SERIAL_WORD1 + 8), ==, 0x00000003);
+    qtest_quit(qts);
+}
