diff --git a/hw/misc/mchp_clock.c b/hw/misc/mchp_clock.c
new file mode 100644
index 0000000..3cbd4bc
--- /dev/null
+++ b/hw/misc/mchp_clock.c
@@ -0,0 +1,732 @@
+/*
+ * Microchip SAM/PIC32CM clock system: OSCCTRL, OSC32KCTRL, GCLK and MCLK
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The four controllers form a QEMU Clock tree:
+ *
+ *   crystals -> OSCCTRL    (XOSC, OSC48M, FDPLL96M) --+
+ *               OSC32KCTRL (XOSC32K, OSC32K, ULP32K) -+-> GCLK generators
+ *   GCLK generators -> GCLK peripheral channels (PCHCTRLm) -> peripherals
+ *   GCLK generator 0 -> MCLK (/ CPUDIV) -> armv7m cpuclk
+ *
+ * An oscillator is ready as soon as it is enabled (and its crystal, if it
+ * needs one, is fitted), FDPLL96M locks as soon as it has a reference, and
+ * every synchronization completes instantly (SYNCBUSY reads 0).
+ * References: DS60001632H chapters 14 (GCLK), 15 (MCLK), 16 (OSC32KCTRL)
+ * and 17 (OSCCTRL).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/host-utils.h"
+#include "qemu/log.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/mchp/gen/gclk_u2122.h"
+#include "hw/mchp/gen/mclk_u2234.h"
+#include "hw/mchp/gen/osc32kctrl_u2246.h"
+#include "hw/mchp/gen/oscctrl_u2119.h"
+#include "hw/misc/mchp_sysctrl.h"
+#include "migration/vmstate.h"
+
+#define MCHP_OSC48M_HZ      48000000
+#define MCHP_OSC32K_HZ      32768
+
+/*
+ * The clock graph can loop (FDPLL96M referenced from a GCLK channel whose
+ * generator runs from FDPLL96M), so updating an output can re-enter the
+ * device that made it. Re-entry only marks the device dirty and the outer
+ * update repeats until the outputs settle.
+ */
+#define MCHP_CLK_MAX_PASSES 8
+
+typedef struct MchpClkSettle {
+    bool busy;
+    bool dirty;
+} MchpClkSettle;
+
+static void mchp_clk_settle(MchpRegBlock *s, MchpClkSettle *st,
+                            void (*compute)(MchpRegBlock *s))
+{
+    if (st->busy) {
+        st->dirty = true;
+        return;
+    }
+    st->busy = true;
+    for (int pass = 0; pass < MCHP_CLK_MAX_PASSES; pass++) {
+        st->dirty = false;
+        compute(s);
+        if (!st->dirty) {
+            break;
+        }
+    }
+    if (st->dirty) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: clock configuration loops and does not settle\n",
+                      s->name);
+    }
+    st->busy = false;
+}
+
+static uint32_t mchp_clk_reg(MchpRegBlock *s, hwaddr offset, unsigned size)
+{
+    return mchp_regfile_peek(&s->rf, offset, size);
+}
+
+/* Set INTFLAG bits (ready flags) of @s. */
+static void mchp_clk_raise_flags(MchpRegBlock *s, uint32_t flags)
+{
+    if (flags && s->intflag) {
+        mchp_regfile_set(&s->rf, s->intflag, 0,
+                         mchp_regfile_get(&s->rf, s->intflag, 0) | flags);
+    }
+}
+
+/* A register with a WRTLOCK bit ignores writes once it is locked. */
+static bool mchp_clk_write_locked(MchpRegBlock *s, const MchpRegInfo *ri,
+                                  unsigned idx, uint32_t old, uint32_t lock)
+{
+    if (!(old & lock)) {
+        return false;
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "%s.%s: write while WRTLOCK is set"
+                  " (ignored)\n", s->name, ri->name);
+    mchp_regfile_set(&s->rf, ri, idx, old);
+    return true;
+}
+
+/* OSCCTRL */
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpOscctrlState, MCHP_OSCCTRL)
+
+struct MchpOscctrlState {
+    MchpRegBlock parent_obj;
+
+    Clock *xtal;
+    Clock *ref_xosc32k;
+    Clock *ref_gclk;
+    Clock *xosc;
+    Clock *osc48m;
+    Clock *fdpll96m;
+
+    uint32_t status;            /* STATUS when last updated, for flag edges */
+    MchpClkSettle settle;
+};
+
+#define MCHP_OSCCTRL_READY \
+    (R_MCHP_OSCCTRL_STATUS_XOSCRDY_MASK | \
+     R_MCHP_OSCCTRL_STATUS_OSC48MRDY_MASK | \
+     R_MCHP_OSCCTRL_STATUS_DPLLLCKR_MASK)
+
+static uint64_t mchp_oscctrl_xosc_hz(MchpOscctrlState *s)
+{
+    uint32_t ctrl = mchp_clk_reg(MCHP_REGBLOCK(s), A_MCHP_OSCCTRL_XOSCCTRL, 2);
+
+    return FIELD_EX32(ctrl, MCHP_OSCCTRL_XOSCCTRL, ENABLE) ?
+           clock_get_hz(s->xtal) : 0;
+}
+
+static uint64_t mchp_oscctrl_osc48m_hz(MchpOscctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ctrl = mchp_clk_reg(rb, A_MCHP_OSCCTRL_OSC48MCTRL, 1);
+    uint32_t div = mchp_clk_reg(rb, A_MCHP_OSCCTRL_OSC48MDIV, 1);
+
+    if (!FIELD_EX32(ctrl, MCHP_OSCCTRL_OSC48MCTRL, ENABLE)) {
+        return 0;
+    }
+    return MCHP_OSC48M_HZ / (FIELD_EX32(div, MCHP_OSCCTRL_OSC48MDIV, DIV) + 1);
+}
+
+static uint64_t mchp_oscctrl_dpll_ref_hz(MchpOscctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ctrlb = mchp_clk_reg(rb, A_MCHP_OSCCTRL_DPLLCTRLB, 4);
+    uint32_t div = FIELD_EX32(ctrlb, MCHP_OSCCTRL_DPLLCTRLB, DIV);
+
+    switch (FIELD_EX32(ctrlb, MCHP_OSCCTRL_DPLLCTRLB, REFCLK)) {
+    case MCHP_OSCCTRL_DPLLCTRLB_REFCLK_XOSC32K:
+        return clock_get_hz(s->ref_xosc32k);
+    case MCHP_OSCCTRL_DPLLCTRLB_REFCLK_XOSC:
+        return mchp_oscctrl_xosc_hz(s) / (2 * (div + 1));
+    case MCHP_OSCCTRL_DPLLCTRLB_REFCLK_GCLK:
+        return clock_get_hz(s->ref_gclk);
+    default:
+        return 0;
+    }
+}
+
+static bool mchp_oscctrl_dpll_locked(MchpOscctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ctrla = mchp_clk_reg(rb, A_MCHP_OSCCTRL_DPLLCTRLA, 1);
+
+    return FIELD_EX32(ctrla, MCHP_OSCCTRL_DPLLCTRLA, ENABLE) &&
+           mchp_oscctrl_dpll_ref_hz(s);
+}
+
+/* fCK = fCKR * (LDR + 1 + LDRFRAC / 16) / 2^PRESC (DS 17.6.5) */
+static uint64_t mchp_oscctrl_fdpll_hz(MchpOscctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ratio = mchp_clk_reg(rb, A_MCHP_OSCCTRL_DPLLRATIO, 4);
+    uint32_t presc = mchp_clk_reg(rb, A_MCHP_OSCCTRL_DPLLPRESC, 1);
+    uint64_t mul16;
+
+    if (!mchp_oscctrl_dpll_locked(s)) {
+        return 0;
+    }
+    mul16 = 16 * (FIELD_EX32(ratio, MCHP_OSCCTRL_DPLLRATIO, LDR) + 1) +
+            FIELD_EX32(ratio, MCHP_OSCCTRL_DPLLRATIO, LDRFRAC);
+    return (mchp_oscctrl_dpll_ref_hz(s) * mul16 / 16) >>
+           FIELD_EX32(presc, MCHP_OSCCTRL_DPLLPRESC, PRESC);
+}
+
+static uint32_t mchp_oscctrl_status(MchpOscctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ctrl = mchp_clk_reg(rb, A_MCHP_OSCCTRL_OSC48MCTRL, 1);
+    uint32_t status = 0;
+
+    if (mchp_oscctrl_xosc_hz(s)) {
+        status |= R_MCHP_OSCCTRL_STATUS_XOSCRDY_MASK;
+    }
+    if (FIELD_EX32(ctrl, MCHP_OSCCTRL_OSC48MCTRL, ENABLE)) {
+        status |= R_MCHP_OSCCTRL_STATUS_OSC48MRDY_MASK;
+    }
+    if (mchp_oscctrl_dpll_locked(s)) {
+        status |= R_MCHP_OSCCTRL_STATUS_DPLLLCKR_MASK;
+    }
+    return status;
+}
+
+static void mchp_oscctrl_compute(MchpRegBlock *rb)
+{
+    MchpOscctrlState *s = MCHP_OSCCTRL(rb);
+    uint32_t status = mchp_oscctrl_status(s);
+    uint32_t flags = status & ~s->status & MCHP_OSCCTRL_READY;
+
+    if (s->status & ~status & R_MCHP_OSCCTRL_STATUS_DPLLLCKR_MASK) {
+        flags |= R_MCHP_OSCCTRL_INTFLAG_DPLLLCKF_MASK;
+    }
+    mchp_clk_raise_flags(rb, flags);
+    s->status = status;
+
+    mchp_regblock_set_clock(rb, s->xosc, mchp_oscctrl_xosc_hz(s));
+    mchp_regblock_set_clock(rb, s->osc48m, mchp_oscctrl_osc48m_hz(s));
+    mchp_regblock_set_clock(rb, s->fdpll96m, mchp_oscctrl_fdpll_hz(s));
+}
+
+static void mchp_oscctrl_update(MchpOscctrlState *s)
+{
+    mchp_clk_settle(MCHP_REGBLOCK(s), &s->settle, mchp_oscctrl_compute);
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void mchp_oscctrl_clk_update(void *opaque, ClockEvent event)
+{
+    mchp_oscctrl_update(MCHP_OSCCTRL(opaque));
+}
+
+static uint32_t mchp_oscctrl_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                      unsigned idx, uint32_t stored,
+                                      bool side_effects)
+{
+    MchpOscctrlState *s = MCHP_OSCCTRL(rf->opaque);
+
+    switch (ri->offset) {
+    case A_MCHP_OSCCTRL_STATUS:
+        return mchp_oscctrl_status(s);
+    case A_MCHP_OSCCTRL_DPLLSTATUS:
+        return mchp_oscctrl_dpll_locked(s) ?
+               R_MCHP_OSCCTRL_DPLLSTATUS_LOCK_MASK |
+               R_MCHP_OSCCTRL_DPLLSTATUS_CLKRDY_MASK : 0;
+    default:
+        return stored;          /* *SYNCBUSY: synchronization is instant */
+    }
+}
+
+static void mchp_oscctrl_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                    unsigned idx, uint32_t old,
+                                    uint32_t written, uint32_t we)
+{
+    mchp_oscctrl_update(MCHP_OSCCTRL(rf->opaque));
+}
+
+static void mchp_oscctrl_reset_hold(MchpRegBlock *rb)
+{
+    MchpOscctrlState *s = MCHP_OSCCTRL(rb);
+
+    s->status = mchp_oscctrl_status(s);
+}
+
+static void mchp_oscctrl_reset_exit(MchpRegBlock *rb)
+{
+    mchp_oscctrl_update(MCHP_OSCCTRL(rb));
+}
+
+static void mchp_oscctrl_init(Object *obj)
+{
+    MchpOscctrlState *s = MCHP_OSCCTRL(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    s->xtal = qdev_init_clock_in(dev, "xtal", mchp_oscctrl_clk_update, s,
+                                 ClockUpdate);
+    s->ref_xosc32k = qdev_init_clock_in(dev, "dpll-ref-xosc32k",
+                                        mchp_oscctrl_clk_update, s,
+                                        ClockUpdate);
+    s->ref_gclk = qdev_init_clock_in(dev, "dpll-ref-gclk",
+                                     mchp_oscctrl_clk_update, s, ClockUpdate);
+    s->xosc = qdev_init_clock_out(dev, "xosc");
+    s->osc48m = qdev_init_clock_out(dev, "osc48m");
+    s->fdpll96m = qdev_init_clock_out(dev, "fdpll96m");
+}
+
+static const VMStateDescription vmstate_mchp_oscctrl = {
+    .name = TYPE_MCHP_OSCCTRL,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpOscctrlState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_CLOCK(xtal, MchpOscctrlState),
+        VMSTATE_CLOCK(ref_xosc32k, MchpOscctrlState),
+        VMSTATE_CLOCK(ref_gclk, MchpOscctrlState),
+        VMSTATE_UINT32(status, MchpOscctrlState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_oscctrl_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_oscctrl;
+    c->pre_read = mchp_oscctrl_pre_read;
+    c->post_write = mchp_oscctrl_post_write;
+    c->reset_hold = mchp_oscctrl_reset_hold;
+    c->reset_exit = mchp_oscctrl_reset_exit;
+    c->log_writes = false;
+}
+
+/* OSC32KCTRL */
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpOsc32kctrlState, MCHP_OSC32KCTRL)
+
+struct MchpOsc32kctrlState {
+    MchpRegBlock parent_obj;
+
+    Clock *xtal32k;
+    Clock *xosc32k;
+    Clock *osc32k;
+    Clock *osculp32k;
+
+    uint32_t status;            /* STATUS when last updated, for flag edges */
+};
+
+#define MCHP_OSC32KCTRL_READY \
+    (R_MCHP_OSC32KCTRL_STATUS_XOSC32KRDY_MASK | \
+     R_MCHP_OSC32KCTRL_STATUS_OSC32KRDY_MASK)
+
+static uint32_t mchp_osc32kctrl_status(MchpOsc32kctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t xosc32k = mchp_clk_reg(rb, A_MCHP_OSC32KCTRL_XOSC32K, 2);
+    uint32_t osc32k = mchp_clk_reg(rb, A_MCHP_OSC32KCTRL_OSC32K, 4);
+    uint32_t status = 0;
+
+    if (FIELD_EX32(xosc32k, MCHP_OSC32KCTRL_XOSC32K, ENABLE) &&
+        clock_get_hz(s->xtal32k)) {
+        status |= R_MCHP_OSC32KCTRL_STATUS_XOSC32KRDY_MASK;
+    }
+    if (FIELD_EX32(osc32k, MCHP_OSC32KCTRL_OSC32K, ENABLE)) {
+        status |= R_MCHP_OSC32KCTRL_STATUS_OSC32KRDY_MASK;
+    }
+    return status;
+}
+
+/* The 32.768 kHz outputs also need EN32K (DS 16.6.2, 16.6.4). */
+static void mchp_osc32kctrl_update(MchpOsc32kctrlState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t xosc32k = mchp_clk_reg(rb, A_MCHP_OSC32KCTRL_XOSC32K, 2);
+    uint32_t osc32k = mchp_clk_reg(rb, A_MCHP_OSC32KCTRL_OSC32K, 4);
+    uint32_t status = mchp_osc32kctrl_status(s);
+
+    mchp_clk_raise_flags(rb, status & ~s->status & MCHP_OSC32KCTRL_READY);
+    s->status = status;
+
+    mchp_regblock_set_clock(rb, s->xosc32k,
+        (status & R_MCHP_OSC32KCTRL_STATUS_XOSC32KRDY_MASK) &&
+        FIELD_EX32(xosc32k, MCHP_OSC32KCTRL_XOSC32K, EN32K) ?
+        clock_get_hz(s->xtal32k) : 0);
+    mchp_regblock_set_clock(rb, s->osc32k,
+        (status & R_MCHP_OSC32KCTRL_STATUS_OSC32KRDY_MASK) &&
+        FIELD_EX32(osc32k, MCHP_OSC32KCTRL_OSC32K, EN32K) ?
+        MCHP_OSC32K_HZ : 0);
+    mchp_regblock_set_clock(rb, s->osculp32k, MCHP_OSC32K_HZ);
+    mchp_regblock_update_irq(rb);
+}
+
+static void mchp_osc32kctrl_clk_update(void *opaque, ClockEvent event)
+{
+    mchp_osc32kctrl_update(MCHP_OSC32KCTRL(opaque));
+}
+
+static uint32_t mchp_osc32kctrl_pre_read(MchpRegFile *rf,
+                                         const MchpRegInfo *ri, unsigned idx,
+                                         uint32_t stored, bool side_effects)
+{
+    if (ri->offset == A_MCHP_OSC32KCTRL_STATUS) {
+        return mchp_osc32kctrl_status(MCHP_OSC32KCTRL(rf->opaque));
+    }
+    return stored;
+}
+
+static void mchp_osc32kctrl_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                       unsigned idx, uint32_t old,
+                                       uint32_t written, uint32_t we)
+{
+    MchpOsc32kctrlState *s = MCHP_OSC32KCTRL(rf->opaque);
+
+    switch (ri->offset) {
+    case A_MCHP_OSC32KCTRL_XOSC32K:
+        mchp_clk_write_locked(MCHP_REGBLOCK(s), ri, idx, old,
+                              R_MCHP_OSC32KCTRL_XOSC32K_WRTLOCK_MASK);
+        break;
+    case A_MCHP_OSC32KCTRL_OSC32K:
+        mchp_clk_write_locked(MCHP_REGBLOCK(s), ri, idx, old,
+                              R_MCHP_OSC32KCTRL_OSC32K_WRTLOCK_MASK);
+        break;
+    }
+    mchp_osc32kctrl_update(s);
+}
+
+static void mchp_osc32kctrl_reset_hold(MchpRegBlock *rb)
+{
+    MchpOsc32kctrlState *s = MCHP_OSC32KCTRL(rb);
+
+    s->status = mchp_osc32kctrl_status(s);
+}
+
+static void mchp_osc32kctrl_reset_exit(MchpRegBlock *rb)
+{
+    mchp_osc32kctrl_update(MCHP_OSC32KCTRL(rb));
+}
+
+static void mchp_osc32kctrl_init(Object *obj)
+{
+    MchpOsc32kctrlState *s = MCHP_OSC32KCTRL(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    s->xtal32k = qdev_init_clock_in(dev, "xtal32k", mchp_osc32kctrl_clk_update,
+                                    s, ClockUpdate);
+    s->xosc32k = qdev_init_clock_out(dev, "xosc32k");
+    s->osc32k = qdev_init_clock_out(dev, "osc32k");
+    s->osculp32k = qdev_init_clock_out(dev, "osculp32k");
+}
+
+static const VMStateDescription vmstate_mchp_osc32kctrl = {
+    .name = TYPE_MCHP_OSC32KCTRL,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpOsc32kctrlState, 1,
+                       vmstate_mchp_regblock, MchpRegBlock),
+        VMSTATE_CLOCK(xtal32k, MchpOsc32kctrlState),
+        VMSTATE_UINT32(status, MchpOsc32kctrlState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_osc32kctrl_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_osc32kctrl;
+    c->pre_read = mchp_osc32kctrl_pre_read;
+    c->post_write = mchp_osc32kctrl_post_write;
+    c->reset_hold = mchp_osc32kctrl_reset_hold;
+    c->reset_exit = mchp_osc32kctrl_reset_exit;
+    c->log_writes = false;
+}
+
+/* GCLK */
+
+/* Clock inputs by GENCTRL.SRC value; GCLKGEN1 is generator 1 itself. */
+static const char *const mchp_gclk_src_names[] = {
+    [MCHP_GCLK_GENCTRL_SRC_XOSC] = "xosc",
+    [MCHP_GCLK_GENCTRL_SRC_GCLKIN] = "gclk-in",
+    [MCHP_GCLK_GENCTRL_SRC_OSCULP32K] = "osculp32k",
+    [MCHP_GCLK_GENCTRL_SRC_OSC32K] = "osc32k",
+    [MCHP_GCLK_GENCTRL_SRC_XOSC32K] = "xosc32k",
+    [MCHP_GCLK_GENCTRL_SRC_OSC48M] = "osc48m",
+    [MCHP_GCLK_GENCTRL_SRC_FDPLL96M] = "fdpll96m",
+};
+
+/* Only generator 1 has 16 DIV bits, the others have 8 (DS Table 14-3). */
+#define MCHP_GCLK_GEN1          1
+#define MCHP_GCLK_DIV8_MASK     0x00FF0000
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpGclkState, MCHP_GCLK)
+
+struct MchpGclkState {
+    MchpRegBlock parent_obj;
+
+    Clock *src[ARRAY_SIZE(mchp_gclk_src_names)];
+    Clock *gen[MCHP_GCLK_GENCTRL_COUNT];
+    Clock *pch[MCHP_GCLK_PCHCTRL_COUNT];
+
+    MchpClkSettle settle;
+};
+
+static uint64_t mchp_gclk_src_hz(MchpGclkState *s, unsigned src)
+{
+    if (src >= ARRAY_SIZE(s->src) || !s->src[src]) {
+        return 0;
+    }
+    return clock_get_hz(s->src[src]);
+}
+
+static uint64_t mchp_gclk_gen_hz(MchpGclkState *s, unsigned n,
+                                 uint64_t gen1_hz)
+{
+    uint32_t ctrl = mchp_clk_reg(MCHP_REGBLOCK(s),
+                                 A_MCHP_GCLK_GENCTRL + 4 * n, 4);
+    uint32_t src = FIELD_EX32(ctrl, MCHP_GCLK_GENCTRL, SRC);
+    uint32_t div = FIELD_EX32(ctrl, MCHP_GCLK_GENCTRL, DIV);
+    uint64_t hz;
+
+    if (!FIELD_EX32(ctrl, MCHP_GCLK_GENCTRL, GENEN)) {
+        return 0;
+    }
+    if (src == MCHP_GCLK_GENCTRL_SRC_GCLKGEN1) {
+        hz = n == MCHP_GCLK_GEN1 ? 0 : gen1_hz;
+    } else {
+        hz = mchp_gclk_src_hz(s, src);
+    }
+    if (FIELD_EX32(ctrl, MCHP_GCLK_GENCTRL, DIVSEL)) {
+        return div + 1 < 64 ? hz >> (div + 1) : 0;
+    }
+    return div > 1 ? hz / div : hz;
+}
+
+static void mchp_gclk_compute(MchpRegBlock *rb)
+{
+    MchpGclkState *s = MCHP_GCLK(rb);
+    uint64_t hz[MCHP_GCLK_GENCTRL_COUNT];
+
+    hz[MCHP_GCLK_GEN1] = mchp_gclk_gen_hz(s, MCHP_GCLK_GEN1, 0);
+    for (unsigned n = 0; n < MCHP_GCLK_GENCTRL_COUNT; n++) {
+        if (n != MCHP_GCLK_GEN1) {
+            hz[n] = mchp_gclk_gen_hz(s, n, hz[MCHP_GCLK_GEN1]);
+        }
+    }
+    for (unsigned n = 0; n < MCHP_GCLK_GENCTRL_COUNT; n++) {
+        mchp_regblock_set_clock(rb, s->gen[n], hz[n]);
+    }
+    for (unsigned m = 0; m < MCHP_GCLK_PCHCTRL_COUNT; m++) {
+        uint32_t ctrl = mchp_clk_reg(rb, A_MCHP_GCLK_PCHCTRL + 4 * m, 4);
+        uint32_t gen = FIELD_EX32(ctrl, MCHP_GCLK_PCHCTRL, GEN);
+        bool on = FIELD_EX32(ctrl, MCHP_GCLK_PCHCTRL, CHEN) &&
+                  gen < MCHP_GCLK_GENCTRL_COUNT;
+
+        mchp_regblock_set_clock(rb, s->pch[m], on ? hz[gen] : 0);
+    }
+}
+
+static void mchp_gclk_update(MchpGclkState *s)
+{
+    mchp_clk_settle(MCHP_REGBLOCK(s), &s->settle, mchp_gclk_compute);
+}
+
+static void mchp_gclk_clk_update(void *opaque, ClockEvent event)
+{
+    mchp_gclk_update(MCHP_GCLK(opaque));
+}
+
+static void mchp_gclk_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                 unsigned idx, uint32_t old,
+                                 uint32_t written, uint32_t we)
+{
+    MchpGclkState *s = MCHP_GCLK(rf->opaque);
+    uint32_t val = mchp_regfile_get(rf, ri, idx);
+
+    switch (ri->offset) {
+    case A_MCHP_GCLK_GENCTRL:
+        if (idx != MCHP_GCLK_GEN1) {
+            val &= ~R_MCHP_GCLK_GENCTRL_DIV_MASK | MCHP_GCLK_DIV8_MASK;
+            mchp_regfile_set(rf, ri, idx, val);
+        }
+        break;
+    case A_MCHP_GCLK_PCHCTRL:
+        mchp_clk_write_locked(MCHP_REGBLOCK(s), ri, idx, old,
+                              R_MCHP_GCLK_PCHCTRL_WRTLOCK_MASK);
+        break;
+    default:
+        return;                 /* CTRLA.SWRST is handled by mchp-regblock */
+    }
+    mchp_gclk_update(s);
+}
+
+static void mchp_gclk_reset_exit(MchpRegBlock *rb)
+{
+    mchp_gclk_update(MCHP_GCLK(rb));
+}
+
+static void mchp_gclk_init(Object *obj)
+{
+    MchpGclkState *s = MCHP_GCLK(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    for (unsigned i = 0; i < ARRAY_SIZE(s->src); i++) {
+        if (mchp_gclk_src_names[i]) {
+            s->src[i] = qdev_init_clock_in(dev, mchp_gclk_src_names[i],
+                                           mchp_gclk_clk_update, s,
+                                           ClockUpdate);
+        }
+    }
+    for (unsigned n = 0; n < MCHP_GCLK_GENCTRL_COUNT; n++) {
+        g_autofree char *name = g_strdup_printf("gen[%u]", n);
+
+        s->gen[n] = qdev_init_clock_out(dev, name);
+    }
+    for (unsigned m = 0; m < MCHP_GCLK_PCHCTRL_COUNT; m++) {
+        g_autofree char *name = g_strdup_printf("pch[%u]", m);
+
+        s->pch[m] = qdev_init_clock_out(dev, name);
+    }
+}
+
+static const VMStateDescription vmstate_mchp_gclk = {
+    .name = TYPE_MCHP_GCLK,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpGclkState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_gclk_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_gclk;
+    c->post_write = mchp_gclk_post_write;
+    c->reset_exit = mchp_gclk_reset_exit;
+    c->log_writes = false;
+}
+
+/* MCLK */
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpMclkState, MCHP_MCLK)
+
+struct MchpMclkState {
+    MchpRegBlock parent_obj;
+
+    Clock *main;
+    Clock *cpu;
+};
+
+static void mchp_mclk_update(MchpMclkState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t div = mchp_clk_reg(rb, A_MCHP_MCLK_CPUDIV, 1);
+
+    mchp_regblock_set_clock(rb, s->cpu, div ? clock_get_hz(s->main) / div : 0);
+}
+
+static void mchp_mclk_clk_update(void *opaque, ClockEvent event)
+{
+    mchp_mclk_update(MCHP_MCLK(opaque));
+}
+
+/* CPUDIV takes powers of two up to 128 (DS 15.6.4); CKRDY sets again. */
+static void mchp_mclk_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                 unsigned idx, uint32_t old,
+                                 uint32_t written, uint32_t we)
+{
+    MchpMclkState *s = MCHP_MCLK(rf->opaque);
+    uint32_t div = mchp_regfile_get(rf, ri, idx);
+
+    if (ri->offset != A_MCHP_MCLK_CPUDIV) {
+        return;
+    }
+    if (!is_power_of_2(div) || div > MCHP_MCLK_CPUDIV_CPUDIV_DIV128) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.CPUDIV: reserved value 0x%" PRIx32
+                      " (ignored)\n", MCHP_REGBLOCK(s)->name, div);
+        mchp_regfile_set(rf, ri, idx, old);
+    }
+    mchp_clk_raise_flags(MCHP_REGBLOCK(s), R_MCHP_MCLK_INTFLAG_CKRDY_MASK);
+    mchp_mclk_update(s);
+}
+
+static void mchp_mclk_reset_exit(MchpRegBlock *rb)
+{
+    mchp_mclk_update(MCHP_MCLK(rb));
+}
+
+static void mchp_mclk_init(Object *obj)
+{
+    MchpMclkState *s = MCHP_MCLK(obj);
+
+    s->main = qdev_init_clock_in(DEVICE(obj), "gclk-main",
+                                 mchp_mclk_clk_update, s, ClockUpdate);
+    s->cpu = qdev_init_clock_out(DEVICE(obj), "cpu");
+}
+
+static const VMStateDescription vmstate_mchp_mclk = {
+    .name = TYPE_MCHP_MCLK,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpMclkState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_CLOCK(main, MchpMclkState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_mclk_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_mclk;
+    c->post_write = mchp_mclk_post_write;
+    c->reset_exit = mchp_mclk_reset_exit;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_clock_types[] = {
+    {
+        .name = TYPE_MCHP_OSCCTRL,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpOscctrlState),
+        .instance_init = mchp_oscctrl_init,
+        .class_init = mchp_oscctrl_class_init,
+    }, {
+        .name = TYPE_MCHP_OSC32KCTRL,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpOsc32kctrlState),
+        .instance_init = mchp_osc32kctrl_init,
+        .class_init = mchp_osc32kctrl_class_init,
+    }, {
+        .name = TYPE_MCHP_GCLK,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpGclkState),
+        .instance_init = mchp_gclk_init,
+        .class_init = mchp_gclk_class_init,
+    }, {
+        .name = TYPE_MCHP_MCLK,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpMclkState),
+        .instance_init = mchp_mclk_init,
+        .class_init = mchp_mclk_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_clock_types)
diff --git a/hw/misc/mchp_regblock.c b/hw/misc/mchp_regblock.c
new file mode 100644
index 0000000..977a8a4
--- /dev/null
+++ b/hw/misc/mchp_regblock.c
