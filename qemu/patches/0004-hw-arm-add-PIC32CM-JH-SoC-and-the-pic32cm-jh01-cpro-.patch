diff --git a/include/hw/arm/pic32cm_jh_soc.h b/include/hw/arm/pic32cm_jh_soc.h
new file mode 100644
index 0000000..147d291
--- /dev/null
+++ b/include/hw/arm/pic32cm_jh_soc.h
@@ -0,0 +1,66 @@
+/*
+ * Microchip PIC32CM JH01 SoC (PIC32CM5164JH01100)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Built from the generated device description (pic32cm5164jh01100_gen.h):
+ * a Cortex-M0 armv7m, the memories, and one child per ATDF peripheral
+ * instance named after it in lowercase ("sercom4", "gclk", ...).
+ *
+ * Clock inputs "xosc" and "xosc32k": the board's crystals on XIN/XOUT and
+ * XIN32/XOUT32 (leave unconnected when not fitted).
+ * Properties: "silicon-rev" ("B0" default, or "C0"), "serial-number"
+ * (32 hex digits: the words at 0x0080A00C, 0x0080A040, 0x0080A044 and
+ * 0x0080A048, in that order).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_ARM_PIC32CM_JH_SOC_H
+#define HW_ARM_PIC32CM_JH_SOC_H
+
+#include "hw/arm/armv7m.h"
+#include "hw/arm/pic32cm5164jh01100_gen.h"
+#include "hw/core/or-irq.h"
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_PIC32CM5164JH01100_SOC "pic32cm5164jh01100-soc"
+OBJECT_DECLARE_SIMPLE_TYPE(Pic32cmJhSocState, PIC32CM5164JH01100_SOC)
+
+#define PIC32CM_JH_NUM_SERCOM   8
+
+/*
+ * SCB->CPUID of the Cortex-M0+ r0p1 core (ATDF __CM0P_REV 0x0001); the
+ * board applies it to QEMU's cortex-m0 as a "midr" global property.
+ */
+#define PIC32CM_JH_CPUID        0x410CC601
+
+struct Pic32cmJhSocState {
+    SysBusDevice parent_obj;
+
+    ARMv7MState armv7m;
+    /* OR gates of the shared NVIC lines, indexed by line */
+    OrIRQState irq_or[PIC32CM5164JH01100_NUM_IRQ_LINES];
+    /* Peripheral models by instance index; NULL when not a regblock */
+    DeviceState *periph[PIC32CM5164JH01100_NUM_INSTANCES];
+    Chardev *sercom_chr[PIC32CM_JH_NUM_SERCOM];
+
+    MemoryRegion flash;
+    MemoryRegion dataflash;
+    MemoryRegion nvm_rows;
+    MemoryRegion sram;
+
+    char *silicon_rev;
+    char *serial_number;
+};
+
+/*
+ * Attach @chr to SERCOM@sercom; call before realize. The chardev reaches
+ * the SERCOM model through its "chardev" property, if the model has one.
+ */
+void pic32cm_jh_soc_connect_serial(Pic32cmJhSocState *s, unsigned sercom,
+                                   Chardev *chr);
+
+#endif /* HW_ARM_PIC32CM_JH_SOC_H */
diff --git a/include/hw/misc/mchp_regblock.h b/include/hw/misc/mchp_regblock.h
new file mode 100644
index 0000000..5f55252
--- /dev/null
+++ b/include/hw/misc/mchp_regblock.h
@@ -0,0 +1,91 @@
+/*
+ * Microchip generic register block: one peripheral instance as a register file
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A SysBusDevice built from one MchpInstanceInfo of a generated SoC table:
+ * the register file with that instance's tables, reset values (including
+ * fields loaded from NVM fuses at reset), register views switched by the
+ * mode selector (SERCOM CTRLA.MODE, TC/RTC CTRLA.MODE) and one IRQ output.
+ *
+ * Without a dedicated model it gives firmware what the tables describe:
+ * reset values, store and read back, W1C flags, set/clear aliases,
+ * SYNCBUSY reading 0 (DYNAMIC registers return their stored value) and a
+ * software reset when bit 0 (SWRST) of CTRLA/CTRL at offset 0 is written,
+ * and it reports every other write with LOG_UNIMP ("<inst>.<REG>: ... not
+ * modelled"). The IRQ level is (INTFLAG & INTENSET) != 0.
+ *
+ * Dedicated models subclass TYPE_MCHP_REGBLOCK and fill MchpRegBlockClass.
+ *
+ * sysbus MMIO 0: the instance slot; MMIO 1: the second view of the
+ * registers (IOBUS or DSU_EXT) when the instance has one.
+ * sysbus IRQ 0: the interrupt request. Clock input "gclk": the GCLK
+ * peripheral channel of the instance (may stay unconnected).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_REGBLOCK_H
+#define HW_MISC_MCHP_REGBLOCK_H
+
+#include "hw/core/sysbus.h"
+#include "hw/mchp/mchp_device.h"
+#include "hw/misc/mchp_regfile.h"
+#include "qom/object.h"
+
+#define TYPE_MCHP_REGBLOCK "mchp-regblock"
+OBJECT_DECLARE_TYPE(MchpRegBlock, MchpRegBlockClass, MCHP_REGBLOCK)
+
+struct MchpRegBlock {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    MemoryRegion alias;
+    qemu_irq irq;
+    Clock *gclk;
+
+    MchpRegFile rf;
+    const MchpInstanceInfo *info;
+    char *name;                         /* lowercase instance name */
+
+    /* Registers of the active view the generic behaviour relies on */
+    const MchpRegInfo *ctrl;            /* CTRLA/CTRL at offset 0, or NULL */
+    const MchpRegInfo *intflag;
+    const MchpRegInfo *intenset;
+    uint32_t view_sel;                  /* mode selector of the active view */
+};
+
+struct MchpRegBlockClass {
+    SysBusDeviceClass parent_class;
+
+    /* Model-specific realize, after the register file exists */
+    bool (*realize)(MchpRegBlock *s, Error **errp);
+    /* Register hooks of a dedicated model (MchpRegFile semantics) */
+    MchpRegPreReadFn pre_read;
+    MchpRegPostWriteFn post_write;
+    /* Enable protection; NULL: CTRLA/CTRL.ENABLE (bit 1) */
+    MchpRegEnabledFn is_enabled;
+    /* IRQ level; NULL: (INTFLAG & INTENSET) != 0 */
+    bool (*irq_pending)(MchpRegBlock *s);
+    /* Called after the registers are reset (system reset and SWRST) */
+    void (*reset_hold)(MchpRegBlock *s);
+    /* Called after reset_hold, may update outputs such as clocks */
+    void (*reset_exit)(MchpRegBlock *s);
+    /* Report each write with LOG_UNIMP: true for the generic block */
+    bool log_writes;
+};
+
+/* For dedicated models with state of their own (VMSTATE_STRUCT) */
+extern const VMStateDescription vmstate_mchp_regblock;
+
+/* Select the instance to model; call before realize. */
+void mchp_regblock_set_info(MchpRegBlock *s, const MchpInstanceInfo *info);
+
+/* Recompute the IRQ output after a state change made outside an access. */
+void mchp_regblock_update_irq(MchpRegBlock *s);
+
+/* Set output clock @out of @s to @hz; a change is traced and propagated. */
+void mchp_regblock_set_clock(MchpRegBlock *s, Clock *out, uint64_t hz);
+
+#endif /* HW_MISC_MCHP_REGBLOCK_H */
diff --git a/include/hw/misc/mchp_regfile.h b/include/hw/misc/mchp_regfile.h
new file mode 100644
index 0000000..4862f33
--- /dev/null
+++ b/include/hw/misc/mchp_regfile.h
@@ -0,0 +1,128 @@
+/*
+ * Microchip register file: byte-lane dispatcher over generated register tables
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SAM/PIC32CM peripherals mix 8, 16 and 32-bit registers at byte offsets
+ * and firmware accesses them with any width, so an access is split into
+ * the register elements it overlaps. Each element follows the semantics
+ * of its MchpRegInfo row (generated from the ATDF plus behaviour overlays
+ * by generator/atdf2qemu.py); models add behaviour through the pre_read and
+ * post_write hooks.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_REGFILE_H
+#define HW_MISC_MCHP_REGFILE_H
+
+#include "exec/hwaddr.h"
+#include "exec/memattrs.h"
+#include "migration/vmstate.h"
+
+typedef struct MchpRegInfo {
+    const char *name;   /* ATDF register name, e.g. "CTRLA", "PCHCTRL" */
+    uint16_t offset;    /* byte offset of element 0 inside the register group */
+    uint8_t size;       /* 1, 2 or 4 bytes */
+    uint8_t count;      /* array elements (1 for scalars) */
+    uint16_t stride;    /* bytes between array elements (== size unless ATDF says otherwise) */
+    int16_t alias_of;   /* index in the same table of the storage register this one aliases,
+                           or -1; may equal its own index (e.g. INTENSET is the storage) */
+    uint32_t reset;     /* reset value of every element (exceptions: MchpResetOverride) */
+    uint32_t impl;      /* implemented bits; reads return value & impl (0xFFFFFFFF if ATDF has no bitfields) */
+    uint32_t wmask;     /* software-writable bits (RW bits minus ro/w1c) */
+    uint32_t w1c;       /* write-1-to-clear bits */
+    uint32_t rdz;       /* bits that always read 0 (strobes, self-clearing, write-only) */
+    uint32_t enprot;    /* enable-protected bits: writable only while the IP is disabled */
+    uint32_t syncbusy;  /* SYNCBUSY bits raised by writing this register (0 = none) */
+    uint32_t flags;     /* MCHP_F_* */
+} MchpRegInfo;
+
+#define MCHP_F_PAC             (1u << 0)  /* PAC write-protectable */
+#define MCHP_F_ALIAS_SET       (1u << 1)  /* write 1 sets bits of alias_of; read returns alias_of */
+#define MCHP_F_ALIAS_CLEAR     (1u << 2)  /* write 1 clears bits of alias_of; read returns alias_of */
+#define MCHP_F_ALIAS_TOGGLE    (1u << 3)  /* write 1 toggles bits of alias_of; read returns alias_of */
+#define MCHP_F_DYNAMIC         (1u << 4)  /* value produced by the model's pre_read hook */
+#define MCHP_F_HOOK_PRE_READ   (1u << 5)  /* call pre_read (side effects only when !attrs.debug) */
+#define MCHP_F_HOOK_POST_WRITE (1u << 6)  /* call post_write after storage is updated */
+#define MCHP_F_BUSY_BUSERR     (1u << 7)  /* write while own SYNCBUSY bit set = bus error (pedantic mode) */
+#define MCHP_F_WRITE_ONLY      (1u << 8)  /* reads return 0 */
+#define MCHP_F_READ_ONLY       (1u << 9)  /* writes ignored (+LOG_GUEST_ERROR) */
+
+typedef struct MchpResetOverride {
+    uint16_t offset;    /* byte offset of the element */
+    uint8_t size;
+    uint32_t value;
+} MchpResetOverride;
+
+typedef struct MchpRegFile MchpRegFile;
+typedef uint32_t (*MchpRegPreReadFn)(MchpRegFile *rf, const MchpRegInfo *ri,
+                                     unsigned idx, uint32_t stored,
+                                     bool side_effects);
+typedef void (*MchpRegPostWriteFn)(MchpRegFile *rf, const MchpRegInfo *ri,
+                                   unsigned idx, uint32_t old_value,
+                                   uint32_t written, uint32_t we);
+typedef bool (*MchpRegEnabledFn)(MchpRegFile *rf);
+
+struct MchpRegFile {
+    const char *name;                 /* instance name for logs, e.g. "sercom4" */
+    uint8_t *storage;                 /* little-endian backing store */
+    uint32_t size;                    /* bytes of storage (register-group size) */
+    const MchpRegInfo *regs;          /* active table (SERCOM switches it on CTRLA.MODE) */
+    unsigned nregs;
+    const MchpResetOverride *ovr;
+    unsigned novr;
+    void *opaque;                     /* owning device */
+    MchpRegPreReadFn pre_read;        /* may be NULL */
+    MchpRegPostWriteFn post_write;    /* may be NULL */
+    MchpRegEnabledFn is_enabled;      /* NULL = never enabled (no enable protection) */
+};
+
+void mchp_regfile_init(MchpRegFile *rf, const char *name, uint32_t size,
+                       const MchpRegInfo *regs, unsigned nregs);
+void mchp_regfile_set_table(MchpRegFile *rf, const MchpRegInfo *regs, unsigned nregs);
+void mchp_regfile_set_overrides(MchpRegFile *rf, const MchpResetOverride *ovr, unsigned n);
+void mchp_regfile_reset(MchpRegFile *rf);       /* reset values, then overrides */
+uint64_t mchp_regfile_read(MchpRegFile *rf, hwaddr addr, unsigned size, MemTxAttrs attrs);
+void mchp_regfile_write(MchpRegFile *rf, hwaddr addr, uint64_t val, unsigned size, MemTxAttrs attrs);
+uint32_t mchp_regfile_peek(MchpRegFile *rf, uint32_t offset, unsigned size);   /* raw storage */
+void mchp_regfile_poke(MchpRegFile *rf, uint32_t offset, unsigned size, uint32_t val);
+const MchpRegInfo *mchp_regfile_find(MchpRegFile *rf, const char *name);       /* active table */
+/* VMState helper: VMSTATE_VBUFFER_UINT32 or equivalent over storage/size */
+
+/* Additions to the contract above. */
+
+/*
+ * The register element of the active table that covers byte @offset, or
+ * NULL for a reserved byte. *@idx receives the array element index.
+ */
+const MchpRegInfo *mchp_regfile_lookup(MchpRegFile *rf, uint32_t offset,
+                                       unsigned *idx);
+
+/* Byte offset of element @idx of @ri. */
+static inline uint32_t mchp_regfile_elem_offset(const MchpRegInfo *ri,
+                                                unsigned idx)
+{
+    return ri->offset + idx * ri->stride;
+}
+
+/* Raw stored value of element @idx of @ri. */
+static inline uint32_t mchp_regfile_get(MchpRegFile *rf,
+                                        const MchpRegInfo *ri, unsigned idx)
+{
+    return mchp_regfile_peek(rf, mchp_regfile_elem_offset(ri, idx), ri->size);
+}
+
+/* Overwrite the raw stored value of element @idx of @ri. */
+static inline void mchp_regfile_set(MchpRegFile *rf, const MchpRegInfo *ri,
+                                    unsigned idx, uint32_t val)
+{
+    mchp_regfile_poke(rf, mchp_regfile_elem_offset(ri, idx), ri->size, val);
+}
+
+/* Migrates the storage of the MchpRegFile member @_field of @_state. */
+#define VMSTATE_MCHP_REGFILE(_field, _state) \
+    VMSTATE_VBUFFER_UINT32(_field.storage, _state, 0, NULL, _field.size)
+
+#endif /* HW_MISC_MCHP_REGFILE_H */
diff --git a/include/hw/misc/mchp_sysctrl.h b/include/hw/misc/mchp_sysctrl.h
new file mode 100644
index 0000000..ca79688
--- /dev/null
+++ b/include/hw/misc/mchp_sysctrl.h
@@ -0,0 +1,75 @@
+/*
+ * Microchip SAM/PIC32CM system controllers built on mchp-regblock
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Each type is a TYPE_MCHP_REGBLOCK subclass configured with
+ * mchp_regblock_set_info(). Their state is private; SoCs wire them through
+ * the clock, GPIO and property names below.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_SYSCTRL_H
+#define HW_MISC_MCHP_SYSCTRL_H
+
+#include "hw/misc/mchp_regblock.h"
+
+/*
+ * OSCCTRL U2119. Clock inputs: "xtal" (XIN/XOUT crystal or external clock,
+ * unconnected or 0 Hz: none fitted), "dpll-ref-xosc32k" and "dpll-ref-gclk"
+ * (FDPLL96M references). Clock outputs: "xosc", "osc48m", "fdpll96m".
+ */
+#define TYPE_MCHP_OSCCTRL "mchp-oscctrl"
+
+/*
+ * OSC32KCTRL U2246. Clock input "xtal32k" (XIN32/XOUT32). Clock outputs
+ * (32.768 kHz domain): "xosc32k", "osc32k", "osculp32k".
+ */
+#define TYPE_MCHP_OSC32KCTRL "mchp-osc32kctrl"
+
+/*
+ * GCLK U2122. Clock inputs named after the GENCTRL.SRC sources: "xosc",
+ * "gclk-in", "osculp32k", "osc32k", "xosc32k", "osc48m", "fdpll96m".
+ * Clock outputs: generators "gen[n]" and peripheral channels "pch[m]".
+ */
+#define TYPE_MCHP_GCLK "mchp-gclk"
+
+/* MCLK U2234. Clock input "gclk-main" (generator 0); output "cpu". */
+#define TYPE_MCHP_MCLK "mchp-mclk"
+
+/* NVMCTRL 03929: PARAM, READY, CTRLA command keys; no flash programming. */
+#define TYPE_MCHP_NVMCTRL "mchp-nvmctrl"
+
+/* SUPC U2117: BODVDD (reset from the user row) and its ready flags. */
+#define TYPE_MCHP_SUPC "mchp-supc"
+
+/*
+ * RSTC U2239. Named GPIO input array "reset-cause": raising line n records
+ * RCAUSE bit n and requests a system reset; RCAUSE reads that cause after
+ * the reset (POR at the first reset, EXT for resets nobody announced).
+ */
+#define TYPE_MCHP_RSTC "mchp-rstc"
+#define MCHP_RSTC_RESET_CAUSE "reset-cause"
+
+/*
+ * WDT U2251. Named GPIO output "system-reset", pulsed when software writes
+ * a wrong CLEAR key to an enabled watchdog. No timeout in v0.
+ */
+#define TYPE_MCHP_WDT "mchp-wdt"
+#define MCHP_WDT_SYSTEM_RESET "system-reset"
+
+/* PM U2240: SLEEPCFG/STDBYCFG store and read back; WFI is the CPU's. */
+#define TYPE_MCHP_PM "mchp-pm"
+
+/* PAC U2120: WRCTRL/STATUSx bookkeeping and errors, no enforcement. */
+#define TYPE_MCHP_PAC "mchp-pac"
+
+/* DSU U2209. Property "revision": DID.REVISION (1 = B0, 2 = C0). */
+#define TYPE_MCHP_DSU "mchp-dsu"
+
+/* DIVAS U2258: divide and square root, completed instantly. */
+#define TYPE_MCHP_DIVAS "mchp-divas"
+
+#endif /* HW_MISC_MCHP_SYSCTRL_H */
