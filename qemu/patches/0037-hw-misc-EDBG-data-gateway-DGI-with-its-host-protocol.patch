diff --git a/hw/misc/mchp_edbg_dgi.c b/hw/misc/mchp_edbg_dgi.c
index cac8bf4..52d03f5 100644
--- a/hw/misc/mchp_edbg_dgi.c
+++ b/hw/misc/mchp_edbg_dgi.c
@@ -1,25 +1,479 @@
 /*
- * Microchip EDBG data gateway (DGI) as seen on a Curiosity Pro I2C bus
+ * Microchip EDBG/nEDBG data gateway (DGI): the debugger's data channel
  *
  * Peripheral Pretender: a personal project. AI-assisted code;
  * not for submission to upstream QEMU.
  *
- * The board's debugger listens on the target's I2C bus (address 0x28 on
- * the PIC32CM MC00 Curiosity Pro). As the target sees it on silicon, it
- * acknowledges its address and every byte written, reads return 0x00, and
- * it does not answer the general call (address 0). The gateway protocol
- * itself is not modelled.
+ * Host side: the DGI command protocol, read and written on "chardev" as
+ * the debugger exchanges it over its USB DGI endpoints. A command is its
+ * code, a 16-bit big-endian payload length and the payload; a reply
+ * echoes the code, then 0x80 (OK) or 0xA0 (data) and the data. Checked
+ * against an nEDBG (AVR64EA48 Curiosity Nano, firmware with DGI 4.1):
+ * sign on, version, interface list, configuration and status replies.
+ *
+ *   0x00 sign on       A0 len16 name (NUL terminated)
+ *   0x01 sign off      80, every interface stops
+ *   0x02 version       A0 major minor
+ *   0x08 interfaces    A0 count ids...
+ *   0x0A set mode      80 (2- or 4-byte poll lengths, overflow marker)
+ *   0x10 enable        payload interface, state (0 off, 1 on, 2 on with
+ *                      timestamps); 80
+ *   0x11 status        A0 then interface, flags (bit 0 on, 1 timestamps,
+ *                      2 overflow) per interface
+ *   0x12 set config    payload interface, then id16 value32 pairs; 80
+ *   0x13 get config    A0 len16 interface pairs...
+ *   0x14 send data     payload interface, data; 80 (to the target: what
+ *                      the target reads from the DGI over I2C or SPI)
+ *   0x15 poll          A0 interface len16 (len32 in 4-byte mode) data
+ *   0x20 target reset  80
+ *
+ * Target side: the I2C target (a write feeds interface I2C, a read takes
+ * the next byte sent by the host, else 0x00; the general call is not
+ * answered, as on the MC00 Curiosity Pro), the SPI target (MOSI bytes feed
+ * interface SPI while its slave select is low; MISO is the next byte sent
+ * by the host, else 0x00), and the GPIO monitor lines. Bytes and edges
+ * are only taken while the host has their interface on, like the
+ * debugger, whose target pins stay tristated otherwise.
+ *
+ * GPIO and timestamp records: a GPIO poll returns one byte per change,
+ * the levels of all lines (bit n is line n). With timestamps on, each
+ * record is preceded by the time of the change in "tick-hz" ticks since
+ * the interface was enabled, as a 32-bit big-endian count. TODO: compare
+ * these record formats with a debugger's; the command layer above is
+ * checked, these are not yet.
  *
  * SPDX-License-Identifier: GPL-2.0-or-later
  */
 
 #include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qemu/log.h"
+#include "qemu/host-utils.h"
+#include "qemu/bswap.h"
+#include "qapi/error.h"
+#include "chardev/char-fe.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
 #include "hw/i2c/i2c.h"
+#include "hw/ssi/ssi.h"
 #include "hw/misc/mchp_edbg_dgi.h"
 
+#define DGI_RESP_OK 0x80
+#define DGI_RESP_DATA 0xA0
+#define DGI_RESP_FAIL 0x81
+#define DGI_BUF_MAX (64 * 1024)
+#define DGI_CMD_MAX (4 + 512)
+#define DGI_MAX_IF 8
+#define DGI_MAX_CFG 8
+#define DGI_GPIO_LINES MCHP_EDBG_DGI_SS_LINE
+
+typedef struct DgiIface {
+    uint8_t id;
+    uint8_t state;              /* 0 off, 1 on, 2 on with timestamps */
+    bool overflow;
+    int64_t start_ns;           /* virtual time it was switched on */
+    GByteArray *buf;            /* data for the host, oldest first */
+    uint16_t cfg_id[DGI_MAX_CFG];
+    uint32_t cfg_val[DGI_MAX_CFG];
+    unsigned ncfg;
+} DgiIface;
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpEdbgDgiState, MCHP_EDBG_DGI)
+
+struct MchpEdbgDgiState {
+    DeviceState parent_obj;
+
+    CharFrontend chr;
+    char *sign_on;
+    uint16_t version;
+    char *interfaces;
+    uint32_t tick_hz;
+
+    DgiIface iface[DGI_MAX_IF];
+    unsigned niface;
+    bool poll_len32;
+    uint8_t cmd[DGI_CMD_MAX];
+    unsigned cmd_len;
+    GByteArray *to_target;      /* sent by the host, for I2C/SPI reads */
+    uint8_t gpio;               /* levels of the monitored lines */
+    bool ss_low;                /* the SPI slave select */
+};
+
+static DgiIface *dgi_iface(MchpEdbgDgiState *s, uint8_t id)
+{
+    for (unsigned i = 0; i < s->niface; i++) {
+        if (s->iface[i].id == id) {
+            return &s->iface[i];
+        }
+    }
+    return NULL;
+}
+
+/* Data for the host from interface @id, if the host has it on */
+static void dgi_push(MchpEdbgDgiState *s, uint8_t id, const uint8_t *data,
+                     size_t len)
+{
+    DgiIface *f = dgi_iface(s, id);
+
+    if (!f || !f->state) {
+        return;
+    }
+    if (f->buf->len + len > DGI_BUF_MAX) {
+        f->overflow = true;
+        return;
+    }
+    g_byte_array_append(f->buf, data, len);
+}
+
+static void dgi_reply(MchpEdbgDgiState *s, const uint8_t *data, size_t len)
+{
+    qemu_chr_fe_write_all(&s->chr, data, len);
+}
+
+static void dgi_reply_status(MchpEdbgDgiState *s, uint8_t cmd, uint8_t st)
+{
+    uint8_t r[2] = { cmd, st };
+
+    dgi_reply(s, r, sizeof(r));
+}
+
+static void dgi_stop_all(MchpEdbgDgiState *s)
+{
+    for (unsigned i = 0; i < s->niface; i++) {
+        s->iface[i].state = 0;
+        s->iface[i].overflow = false;
+        g_byte_array_set_size(s->iface[i].buf, 0);
+    }
+    g_byte_array_set_size(s->to_target, 0);
+}
+
+static void dgi_command(MchpEdbgDgiState *s, uint8_t cmd, const uint8_t *p,
+                        unsigned n)
+{
+    g_autoptr(GByteArray) r = g_byte_array_new();
+    uint8_t hdr[2] = { cmd, DGI_RESP_DATA };
+    DgiIface *f;
+
+    switch (cmd) {
+    case 0x00: {                                        /* sign on */
+        size_t len = strlen(s->sign_on) + 1;
+        uint8_t l[2] = { len >> 8, len };
+
+        g_byte_array_append(r, hdr, 2);
+        g_byte_array_append(r, l, 2);
+        g_byte_array_append(r, (const uint8_t *)s->sign_on, len);
+        break;
+    }
+    case 0x01:                                          /* sign off */
+        dgi_stop_all(s);
+        dgi_reply_status(s, cmd, DGI_RESP_OK);
+        return;
+    case 0x02: {                                        /* version */
+        uint8_t v[2] = { s->version >> 8, s->version };
+
+        g_byte_array_append(r, hdr, 2);
+        g_byte_array_append(r, v, 2);
+        break;
+    }
+    case 0x08: {                                        /* interfaces */
+        uint8_t count = s->niface;
+
+        g_byte_array_append(r, hdr, 2);
+        g_byte_array_append(r, &count, 1);
+        for (unsigned i = 0; i < s->niface; i++) {
+            g_byte_array_append(r, &s->iface[i].id, 1);
+        }
+        break;
+    }
+    case 0x0A:                                          /* set mode */
+        if (n >= 1) {
+            s->poll_len32 = p[0] & 4;
+        }
+        dgi_reply_status(s, cmd, DGI_RESP_OK);
+        return;
+    case 0x10:                                          /* enable */
+        f = n >= 2 ? dgi_iface(s, p[0]) : NULL;
+        if (!f || p[1] > 2) {
+            dgi_reply_status(s, cmd, DGI_RESP_FAIL);
+            return;
+        }
+        if (p[1] && !f->state) {
+            f->start_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+            f->overflow = false;
+            g_byte_array_set_size(f->buf, 0);
+            f->state = p[1];
+            if (f->id == DGI_IF_GPIO) {
+                /* The levels at the start come first */
+                mchp_edbg_dgi_gpio(s, UINT_MAX, false);
+            }
+        }
+        f->state = p[1];
+        dgi_reply_status(s, cmd, DGI_RESP_OK);
+        return;
+    case 0x11:                                          /* status */
+        g_byte_array_append(r, hdr, 2);
+        for (unsigned i = 0; i < s->niface; i++) {
+            uint8_t st[2] = { s->iface[i].id,
+                              (s->iface[i].state ? 1 : 0) |
+                              (s->iface[i].state == 2 ? 2 : 0) |
+                              (s->iface[i].overflow ? 4 : 0) };
+
+            g_byte_array_append(r, st, 2);
+        }
+        break;
+    case 0x12:                                          /* set config */
+        f = n >= 1 ? dgi_iface(s, p[0]) : NULL;
+        if (!f) {
+            dgi_reply_status(s, cmd, DGI_RESP_FAIL);
+            return;
+        }
+        for (unsigned o = 1; o + 6 <= n; o += 6) {
+            uint16_t id = p[o] << 8 | p[o + 1];
+            uint32_t val = ldl_be_p(p + o + 2);
+
+            for (unsigned c = 0; c < f->ncfg; c++) {
+                if (f->cfg_id[c] == id) {
+                    f->cfg_val[c] = val;
+                }
+            }
+        }
+        dgi_reply_status(s, cmd, DGI_RESP_OK);
+        return;
+    case 0x13: {                                        /* get config */
+        uint8_t l[2], pair[6];
+
+        f = n >= 1 ? dgi_iface(s, p[0]) : NULL;
+        if (!f) {
+            dgi_reply_status(s, cmd, DGI_RESP_FAIL);
+            return;
+        }
+        l[0] = (1 + 6 * f->ncfg) >> 8;
+        l[1] = 1 + 6 * f->ncfg;
+        g_byte_array_append(r, hdr, 2);
+        g_byte_array_append(r, l, 2);
+        g_byte_array_append(r, &f->id, 1);
+        for (unsigned c = 0; c < f->ncfg; c++) {
+            pair[0] = f->cfg_id[c] >> 8;
+            pair[1] = f->cfg_id[c];
+            stl_be_p(pair + 2, f->cfg_val[c]);
+            g_byte_array_append(r, pair, 6);
+        }
+        break;
+    }
+    case 0x14:                                          /* send data */
+        if (n >= 1 && dgi_iface(s, p[0]) &&
+            s->to_target->len + n - 1 <= DGI_BUF_MAX) {
+            g_byte_array_append(s->to_target, p + 1, n - 1);
+            dgi_reply_status(s, cmd, DGI_RESP_OK);
+        } else {
+            dgi_reply_status(s, cmd, DGI_RESP_FAIL);
+        }
+        return;
+    case 0x15: {                                        /* poll */
+        uint8_t l[4];
+        size_t len;
+
+        f = n >= 1 ? dgi_iface(s, p[0]) : NULL;
+        if (!f) {
+            dgi_reply_status(s, cmd, DGI_RESP_FAIL);
+            return;
+        }
+        len = s->poll_len32 ? f->buf->len : MIN(f->buf->len, 0xffff);
+        g_byte_array_append(r, hdr, 2);
+        g_byte_array_append(r, &f->id, 1);
+        if (s->poll_len32) {
+            stl_be_p(l, len);
+            g_byte_array_append(r, l, 4);
+        } else {
+            l[0] = len >> 8;
+            l[1] = len;
+            g_byte_array_append(r, l, 2);
+        }
+        g_byte_array_append(r, f->buf->data, len);
+        g_byte_array_remove_range(f->buf, 0, len);
+        f->overflow = false;
+        break;
+    }
+    case 0x20:                                          /* target reset */
+        dgi_reply_status(s, cmd, DGI_RESP_OK);
+        return;
+    default:
+        qemu_log_mask(LOG_UNIMP, "mchp-edbg-dgi: command 0x%02x\n", cmd);
+        dgi_reply_status(s, cmd, DGI_RESP_FAIL);
+        return;
+    }
+    dgi_reply(s, r->data, r->len);
+}
