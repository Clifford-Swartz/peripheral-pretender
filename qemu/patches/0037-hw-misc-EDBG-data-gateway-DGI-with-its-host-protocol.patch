+static int dgi_can_receive(void *opaque)
+{
+    MchpEdbgDgiState *s = opaque;
+
+    return DGI_CMD_MAX - s->cmd_len;
+}
+
+static void dgi_receive(void *opaque, const uint8_t *buf, int size)
+{
+    MchpEdbgDgiState *s = opaque;
+
+    memcpy(s->cmd + s->cmd_len, buf, size);
+    s->cmd_len += size;
+    while (s->cmd_len >= 3) {
+        unsigned n = s->cmd[1] << 8 | s->cmd[2];
+
+        if (n > DGI_CMD_MAX - 3) {
+            s->cmd_len = 0;                 /* garbage: start over */
+            return;
+        }
+        if (s->cmd_len < 3 + n) {
+            return;
+        }
+        dgi_command(s, s->cmd[0], s->cmd + 3, n);
+        memmove(s->cmd, s->cmd + 3 + n, s->cmd_len - 3 - n);
+        s->cmd_len -= 3 + n;
+    }
+}
+
+static void dgi_chr_event(void *opaque, QEMUChrEvent event)
+{
+    MchpEdbgDgiState *s = opaque;
+
+    if (event == CHR_EVENT_CLOSED) {
+        /* The host went away: as a sign off */
+        dgi_stop_all(s);
+        s->cmd_len = 0;
+    }
+}
+
+static uint8_t dgi_from_host(MchpEdbgDgiState *s)
+{
+    uint8_t b = 0;
+
+    if (s->to_target->len) {
+        b = s->to_target->data[0];
+        g_byte_array_remove_index(s->to_target, 0);
+    }
+    return b;
+}
+
+void mchp_edbg_dgi_gpio(void *opaque, unsigned line, bool level)
+{
+    MchpEdbgDgiState *s = opaque;
+    DgiIface *f = dgi_iface(s, DGI_IF_GPIO);
+    uint8_t rec[5];
+    unsigned n = 0;
+
+    if (line < DGI_GPIO_LINES) {
+        s->gpio = deposit32(s->gpio, line, 1, level);
+    } else if (line == DGI_GPIO_LINES) {
+        s->ss_low = !level;                 /* the SPI slave select */
+        return;
+    }
+    if (!f || !f->state) {
+        return;
+    }
+    if (f->state == 2) {
+        int64_t dt = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - f->start_ns;
+
+        stl_be_p(rec, muldiv64(dt, s->tick_hz, NANOSECONDS_PER_SECOND));
+        n = 4;
+    }
+    rec[n++] = s->gpio;
+    dgi_push(s, DGI_IF_GPIO, rec, n);
+}
+
+static void dgi_add_iface(MchpEdbgDgiState *s, uint8_t id)
+{
+    DgiIface *f = &s->iface[s->niface++];
+
+    f->id = id;
+    f->buf = g_byte_array_new();
+    /* Configurations as an nEDBG reports them */
+    switch (id) {
+    case DGI_IF_TIMESTAMP:
+        f->cfg_id[0] = 0;                   /* prescaler */
+        f->cfg_val[0] = 1;
+        f->cfg_id[1] = 1;                   /* clock, Hz */
+        f->cfg_val[1] = s->tick_hz;
+        f->ncfg = 2;
+        break;
+    case DGI_IF_GPIO:
+        f->cfg_id[0] = 0;                   /* input lines */
+        f->cfg_val[0] = 2;
+        f->cfg_id[1] = 1;                   /* output lines */
+        f->cfg_val[1] = 0;
+        f->ncfg = 2;
+        break;
+    default:
+        break;
+    }
+}
+
+static void dgi_realize(DeviceState *dev, Error **errp)
+{
+    MchpEdbgDgiState *s = MCHP_EDBG_DGI(dev);
+    g_auto(GStrv) ids = g_strsplit(s->interfaces ? s->interfaces : "", ",",
+                                   -1);
+
+    for (unsigned i = 0; ids[i] && *ids[i]; i++) {
+        unsigned long id = strtoul(ids[i], NULL, 16);
+
+        if (s->niface == DGI_MAX_IF || id > 0xff) {
+            error_setg(errp, "mchp-edbg-dgi: bad interfaces \"%s\"",
+                       s->interfaces);
+            return;
+        }
+        dgi_add_iface(s, id);
+    }
+    s->to_target = g_byte_array_new();
+    qemu_chr_fe_set_handlers(&s->chr, dgi_can_receive, dgi_receive,
+                             dgi_chr_event, NULL, s, NULL, true);
+}
