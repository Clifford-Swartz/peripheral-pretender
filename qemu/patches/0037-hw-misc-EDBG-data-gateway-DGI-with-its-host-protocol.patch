+/*
+ * The EDBG data gateway: its host side on the chardev "dgi=" names (none:
+ * the target side still answers, as the debugger's I2C address does)
+ */
+static void pic32cm_mc00_cpro_add_dgi(Pic32cmMc00CproState *s,
+                                      DeviceState *port)
+{
+    DeviceState *dgi = qdev_new(TYPE_MCHP_EDBG_DGI);
+    DeviceState *dev;
+
+    if (s->dgi) {
+        Chardev *chr = qemu_chr_find(s->dgi);
+
+        if (!chr) {
+            error_report("dgi: no chardev \"%s\"", s->dgi);
+            exit(1);
+        }
+        qdev_prop_set_chr(dgi, "chardev", chr);
+    }
+    qdev_prop_set_string(dgi, "interfaces", "00,20,22,30");
+    object_property_add_child(OBJECT(s), "edbg-dgi", OBJECT(dgi));
+    qdev_realize_and_unref(dgi, NULL, &error_fatal);
+
+    dev = qdev_new(TYPE_MCHP_EDBG_DGI_I2C);
+    qdev_prop_set_uint8(dev, "address", CPRO_EDBG_DGI_ADDR);
+    object_property_set_link(OBJECT(dev), "dgi", OBJECT(dgi), &error_fatal);
+    i2c_slave_realize_and_unref(I2C_SLAVE(dev), I2C_BUS(qdev_get_child_bus(
+        pic32cm_soc_periph(&s->soc, CPRO_EXT_I2C), "sercom2.i2c")),
+        &error_fatal);
+
+    dev = qdev_new(TYPE_MCHP_EDBG_DGI_SPI);
+    /* Its own slave select is a pad watch: a CS index the Clicks do not use */
+    qdev_prop_set_uint8(dev, "cs", 15);
+    object_property_set_link(OBJECT(dev), "dgi", OBJECT(dgi), &error_fatal);
+    ssi_realize_and_unref(dev, (SSIBus *)(qdev_get_child_bus(
+        pic32cm_soc_periph(&s->soc, CPRO_EXT_SPI), "sercom1.spi")),
+        &error_fatal);
+
+    for (unsigned i = 0; i < ARRAY_SIZE(pic32cm_mc00_cpro_dgi_gpio); i++) {
+        mchp_port_watch(port, pic32cm_mc00_cpro_dgi_gpio[i],
+                        mchp_edbg_dgi_gpio, dgi, i);
+    }
+    mchp_port_watch(port, CPRO_DGI_SS, mchp_edbg_dgi_gpio, dgi,
+                    MCHP_EDBG_DGI_SS_LINE);
+}
+
+static char *pic32cm_mc00_cpro_get_dgi(Object *obj, Error **errp)
