+void mchp_port_watch(DeviceState *port, unsigned pin, MchpPadWatchFn *fn,
+                     void *opaque, unsigned line)
+{
+    MchpPortState *s = MCHP_PORT(port);
+
+    assert(s->nwatch < MCHP_PORT_WATCHES);
+    s->watch[s->nwatch].pin = pin;
+    s->watch[s->nwatch].line = line;
+    s->watch[s->nwatch].fn = fn;
+    s->watch[s->nwatch].opaque = opaque;
+    s->watch[s->nwatch].valid = false;
+    s->nwatch++;
+    if (pin / MCHP_PORT_GROUP_PINS < s->ngroups) {
+        mchp_port_update_func(s, pin / MCHP_PORT_GROUP_PINS);
+    }
+}
