+/*
+ * Every transfer on the bus reaches it: it takes part while its slave
+ * select (a GPIO monitor line, mchp_edbg_dgi_gpio() line DGI_GPIO_LINES)
+ * is low and the host has SPI on; otherwise it answers 0 (the bus ORs).
+ */
+bool mchp_edbg_dgi_spi_driving(DeviceState *dev)
+{
+    MchpEdbgDgiSpiState *s = MCHP_EDBG_DGI_SPI(dev);
+    DgiIface *f = s->dgi ? dgi_iface(s->dgi, DGI_IF_SPI) : NULL;
+
+    return f && f->state && s->dgi->ss_low;
+}
+
+static uint32_t dgi_spi_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    MchpEdbgDgiSpiState *s = MCHP_EDBG_DGI_SPI(dev);
+    uint8_t b = val;
+
+    if (!mchp_edbg_dgi_spi_driving(DEVICE(dev))) {
+        return 0;
+    }
+    dgi_push(s->dgi, DGI_IF_SPI, &b, 1);
+    return dgi_from_host(s->dgi);
