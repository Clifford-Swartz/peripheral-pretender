+/*
+ * Whether anything on the bus can drive MISO: a device, unless it is a
+ * debugger's DGI SPI target that is not taking part (its pins tristated)
+ */
+static bool mchp_sercom_spi_driven(MchpSercomState *s)
+{
+    BusChild *kid;
+
+    QTAILQ_FOREACH(kid, &BUS(s->spi)->children, sibling) {
+        if (!object_dynamic_cast(OBJECT(kid->child),
+                                 TYPE_MCHP_EDBG_DGI_SPI) ||
+            mchp_edbg_dgi_spi_driving(kid->child)) {
+            return true;
+        }
+    }
+    return false;
+}
