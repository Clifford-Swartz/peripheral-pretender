diff --git a/tests/qtest/pic32cm-tsens-test.c b/tests/qtest/pic32cm-tsens-test.c
new file mode 100644
index 0000000..d813895
--- /dev/null
+++ b/tests/qtest/pic32cm-tsens-test.c
@@ -0,0 +1,116 @@
+/*
+ * QTest for the temperature sensor of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The board side of the TSENS model: the "temperature" property through
+ * the factory calibration, the conversion time on stepped virtual time
+ * and its GCLK dependence. firmware/hello APP=tsens checks the rest
+ * against silicon.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+#define TSENS_PATH      "/machine/soc/tsens"
+
+#define OSCCTRL         0x40001000
+#define GCLK            0x40001C00
+#define TSENS           0x40003000
+#define TEMP_LOG        0x00806030
+#define TSENS_GCLK      5
+
+#define R_CTRLA         0x00
+#define R_CTRLB         0x01
+#define R_INTFLAG       0x06
+#define R_VALUE         0x0C
+#define R_GAIN          0x18
+#define R_OFFSET        0x1C
+#define R_CAL           0x20
+
+#define ENABLE          0x02
+#define RESRDY          0x01
+
+/* GCLK_TSENS from generator 0 (4 MHz, or 48 MHz with OSC48MDIV = 0) */
+static QTestState *tsens_init(bool mhz48)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    uint32_t lo = qtest_readl(qts, TEMP_LOG);
+    uint32_t hi = qtest_readl(qts, TEMP_LOG + 4);
+
+    if (mhz48) {
+        qtest_writeb(qts, OSCCTRL + 0x15, 0);
+    }
+    qtest_writel(qts, GCLK + 0x80 + 4 * TSENS_GCLK, 0x40);  /* GEN0, CHEN */
+    qtest_writel(qts, TSENS + R_CAL, (lo & 0x3F) << 8 | ((lo >> 6) & 0x3F));
+    qtest_writel(qts, TSENS + R_GAIN, ((hi & 0xF) << 20) | (lo >> 12));
+    qtest_writel(qts, TSENS + R_OFFSET, hi >> 4);
+    qtest_writeb(qts, TSENS + R_CTRLA, ENABLE);
+    return qts;
+}
+
+static int32_t convert(QTestState *qts, int64_t step_ns)
+{
+    qtest_writeb(qts, TSENS + R_CTRLB, 1);
+    qtest_clock_step(qts, step_ns);
+    g_assert_cmphex(qtest_readb(qts, TSENS + R_INTFLAG) & RESRDY, ==, RESRDY);
+    return sextract32(qtest_readl(qts, TSENS + R_VALUE), 0, 24);
+}
+
+static void set_temp(QTestState *qts, int mdeg)
+{
+    qtest_qmp_assert_success(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '" TSENS_PATH "',"
+        " 'property': 'temperature', 'value': %d } }", mdeg);
+}
+
+/* With the factory calibration at 48 MHz: hundredths of a degree */
+static void test_temperature(void)
+{
+    QTestState *qts = tsens_init(true);
+
+    g_assert_cmpint(convert(qts, 4000000), ==, 2500);
+    set_temp(qts, 31500);
+    g_assert_cmpint(convert(qts, 4000000), ==, 3150);
+    set_temp(qts, -10000);
+    g_assert_cmpint(convert(qts, 4000000), ==, -1000);
+    qtest_quit(qts);
+}
+
+/* (2 GAIN + 2000) clocks: 3.499 ms at 48 MHz with this part's GAIN */
+static void test_conversion_time(void)
+{
+    QTestState *qts = tsens_init(true);
+
+    qtest_writeb(qts, TSENS + R_CTRLB, 1);
+    qtest_clock_step(qts, 3490000);
+    g_assert_cmphex(qtest_readb(qts, TSENS + R_INTFLAG), ==, 0);
+    qtest_clock_step(qts, 20000);
+    g_assert_cmphex(qtest_readb(qts, TSENS + R_INTFLAG), ==, RESRDY);
+    qtest_quit(qts);
+}
+
+/* At 4 MHz (reset clocks) VALUE - OFFSET is 12 times as large */
+static void test_slow_clock(void)
+{
+    QTestState *qts = tsens_init(false);
+    int32_t offset = sextract32(qtest_readl(qts, TSENS + R_OFFSET), 0, 24);
+
+    g_assert_cmpint(convert(qts, 43000000), ==,
+                    offset + 12 * (2500 - offset));
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-tsens/temperature", test_temperature);
+    qtest_add_func("pic32cm-tsens/conversion-time", test_conversion_time);
+    qtest_add_func("pic32cm-tsens/slow-clock", test_slow_clock);
+    return g_test_run();
+}
