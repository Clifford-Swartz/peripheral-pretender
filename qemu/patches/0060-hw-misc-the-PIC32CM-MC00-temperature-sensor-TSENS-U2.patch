diff --git a/hw/misc/mchp_tsens_u2261.c b/hw/misc/mchp_tsens_u2261.c
new file mode 100644
index 0000000..6f7ea47
--- /dev/null
+++ b/hw/misc/mchp_tsens_u2261.c
@@ -0,0 +1,415 @@
+/*
+ * Microchip PIC32CM MC00 temperature sensor (TSENS U2261)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A conversion measures the sensor's oscillator in two phases of GAIN
+ * GCLK_TSENS periods each and gives VALUE = OFFSET + GAIN * D(T) / f_GCLK
+ * (DS60001638E 40.5.1), 24-bit two's complement. D(T) follows from the
+ * part's factory calibration (the NVM temperature log at 0x00806030) so
+ * that firmware loading it reads hundredths of a degree: 2500 at 25 C.
+ * The temperature is the property "temperature" (millidegrees C, default
+ * 25000), settable at run time.
+ *
+ * What the PIC32CM MC00 (rev A1, firmware/hello APP=tsensprobe and
+ * tsensprobe2) showed, and the model does:
+ *
+ *   - A conversion takes (2 * GAIN + 2000) GCLK_TSENS periods (3.50 ms
+ *     with the factory GAIN at 48 MHz); GAIN = 0 counts as 2^24, in time
+ *     and in the result. VALUE - OFFSET scales with GAIN / f_GCLK; OFFSET
+ *     adds. FREERUN converts back to back at that period.
+ *   - START (CTRLB, or a rising edge of the START event, falling with
+ *     STARTINV, with STARTEI) is ignored while converting and while
+ *     disabled; with no GCLK_TSENS a conversion waits for the clock and
+ *     then takes the full time. Disabling aborts a conversion; one that
+ *     FREERUN started runs again from the start at the next enable, even
+ *     with FREERUN cleared meanwhile.
+ *   - A result sets RESRDY, and OVERRUN if the previous VALUE was not
+ *     read; reading VALUE clears RESRDY and WINMON. A result outside 24
+ *     bits sets OVF and STATUS.OVF (no RESRDY) and stores its low 24
+ *     bits; disabling or the next good result clears STATUS.OVF.
+ *   - The window monitor compares signed values, ABOVE: VALUE > WINLT,
+ *     BELOW: VALUE < WINUT, INSIDE, OUTSIDE (VALUE < WINLT or > WINUT, as
+ *     the ATDF says), HYST_ABOVE/BELOW from WINUT/WINLT; WINMON sets and
+ *     the WINMON event pulses on every matching result. The hysteresis
+ *     state restarts at enable.
+ *   - SWRST keeps GAIN, OFFSET, CAL and DBGCTRL.
+ *
+ * Not modelled: CAL (silicon: CAL = 0 shifts the reading by about -9 C;
+ * FCAL and TCAL trim it), the DMA trigger, sleep, DBGRUN, the reading's
+ * noise (silicon: about +-0.2 C).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include <math.h>
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/timer.h"
+#include "hw/core/clock.h"
+#include "hw/core/irq.h"
+#include "hw/misc/mchp_tsens.h"
+#include "hw/mchp/gen/tsens_u2261.h"
+#include "migration/vmstate.h"
+#include "system/dma.h"
+
+#define TEMP_LOG_ADDR       0x00806030
+#define CAL_HZ              48000000.0  /* factory calibration clock */
+/* The desk part's factory GAIN and OFFSET, for an erased log */
+#define NOMINAL_GAIN        82977
+#define NOMINAL_OFFSET      9282
+#define FIXED_CYCLES        2000
+
+#define VALUE_MAX           0x7FFFFF
+#define VALUE_MIN           (-0x800000)
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpTsensState, MCHP_TSENS_U2261)
+
+struct MchpTsensState {
+    MchpRegBlock parent_obj;
+
+    int32_t temperature;        /* millidegrees C */
+    bool busy;                  /* a conversion is running */
+    bool waiting;               /* started, waiting for GCLK_TSENS */
+    bool by_freerun;            /* the running conversion FREERUN began */
+    bool resume;                /* run one at enable (FREERUN, disabled) */
+    bool unread;                /* VALUE not read since the last result */
+    bool hyst;                  /* HYST_ABOVE/BELOW: inside since a match */
+    bool ev_level;              /* the START event input */
+    bool swrst;                 /* the next reset is a SWRST */
+    uint32_t keep[4];           /* GAIN, OFFSET, CAL, DBGCTRL across it */
+
+    QEMUTimer *timer;
+    qemu_irq winmon_event;
+};
+
+static uint32_t ts_reg(MchpTsensState *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static void ts_set_reg(MchpTsensState *s, hwaddr off, unsigned size,
+                       uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
+static bool ts_on(MchpTsensState *s)
+{
+    return ts_reg(s, A_MCHP_TSENS_CTRLA, 1) & R_MCHP_TSENS_CTRLA_ENABLE_MASK;
+}
+
+static void ts_flag(MchpTsensState *s, uint8_t bits)
+{
+    ts_set_reg(s, A_MCHP_TSENS_INTFLAG, 1,
+               ts_reg(s, A_MCHP_TSENS_INTFLAG, 1) | bits);
+}
+
+static int32_t sext24(uint32_t v)
+{
+    return sextract32(v, 0, 24);
+}
+
+/* GAIN in effect: 0 counts as 2^24 (silicon) */
+static uint64_t ts_gain(MchpTsensState *s)
+{
+    uint32_t g = ts_reg(s, A_MCHP_TSENS_GAIN, 4) & 0xFFFFFF;
+
+    return g ? g : 1u << 24;
+}
+
+/*
+ * The result at the current temperature: D(T) is the oscillators'
+ * frequency difference that the factory calibration maps to T / 10
+ */
+static int64_t ts_result(MchpTsensState *s, uint64_t hz)
+{
+    uint32_t log[2];
+    double gain_nvm, offset_nvm, d;
+
+    dma_memory_read(&address_space_memory, TEMP_LOG_ADDR, log, sizeof(log),
+                    MEMTXATTRS_UNSPECIFIED);
+    gain_nvm = ((le32_to_cpu(log[1]) & 0xF) << 20) |
+               (le32_to_cpu(log[0]) >> 12);
+    offset_nvm = sext24(le32_to_cpu(log[1]) >> 4);
+    if (gain_nvm == 0 || gain_nvm == 0xFFFFFF) {
+        gain_nvm = NOMINAL_GAIN;
+        offset_nvm = NOMINAL_OFFSET;
+    }
+    d = (s->temperature / 10.0 - offset_nvm) * CAL_HZ / gain_nvm;
+    return sext24(ts_reg(s, A_MCHP_TSENS_OFFSET, 4)) +
+           llround(ts_gain(s) * d / hz);
+}
+
+/* The window monitor on a result */
+static bool ts_window(MchpTsensState *s, int32_t v)
+{
+    int32_t lt = sext24(ts_reg(s, A_MCHP_TSENS_WINLT, 4));
+    int32_t ut = sext24(ts_reg(s, A_MCHP_TSENS_WINUT, 4));
+
+    switch (FIELD_EX32(ts_reg(s, A_MCHP_TSENS_CTRLC, 1), MCHP_TSENS_CTRLC,
+                       WINMODE)) {
+    case 1:
+        return v > lt;
+    case 2:
+        return v < ut;
+    case 3:
+        return v > lt && v < ut;
+    case 4:
+        return v < lt || v > ut;
+    case 5:
+        s->hyst = s->hyst ? v > lt : v > ut;
+        return s->hyst;
+    case 6:
+        s->hyst = s->hyst ? v < ut : v < lt;
+        return s->hyst;
+    default:
+        return false;
+    }
+}
+
+static void ts_begin(MchpTsensState *s);
+
+static void ts_done(void *opaque)
+{
+    MchpTsensState *s = opaque;
+    uint64_t hz = clock_get_hz(MCHP_REGBLOCK(s)->gclk);
+    int64_t v = ts_result(s, hz ? hz : 1);
+
+    s->busy = false;
+    ts_set_reg(s, A_MCHP_TSENS_VALUE, 4, v & 0xFFFFFF);
+    if (v < VALUE_MIN || v > VALUE_MAX) {
+        ts_flag(s, R_MCHP_TSENS_INTFLAG_OVF_MASK);
+        ts_set_reg(s, A_MCHP_TSENS_STATUS, 1, R_MCHP_TSENS_STATUS_OVF_MASK);
+    } else {
+        ts_set_reg(s, A_MCHP_TSENS_STATUS, 1, 0);
+        ts_flag(s, R_MCHP_TSENS_INTFLAG_RESRDY_MASK |
+                   (s->unread ? R_MCHP_TSENS_INTFLAG_OVERRUN_MASK : 0));
+        s->unread = true;
+        if (ts_window(s, v)) {
+            ts_flag(s, R_MCHP_TSENS_INTFLAG_WINMON_MASK);
+            if (ts_reg(s, A_MCHP_TSENS_EVCTRL, 1) &
+                R_MCHP_TSENS_EVCTRL_WINEO_MASK) {
+                qemu_irq_pulse(s->winmon_event);
+            }
+        }
+    }
+    if (FIELD_EX32(ts_reg(s, A_MCHP_TSENS_CTRLC, 1), MCHP_TSENS_CTRLC,
+                   FREERUN) && ts_on(s)) {
+        ts_begin(s);
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+/* A conversion starts now, or when GCLK_TSENS runs */
+static void ts_begin(MchpTsensState *s)
+{
+    uint64_t hz = clock_get_hz(MCHP_REGBLOCK(s)->gclk);
+    uint64_t cycles = 2 * ts_gain(s) + FIXED_CYCLES;
+
+    s->busy = true;
+    s->by_freerun = FIELD_EX32(ts_reg(s, A_MCHP_TSENS_CTRLC, 1),
+                               MCHP_TSENS_CTRLC, FREERUN);
+    s->waiting = !hz;
+    if (hz) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  muldiv64(cycles, NANOSECONDS_PER_SECOND, hz));
+    }
+}
+
+static void ts_start(MchpTsensState *s)
+{
+    if (ts_on(s) && !s->busy) {
+        ts_begin(s);
+    }
+}
+
+static void ts_stop(MchpTsensState *s)
+{
+    timer_del(s->timer);
+    s->busy = false;
+    s->waiting = false;
+}
+
+static void ts_start_event(void *opaque, int n, int level)
+{
+    MchpTsensState *s = opaque;
+    uint8_t ev = ts_reg(s, A_MCHP_TSENS_EVCTRL, 1);
+    bool inv = ev & R_MCHP_TSENS_EVCTRL_STARTINV_MASK;
+    bool was = s->ev_level ^ inv;
+
+    s->ev_level = level > 0;
+    if ((ev & R_MCHP_TSENS_EVCTRL_STARTEI_MASK) && !was &&
+        (s->ev_level ^ inv)) {
+        ts_start(s);
+    }
+}
+
+static uint32_t ts_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                            unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpTsensState *s = MCHP_TSENS_U2261(rf->opaque);
+
+    if (ri->offset == A_MCHP_TSENS_VALUE && side_effects) {
+        s->unread = false;
+        ts_set_reg(s, A_MCHP_TSENS_INTFLAG, 1,
+                   ts_reg(s, A_MCHP_TSENS_INTFLAG, 1) &
+                   ~(R_MCHP_TSENS_INTFLAG_RESRDY_MASK |
+                     R_MCHP_TSENS_INTFLAG_WINMON_MASK));
+        mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+    }
+    return stored;
+}
+
+static void ts_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                          unsigned idx, uint32_t old, uint32_t written,
+                          uint32_t we)
+{
+    MchpTsensState *s = MCHP_TSENS_U2261(rf->opaque);
+
+    switch (ri->offset) {
+    case A_MCHP_TSENS_CTRLA:
+        if (written & we & R_MCHP_TSENS_CTRLA_SWRST_MASK) {
+            /* mchp_regblock_soft_reset() follows: keep these through it */
+            s->swrst = true;
+            s->keep[0] = ts_reg(s, A_MCHP_TSENS_GAIN, 4);
+            s->keep[1] = ts_reg(s, A_MCHP_TSENS_OFFSET, 4);
+            s->keep[2] = ts_reg(s, A_MCHP_TSENS_CAL, 4);
+            s->keep[3] = ts_reg(s, A_MCHP_TSENS_DBGCTRL, 1);
+        } else if (ts_on(s) && !(old & R_MCHP_TSENS_CTRLA_ENABLE_MASK)) {
+            s->hyst = false;
+            if (s->resume ||
+                FIELD_EX32(ts_reg(s, A_MCHP_TSENS_CTRLC, 1),
+                           MCHP_TSENS_CTRLC, FREERUN)) {
+                s->resume = false;
+                ts_begin(s);
+            }
+        } else if (!ts_on(s) && (old & R_MCHP_TSENS_CTRLA_ENABLE_MASK)) {
+            s->resume = s->busy && s->by_freerun;
+            ts_stop(s);
+            ts_set_reg(s, A_MCHP_TSENS_STATUS, 1, 0);
+        }
+        break;
+    case A_MCHP_TSENS_CTRLB:
+        if (written & we & R_MCHP_TSENS_CTRLB_START_MASK) {
+            ts_start(s);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void ts_gclk_update(MchpRegBlock *rb, ClockEvent event)
+{
+    MchpTsensState *s = MCHP_TSENS_U2261(rb);
+
+    if (event == ClockUpdate && s->waiting &&
+        clock_get_hz(rb->gclk)) {
+        ts_begin(s);            /* the whole conversion from now */
+    }
+}
+
+static void ts_reset_hold(MchpRegBlock *rb)
+{
+    MchpTsensState *s = MCHP_TSENS_U2261(rb);
+
+    ts_stop(s);
+    s->resume = false;
+    s->unread = false;
+    s->hyst = false;
+    if (s->swrst) {
+        s->swrst = false;
+        ts_set_reg(s, A_MCHP_TSENS_GAIN, 4, s->keep[0]);
+        ts_set_reg(s, A_MCHP_TSENS_OFFSET, 4, s->keep[1]);
+        ts_set_reg(s, A_MCHP_TSENS_CAL, 4, s->keep[2]);
+        ts_set_reg(s, A_MCHP_TSENS_DBGCTRL, 1, s->keep[3]);
+    }
+}
+
+static void ts_get_temp(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, &MCHP_TSENS_U2261(obj)->temperature, errp);
+}
+
+static void ts_set_temp(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    int32_t t;
+
+    if (!visit_type_int32(v, name, &t, errp)) {
+        return;
+    }
+    if (t < -40000 || t > 150000) {
+        error_setg(errp, "temperature: %d mC is outside -40000..150000", t);
+        return;
+    }
+    MCHP_TSENS_U2261(obj)->temperature = t;
+}
+
+static void ts_init(Object *obj)
+{
+    MchpTsensState *s = MCHP_TSENS_U2261(obj);
+
+    s->temperature = 25000;
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, ts_done, s);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->winmon_event,
+                             MCHP_TSENS_WINMON_EVENT, 1);
+    qdev_init_gpio_in_named(DEVICE(obj), ts_start_event,
+                            MCHP_TSENS_START_EVENT_IN, 1);
+    object_property_add(obj, "temperature", "int32", ts_get_temp,
+                        ts_set_temp, NULL, NULL);
+}
+
+static void ts_finalize(Object *obj)
+{
+    timer_free(MCHP_TSENS_U2261(obj)->timer);
+}
+
+static const VMStateDescription vmstate_mchp_tsens = {
+    .name = TYPE_MCHP_TSENS_U2261,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpTsensState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_INT32(temperature, MchpTsensState),
+        VMSTATE_BOOL(busy, MchpTsensState),
+        VMSTATE_BOOL(waiting, MchpTsensState),
+        VMSTATE_BOOL(by_freerun, MchpTsensState),
+        VMSTATE_BOOL(resume, MchpTsensState),
+        VMSTATE_BOOL(unread, MchpTsensState),
+        VMSTATE_BOOL(hyst, MchpTsensState),
+        VMSTATE_BOOL(ev_level, MchpTsensState),
+        VMSTATE_TIMER_PTR(timer, MchpTsensState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void ts_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_tsens;
+    c->pre_read = ts_pre_read;
+    c->post_write = ts_post_write;
+    c->reset_hold = ts_reset_hold;
+    c->gclk_update = ts_gclk_update;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_tsens_types[] = {
+    {
+        .name = TYPE_MCHP_TSENS_U2261,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpTsensState),
+        .instance_init = ts_init,
+        .instance_finalize = ts_finalize,
+        .class_init = ts_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_tsens_types)
