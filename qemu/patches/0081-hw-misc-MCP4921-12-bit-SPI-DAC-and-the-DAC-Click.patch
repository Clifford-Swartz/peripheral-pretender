+/*
+ * Microchip MCP4921 12-bit SPI DAC
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * "mchp-mcp4921": an SSI peripheral (chip select active low). GPIO input
+ * "ldac" (LDAC#, low by default: the output follows each write). QOM
+ * properties "vref" and "vdd" (mV, default 3300), and read-only "code"
+ * (the DAC register), "vout" (the output in mV, 0 while shut down) and
+ * "readout" ("VOUT 1.650 V", or "VOUT off").
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_MCP4921_H
+#define HW_MISC_MCHP_MCP4921_H
+
+#define TYPE_MCHP_MCP4921 "mchp-mcp4921"
+
+#define MCHP_MCP4921_LDAC "ldac"
+
+#endif /* HW_MISC_MCHP_MCP4921_H */
