 }
 
+static char *qom_str(QTestState *qts, const char *path, const char *prop);
+
+/* One 16-bit MCP4921 write on SERCOM1, CS# on PA17 */
+static void dac_write(QTestState *qts, uint16_t word, unsigned bytes)
+{
+    qtest_writel(qts, PA + P_OUTCLR, BIT(17));
+    spi_byte(qts, word >> 8);
+    if (bytes > 1) {
+        spi_byte(qts, word & 0xff);
+    }
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));
+}
+
+/* DAC Click on EXT1: MCP4921 (CS# PA17), VOUT on its terminals */
+static void test_dac(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext1=dac ");
+    g_autofree char *mid = NULL, *off = NULL;
+
+    g_assert_true(pin_high(qts, PA, 17));               /* R4 pull-up */
+    g_assert_cmpuint(qom_int(qts, CLICK1, "vout"), ==, 0);
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, PA + P_OUTSET, BIT(17));
+    qtest_writel(qts, PA + P_DIRSET, BIT(17));
+    dac_write(qts, 0x3800, 2);                  /* gain 1, on, 2048 */
+    g_assert_cmpuint(qom_int(qts, CLICK1, "code"), ==, 2048);
+    g_assert_cmpuint(qom_int(qts, CLICK1, "vout"), ==, 1650);
+    mid = qom_str(qts, CLICK1, "readout");
+    g_assert_cmpstr(mid, ==, "VOUT 1.650 V");
+    dac_write(qts, 0x1c00, 2);                  /* gain 2: 3072 is VDD */
+    g_assert_cmpuint(qom_int(qts, CLICK1, "vout"), ==, 3300);
+    dac_write(qts, 0x3400, 1);                  /* 8 clocks: aborted */
+    g_assert_cmpuint(qom_int(qts, CLICK1, "code"), ==, 3072);
+    dac_write(qts, 0x2800, 2);                  /* SHDN# low */
+    g_assert_cmpuint(qom_int(qts, CLICK1, "vout"), ==, 0);
+    off = qom_str(qts, CLICK1, "readout");
+    g_assert_cmpstr(off, ==, "VOUT off");
+    qtest_quit(qts);
+}
+
