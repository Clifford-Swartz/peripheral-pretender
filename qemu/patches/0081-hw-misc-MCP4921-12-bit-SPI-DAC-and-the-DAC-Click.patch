diff --git a/hw/misc/mchp_mcp4921.c b/hw/misc/mchp_mcp4921.c
new file mode 100644
index 0000000..07bef8d
--- /dev/null
+++ b/hw/misc/mchp_mcp4921.c
@@ -0,0 +1,217 @@
+/*
+ * Microchip MCP4921 12-bit SPI DAC, and the DAC Click
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * MCP4921/4922 data sheet (DS21897B), section 5: with CS# low, sixteen
+ * bits shift in MSB first: A/B (the MCP4922's second DAC; writes with it
+ * set are ignored here), BUF, GA# (1: VOUT = VREF * D / 4096, 0: twice
+ * that), SHDN# (0: output off) and twelve data bits. CS# rising after
+ * exactly sixteen clocks loads the input register; before sixteen the
+ * write is aborted. More than sixteen keeps the last sixteen bits (the
+ * shift register; not checked). The DAC register follows the input
+ * register while LDAC# is low, else on its falling edge. The output is
+ * limited to VDD; shut down, it is high impedance and reads 0 V (the
+ * DAC Click loads it with 10 kOhm to ground). The device has no SDO.
+ * Settling time, the reference buffer and the output's load regulation
+ * are not modelled.
+ *
+ * DAC Click (MikroElektronika, schematic v100): CS# with R4 100 kOhm
+ * pull-up, LDAC# tied low, VREF on VCC (J1; 4.096 V from an MCP1541 on
+ * the other position, "vref=4096"), VCC 3.3 V (J2). Not checked against
+ * a physical Click.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/misc/mchp_mcp4921.h"
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+
+#define MCP4921_AB          (1u << 15)
+#define MCP4921_GA          (1u << 13)      /* 1: gain 1 */
+#define MCP4921_SHDN        (1u << 12)      /* 0: shut down */
+#define MCP4921_DATA        0x0fffu
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpMcp4921State, MCHP_MCP4921)
+
+struct MchpMcp4921State {
+    SSIPeripheral parent_obj;
+
+    uint32_t vref;                      /* mV */
+    uint32_t vdd;                       /* mV */
+    uint32_t shift;                     /* bits clocked in since CS# fell */
+    uint32_t bits;
+    uint16_t input;                     /* input register: config + data */
+    uint16_t dac;                       /* DAC register */
+    bool ldac;                          /* LDAC# level */
+};
+
+static uint32_t mcp4921_vout(MchpMcp4921State *s)
+{
+    uint64_t mv;
+
+    if (!(s->dac & MCP4921_SHDN)) {
+        return 0;
+    }
+    mv = (uint64_t)s->vref * (s->dac & MCP4921_DATA) / 4096;
+    if (!(s->dac & MCP4921_GA)) {
+        mv *= 2;
+    }
+    return MIN(mv, s->vdd);
+}
+
+static uint32_t mcp4921_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    MchpMcp4921State *s = MCHP_MCP4921(dev);
+
+    s->shift = s->shift << 8 | (val & 0xff);
+    s->bits += 8;
+    return 0;                           /* no SDO */
+}
+
+static int mcp4921_set_cs(SSIPeripheral *dev, bool high)
+{
+    MchpMcp4921State *s = MCHP_MCP4921(dev);
+
+    if (!high) {
+        s->shift = 0;
+        s->bits = 0;
+        return 0;
+    }
+    if (s->bits < 16) {
+        if (s->bits) {
+            qemu_log_mask(LOG_GUEST_ERROR, "mcp4921: %u clocks, write "
+                          "aborted\n", s->bits);
+        }
+        return 0;
+    }
+    if (s->shift & MCP4921_AB) {
+        qemu_log_mask(LOG_GUEST_ERROR, "mcp4921: write to DAC B ignored\n");
+        return 0;
+    }
+    s->input = s->shift & 0xffff;
+    if (!s->ldac) {
+        s->dac = s->input;
+    }
+    return 0;
+}
+
+static void mcp4921_set_ldac(void *opaque, int n, int level)
+{
+    MchpMcp4921State *s = opaque;
+
+    /* Low (and its falling edge) copies the input register */
+    s->ldac = level > 0;
+    if (!s->ldac) {
+        s->dac = s->input;
+    }
+}
+
+static void mcp4921_get_vout(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    uint32_t mv = mcp4921_vout(MCHP_MCP4921(obj));
+
+    visit_type_uint32(v, name, &mv, errp);
+}
+
+static void mcp4921_get_code(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    uint32_t code = MCHP_MCP4921(obj)->dac & MCP4921_DATA;
+
+    visit_type_uint32(v, name, &code, errp);
+}
+
+static char *mcp4921_get_readout(Object *obj, Error **errp)
+{
+    MchpMcp4921State *s = MCHP_MCP4921(obj);
+    uint32_t mv = mcp4921_vout(s);
+
+    if (!(s->dac & MCP4921_SHDN)) {
+        return g_strdup("VOUT off");
+    }
+    return g_strdup_printf("VOUT %u.%03u V", mv / 1000, mv % 1000);
+}
+
+static void mcp4921_realize(SSIPeripheral *dev, Error **errp)
+{
+}
+
+static void mcp4921_reset(DeviceState *dev)
+{
+    MchpMcp4921State *s = MCHP_MCP4921(dev);
+
+    /* Power-on reset: the DAC holds 0, the output buffer on */
+    s->shift = 0;
+    s->bits = 0;
+    s->input = MCP4921_GA | MCP4921_SHDN;
+    s->dac = s->input;
+    s->parent_obj.cs = true;            /* CS# pulled up */
+}
+
+static void mcp4921_init(Object *obj)
+{
+    qdev_init_gpio_in_named(DEVICE(obj), mcp4921_set_ldac, MCHP_MCP4921_LDAC,
+                            1);
+    object_property_add(obj, "vout", "uint32", mcp4921_get_vout, NULL, NULL,
+                        NULL);
+    object_property_add(obj, "code", "uint32", mcp4921_get_code, NULL, NULL,
+                        NULL);
+    object_property_add_str(obj, "readout", mcp4921_get_readout, NULL);
+}
+
+static const Property mcp4921_properties[] = {
+    DEFINE_PROP_UINT32("vref", MchpMcp4921State, vref, 3300),
+    DEFINE_PROP_UINT32("vdd", MchpMcp4921State, vdd, 3300),
+};
+
+static const VMStateDescription vmstate_mcp4921 = {
+    .name = TYPE_MCHP_MCP4921,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, MchpMcp4921State),
+        VMSTATE_UINT32(shift, MchpMcp4921State),
+        VMSTATE_UINT32(bits, MchpMcp4921State),
+        VMSTATE_UINT16(input, MchpMcp4921State),
+        VMSTATE_UINT16(dac, MchpMcp4921State),
+        VMSTATE_BOOL(ldac, MchpMcp4921State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mcp4921_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    dc->desc = "MCP4921 12-bit SPI DAC";
+    dc->vmsd = &vmstate_mcp4921;
+    device_class_set_props(dc, mcp4921_properties);
+    device_class_set_legacy_reset(dc, mcp4921_reset);
+    k->realize = mcp4921_realize;
+    k->transfer = mcp4921_transfer;
+    k->set_cs = mcp4921_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+}
+
+static const TypeInfo mcp4921_types[] = {
+    {
+        .name = TYPE_MCHP_MCP4921,
+        .parent = TYPE_SSI_PERIPHERAL,
+        .instance_size = sizeof(MchpMcp4921State),
+        .instance_init = mcp4921_init,
+        .class_init = mcp4921_class_init,
+    },
+};
+
+DEFINE_TYPES(mcp4921_types)
