+/* DAC Click on mikroBUS 1: MCP4921, CS# on PA7 */
+static void test_dac_mb1(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb1=dac -kernel %s",
+                                  (const char *)fw);
+
+    qtest_writeb(qts, PORTA + 0x05, BIT(7));                    /* OUTSET */
+    qtest_writeb(qts, PORTA + 0x01, BIT(4) | BIT(6) | BIT(7));  /* DIRSET */
+    qtest_writeb(qts, SPI0 + 0, 0x21);                  /* MASTER, ENABLE */
+    qtest_writeb(qts, PORTA + 0x06, BIT(7));                    /* OUTCLR */
+    spi0_xfer(qts, 0x34);                       /* gain 1, on, 1024 */
+    spi0_xfer(qts, 0x00);
+    qtest_writeb(qts, PORTA + 0x05, BIT(7));
+    g_assert_cmpuint(qom_uint(qts, "/machine/mb1-click", "vout"), ==, 825);
+    qtest_quit(qts);
+}
+
