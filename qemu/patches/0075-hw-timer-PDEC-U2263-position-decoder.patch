diff --git a/hw/timer/mchp_pdec.c b/hw/timer/mchp_pdec.c
new file mode 100644
index 0000000..bbbb851
--- /dev/null
+++ b/hw/timer/mchp_pdec.c
@@ -0,0 +1,746 @@
+/*
+ * Microchip position decoder (PDEC U2263)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * QDEC, HALL and COUNTER modes as PIC32CM MC00 silicon showed them
+ * (firmware/hello APP=pdecprobe and pdecprobe2, checked by pdec;
+ * docs/research/peripherals/pdec-u2263.md):
+ *
+ *   - Inputs S0-S2: the pad PDEC[n] ("pad-qdi-in", CTRLA.PINENn, inverted
+ *     by PINVENn) or the event EVUn ("evu-event-in", EVCTRL.EVEIn,
+ *     EVINVn); CTRLA.SWAP swaps S0 and S1 in QDEC and HALL.
+ *   - The enable leaves QDEC and HALL stopped (STATUS.STOP) until a START
+ *     command; COUNTER counts from the enable. STOP keeps COUNT; RETRIGGER
+ *     loads 0 in either direction; a re-enable stops again.
+ *   - QDEC X4 (CONF X4, and X4S/AUTOC without their extras): every S0/S1
+ *     transition counts, the S0-leading order up. A reversal sets
+ *     STATUS.DIR at its first edge and INTFLAG.DIR at the second; every
+ *     transition but that first one raises VLC. A simultaneous S0/S1
+ *     change sets STATUS.QERR and ERR and does not count, except the first
+ *     transition after START. X2 (and X2S): each S0 edge counts, down
+ *     while S1 is 1; STATUS.DIR follows S1, INTFLAG.DIR flags a count in
+ *     the other direction than the last.
+ *   - COUNT holds the angular count in its ANGULAR + 9 low bits and the
+ *     revolution count above. Each part wraps at its TOP (all ones, or
+ *     the part of CC0 with PEREN); an angular wrap moves the revolution
+ *     count without a flag, a wrap of both raises OVF.
+ *   - COUNTER counts GCLK_PDEC / 2^PRESC up to TOP (0xFFFF, or CC0 with
+ *     PEREN), then wraps with OVF.
+ *   - MC0 and MC1 flag COUNT becoming CC0, CC1 (a count that stays on
+ *     the value flags nothing), and a match at START and RETRIGGER.
+ *   - Input changes in the same instant are one transition (one event
+ *     into EVU0 and EVU1 is a simultaneous S0/S1 change, as on silicon).
+ *   - HALL: the code S2 S1 S0 lands in COUNT[2:0]; 0 and 7 set HERR and
+ *     ERR; the 1-3-2-6-4-5 order clears STATUS.DIR, the reverse sets it.
+ *   - COUNT reads the copy READSYNC (or a COUNT write) left. CCBUFx,
+ *     PRESCBUF and FILTERBUF set their STATUS valid bit; CCx reads show
+ *     CCBUFx while it is valid, and a CCBUFx write meanwhile is dropped
+ *     (silicon kept the first of two); the UPDATE command, and an
+ *     overflow unless CTRLB.LUPD, copies them.
+ *   - Events: OVF, ERR, VLC, MC0, MC1 pulse their outputs (with their
+ *     EVCTRL ...EO), DIR gives STATUS.DIR as a level.
+ *
+ * Not modelled: the index (X4/X2 revolution counting on an index, the X4S
+ * and X2S index checks), AUTOC's correction, the HALL window and delay
+ * counters and their flags, the input filter (FILTER), COUNTER's event
+ * actions, standby.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/timer/mchp_pdec.h"
+#include "hw/mchp/gen/pdec_u2263.h"
+#include "migration/vmstate.h"
+
+#define A_CTRLA         A_MCHP_PDEC_CTRLA
+#define A_CTRLBSET      A_MCHP_PDEC_CTRLBSET
+#define A_EVCTRL        A_MCHP_PDEC_EVCTRL
+#define A_INTFLAG       A_MCHP_PDEC_INTFLAG
+#define A_STATUS        A_MCHP_PDEC_STATUS
+#define A_PRESC         A_MCHP_PDEC_PRESC
+#define A_FILTER        A_MCHP_PDEC_FILTER
+#define A_PRESCBUF      A_MCHP_PDEC_PRESCBUF
+#define A_FILTERBUF     A_MCHP_PDEC_FILTERBUF
+#define A_COUNT         A_MCHP_PDEC_COUNT
+#define A_CC            A_MCHP_PDEC_CC
+#define A_CCBUF         A_MCHP_PDEC_CCBUF
+#define F(reg, field)   R_MCHP_PDEC_##reg##_##field##_MASK
+
+enum { MODE_QDEC, MODE_HALL, MODE_COUNTER };
+enum { CONF_X4, CONF_X4S, CONF_X2, CONF_X2S, CONF_AUTOC };
+enum { CMD_RETRIGGER = 1, CMD_UPDATE, CMD_READSYNC, CMD_START, CMD_STOP };
+
+#define FLAG_OVF        0x01
+#define FLAG_ERR        0x02
+#define FLAG_DIR        0x04
+#define FLAG_VLC        0x08
+#define FLAG_MC0        0x10
+#define FLAG_MC1        0x20
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpPdecState, MCHP_PDEC)
+
+struct MchpPdecState {
+    MchpRegBlock parent_obj;
+
+    qemu_irq ovf_event, err_event, dir_event, vlc_event;
+    qemu_irq mc_event[2];
+    QEMUTimer *timer;           /* COUNTER mode's next match or wrap */
+    QEMUTimer *in_timer;        /* decodes this instant's input changes */
+
+    uint8_t pad;                /* "pad-qdi-in" levels */
+    uint8_t evu;                /* "evu-event-in" levels */
+    uint8_t in;                 /* S0-S2 as the decoder last saw them */
+    uint16_t count;
+    bool reversing;             /* one edge seen against STATUS.DIR */
+    bool last_down;             /* X2: the last count's direction */
+    bool started;               /* a transition since START (QERR) */
+    bool dir_level;             /* the DIR event output */
+    bool warned;
+    int64_t t_base;             /* COUNTER: the instant of the last tick */
+};
+
+static uint32_t pdec_reg(MchpPdecState *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static void pdec_set(MchpPdecState *s, hwaddr off, unsigned size, uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
+static void pdec_status(MchpPdecState *s, uint16_t clear, uint16_t set)
+{
+    pdec_set(s, A_STATUS, 2, (pdec_reg(s, A_STATUS, 2) & ~clear) | set);
+}
+
+static uint32_t pdec_ctrla(MchpPdecState *s)
+{
+    return pdec_reg(s, A_CTRLA, 4);
+}
+
+static unsigned pdec_mode(MchpPdecState *s)
+{
+    return FIELD_EX32(pdec_ctrla(s), MCHP_PDEC_CTRLA, MODE);
+}
+
+static bool pdec_enabled(MchpPdecState *s)
+{
+    return FIELD_EX32(pdec_ctrla(s), MCHP_PDEC_CTRLA, ENABLE);
+}
+
+static bool pdec_stopped(MchpPdecState *s)
+{
+    return pdec_reg(s, A_STATUS, 2) & F(STATUS, STOP);
+}
+
+static bool pdec_down(MchpPdecState *s)
+{
+    return pdec_reg(s, A_STATUS, 2) & F(STATUS, DIR);
+}
+
+static void pdec_dir_event(MchpPdecState *s)
+{
+    bool level = pdec_down(s) &&
+                 FIELD_EX32(pdec_reg(s, A_EVCTRL, 2), MCHP_PDEC_EVCTRL, DIREO);
+
+    if (level != s->dir_level) {
+        s->dir_level = level;
+        qemu_set_irq(s->dir_event, level);
+    }
+}
+
+/* Raise @flags, pulse their events */
+static void pdec_flag(MchpPdecState *s, uint8_t flags)
+{
+    uint16_t ev = pdec_reg(s, A_EVCTRL, 2);
+
+    if (!flags) {
+        return;
+    }
+    pdec_set(s, A_INTFLAG, 1, pdec_reg(s, A_INTFLAG, 1) | flags);
+    if ((flags & FLAG_OVF) && FIELD_EX32(ev, MCHP_PDEC_EVCTRL, OVFEO)) {
+        qemu_irq_pulse(s->ovf_event);
+    }
+    if ((flags & FLAG_ERR) && FIELD_EX32(ev, MCHP_PDEC_EVCTRL, ERREO)) {
+        qemu_irq_pulse(s->err_event);
+    }
+    if ((flags & FLAG_VLC) && FIELD_EX32(ev, MCHP_PDEC_EVCTRL, VLCEO)) {
+        qemu_irq_pulse(s->vlc_event);
+    }
+    for (unsigned n = 0; n < 2; n++) {
+        if ((flags & (FLAG_MC0 << n)) &&
+            extract32(ev, R_MCHP_PDEC_EVCTRL_MCEO0_SHIFT + n, 1)) {
+            qemu_irq_pulse(s->mc_event[n]);
+        }
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+/* CCx as compared: the register (CCBUFx waits for an update) */
+static uint16_t pdec_cc(MchpPdecState *s, unsigned n)
+{
+    return pdec_reg(s, A_CC + 4 * n, 4);
+}
+
+/* MC0/MC1 when COUNT matches CC0/CC1 */
+static uint8_t pdec_matches(MchpPdecState *s)
+{
+    return (s->count == pdec_cc(s, 0) ? FLAG_MC0 : 0) |
+           (s->count == pdec_cc(s, 1) ? FLAG_MC1 : 0);
+}
+
+/* Copy the valid buffers into their registers */
+static void pdec_update(MchpPdecState *s)
+{
+    uint16_t st = pdec_reg(s, A_STATUS, 2);
+
+    for (unsigned n = 0; n < 2; n++) {
+        if (st & (F(STATUS, CCBUFV0) << n)) {
+            pdec_set(s, A_CC + 4 * n, 4, pdec_reg(s, A_CCBUF + 4 * n, 4));
+        }
+    }
+    if (st & F(STATUS, PRESCBUFV)) {
+        pdec_set(s, A_PRESC, 1, pdec_reg(s, A_PRESCBUF, 1));
+    }
+    if (st & F(STATUS, FILTERBUFV)) {
+        pdec_set(s, A_FILTER, 1, pdec_reg(s, A_FILTERBUF, 1));
+    }
+    pdec_status(s, F(STATUS, CCBUFV0) | F(STATUS, CCBUFV1) |
+                F(STATUS, PRESCBUFV) | F(STATUS, FILTERBUFV), 0);
+}
+
+static void pdec_overflow(MchpPdecState *s)
+{
+    if (!(pdec_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, LUPD))) {
+        pdec_update(s);
+    }
+}
+
+/* One QDEC count up or down: the angular and revolution parts */
+static uint8_t pdec_count_step(MchpPdecState *s, bool down)
+{
+    uint32_t ctrla = pdec_ctrla(s);
+    unsigned abits = MIN(FIELD_EX32(ctrla, MCHP_PDEC_CTRLA, ANGULAR) + 9, 16);
+    uint32_t amask = MAKE_64BIT_MASK(0, abits), rmask = 0xFFFF >> abits;
+    uint32_t ang = s->count & amask, rev = (s->count >> abits) & rmask;
+    uint32_t atop = amask, rtop = rmask;
+    uint8_t flags = 0;
+
+    if (FIELD_EX32(ctrla, MCHP_PDEC_CTRLA, PEREN)) {
+        atop = pdec_cc(s, 0) & amask;
+        rtop = (pdec_cc(s, 0) >> abits) & rmask;
+    }
+    if (!down) {
+        if (ang >= atop) {
+            ang = 0;
+            if (rev >= rtop) {
+                rev = 0;
+                flags |= FLAG_OVF;
+            } else {
+                rev++;
+            }
+        } else {
+            ang++;
+        }
+    } else {
+        if (ang == 0) {
+            ang = atop;
+            if (rev == 0) {
+                rev = rtop;
+                flags |= FLAG_OVF;
+            } else {
+                rev--;
+            }
+        } else {
+            ang--;
+        }
+    }
+    if (((rev << abits) | ang) == s->count) {
+        return flags;           /* a match flags only on the way in */
+    }
+    s->count = (rev << abits) | ang;
+    if (flags & FLAG_OVF) {
+        pdec_overflow(s);
+    }
+    return flags | pdec_matches(s);
+}
+
+/* Position of an S0/S1 state in the S0-leading order 00 10 11 01 */
+static int pdec_quad_pos(uint8_t v)
+{
+    static const int8_t pos[4] = { 0, 1, 3, 2 };
+
+    return pos[v & 3];
+}
+
+static void pdec_qdec(MchpPdecState *s, uint8_t old, uint8_t new)
+{
+    unsigned conf = FIELD_EX32(pdec_ctrla(s), MCHP_PDEC_CTRLA, CONF);
+    uint8_t changed = (old ^ new) & 3;
+    uint8_t flags = 0;
+    bool down;
+
+    if (!changed) {
+        if ((old ^ new) & 4 && !s->warned) {
+            qemu_log_mask(LOG_UNIMP, "%s: the index is not modelled\n",
+                          MCHP_REGBLOCK(s)->name);
+            s->warned = true;
+        }
+        return;
+    }
+    if (conf == CONF_X2 || conf == CONF_X2S) {
+        down = new & 2;
+        pdec_status(s, F(STATUS, DIR), down ? F(STATUS, DIR) : 0);
+        if (changed & 1) {
+            flags = FLAG_VLC | pdec_count_step(s, down);
+            if (down != s->last_down) {
+                flags |= FLAG_DIR;
+            }
+            s->last_down = down;
+        }
+        pdec_dir_event(s);
+        pdec_flag(s, flags);
+        return;
+    }
+    if (changed == 3) {
+        if (s->started) {
+            pdec_status(s, 0, F(STATUS, QERR));
+            flags |= FLAG_ERR;
+        }
+        s->started = true;
+        pdec_flag(s, flags);
+        return;
+    }
+    s->started = true;
+    down = pdec_quad_pos(new) != (pdec_quad_pos(old) + 1) % 4;
+    if (down != pdec_down(s)) {
+        pdec_status(s, F(STATUS, DIR), down ? F(STATUS, DIR) : 0);
+        s->reversing = true;
+    } else if (s->reversing) {
+        s->reversing = false;
+        flags |= FLAG_DIR | FLAG_VLC;
+    } else {
+        flags |= FLAG_VLC;
+    }
+    flags |= pdec_count_step(s, down);
+    pdec_dir_event(s);
+    pdec_flag(s, flags);
+}
+
+/* Position of a hall code in the 1-3-2-6-4-5 order, -1 if invalid */
+static int pdec_hall_pos(uint8_t code)
+{
+    static const int8_t pos[8] = { -1, 0, 2, 1, 4, 5, 3, -1 };
+
+    return pos[code & 7];
+}
+
+static void pdec_hall(MchpPdecState *s, uint8_t old, uint8_t new)
+{
+    int po = pdec_hall_pos(old), pn = pdec_hall_pos(new);
+    uint8_t flags = 0;
+
+    if (!s->warned) {
+        qemu_log_mask(LOG_UNIMP, "%s: the HALL window and delay counters are "
+                      "not modelled\n", MCHP_REGBLOCK(s)->name);
+        s->warned = true;
+    }
+    s->count = (s->count & ~7) | (new & 7);
+    if (pn < 0) {
+        pdec_status(s, 0, F(STATUS, HERR));
+        flags |= FLAG_ERR;
+    } else if (po >= 0 && pn != po) {
+        bool down = pn != (po + 1) % 6;
+
+        if (down != pdec_down(s)) {
+            flags |= FLAG_DIR;
+        }
+        pdec_status(s, F(STATUS, DIR), down ? F(STATUS, DIR) : 0);
+        flags |= FLAG_VLC;
+    }
+    pdec_dir_event(s);
+    pdec_flag(s, flags);
+}
+
+/* S0-S2 from the pads or events, inverted, swapped */
+static uint8_t pdec_inputs(MchpPdecState *s)
+{
+    uint32_t ctrla = pdec_ctrla(s);
+    uint16_t ev = pdec_reg(s, A_EVCTRL, 2);
+    uint8_t in = 0;
+
+    for (unsigned n = 0; n < 3; n++) {
+        bool v = false;
+
+        if (extract32(ctrla, R_MCHP_PDEC_CTRLA_PINEN0_SHIFT + n, 1)) {
+            v = extract32(s->pad, n, 1) ^
+                extract32(ctrla, R_MCHP_PDEC_CTRLA_PINVEN0_SHIFT + n, 1);
+        } else if (extract32(ev, R_MCHP_PDEC_EVCTRL_EVEI_SHIFT + n, 1)) {
+            v = extract32(s->evu, n, 1) ^
+                extract32(ev, R_MCHP_PDEC_EVCTRL_EVINV_SHIFT + n, 1);
+        }
+        in |= v << n;
+    }
+    if (FIELD_EX32(ctrla, MCHP_PDEC_CTRLA, SWAP) &&
+        pdec_mode(s) != MODE_COUNTER) {
+        in = (in & 4) | ((in & 1) << 1) | ((in >> 1) & 1);
+    }
+    return in;
+}
+
+/* The inputs as they settled this instant */
+static void pdec_decode(void *opaque)
+{
+    MchpPdecState *s = opaque;
+    uint8_t old = s->in, new = pdec_inputs(s);
+
+    s->in = new;
+    if (old == new || !pdec_enabled(s) || pdec_stopped(s)) {
+        return;
+    }
+    switch (pdec_mode(s)) {
+    case MODE_QDEC:
+        pdec_qdec(s, old, new);
+        break;
+    case MODE_HALL:
+        pdec_hall(s, old, new);
+        break;
+    default:
+        break;
+    }
+}
+
+/* COUNTER mode: the length of a counter tick in ns, 0 while stopped */
+static int64_t pdec_tick_ns(MchpPdecState *s)
+{
+    Clock *clk = MCHP_REGBLOCK(s)->gclk;
+    unsigned presc = FIELD_EX32(pdec_reg(s, A_PRESC, 1), MCHP_PDEC_PRESC,
+                                PRESC);
+
