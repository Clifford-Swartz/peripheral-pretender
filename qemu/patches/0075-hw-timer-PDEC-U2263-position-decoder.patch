+        break;
+    case CMD_UPDATE:
+        pdec_update(s);
+        break;
+    case CMD_READSYNC:
+        pdec_set(s, A_COUNT, 4, s->count);
+        break;
+    case CMD_START:
+        if (pdec_enabled(s) && pdec_stopped(s)) {
+            pdec_status(s, F(STATUS, STOP), 0);
+            s->started = false;
+            s->reversing = false;
+            s->in = pdec_inputs(s);
+            pdec_flag(s, pdec_matches(s));
+        }
+        break;
+    case CMD_STOP:
+        pdec_status(s, 0, F(STATUS, STOP));
+        break;
+    default:
