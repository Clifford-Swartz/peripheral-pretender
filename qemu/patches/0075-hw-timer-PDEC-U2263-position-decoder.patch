diff --git a/tests/qtest/pic32cm-pdec-test.c b/tests/qtest/pic32cm-pdec-test.c
new file mode 100644
index 0000000..467bd3c
--- /dev/null
+++ b/tests/qtest/pic32cm-pdec-test.c
@@ -0,0 +1,173 @@
+/*
+ * QTest for the PDEC of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The mchp-pdec model through its input lines: X4 counting and a
+ * reversal, X2, COUNTER timing and the CC buffer. firmware/hello APP=pdec
+ * checks the same against silicon, and QERR (one event into two inputs:
+ * two qtest commands are never one instant).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+#define PDEC            0x42006800
+#define PDEC_PATH       "/machine/soc/pdec"
+#define GCLK_PCHCTRL    0x40001C80
+#define PDEC_GCLK_ID    34
+#define R_CTRLA         0x00
+#define R_CTRLBSET      0x05
+#define R_INTFLAG       0x0A
+#define R_STATUS        0x0C
+#define R_PRESC         0x14
+#define R_COUNT         0x1C
+#define R_CC(n)         (0x20 + 4 * (n))
+#define R_CCBUF(n)      (0x30 + 4 * (n))
+#define ENABLE          BIT(1)
+#define MODE_COUNTER    (2 << 2)
+#define CONF_X2         (2 << 8)
+#define PEREN           BIT(15)
+#define AB              (BIT(16) | BIT(17))
+#define CMD_UPDATE      (2 << 5)
+#define CMD_READSYNC    (3 << 5)
+#define CMD_START       (4 << 5)
+#define OVF             BIT(0)
+#define DIRF            BIT(2)
+#define VLC             BIT(3)
+#define MC0             BIT(4)
+#define MC1             BIT(5)
+#define STOP            BIT(6)
+#define DIR             BIT(7)
+#define CCBUFV0         BIT(12)
+
+static QTestState *pdec_init(uint32_t ctrla, int start)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * PDEC_GCLK_ID, 0x40);
+    qtest_writel(qts, PDEC + R_CTRLA, ctrla);
+    qtest_writel(qts, PDEC + R_CTRLA, ctrla | ENABLE);
+    if (start) {
+        qtest_writeb(qts, PDEC + R_CTRLBSET, CMD_START);
+    }
+    qtest_writeb(qts, PDEC + R_INTFLAG, 0xFF);
+    return qts;
+}
+
+/* Pads A and B to bits 0 and 1 of @ab, in one instant */
+static void ab(QTestState *qts, unsigned v)
+{
+    qtest_set_irq_in(qts, PDEC_PATH, "pad-qdi-in", 0, v & 1);
+    qtest_set_irq_in(qts, PDEC_PATH, "pad-qdi-in", 1, (v >> 1) & 1);
+    qtest_clock_step(qts, 1000);
+}
+
+static uint32_t count(QTestState *qts)
+{
+    qtest_writeb(qts, PDEC + R_CTRLBSET, CMD_READSYNC);
+    return qtest_readl(qts, PDEC + R_COUNT);
+}
+
+static uint8_t flags(QTestState *qts)
+{
+    uint8_t f = qtest_readb(qts, PDEC + R_INTFLAG);
+
+    qtest_writeb(qts, PDEC + R_INTFLAG, f);
+    return f;
+}
+
+/* X4: up 4 per cycle; reversing sets DIR at once, the DIR flag next */
+static void test_x4(void)
+{
+    static const uint8_t fwd[4] = { 1, 3, 2, 0 };
+    QTestState *qts = pdec_init(AB, 0);
+
+    ab(qts, 1);
+    g_assert_cmpuint(count(qts), ==, 0);        /* stopped until START */
+    g_assert_cmphex(qtest_readw(qts, PDEC + R_STATUS) & STOP, ==, STOP);
+    ab(qts, 0);
+    qtest_writeb(qts, PDEC + R_CTRLBSET, CMD_START);
+    flags(qts);
+    for (unsigned k = 0; k < 4; k++) {
+        ab(qts, fwd[k]);
+    }
+    g_assert_cmpuint(count(qts), ==, 4);
+    g_assert_cmphex(flags(qts), ==, VLC);
+    ab(qts, 2);                                 /* back: 00 -> 01 */
+    g_assert_cmpuint(count(qts), ==, 3);
+    g_assert_cmphex(qtest_readw(qts, PDEC + R_STATUS) & DIR, ==, DIR);
+    g_assert_cmphex(flags(qts), ==, 0);
+    ab(qts, 3);
+    g_assert_cmphex(flags(qts), ==, DIRF | VLC);
+    qtest_quit(qts);
+}
+
+/* X2: S0 edges count, down while S1 is 1 */
+static void test_x2(void)
+{
+    QTestState *qts = pdec_init(AB | CONF_X2, 1);
+
+    ab(qts, 1);
+    ab(qts, 0);
+    g_assert_cmpuint(count(qts), ==, 2);
+    ab(qts, 2);
+    g_assert_cmphex(qtest_readw(qts, PDEC + R_STATUS) & DIR, ==, DIR);
+    ab(qts, 3);
+    ab(qts, 2);
+    g_assert_cmpuint(count(qts), ==, 0);
+    qtest_quit(qts);
+}
+
+/* COUNTER: GCLK0 4 MHz / 4 = 1 us ticks from the enable; CC0 TOP, CC1 */
+static void test_counter(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * PDEC_GCLK_ID, 0x40);
+    qtest_writeb(qts, PDEC + R_PRESC, 2);
+    qtest_writel(qts, PDEC + R_CC(0), 99);
+    qtest_writel(qts, PDEC + R_CC(1), 30);
+    qtest_writel(qts, PDEC + R_CTRLA, MODE_COUNTER | PEREN | ENABLE);
+    flags(qts);
+    qtest_clock_step(qts, 30500);
+    g_assert_cmpuint(count(qts), ==, 30);
+    g_assert_cmphex(flags(qts), ==, MC1);
+    qtest_clock_step(qts, 69000);               /* 99.5 us: CC0 */
+    g_assert_cmphex(flags(qts), ==, MC0);
+    qtest_clock_step(qts, 1000);                /* 100.5 us: wrapped */
+    g_assert_cmpuint(count(qts), ==, 0);
+    g_assert_cmphex(flags(qts), ==, OVF);
+    qtest_quit(qts);
+}
+
+/* CCBUF0 shows in CC0 while valid; a second write is dropped; UPDATE */
+static void test_buffer(void)
+{
+    QTestState *qts = pdec_init(AB | PEREN, 1);
+
+    qtest_writel(qts, PDEC + R_CCBUF(0), 0x200);
+    g_assert_cmphex(qtest_readl(qts, PDEC + R_CC(0)), ==, 0x200);
+    g_assert_cmphex(qtest_readw(qts, PDEC + R_STATUS) & CCBUFV0, ==,
+                    CCBUFV0);
+    qtest_writel(qts, PDEC + R_CCBUF(0), 0x300);
+    qtest_writeb(qts, PDEC + R_CTRLBSET, CMD_UPDATE);
+    g_assert_cmphex(qtest_readl(qts, PDEC + R_CC(0)), ==, 0x200);
+    g_assert_cmphex(qtest_readw(qts, PDEC + R_STATUS) & CCBUFV0, ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-pdec/x4", test_x4);
+    qtest_add_func("pic32cm-pdec/x2", test_x2);
+    qtest_add_func("pic32cm-pdec/counter", test_counter);
+    qtest_add_func("pic32cm-pdec/buffer", test_buffer);
+    return g_test_run();
+}
