+    if (ri->offset == A_CC &&
+        (pdec_reg(s, A_STATUS, 2) & (F(STATUS, CCBUFV0) << idx))) {
+        return pdec_reg(s, A_CCBUF + 4 * idx, 4);
+    }
+    if (side_effects) {
+        pdec_sync(s);
+    }
+    return stored;
