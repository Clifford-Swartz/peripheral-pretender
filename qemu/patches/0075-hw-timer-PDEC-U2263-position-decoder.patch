+/*
+ * Microchip position decoder (PDEC U2263)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An mchp-regblock (see mchp_pdec.c). GPIO inputs "pad-qdi-in"[3] (the
+ * PDEC[n] pads while muxed to the PDEC) and "evu-event-in"[3] (EVSYS
+ * users EVU0-2); outputs "ovf-event", "err-event", "vlc-event",
+ * "mc-event"[2] (pulses) and "dir-event" (STATUS.DIR as a level).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_TIMER_MCHP_PDEC_H
+#define HW_TIMER_MCHP_PDEC_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_PDEC "mchp-pdec"
+
+#define MCHP_PDEC_PAD_QDI_IN "pad-qdi-in"
+#define MCHP_PDEC_EVU_EVENT_IN "evu-event-in"
+
+#endif /* HW_TIMER_MCHP_PDEC_H */
