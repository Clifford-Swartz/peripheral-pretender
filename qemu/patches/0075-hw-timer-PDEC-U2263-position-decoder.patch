+static uint32_t pdec_next_event(MchpPdecState *s)
+{
+    uint16_t top = pdec_top(s);
+    uint32_t next = (uint32_t)(top - MIN(s->count, top)) + 1;  /* wrap */
+
+    for (unsigned n = 0; n < 2; n++) {
+        uint16_t cc = pdec_cc(s, n);
