+            return;             /* mchp-regblock resets the PDEC next */
+        }
+        if (!(old & F(CTRLA, ENABLE)) && (val & F(CTRLA, ENABLE))) {
+            /* QDEC and HALL wait for START; COUNTER runs */
+            pdec_status(s, F(STATUS, STOP),
