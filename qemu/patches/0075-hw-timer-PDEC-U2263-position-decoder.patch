+static uint32_t pdec_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                              unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpPdecState *s = MCHP_PDEC(rf->opaque);
