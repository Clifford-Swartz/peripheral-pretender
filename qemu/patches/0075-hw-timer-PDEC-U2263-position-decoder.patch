+    s->in_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, pdec_decode, s);
+    qdev_init_gpio_in_named(dev, pdec_pad_in, MCHP_PDEC_PAD_QDI_IN, 3);
+    qdev_init_gpio_in_named(dev, pdec_evu_in, MCHP_PDEC_EVU_EVENT_IN, 3);
+    qdev_init_gpio_out_named(dev, &s->ovf_event, "ovf-event", 1);
+    qdev_init_gpio_out_named(dev, &s->err_event, "err-event", 1);
+    qdev_init_gpio_out_named(dev, &s->dir_event, "dir-event", 1);
+    qdev_init_gpio_out_named(dev, &s->vlc_event, "vlc-event", 1);
+    qdev_init_gpio_out_named(dev, s->mc_event, "mc-event", 2);
