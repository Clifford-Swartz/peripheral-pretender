+
+static void pdec_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                            unsigned idx, uint32_t old, uint32_t written,
+                            uint32_t we)
+{
+    MchpPdecState *s = MCHP_PDEC(rf->opaque);
+    uint32_t val = mchp_regfile_get(rf, ri, idx);
