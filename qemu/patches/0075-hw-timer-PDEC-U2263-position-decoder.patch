+    }
+    case A_COUNT:
+        pdec_sync(s);
+        s->count = val;
+        pdec_restart_base(s);
+        break;
+    case A_CC:
+        pdec_sync(s);
+        pdec_restart_base(s);
+        break;
+    case A_CCBUF:
+        if (pdec_reg(s, A_STATUS, 2) & (F(STATUS, CCBUFV0) << idx)) {
+            pdec_set(s, A_CCBUF + 4 * idx, 4, old);     /* dropped */
+        }
+        pdec_status(s, 0, F(STATUS, CCBUFV0) << idx);
+        break;
+    case A_PRESCBUF:
+        pdec_status(s, 0, F(STATUS, PRESCBUFV));
+        break;
+    case A_FILTERBUF:
+        pdec_status(s, 0, F(STATUS, FILTERBUFV));
+        break;
+    case A_PRESC:
+        pdec_sync(s);
+        pdec_restart_base(s);
+        break;
+    default:
+        break;
+    }
+}
