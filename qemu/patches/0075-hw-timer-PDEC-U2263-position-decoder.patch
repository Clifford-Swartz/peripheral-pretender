+            s->count += elapsed;
+            s->t_base += elapsed * tick;
+            timer_mod(s->timer, s->t_base + (n - elapsed) * tick);
+            return;
+        }
+        s->t_base += (int64_t)n * tick;
+        if ((uint32_t)s->count + n > top) {
+            s->count = 0;
+            pdec_overflow(s);
+            pdec_flag(s, FLAG_OVF | pdec_matches(s));
