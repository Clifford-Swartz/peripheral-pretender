+/* STAMP: a two-deep FIFO per channel, ERR when full; MAX at an overflow */
+static void test_capture_stamp(void)
+{
+    QTestState *qts = capture_init(MODE_COUNT8 | DIV1024 | CAPTEN0,
+                                   EVACT_STAMP);
+
+    qtest_writeb(qts, TC0 + T_PER, 200);
+    qtest_clock_step(qts, 3 * TICK_NS + TICK_NS / 2);
+    ext(qts, true);                                         /* COUNT 3 */
+    ext(qts, false);
+    qtest_clock_step(qts, 4 * TICK_NS);
+    ext(qts, true);                                         /* COUNT 7 */
+    ext(qts, false);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & (MC0 | ERR), ==,
+                    MC0);
+    g_assert_cmpuint(qtest_readb(qts, TC0 + T_CC0), ==, 3);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & MC0, ==, 0);
+    qtest_clock_step(qts, 1000);                            /* 2 GCLK */
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & MC0, ==, MC0);
+    g_assert_cmpuint(qtest_readb(qts, TC0 + T_CC0), ==, 7);
+    for (int i = 0; i < 3; i++) {
+        ext(qts, true);
+        ext(qts, false);
+    }
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & ERR, ==, ERR);
+    qtest_quit(qts);
+
+    qts = capture_init(MODE_COUNT8 | DIV1024 | CAPTEN0 | CAPTEN1,
+                       EVACT_STAMP);
+    qtest_writeb(qts, TC0 + T_PER, 20);
+    qtest_clock_step(qts, 22 * TICK_NS);                    /* one wrap */
+    g_assert_cmpuint(qtest_readb(qts, TC0 + T_CC0), ==, 0xFF);
+    g_assert_cmpuint(qtest_readb(qts, TC0 + T_CC1), ==, 0xFF);
+    qtest_quit(qts);
+}
+
+/* PPW: the period in CC0 and a restart on the rise, the width in CC1 */
+static void test_capture_ppw(void)
+{
+    QTestState *qts = capture_init(MODE_COUNT16 | DIV1024 | CAPTEN0 |
+                                   CAPTEN1, EVACT_PPW);
+
+    ext(qts, true);
+    qtest_clock_step(qts, 5 * TICK_NS);
+    ext(qts, false);
+    qtest_clock_step(qts, 7 * TICK_NS);
+    ext(qts, true);
+    g_assert_cmpuint(qtest_readw(qts, TC0 + T_CC0), ==, 0);
+    g_assert_cmpuint(qtest_readw(qts, TC0 + 0x1E), ==, 5);  /* CC1 */
+    qtest_clock_step(qts, 1000);
+    g_assert_cmpuint(qtest_readw(qts, TC0 + T_CC0), ==, 12);
+    qtest_quit(qts);
+}
+
+/* PW waits for the first active edge, captures at the inactive one, stops */
+static void test_capture_pw(void)
+{
+    QTestState *qts = capture_init(MODE_COUNT16 | DIV1024 | CAPTEN0,
+                                   EVACT_PW | TCINV);
+
+    ext(qts, true);                         /* inactive: nothing started */
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & MC0, ==, 0);
+    qtest_clock_step(qts, 2 * TICK_NS);
+    ext(qts, false);                        /* active: count from ZERO */
+    qtest_clock_step(qts, 9 * TICK_NS);
+    ext(qts, true);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & MC0, ==, MC0);
+    g_assert_cmpuint(qtest_readw(qts, TC0 + T_CC0), ==, 9);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_STATUS) & STOP, ==, STOP);
+    qtest_quit(qts);
+}
