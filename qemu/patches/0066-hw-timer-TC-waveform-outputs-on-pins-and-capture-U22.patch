+static void mchp_tc_next(MchpTcState *s, uint64_t *ovf,
+                         uint64_t match[MCHP_TC_CHANNELS])
+{
+    mchp_tc_next_all(s, ovf, match, false);
+}
+
+/* NFRQ and MFRQ toggle their outputs; NPWM and MPWM set and clear them */
+static bool mchp_tc_toggles(MchpTcState *s)
+{
+    unsigned w = mchp_tc_wavegen(s);
+
+    return w == MCHP_TC_COUNT16_WAVE_WAVEGEN_NFRQ ||
+           w == MCHP_TC_COUNT16_WAVE_WAVEGEN_MFRQ;
+}
+
+/*
+ * A wrap (@ovf) and matches (@match) on one tick: PWM sets the output at
+ * the wrap counting up (clears it counting down), a match clears it (sets
+ * it) and wins; a match toggles NFRQ and MFRQ
+ */
+static void mchp_tc_wo_step(MchpTcState *s, bool ovf,
+                            const bool match[MCHP_TC_CHANNELS])
+{
+    bool down = mchp_tc_down(s), toggles = mchp_tc_toggles(s);
+
+    for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+        bool o = extract32(s->wo, ch, 1);
+
+        if (ovf && !toggles) {
+            o = !down;
+        }
+        if (match[ch]) {
+            o = toggles ? !o : down;
+        }
+        s->wo = deposit32(s->wo, ch, 1, o);
+    }
+}
+
+/* The outputs at a start from s->count: the start acts as a wrap */
+static void mchp_tc_wo_start(MchpTcState *s)
+{
+    bool match[MCHP_TC_CHANNELS];
+
+    for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+        match[ch] = mchp_tc_cc(s, ch) == s->count;
+    }
+    if (mchp_tc_toggles(s)) {
+        s->wo = 0;
+    }
+    mchp_tc_wo_step(s, true, match);
+}
+
+/* A start at COUNT = CCx is a match: CC1 = 0 sets MC1 at once (silicon) */
+static void mchp_tc_start_flags(MchpTcState *s)
+{
+    uint32_t flags = 0, evctrl = mchp_tc_reg(s, A_EVCTRL, 2);
+
+    for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+        if (!mchp_tc_capture(s, ch) && mchp_tc_cc(s, ch) == s->count) {
+            flags |= R_MCHP_TC_COUNT16_INTFLAG_MC0_MASK << ch;
+            if (evctrl & (F(EVCTRL, MCEO0) << ch)) {
+                qemu_irq_pulse(s->mc_event[ch]);
+            }
+        }
+    }
+    mchp_tc_mod_reg(s, A_INTFLAG, 1, 0, flags);
+}
+
+/* PWM outputs from the count alone, after the counter jumped */
+static void mchp_tc_wo_resync(MchpTcState *s)
+{
+    if (mchp_tc_toggles(s)) {
+        return;
+    }
+    for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+        uint32_t cc = mchp_tc_cc(s, ch);
+
+        s->wo = deposit32(s->wo, ch, 1, mchp_tc_down(s) ? s->count <= cc :
+                                                          s->count < cc);
+    }
+}
+
+/* Drive the pads: low while stopped, floating (pull off) while disabled */
+static void mchp_tc_update_pads(MchpTcState *s)
+{
+    bool on = FIELD_EX32(mchp_tc_reg(s, A_CTRLA, 4), MCHP_TC_COUNT16_CTRLA,
+                         ENABLE);
+    uint32_t inv = mchp_tc_reg(s, A_DRVCTRL, 1);
+
+    uint32_t copen = extract32(mchp_tc_reg(s, A_CTRLA, 4),
+                               R_MCHP_TC_COUNT16_CTRLA_COPEN0_SHIFT, 2);
+
+    for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+        /* A capture pin (COPENx) is an input: not driven, pull off */
+        int level = !on || extract32(copen, ch, 1) ? MCHP_PORT_PAD_HIZ :
+                    !s->running ? 0 :
+                    (int)(extract32(s->wo, ch, 1) ^ extract32(inv, ch, 1));
+
+        if (level != s->pad_level[ch]) {
+            s->pad_level[ch] = level;
+            qemu_set_irq(s->pad_wo[ch], level);
+        }
+    }
+}
+
+/* Capture @v on channel @ch: CCx, else its buffer, else ERR */
+static void mchp_tc_capture_value(MchpTcState *s, unsigned ch, uint32_t v)
+{
+    uint32_t mc = R_MCHP_TC_COUNT16_INTFLAG_MC0_MASK << ch;
+    unsigned size = mchp_tc_size(s);
+
+    if (!(mchp_tc_reg(s, A_INTFLAG, 1) & mc) && !extract32(s->refill, ch, 1)) {
+        mchp_tc_set_reg(s, A_CC + ch * size, size, v);
+        mchp_tc_mod_reg(s, A_INTFLAG, 1, 0, mc);
+        if (mchp_tc_reg(s, A_EVCTRL, 2) & (F(EVCTRL, MCEO0) << ch)) {
+            qemu_irq_pulse(s->mc_event[ch]);
+        }
+    } else if (!extract32(s->cap_full, ch, 1)) {
+        s->cap_buf[ch] = v;
+        s->cap_full = deposit32(s->cap_full, ch, 1, 1);
+    } else {
+        mchp_tc_mod_reg(s, A_INTFLAG, 1, 0, F(INTFLAG, ERR));
+    }
+}
+
+/* Capture channels fed by the event input (CAPTENx, not COPENx) */
+static bool mchp_tc_event_capture(MchpTcState *s, unsigned ch)
+{
+    return mchp_tc_capture(s, ch) &&
+           !extract32(mchp_tc_reg(s, A_CTRLA, 4),
+                      R_MCHP_TC_COUNT16_CTRLA_COPEN0_SHIFT + ch, 1);
+}
+
