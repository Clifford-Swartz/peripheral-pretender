+static void test_wave_pad(void)
+{
+    QTestState *qts = tc_init(MODE_COUNT8 | DIV1024, 9);
+
+    qtest_writeb(qts, PA + P_PINCFG + WO0_PIN, 0x03);      /* PMUXEN, INEN */
+    qtest_writeb(qts, PA + P_PMUX + WO0_PIN / 2, 0x04);     /* E */
+    qtest_writeb(qts, TC0 + T_WAVE, NPWM);
+    qtest_writeb(qts, TC0 + T_CC0, 3);
+    g_assert_false(wo0(qts));                               /* floating */
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | DIV1024 | CTRLA_ENABLE);
+    g_assert_true(wo0(qts));
+    qtest_clock_step(qts, 3 * TICK_NS - TICK_NS / 2);
+    g_assert_true(wo0(qts));
+    qtest_clock_step(qts, TICK_NS);
+    g_assert_false(wo0(qts));                               /* CC0 */
+    qtest_clock_step(qts, 7 * TICK_NS);
+    g_assert_true(wo0(qts));                                /* the wrap */
+    qtest_writeb(qts, TC0 + T_CTRLBSET, CMD_STOP);
+    g_assert_false(wo0(qts));                               /* stopped */
+    qtest_quit(qts);
