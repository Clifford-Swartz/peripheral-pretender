From 26304c1d2211fd1362b938d807831cef568a17bf Mon Sep 17 00:00:00 2001
From: Clifford Swartz <cliffordswartz1@gmail.com>
Date: Thu, 15 Oct 2026 11:15:36 -0700
Subject: [PATCH 42/57] hw/adc: AVR8X ADC checked on AVR64EA48 silicon

An internal reference above VDD acts as VDD: on silicon at VDD 3.31 V
the 4.096 V reference converts VDD/10 to 409, as the VDD reference
does. The rest of firmware/avr-hello APP=adc matches the model:
references, 8-bit, LEFTADJ, burst accumulation, differential (+-VREF
over +-2048), RESRDY cleared by reading RESULT, the temperature formula.
The device descriptor carries the desk kit's SIGROW TEMPSENSE0/1 (the
profile's data rows), so the twin's temperature reading converts as the
kit's does.

Peripheral Pretender: AI-assisted; not for submission to upstream QEMU.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/adc/avr8x_adc.c        | 24 +++++++++++++++++++-----
 hw/avr/avr64ea48_device.h | 10 +++++++---
 2 files changed, 26 insertions(+), 8 deletions(-)

diff --git a/hw/adc/avr8x_adc.c b/hw/adc/avr8x_adc.c
index 8e1c955..e00a64f 100644
--- a/hw/adc/avr8x_adc.c
+++ b/hw/adc/avr8x_adc.c
@@ -25,7 +25,10 @@
  * (the code whose conversion with SIGROW.TEMPSENSE0/1, as the data sheet's
  * formula gives it, is "temperature" in millidegrees C; mid scale when
  * TEMPSENSE0 is 0), DAC0 (0 V: no DAC model). References: VDD, VREFA
- * ("vrefa"; VDD unless set), 1.024, 2.048, 2.500, 4.096 V.
+ * ("vrefa"; VDD unless set), 1.024, 2.048, 2.500, 4.096 V, an internal one
+ * above VDD acting as VDD. Checked on AVR64EA48 silicon (firmware/avr-hello
+ * APP=adc, VDD 3.31 V): references, 8-bit, LEFTADJ, burst accumulation,
+ * differential (+-VREF over +-2048), RESRDY, the temperature formula.
  *
  * Not modelled: the PGA (gain logged), events, chopping, the conversion
  * time, STATUS.ADCBUSY (always 0).
@@ -85,23 +88,34 @@ static void adc_flag(Avr8xAdcState *s, uint8_t mask)
             adc_reg(s, A_MCHP_ADC_INTFLAGS, 1) | mask);
 }
 
+/*
+ * The reference in mV. An internal one above VDD acts as VDD (silicon: the
+ * 4.096 V reference at VDD 3.3 V converts VDD/10 to 409, as VDD does)
+ */
 static int32_t adc_ref_mv(Avr8xAdcState *s)
 {
+    int32_t ref;
+
     switch (FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLC, 1), MCHP_ADC_CTRLC,
                        REFSEL)) {
     case MCHP_ADC_CTRLC_REFSEL_1V024:
-        return 1024;
+        ref = 1024;
+        break;
     case MCHP_ADC_CTRLC_REFSEL_2V048:
-        return 2048;
+        ref = 2048;
+        break;
     case MCHP_ADC_CTRLC_REFSEL_2V500:
-        return 2500;
+        ref = 2500;
+        break;
     case MCHP_ADC_CTRLC_REFSEL_4V096:
-        return 4096;
+        ref = 4096;
+        break;
     case MCHP_ADC_CTRLC_REFSEL_VREFA:
         return s->vrefa_mv >= 0 ? s->vrefa_mv : s->vdd_mv;
     default:
         return s->vdd_mv;
     }
+    return MIN(ref, s->vdd_mv);
 }
 
 /*
diff --git a/hw/avr/avr64ea48_device.h b/hw/avr/avr64ea48_device.h
index 4d1ba18..70a32d4 100644
--- a/hw/avr/avr64ea48_device.h
+++ b/hw/avr/avr64ea48_device.h
@@ -6,7 +6,7 @@
  *
  * GENERATED by generator/atdf2qemu.py from AVR64EA48.atdf
  * (AVR-Ex_DFP 2.8.189). Do not edit.
- * Profile: profiles/avr64ea48.yaml (sha1 884b235352bc)
+ * Profile: profiles/avr64ea48.yaml (sha1 1a409a76d26c)
  *
  * SPDX-License-Identifier: GPL-2.0-or-later
  */
@@ -22,8 +22,12 @@ static const MchpSiliconRev avr64ea48_revisions[] = {
 };
 
 /* Data-space bytes that are not erased (profiles/avr64ea48.yaml) */
+static const uint8_t avr64ea48_data_row0[] = {
+    0xCE, 0xFD, 0x7E, 0xEC,
+};
 static const MchpAvrDataRow avr64ea48_data_rows[] = {
-    { 0 },
+    /* SIGROW.TEMPSENSE0/1 of the desk EV66E56A */
+    { .addr = 0x1104, .bytes = avr64ea48_data_row0, .len = 4 },
 };
 
 static const MchpAvrDeviceInfo avr64ea48_device = {
@@ -48,7 +52,7 @@ static const MchpAvrDeviceInfo avr64ea48_device = {
     .revisions = avr64ea48_revisions,
     .nrevisions = ARRAY_SIZE(avr64ea48_revisions),
     .data_rows = avr64ea48_data_rows,
-    .ndata_rows = 0,
+    .ndata_rows = 1,
 };
 
 #endif /* HW_AVR_AVR64EA48_DEVICE_H */
