+ * while MC0 is high; WO1 goes on. Without EVCTRL.MCEI0 it does nothing
+ */
+static void test_fault_clamp(void)
+{
+    QTestState *qts = fault_init(0, FSRC, MCEI0, 0);
+
+    wave_tick(qts, 5);
+    g_assert_cmphex(wo(qts) & 0x13, ==, 0x13);
+    mc_event(qts, 0, 1);
+    g_assert_cmphex(wo(qts) & 0x13, ==, 0x02);
+    g_assert_cmphex(tcc_status(qts) & (FAULTAIN | FAULTA), ==,
+                    FAULTAIN | FAULTA);
+    g_assert_cmphex(flags(qts) & FAULTA, ==, FAULTA);
+    g_assert_cmphex(tcc_status(qts) & BIT(24), ==, BIT(24));   /* CMP0 */
+    wave_tick(qts, 10);
+    mc_event(qts, 0, 0);
+    g_assert_cmphex(wo(qts) & 0x13, ==, 0x13);
+    g_assert_cmphex(tcc_status(qts) & (FAULTAIN | FAULTA), ==, 0);
+    qtest_quit(qts);
+
+    qts = fault_init(0, FSRC, 0, 0);
+    wave_tick(qts, 5);
+    mc_event(qts, 0, 1);
+    g_assert_cmphex(wo(qts) & 0x13, ==, 0x13);
+    g_assert_cmphex(flags(qts) & FAULTA, ==, 0);
+    qtest_quit(qts);
+}
+
+/* KEEP: clamped (and STATUS.FAULTA set) to the start of the next cycle */
+static void test_fault_keep(void)
+{
+    QTestState *qts = fault_init(0, FSRC | FKEEP, MCEI0, 0);
+
+    wave_tick(qts, 5);
+    mc_event(qts, 0, 1);
+    wave_tick(qts, 10);
+    mc_event(qts, 0, 0);
+    g_assert_cmphex(wo(qts) & 1, ==, 0);
+    wave_tick(qts, 99);
+    g_assert_cmphex(tcc_status(qts) & FAULTA, ==, FAULTA);
+    wave_tick(qts, 102);                    /* CMP0 rose at 101 */
+    g_assert_cmphex(wo(qts) & 1, ==, 1);
+    g_assert_cmphex(tcc_status(qts) & FAULTA, ==, 0);
+    qtest_quit(qts);
+}
+
+/* QUAL: a fault while channel 0's waveform is low is ignored */
+static void test_fault_qual(void)
+{
+    QTestState *qts = fault_init(0, FSRC | FQUAL, MCEI0, 0);
+
+    wave_tick(qts, 30);                     /* WO0 low from 21 */
+    mc_event(qts, 0, 1);
+    g_assert_cmphex(tcc_status(qts) & (FAULTAIN | FAULTA), ==, 0);
+    g_assert_cmphex(flags(qts) & FAULTA, ==, 0);
+    wave_tick(qts, 105);                    /* high again: it acts */
+    g_assert_cmphex(tcc_status(qts) & FAULTA, ==, FAULTA);
+    g_assert_cmphex(wo(qts) & 1, ==, 0);
+    qtest_quit(qts);
+}
+
+/* RESTART: the counter restarts at the fault, without an output glitch */
+static void test_fault_restart(void)
+{
+    QTestState *qts = fault_init(0, FSRC | FRESTART, MCEI0, 0);
+
+    wave_tick(qts, 30);
+    mc_event(qts, 0, 1);
+    g_assert_cmpuint(readsync(qts), ==, 0);
+    g_assert_cmphex(flags(qts) & TRG, ==, TRG);
+    g_assert_cmphex(wo(qts) & 0x3, ==, 0x2);    /* WO1 (CC1 40) stays */
+    wave_tick(qts, 35);
+    mc_event(qts, 0, 0);
+    g_assert_cmpuint(readsync(qts), ==, 5);
+    g_assert_cmphex(wo(qts) & 0x3, ==, 0x3);
+    qtest_quit(qts);
+}
+
+/*
+ * HALT = HW holds the counter while the fault lasts; HALT = SW until
+ * software clears STATUS.FAULTA (after the fault)
+ */
+static void test_fault_halt(void)
+{
+    QTestState *qts = fault_init(0, FSRC | FHALT_HW, MCEI0, 0);
+
+    wave_tick(qts, 5);
+    mc_event(qts, 0, 1);
+    wave_tick(qts, 15);
+    mc_event(qts, 0, 0);
+    wave_tick(qts, 25);
+    g_assert_cmpuint(readsync(qts), ==, 15);
+    qtest_quit(qts);
+
+    qts = fault_init(0, FSRC | FHALT_SW, MCEI0, 0);
+    wave_tick(qts, 5);
+    mc_event(qts, 0, 1);
+    wave_tick(qts, 15);
+    mc_event(qts, 0, 0);
+    g_assert_cmphex(wo(qts) & 1, ==, 1);        /* released, held */
+    wave_tick(qts, 25);
+    g_assert_cmpuint(readsync(qts), ==, 5);
+    g_assert_cmphex(tcc_status(qts) & FAULTA, ==, FAULTA);
+    qtest_writel(qts, TCC0 + R_STATUS, FAULTA);
+    g_assert_cmphex(tcc_status(qts) & FAULTA, ==, 0);
+    wave_tick(qts, 35);
+    g_assert_cmpuint(readsync(qts), ==, 15);
+    qtest_quit(qts);
+}
+
+/*
+ * BLANK = RISE for 10 cycles ignores a fault just after WO0 rises;
+ * FILTERVAL 4 (and the synchronizer's 2 cycles) loses a 3-cycle pulse
+ * and delays a longer one
+ */
+static void test_fault_blank_filter(void)
+{
+    QTestState *qts = fault_init(0, FSRC | FBLANK_RISE | FBLANKVAL(10),
+                                 MCEI0, 0);
+
+    wave_tick(qts, 3);                      /* WO0 rose at 1 */
+    mc_event(qts, 0, 1);
+    wave_tick(qts, 6);
+    mc_event(qts, 0, 0);
+    g_assert_cmphex(flags(qts) & FAULTA, ==, 0);
+    qtest_quit(qts);
+
+    qts = fault_init(0, FSRC | FFILTERVAL(4), MCEI0, 0);
+    wave_tick(qts, 5);
+    mc_event(qts, 0, 1);
+    wave_tick(qts, 8);
+    mc_event(qts, 0, 0);
+    wave_tick(qts, 10);
+    g_assert_cmphex(flags(qts) & FAULTA, ==, 0);
+    mc_event(qts, 0, 1);
+    wave_tick(qts, 15);
+    g_assert_cmphex(wo(qts) & 1, ==, 1);
+    wave_tick(qts, 17);
+    g_assert_cmphex(wo(qts) & 1, ==, 0);
+    qtest_quit(qts);
+}
+
+/* CAPTURE = CAPT, CHSEL 2: COUNT into CC2, a CPTEN2 channel */
+static void test_fault_capture(void)
+{
+    QTestState *qts = fault_init(CPTEN(2), FSRC | FCAPT | FCHSEL(2),
+                                 MCEI0, 0);
+
+    wave_tick(qts, 12);
+    mc_event(qts, 0, 1);
+    g_assert_cmpuint(qtest_readl(qts, TCC0 + R_CC(2)), ==, 12);
+    g_assert_cmphex(flags(qts) & MC(2), ==, MC(2));
+    qtest_quit(qts);
+}
+
+/*
+ * EV0 with the FAULT action: the counter holds and the outputs take their
+ * non-recoverable state until STATUS.FAULT0 is cleared with EV0 gone
+ */
+static void test_fault_nonrecoverable(void)
+{
+    QTestState *qts = fault_init(0, 0, EVACT0_FAULT | TCEI0,
+                                 NRE(0) | NRV(0) | NRE(1));
+    uint64_t h0, l0, h1, l1;
+
+    wave_tick(qts, 10);
+    ev_event(qts, 0, 1);
+    g_assert_cmphex(wo(qts) & 0x3, ==, 0x1);
+    g_assert_cmphex(tcc_status(qts) & (FAULT0IN | FAULT0), ==,
+                    FAULT0IN | FAULT0);
+    g_assert_cmphex(flags(qts) & FAULT0, ==, FAULT0);
+    pa_stats(qts, 18, &h0, &l0);            /* WO2: no NRE2, floating */
+    wave_tick(qts, 20);
+    pa_stats(qts, 18, &h1, &l1);
+    g_assert_cmpuint(h1 - h0 + l1 - l0, ==, 0);
+    g_assert_cmpuint(readsync(qts), ==, 10);
+    qtest_writel(qts, TCC0 + R_STATUS, FAULT0);     /* EV0 still high */
+    g_assert_cmphex(tcc_status(qts) & FAULT0, ==, FAULT0);
+    ev_event(qts, 0, 0);
+    g_assert_cmphex(tcc_status(qts) & (FAULT0IN | FAULT0), ==, FAULT0);
+    qtest_writel(qts, TCC0 + R_STATUS, FAULT0);
+    g_assert_cmphex(tcc_status(qts) & FAULT0, ==, 0);
+    g_assert_cmphex(wo(qts) & 0xF, ==, 0xF);    /* the waveform, COUNT 10 */
+    wave_tick(qts, 30);
+    g_assert_cmpuint(readsync(qts), ==, 20);
+    qtest_quit(qts);
+}
