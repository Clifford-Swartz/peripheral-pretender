+    QEMUTimer *fault_timer;     /* a filter or blanking time ends */
+    uint8_t mc_level;           /* MCx event inputs */
+    uint8_t flt_in;             /* fault inputs after their filters */
+    int64_t flt_at[4];          /* the filters pass a change at, ns */
+    int64_t blank_until[2];     /* faults A, B blanked to, ns */
+    uint8_t rf_active;          /* recoverable faults acting */
+    uint8_t rf_keep;            /* clamping to the end of the cycle (KEEP) */
+    uint8_t rf_halt;            /* holding the counter (HALT HW or SW) */
+    uint8_t nr_fault;           /* non-recoverable: EV0, EV1, A, B (bits) */
+    bool halted;                /* a fault holds the counter */
+    uint8_t cmp_prev;           /* channels 0, 1 waveform after a tick */
+
     bool running;               /* counting (started, not stopped) */
     bool moved;                 /* ticked since the start */
     bool cnt_pending;           /* the start's CNT comes with the 1st tick */
@@ -293,7 +324,7 @@ static uint64_t tcc_hz(MchpTccState *s)
 /* The prescaled clock moves the counter (not events) */
 static bool tcc_clock_counts(MchpTccState *s)
 {
-    if (!s->running || !tcc_hz(s)) {
+    if (!s->running || s->halted || !tcc_hz(s)) {
         return false;
     }
     switch (tcc_evact(s, 0)) {
@@ -605,6 +636,8 @@ static uint32_t tcc_cnt_stop(MchpTccState *s)
 
 static uint32_t tcc_cmp(MchpTccState *s, int64_t now);
 static void tcc_update_wo(MchpTccState *s);
+static void tcc_fault_cycle(MchpTccState *s, int64_t t);
+static void tcc_fault_edges(MchpTccState *s, int64_t t);
 
 /* Silicon clears STATUS.CMPx this many GCLK_TCC cycles after a STOP */
 #define MCHP_TCC_STOP_CLEAR 8
@@ -701,6 +734,7 @@ static void tcc_tick(MchpTccState *s, int force_down)
         }
         s->dith_cycle++;
         tcc_refresh(s);
+        tcc_fault_cycle(s, s->t_base);
     }
     if (update && !(tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, LUPD))) {
         tcc_update_buffers(s);
@@ -708,6 +742,7 @@ static void tcc_tick(MchpTccState *s, int force_down)
     if (ovf && (tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, ONESHOT))) {
         tcc_stop(s, true);
     }
+    tcc_fault_edges(s, s->t_base);
     if (s->wo_active) {
         tcc_update_wo(s);
     }
@@ -800,7 +835,9 @@ static void tcc_update_wo(MchpTccState *s)
     uint8_t level = 0, hiz = 0xFF;
 
     if (tcc_enabled(s)) {
-        level = tcc_extend(s, tcc_cmp(s, now), now);
+        /* Recoverable faults clamp their channel ahead of the matrix */
+        level = tcc_extend(s, tcc_cmp(s, now) & ~(s->rf_active | s->rf_keep),
+                           now);
         hiz = 0;
         if (s->nr_state) {
             uint8_t nre = extract32(drv, 0, 8);
@@ -849,6 +886,7 @@ static bool tcc_quiet(MchpTccState *s)
     return (flags & want) == want && !s->cnt_pending && !s->wo_active &&
            s->wavegen != NFRQ && s->wavegen != MFRQ &&
            !tcc_dith_bits(s) && !(s->wavegen == NPWM && tcc_ramp(s)) &&
+           !tcc_reg(s, A_FCTRLA, 4) && !tcc_reg(s, A_FCTRLB, 4) &&
            !(tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, ONESHOT)) &&
            !(tcc_reg(s, A_STATUS, 4) & (F(STATUS, PERBUFV) | (0xF << 16))) &&
            !(ev & (F(EVCTRL, OVFEO) | (0xF << 24)));
@@ -927,7 +965,7 @@ static void tcc_start(MchpTccState *s)
         tcc_update_buffers(s);
     }
     s->running = true;
-    s->nr_state = false;
+    s->nr_state = s->nr_fault != 0;
     s->moved = false;
     s->down = s->dir;
     tcc_base_set(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
@@ -953,9 +991,9 @@ static void tcc_retrigger(MchpTccState *s)
         tcc_start(s);           /* resume from COUNT */
         return;
     }
+    /* The waveform goes on to the first tick (silicon: no glitch) */
     s->count = tcc_start_value(s);
     s->down = s->dir;
-    s->moved = false;
     tcc_base_set(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
     if (!(tcc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, LUPD))) {
         tcc_update_buffers(s);
@@ -1003,27 +1041,32 @@ static void tcc_report_unimp(MchpTccState *s)
 {
     MchpRegBlock *rb = MCHP_REGBLOCK(s);
     uint32_t ctrla = tcc_reg(s, A_CTRLA, 4);
-    static const struct {
-        hwaddr offset;
-        const char *name;
-    } unimp[] = {
-        { A_FCTRLA, "FCTRLA: faults" }, { A_FCTRLB, "FCTRLB: faults" },
-    };
-
-    for (unsigned i = 0; i < ARRAY_SIZE(unimp); i++) {
-        if (tcc_reg(s, unimp[i].offset, 4)) {
-            qemu_log_mask(LOG_UNIMP, "%s.%s not modelled\n", rb->name,
-                          unimp[i].name);
+    uint32_t mcei = extract32(tcc_reg(s, A_EVCTRL, 4),
+                              R_MCHP_TCC_EVCTRL_MCEI0_SHIFT, 4);
+    uint32_t fsrc = 0;
+    unsigned ev0 = tcc_evact(s, 0), ev1 = tcc_evact(s, 1);
+
+    for (unsigned n = 0; n < 2; n++) {
+        unsigned src = FIELD_EX32(tcc_reg(s, n ? A_FCTRLB : A_FCTRLA, 4),
+                                  MCHP_TCC_FCTRLA, SRC);
+
+        fsrc |= (src != 0) << n;
+        if (src == MCHP_TCC_FCTRLA_SRC_ALTFAULT) {
+            qemu_log_mask(LOG_UNIMP, "%s.FCTRL%c: ALTFAULT not modelled\n",
+                          rb->name, 'A' + n);
         }
     }
-    if (ctrla & 0x0F000000) {
-        qemu_log_mask(LOG_UNIMP, "%s.CTRLA: capture not modelled\n",
-                      rb->name);
+    /* A CPTENx channel taking the MCx event captures (fault inputs aside) */
+    if (extract32(ctrla, R_MCHP_TCC_CTRLA_CPTEN0_SHIFT, 4) & mcei & ~fsrc) {
+        qemu_log_mask(LOG_UNIMP, "%s.CTRLA: capture from events not "
+                      "modelled\n", rb->name);
     }
-    if (tcc_evact(s, 0) > MCHP_TCC_EVCTRL_EVACT0_COUNT ||
-        tcc_evact(s, 1) > MCHP_TCC_EVCTRL_EVACT1_DEC) {
-        qemu_log_mask(LOG_UNIMP, "%s.EVCTRL: capture and fault event "
-                      "actions not modelled\n", rb->name);
+    if ((ev0 > MCHP_TCC_EVCTRL_EVACT0_COUNT &&
+         ev0 != MCHP_TCC_EVCTRL_EVACT0_FAULT) ||
+        (ev1 > MCHP_TCC_EVCTRL_EVACT1_DEC &&
+         ev1 != MCHP_TCC_EVCTRL_EVACT1_FAULT)) {
+        qemu_log_mask(LOG_UNIMP, "%s.EVCTRL: capture event actions not "
+                      "modelled\n", rb->name);
     }
 }
 
@@ -1036,6 +1079,410 @@ static void tcc_update_busy(MchpTccState *s)
     }
 }
 
+/* -- Faults ------------------------------------------------------------- */
+
+#define MCHP_TCC_FAULT_INPUTS 4
+
+static uint32_t tcc_fctrl(MchpTccState *s, unsigned n)
+{
+    return tcc_reg(s, n ? A_FCTRLB : A_FCTRLA, 4);
+}
+
+/*
+ * Fault input @i before its filter: 0 and 1 the recoverable faults A and
+ * B (the MC0 and MC1 events), 2 and 3 the EV0 and EV1 FAULT actions
+ */
+static bool tcc_fault_raw(MchpTccState *s, unsigned i)
+{
+    if (!tcc_enabled(s)) {
+        return false;
+    }
+    if (i >= 2) {
+        unsigned n = i - 2;
+
+        return tcc_ev_enabled(s, n) && tcc_ev_active(s, n) &&
+               tcc_evact(s, n) == (n ? MCHP_TCC_EVCTRL_EVACT1_FAULT :
+                                       MCHP_TCC_EVCTRL_EVACT0_FAULT);
+    }
+    /* EVCTRL.MCEIx is needed as well as FCTRLx.SRC (silicon) */
+    if (!(tcc_reg(s, A_EVCTRL, 4) & (F(EVCTRL, MCEI0) << i))) {
+        return false;
+    }
+    switch (FIELD_EX32(tcc_fctrl(s, i), MCHP_TCC_FCTRLA, SRC)) {
+    case MCHP_TCC_FCTRLA_SRC_ENABLE:
+        return extract32(s->mc_level, i, 1);
+    case MCHP_TCC_FCTRLA_SRC_INVERT:
+        return !extract32(s->mc_level, i, 1);
+    }
+    return false;
+}
+
+/* Fault input @i's filter, in GCLK_TCC cycles */
+static unsigned tcc_fault_filter(MchpTccState *s, unsigned i)
+{
+    if (i < 2) {
+        return FIELD_EX32(tcc_fctrl(s, i), MCHP_TCC_FCTRLA, FILTERVAL);
+    }
+    return extract32(tcc_reg(s, A_DRVCTRL, 4),
+                     R_MCHP_TCC_DRVCTRL_FILTERVAL0_SHIFT + 4 * (i - 2), 4);
+}
+
+/* A filtered input is synchronized too: 2 more GCLK_TCC cycles (silicon) */
+#define MCHP_TCC_FILTER_SYNC 2
+
+/*
+ * The filters: an input passes a change once it has held for FILTERVAL
+ * (and the synchronizer's) GCLK_TCC cycles; a shorter pulse is lost
+ */
+static void tcc_fault_sample(MchpTccState *s, int64_t now)
+{
+    for (unsigned i = 0; i < MCHP_TCC_FAULT_INPUTS; i++) {
+        bool raw = tcc_fault_raw(s, i);
+        unsigned fv = tcc_fault_filter(s, i);
+
+        if (raw == extract32(s->flt_in, i, 1)) {
+            s->flt_at[i] = INT64_MAX;
+        } else if (!fv || !tcc_hz(s) || now >= s->flt_at[i]) {
+            s->flt_in = deposit32(s->flt_in, i, 1, raw);
+            s->flt_at[i] = INT64_MAX;
+        } else if (s->flt_at[i] == INT64_MAX) {
+            s->flt_at[i] = now + clock_ticks_to_ns(MCHP_REGBLOCK(s)->gclk,
+                                                   fv + MCHP_TCC_FILTER_SYNC);
+        }
+    }
+}
+
+/* Recoverable fault @n's blanking time, ns (0: none) */
+static int64_t tcc_blank_ns(MchpTccState *s, unsigned n)
+{
+    uint32_t f = tcc_fctrl(s, n);
+    uint64_t v = FIELD_EX32(f, MCHP_TCC_FCTRLA, BLANKVAL);
+
+    if (f & R_MCHP_TCC_FCTRLA_BLANKPRESC_MASK) {
+        v *= 64;
+    }
+    return v ? clock_ticks_to_ns(MCHP_REGBLOCK(s)->gclk, v) : 0;
+}
+
+/* Hold the counter while a halt or a non-recoverable fault says so */
+static void tcc_fault_hold(MchpTccState *s, int64_t t)
+{
+    bool hold = s->rf_halt || s->nr_fault;
+
+    if (hold == s->halted) {
+        return;
+    }
+    if (hold) {
+        tcc_jump(s, tcc_ticks(s, t));   /* the count at @t is kept */
+        s->halted = true;
+        timer_del(s->timer);
+    } else {
+        s->halted = false;
+        tcc_base_set(s, t);
+    }
+}
+
+/* Restart the counter at @t (RESTART) */
+static void tcc_fault_restart(MchpTccState *s, int64_t t)
+{
+    tcc_retrigger(s);
+    tcc_base_set(s, t);
+}
+
+/* CAPTURE: COUNT at @t into the CHSEL channel, if CTRLA.CPTENx (silicon) */
+static void tcc_fault_capture(MchpTccState *s, unsigned n, int64_t t)
+{
+    uint32_t f = tcc_fctrl(s, n);
+    unsigned ch = FIELD_EX32(f, MCHP_TCC_FCTRLA, CHSEL);
+    unsigned mode = FIELD_EX32(f, MCHP_TCC_FCTRLA, CAPTURE);
+    unsigned nch = MCHP_REGBLOCK(s)->info->channels ?: MCHP_TCC_CHANNELS;
+
+    if (mode == MCHP_TCC_FCTRLA_CAPTURE_DISABLE) {
+        return;
+    }
+    if (mode != MCHP_TCC_FCTRLA_CAPTURE_CAPT) {
+        qemu_log_mask(LOG_UNIMP, "%s.FCTRL%c: capture mode %u not "
+                      "modelled\n", MCHP_REGBLOCK(s)->name, 'A' + n, mode);
+        return;
+    }
+    if (ch < nch && (tcc_reg(s, A_CTRLA, 4) & (F(CTRLA, CPTEN0) << ch))) {
+        bool down;
+        uint32_t c = tcc_after(s, tcc_ticks(s, t), &down);
+
+        tcc_set_reg(s, A_CC + 4 * ch, 4, c << tcc_dith_bits(s));
+        tcc_refresh(s);
+        tcc_flag(s, F(INTFLAG, MC0) << ch);
+    }
+}
+
+/* Recoverable fault @n starts acting at @t */
+static void tcc_rf_assert(MchpTccState *s, unsigned n, int64_t t)
+{
+    uint32_t f = tcc_fctrl(s, n);
+
+    s->rf_active |= BIT(n);
+    tcc_mod_reg(s, A_STATUS, 4, 0, F(STATUS, FAULTA) << n);
+    tcc_flag(s, F(INTFLAG, FAULTA) << n);
+    tcc_fault_capture(s, n, t);
+    if (f & R_MCHP_TCC_FCTRLA_KEEP_MASK) {
+        s->rf_keep |= BIT(n);
+    }
+    switch (FIELD_EX32(f, MCHP_TCC_FCTRLA, HALT)) {
+    case MCHP_TCC_FCTRLA_HALT_NR:
+        s->nr_fault |= BIT(2 + n);
+        s->nr_state = true;
+        break;
+    case MCHP_TCC_FCTRLA_HALT_HW:
+    case MCHP_TCC_FCTRLA_HALT_SW:
+        s->rf_halt |= BIT(n);
+        break;
+    default:
+        /* Restarted at the fault (silicon), clamped while it lasts */
+        if (f & R_MCHP_TCC_FCTRLA_RESTART_MASK) {
+            tcc_fault_restart(s, t);
+        }
+        break;
+    }
+    tcc_fault_hold(s, t);
+}
+
+/* Recoverable fault @n stops acting at @t */
+static void tcc_rf_release(MchpTccState *s, unsigned n, int64_t t)
+{
+    uint32_t f = tcc_fctrl(s, n);
+    unsigned halt = FIELD_EX32(f, MCHP_TCC_FCTRLA, HALT);
+
+    s->rf_active &= ~BIT(n);
+    if (halt == MCHP_TCC_FCTRLA_HALT_HW) {
+        s->rf_halt &= ~BIT(n);
+        tcc_fault_hold(s, t);
+        /* With a halt the restart comes at the end (DS 34.6.3.5) */
+        if (f & R_MCHP_TCC_FCTRLA_RESTART_MASK) {
+            tcc_fault_restart(s, t);
+        }
+    }
+    /* KEEP keeps STATUS.FAULTx to the cycle end, SW and NR to software */
+    if (!(s->rf_keep & BIT(n)) && halt != MCHP_TCC_FCTRLA_HALT_SW &&
+        halt != MCHP_TCC_FCTRLA_HALT_NR) {
+        tcc_mod_reg(s, A_STATUS, 4, F(STATUS, FAULTA) << n, 0);
+    }
+}
+
+/* Apply the filtered fault inputs at @t */
+static void tcc_faults(MchpTccState *s, int64_t t)
+{
+    uint32_t cmp = tcc_cmp(s, t), in = 0;
+    unsigned ramp = s->wavegen == NPWM ? tcc_ramp(s) : RAMP1;
+
+    for (unsigned n = 0; n < 2; n++) {
+        uint32_t f = tcc_fctrl(s, n);
+        bool on = extract32(s->flt_in, n, 1);
+        bool active = s->rf_active & BIT(n);
+
+        /* QUAL: not while the channel's waveform is low (silicon) */
+        if ((f & R_MCHP_TCC_FCTRLA_QUAL_MASK) && !extract32(cmp, n, 1)) {
+            on = false;
+        }
+        /* RAMP2: fault A in cycle A only, B in cycle B (DS 34.6.3.5) */
+        if (ramp != RAMP1 && s->ramp_idx != n) {
+            on = false;
+        }
+        if (on) {
+            in |= F(STATUS, FAULTAIN) << n;
+        }
+        if (on && !active && t >= s->blank_until[n]) {
+            tcc_rf_assert(s, n, t);
+        } else if (!on && active) {
+            tcc_rf_release(s, n, t);
+        }
+    }
+    for (unsigned n = 0; n < 2; n++) {
+        if (!extract32(s->flt_in, 2 + n, 1)) {
+            continue;
+        }
