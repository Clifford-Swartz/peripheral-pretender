+/*
+ * After a tick at @t: blanking from the waveform edges of channels 0 and
+ * 1, and the faults again (QUAL follows the waveform)
+ */
+static void tcc_fault_edges(MchpTccState *s, int64_t t)
+{
+    uint8_t cmp, edge[4];
+
+    if (!tcc_reg(s, A_FCTRLA, 4) && !tcc_reg(s, A_FCTRLB, 4)) {
+        return;
+    }
+    cmp = tcc_cmp(s, t) & 3;
+    edge[MCHP_TCC_FCTRLA_BLANK_START] = 0;
+    edge[MCHP_TCC_FCTRLA_BLANK_RISE] = cmp & ~s->cmp_prev;
+    edge[MCHP_TCC_FCTRLA_BLANK_FALL] = ~cmp & s->cmp_prev;
+    edge[MCHP_TCC_FCTRLA_BLANK_BOTH] = cmp ^ s->cmp_prev;
+    s->cmp_prev = cmp;
+    for (unsigned n = 0; n < 2; n++) {
+        unsigned b = FIELD_EX32(tcc_fctrl(s, n), MCHP_TCC_FCTRLA, BLANK);
+
+        if ((edge[b] & BIT(n)) && tcc_blank_ns(s, n)) {
+            s->blank_until[n] = t + tcc_blank_ns(s, n);
+        }
+    }
+    tcc_faults(s, t);
+    tcc_fault_arm(s, t);
