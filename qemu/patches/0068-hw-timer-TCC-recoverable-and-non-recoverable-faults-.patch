+/* The fault timer: the next filter or blanking time to end */
+static void tcc_fault_arm(MchpTccState *s, int64_t now)
+{
+    int64_t next = INT64_MAX;
+
+    for (unsigned i = 0; i < MCHP_TCC_FAULT_INPUTS; i++) {
+        next = MIN(next, s->flt_at[i]);
+    }
+    for (unsigned n = 0; n < 2; n++) {
+        if (extract32(s->flt_in, n, 1) && !(s->rf_active & BIT(n)) &&
+            now < s->blank_until[n]) {
+            next = MIN(next, s->blank_until[n]);
+        }
+    }
+    if (next == INT64_MAX) {
+        timer_del(s->fault_timer);
+    } else {
+        timer_mod(s->fault_timer, next);
