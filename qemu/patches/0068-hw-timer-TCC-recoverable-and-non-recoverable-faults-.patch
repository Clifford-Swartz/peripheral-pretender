+/*
+ * Software cleared STATUS.FAULTx: a software halt or a non-recoverable
+ * fault ends if its input is gone (else the bit stays set)
+ */
+static void tcc_fault_cleared(MchpTccState *s, int64_t t)
+{
+    uint32_t st = tcc_reg(s, A_STATUS, 4);
+
+    for (unsigned n = 0; n < 2; n++) {
+        uint32_t bit = F(STATUS, FAULTA) << n;
+
+        if (st & bit || !(s->rf_halt & BIT(n) || s->nr_fault & BIT(2 + n) ||
+                          s->rf_active & BIT(n))) {
+            continue;
+        }
+        if (s->rf_active & BIT(n)) {
+            tcc_mod_reg(s, A_STATUS, 4, 0, bit);
+            continue;
+        }
+        if (s->rf_halt & BIT(n)) {
+            s->rf_halt &= ~BIT(n);
+            if (tcc_fctrl(s, n) & R_MCHP_TCC_FCTRLA_RESTART_MASK) {
+                tcc_fault_hold(s, t);
+                tcc_fault_restart(s, t);
