+/* A new cycle at @t: KEEP lets go of faults gone; BLANK = START blanks */
+static void tcc_fault_cycle(MchpTccState *s, int64_t t)
+{
+    for (unsigned n = 0; n < 2; n++) {
+        uint32_t f = tcc_fctrl(s, n);
+        unsigned halt = FIELD_EX32(f, MCHP_TCC_FCTRLA, HALT);
+
+        if ((s->rf_keep & BIT(n)) && !(s->rf_active & BIT(n))) {
+            s->rf_keep &= ~BIT(n);
+            if (halt != MCHP_TCC_FCTRLA_HALT_SW &&
+                halt != MCHP_TCC_FCTRLA_HALT_NR) {
+                tcc_mod_reg(s, A_STATUS, 4, F(STATUS, FAULTA) << n, 0);
+            }
+        }
+        if (FIELD_EX32(f, MCHP_TCC_FCTRLA, BLANK) ==
+            MCHP_TCC_FCTRLA_BLANK_START && tcc_blank_ns(s, n)) {
+            s->blank_until[n] = t + tcc_blank_ns(s, n);
+        }
