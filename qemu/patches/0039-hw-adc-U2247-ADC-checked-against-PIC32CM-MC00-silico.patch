From 363d625c8bf4c4eb2fbd9129424cdf99bab51410 Mon Sep 17 00:00:00 2001
From: Clifford Swartz <cliffordswartz1@gmail.com>
Date: Thu, 15 Oct 2026 06:31:43 -0700
Subject: [PATCH 39/39] hw/adc: U2247 ADC checked against PIC32CM MC00 silicon

INTREF is the SUPC's VREF (VREF.SEL: 1.024 V at reset, 2.048, 4.096 V),
and reaches the ADC input only with VREF.VREFOE set: without it a
conversion of INTREF never completes (SWTRIG.START stays set, no
RESRDY). INTVCC0 is VDDANA / 1.6, as the DFP says (the data sheet's
characteristics table gives 1 / 1.48). REFCTRL ignores writes while the
ADC is enabled (overlay: enable-protected; regenerated tables). Checked
with firmware/hello APP=adc on an MC00 Curiosity Pro running at 5 V.

Peripheral Pretender: AI-assisted; not for submission to upstream QEMU.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/adc/mchp_adc_u2247.c                       | 73 +++++++++++++++----
 include/hw/mchp/gen/adc_u2247.h               |  2 +-
 .../mchp/gen/pic32cm1216mc00048/adc_u2247.h   |  5 +-
 .../mchp/gen/pic32cm5164jh01100/adc_u2247.h   |  5 +-
 4 files changed, 66 insertions(+), 19 deletions(-)

diff --git a/hw/adc/mchp_adc_u2247.c b/hw/adc/mchp_adc_u2247.c
index 6928064..8df645d 100644
--- a/hw/adc/mchp_adc_u2247.c
+++ b/hw/adc/mchp_adc_u2247.c
@@ -19,12 +19,19 @@
  * - AIN0..AIN11: the "ain" property ("channel=millivolts,..."; the board
  *   sets the pins' voltages; unset inputs read "ain-default", 0 mV); in
  *   differential mode MUXNEG is an AIN or GND;
- * - INTREF: 1.0 V; SCALEDVDDCORE: 1.2 V / 4; SCALEDVDDANA: VDDANA / 4.
+ * - INTREF: the SUPC's VREF (VREF.SEL: 1.024, 2.048 or 4.096 V); it only
+ *   reaches the input with VREF.VREFOE set, and without it a conversion
+ *   of INTREF never completes (SWTRIG.START stays set, no RESRDY);
+ * - SCALEDVDDCORE: 1.2 V / 4; SCALEDVDDANA: VDDANA / 4.
  *
- * References (the data sheet's ADC characteristics): INTREF 1.0 V,
- * INTVCC0 = VDDANA / 1.48, INTVCC1 = VDDANA / 2, INTVCC2 = VDDANA,
- * VREFA = "vrefa" (a pin; VDDANA unless the board sets it), DAC as
- * VDDANA. "vdd" is VDDANA in millivolts. Not modelled: sequencing
+ * References: INTREF (VREF, as above, without VREFOE), INTVCC0 = VDDANA /
+ * 1.6, INTVCC1 = VDDANA / 2, INTVCC2 = VDDANA, VREFA = "vrefa" (a pin;
+ * VDDANA unless the board sets it), DAC as VDDANA. "vdd" is VDDANA in
+ * millivolts. Checked on PIC32CM MC00 silicon (APP=adc, a board at 5 V):
+ * INTREF 1.024 V, INTVCC0 VDDANA / 1.6 (the data sheet's table says
+ * 1 / 1.48; the DFP and silicon say 1 / 1.6), VDDCORE 1.2 V, the INTREF
+ * stall without VREFOE, and REFCTRL ignoring writes while enabled (the
+ * overlay makes it enable-protected). Not modelled: sequencing
  * (SEQCTRL, logged), the master/slave pair (CTRLA.SLAVEEN), event inputs,
  * the conversion time.
  *
@@ -36,13 +43,17 @@
 #include "qapi/visitor.h"
 #include "qemu/log.h"
 #include "hw/adc/mchp_adc.h"
+#include "hw/misc/mchp_sysctrl.h"
 #include "hw/mchp/gen/adc_u2247.h"
 #include "migration/vmstate.h"
 
 #define ADC_NAIN            12
-#define INTREF_MV           1000
 #define CORE_MV             1200
 #define MUXNEG_GND          0x18
+/* SUPC VREF (hw/mchp/gen/supc_u2117.h): VREFOE bit 2, SEL bits 16-19 */
+#define SUPC_VREF_OFFSET    0x1C
+#define SUPC_VREF_VREFOE    (1U << 2)
+#define SUPC_VREF_SEL(v)    extract32(v, 16, 4)
 
 OBJECT_DECLARE_SIMPLE_TYPE(MchpAdcU2247State, MCHP_ADC_U2247)
 
@@ -54,6 +65,7 @@ struct MchpAdcU2247State {
     int32_t vdd_mv;
     int32_t vrefa_mv;           /* < 0: VDDANA */
     bool unread;                /* a result not read yet */
+    MchpRegBlock *supc;         /* the SUPC, for VREF (found on first use) */
 };
 
 static uint32_t adc_reg(MchpAdcU2247State *s, hwaddr off, unsigned size)
@@ -73,11 +85,35 @@ static void adc_flag(MchpAdcU2247State *s, uint8_t mask)
             mask);
 }
 
+/* The SUPC's VREF register (0 when there is no SUPC: VREF at reset) */
+static uint32_t adc_supc_vref(MchpAdcU2247State *s)
+{
+    if (!s->supc) {
+        Object *o = object_resolve_path_type("", TYPE_MCHP_SUPC, NULL);
+
+        s->supc = o ? MCHP_REGBLOCK(o) : NULL;
+    }
+    return s->supc ? mchp_regfile_peek(&s->supc->rf, SUPC_VREF_OFFSET, 4) : 0;
+}
+
+/* INTREF: VREF.SEL's level (1.024 V at reset) */
+static int32_t adc_intref_mv(MchpAdcU2247State *s)
+{
+    switch (SUPC_VREF_SEL(adc_supc_vref(s))) {
+    case 2:
+        return 2048;
+    case 3:
+        return 4096;
+    default:
+        return 1024;
+    }
+}
+
 static int32_t adc_input_mv(MchpAdcU2247State *s, unsigned mux)
 {
     switch (mux) {
     case MCHP_ADC_INPUTCTRL_MUXPOS_INTREF:
-        return INTREF_MV;
+        return adc_intref_mv(s);
     case MCHP_ADC_INPUTCTRL_MUXPOS_SCALEDVDDCORE:
         return CORE_MV / 4;
     case MCHP_ADC_INPUTCTRL_MUXPOS_SCALEDVDDANA:
@@ -98,9 +134,9 @@ static int64_t adc_ref_uv(MchpAdcU2247State *s)
     switch (FIELD_EX32(adc_reg(s, A_MCHP_ADC_REFCTRL, 1), MCHP_ADC_REFCTRL,
                        REFSEL)) {
     case MCHP_ADC_REFCTRL_REFSEL_INTREF:
-        return INTREF_MV * 1000LL;
+        return adc_intref_mv(s) * 1000LL;
     case MCHP_ADC_REFCTRL_REFSEL_INTVCC0:
-        return vdd * 100 / 148;
+        return vdd * 10 / 16;
     case MCHP_ADC_REFCTRL_REFSEL_INTVCC1:
         return vdd / 2;
     case MCHP_ADC_REFCTRL_REFSEL_VREFA:
@@ -144,7 +180,8 @@ static void adc_window(MchpAdcU2247State *s, int32_t code, bool diff)
     }
 }
 
-static void adc_convert(MchpAdcU2247State *s)
+/* Convert; false when the conversion cannot complete (see INTREF) */
+static bool adc_convert(MchpAdcU2247State *s)
 {
     MchpRegBlock *rb = MCHP_REGBLOCK(s);
     uint32_t in = adc_reg(s, A_MCHP_ADC_INPUTCTRL, 2);
@@ -162,7 +199,12 @@ static void adc_convert(MchpAdcU2247State *s)
 
     if (!FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLA, 1), MCHP_ADC_CTRLA,
                     ENABLE)) {
-        return;
+        return true;
+    }
+    if (FIELD_EX32(in, MCHP_ADC_INPUTCTRL, MUXPOS) ==
+        MCHP_ADC_INPUTCTRL_MUXPOS_INTREF &&
+        !(adc_supc_vref(s) & SUPC_VREF_VREFOE)) {
+        return false;           /* INTREF is not routed to the input */
     }
     if (adc_reg(s, A_MCHP_ADC_SEQCTRL, 4)) {
         qemu_log_mask(LOG_UNIMP, "%s: sequencing not modelled\n", rb->name);
@@ -199,6 +241,7 @@ static void adc_convert(MchpAdcU2247State *s)
     adc_flag(s, R_MCHP_ADC_INTFLAG_RESRDY_MASK);
     s->unread = true;
     mchp_regblock_update_irq(rb);
+    return true;
 }
 
 static uint32_t adc_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
@@ -229,10 +272,12 @@ static void adc_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
         if (written & we & R_MCHP_ADC_SWTRIG_FLUSH_MASK) {
             s->unread = false;
         }
-        if (written & we & R_MCHP_ADC_SWTRIG_START_MASK) {
-            adc_convert(s);
-        }
         adc_set(s, A_MCHP_ADC_SWTRIG, 1, 0);
+        if ((written & we & R_MCHP_ADC_SWTRIG_START_MASK) &&
+            !adc_convert(s)) {
+            /* Never starts: START stays set (silicon) */
+            adc_set(s, A_MCHP_ADC_SWTRIG, 1, R_MCHP_ADC_SWTRIG_START_MASK);
+        }
     } else if (ri->offset == A_MCHP_ADC_CTRLC &&
                FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLC, 2), MCHP_ADC_CTRLC,
                           FREERUN)) {
