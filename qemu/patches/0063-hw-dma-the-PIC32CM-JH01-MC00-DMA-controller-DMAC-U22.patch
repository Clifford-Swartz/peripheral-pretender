diff --git a/hw/dma/mchp_dmac_u2223.c b/hw/dma/mchp_dmac_u2223.c
new file mode 100644
index 0000000..50a2d9f
--- /dev/null
+++ b/hw/dma/mchp_dmac_u2223.c
@@ -0,0 +1,1114 @@
+/*
+ * Microchip PIC32CM JH01/MC00 DMA controller (DMAC U2223)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Twelve channels behind one register window (CHID selects the channel
+ * seen at 0x40-0x4F), one NVIC line, the descriptor format of the SAM D5x
+ * DMAC (mchp_dmac.c) and a CRC engine. What the PIC32CM MC00 (rev A1,
+ * firmware/hello APP=dmacprobe) showed, and the model does:
+ *
+ *   - Enabling a channel fetches its first descriptor (BASEADDR + 16 * n)
+ *     into the write-back memory (WRBADDR + 16 * n) at once (silicon: a
+ *     load right after the write sees it, all but the very next one). An
+ *     invalid one raises
+ *     TERR and SUSP, sets CHSTATUS.FERR and leaves the channel enabled and
+ *     suspended; the write-back memory is not written.
+ *   - A trigger (peripheral, software, event) makes one request pending;
+ *     more while one is pending are lost. A grant runs the trigger action:
+ *     one beat (BEAT), a block (BLOCK) or every block (TRANSACTION); BUSY
+ *     reads 1 meanwhile. The arbiter grants a beat at a time: the highest
+ *     enabled level (CTRL.LVLENx) wins, within a level the lowest channel
+ *     or, with PRICTRL.RRLVLENx, the next one after LVLPRIx, the channel
+ *     granted last (round robin, beat by beat); requests of disabled
+ *     levels stay pending.
+ *   - The write-back copy is updated at the end of a block (VALID cleared,
+ *     BTCNT 0), and with the remaining BTCNT when the channel loses the
+ *     arbiter, is suspended, disabled or hits a bus error; not every beat.
+ *   - At the end of a block BLOCKACT INT raises TCMPL; the end of the last
+ *     block (DESCADDR 0) raises TCMPL whatever BLOCKACT says and disables
+ *     the channel, unless BLOCKACT suspends: then the channel suspends
+ *     (BUSY stays 1 in a transaction) and a RESUME fetches DESCADDR 0, an
+ *     invalid descriptor. A RESUME of a channel not suspended skips its
+ *     next suspend. RESUME (command or event) does not clear SUSP; it
+ *     clears FERR and fetches the descriptor that failed again.
+ *   - SWTRIGx on a disabled channel stays set and fires when it is
+ *     enabled; on an enabled one it becomes the pending request and reads
+ *     0, or stays set as a second request while one is pending.
+ *   - BTCNT 0 is 65536 beats. A bus error raises TERR and disables the
+ *     channel, BTCNT not decremented.
+ *   - Clearing CTRL.DMAENABLE stops the channels; their ENABLE stays set.
+ *     CTRL.SWRST (only with DMAENABLE and CRCENABLE clear) resets all but
+ *     DBGCTRL. BASEADDR/WRBADDR ignore writes while DMAENABLE is set,
+ *     CRCCTRL/CRCCHKSUM while CRCENABLE is, CHCTRLB all but LVL and CMD
+ *     while the channel is enabled; CHCTRLA.SWRST is ignored while enabled.
+ *   - CHID 12-15 read channels 8-11 and ignore writes.
+ *   - INTPEND.ID is the lowest channel with an enabled flag set (0 and no
+ *     flags if none); writing its flags clears them in channel ID.
+ *     ACTIVE holds the last granted channel, its BTCNT, and ABUSY while
+ *     that channel is inside a block.
+ *   - CRC-16 is CCITT (0x1021, MSB first), CRC-32 the IEEE one (reflected,
+ *     read when idle reversed and complemented; while busy CRCCHKSUM reads
+ *     the register bit-reversed). Halfword and word beats go in LSB first.
+ *     I/O mode (CRCSRC 1): each CRCDATAIN write sets CRCBUSY, which
+ *     firmware clears by writing 1; CRCENABLE cannot be cleared meanwhile.
+ *     Channel mode (CRCSRC 0x20 + n): every beat of channel n goes in,
+ *     CRCBUSY reads 1 while the channel is enabled.
+ *   - Event outputs (EVOE, channels 0-3): BTCTRL.EVOSEL BLOCK pulses after
+ *     each block, BEAT after each beat. Event inputs (EVIE): TRIG, SUSPEND,
+ *     SSKIP, and RESUME, which silicon took only while the channel had a
+ *     request pending from its peripheral trigger (five cases fit this;
+ *     with no request or a software one it did nothing).
+ *
+ * Transfers run as in mchp_dmac.c: at the next read of a DMAC register
+ * or 20 us after the write that started them. Not modelled: beat timing,
+ * CTRIG and CBLOCK events, QOSCTRL, ACTIVE.LVLEX, standby.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/dma/mchp_dmac.h"
+#include "hw/mchp/gen/dmac_u2223.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+#include "system/dma.h"
+
+#define NCH                 12
+#define NEV                 4           /* channels with events */
+#define START_NS            20000
+#define POLL_NS             100000
+#define BUDGET              (65536 * 2)
+
+#define CHCTRLA_MASK        0x43
+#define CHCTRLB_MASK        0x00C03F7Fu
+#define CHCTRLB_LVL         0x00000060u
+#define FLAG_TERR           0x01
+#define FLAG_TCMPL          0x02
+#define FLAG_SUSP           0x04
+#define ST_PEND             0x01
+#define ST_BUSY             0x02
+#define ST_FERR             0x04
+
+/* Descriptor BTCTRL */
+#define BT_VALID            BIT(0)
+#define BT_EVOSEL(v)        extract32(v, 1, 2)
+#define BT_BLOCKACT(v)      extract32(v, 3, 2)
+#define BT_BEATSIZE(v)      extract32(v, 8, 2)
+#define BT_SRCINC           BIT(10)
+#define BT_DSTINC           BIT(11)
+#define BT_STEPSRC          BIT(12)
+#define BT_STEPSIZE(v)      extract32(v, 13, 3)
+
+#define TRIGACT_BLOCK       0
+#define TRIGACT_BEAT        2
+#define TRIGACT_TRANSACTION 3
+
+#define CRCSRC_IO           1
+#define CRCSRC_CH0          0x20
+
+typedef struct DmacTrigger {
+    hwaddr flag_addr;
+    uint8_t mask;
+} DmacTrigger;
+
+typedef struct DmacDesc {
+    uint16_t btctrl;
+    uint16_t btcnt;
+    uint32_t srcaddr;
+    uint32_t dstaddr;
+    uint32_t descaddr;
+} DmacDesc;
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpDmacU2223State, MCHP_DMAC_U2223)
+
+struct MchpDmacU2223State {
+    MchpRegBlock parent_obj;
+
+    QEMUTimer *timer;
+    DmacTrigger trig[MCHP_DMAC_MAX_TRIGGERS];
+
+    uint8_t chctrla[NCH];
+    uint32_t chctrlb[NCH];
+    uint8_t inten[NCH];
+    uint8_t flag[NCH];
+    DmacDesc cur[NCH];          /* the descriptor a channel works on */
+    uint32_t total[NCH];        /* beats of its block */
+    uint32_t left[NCH];         /* beats still to move */
+    bool fetched[NCH];
+    bool pend[NCH];             /* a request is pending */
+    bool pend_hw[NCH];          /* ... from the peripheral trigger */
+    bool action[NCH];           /* a trigger action runs (BUSY) */
+    bool susp[NCH];
+    bool ferr[NCH];
+    bool refetch[NCH];          /* RESUME fetches refetch_addr */
+    uint32_t refetch_addr[NCH];
+    bool skip[NCH];             /* skip the next suspend */
+    bool inside[NCH];           /* beats moved in this block */
+    uint32_t swtrig;
+    int32_t last;               /* ACTIVE.ID; -1: none yet */
+    bool abusy;
+    uint16_t active_btcnt;      /* ACTIVE.BTCNT: after the last beat */
+    uint32_t crc;               /* CRC-32: reflected; CRC-16: plain */
+    bool crc_busy;              /* I/O mode */
+    bool crc_fed;               /* data went in since CRCENABLE */
+    bool ev_level[NEV];
+
+    uint8_t wanted[MCHP_DMAC_MAX_TRIGGERS];
+    qemu_irq trig_wanted[MCHP_DMAC_MAX_TRIGGERS];
+    qemu_irq ch_event[NEV];
+};
+
+static uint32_t reg(MchpDmacU2223State *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static void set_reg(MchpDmacU2223State *s, hwaddr off, unsigned size,
+                    uint32_t v)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, off, size, v);
+}
+
+static bool dma_on(MchpDmacU2223State *s)
+{
+    return reg(s, A_MCHP_DMAC_CTRL, 2) & R_MCHP_DMAC_CTRL_DMAENABLE_MASK;
+}
+
+static bool ch_on(MchpDmacU2223State *s, unsigned ch)
+{
+    return s->chctrla[ch] & R_MCHP_DMAC_CHCTRLA_ENABLE_MASK;
+}
+
+static unsigned ch_trigact(MchpDmacU2223State *s, unsigned ch)
+{
+    return FIELD_EX32(s->chctrlb[ch], MCHP_DMAC_CHCTRLB, TRIGACT);
+}
+
+static unsigned ch_trigsrc(MchpDmacU2223State *s, unsigned ch)
+{
+    return FIELD_EX32(s->chctrlb[ch], MCHP_DMAC_CHCTRLB, TRIGSRC);
+}
+
+static hwaddr wb_addr(MchpDmacU2223State *s, unsigned ch)
+{
+    return reg(s, A_MCHP_DMAC_WRBADDR, 4) + 16 * ch;
+}
+
+static void desc_load(hwaddr addr, DmacDesc *d)
+{
+    uint8_t b[16];
+
+    dma_memory_read(&address_space_memory, addr, b, sizeof(b),
+                    MEMTXATTRS_UNSPECIFIED);
+    d->btctrl = lduw_le_p(&b[0]);
+    d->btcnt = lduw_le_p(&b[2]);
+    d->srcaddr = ldl_le_p(&b[4]);
+    d->dstaddr = ldl_le_p(&b[8]);
+    d->descaddr = ldl_le_p(&b[12]);
+}
+
+static void desc_store(hwaddr addr, const DmacDesc *d)
+{
+    uint8_t b[16];
+
+    stw_le_p(&b[0], d->btctrl);
+    stw_le_p(&b[2], d->btcnt);
+    stl_le_p(&b[4], d->srcaddr);
+    stl_le_p(&b[8], d->dstaddr);
+    stl_le_p(&b[12], d->descaddr);
+    dma_memory_write(&address_space_memory, addr, b, sizeof(b),
+                     MEMTXATTRS_UNSPECIFIED);
+}
+
+/* The remaining BTCNT into the write-back copy */
+static void write_back(MchpDmacU2223State *s, unsigned ch)
+{
+    if (s->fetched[ch]) {
+        s->cur[ch].btcnt = s->left[ch];
+        desc_store(wb_addr(s, ch), &s->cur[ch]);
+    }
+}
+
+/* ---- CRC ---- */
+
+static bool crc32_poly(MchpDmacU2223State *s)
+{
+    return FIELD_EX32(reg(s, A_MCHP_DMAC_CRCCTRL, 2), MCHP_DMAC_CRCCTRL,
+                      CRCPOLY) == 1;
+}
+
+static unsigned crc_src(MchpDmacU2223State *s)
+{
+    return FIELD_EX32(reg(s, A_MCHP_DMAC_CRCCTRL, 2), MCHP_DMAC_CRCCTRL,
+                      CRCSRC);
+}
+
+static bool crc_on(MchpDmacU2223State *s)
+{
+    return reg(s, A_MCHP_DMAC_CTRL, 2) & R_MCHP_DMAC_CTRL_CRCENABLE_MASK;
+}
+
+static void crc_feed(MchpDmacU2223State *s, uint32_t data, unsigned bytes)
+{
+    s->crc_fed = true;
+    for (unsigned i = 0; i < bytes; i++) {
+        uint8_t b = data >> (8 * i);
+
+        if (crc32_poly(s)) {
+            s->crc ^= b;
+            for (unsigned k = 0; k < 8; k++) {
+                s->crc = (s->crc >> 1) ^ (s->crc & 1 ? 0xEDB88320u : 0);
+            }
+        } else {
+            s->crc ^= (uint32_t)b << 8;
+            for (unsigned k = 0; k < 8; k++) {
+                s->crc = (s->crc << 1) ^ (s->crc & 0x8000 ? 0x1021 : 0);
+            }
+            s->crc &= 0xFFFF;
+        }
+    }
+}
+
+static bool crc_busy(MchpDmacU2223State *s)
+{
+    unsigned src = crc_src(s);
+
+    if (!crc_on(s)) {
+        return false;
+    }
+    if (src >= CRCSRC_CH0 && src < CRCSRC_CH0 + NCH) {
+        return ch_on(s, src - CRCSRC_CH0);
+    }
+    return s->crc_busy;
+}
+
+/* CRCCHKSUM as firmware reads it */
+static uint32_t crc_read(MchpDmacU2223State *s)
+{
+    if (!crc32_poly(s)) {
+        return s->crc & 0xFFFF;
+    }
+    return crc_busy(s) ? revbit32(s->crc) : ~s->crc;
+}
+
+/* ---- channels ---- */
+
+static void ch_flag(MchpDmacU2223State *s, unsigned ch, uint8_t f)
+{
+    s->flag[ch] |= f;
+}
+
+/* Fetch the descriptor at @addr for @ch; false: invalid (FERR) */
+static bool fetch(MchpDmacU2223State *s, unsigned ch, uint32_t addr)
+{
+    DmacDesc d;
+
+    desc_load(addr, &d);
+    if (!(d.btctrl & BT_VALID)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: channel %u: invalid descriptor"
+                      " at 0x%" PRIx32 "\n", MCHP_REGBLOCK(s)->name, ch,
+                      addr);
+        ch_flag(s, ch, FLAG_TERR | FLAG_SUSP);
+        s->ferr[ch] = true;
+        s->susp[ch] = true;
+        s->refetch[ch] = true;
+        s->refetch_addr[ch] = addr;
+        s->fetched[ch] = false;
+        return false;
+    }
+    desc_store(wb_addr(s, ch), &d);
+    s->cur[ch] = d;
+    s->total[ch] = s->left[ch] = d.btcnt ? d.btcnt : 65536;
+    s->fetched[ch] = true;
+    s->inside[ch] = false;
+    return true;
+}
+
+static void ch_stop(MchpDmacU2223State *s, unsigned ch)
+{
+    s->chctrla[ch] &= ~R_MCHP_DMAC_CHCTRLA_ENABLE_MASK;
+    s->fetched[ch] = false;
+    s->pend[ch] = s->pend_hw[ch] = s->action[ch] = false;
+    s->susp[ch] = s->ferr[ch] = s->refetch[ch] = s->skip[ch] = false;
+}
+
+/* A queued software trigger becomes the pending request */
+static void ch_take_swtrig(MchpDmacU2223State *s, unsigned ch)
+{
+    if ((s->swtrig & BIT(ch)) && ch_on(s, ch) && !s->pend[ch]) {
+        s->swtrig &= ~BIT(ch);
+        s->pend[ch] = true;
+        s->pend_hw[ch] = false;
+    }
+}
+
+static void ch_request(MchpDmacU2223State *s, unsigned ch, bool hw)
+{
+    if (ch_on(s, ch) && !s->pend[ch]) {
+        s->pend[ch] = true;
+        s->pend_hw[ch] = hw;
+    }
+}
+
+static void ch_suspend(MchpDmacU2223State *s, unsigned ch)
+{
+    if (!ch_on(s, ch) || s->susp[ch]) {
+        return;
+    }
+    write_back(s, ch);
+    s->susp[ch] = true;
+    if (s->last == ch) {
+        s->abusy = false;
+    }
+    ch_flag(s, ch, FLAG_SUSP);
+}
+
+static void ch_resume(MchpDmacU2223State *s, unsigned ch)
+{
+    if (!ch_on(s, ch)) {
+        return;
+    }
+    if (!s->susp[ch]) {
+        s->skip[ch] = true;
+        return;
+    }
+    s->susp[ch] = false;
+    if (s->refetch[ch]) {
+        s->refetch[ch] = false;
+        s->ferr[ch] = false;
+        fetch(s, ch, s->refetch_addr[ch]);
+    } else if (s->fetched[ch]) {
+        /* An ongoing block continues from the write-back copy */
+        uint32_t left = s->left[ch];
+
+        desc_load(wb_addr(s, ch), &s->cur[ch]);
+        s->left[ch] = left;
+    }
+}
+
+static void event_pulse(MchpDmacU2223State *s, unsigned ch, unsigned sel)
+{
+    if (ch < NEV && (s->chctrlb[ch] & R_MCHP_DMAC_CHCTRLB_EVOE_MASK) &&
+        BT_EVOSEL(s->cur[ch].btctrl) == sel) {
+        qemu_irq_pulse(s->ch_event[ch]);
+    }
+}
+
+static void block_end(MchpDmacU2223State *s, unsigned ch)
+{
+    DmacDesc *d = &s->cur[ch];
+    unsigned act = BT_BLOCKACT(d->btctrl);
+    bool last = !d->descaddr;
+    bool block_ev = ch < NEV &&
+                    (s->chctrlb[ch] & R_MCHP_DMAC_CHCTRLB_EVOE_MASK) &&
+                    BT_EVOSEL(d->btctrl) == 1;
+    uint32_t next = d->descaddr;
+
+    d->btctrl &= ~BT_VALID;
+    d->btcnt = 0;
+    desc_store(wb_addr(s, ch), d);
+    s->inside[ch] = false;
+    if (s->last == ch) {
+        s->abusy = false;
+    }
+    if ((act & 2) && !s->skip[ch]) {
+        if (act & 1) {
+            ch_flag(s, ch, FLAG_TCMPL);
+        }
+        ch_flag(s, ch, FLAG_SUSP);
+        s->susp[ch] = true;
+        if (last) {
+            s->fetched[ch] = false;
+            s->refetch[ch] = true;      /* RESUME: DESCADDR 0, invalid */
+            s->refetch_addr[ch] = 0;
+        } else if (!fetch(s, ch, next)) {
+            /* FERR as well */
+        }
+        if (ch_trigact(s, ch) != TRIGACT_TRANSACTION) {
+            s->action[ch] = false;
+        }
+    } else {
+        if (act & 2) {
+            s->skip[ch] = false;
+        }
+        if (last) {
+            ch_flag(s, ch, FLAG_TCMPL);
+            ch_stop(s, ch);
+        } else {
+            if (act & 1) {
+                ch_flag(s, ch, FLAG_TCMPL);
+            }
+            fetch(s, ch, next);
+            if (ch_trigact(s, ch) != TRIGACT_TRANSACTION) {
+                s->action[ch] = false;
+            }
+        }
+    }
+    if (block_ev) {
+        qemu_irq_pulse(s->ch_event[ch]);
+    }
+}
+
+/* One beat of @ch */
+static void beat(MchpDmacU2223State *s, unsigned ch)
+{
+    DmacDesc *d = &s->cur[ch];
+    unsigned bs = BT_BEATSIZE(d->btctrl);
+    unsigned size = 1 << MIN(bs, 2);
+    unsigned step = 1 << BT_STEPSIZE(d->btctrl);
+    bool stepsrc = d->btctrl & BT_STEPSRC;
+    uint32_t k = s->total[ch] - s->left[ch];
+    uint32_t src = d->srcaddr, dst = d->dstaddr;
+    uint8_t buf[4] = { 0 };
+    MemTxResult r;
+
+    if (d->btctrl & BT_SRCINC) {
+        uint32_t inc = size * (stepsrc ? step : 1);
+
+        src = d->srcaddr - s->total[ch] * inc + k * inc;
+    }
+    if (d->btctrl & BT_DSTINC) {
+        uint32_t inc = size * (stepsrc ? 1 : step);
+
+        dst = d->dstaddr - s->total[ch] * inc + k * inc;
+    }
+    r = dma_memory_read(&address_space_memory, src, buf, size,
+                        MEMTXATTRS_UNSPECIFIED);
+    if (r == MEMTX_OK) {
+        r = dma_memory_write(&address_space_memory, dst, buf, size,
+                             MEMTXATTRS_UNSPECIFIED);
+    }
+    s->abusy = true;
+    if (r != MEMTX_OK) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: channel %u: bus error at "
+                      "0x%" PRIx32 " -> 0x%" PRIx32 "\n",
+                      MCHP_REGBLOCK(s)->name, ch, src, dst);
+        s->active_btcnt = s->left[ch];
+        write_back(s, ch);              /* BTCNT not decremented */
+        ch_flag(s, ch, FLAG_TERR);
+        ch_stop(s, ch);
+        return;
+    }
+    if (crc_on(s) && crc_src(s) == CRCSRC_CH0 + ch) {
+        crc_feed(s, ldl_le_p(buf), size);
+    }
+    s->left[ch]--;
+    s->active_btcnt = s->left[ch];
+    s->inside[ch] = true;
+    event_pulse(s, ch, 3);
+    if (ch_trigact(s, ch) == TRIGACT_BEAT) {
+        s->action[ch] = false;
+    }
+    if (!s->left[ch]) {
+        block_end(s, ch);
+    }
+    if (!s->action[ch]) {
+        ch_take_swtrig(s, ch);
+    }
+}
+
+static bool trigger_ready(MchpDmacU2223State *s, unsigned ch)
+{
+    unsigned src = ch_trigsrc(s, ch);
+    uint8_t f = 0;
+
+    if (!src || src >= MCHP_DMAC_MAX_TRIGGERS || !s->trig[src].mask) {
+        return false;
+    }
+    dma_memory_read(&address_space_memory, s->trig[src].flag_addr, &f, 1,
+                    MEMTXATTRS_UNSPECIFIED);
+    return f & s->trig[src].mask;
+}
+
+static bool runnable(MchpDmacU2223State *s, unsigned ch)
+{
+    unsigned lvl = FIELD_EX32(s->chctrlb[ch], MCHP_DMAC_CHCTRLB, LVL);
+
+    return ch_on(s, ch) && s->fetched[ch] && !s->susp[ch] &&
+           (s->action[ch] || s->pend[ch]) &&
+           (reg(s, A_MCHP_DMAC_CTRL, 2) &
+            (R_MCHP_DMAC_CTRL_LVLEN0_MASK << lvl));
+}
+
+/* The channel the arbiter grants next, or -1 */
+static int arbitrate(MchpDmacU2223State *s)
+{
+    uint32_t pri = reg(s, A_MCHP_DMAC_PRICTRL, 4);
+
+    for (int lvl = 3; lvl >= 0; lvl--) {
+        bool rr = extract32(pri, 8 * lvl + 7, 1);
+        unsigned start = rr ? (extract32(pri, 8 * lvl, 4) + 1) % NCH : 0;
+
+        for (unsigned i = 0; i < NCH; i++) {
+            unsigned ch = (start + i) % NCH;
+
+            if (FIELD_EX32(s->chctrlb[ch], MCHP_DMAC_CHCTRLB, LVL) == lvl &&
+                runnable(s, ch)) {
+                if (rr) {
+                    set_reg(s, A_MCHP_DMAC_PRICTRL, 4,
+                            deposit32(pri, 8 * lvl, 4, ch));
+                }
+                return ch;
+            }
+        }
+    }
+    return -1;
+}
+
+static void update_wanted(MchpDmacU2223State *s)
+{
+    uint8_t want[MCHP_DMAC_MAX_TRIGGERS] = { 0 };
+
+    for (unsigned ch = 0; ch < NCH; ch++) {
+        if (ch_on(s, ch)) {
+            want[ch_trigsrc(s, ch)] = 1;
+        }
+    }
+    for (unsigned id = 1; id < MCHP_DMAC_MAX_TRIGGERS; id++) {
+        if (want[id] != s->wanted[id]) {
+            s->wanted[id] = want[id];
+            qemu_set_irq(s->trig_wanted[id], want[id]);
+        }
+    }
+}
+
+static void run(MchpDmacU2223State *s)
+{
+    unsigned budget = BUDGET;
+    bool waiting = false, more = false;
+
+    if (dma_on(s)) {
+        for (;;) {
+            int ch;
+
+            for (unsigned c = 0; c < NCH; c++) {
+                if (ch_on(s, c) && s->fetched[c] && !s->action[c] &&
+                    !s->pend[c] && trigger_ready(s, c)) {
+                    s->pend[c] = s->pend_hw[c] = true;
+                }
+            }
+            ch = arbitrate(s);
+            if (ch < 0) {
+                break;
+            }
+            if (!budget--) {
+                more = true;            /* the rest in the next run */
+                break;
+            }
+            if (s->last >= 0 && s->last != ch && s->inside[s->last]) {
+                write_back(s, s->last);         /* lost the arbiter */
+            }
+            s->last = ch;
+            if (!s->action[ch]) {
+                s->action[ch] = true;
+                s->pend[ch] = s->pend_hw[ch] = false;
+            }
+            beat(s, ch);
+        }
+        for (unsigned c = 0; c < NCH; c++) {
+            if (ch_on(s, c) && s->fetched[c] && !s->susp[c] &&
+                ch_trigsrc(s, c) && s->trig[ch_trigsrc(s, c)].mask) {
+                waiting = true;
+            }
+        }
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+    update_wanted(s);
+    if (waiting || more) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  (waiting ? POLL_NS : START_NS));
+    }
+}
+
+static void timer_cb(void *opaque)
+{
+    run(MCHP_DMAC_U2223(opaque));
+}
+
+static void schedule(MchpDmacU2223State *s)
+{
+    int64_t when = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + START_NS;
+
+    if (!timer_pending(s->timer) || timer_expire_time_ns(s->timer) > when) {
+        timer_mod(s->timer, when);
+    }
+}
+
+static void trigger_in(void *opaque, int id, int level)
+{
+    MchpDmacU2223State *s = opaque;
+    bool any = false;
+
+    if (level <= 0) {
+        return;
+    }
+    for (unsigned ch = 0; ch < NCH; ch++) {
+        if (ch_on(s, ch) && s->fetched[ch] && ch_trigsrc(s, ch) == id) {
+            ch_request(s, ch, true);
+            any = true;
+        }
+    }
+    if (any) {
+        run(s);
+    }
+}
+
+static void event_in(void *opaque, int ch, int level)
+{
+    MchpDmacU2223State *s = opaque;
+    bool rose = level > 0 && !s->ev_level[ch];
+
+    s->ev_level[ch] = level > 0;
+    if (!rose || !(s->chctrlb[ch] & R_MCHP_DMAC_CHCTRLB_EVIE_MASK)) {
+        return;
+    }
+    switch (FIELD_EX32(s->chctrlb[ch], MCHP_DMAC_CHCTRLB, EVACT)) {
+    case MCHP_DMAC_CHCTRLB_EVACT_TRIG:
+        ch_request(s, ch, false);
+        break;
+    case MCHP_DMAC_CHCTRLB_EVACT_SUSPEND:
+        ch_suspend(s, ch);
+        break;
+    case MCHP_DMAC_CHCTRLB_EVACT_RESUME:
+        if (s->pend_hw[ch]) {               /* silicon, see above */
+            ch_resume(s, ch);
+        }
+        break;
+    case MCHP_DMAC_CHCTRLB_EVACT_SSKIP:
+        s->skip[ch] = true;
+        break;
+    case MCHP_DMAC_CHCTRLB_EVACT_NOACT:
+        return;
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s: channel %d: CTRIG/CBLOCK events "
+                      "not modelled\n", MCHP_REGBLOCK(s)->name, ch);
+        return;
+    }
+    run(s);
+}
+
+void mchp_dmac_u2223_set_trigger(DeviceState *dev, unsigned id,
+                                 hwaddr flag_addr, uint8_t mask)
+{
+    MchpDmacU2223State *s = MCHP_DMAC_U2223(dev);
+
+    assert(id < MCHP_DMAC_MAX_TRIGGERS);
+    s->trig[id].flag_addr = flag_addr;
+    s->trig[id].mask = mask;
+}
+
+/* ---- registers ---- */
+
+/* The channel CHID selects: 12-15 read 8-11; -1 for writes there */
+static int window_ch(MchpDmacU2223State *s, bool write)
+{
+    unsigned id = reg(s, A_MCHP_DMAC_CHID, 1) & 0xF;
+
+    if (id < NCH) {
+        return id;
+    }
+    return write ? -1 : (int)id - 4;
+}
+
+static uint8_t ch_status(MchpDmacU2223State *s, unsigned ch)
+{
+    return (s->pend[ch] ? ST_PEND : 0) |
+           (s->action[ch] && ch_on(s, ch) ? ST_BUSY : 0) |
+           (s->ferr[ch] ? ST_FERR : 0);
+}
+
+static uint8_t ch_pending_irq(MchpDmacU2223State *s, unsigned ch)
+{
+    return s->flag[ch] & s->inten[ch];
+}
+
+static uint32_t pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                         unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpDmacU2223State *s = MCHP_DMAC_U2223(rf->opaque);
+    uint32_t v = 0;
+    int ch;
+
+    if (side_effects && timer_pending(s->timer)) {
+        timer_del(s->timer);
+        run(s);
+    }
+    ch = window_ch(s, false);
+    switch (ri->offset) {
+    case A_MCHP_DMAC_CRCCHKSUM:
+        return crc_on(s) ? crc_read(s) : stored;
+    case A_MCHP_DMAC_CRCSTATUS:
+        return (crc_busy(s) ? R_MCHP_DMAC_CRCSTATUS_CRCBUSY_MASK : 0) |
+               (crc_on(s) && s->crc_fed && !crc_busy(s) && crc_read(s) == 0 ?
+                R_MCHP_DMAC_CRCSTATUS_CRCZERO_MASK : 0);
+    case A_MCHP_DMAC_SWTRIGCTRL:
+        return s->swtrig;
+    case A_MCHP_DMAC_INTPEND:
+        for (unsigned c = 0; c < NCH; c++) {
+            if (ch_pending_irq(s, c)) {
+                uint8_t st = ch_status(s, c);
+
+                return c | (uint32_t)s->flag[c] << 8 |
+                       (st & ST_FERR ? R_MCHP_DMAC_INTPEND_FERR_MASK : 0) |
+                       (st & ST_BUSY ? R_MCHP_DMAC_INTPEND_BUSY_MASK : 0) |
+                       (st & ST_PEND ? R_MCHP_DMAC_INTPEND_PEND_MASK : 0);
+            }
+        }
+        return 0;
+    case A_MCHP_DMAC_INTSTATUS:
+    case A_MCHP_DMAC_BUSYCH:
+    case A_MCHP_DMAC_PENDCH:
+        for (unsigned c = 0; c < NCH; c++) {
+            bool bit = ri->offset == A_MCHP_DMAC_INTSTATUS ?
+                       ch_pending_irq(s, c) != 0 :
+                       ri->offset == A_MCHP_DMAC_BUSYCH ?
+                       (ch_status(s, c) & ST_BUSY) != 0 : s->pend[c];
+
+            v |= bit ? BIT(c) : 0;
+        }
+        return v;
+    case A_MCHP_DMAC_ACTIVE:
+        if (s->last < 0) {
+            return 0;
+        }
+        return (uint32_t)s->last << R_MCHP_DMAC_ACTIVE_ID_SHIFT |
+               (s->abusy ? R_MCHP_DMAC_ACTIVE_ABUSY_MASK : 0) |
+               (uint32_t)s->active_btcnt << R_MCHP_DMAC_ACTIVE_BTCNT_SHIFT;
+    case A_MCHP_DMAC_CHCTRLA:
+        return s->chctrla[ch];
+    case A_MCHP_DMAC_CHCTRLB:
+        return s->chctrlb[ch];
+    case A_MCHP_DMAC_CHINTENCLR:
+    case A_MCHP_DMAC_CHINTENSET:
+        return s->inten[ch];
+    case A_MCHP_DMAC_CHINTFLAG:
+        return s->flag[ch];
+    case A_MCHP_DMAC_CHSTATUS:
+        return ch_status(s, ch);
+    default:
+        return mchp_regfile_peek(rf, ri->offset, ri->size);
+    }
+}
+
+static void ch_reset(MchpDmacU2223State *s, unsigned ch)
+{
+    ch_stop(s, ch);
+    s->chctrla[ch] = 0;
+    s->chctrlb[ch] = 0;
+    s->inten[ch] = s->flag[ch] = 0;
+    s->swtrig &= ~BIT(ch);
+    s->inside[ch] = false;
+}
+
+static void state_reset(MchpDmacU2223State *s)
+{
+    timer_del(s->timer);
+    for (unsigned ch = 0; ch < NCH; ch++) {
+        ch_reset(s, ch);
+        s->left[ch] = s->total[ch] = 0;
+    }
+    s->swtrig = 0;
+    s->last = -1;
+    s->abusy = false;
+    s->active_btcnt = 0;
+    s->crc_fed = false;
+    s->crc = 0;
+    s->crc_busy = false;
+}
+
+static void ctrl_write(MchpDmacU2223State *s, uint32_t old, uint32_t written,
+                       uint32_t we)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+
+    if (written & we & R_MCHP_DMAC_CTRL_SWRST_MASK) {
+        if (old & (R_MCHP_DMAC_CTRL_DMAENABLE_MASK |
+                   R_MCHP_DMAC_CTRL_CRCENABLE_MASK)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "%s: CTRL.SWRST while enabled "
+                          "(ignored)\n", rb->name);
+            set_reg(s, A_MCHP_DMAC_CTRL, 2, old);
+        } else {
+            uint8_t dbg = reg(s, A_MCHP_DMAC_DBGCTRL, 1);
+
+            mchp_regfile_reset(&rb->rf);        /* all but DBGCTRL */
+            set_reg(s, A_MCHP_DMAC_DBGCTRL, 1, dbg);
+            state_reset(s);
+        }
+        return;
+    }
+    /* CRCENABLE stays set while the I/O mode CRC is busy */
+    if ((old & R_MCHP_DMAC_CTRL_CRCENABLE_MASK) && !crc_on(s) &&
+        s->crc_busy) {
+        set_reg(s, A_MCHP_DMAC_CTRL, 2, reg(s, A_MCHP_DMAC_CTRL, 2) |
+                R_MCHP_DMAC_CTRL_CRCENABLE_MASK);
+    } else if (crc_on(s) && !(old & R_MCHP_DMAC_CTRL_CRCENABLE_MASK)) {
+        /* CRCCHKSUM holds the seed, as the raw register */
+        uint32_t seed = reg(s, A_MCHP_DMAC_CRCCHKSUM, 4);
+
+        s->crc = crc32_poly(s) ? revbit32(seed) : seed & 0xFFFF;
+        s->crc_busy = false;
+        s->crc_fed = false;
+    } else if (!crc_on(s) && (old & R_MCHP_DMAC_CTRL_CRCENABLE_MASK)) {
+        set_reg(s, A_MCHP_DMAC_CRCCHKSUM, 4, crc_read(s));
+    }
+}
+
+static void chctrla_write(MchpDmacU2223State *s, unsigned ch, uint32_t val)
+{
+    bool was = ch_on(s, ch);
+
+    if ((val & R_MCHP_DMAC_CHCTRLA_SWRST_MASK) && !was) {
+        ch_reset(s, ch);
+        return;
+    }
+    s->chctrla[ch] = val & CHCTRLA_MASK & ~R_MCHP_DMAC_CHCTRLA_SWRST_MASK;
+    if (ch_on(s, ch) && !was) {
+        s->ferr[ch] = s->susp[ch] = s->refetch[ch] = s->skip[ch] = false;
+        s->pend[ch] = s->pend_hw[ch] = s->action[ch] = false;
+        fetch(s, ch, reg(s, A_MCHP_DMAC_BASEADDR, 4) + 16 * ch);
+        ch_take_swtrig(s, ch);
+    } else if (!ch_on(s, ch) && was) {
+        write_back(s, ch);
+        if (s->last == ch) {
+            s->abusy = false;
+        }
+        ch_stop(s, ch);
+    }
+}
+
+static void chctrlb_write(MchpDmacU2223State *s, unsigned ch, uint32_t val)
+{
+    if (ch_on(s, ch)) {
+        s->chctrlb[ch] = (s->chctrlb[ch] & ~CHCTRLB_LVL) |
+                         (val & CHCTRLB_LVL);
+    } else {
+        s->chctrlb[ch] = val & CHCTRLB_MASK;
+    }
+    switch (FIELD_EX32(val, MCHP_DMAC_CHCTRLB, CMD)) {
+    case 1:
+        ch_suspend(s, ch);
+        break;
+    case 2:
+        ch_resume(s, ch);
+        break;
+    default:
+        break;
+    }
+}
+
+static void post_write(MchpRegFile *rf, const MchpRegInfo *ri, unsigned idx,
+                       uint32_t old, uint32_t written, uint32_t we)
+{
+    MchpDmacU2223State *s = MCHP_DMAC_U2223(rf->opaque);
+    uint32_t val = written & we;
+    int ch = window_ch(s, true);
+
+    switch (ri->offset) {
+    case A_MCHP_DMAC_CTRL:
+        ctrl_write(s, old, written, we);
+        break;
+    case A_MCHP_DMAC_CRCCTRL:
+        if (crc_on(s)) {
+            set_reg(s, A_MCHP_DMAC_CRCCTRL, 2, old);    /* enable-protected */
+        }
+        break;
+    case A_MCHP_DMAC_CRCDATAIN:
+        if (crc_on(s) && crc_src(s) == CRCSRC_IO) {
+            crc_feed(s, val, 1 << MIN(FIELD_EX32(reg(s, A_MCHP_DMAC_CRCCTRL,
+                                                     2),
+                                                 MCHP_DMAC_CRCCTRL,
+                                                 CRCBEATSIZE), 2));
+            s->crc_busy = true;
+        }
+        break;
+    case A_MCHP_DMAC_CRCCHKSUM:
+        if (crc_on(s)) {
+            set_reg(s, A_MCHP_DMAC_CRCCHKSUM, 4, old);  /* enable-protected */
+        }
+        break;
+    case A_MCHP_DMAC_CRCSTATUS:
+        if (val & R_MCHP_DMAC_CRCSTATUS_CRCBUSY_MASK) {
+            s->crc_busy = false;
+        }
+        break;
+    case A_MCHP_DMAC_SWTRIGCTRL:
+        s->swtrig = val & MAKE_64BIT_MASK(0, NCH);
+        for (unsigned c = 0; c < NCH; c++) {
+            ch_take_swtrig(s, c);
+        }
+        break;
+    case A_MCHP_DMAC_INTPEND: {
+        unsigned id = FIELD_EX32(val, MCHP_DMAC_INTPEND, ID);
+
+        if (id < NCH) {
+            s->flag[id] &= ~(val >> 8 & 7);
+        }
+        break;
+    }
+    case A_MCHP_DMAC_CHCTRLA:
+        if (ch >= 0) {
+            chctrla_write(s, ch, val);
+        }
+        break;
+    case A_MCHP_DMAC_CHCTRLB:
+        if (ch >= 0) {
+            chctrlb_write(s, ch, val);
+        }
+        break;
+    case A_MCHP_DMAC_CHINTENCLR:
+        if (ch >= 0) {
+            s->inten[ch] &= ~(val & 7);
+        }
+        break;
+    case A_MCHP_DMAC_CHINTENSET:
+        if (ch >= 0) {
+            s->inten[ch] |= val & 7;
+        }
+        break;
+    case A_MCHP_DMAC_CHINTFLAG:
+        if (ch >= 0) {
+            s->flag[ch] &= ~(val & 7);
+        }
+        break;
+    default:
+        break;
+    }
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+    update_wanted(s);
+    schedule(s);
+}
+
+static uint32_t irq_lines(MchpRegBlock *rb)
+{
+    MchpDmacU2223State *s = MCHP_DMAC_U2223(rb);
+
+    for (unsigned ch = 0; ch < NCH; ch++) {
+        if (ch_pending_irq(s, ch)) {
+            return 1;
+        }
+    }
+    return 0;
