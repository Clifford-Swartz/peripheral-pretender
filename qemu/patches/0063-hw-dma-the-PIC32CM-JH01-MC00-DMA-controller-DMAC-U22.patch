diff --git a/tests/qtest/pic32cm-dmac-test.c b/tests/qtest/pic32cm-dmac-test.c
new file mode 100644
index 0000000..6c0630e
--- /dev/null
+++ b/tests/qtest/pic32cm-dmac-test.c
@@ -0,0 +1,133 @@
+/*
+ * QTest for the DMA controller of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The U2223 model through its CHID window: a copy, the write-back copy,
+ * the CRC engine, CHID 12-15. firmware/hello APP=dmac checks the rest
+ * against silicon.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qemu/bswap.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+
+#define DMAC            0x41006000
+#define R_CTRL          0x00
+#define R_CRCCTRL       0x02
+#define R_CRCDATAIN     0x04
+#define R_CRCCHKSUM     0x08
+#define R_CRCSTATUS     0x0C
+#define R_SWTRIGCTRL    0x10
+#define R_BASEADDR      0x34
+#define R_WRBADDR       0x38
+#define R_CHID          0x3F
+#define R_CHCTRLA       0x40
+#define R_CHCTRLB       0x44
+#define R_CHINTFLAG     0x4E
+#define R_CHSTATUS      0x4F
+
+#define DESC            0x20001000      /* 16-byte aligned sections */
+#define WB              0x20001100
+#define SRC             0x20001200
+#define DST             0x20001300
+
+#define DMAENABLE       0x0002
+#define CRCENABLE       0x0004
+#define LVLEN_ALL       0x0F00
+
+static QTestState *dmac_init(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, DMAC + R_BASEADDR, DESC);
+    qtest_writel(qts, DMAC + R_WRBADDR, WB);
+    qtest_writew(qts, DMAC + R_CTRL, DMAENABLE | LVLEN_ALL);
+    return qts;
+}
+
+/* A block of @n byte beats from SRC to DST (end addresses) */
+static void put_desc(QTestState *qts, unsigned ch, uint16_t n)
+{
+    uint8_t d[16];
+
+    stw_le_p(&d[0], 0x0C01);            /* VALID, SRCINC, DSTINC, bytes */
+    stw_le_p(&d[2], n);
+    stl_le_p(&d[4], SRC + n);
+    stl_le_p(&d[8], DST + n);
+    stl_le_p(&d[12], 0);
+    qtest_memwrite(qts, DESC + 16 * ch, d, sizeof(d));
+}
+
+static void test_copy(void)
+{
+    QTestState *qts = dmac_init();
+    uint8_t src[32], dst[32];
+
+    for (unsigned i = 0; i < sizeof(src); i++) {
+        src[i] = i * 3;
+    }
+    qtest_memwrite(qts, SRC, src, sizeof(src));
+    put_desc(qts, 3, sizeof(src));
+    qtest_writeb(qts, DMAC + R_CHID, 3);
+    qtest_writeb(qts, DMAC + R_CHCTRLA, 0x02);
+    /* the descriptor is in the write-back copy at once */
+    g_assert_cmphex(qtest_readw(qts, WB + 16 * 3), ==, 0x0C01);
+    qtest_writel(qts, DMAC + R_SWTRIGCTRL, BIT(3));
+    /* a status read lets the transfer run */
+    g_assert_cmphex(qtest_readb(qts, DMAC + R_CHINTFLAG), ==, 0x02);
+    g_assert_cmphex(qtest_readb(qts, DMAC + R_CHCTRLA), ==, 0);
+    qtest_memread(qts, DST, dst, sizeof(dst));
+    g_assert_cmpmem(src, sizeof(src), dst, sizeof(dst));
+    /* the write-back copy: VALID cleared, BTCNT 0 */
+    g_assert_cmphex(qtest_readw(qts, WB + 16 * 3), ==, 0x0C00);
+    g_assert_cmphex(qtest_readw(qts, WB + 16 * 3 + 2), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_crc(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    static const char s9[] = "123456789";
+
+    qtest_writel(qts, DMAC + R_CRCCHKSUM, 0xFFFFFFFF);
+    qtest_writew(qts, DMAC + R_CRCCTRL, (1 << 2) | (1 << 8));  /* CRC-32, IO */
+    qtest_writew(qts, DMAC + R_CTRL, CRCENABLE);
+    for (unsigned i = 0; i < 9; i++) {
+        qtest_writel(qts, DMAC + R_CRCDATAIN, (uint8_t)s9[i]);
+        g_assert_cmphex(qtest_readb(qts, DMAC + R_CRCSTATUS) & 1, ==, 1);
+        qtest_writeb(qts, DMAC + R_CRCSTATUS, 1);
+    }
+    g_assert_cmphex(qtest_readl(qts, DMAC + R_CRCCHKSUM), ==, 0xCBF43926);
+    qtest_quit(qts);
+}
+
+/* CHID 12-15 read channels 8-11 and ignore writes */
+static void test_chid_alias(void)
+{
+    QTestState *qts = dmac_init();
+
+    qtest_writeb(qts, DMAC + R_CHID, 9);
+    qtest_writel(qts, DMAC + R_CHCTRLB, 0x0900);
+    qtest_writeb(qts, DMAC + R_CHID, 13);
+    g_assert_cmphex(qtest_readl(qts, DMAC + R_CHCTRLB), ==, 0x0900);
+    qtest_writel(qts, DMAC + R_CHCTRLB, 0x0D00);
+    qtest_writeb(qts, DMAC + R_CHID, 9);
+    g_assert_cmphex(qtest_readl(qts, DMAC + R_CHCTRLB), ==, 0x0900);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-dmac/copy", test_copy);
+    qtest_add_func("pic32cm-dmac/crc", test_crc);
+    qtest_add_func("pic32cm-dmac/chid-alias", test_chid_alias);
+    return g_test_run();
+}
