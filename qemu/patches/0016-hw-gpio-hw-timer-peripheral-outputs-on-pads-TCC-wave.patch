+/* A child gate device (TYPE_OR_IRQ or TYPE_SPLIT_IRQ) of @n lines */
+static DeviceState *pic32cm_gate(Pic32cmSocState *s, const char *type,
+                                 const char *name, unsigned n)
+{
+    Object *obj = object_new(type);
+
+    object_property_add_child(OBJECT(s), name, obj);
+    object_unref(obj);
+    object_property_set_int(obj, "num-lines", n, &error_abort);
+    qdev_realize(DEVICE(obj), NULL, &error_abort);
+    return DEVICE(obj);
+}
+
+/*
+ * Peripheral outputs to the pads (MchpDeviceInfo.signals): signal
+ * GROUP[n] of an instance on a pad with a PMUX function is the model's
+ * GPIO output "pad-group"[n], lower case, driving PORT "pmux-in" of that
+ * pad and function; its input "pad-group-active"[n], if the model has it,
+ * follows PORT "pmux-active". A signal on several pads fans out through a
+ * split-irq, and their "active" lines are OR-ed.
+ */
+static void pic32cm_connect_pads(Pic32cmSocState *s)
+{
+    DeviceState *port = pic32cm_periph(s, "PORT");
+    g_autoptr(GHashTable) seen = g_hash_table_new_full(g_str_hash,
+                                                       g_str_equal, g_free,
+                                                       NULL);
+
+    for (unsigned i = 0; i < s->dev->nsignals; i++) {
+        const MchpSignalInfo *sig = &s->dev->signals[i];
+        DeviceState *dev = pic32cm_soc_periph(s, sig->instance);
+        g_autofree char *grp = g_ascii_strdown(sig->group, -1);
+        g_autofree char *out = g_strdup_printf("pad-%s", grp);
+        g_autofree char *act = g_strdup_printf("pad-%s-active", grp);
+        g_autofree char *key = NULL;
+        unsigned pins[16], n = 0;
+        DeviceState *split = NULL, *or = NULL;
+
+        if (!dev || sig->pmux < 0 || sig->pin < 0 || sig->index < 0 ||
+            !pic32cm_has_gpio(dev, out, false, sig->index)) {
+            continue;
+        }
+        key = g_strdup_printf("%s.%s[%d]", sig->instance, grp, sig->index);
+        if (g_hash_table_contains(seen, key)) {
+            continue;
+        }
+        /* Every pad (and function) that carries this signal */
+        for (unsigned j = i; j < s->dev->nsignals && n < ARRAY_SIZE(pins);
+             j++) {
+            const MchpSignalInfo *o = &s->dev->signals[j];
+
+            if (!strcmp(o->instance, sig->instance) &&
+                !strcmp(o->group, sig->group) && o->index == sig->index &&
+                o->pmux >= 0 && o->pin >= 0) {
+                pins[n++] = o->pin * MCHP_PORT_FUNCS + o->pmux;
+            }
+        }
+        if (n > 1) {
+            g_autofree char *sname = g_strdup_printf("%s-split", key);
+
+            split = pic32cm_gate(s, TYPE_SPLIT_IRQ, sname, n);
+            qdev_connect_gpio_out_named(dev, out, sig->index,
+                                        qdev_get_gpio_in(split, 0));
+        }
+        if (n > 1 && pic32cm_has_gpio(dev, act, true, sig->index)) {
+            g_autofree char *oname = g_strdup_printf("%s-active-or", key);
+
+            or = pic32cm_gate(s, TYPE_OR_IRQ, oname, n);
+            qdev_connect_gpio_out(or, 0,
+                                  qdev_get_gpio_in_named(dev, act,
+                                                         sig->index));
+        }
+        for (unsigned k = 0; k < n; k++) {
+            qemu_irq in = qdev_get_gpio_in_named(port, MCHP_PORT_PMUX_IN,
+                                                 pins[k]);
+
+            if (split) {
+                qdev_connect_gpio_out(split, k, in);
+            } else {
+                qdev_connect_gpio_out_named(dev, out, sig->index, in);
+            }
+            if (or) {
+                qdev_connect_gpio_out_named(port, MCHP_PORT_PMUX_ACTIVE,
+                                            pins[k],
+                                            qdev_get_gpio_in(or, k));
+            } else if (pic32cm_has_gpio(dev, act, true, sig->index)) {
+                qdev_connect_gpio_out_named(port, MCHP_PORT_PMUX_ACTIVE,
+                                            pins[k],
+                                            qdev_get_gpio_in_named(dev, act,
+                                                sig->index));
+            }
+        }
+        g_hash_table_add(seen, g_steal_pointer(&key));
+    }
+}
+
