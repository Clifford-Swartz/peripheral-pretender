@@ -15,12 +15,15 @@
 #include "qemu/osdep.h"
 #include "libqtest.h"
 #include "qemu/bitops.h"
+#include "qobject/qdict.h"
 
 #define MACHINE         "-M pic32cm-mc00-cpro "
 
 #define GCLK_PCHCTRL    0x40001C80
 #define TCC0            0x42002400
+#define TCC1            0x42002800
 #define TCC2            0x42002C00
+#define PORT            0x41000000
 #define NVIC_ISPR       0xE000E200
 
 #define R_CTRLA         0x00
@@ -275,6 +278,50 @@ static void test_counter_width(void)
     qtest_quit(qts);
