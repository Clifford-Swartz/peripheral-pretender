+/* "pa-stats" of PA24: driven-high and driven-low ns (pins 24 at 2n + 1) */
+static void pa24_stats(QTestState *qts, uint64_t *high, uint64_t *low)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': '/machine/soc/port',"
+                           " 'property': 'pa-stats' } }");
+    g_auto(GStrv) f = g_strsplit(qdict_get_str(rsp, "return"), " ", -1);
+
+    *high = g_ascii_strtoull(f[1 + 2 * 24], NULL, 10);
+    *low = g_ascii_strtoull(f[2 + 2 * 24], NULL, 10);
+    qobject_unref(rsp);
+}
+
+/*
+ * TCC1 WO[2] on PA24 (function F): an NPWM waveform at 25 % duty drives
+ * the pad high a quarter of the time; with the pin back on GPIO it does
+ * not drive it at all
+ */
+static void test_pwm_pad(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    uint64_t h0, l0, h1, l1;
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * TCC0_GCLK_ID, 0x40);
+    qtest_writel(qts, TCC1 + R_WAVE, NPWM);
+    qtest_writel(qts, TCC1 + R_PER, 99);
+    qtest_writel(qts, TCC1 + R_CC(0), 25);
+    qtest_writeb(qts, PORT + 0x40 + 24, 0x01);        /* PINCFG24.PMUXEN */
+    qtest_writeb(qts, PORT + 0x30 + 12, 0x05);        /* PMUXE: F */
+    qtest_writel(qts, TCC1 + R_CTRLA, ENABLE);        /* /1: 25 us period */
+    qtest_clock_step(qts, 1000000);
+    pa24_stats(qts, &h0, &l0);
+    qtest_clock_step(qts, 10000000);
+    pa24_stats(qts, &h1, &l1);
+    g_assert_cmpuint((h1 - h0) * 100 / (h1 - h0 + l1 - l0), ==, 25);
+
+    qtest_writeb(qts, PORT + 0x40 + 24, 0x00);        /* back to GPIO */
+    pa24_stats(qts, &h0, &l0);
+    qtest_clock_step(qts, 1000000);
+    pa24_stats(qts, &h1, &l1);
+    g_assert_cmpuint(h1 - h0 + l1 - l0, ==, 0);       /* undriven */
+    qtest_quit(qts);
+}
