+/* The peripheral function pin @pin of group @g is muxed to, or -1 */
+static int mchp_port_sel(MchpPortState *s, unsigned g, unsigned pin)
+{
+    hwaddr pincfg = mchp_port_offset(g, A_MCHP_PORT_GROUP_PINCFG + pin);
+    hwaddr pmux = mchp_port_offset(g, A_MCHP_PORT_GROUP_PMUX + pin / 2);
+
+    if (!(mchp_regfile_peek(mchp_port_rf(s), pincfg, 1) &
+          R_MCHP_PORT_GROUP_PINCFG_PMUXEN_MASK)) {
+        return -1;
+    }
+    return extract32(mchp_regfile_peek(mchp_port_rf(s), pmux, 1),
+                     (pin & 1) * 4, 4);
+}
+
+/* Pads of group @g an output peripheral holds floating, without pull */
+static uint32_t mchp_port_hiz(MchpPortState *s, unsigned g)
+{
+    uint32_t mask = 0;
+
+    for (unsigned pin = 0; pin < MCHP_PORT_GROUP_PINS; pin++) {
+        int f = mchp_port_sel(s, g, pin);
+
+        if (f >= 0 && extract32(s->fn_hiz[g][f], pin, 1)) {
+            mask |= BIT(pin);
+        }
+    }
+    return mask;
+}
+
+/* Pads of group @g a peripheral drives (*level: their levels) */
+static uint32_t mchp_port_periph(MchpPortState *s, unsigned g,
+                                 uint32_t *level)
+{
+    uint32_t mask = 0;
+
+    *level = 0;
+    for (unsigned pin = 0; pin < MCHP_PORT_GROUP_PINS; pin++) {
+        int f = mchp_port_sel(s, g, pin);
+
+        if (f >= 0 && extract32(s->fn_mask[g][f], pin, 1)) {
+            mask |= BIT(pin);
+            *level |= s->fn_level[g][f] & BIT(pin);
+        }
+    }
+    return mask;
+}
+
 /*
- * Level of every pad of group @g (DS 27.6.3.2): the PORT's output, else an
- * external driver, else the pull resistor of an input (towards OUT), else
- * 0 for a floating pad.
+ * Level of every pad of group @g (DS 27.6.3.2): the PORT's output, else
+ * the peripheral the pin is muxed to, else an external driver, else the
+ * pull resistor of an input (towards OUT), else 0 for a floating pad.
  */
 static uint32_t mchp_port_pads(MchpPortState *s, unsigned g)
 {
     uint32_t out = mchp_port_reg(s, g, A_MCHP_PORT_GROUP_OUT);
     uint32_t drive = mchp_port_drive_mask(s, g);
-    uint32_t ext = s->ext_mask[g] & ~drive;
+    uint32_t plevel, periph = mchp_port_periph(s, g, &plevel) & ~drive;
+    uint32_t ext = s->ext_mask[g] & ~drive & ~periph;
+    /* No pull where an output peripheral holds the pad, even floating */
     uint32_t pull = mchp_port_pincfg(s, g,
                                      R_MCHP_PORT_GROUP_PINCFG_PULLEN_MASK) &
-                    ~mchp_port_reg(s, g, A_MCHP_PORT_GROUP_DIR) & ~ext;
+                    ~mchp_port_reg(s, g, A_MCHP_PORT_GROUP_DIR) & ~ext &
+                    ~periph & ~mchp_port_hiz(s, g);
+
+    return (out & drive) | (plevel & periph) | (s->ext_level[g] & ext) |
+           (out & pull);
+}
 
-    return (out & drive) | (s->ext_level[g] & ext) | (out & pull);
+/* Add the time since the last call to the high/low time of driven pads */
+static void mchp_port_account(MchpPortState *s, unsigned g)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t dt = now - s->acc_time[g];
+
+    for (unsigned pin = 0; pin < MCHP_PORT_GROUP_PINS && dt > 0; pin++) {
+        unsigned n = g * MCHP_PORT_GROUP_PINS + pin;
+
+        if (extract32(s->pad_mask[g], pin, 1)) {
+            if (extract32(s->pad_level[g], pin, 1)) {
+                s->high_ns[n] += dt;
+            } else {
+                s->low_ns[n] += dt;
+            }
+        }
+    }
+    s->acc_time[g] = now;
 }
 
