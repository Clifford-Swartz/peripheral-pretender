+/* "pmux-in": peripheral function @n % 16 drives pin @n / 16 (-1: does not) */
+static void mchp_port_set_pmux_in(void *opaque, int n, int level)
+{
+    MchpPortState *s = opaque;
+    unsigned pin = n / MCHP_PORT_FUNCS, f = n % MCHP_PORT_FUNCS;
+    unsigned g = pin / MCHP_PORT_GROUP_PINS, bit = pin % MCHP_PORT_GROUP_PINS;
+
+    if (g >= s->ngroups) {
+        return;
+    }
+    trace_mchp_port_pmux_in('A' + g, bit, f, level);
+    s->fn_mask[g][f] = deposit32(s->fn_mask[g][f], bit, 1, level >= 0);
+    s->fn_hiz[g][f] = deposit32(s->fn_hiz[g][f], bit, 1,
+                                level == MCHP_PORT_PAD_HIZ);
