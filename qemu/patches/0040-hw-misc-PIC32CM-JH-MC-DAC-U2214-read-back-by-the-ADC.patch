+static DeviceState *adc_dac(MchpAdcU2247State *s)
+{
+    if (!s->dac_looked) {
+        Object *o = object_resolve_path_type("", TYPE_MCHP_DAC_U2214, NULL);
+
+        s->dac = o ? DEVICE(o) : NULL;
+        s->dac_looked = true;
+    }
+    return s->dac;
+}
+
+/*
+ * The DAC's VOUT pin (PA02) is ADC0's AIN0 on the JH01 and MC00: while the
+ * DAC drives it, that is what the ADC reads there (silicon: APP=dac)
+ */
+static int32_t adc_dac_vout_mv(MchpAdcU2247State *s, unsigned mux)
+{
+    DeviceState *dac;
+
+    if (mux != 0 || strcmp(MCHP_REGBLOCK(s)->name, "adc0")) {
+        return -1;
+    }
+    dac = adc_dac(s);
+    return dac ? mchp_dac_u2214_vout_mv(dac) : -1;
+}
+
 static int32_t adc_input_mv(MchpAdcU2247State *s, unsigned mux)
 {
+    int32_t vout = adc_dac_vout_mv(s, mux);
+
+    if (vout >= 0) {
+        return vout;
+    }
     switch (mux) {
     case MCHP_ADC_INPUTCTRL_MUXPOS_INTREF:
         return adc_intref_mv(s);
@@ -141,7 +176,10 @@ static int64_t adc_ref_uv(MchpAdcU2247State *s)
         return vdd / 2;
     case MCHP_ADC_REFCTRL_REFSEL_VREFA:
         return s->vrefa_mv >= 0 ? s->vrefa_mv * 1000LL : vdd;
-    default:                    /* INTVCC2, DAC */
+    case MCHP_ADC_REFCTRL_REFSEL_DAC:
+        return adc_dac(s) ? mchp_dac_u2214_internal_mv(adc_dac(s)) * 1000LL
+                          : vdd;
+    default:                    /* INTVCC2 */
         return vdd;
     }
 }
