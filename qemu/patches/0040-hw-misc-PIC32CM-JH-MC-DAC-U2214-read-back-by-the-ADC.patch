diff --git a/hw/adc/mchp_adc_u2247.c b/hw/adc/mchp_adc_u2247.c
index 7e20437..c98da14 100644
--- a/hw/adc/mchp_adc_u2247.c
+++ b/hw/adc/mchp_adc_u2247.c
@@ -26,7 +26,8 @@
  *
  * References: INTREF (VREF, as above, without VREFOE), INTVCC0 = VDDANA /
  * 1.6, INTVCC1 = VDDANA / 2, INTVCC2 = VDDANA, VREFA = "vrefa" (a pin;
- * VDDANA unless the board sets it), DAC as VDDANA. "vdd" is VDDANA in
+ * VDDANA unless the board sets it), DAC (the DAC's output). AIN0 of ADC0
+ * reads the DAC's VOUT while the DAC drives it. "vdd" is VDDANA in
  * millivolts. Checked on PIC32CM MC00 silicon (APP=adc, a board at 5 V):
  * INTREF 1.024 V, INTVCC0 VDDANA / 1.6 (the data sheet's table says
  * 1 / 1.48; the DFP and silicon say 1 / 1.6), VDDCORE 1.2 V, the INTREF
@@ -44,6 +45,7 @@
 #include "qemu/log.h"
 #include "hw/adc/mchp_adc.h"
 #include "hw/misc/mchp_sysctrl.h"
+#include "hw/misc/mchp_dac.h"
 #include "hw/mchp/gen/adc_u2247.h"
 #include "migration/vmstate.h"
 
@@ -66,6 +68,8 @@ struct MchpAdcU2247State {
     int32_t vrefa_mv;           /* < 0: VDDANA */
     bool unread;                /* a result not read yet */
     MchpRegBlock *supc;         /* the SUPC, for VREF (found on first use) */
+    DeviceState *dac;           /* the DAC: VOUT on ADC0 AIN0, DAC ref */
+    bool dac_looked;
 };
 
 static uint32_t adc_reg(MchpAdcU2247State *s, hwaddr off, unsigned size)
@@ -109,8 +113,39 @@ static int32_t adc_intref_mv(MchpAdcU2247State *s)
