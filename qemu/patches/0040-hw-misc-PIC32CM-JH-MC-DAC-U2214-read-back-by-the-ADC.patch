diff --git a/hw/misc/mchp_dac_u2214.c b/hw/misc/mchp_dac_u2214.c
new file mode 100644
index 0000000..0e92774
--- /dev/null
+++ b/hw/misc/mchp_dac_u2214.c
@@ -0,0 +1,210 @@
+/*
+ * Microchip PIC32CM JH/MC DAC (DAC U2214)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * One 10-bit channel converting at once: a DATA write sets the output code
+ * (DATA[9:0], or DATA[15:6] with CTRLB.LEFTADJ). The output is code / 1023
+ * of the reference CTRLB.REFSEL: INTREF (the SUPC's VREF, VREF.SEL: 1.024
+ * V at reset), VDDANA ("vdd") or VREFA ("vrefa"; VDDANA unless the board
+ * sets it). With CTRLB.EOEN it drives VOUT (PA02, ADC0 AIN0 on these
+ * parts: the ADC reads it back there, see mchp_dac_u2214_vout_mv()); with
+ * IOEN it feeds the ADC as its DAC reference. STATUS.READY reads 1 while
+ * enabled, and SYNCBUSY never shows busy. "vout" (read-only) is the VOUT
+ * pin's voltage in mV, -1 while the DAC does not drive it.
+ *
+ * Checked on PIC32CM MC00 silicon (firmware/hello APP=dac, read back by
+ * ADC0 on PA02): linear from 0 to 1023 against VDDANA, INTREF full scale
+ * at 1.02 V, READY set at once after enable. Silicon's offset of about 15
+ * mV at code 0 is not modelled. Not modelled: DATABUF with START events
+ * (logged), the EMPTY and UNDERRUN flags, dithering, VPD, the
+ * conversion time.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "hw/misc/mchp_dac.h"
+#include "hw/misc/mchp_sysctrl.h"
+#include "hw/mchp/gen/dac_u2214.h"
+#include "migration/vmstate.h"
+
+/* SUPC VREF (hw/mchp/gen/supc_u2117.h): SEL bits 16-19 */
+#define SUPC_VREF_OFFSET    0x1C
+#define SUPC_VREF_SEL(v)    extract32(v, 16, 4)
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpDacU2214State, MCHP_DAC_U2214)
+
+struct MchpDacU2214State {
+    MchpRegBlock parent_obj;
+
+    uint16_t code;              /* the converted 10-bit code */
+    int32_t vdd_mv;
+    int32_t vrefa_mv;           /* < 0: VDDANA */
+    MchpRegBlock *supc;         /* the SUPC, for VREF (found on first use) */
+};
+
+static uint32_t dac_reg(MchpDacU2214State *s, hwaddr off, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, off, size);
+}
+
+static int32_t dac_ref_mv(MchpDacU2214State *s)
+{
+    uint32_t vref;
+
+    switch (FIELD_EX32(dac_reg(s, A_MCHP_DAC_CTRLB, 1), MCHP_DAC_CTRLB,
+                       REFSEL)) {
+    case MCHP_DAC_CTRLB_REFSEL_INTREF:
+        if (!s->supc) {
+            Object *o = object_resolve_path_type("", TYPE_MCHP_SUPC, NULL);
+
+            s->supc = o ? MCHP_REGBLOCK(o) : NULL;
+        }
+        vref = s->supc ? mchp_regfile_peek(&s->supc->rf, SUPC_VREF_OFFSET,
+                                           4) : 0;
+        return SUPC_VREF_SEL(vref) == 2 ? 2048 :
+               SUPC_VREF_SEL(vref) == 3 ? 4096 : 1024;
+    case MCHP_DAC_CTRLB_REFSEL_VREFA:
+        return s->vrefa_mv >= 0 ? s->vrefa_mv : s->vdd_mv;
+    default:
+        return s->vdd_mv;
+    }
+}
+
+static bool dac_enabled(MchpDacU2214State *s)
+{
+    return FIELD_EX32(dac_reg(s, A_MCHP_DAC_CTRLA, 1), MCHP_DAC_CTRLA,
+                      ENABLE);
+}
+
+/* The output voltage while enabled, in mV */
+static int32_t dac_out_mv(MchpDacU2214State *s)
+{
+    return (int64_t)s->code * dac_ref_mv(s) / 1023;
+}
+
+int32_t mchp_dac_u2214_vout_mv(DeviceState *dev)
+{
+    MchpDacU2214State *s = MCHP_DAC_U2214(dev);
+
+    if (!dac_enabled(s) || !FIELD_EX32(dac_reg(s, A_MCHP_DAC_CTRLB, 1),
+                                       MCHP_DAC_CTRLB, EOEN)) {
+        return -1;
+    }
+    return dac_out_mv(s);
+}
+
+int32_t mchp_dac_u2214_internal_mv(DeviceState *dev)
+{
+    MchpDacU2214State *s = MCHP_DAC_U2214(dev);
+
+    return dac_enabled(s) ? dac_out_mv(s) : 0;
+}
+
+static uint32_t dac_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                             unsigned idx, uint32_t stored, bool side_effects)
+{
+    MchpDacU2214State *s = MCHP_DAC_U2214(rf->opaque);
+
+    if (ri->offset == A_MCHP_DAC_STATUS) {
+        return dac_enabled(s) ? R_MCHP_DAC_STATUS_READY_MASK : 0;
+    }
+    return stored;              /* SYNCBUSY: idle, writes are instant */
+}
+
+static void dac_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                           unsigned idx, uint32_t old, uint32_t written,
+                           uint32_t we)
+{
+    MchpDacU2214State *s = MCHP_DAC_U2214(rf->opaque);
+    uint16_t data = dac_reg(s, A_MCHP_DAC_DATA, 2);
+
+    if (ri->offset == A_MCHP_DAC_DATA) {
+        s->code = FIELD_EX32(dac_reg(s, A_MCHP_DAC_CTRLB, 1), MCHP_DAC_CTRLB,
+                             LEFTADJ) ? data >> 6 : data & 0x3FF;
+    } else if (ri->offset == A_MCHP_DAC_DATABUF) {
+        qemu_log_mask(LOG_UNIMP, "%s: DATABUF (START events) not "
+                      "modelled\n", MCHP_REGBLOCK(s)->name);
+    }
+}
+
+static void dac_reset_hold(MchpRegBlock *rb)
+{
+    MCHP_DAC_U2214(rb)->code = 0;
+}
+
+static void dac_get_vout(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    int32_t mv = mchp_dac_u2214_vout_mv(DEVICE(obj));
+
+    visit_type_int32(v, name, &mv, errp);
+}
+
+static void dac_get_i32(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, opaque, errp);
+}
+
+static void dac_set_i32(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, opaque, errp);
+}
+
+static void dac_init(Object *obj)
+{
+    MchpDacU2214State *s = MCHP_DAC_U2214(obj);
+
+    s->vdd_mv = 3300;
+    s->vrefa_mv = -1;
+    object_property_add(obj, "vout", "int32", dac_get_vout, NULL, NULL,
+                        NULL);
+    object_property_add(obj, "vdd", "int32", dac_get_i32, dac_set_i32, NULL,
+                        &s->vdd_mv);
+    object_property_add(obj, "vrefa", "int32", dac_get_i32, dac_set_i32,
+                        NULL, &s->vrefa_mv);
+}
+
+static const VMStateDescription vmstate_mchp_dac_u2214 = {
+    .name = TYPE_MCHP_DAC_U2214,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpDacU2214State, 1,
+                       vmstate_mchp_regblock, MchpRegBlock),
+        VMSTATE_UINT16(code, MchpDacU2214State),
+        VMSTATE_INT32(vdd_mv, MchpDacU2214State),
+        VMSTATE_INT32(vrefa_mv, MchpDacU2214State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void dac_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_dac_u2214;
+    c->pre_read = dac_pre_read;
+    c->post_write = dac_post_write;
+    c->reset_hold = dac_reset_hold;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_dac_u2214_types[] = {
+    {
+        .name = TYPE_MCHP_DAC_U2214,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpDacU2214State),
+        .instance_init = dac_init,
+        .class_init = dac_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_dac_u2214_types)
