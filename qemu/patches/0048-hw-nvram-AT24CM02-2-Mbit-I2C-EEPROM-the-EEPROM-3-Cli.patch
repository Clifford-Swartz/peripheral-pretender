 hw/misc/mikrobus.c                    |   4 +
 hw/nvram/mchp_at24cm02.c              | 280 ++++++++++++++++++++++++++
 hw/nvram/meson.build                  |   1 +
 include/hw/nvram/mchp_at24cm02.h      |  18 ++
