+/*
+ * Microchip (Atmel) AT24CM02 2-Mbit I2C serial EEPROM
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_NVRAM_MCHP_AT24CM02_H
+#define HW_NVRAM_MCHP_AT24CM02_H
+
+#define TYPE_MCHP_AT24CM02 "mchp-at24cm02"
+
+/* Base I2C address (A2 = 0); A17:A16 select one of four in a row */
+#define MCHP_AT24CM02_ADDR 0x50
+
+#endif /* HW_NVRAM_MCHP_AT24CM02_H */
