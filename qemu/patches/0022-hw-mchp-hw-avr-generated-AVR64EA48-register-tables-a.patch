+
+/* An interrupt vector and the instance raising it (NULL: none) */
+typedef struct MchpAvrVector {
+    const char *name;               /* e.g. "USART1_DRE" */
+    const char *instance;           /* e.g. "USART1" */
+    uint8_t vector;                 /* 1..; 0 is reset */
+} MchpAvrVector;
+
+/* Bytes of the data space that are not erased (profile data_rows) */
+typedef struct MchpAvrDataRow {
