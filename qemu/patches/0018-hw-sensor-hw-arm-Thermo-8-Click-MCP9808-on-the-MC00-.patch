diff --git a/hw/sensor/mchp_mcp9808.c b/hw/sensor/mchp_mcp9808.c
new file mode 100644
index 0000000..ba360c8
--- /dev/null
+++ b/hw/sensor/mchp_mcp9808.c
@@ -0,0 +1,356 @@
+/*
+ * Microchip MCP9808 digital temperature sensor (I2C)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Follows the MCP9808 data sheet (DS25095) chapter 5: a register pointer,
+ * then 16-bit registers MSB first (the resolution register is 8-bit):
+ * CONFIG, the TUPPER/TLOWER/TCRIT limits (0.25 C), the ambient temperature
+ * TA (13-bit two's complement in 1/16 C, rounded down to the selected
+ * resolution, with the TCRIT/TUPPER/TLOWER comparison flags in bits
+ * 15:13), the manufacturer ID 0x0054 and the device ID 0x0400. Shutdown
+ * (CONFIG.SHDN) holds TA; the lock bits protect the limits; the Alert
+ * output (open drain: driven or released) follows CONFIG in comparator and
+ * interrupt modes, critical temperature always in comparator mode.
+ * Conversion time and hysteresis are not modelled: TA follows the
+ * "temperature" property (milli-degrees C) at once.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/i2c/i2c.h"
+#include "hw/sensor/mchp_mcp9808.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+enum {
+    REG_RFU,
+    REG_CONFIG,
+    REG_TUPPER,
+    REG_TLOWER,
+    REG_TCRIT,
+    REG_TA,
+    REG_MANUF,
+    REG_DEVID,
+    REG_RES,
+};
+
+#define CFG_ALERT_MODE      BIT(0)      /* interrupt output */
+#define CFG_ALERT_POL       BIT(1)      /* active high */
+#define CFG_ALERT_SEL       BIT(2)      /* TCRIT only */
+#define CFG_ALERT_CNT       BIT(3)      /* enabled */
+#define CFG_ALERT_STAT      BIT(4)
+#define CFG_INT_CLEAR       BIT(5)
+#define CFG_WIN_LOCK        BIT(6)
+#define CFG_CRIT_LOCK       BIT(7)
+#define CFG_SHDN            BIT(8)
+#define CFG_WRITABLE        0x07FF
+
+#define LIMIT_MASK          0x1FFC
+#define MANUF_ID            0x0054
+#define DEVICE_ID           0x0400
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpMcp9808State, MCHP_MCP9808)
+
+struct MchpMcp9808State {
+    I2CSlave parent_obj;
+
+    qemu_irq alert;
+    int32_t temperature;        /* milli-degrees C */
+    int16_t held;               /* TA in 1/16 C while shut down */
+    uint8_t pointer;
+    uint8_t len;                /* bytes received since the address */
+    uint8_t rd;                 /* bytes read since the address */
+    uint8_t buf[2];
+    uint16_t config;
+    uint16_t limit[3];          /* TUPPER, TLOWER, TCRIT */
+    uint8_t resolution;
+    bool latched;               /* interrupt-mode alert, until cleared */
+};
+
+/* 13-bit two's complement to int */
+static int sext13(uint16_t v)
+{
+    return (int16_t)(v << 3) >> 3;
+}
+
+/* The temperature in 1/16 C, rounded down to the resolution */
+static int mcp9808_t16(MchpMcp9808State *s)
+{
+    int t;
+
+    if (s->config & CFG_SHDN) {
+        return s->held;
+    }
+    t = s->temperature >= 0 ? s->temperature * 16 / 1000
+                            : -((-s->temperature * 16 + 999) / 1000);
+    t = MAX(-4096, MIN(4095, t));
+    return t & ~((1 << (3 - s->resolution)) - 1);
+}
+
+static bool mcp9808_crit(MchpMcp9808State *s, int t)
+{
+    return t >= sext13(s->limit[2] & LIMIT_MASK);
+}
+
+static bool mcp9808_window(MchpMcp9808State *s, int t)
+{
+    return t > sext13(s->limit[0] & LIMIT_MASK) ||
+           t < sext13(s->limit[1] & LIMIT_MASK);
+}
+
+static uint16_t mcp9808_ta(MchpMcp9808State *s)
+{
+    int t = mcp9808_t16(s);
+
+    return (mcp9808_crit(s, t) ? BIT(15) : 0) |
+           (t > sext13(s->limit[0] & LIMIT_MASK) ? BIT(14) : 0) |
+           (t < sext13(s->limit[1] & LIMIT_MASK) ? BIT(13) : 0) |
+           (t & 0x1FFF);
+}
+
+/* Re-evaluate the Alert output and CONFIG.Alert Stat. */
+static void mcp9808_update(MchpMcp9808State *s)
+{
+    int t = mcp9808_t16(s);
+    bool crit = mcp9808_crit(s, t), on = false;
+
+    if ((s->config & CFG_ALERT_CNT) && !(s->config & CFG_SHDN)) {
+        if (s->config & CFG_ALERT_SEL) {
+            on = crit;
+        } else if (crit) {
+            on = true;              /* always a comparator output */
+        } else if (s->config & CFG_ALERT_MODE) {
+            s->latched |= mcp9808_window(s, t);
+            on = s->latched;
+        } else {
+            on = mcp9808_window(s, t);
+        }
+    }
+    s->config = (s->config & ~CFG_ALERT_STAT) | (on ? CFG_ALERT_STAT : 0);
+    /* Open drain: the asserted level is driven, the other one released */
+    if (s->config & CFG_ALERT_POL) {
+        qemu_set_irq(s->alert, on ? -1 : 0);
+    } else {
+        qemu_set_irq(s->alert, on ? 0 : -1);
+    }
+}
+
+static uint16_t mcp9808_read(MchpMcp9808State *s, unsigned reg)
+{
+    switch (reg) {
+    case REG_CONFIG:
+        return s->config;
+    case REG_TUPPER:
+    case REG_TLOWER:
+    case REG_TCRIT:
+        return s->limit[reg - REG_TUPPER] & LIMIT_MASK;
+    case REG_TA:
+        return mcp9808_ta(s);
+    case REG_MANUF:
+        return MANUF_ID;
+    case REG_DEVID:
+        return DEVICE_ID;
+    case REG_RES:
+        return s->resolution;
+    default:
+        return 0;
+    }
+}
+
+static void mcp9808_write(MchpMcp9808State *s, unsigned reg, uint16_t val)
+{
+    switch (reg) {
+    case REG_CONFIG: {
+        uint16_t keep = CFG_ALERT_STAT, old = s->config;
+
+        /* Locks protect themselves and the alert settings (DS Table 5-3) */
+        if (old & (CFG_WIN_LOCK | CFG_CRIT_LOCK)) {
+            keep |= CFG_ALERT_CNT;
+        }
+        if (old & CFG_WIN_LOCK) {
+            keep |= CFG_WIN_LOCK | CFG_ALERT_SEL;
+        }
+        if (old & CFG_CRIT_LOCK) {
+            keep |= CFG_CRIT_LOCK;
+        }
+        s->config = (old & keep) | (val & CFG_WRITABLE & ~keep);
+        if (val & CFG_INT_CLEAR) {
+            s->latched = false;
+        }
+        s->config &= ~CFG_INT_CLEAR;            /* reads back 0 */
+        if ((s->config & CFG_SHDN) && !(old & CFG_SHDN)) {
+            s->config &= ~CFG_SHDN;
+            s->held = mcp9808_t16(s);
+            s->config |= CFG_SHDN;
+        }
+        break;
+    }
+    case REG_TUPPER:
+    case REG_TLOWER:
+        if (!(s->config & CFG_WIN_LOCK)) {
+            s->limit[reg - REG_TUPPER] = val & LIMIT_MASK;
+        }
+        break;
+    case REG_TCRIT:
+        if (!(s->config & CFG_CRIT_LOCK)) {
+            s->limit[2] = val & LIMIT_MASK;
+        }
+        break;
+    case REG_RES:
+        s->resolution = val & 3;
+        break;
+    }
+    trace_mchp_mcp9808_write(reg, val);
+    mcp9808_update(s);
+}
+
+static int mcp9808_event(I2CSlave *i2c, enum i2c_event event)
+{
+    MchpMcp9808State *s = MCHP_MCP9808(i2c);
+
+    switch (event) {
+    case I2C_START_SEND:
+        s->len = 0;
+        break;
+    case I2C_START_RECV:
+        s->rd = 0;
+        break;
+    default:
+        break;
+    }
+    return 0;
+}
+
+/* The pointer, then MSB and LSB (one byte for the resolution register) */
+static int mcp9808_send(I2CSlave *i2c, uint8_t data)
+{
+    MchpMcp9808State *s = MCHP_MCP9808(i2c);
+
+    if (s->len == 0) {
+        s->pointer = data & 0x0F;
+    } else if (s->pointer == REG_RES) {
+        if (s->len == 1) {
+            mcp9808_write(s, REG_RES, data);
+        }
+    } else if (s->len <= 2) {
+        s->buf[s->len - 1] = data;
+        if (s->len == 2) {
+            mcp9808_write(s, s->pointer, s->buf[0] << 8 | s->buf[1]);
+        }
+    }
+    s->len++;
+    return 0;
+}
+
+static uint8_t mcp9808_recv(I2CSlave *i2c)
+{
+    MchpMcp9808State *s = MCHP_MCP9808(i2c);
+    uint16_t val = mcp9808_read(s, s->pointer);
+
+    if (s->pointer == REG_RES) {
+        return val;
+    }
+    return (s->rd++ & 1) ? val & 0xFF : val >> 8;
+}
+
+static void mcp9808_get_temperature(Object *obj, Visitor *v, const char *name,
+                                    void *opaque, Error **errp)
+{
+    int64_t value = MCHP_MCP9808(obj)->temperature;
+
+    visit_type_int(v, name, &value, errp);
+}
+
+static void mcp9808_set_temperature(Object *obj, Visitor *v, const char *name,
+                                    void *opaque, Error **errp)
+{
+    MchpMcp9808State *s = MCHP_MCP9808(obj);
+    int64_t value;
+
+    if (!visit_type_int(v, name, &value, errp)) {
+        return;
+    }
+    if (value < -40000 || value > 125000) {
+        error_setg(errp, "temperature %" PRId64 " out of range "
+                   "(-40000 to 125000 milli-degrees C)", value);
+        return;
+    }
+    s->temperature = value;
+    trace_mchp_mcp9808_temperature(value);
+    mcp9808_update(s);
+}
+
+static void mcp9808_reset(DeviceState *dev)
+{
+    MchpMcp9808State *s = MCHP_MCP9808(dev);
+
+    s->pointer = 0;
+    s->len = 0;
+    s->rd = 0;
+    s->config = 0;
+    memset(s->limit, 0, sizeof(s->limit));
+    s->resolution = 3;
+    s->latched = false;
+    mcp9808_update(s);
+}
+
+static void mcp9808_init(Object *obj)
+{
+    MchpMcp9808State *s = MCHP_MCP9808(obj);
+
+    s->temperature = 25000;
+    qdev_init_gpio_out_named(DEVICE(obj), &s->alert, MCHP_MCP9808_ALERT, 1);
+    object_property_add(obj, "temperature", "int", mcp9808_get_temperature,
+                        mcp9808_set_temperature, NULL, NULL);
+}
+
+static const VMStateDescription vmstate_mcp9808 = {
+    .name = TYPE_MCHP_MCP9808,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, MchpMcp9808State),
+        VMSTATE_INT32(temperature, MchpMcp9808State),
+        VMSTATE_INT16(held, MchpMcp9808State),
+        VMSTATE_UINT8(pointer, MchpMcp9808State),
+        VMSTATE_UINT8(len, MchpMcp9808State),
+        VMSTATE_UINT8(rd, MchpMcp9808State),
+        VMSTATE_UINT8_ARRAY(buf, MchpMcp9808State, 2),
+        VMSTATE_UINT16(config, MchpMcp9808State),
+        VMSTATE_UINT16_ARRAY(limit, MchpMcp9808State, 3),
+        VMSTATE_UINT8(resolution, MchpMcp9808State),
+        VMSTATE_BOOL(latched, MchpMcp9808State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mcp9808_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->desc = "Microchip MCP9808 temperature sensor";
+    dc->vmsd = &vmstate_mcp9808;
+    device_class_set_legacy_reset(dc, mcp9808_reset);
+    k->event = mcp9808_event;
+    k->send = mcp9808_send;
+    k->recv = mcp9808_recv;
+}
+
+static const TypeInfo mcp9808_types[] = {
+    {
+        .name = TYPE_MCHP_MCP9808,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(MchpMcp9808State),
+        .instance_init = mcp9808_init,
+        .class_init = mcp9808_class_init,
+    },
+};
+
+DEFINE_TYPES(mcp9808_types)
