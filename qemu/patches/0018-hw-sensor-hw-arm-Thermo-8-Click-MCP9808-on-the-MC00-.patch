+/*
+ * Microchip MCP9808 digital temperature sensor (I2C)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * An I2C target (address 0x18-0x1F, set with the "address" property).
+ * QOM property "temperature": the ambient temperature in milli-degrees C
+ * (-40000 to 125000, default 25000), settable while running. GPIO output
+ * "alert": the open-drain Alert pin, 0 while driven low, -1 while released.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SENSOR_MCHP_MCP9808_H
+#define HW_SENSOR_MCHP_MCP9808_H
+
+#define TYPE_MCHP_MCP9808 "mchp-mcp9808"
+#define MCHP_MCP9808_ALERT "alert"
+
+#endif /* HW_SENSOR_MCHP_MCP9808_H */
