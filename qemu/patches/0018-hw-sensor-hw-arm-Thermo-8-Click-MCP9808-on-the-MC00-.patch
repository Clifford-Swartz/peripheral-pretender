diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
new file mode 100644
index 0000000..a91294b
--- /dev/null
+++ b/tests/qtest/pic32cm-click-test.c
@@ -0,0 +1,266 @@
+/*
+ * QTest for Click boards on the PIC32CM MC00 Curiosity Pro extension headers
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Thermo 8 Click (MCP9808, data sheet DS25095) on EXT1 through the SERCOM2
+ * I2C host: identity registers, the TA encoding and its limit flags, the
+ * resolution, shutdown, the limit locks, and the open-drain Alert output
+ * on the INT pin (PB02) in comparator and interrupt modes.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro,ext1=thermo8 "
+#define CLICK1          "/machine/ext1-click"
+
+#define PORT            0x41000000
+#define PB              (PORT + 0x80)
+#define P_IN            0x20
+#define P_PINCFG        0x40
+#define INT1_PIN        2       /* PB02, EXT1 pin 9 */
+
+#define SERCOM2         0x42000C00
+#define I2CM_CTRLA      (5 << 2)
+#define I2CM_SMEN       BIT(8)
+#define I2CM_ACKACT     BIT(18)
+#define I2CM_STOP       (3 << 16)
+
+#define MCP9808         0x18
+
+static QTestState *click_init(const char *extra)
+{
+    QTestState *qts = qtest_initf(MACHINE "%s", extra);
+
+    qtest_writel(qts, SERCOM2 + 0x00, I2CM_CTRLA);
+    qtest_writel(qts, SERCOM2 + 0x04, I2CM_SMEN);
+    qtest_writel(qts, SERCOM2 + 0x00, I2CM_CTRLA | 0x02);  /* ENABLE */
+    qtest_writew(qts, SERCOM2 + 0x1A, 0x10);               /* force IDLE */
+    /* INT: input with the internal pull-up (open-drain Alert) */
+    qtest_writeb(qts, PB + P_PINCFG + INT1_PIN, 0x06);
+    qtest_writel(qts, PB + 0x18, BIT(INT1_PIN));           /* OUTSET */
+    return qts;
+}
+
+static void i2c_stop(QTestState *qts)
+{
+    qtest_writel(qts, SERCOM2 + 0x04, I2CM_SMEN | I2CM_ACKACT | I2CM_STOP);
+    qtest_clock_step(qts, 20000);
+    qtest_writel(qts, SERCOM2 + 0x04, I2CM_SMEN);           /* ACK next */
+}
+
+/* Write the register pointer and n data bytes; false on a NACK */
+static bool mcp_write(QTestState *qts, uint8_t reg, const uint8_t *d,
+                      unsigned n)
+{
+    bool ack;
+
+    qtest_writel(qts, SERCOM2 + 0x24, MCP9808 << 1);
+    ack = !(qtest_readw(qts, SERCOM2 + 0x1A) & BIT(2));    /* RXNACK */
+    qtest_writel(qts, SERCOM2 + 0x28, reg);
+    for (unsigned i = 0; i < n; i++) {
+        qtest_writel(qts, SERCOM2 + 0x28, d[i]);
+    }
+    i2c_stop(qts);
+    return ack;
+}
+
+static void mcp_write16(QTestState *qts, uint8_t reg, uint16_t val)
+{
+    uint8_t d[2] = { val >> 8, val & 0xFF };
+
+    g_assert_true(mcp_write(qts, reg, d, 2));
+}
+
+/* Point at reg, then read n (1 or 2) bytes MSB first */
+static uint16_t mcp_read(QTestState *qts, uint8_t reg, unsigned n)
+{
+    uint16_t val = 0;
+
+    mcp_write(qts, reg, NULL, 0);
+    qtest_writel(qts, SERCOM2 + 0x24, MCP9808 << 1 | 1);
+    g_assert_cmphex(qtest_readb(qts, SERCOM2 + 0x18), ==, 0x02);    /* SB */
+    for (unsigned i = 0; i < n; i++) {
+        if (i == n - 1) {
+            qtest_writel(qts, SERCOM2 + 0x04, I2CM_SMEN | I2CM_ACKACT);
+        }
+        val = val << 8 | qtest_readb(qts, SERCOM2 + 0x28);
+    }
+    i2c_stop(qts);
+    return val;
+}
+
+static bool int_high(QTestState *qts)
+{
+    return qtest_readl(qts, PB + P_IN) & BIT(INT1_PIN);
+}
+
+static void set_temp(QTestState *qts, int64_t mdeg)
+{
+    qtest_qmp_assert_success(qts,
+        "{ 'execute': 'qom-set', 'arguments': { 'path': '" CLICK1 "',"
+        " 'property': 'temperature', 'value': %" PRId64 " } }", mdeg);
+}
+
+static int64_t qom_int(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments': {"
+                           " 'path': %s, 'property': %s } }", path, prop);
+    int64_t v = qdict_get_int(rsp, "return");
+
+    qobject_unref(rsp);
+    return v;
+}
+
+static void test_identity(void)
+{
+    QTestState *qts = click_init("");
+
+    g_assert_cmphex(mcp_read(qts, 6, 2), ==, 0x0054);      /* manufacturer */
+    g_assert_cmphex(mcp_read(qts, 7, 2), ==, 0x0400);      /* device, rev */
+    g_assert_cmphex(mcp_read(qts, 1, 2), ==, 0x0000);      /* CONFIG */
+    g_assert_cmphex(mcp_read(qts, 8, 1), ==, 0x03);        /* 0.0625 C */
+    /* TA, 25 C: above TUPPER and TCRIT, both 0 after reset */
+    g_assert_cmphex(mcp_read(qts, 5, 2), ==, 0xC000 | 25 * 16);
+    g_assert_cmpint(qom_int(qts, CLICK1, "temperature"), ==, 25000);
+    qtest_quit(qts);
+}
+
+static void test_not_fitted(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro ");
+
+    qtest_writel(qts, SERCOM2 + 0x00, I2CM_CTRLA);
+    qtest_writel(qts, SERCOM2 + 0x04, I2CM_SMEN);
+    qtest_writel(qts, SERCOM2 + 0x00, I2CM_CTRLA | 0x02);
+    qtest_writew(qts, SERCOM2 + 0x1A, 0x10);
+    g_assert_false(mcp_write(qts, 5, NULL, 0));
+    qtest_quit(qts);
+}
+
+/* TA: 13-bit two's complement in 1/16 C, truncated to the resolution */
+static void test_ta_encoding(void)
+{
+    QTestState *qts = click_init("");
+
+    set_temp(qts, 23437);                   /* 23.437 C -> 374/16 */
+    g_assert_cmphex(mcp_read(qts, 5, 2), ==, 0xC000 | 0x0176);
+    set_temp(qts, -10500);                  /* below TLOWER (0 C) */
+    g_assert_cmphex(mcp_read(qts, 5, 2), ==, 0x2000 | 0x1F58);
+    set_temp(qts, -40000);
+    g_assert_cmphex(mcp_read(qts, 5, 2), ==, 0x2000 | 0x1D80);
+    set_temp(qts, 125000);
+    g_assert_cmphex(mcp_read(qts, 5, 2), ==, 0xC000 | 0x07D0);
+
+    set_temp(qts, 23437);
+    mcp_write(qts, 8, (const uint8_t[]){ 0 }, 1);          /* 0.5 C */
+    g_assert_cmphex(mcp_read(qts, 8, 1), ==, 0x00);
+    g_assert_cmphex(mcp_read(qts, 5, 2) & 0x1FFF, ==, 0x0170);
+    mcp_write(qts, 8, (const uint8_t[]){ 1 }, 1);          /* 0.25 C */
+    g_assert_cmphex(mcp_read(qts, 5, 2) & 0x1FFF, ==, 0x0174);
+    qtest_quit(qts);
+}
+
+/* TA bits 15:13 compare against TCRIT, TUPPER and TLOWER (0.25 C) */
+static void test_limit_flags(void)
+{
+    QTestState *qts = click_init("");
+
+    mcp_write16(qts, 2, 30 * 16 | 0x3);     /* TUPPER 30 C, LSBs ignored */
+    g_assert_cmphex(mcp_read(qts, 2, 2), ==, 30 * 16);
+    mcp_write16(qts, 3, 10 * 16);           /* TLOWER */
+    mcp_write16(qts, 4, 80 * 16);           /* TCRIT */
+    g_assert_cmphex(mcp_read(qts, 5, 2) >> 13, ==, 0);
+    set_temp(qts, 30000);                   /* equal: not above */
+    g_assert_cmphex(mcp_read(qts, 5, 2) >> 13, ==, 0);
+    set_temp(qts, 30250);
+    g_assert_cmphex(mcp_read(qts, 5, 2) >> 13, ==, 2);
+    set_temp(qts, 80000);                   /* at TCRIT */
+    g_assert_cmphex(mcp_read(qts, 5, 2) >> 13, ==, 6);
+    set_temp(qts, 9750);
+    g_assert_cmphex(mcp_read(qts, 5, 2) >> 13, ==, 1);
+    mcp_write16(qts, 3, (uint16_t)(-20 * 16) & 0x1FFC);    /* -20 C */
+    g_assert_cmphex(mcp_read(qts, 5, 2) >> 13, ==, 0);
+    set_temp(qts, -20250);
+    g_assert_cmphex(mcp_read(qts, 5, 2), ==, 0x2000 | 0x1EBC);
+    qtest_quit(qts);
+}
+
+/* Comparator mode follows the window; interrupt mode latches until cleared */
+static void test_alert(void)
+{
+    QTestState *qts = click_init("");
+
+    mcp_write16(qts, 2, 30 * 16);
+    mcp_write16(qts, 3, 10 * 16);
+    mcp_write16(qts, 4, 80 * 16);
+    set_temp(qts, 35000);
+    g_assert_true(int_high(qts));           /* alert output disabled */
+
+    mcp_write16(qts, 1, 0x0008);            /* enabled, comparator, low */
+    g_assert_false(int_high(qts));
+    g_assert_cmphex(qom_int(qts, "/machine/soc/port", "pb-levels")
+                    & BIT(INT1_PIN), ==, 0);
+    g_assert_cmphex(mcp_read(qts, 1, 2), ==, 0x0018);      /* Alert Stat */
+    set_temp(qts, 25000);
+    g_assert_true(int_high(qts));
+    g_assert_cmphex(mcp_read(qts, 1, 2), ==, 0x0008);
+
+    mcp_write16(qts, 1, 0x0009);            /* interrupt mode */
+    set_temp(qts, 35000);
+    set_temp(qts, 25000);
+    g_assert_false(int_high(qts));          /* latched */
+    mcp_write16(qts, 1, 0x0029);            /* interrupt clear */
+    g_assert_true(int_high(qts));
+    g_assert_cmphex(mcp_read(qts, 1, 2), ==, 0x0009);      /* reads 0 */
+
+    mcp_write16(qts, 1, 0x000C);            /* TCRIT only */
+    set_temp(qts, 35000);
+    g_assert_true(int_high(qts));
+    set_temp(qts, 85000);
+    g_assert_false(int_high(qts));
+
+    mcp_write16(qts, 1, 0x000A);            /* active high: released */
+    g_assert_true(int_high(qts));
+    qtest_quit(qts);
+}
+
+/* Shutdown holds TA; the window lock protects TUPPER/TLOWER */
+static void test_shutdown_lock(void)
+{
+    QTestState *qts = click_init("");
+
+    mcp_write16(qts, 1, 0x0100);
+    set_temp(qts, 40000);
+    g_assert_cmphex(mcp_read(qts, 5, 2) & 0x1FFF, ==, 25 * 16);
+    mcp_write16(qts, 1, 0x0000);
+    g_assert_cmphex(mcp_read(qts, 5, 2) & 0x1FFF, ==, 40 * 16);
+
+    mcp_write16(qts, 2, 50 * 16);
+    mcp_write16(qts, 1, 0x0040);            /* window lock */
+    mcp_write16(qts, 2, 60 * 16);
+    g_assert_cmphex(mcp_read(qts, 2, 2), ==, 50 * 16);
+    mcp_write16(qts, 1, 0x0000);            /* lock stays until reset */
+    g_assert_cmphex(mcp_read(qts, 1, 2), ==, 0x0040);
+    mcp_write16(qts, 4, 70 * 16);           /* TCRIT is not locked */
+    g_assert_cmphex(mcp_read(qts, 4, 2), ==, 70 * 16);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-click/thermo8-identity", test_identity);
+    qtest_add_func("pic32cm-click/not-fitted", test_not_fitted);
+    qtest_add_func("pic32cm-click/thermo8-ta", test_ta_encoding);
