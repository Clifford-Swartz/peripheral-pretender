+/* Plug the Click boards named by ext1= and ext2= into their headers. */
+static void pic32cm_mc00_cpro_add_clicks(Pic32cmMc00CproState *s)
+{
+    DeviceState *port = pic32cm_soc_periph(&s->soc, "PORT");
+    I2CBus *i2c = I2C_BUS(qdev_get_child_bus(
+        pic32cm_soc_periph(&s->soc, CPRO_EXT_I2C), "sercom2.i2c"));
+    uint8_t used[CPRO_EXT_NUM] = { 0 };
+
+    for (unsigned n = 0; n < CPRO_EXT_NUM; n++) {
+        const CproClick *c = NULL;
+        g_autofree char *child = NULL;
+        I2CSlave *dev;
+
+        if (!s->ext[n] || !*s->ext[n] || !strcmp(s->ext[n], "none")) {
+            continue;
+        }
+        for (unsigned i = 0; i < ARRAY_SIZE(pic32cm_mc00_cpro_clicks); i++) {
+            if (!strcmp(s->ext[n], pic32cm_mc00_cpro_clicks[i].name)) {
+                c = &pic32cm_mc00_cpro_clicks[i];
+            }
+        }
+        if (!c) {
+            error_report("ext%u: unknown Click board '%s' (known: thermo8)",
+                         n + 1, s->ext[n]);
+            exit(1);
+        }
+        for (unsigned m = 0; m < n; m++) {
+            if (used[m] == c->addr) {
+                error_report("ext%u: I2C address 0x%02x is taken by ext%u",
+                             n + 1, c->addr, m + 1);
+                exit(1);
+            }
+        }
+        used[n] = c->addr;
+        dev = i2c_slave_new(c->type, c->addr);
+        child = g_strdup_printf("ext%u-click", n + 1);
+        object_property_add_child(OBJECT(s), child, OBJECT(dev));
+        i2c_slave_realize_and_unref(dev, i2c, &error_fatal);
+        if (c->int_out) {
+            qdev_connect_gpio_out_named(DEVICE(dev), c->int_out, 0,
+                qdev_get_gpio_in_named(port, MCHP_PORT_IN,
+                                       pic32cm_mc00_cpro_ext_int[n]));
+        }
+    }
+}
