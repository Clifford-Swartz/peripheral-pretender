diff --git a/tests/qtest/pic32cm-wdt-test.c b/tests/qtest/pic32cm-wdt-test.c
new file mode 100644
index 0000000..3d8de8b
--- /dev/null
+++ b/tests/qtest/pic32cm-wdt-test.c
@@ -0,0 +1,240 @@
+/*
+ * QTest for the watchdog of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * The WDT model's edges on stepped virtual time, and what firmware cannot
+ * reach in reasonable time or at all: reserved values (16384 clocks) and
+ * ALWAYSON. firmware/hello APP=wdt checks the rest against silicon.
+ *
+ * The WDT clock has an edge every 1/1024 s from time 0. A CTRLA write at
+ * time 0 completes at edge 3 and starts the count at edge 2; a CLEAR write
+ * completes at the third edge after it.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro"
+
+#define RSTC_RCAUSE     0x40000C00
+#define WDT             0x40002000
+#define R_CTRLA         0x00
+#define R_CONFIG        0x01
+#define R_EWCTRL        0x02
+#define R_INTFLAG       0x06
+#define R_SYNCBUSY      0x08
+#define R_CLEAR         0x0C
+
+#define ENABLE          0x02
+#define WEN             0x04
+#define ALWAYSON        0x80
+#define EW              0x01
+#define SB_ENABLE       0x02
+#define SB_CLEAR        0x10
+#define KEY             0xA5
+#define RCAUSE_WDT      0x20
+#define USER_CONFIG     0xBB        /* the twin's default user row */
+
+typedef struct {
+    QTestState *qts;
+    int64_t now;
+} Wdt;
+
+static int64_t edge(int64_t n)
+{
+    return n * 1000000000LL / 1024;
+}
+
+static Wdt wdt_init(void)
+{
+    return (Wdt) { .qts = qtest_init(MACHINE), .now = 0 };
+}
+
+static void step_to(Wdt *w, int64_t ns)
+{
+    g_assert_cmpint(ns, >=, w->now);
+    if (ns > w->now) {
+        qtest_clock_step(w->qts, ns - w->now);
+    }
+    w->now = ns;
+}
+
+static uint8_t rd(Wdt *w, unsigned off)
+{
+    return qtest_readb(w->qts, WDT + off);
+}
+
+static void wr(Wdt *w, unsigned off, uint8_t v)
+{
+    qtest_writeb(w->qts, WDT + off, v);
+}
+
+/* A system reset reloads CONFIG from the user row */
+static bool was_reset(Wdt *w)
+{
+    return rd(w, R_CONFIG) == USER_CONFIG &&
+           qtest_readb(w->qts, RSTC_RCAUSE) == RCAUSE_WDT;
+}
+
+/* Reset exactly at @ns: not one nanosecond earlier */
+static void expect_reset_at(Wdt *w, int64_t ns)
+{
+    step_to(w, ns - 1);
+    g_assert_false(was_reset(w));
+    step_to(w, ns);
+    g_assert_true(was_reset(w));
+}
+
+static void test_timeout(void)
+{
+    Wdt w = wdt_init();
+
+    wr(&w, R_CONFIG, 0x02);                 /* PER 32 */
+    wr(&w, R_EWCTRL, 0x01);                 /* EWOFFSET 16 */
+    wr(&w, R_CTRLA, ENABLE);
+    g_assert_cmphex(rd(&w, R_SYNCBUSY), ==, SB_ENABLE);
+    g_assert_cmphex(rd(&w, R_CTRLA), ==, ENABLE);
+    step_to(&w, edge(3) - 1);
+    g_assert_cmphex(rd(&w, R_SYNCBUSY), ==, SB_ENABLE);
+    step_to(&w, edge(3));
+    g_assert_cmphex(rd(&w, R_SYNCBUSY), ==, 0);
+    step_to(&w, edge(2 + 16) - 1);
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, 0);
+    step_to(&w, edge(2 + 16));
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, EW);
+    expect_reset_at(&w, edge(2 + 32));
+    g_assert_cmphex(rd(&w, R_CTRLA), ==, 0);
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, 0);
+    qtest_quit(w.qts);
+}
+
+/* A clear with the key restarts the count when its sync completes */
+static void test_clear(void)
+{
+    Wdt w = wdt_init();
+
+    wr(&w, R_CONFIG, 0x02);                 /* PER 32 */
+    wr(&w, R_EWCTRL, 0x01);                 /* EWOFFSET 16 */
+    wr(&w, R_CTRLA, ENABLE);
+    step_to(&w, edge(20));
+    wr(&w, R_INTFLAG, EW);
+    wr(&w, R_CLEAR, KEY);
+    g_assert_cmphex(rd(&w, R_SYNCBUSY), ==, SB_CLEAR);
+    g_assert_cmphex(rd(&w, R_CLEAR), ==, 0);
+    step_to(&w, edge(23) - 1);
+    g_assert_cmphex(rd(&w, R_SYNCBUSY), ==, SB_CLEAR);
+    step_to(&w, edge(34));                  /* the old time-out */
+    g_assert_false(was_reset(&w));
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, 0);
+    step_to(&w, edge(23 + 16));
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, EW);
+    expect_reset_at(&w, edge(23 + 32));
+    qtest_quit(w.qts);
+}
+
+/* A wrong key resets when its sync completes, one edge later if disabled */
+static void test_wrong_key(void)
+{
+    Wdt w = wdt_init();
+
+    wr(&w, R_CONFIG, 0x05);
+    wr(&w, R_CLEAR, 0x5A);
+    expect_reset_at(&w, edge(4));
+    qtest_quit(w.qts);
+
+    w = wdt_init();
+    wr(&w, R_CONFIG, 0x0B);
+    wr(&w, R_CTRLA, ENABLE);
+    step_to(&w, edge(10));
+    wr(&w, R_CLEAR, 0x5A);
+    expect_reset_at(&w, edge(13));
+    qtest_quit(w.qts);
+}
+
+static void test_window(void)
+{
+    Wdt w = wdt_init();
+
+    /* Closed 16, open 16: a clear completing at edge 13 is too early */
+    wr(&w, R_CONFIG, 0x11);
+    wr(&w, R_CTRLA, ENABLE | WEN);
+    step_to(&w, edge(10));
+    wr(&w, R_CLEAR, KEY);
+    expect_reset_at(&w, edge(13));
+    qtest_quit(w.qts);
+
+    /* In the open window: the closed window starts again at edge 23 */
+    w = wdt_init();
+    wr(&w, R_CONFIG, 0x11);
+    wr(&w, R_EWCTRL, 0x00);                 /* ignored in window mode */
+    wr(&w, R_CTRLA, ENABLE | WEN);
+    step_to(&w, edge(2 + 16) - 1);
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, 0);
+    step_to(&w, edge(2 + 16));
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, EW);
+    wr(&w, R_INTFLAG, EW);
+    step_to(&w, edge(20));
+    wr(&w, R_CLEAR, KEY);
+    step_to(&w, edge(23 + 16) - 1);
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, 0);
+    step_to(&w, edge(23 + 16));
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, EW);
+    expect_reset_at(&w, edge(23 + 32));
+    qtest_quit(w.qts);
+}
+
+/* Reserved PER counts as 0xB; an EWOFFSET not below PER never warns */
+static void test_reserved(void)
+{
+    Wdt w = wdt_init();
+
+    wr(&w, R_CONFIG, 0x0C);
+    wr(&w, R_EWCTRL, 0x0F);
+    g_assert_cmphex(rd(&w, R_CONFIG), ==, 0x0C);
+    g_assert_cmphex(rd(&w, R_EWCTRL), ==, 0x0F);
+    wr(&w, R_CTRLA, ENABLE);
+    step_to(&w, edge(2 + 16384) - 1);
+    g_assert_cmphex(rd(&w, R_INTFLAG), ==, 0);
+    expect_reset_at(&w, edge(2 + 16384));
+    qtest_quit(w.qts);
+}
+
+/*
+ * ALWAYSON runs the WDT without ENABLE, holds through a system reset,
+ * locks ENABLE, CONFIG and EWCTRL, and leaves WEN writable.
+ */
+static void test_alwayson(void)
+{
+    Wdt w = wdt_init();
+
+    wr(&w, R_CONFIG, 0x02);                 /* PER 32 */
+    wr(&w, R_CTRLA, ALWAYSON);
+    step_to(&w, edge(3));
+    wr(&w, R_CTRLA, 0);
+    g_assert_cmphex(rd(&w, R_CTRLA), ==, ALWAYSON);
+    wr(&w, R_CONFIG, 0x05);
+    g_assert_cmphex(rd(&w, R_CONFIG), ==, 0x02);
+    expect_reset_at(&w, edge(2 + 32));
+    /* Still on after the reset, counting from it with the user row's PER */
+    g_assert_cmphex(rd(&w, R_CTRLA), ==, ALWAYSON);
+    wr(&w, R_CTRLA, ALWAYSON | WEN);
+    g_assert_cmphex(rd(&w, R_CTRLA), ==, ALWAYSON | WEN);
+    qtest_quit(w.qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("pic32cm-wdt/timeout", test_timeout);
+    qtest_add_func("pic32cm-wdt/clear", test_clear);
+    qtest_add_func("pic32cm-wdt/wrong-key", test_wrong_key);
+    qtest_add_func("pic32cm-wdt/window", test_window);
+    qtest_add_func("pic32cm-wdt/reserved", test_reserved);
+    qtest_add_func("pic32cm-wdt/alwayson", test_alwayson);
+    return g_test_run();
+}
