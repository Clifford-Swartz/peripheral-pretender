@@ -224,26 +226,213 @@ static void mchp_rstc_class_init(ObjectClass *klass, const void *data)
 
 /* WDT */
 
+/*
+ * The WDT counts CLK_WDT_OSC, the 1.024 kHz output of OSCULP32K; this
+ * model puts its edges at whole multiples of 1/1024 s of virtual time and
+ * counts in edge numbers. Timings are the PIC32CM MC00's
+ * (firmware/hello APP=wdtprobe, docs/research/peripherals/wdt-u2251.md):
+ *
+ *   - a write that changes CTRLA.ENABLE, WEN or ALWAYSON synchronizes
+ *     until the first edge at least 3 T - T/32 after it, a CLEAR write
+ *     until the third edge after it; SYNCBUSY meanwhile;
+ *   - the count starts one edge before an enable completes, and restarts
+ *     when a CLEAR with the key completes;
+ *   - early warning after EWOFFSET clocks, only when below PER (normal
+ *     mode), or after WINDOW clocks (window mode); the reset after PER
+ *     (normal) or WINDOW + PER clocks (window);
+ *   - a CLEAR with another value resets when it completes, one edge later
+ *     while the WDT is disabled (the data sheet says nothing about a
+ *     disabled WDT); so does the key in the closed window;
+ *   - reserved PER, WINDOW and EWOFFSET values count as 0xB (16384);
+ *   - ALWAYSON holds until power-on: it survives system resets, keeps
+ *     ENABLE, and leaves WEN writable (DS 22.5.5.1; the ALWAYSON bit
+ *     description says CTRLA is read-only). Not checked on silicon.
+ */
+
+#define MCHP_WDT_HZ             1024
+#define MCHP_WDT_NONE           INT64_MAX
+#define MCHP_WDT_ON \
+    (R_MCHP_WDT_CTRLA_ENABLE_MASK | R_MCHP_WDT_CTRLA_ALWAYSON_MASK)
+#define MCHP_WDT_CTRLA_SYNCED \
+    (MCHP_WDT_ON | R_MCHP_WDT_CTRLA_WEN_MASK)
+
 OBJECT_DECLARE_SIMPLE_TYPE(MchpWdtState, MCHP_WDT)
 
 struct MchpWdtState {
     MchpRegBlock parent_obj;
 
     qemu_irq system_reset;
+    QEMUTimer *timer;
+    bool alwayson;          /* set until power-on */
+    bool running;           /* counting: ENABLE or ALWAYSON, synchronized */
+    bool window;            /* WEN, synchronized */
+    bool ew_armed;          /* this period's early warning is still due */
+    uint8_t ctrla_busy;     /* SYNCBUSY bits of the CTRLA sync */
+    uint8_t clear_value;    /* the CLEAR write being synchronized */
+    int64_t origin;         /* edge where the count started */
+    int64_t ctrla_done;     /* edge where the CTRLA sync completes */
+    int64_t clear_done;     /* edge where the CLEAR sync completes */
+    int64_t reset_at;       /* edge of a pending system reset */
 };
 
-#define MCHP_WDT_ON \
-    (R_MCHP_WDT_CTRLA_ENABLE_MASK | R_MCHP_WDT_CTRLA_ALWAYSON_MASK)
-
 static bool mchp_wdt_is_enabled(MchpRegFile *rf)
 {
     return mchp_regfile_peek(rf, A_MCHP_WDT_CTRLA, 1) & MCHP_WDT_ON;
 }
 
-static void mchp_wdt_report_enabled(MchpRegBlock *s)
+static int64_t mchp_wdt_edge_ns(int64_t n)
+{
+    return muldiv64(n, NANOSECONDS_PER_SECOND, MCHP_WDT_HZ);
+}
+
+/* The first edge at or after @ns */
+static int64_t mchp_wdt_edge_from(int64_t ns)
+{
+    int64_t n = muldiv64(ns, MCHP_WDT_HZ, NANOSECONDS_PER_SECOND);
+
+    return mchp_wdt_edge_ns(n) < ns ? n + 1 : n;
+}
+
+static uint32_t mchp_wdt_cycles(uint32_t field)
+{
+    return 8u << MIN(field, 0xB);
+}
+
+static uint32_t mchp_wdt_config(MchpWdtState *s, bool window)
+{
+    uint32_t config = mchp_reg(MCHP_REGBLOCK(s), A_MCHP_WDT_CONFIG, 1);
+
+    return mchp_wdt_cycles(window ?
+                           FIELD_EX32(config, MCHP_WDT_CONFIG, WINDOW) :
+                           FIELD_EX32(config, MCHP_WDT_CONFIG, PER));
+}
+
+/* The edges of this period's early warning and time-out */
+static void mchp_wdt_deadlines(MchpWdtState *s, int64_t *ew,
+                               int64_t *timeout)
+{
+    uint32_t ewctrl = mchp_reg(MCHP_REGBLOCK(s), A_MCHP_WDT_EWCTRL, 1);
+    uint32_t ewo = mchp_wdt_cycles(FIELD_EX32(ewctrl, MCHP_WDT_EWCTRL,
+                                              EWOFFSET));
+    uint32_t per = mchp_wdt_config(s, false);
+    uint32_t win = mchp_wdt_config(s, true);
+
+    *ew = *timeout = MCHP_WDT_NONE;
+    if (!s->running) {
+        return;
+    }
+    if (s->window) {
+        *ew = s->origin + win;
+        *timeout = s->origin + win + per;
+    } else {
+        *ew = ewo < per ? s->origin + ewo : MCHP_WDT_NONE;
+        *timeout = s->origin + per;
+    }
+    if (!s->ew_armed) {
+        *ew = MCHP_WDT_NONE;
+    }
+}
+
+static void mchp_wdt_ctrla_done(MchpWdtState *s, int64_t n)
+{
+    uint32_t ctrla = mchp_reg(MCHP_REGBLOCK(s), A_MCHP_WDT_CTRLA, 1);
+    bool run = ctrla & MCHP_WDT_ON;
+
+    s->ctrla_done = MCHP_WDT_NONE;
+    s->ctrla_busy = 0;
+    if (run && !s->running) {
+        s->origin = n - 1;
+        s->ew_armed = true;
+    }
+    s->running = run;
+    s->window = ctrla & R_MCHP_WDT_CTRLA_WEN_MASK;
+}
+
+static void mchp_wdt_clear_done(MchpWdtState *s, int64_t n)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+
+    s->clear_done = MCHP_WDT_NONE;
+    if (s->clear_value != MCHP_WDT_CLEAR_CLEAR_KEY) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.CLEAR: wrong key 0x%02x; system"
+                      " reset\n", rb->name, s->clear_value);
+        s->reset_at = s->running ? n : n + 1;
+    } else if (s->running && s->window &&
+               n < s->origin + mchp_wdt_config(s, true)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s.CLEAR: cleared in the closed"
+                      " window; system reset\n", rb->name);
+        s->reset_at = n;
+    } else if (s->running) {
+        s->origin = n;
+        s->ew_armed = true;
+    }
+}
+
+/* Run every event due by now, then arm the timer for the next one. */
+static void mchp_wdt_update(MchpWdtState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    for (;;) {
+        int64_t ew, timeout, next;
+
+        mchp_wdt_deadlines(s, &ew, &timeout);
+        next = MIN(MIN(s->ctrla_done, s->clear_done),
+                   MIN(MIN(ew, timeout), s->reset_at));
+        if (next == MCHP_WDT_NONE) {
+            timer_del(s->timer);
+            return;
+        }
+        if (mchp_wdt_edge_ns(next) > now) {
+            timer_mod(s->timer, mchp_wdt_edge_ns(next));
+            return;
+        }
+        if (next == s->ctrla_done) {
+            mchp_wdt_ctrla_done(s, next);
+        } else if (next == s->clear_done) {
+            mchp_wdt_clear_done(s, next);
+        } else if (next == ew) {
+            mchp_reg_set_bits(rb, A_MCHP_WDT_INTFLAG, 1,
+                              R_MCHP_WDT_INTFLAG_EW_MASK);
+            s->ew_armed = false;
+            mchp_regblock_update_irq(rb);
+        } else {
+            /* The time-out, or a reset that a CLEAR asked for */
+            s->running = false;
+            s->ctrla_done = s->clear_done = s->reset_at = MCHP_WDT_NONE;
+            timer_del(s->timer);
+            qemu_irq_pulse(s->system_reset);
+            return;
+        }
+    }
+}
+
+static void mchp_wdt_tick(void *opaque)
 {
-    qemu_log_mask(LOG_UNIMP, "%s.CTRLA: watchdog enabled; time-out not"
-                  " modelled\n", s->name);
+    mchp_wdt_update(MCHP_WDT(opaque));
+}
+
+static uint32_t mchp_wdt_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                  unsigned idx, uint32_t stored,
+                                  bool side_effects)
+{
+    MchpWdtState *s = MCHP_WDT(rf->opaque);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint32_t busy = 0;
+
+    if (ri->offset != A_MCHP_WDT_SYNCBUSY) {
+        return stored;
+    }
+    if (s->ctrla_done != MCHP_WDT_NONE &&
+        mchp_wdt_edge_ns(s->ctrla_done) > now) {
+        busy |= s->ctrla_busy;
+    }
+    if (s->clear_done != MCHP_WDT_NONE &&
+        mchp_wdt_edge_ns(s->clear_done) > now) {
+        busy |= R_MCHP_WDT_SYNCBUSY_CLEAR_MASK;
+    }
+    return busy;
 }
 
 static void mchp_wdt_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
@@ -251,57 +440,128 @@ static void mchp_wdt_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
                                 uint32_t written, uint32_t we)
 {
     MchpWdtState *s = MCHP_WDT(rf->opaque);
-    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t t = mchp_wdt_edge_ns(1);
     uint32_t val = mchp_regfile_get(rf, ri, idx);
+    uint32_t changed;
+    int64_t n;
 
     switch (ri->offset) {
     case A_MCHP_WDT_CTRLA:
-        /* ALWAYSON holds until power-on reset and locks CTRLA (DS 22.6.1) */
         if (old & R_MCHP_WDT_CTRLA_ALWAYSON_MASK) {
-            if (val != old) {
-                qemu_log_mask(LOG_GUEST_ERROR, "%s.CTRLA: read-only while"
-                              " ALWAYSON is set (ignored)\n", rb->name);
-                mchp_regfile_set(rf, ri, idx, old);
-            }
-        } else if ((val & MCHP_WDT_ON) && !(old & MCHP_WDT_ON)) {
-            mchp_wdt_report_enabled(rb);
+            val = (old & ~R_MCHP_WDT_CTRLA_WEN_MASK) |
+                  (written & R_MCHP_WDT_CTRLA_WEN_MASK);
+            mchp_regfile_set(rf, ri, idx, val);
+        }
+        if (val & R_MCHP_WDT_CTRLA_ALWAYSON_MASK) {
+            s->alwayson = true;
+        }
+        changed = (old ^ val) & MCHP_WDT_CTRLA_SYNCED;
+        if (!changed) {
+            break;
         }
+        s->ctrla_busy |= changed & (R_MCHP_WDT_CTRLA_ENABLE_MASK |
+                                    R_MCHP_WDT_CTRLA_WEN_MASK);
+        if (changed & R_MCHP_WDT_CTRLA_ALWAYSON_MASK) {
+            s->ctrla_busy |= R_MCHP_WDT_SYNCBUSY_ALWAYSON_MASK;
+        }
+        s->ctrla_done = mchp_wdt_edge_from(now + 3 * t - t / 32);
+        mchp_wdt_update(s);
         break;
     case A_MCHP_WDT_CLEAR:
-        /* Any value but the key resets the system at once (DS 22.6.8) */
-        if (mchp_wdt_is_enabled(rf) &&
-            FIELD_EX32(written, MCHP_WDT_CLEAR, CLEAR) !=
-            MCHP_WDT_CLEAR_CLEAR_KEY) {
-            qemu_log_mask(LOG_GUEST_ERROR, "%s.CLEAR: wrong key 0x%" PRIx32
-                          "; system reset\n", rb->name,
-                          FIELD_EX32(written, MCHP_WDT_CLEAR, CLEAR));
-            qemu_irq_pulse(s->system_reset);
+        /* Write-only; a write while one is synchronizing is dropped */
+        mchp_regfile_set(rf, ri, idx, 0);
+        if (s->clear_done != MCHP_WDT_NONE) {
+            break;
         }
+        n = mchp_wdt_edge_from(now);
+        if (mchp_wdt_edge_ns(n) == now) {
+            n++;
+        }
+        s->clear_value = FIELD_EX32(written, MCHP_WDT_CLEAR, CLEAR);
+        s->clear_done = n + 2;
+        mchp_wdt_update(s);
         break;
     }
 }
 
+static void mchp_wdt_reset_hold(MchpRegBlock *rb)
+{
+    MchpWdtState *s = MCHP_WDT(rb);
+
+    timer_del(s->timer);
+    s->running = s->window = s->ew_armed = false;
+    s->ctrla_busy = s->clear_value = 0;
+    s->origin = 0;
+    s->ctrla_done = s->clear_done = s->reset_at = MCHP_WDT_NONE;
+    if (s->alwayson) {
+        mchp_reg_set_bits(rb, A_MCHP_WDT_CTRLA, 1,
+                          R_MCHP_WDT_CTRLA_ALWAYSON_MASK);
+    }
+}
+
+/* Enabled by the user row (or ALWAYSON): counting from the reset */
 static void mchp_wdt_reset_exit(MchpRegBlock *rb)
 {
-    if (mchp_wdt_is_enabled(&rb->rf)) {
-        mchp_wdt_report_enabled(rb);
+    MchpWdtState *s = MCHP_WDT(rb);
+    uint32_t ctrla = mchp_reg(rb, A_MCHP_WDT_CTRLA, 1);
+
+    if (!(ctrla & MCHP_WDT_ON)) {
+        return;
     }
+    s->alwayson |= ctrla & R_MCHP_WDT_CTRLA_ALWAYSON_MASK;
+    s->running = true;
+    s->window = ctrla & R_MCHP_WDT_CTRLA_WEN_MASK;
+    s->ew_armed = true;
+    s->origin = mchp_wdt_edge_from(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    mchp_wdt_update(s);
 }
 
 static void mchp_wdt_init(Object *obj)
 {
     MchpWdtState *s = MCHP_WDT(obj);
 
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, mchp_wdt_tick, s);
     qdev_init_gpio_out_named(DEVICE(obj), &s->system_reset,
                              MCHP_WDT_SYSTEM_RESET, 1);
 }
 
+static void mchp_wdt_finalize(Object *obj)
+{
+    timer_free(MCHP_WDT(obj)->timer);
+}
