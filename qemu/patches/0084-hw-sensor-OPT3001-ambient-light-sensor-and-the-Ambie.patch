+#define OPT3001         0x44
+
+static uint16_t opt_reg(QTestState *qts, uint8_t reg)
+{
+    uint8_t d[2];
+
+    i2c_rd(qts, OPT3001, reg, d, 2);
+    return d[0] << 8 | d[1];
+}
+
+static void opt_set(QTestState *qts, uint8_t reg, uint16_t v)
+{
+    uint8_t d[2] = { v >> 8, v & 0xff };
+
+    g_assert_true(i2c_wr(qts, OPT3001, reg, d, 2));
+}
+
+/* Ambient 2 Click on EXT1: OPT3001 at 0x44, open-drain INT on PB02 */
+static void test_ambient2(void)
+{
+    QTestState *qts = i2c_init("-M pic32cm-mc00-cpro,ext1=ambient2 ");
+
+    g_assert_cmphex(opt_reg(qts, 0x7e), ==, 0x5449);
+    g_assert_cmphex(opt_reg(qts, 0x7f), ==, 0x3001);
+    g_assert_cmphex(opt_reg(qts, 0x01), ==, 0xc810);    /* power-on */
+    g_assert_true(int_high(qts));
+    qom_set_int(qts, CLICK1, "lux", 500000);            /* 500 lux */
+    opt_set(qts, 0x01, 0xc610);                 /* auto, 100 ms, continuous */
+    qtest_clock_step(qts, 101 * 1000 * 1000);
+    g_assert_cmphex(opt_reg(qts, 0x00), ==, 0x4c35);    /* 16 * 3125 */
+    g_assert_false(int_high(qts));              /* end-of-conversion */
+    g_assert_cmphex(opt_reg(qts, 0x01) & 0xe0, ==, 0x80);   /* CRF */
+    g_assert_true(int_high(qts));               /* the read cleared it */
+
+    /* Latched window: above 327.68 lux (4800h) for one conversion */
+    opt_set(qts, 0x02, 0x0010);
+    opt_set(qts, 0x03, 0x4800);
+    qtest_clock_step(qts, 101 * 1000 * 1000);
+    g_assert_false(int_high(qts));
+    g_assert_cmphex(opt_reg(qts, 0x01) & 0x60, ==, 0x40);   /* FH */
+    g_assert_true(int_high(qts));
+    g_assert_cmphex(opt_reg(qts, 0x01) & 0x60, ==, 0x00);
+
+    /* Manual 40.95 lux range: overflow; ME masks the exponent */
+    opt_set(qts, 0x01, 0x0614);
+    qtest_clock_step(qts, 101 * 1000 * 1000);
+    g_assert_cmphex(opt_reg(qts, 0x01) & 0x100, ==, 0x100);  /* OVF */
+    g_assert_cmphex(opt_reg(qts, 0x00), ==, 0x0fff);
+    qtest_quit(qts);
+}
