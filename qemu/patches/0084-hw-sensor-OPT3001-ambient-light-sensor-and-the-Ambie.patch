+/* Ambient 2 Click on mikroBUS 3: OPT3001 at 0x44 on TWI0 */
+static void test_ambient2_mb3(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb3=ambient2 "
+                                  "-kernel %s", (const char *)fw);
+    uint8_t d[2];
+
+    qtest_writeb(qts, TWI0 + T_MCTRLA, 0x03);
+    qtest_writeb(qts, TWI0 + T_MSTATUS, 0x01);
+    twi_read(qts, 0x44, 0x7f, d, 2);                    /* device ID */
+    g_assert_cmphex(d[0] << 8 | d[1], ==, 0x3001);
+    qtest_quit(qts);
+}
