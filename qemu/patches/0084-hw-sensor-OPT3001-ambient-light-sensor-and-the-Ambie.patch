+/*
+ * TI OPT3001 ambient light sensor
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * "opt3001": an I2C target (0x44-0x47 by its ADDR pin, set by the
+ * board). GPIO output "int": open drain, 0 or -1 (released). QOM
+ * property "lux" (milli-lux, 0 to 83865600, default 250000): the light
+ * the sensor sees, also at run time.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SENSOR_OPT3001_H
+#define HW_SENSOR_OPT3001_H
+
+#define TYPE_OPT3001 "opt3001"
+
+#define OPT3001_INT "int"
+
+#endif /* HW_SENSOR_OPT3001_H */
