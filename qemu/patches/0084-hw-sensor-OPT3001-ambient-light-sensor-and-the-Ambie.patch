diff --git a/hw/sensor/opt3001.c b/hw/sensor/opt3001.c
new file mode 100644
index 0000000..b89d8f8
--- /dev/null
+++ b/hw/sensor/opt3001.c
@@ -0,0 +1,398 @@
+/*
+ * TI OPT3001 ambient light sensor, and the Ambient 2 Click
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * OPT3001 data sheet (SBOS681C), sections 7.3-7.6:
+ *  - Registers (16 bits, MSB first; the first byte written sets the
+ *    pointer): result 00h, configuration 01h (power-on C810h: automatic
+ *    range, 800 ms, shutdown, latched), low limit 02h (C000h), high
+ *    limit 03h (BFFFh), manufacturer ID 7Eh (5449h), device ID 7Fh
+ *    (3001h).
+ *  - Results are E[3:0] R[11:0], lux = 0.01 * 2^E * R. Range RN 0-11
+ *    gives a full scale of 40.95 * 2^RN lux (OVF above it); RN 12 picks
+ *    the smallest range that holds the light. ME zeroes the reported
+ *    exponent of a manual range.
+ *  - Conversions take 100 or 800 ms (CT); single-shot (M = 01) returns to
+ *    shutdown after one, continuous (M = 1x) repeats. CRF is set at each
+ *    end and cleared by reading the configuration or writing it with a
+ *    non-shutdown mode.
+ *  - Results above the high limit or below the low limit for FC (1, 2, 4
+ *    or 8) conversions in a row are faults. Latched window mode (L = 1):
+ *    FH or FL and INT latch until the configuration is read. Transparent
+ *    hysteresis (L = 0): above the high limit INT goes active with FH,
+ *    below the low limit inactive with FL; configuration reads do not
+ *    change them. With the low limit's two exponent MSBs set (the reset
+ *    value) INT goes active at every conversion end instead, cleared like
+ *    a latched fault, and only the high limit is compared.
+ *  - INT is open drain: active pulls low (POL 0), or releases (POL 1).
+ * Not modelled: the SMBus alert response, the reduced resolution of
+ * 100 ms conversions in the low ranges, and noise.
+ *
+ * Ambient 2 Click (MikroElektronika, schematic v100): ADDR to ground
+ * (0x44, MikroElektronika's driver default), INT on INT with R3 4.7 kOhm
+ * pull-up. Not checked against a physical Click.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/i2c/i2c.h"
+#include "hw/sensor/opt3001.h"
+#include "migration/vmstate.h"
+
+#define REG_RESULT      0x00
+#define REG_CONFIG      0x01
+#define REG_LOW         0x02
+#define REG_HIGH        0x03
+#define REG_MANUF       0x7e
+#define REG_DEVICE      0x7f
+
+#define CFG_RN_SHIFT    12
+#define CFG_CT          BIT(11)
+#define CFG_M_SHIFT     9
+#define CFG_M           (3 << CFG_M_SHIFT)
+#define CFG_OVF         BIT(8)
+#define CFG_CRF         BIT(7)
+#define CFG_FH          BIT(6)
+#define CFG_FL          BIT(5)
+#define CFG_L           BIT(4)
+#define CFG_POL         BIT(3)
+#define CFG_ME          BIT(2)
+#define CFG_FC          0x3
+#define CFG_RO          (CFG_OVF | CFG_CRF | CFG_FH | CFG_FL)
+
+#define RN_AUTO         12
+#define LUX_MAX_MLX     83865600u       /* 0.01 lux * 2^11 * 4095 */
+
+OBJECT_DECLARE_SIMPLE_TYPE(Opt3001State, OPT3001)
+
+struct Opt3001State {
+    I2CSlave parent_obj;
+
+    uint16_t result;
+    uint16_t config;
+    uint16_t low;
+    uint16_t high;
+    uint8_t ptr;
+    bool ptr_set;               /* the first byte of a write came */
+    uint8_t wbuf;               /* the high byte of a register write */
+    uint8_t wcount;
+    uint8_t rcount;
+    uint8_t high_faults;        /* conversions above the high limit */
+    uint8_t low_faults;
+    bool int_active;
+
+    uint32_t lux;               /* milli-lux */
+    QEMUTimer *timer;
+    qemu_irq irq;
+};
+
+/* A result-format register in hundredths of a lux */
+static uint64_t opt_value(uint16_t reg)
+{
+    return (uint64_t)(reg & 0xfff) << (reg >> 12);
+}
+
+static void opt_update_irq(Opt3001State *s)
+{
+    bool low = s->int_active != !!(s->config & CFG_POL);
+
+    qemu_set_irq(s->irq, low ? 0 : -1);
+}
+
+static bool opt_eoc_mode(Opt3001State *s)
+{
+    return (s->low >> 14) == 3;
+}
+
+static void opt_arm(Opt3001State *s)
+{
+    if (s->config & CFG_M) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  (s->config & CFG_CT ? 800 : 100) * SCALE_MS);
+    } else {
+        timer_del(s->timer);
+    }
+}
+
+static void opt_convert(void *opaque)
+{
+    Opt3001State *s = opaque;
+    unsigned rn = s->config >> CFG_RN_SHIFT, e = rn;
+    uint64_t centi = s->lux / 10;      /* hundredths of a lux */
+    unsigned need = 1u << (s->config & CFG_FC);     /* 1, 2, 4, 8 */
+    bool over;
+
+    if (rn >= RN_AUTO) {
+        for (e = 0; e < 11 && (centi >> e) > 0xfff; e++) {
+        }
+    }
+    over = (centi >> e) > 0xfff;
+    s->result = e << 12 | MIN(centi >> e, 0xfff);
+    s->config = (s->config & ~CFG_OVF) | (over ? CFG_OVF : 0) | CFG_CRF;
+
+    /* Faults, compared in lux whatever ME says */
+    s->high_faults = opt_value(s->result) > opt_value(s->high) ?
+                     MIN(s->high_faults + 1, 8) : 0;
+    s->low_faults = !opt_eoc_mode(s) &&
+                    opt_value(s->result) < opt_value(s->low) ?
+                    MIN(s->low_faults + 1, 8) : 0;
+    if (s->config & CFG_L) {
+        if (s->high_faults >= need) {
+            s->config |= CFG_FH;
+            s->int_active = true;
+        }
+        if (s->low_faults >= need) {
+            s->config |= CFG_FL;
+            s->int_active = true;
+        }
+    } else if (s->high_faults >= need) {
+        s->config = (s->config | CFG_FH) & ~CFG_FL;
+        s->int_active = true;
+    } else if (s->low_faults >= need) {
+        s->config = (s->config | CFG_FL) & ~CFG_FH;
+        s->int_active = false;
+    }
+    if (opt_eoc_mode(s)) {
+        s->int_active = true;
+    }
+    if (((s->config & CFG_M) >> CFG_M_SHIFT) == 1) {
+        s->config &= ~CFG_M;            /* single shot done: shutdown */
+    }
+    opt_update_irq(s);
+    opt_arm(s);
+}
+
+static uint16_t opt_read_reg(Opt3001State *s, uint8_t reg)
+{
+    uint16_t v;
+
+    switch (reg) {
+    case REG_RESULT:
+        v = s->result;
+        if ((s->config & CFG_ME) && (s->config >> CFG_RN_SHIFT) < RN_AUTO) {
+            v &= 0x0fff;
+        }
+        return v;
+    case REG_CONFIG:
+        return s->config;
+    case REG_LOW:
+        return s->low;
+    case REG_HIGH:
+        return s->high;
+    case REG_MANUF:
+        return 0x5449;
+    case REG_DEVICE:
+        return 0x3001;
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "opt3001: read of register 0x%02x\n",
+                  reg);
+    return 0;
+}
+
+/* Reading the configuration clears CRF, and latched flags and INT */
+static void opt_config_read(Opt3001State *s)
+{
+    s->config &= ~CFG_CRF;
+    if ((s->config & CFG_L) || opt_eoc_mode(s)) {
+        s->config &= ~(CFG_FH | CFG_FL);
+        s->int_active = false;
+    }
+    opt_update_irq(s);
+}
+
+static void opt_write_reg(Opt3001State *s, uint8_t reg, uint16_t v)
+{
+    uint16_t old;
+
+    switch (reg) {
+    case REG_CONFIG:
+        old = s->config;
+        if ((v >> CFG_RN_SHIFT) > RN_AUTO) {
+            qemu_log_mask(LOG_GUEST_ERROR, "opt3001: reserved range %u\n",
+                          v >> CFG_RN_SHIFT);
+        }
+        s->config = (v & ~CFG_RO) | (old & CFG_RO);
+        if (v & CFG_M) {
+            s->config &= ~CFG_CRF;
+            if (opt_eoc_mode(s)) {
+                s->int_active = false;
+            }
+            if ((v ^ old) & (CFG_M | CFG_CT | (0xf << CFG_RN_SHIFT)) ||
+                !timer_pending(s->timer)) {
+                opt_arm(s);
+            }
+        } else {
+            timer_del(s->timer);
+        }
+        opt_update_irq(s);
+        break;
+    case REG_LOW:
+        s->low = v;
+        break;
+    case REG_HIGH:
+        s->high = v;
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "opt3001: write of register 0x%02x\n",
+                      reg);
+        break;
+    }
+}
+
+static int opt_event(I2CSlave *i2c, enum i2c_event event)
+{
+    Opt3001State *s = OPT3001(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->ptr_set = false;
+        s->wcount = 0;
+    } else if (event == I2C_START_RECV) {
+        s->rcount = 0;
+    }
+    return 0;
+}
+
+static int opt_send(I2CSlave *i2c, uint8_t data)
+{
+    Opt3001State *s = OPT3001(i2c);
+
+    if (!s->ptr_set) {
+        s->ptr = data;
+        s->ptr_set = true;
+        return 0;
+    }
+    if (s->wcount++ % 2 == 0) {
+        s->wbuf = data;
+    } else {
+        opt_write_reg(s, s->ptr, s->wbuf << 8 | data);
+    }
+    return 0;
+}
+
+static uint8_t opt_recv(I2CSlave *i2c)
+{
+    Opt3001State *s = OPT3001(i2c);
+    uint16_t v = opt_read_reg(s, s->ptr);
+
+    if (s->rcount++ % 2 == 0) {
+        return v >> 8;
+    }
+    if (s->ptr == REG_CONFIG) {
+        opt_config_read(s);
+    }
+    return v & 0xff;
+}
+
+static void opt_get_lux(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &OPT3001(obj)->lux, errp);
+}
+
+static void opt_set_lux(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    uint32_t lux;
+
+    if (!visit_type_uint32(v, name, &lux, errp)) {
+        return;
+    }
+    if (lux > LUX_MAX_MLX) {
+        error_setg(errp, "lux must be 0 to %u milli-lux", LUX_MAX_MLX);
+        return;
+    }
+    OPT3001(obj)->lux = lux;
+}
+
+static void opt_reset(DeviceState *dev)
+{
+    Opt3001State *s = OPT3001(dev);
+
+    s->result = 0;
+    s->config = 0xc810;
+    s->low = 0xc000;
+    s->high = 0xbfff;
+    s->ptr = 0;
+    s->ptr_set = false;
+    s->wcount = 0;
+    s->rcount = 0;
+    s->high_faults = 0;
+    s->low_faults = 0;
+    s->int_active = false;
+    timer_del(s->timer);
+    opt_update_irq(s);
+}
+
+static void opt_init(Object *obj)
+{
+    Opt3001State *s = OPT3001(obj);
+
+    s->lux = 250000;
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, opt_convert, s);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->irq, OPT3001_INT, 1);
+    object_property_add(obj, "lux", "uint32", opt_get_lux, opt_set_lux,
+                        NULL, NULL);
+}
+
+static void opt_finalize(Object *obj)
+{
+    timer_free(OPT3001(obj)->timer);
+}
+
+static const VMStateDescription vmstate_opt3001 = {
+    .name = TYPE_OPT3001,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, Opt3001State),
+        VMSTATE_UINT16(result, Opt3001State),
+        VMSTATE_UINT16(config, Opt3001State),
+        VMSTATE_UINT16(low, Opt3001State),
+        VMSTATE_UINT16(high, Opt3001State),
+        VMSTATE_UINT8(ptr, Opt3001State),
+        VMSTATE_BOOL(ptr_set, Opt3001State),
+        VMSTATE_UINT8(wbuf, Opt3001State),
+        VMSTATE_UINT8(wcount, Opt3001State),
+        VMSTATE_UINT8(rcount, Opt3001State),
+        VMSTATE_UINT8(high_faults, Opt3001State),
+        VMSTATE_UINT8(low_faults, Opt3001State),
+        VMSTATE_BOOL(int_active, Opt3001State),
+        VMSTATE_UINT32(lux, Opt3001State),
+        VMSTATE_TIMER_PTR(timer, Opt3001State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void opt_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->desc = "OPT3001 ambient light sensor";
+    dc->vmsd = &vmstate_opt3001;
+    device_class_set_legacy_reset(dc, opt_reset);
+    k->event = opt_event;
+    k->send = opt_send;
+    k->recv = opt_recv;
+}
+
+static const TypeInfo opt3001_types[] = {
+    {
+        .name = TYPE_OPT3001,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(Opt3001State),
+        .instance_init = opt_init,
+        .instance_finalize = opt_finalize,
+        .class_init = opt_class_init,
+    },
+};
+
+DEFINE_TYPES(opt3001_types)
