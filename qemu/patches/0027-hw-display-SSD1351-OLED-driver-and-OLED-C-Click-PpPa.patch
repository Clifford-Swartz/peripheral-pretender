diff --git a/include/hw/display/pp_panel.h b/include/hw/display/pp_panel.h
new file mode 100644
index 0000000..dffad1e
--- /dev/null
+++ b/include/hw/display/pp_panel.h
@@ -0,0 +1,59 @@
+/*
+ * What a display panel on a board shows, for headless front ends
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A display controller model (SSD1351 on the OLED C Click; later ST7789
+ * and other SPI or parallel controllers) owns a PpPanel: the panel's
+ * visible pixels, composed on demand by the controller's render callback
+ * from its RAM and settings. pp_panel_init() adds QOM properties to the
+ * controller for front ends such as the web board view:
+ *
+ *   "panel-width", "panel-height"   visible pixels (uint32)
+ *   "frame-gen"                     bumped on every visible change: poll
+ *                                   it, fetch "frame" only when it moves
+ *   "frame"                         the picture: base64 of width x height
+ *                                   RGB565 pixels, 2 bytes each, high byte
+ *                                   first, rows top to bottom
+ *
+ * The controller calls pp_panel_changed() whenever what the panel shows
+ * may have changed (a RAM write, a mapping or power change).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_DISPLAY_PP_PANEL_H
+#define HW_DISPLAY_PP_PANEL_H
+
+#include "qom/object.h"
+
+/* Fill @fb (width x height RGB565, rows top to bottom) */
+typedef void PpPanelRender(void *opaque, uint16_t *fb);
+
+typedef struct PpPanel {
+    uint32_t width;
+    uint32_t height;
+    uint32_t gen;
+    bool stale;                 /* fb older than gen */
+    uint16_t *fb;
+    PpPanelRender *render;
+    void *opaque;
+} PpPanel;
+
+void pp_panel_init(PpPanel *p, Object *owner, uint32_t width,
+                   uint32_t height, PpPanelRender *render, void *opaque);
+
+static inline void pp_panel_changed(PpPanel *p)
+{
+    p->gen++;
+    p->stale = true;
+}
+
+/* RGB565 from 8-bit channels */
+static inline uint16_t pp_panel_rgb565(unsigned r, unsigned g, unsigned b)
+{
+    return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
+}
+
+#endif /* HW_DISPLAY_PP_PANEL_H */
diff --git a/include/hw/display/ssd1351.h b/include/hw/display/ssd1351.h
new file mode 100644
index 0000000..5838b99
--- /dev/null
+++ b/include/hw/display/ssd1351.h
@@ -0,0 +1,23 @@
+/*
+ * Solomon Systech SSD1351 128x128 RGB OLED driver on an SSI bus
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * GPIO inputs: "dc" (D/C#: 1 data, 0 command), "reset" (RES#, active
+ * low), "vcc" (the panel's 15 V supply: 1 on), plus the SSI chip select.
+ * The panel picture is a PpPanel ("frame", "frame-gen"; see pp_panel.h).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_DISPLAY_SSD1351_H
+#define HW_DISPLAY_SSD1351_H
+
+#define TYPE_SSD1351 "ssd1351"
+
+#define SSD1351_DC "dc"
+#define SSD1351_RESET "reset"
+#define SSD1351_VCC "vcc"
+
+#endif /* HW_DISPLAY_SSD1351_H */
