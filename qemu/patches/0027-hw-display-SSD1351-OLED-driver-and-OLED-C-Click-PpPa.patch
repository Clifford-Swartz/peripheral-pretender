diff --git a/hw/display/pp_panel.c b/hw/display/pp_panel.c
new file mode 100644
index 0000000..0c3e2f7
--- /dev/null
+++ b/hw/display/pp_panel.c
@@ -0,0 +1,53 @@
+/*
+ * What a display panel on a board shows, for headless front ends
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * See include/hw/display/pp_panel.h.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/visitor.h"
+#include "hw/display/pp_panel.h"
+
+static void pp_panel_get_frame(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    PpPanel *p = opaque;
+    size_t n = (size_t)p->width * p->height;
+    g_autofree uint8_t *bytes = g_malloc(n * 2);
+    g_autofree char *b64 = NULL;
+
+    if (p->stale) {
+        p->render(p->opaque, p->fb);
+        p->stale = false;
+    }
+    for (size_t i = 0; i < n; i++) {
+        bytes[2 * i] = p->fb[i] >> 8;
+        bytes[2 * i + 1] = p->fb[i];
+    }
+    b64 = g_base64_encode(bytes, n * 2);
+    visit_type_str(v, name, &b64, errp);
+}
+
+void pp_panel_init(PpPanel *p, Object *owner, uint32_t width,
+                   uint32_t height, PpPanelRender *render, void *opaque)
+{
+    p->width = width;
+    p->height = height;
+    p->fb = g_new0(uint16_t, (size_t)width * height);
+    p->render = render;
+    p->opaque = opaque;
+    p->stale = true;
+    object_property_add_uint32_ptr(owner, "panel-width", &p->width,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(owner, "panel-height", &p->height,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(owner, "frame-gen", &p->gen,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add(owner, "frame", "str", pp_panel_get_frame,
+                        NULL, NULL, p);
+}
diff --git a/hw/display/ssd1351.c b/hw/display/ssd1351.c
new file mode 100644
index 0000000..cf714bf
--- /dev/null
+++ b/hw/display/ssd1351.c
@@ -0,0 +1,509 @@
+/*
+ * Solomon Systech SSD1351 128x128 RGB OLED driver on an SSI bus
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * SSD1351 data sheet rev 1.3 (Oct 2009), 4-wire SPI (BS1:BS0 = 00): bytes
+ * are commands while D/C# is low and their parameters or display data
+ * while it is high (Table 9-1). Modelled: column and row windows (15h,
+ * 75h) and Write RAM (5Ch) into the 128 x 128 x 18-bit GDDRAM with
+ * horizontal or vertical increment, re-map and colour depth (A0h: column
+ * re-map, A/C swap, COM scan direction; 65k and 262k data), display start
+ * line (A1h), display offset (A2h), display modes (A4h-A7h), sleep
+ * (AEh/AFh), MUX ratio (CAh) and the command lock (FDh: 12h/16h lock the
+ * interface, B0h/B1h the commands A2h, B1h, B3h, BBh, BEh, C1h, which are
+ * locked after reset). Every other command takes its documented number
+ * of parameters and is otherwise ignored: grey-scale table, contrast and
+ * timing do not change the picture. Not modelled: scrolling (96h, 9Eh),
+ * 262k format 2, COM split off, reading RAM (not possible over SPI).
+ * RES# low returns every register to its reset value; the RAM keeps its
+ * contents.
+ *
+ * The panel: "width" x "height" visible pixels; column x shows segment
+ * "seg-left" - x, row y common "com-top" - y. The defaults are the OLED C
+ * Click's PSP27801 (96 x 96 on SEG111..16 and COM127..32), inferred from
+ * MikroElektronika's oledc driver (columns 16-111, MUX 95, offset 20h,
+ * re-map 32h: COM scan reversed, columns re-mapped), whose pictures come
+ * out upright that way. Colour A is blue, B green, C red, so 65k data in
+ * the A->B->C order is RGB565. Nothing lights while the panel supply
+ * ("vcc") is off, in sleep, or in reset. Not checked against a physical
+ * display.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/display/pp_panel.h"
+#include "hw/display/ssd1351.h"
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+
+#define SSD1351_SIZE        128
+#define SSD1351_MAX_ARGS    63
+
+enum {
+    MODE_OFF = 0xA4,
+    MODE_ON = 0xA5,
+    MODE_NORMAL = 0xA6,
+    MODE_INVERSE = 0xA7,
+};
+
+#define REMAP_VERTICAL      BIT(0)
+#define REMAP_COLUMNS       BIT(1)
+#define REMAP_SWAP          BIT(2)
+#define REMAP_COM_REVERSE   BIT(4)
+#define REMAP_SPLIT         BIT(5)
+
+OBJECT_DECLARE_SIMPLE_TYPE(Ssd1351State, SSD1351)
+
+struct Ssd1351State {
+    SSIPeripheral parent_obj;
+
+    PpPanel panel;
+    uint32_t width;
+    uint32_t height;
+    uint32_t seg_left;
+    uint32_t com_top;
+
+    /* GDDRAM: C in bits 17:12, B in 11:6, A in 5:0 */
+    uint32_t ram[SSD1351_SIZE * SSD1351_SIZE];
+    uint8_t cmd;
+    uint8_t nargs;              /* parameters the command takes */
+    uint8_t argc;               /* received so far */
+    uint8_t args[SSD1351_MAX_ARGS];
+    bool writing;               /* after 5Ch: data goes to RAM */
+    uint8_t pix[3];
+    uint8_t npix;
+
+    uint8_t col_start, col_end, row_start, row_end, col, row;
+    uint8_t remap;
+    uint8_t start_line;
+    uint8_t offset;
+    uint8_t mode;
+    uint8_t mux;
+    bool display_on;
+    bool locked;                /* FDh 16h */
+    bool protected_cmds;        /* FDh B0h */
+
+    bool dc;
+    bool in_reset;
+    bool vcc;
+};
+
+/* Number of parameters of each command, -1 for unknown */
+static int ssd1351_nargs(uint8_t cmd)
+{
+    switch (cmd) {
+    case 0x15: case 0x75:
+        return 2;
+    case 0xA0: case 0xA1: case 0xA2: case 0xAB: case 0xB1: case 0xB3:
+    case 0xB5: case 0xB6: case 0xBB: case 0xBE: case 0xC7: case 0xCA:
+    case 0xFD:
+        return 1;
+    case 0xB2: case 0xB4: case 0xC1:
+        return 3;
+    case 0x96:
+        return 5;
+    case 0xB8:
+        return 63;
+    case 0x5C: case 0x5D: case 0x9E: case 0x9F: case 0xA4 ... 0xA7:
+    case 0xAD: case 0xAE: case 0xAF: case 0xB0: case 0xB9: case 0xD1:
+    case 0xE3:
+        return 0;
+    default:
+        return -1;
+    }
+}
+
+static bool ssd1351_protected(uint8_t cmd)
+{
+    return cmd == 0xA2 || cmd == 0xB1 || cmd == 0xB3 || cmd == 0xBB ||
+           cmd == 0xBE || cmd == 0xC1;
+}
+
+static void ssd1351_registers_reset(Ssd1351State *s)
+{
+    s->cmd = 0;
+    s->nargs = 0;
+    s->argc = 0;
+    s->writing = false;
+    s->npix = 0;
+    s->col_start = 0;
+    s->col_end = SSD1351_SIZE - 1;
+    s->row_start = 0;
+    s->row_end = SSD1351_SIZE - 1;
+    s->col = 0;
+    s->row = 0;
+    s->remap = REMAP_SPLIT;
+    s->start_line = 0;
+    s->offset = 0x60;
+    s->mode = MODE_NORMAL;
+    s->mux = SSD1351_SIZE - 1;
+    s->display_on = false;
+    s->locked = false;
+    s->protected_cmds = true;
+    pp_panel_changed(&s->panel);
+}
+
+static void ssd1351_put_pixel(Ssd1351State *s, unsigned c, unsigned b,
+                              unsigned a)
+{
+    if (s->remap & REMAP_SWAP) {
+        unsigned t = a;
+
+        a = c;
+        c = t;
+    }
+    s->ram[s->row * SSD1351_SIZE + s->col] = c << 12 | b << 6 | a;
+    pp_panel_changed(&s->panel);
+    if (s->remap & REMAP_VERTICAL) {
+        if (s->row++ >= s->row_end) {
+            s->row = s->row_start;
+            if (s->col++ >= s->col_end) {
+                s->col = s->col_start;
+            }
+        }
+    } else if (s->col++ >= s->col_end) {
+        s->col = s->col_start;
+        if (s->row++ >= s->row_end) {
+            s->row = s->row_start;
+        }
+    }
+}
+
+static void ssd1351_data(Ssd1351State *s, uint8_t v)
+{
+    unsigned depth = s->remap >> 6;
+
+    s->pix[s->npix++] = v;
+    if (depth < 2 && s->npix == 2) {
+        unsigned w = s->pix[0] << 8 | s->pix[1];
+        unsigned c5 = w >> 11, a5 = w & 0x1F;
+
+        /* 5-bit A and C to the 6-bit RAM: the MSB fills the LSB */
+        ssd1351_put_pixel(s, c5 << 1 | c5 >> 4, (w >> 5) & 0x3F,
+                          a5 << 1 | a5 >> 4);
+        s->npix = 0;
+    } else if (depth >= 2 && s->npix == 3) {
+        if (depth == 3) {
+            qemu_log_mask(LOG_UNIMP, "ssd1351: 262k format 2 is not "
+                          "modelled; taken as 262k\n");
+        }
+        ssd1351_put_pixel(s, s->pix[0] & 0x3F, s->pix[1] & 0x3F,
+                          s->pix[2] & 0x3F);
+        s->npix = 0;
+    }
+}
+
+static void ssd1351_execute(Ssd1351State *s)
+{
+    const uint8_t *a = s->args;
+
+    if (s->protected_cmds && ssd1351_protected(s->cmd)) {
+        return;                 /* inaccessible until FDh B1h */
+    }
+    switch (s->cmd) {
+    case 0x15:
+        s->col_start = a[0] & 0x7F;
+        s->col_end = a[1] & 0x7F;
+        s->col = s->col_start;
+        break;
+    case 0x75:
+        s->row_start = a[0] & 0x7F;
+        s->row_end = a[1] & 0x7F;
+        s->row = s->row_start;
+        break;
+    case 0x5C:
+        s->writing = true;
+        s->npix = 0;
+        break;
+    case 0x5D:
+        qemu_log_mask(LOG_GUEST_ERROR, "ssd1351: Read RAM over SPI\n");
+        break;
+    case 0xA0:
+        s->remap = a[0];
+        if (!(a[0] & REMAP_SPLIT)) {
+            qemu_log_mask(LOG_UNIMP, "ssd1351: COM split off is not "
+                          "modelled\n");
+        }
+        break;
+    case 0xA1:
+        s->start_line = a[0] & 0x7F;
+        break;
+    case 0xA2:
+        s->offset = a[0] & 0x7F;
+        break;
+    case MODE_OFF ... MODE_INVERSE:
+        s->mode = s->cmd;
+        break;
+    case 0xAE:
+        s->display_on = false;
+        break;
+    case 0xAF:
+        s->display_on = true;
+        break;
+    case 0xCA:
+        s->mux = MAX(a[0] & 0x7F, 15);
+        break;
+    case 0xFD:
+        if (a[0] == 0x12 || a[0] == 0x16) {
+            s->locked = a[0] == 0x16;
+        } else if (a[0] == 0xB0 || a[0] == 0xB1) {
+            s->protected_cmds = a[0] == 0xB0;
+        }
+        break;
+    case 0x96: case 0x9E: case 0x9F:
+        qemu_log_mask(LOG_UNIMP, "ssd1351: scrolling (%02Xh) is not "
+                      "modelled\n", s->cmd);
+        break;
+    default:
+        break;                  /* timing, grey scale, contrast */
+    }
+    pp_panel_changed(&s->panel);
+}
+
+static uint32_t ssd1351_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    Ssd1351State *s = SSD1351(dev);
+    int n;
+
+    if (s->in_reset) {
+        return 0;
+    }
+    val &= 0xFF;
+    if (s->dc) {
+        if (s->locked && s->cmd != 0xFD) {
+            return 0;
+        }
+        if (s->argc < s->nargs) {
+            s->args[s->argc++] = val;
+            if (s->argc == s->nargs) {
+                ssd1351_execute(s);
+            }
+        } else if (s->writing) {
+            ssd1351_data(s, val);
+        }
+        return 0;
+    }
+    /* A command byte ends Write RAM */
+    s->writing = false;
+    s->cmd = val;
+    s->argc = 0;
+    s->nargs = 0;
+    if (s->locked && val != 0xFD) {
+        return 0;
+    }
+    n = ssd1351_nargs(val);
+    if (n < 0) {
+        qemu_log_mask(LOG_GUEST_ERROR, "ssd1351: unknown command %02Xh\n",
+                      val);
+        return 0;
+    }
+    s->nargs = n;
+    if (!n) {
+        ssd1351_execute(s);
+    }
+    return 0;
+}
+
+/* 6-bit channels of RAM pixel @v as RGB565, after the display mode */
+static uint16_t ssd1351_pixel(Ssd1351State *s, uint32_t v)
+{
+    unsigned c = (v >> 12) & 0x3F, b = (v >> 6) & 0x3F, a = v & 0x3F;
+
+    switch (s->mode) {
+    case MODE_OFF:
+        return 0;
+    case MODE_ON:
+        return 0xFFFF;
+    case MODE_INVERSE:
+        c ^= 0x3F;
+        b ^= 0x3F;
+        a ^= 0x3F;
+        break;
+    }
+    return (c >> 1) << 11 | b << 5 | a >> 1;
+}
+
+static void ssd1351_render(void *opaque, uint16_t *fb)
+{
+    Ssd1351State *s = opaque;
+
+    for (unsigned y = 0; y < s->height; y++) {
+        int com = (int)s->com_top - (int)y;
+        unsigned q = (unsigned)(com - s->offset) & 0x7F;
+        unsigned line, row;
+
+        for (unsigned x = 0; x < s->width; x++) {
+            fb[y * s->width + x] = 0;
+        }
+        if (!s->vcc || s->in_reset || !s->display_on || com < 0 ||
+            q > s->mux) {
+            continue;           /* dark: no supply, sleep, unscanned */
+        }
+        line = (s->remap & REMAP_COM_REVERSE) ? s->mux - q : q;
+        row = (s->start_line + line) & 0x7F;
+        for (unsigned x = 0; x < s->width; x++) {
+            int seg = (int)s->seg_left - (int)x;
+            unsigned col;
+
+            if (seg < 0) {
+                continue;
+            }
+            col = (s->remap & REMAP_COLUMNS) ? 127 - seg : seg;
+            fb[y * s->width + x] =
+                ssd1351_pixel(s, s->ram[row * SSD1351_SIZE + col]);
+        }
+    }
+}
+
+static void ssd1351_set_dc(void *opaque, int n, int level)
+{
+    SSD1351(opaque)->dc = level > 0;
+}
+
+static void ssd1351_set_reset(void *opaque, int n, int level)
+{
+    Ssd1351State *s = opaque;
+    bool low = level == 0;
+
+    if (low && !s->in_reset) {
+        ssd1351_registers_reset(s);
+    }
+    s->in_reset = low;
+    pp_panel_changed(&s->panel);
+}
+
+static void ssd1351_set_vcc(void *opaque, int n, int level)
+{
+    Ssd1351State *s = opaque;
+
+    s->vcc = level > 0;
+    pp_panel_changed(&s->panel);
+}
+
+static void ssd1351_realize(SSIPeripheral *dev, Error **errp)
+{
+    Ssd1351State *s = SSD1351(dev);
+
+    if (!s->width || !s->height || s->width > s->seg_left + 1 ||
+        s->height > s->com_top + 1 || s->seg_left >= SSD1351_SIZE ||
+        s->com_top >= SSD1351_SIZE) {
+        error_setg(errp, "the panel must lie within SEG0-127 and "
+                   "COM0-127");
+        return;
+    }
+    s->panel.width = s->width;
+    s->panel.height = s->height;
+    g_free(s->panel.fb);
+    s->panel.fb = g_new0(uint16_t, s->width * s->height);
+    qdev_init_gpio_in_named(DEVICE(dev), ssd1351_set_dc, SSD1351_DC, 1);
+    qdev_init_gpio_in_named(DEVICE(dev), ssd1351_set_reset,
+                            SSD1351_RESET, 1);
+    qdev_init_gpio_in_named(DEVICE(dev), ssd1351_set_vcc, SSD1351_VCC, 1);
+}
+
+static void ssd1351_reset(DeviceState *dev)
+{
+    Ssd1351State *s = SSD1351(dev);
+
+    ssd1351_registers_reset(s);
+    /* Power-on: RAM undefined (cleared here), CS high, RES# released */
+    memset(s->ram, 0, sizeof(s->ram));
+    s->parent_obj.cs = true;
+    s->in_reset = false;
+}
+
+static void ssd1351_init(Object *obj)
+{
+    Ssd1351State *s = SSD1351(obj);
+
+    pp_panel_init(&s->panel, obj, 1, 1, ssd1351_render, s);
+}
+
+static void ssd1351_finalize(Object *obj)
+{
+    g_free(SSD1351(obj)->panel.fb);
+}
+
+static int ssd1351_post_load(void *opaque, int version_id)
+{
+    pp_panel_changed(&SSD1351(opaque)->panel);
+    return 0;
+}
+
+static const Property ssd1351_properties[] = {
+    DEFINE_PROP_UINT32("width", Ssd1351State, width, 96),
+    DEFINE_PROP_UINT32("height", Ssd1351State, height, 96),
+    DEFINE_PROP_UINT32("seg-left", Ssd1351State, seg_left, 111),
+    DEFINE_PROP_UINT32("com-top", Ssd1351State, com_top, 127),
+};
+
+static const VMStateDescription vmstate_ssd1351 = {
+    .name = TYPE_SSD1351,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = ssd1351_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, Ssd1351State),
+        VMSTATE_UINT32_ARRAY(ram, Ssd1351State,
+                             SSD1351_SIZE * SSD1351_SIZE),
+        VMSTATE_UINT8(cmd, Ssd1351State),
+        VMSTATE_UINT8(nargs, Ssd1351State),
+        VMSTATE_UINT8(argc, Ssd1351State),
+        VMSTATE_UINT8_ARRAY(args, Ssd1351State, SSD1351_MAX_ARGS),
+        VMSTATE_BOOL(writing, Ssd1351State),
+        VMSTATE_UINT8_ARRAY(pix, Ssd1351State, 3),
+        VMSTATE_UINT8(npix, Ssd1351State),
+        VMSTATE_UINT8(col_start, Ssd1351State),
+        VMSTATE_UINT8(col_end, Ssd1351State),
+        VMSTATE_UINT8(row_start, Ssd1351State),
+        VMSTATE_UINT8(row_end, Ssd1351State),
+        VMSTATE_UINT8(col, Ssd1351State),
+        VMSTATE_UINT8(row, Ssd1351State),
+        VMSTATE_UINT8(remap, Ssd1351State),
+        VMSTATE_UINT8(start_line, Ssd1351State),
+        VMSTATE_UINT8(offset, Ssd1351State),
+        VMSTATE_UINT8(mode, Ssd1351State),
+        VMSTATE_UINT8(mux, Ssd1351State),
+        VMSTATE_BOOL(display_on, Ssd1351State),
+        VMSTATE_BOOL(locked, Ssd1351State),
+        VMSTATE_BOOL(protected_cmds, Ssd1351State),
+        VMSTATE_BOOL(dc, Ssd1351State),
+        VMSTATE_BOOL(in_reset, Ssd1351State),
+        VMSTATE_BOOL(vcc, Ssd1351State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void ssd1351_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    dc->desc = "SSD1351 128x128 RGB OLED driver";
+    dc->vmsd = &vmstate_ssd1351;
+    device_class_set_props(dc, ssd1351_properties);
+    device_class_set_legacy_reset(dc, ssd1351_reset);
+    k->realize = ssd1351_realize;
+    k->transfer = ssd1351_transfer;
+    k->cs_polarity = SSI_CS_LOW;
+}
+
+static const TypeInfo ssd1351_types[] = {
+    {
+        .name = TYPE_SSD1351,
+        .parent = TYPE_SSI_PERIPHERAL,
+        .instance_size = sizeof(Ssd1351State),
+        .instance_init = ssd1351_init,
+        .instance_finalize = ssd1351_finalize,
+        .class_init = ssd1351_class_init,
+    },
+};
+
+DEFINE_TYPES(ssd1351_types)
