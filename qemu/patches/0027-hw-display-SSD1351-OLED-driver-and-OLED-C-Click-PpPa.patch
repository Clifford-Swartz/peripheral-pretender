+/* One SSD1351 command or data byte on mikroBUS 2: CS PE2, D/C on PWM PD1 */
+static void oled_byte(QTestState *qts, bool data, uint8_t v)
+{
+    qtest_writeb(qts, PORTD + (data ? 0x05 : 0x06), BIT(1));
+    qtest_writeb(qts, PORTE + 0x06, BIT(2));
+    qtest_writeb(qts, SPI0 + 4, v);
+    qtest_writeb(qts, PORTE + 0x05, BIT(2));
+}
+
+/* OLED C Click on mikroBUS 2: pulls, then one red pixel at the top left */
+static void test_oledc(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb2=oledc -kernel %s",
+                                  (const char *)fw);
+    static const uint8_t init[][2] = {
+        { 0xFD, 0x12 }, { 0xFD, 0xB1 }, { 0xA0, 0x32 }, { 0xCA, 95 },
+        { 0xA1, 0x00 }, { 0xA2, 0x20 },
+    };
+    g_autofree char *frame = NULL;
+    g_autofree guchar *fb = NULL;
+    gsize len;
+
+    g_assert_cmphex(qtest_readb(qts, PORTE + P_IN) & BIT(2), ==, BIT(2));
+    g_assert_cmphex(qtest_readb(qts, PORTF + P_IN) & BIT(3), ==, BIT(3));
+    g_assert_cmphex(qtest_readb(qts, PORTF + P_IN) & BIT(2), ==, 0);
+    g_assert_cmpuint(qom_uint(qts, "/machine/mb2-click", "panel-width"), ==,
+                     96);
+    qtest_writeb(qts, PORTF + 0x05, BIT(2));            /* EN: 15 V on */
+    qtest_writeb(qts, PORTF + P_DIRSET, BIT(2));
+    qtest_writeb(qts, PORTE + 0x05, BIT(2));
+    qtest_writeb(qts, PORTE + P_DIRSET, BIT(2));
+    qtest_writeb(qts, PORTD + P_DIRSET, BIT(1));
+    qtest_writeb(qts, PORTA + 0x01, BIT(4) | BIT(6));
+    qtest_writeb(qts, SPI0 + 0, 0x21);                  /* MASTER, ENABLE */
+    for (unsigned i = 0; i < ARRAY_SIZE(init); i++) {
+        oled_byte(qts, false, init[i][0]);
+        oled_byte(qts, true, init[i][1]);
+    }
+    oled_byte(qts, false, 0xAF);
+    oled_byte(qts, false, 0x15);
+    oled_byte(qts, true, 16);
+    oled_byte(qts, true, 16);
+    oled_byte(qts, false, 0x75);
+    oled_byte(qts, true, 0);
+    oled_byte(qts, true, 0);
+    oled_byte(qts, false, 0x5C);
+    oled_byte(qts, true, 0xF8);
+    oled_byte(qts, true, 0x00);
+    frame = qom_str(qts, "/machine/mb2-click", "frame");
+    fb = g_base64_decode(frame, &len);
+    g_assert_cmpuint(len, ==, 96 * 96 * 2);
+    g_assert_cmphex(fb[0] << 8 | fb[1], ==, 0xF800);
+    g_assert_cmphex(fb[2] << 8 | fb[3], ==, 0);
+    qtest_quit(qts);
+}
+
