diff --git a/tests/qtest/pic32cm-click-test.c b/tests/qtest/pic32cm-click-test.c
index a2aa5fd..f093a5a 100644
--- a/tests/qtest/pic32cm-click-test.c
+++ b/tests/qtest/pic32cm-click-test.c
@@ -404,6 +404,143 @@ static void test_two_spi(void)
     qtest_quit(qts);
 }
 
+/* OLED C Click on EXT2: CS PA15, D/C on PWM PB22, RES# PA10, EN on INT PA28 */
+#define OLED_CS         15
+#define OLED_DC         22
+#define OLED_RST        10
+#define OLED_EN         28
+
+static void oled_bytes(QTestState *qts, bool data, const uint8_t *b,
+                       unsigned n)
+{
+    qtest_writel(qts, PB + (data ? P_OUTSET : P_OUTCLR), BIT(OLED_DC));
+    qtest_writel(qts, PA + P_OUTCLR, BIT(OLED_CS));
+    for (unsigned i = 0; i < n; i++) {
+        spi_byte(qts, b[i]);
+    }
+    qtest_writel(qts, PA + P_OUTSET, BIT(OLED_CS));
+}
+
+static void oled_cmd(QTestState *qts, uint8_t cmd, const uint8_t *args,
+                     unsigned n)
+{
+    oled_bytes(qts, false, &cmd, 1);
+    if (n) {
+        oled_bytes(qts, true, args, n);
+    }
+}
+
+/* Pixel (x, y) of the panel picture, RGB565 */
+static uint16_t oled_pixel(QTestState *qts, unsigned x, unsigned y)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments': {"
+                           " 'path': '" CLICK2 "', 'property': 'frame' } }");
+    gsize len;
+    g_autofree guchar *fb = g_base64_decode(qdict_get_str(rsp, "return"),
+                                            &len);
+    uint16_t v;
+
+    g_assert_cmpuint(len, ==, 96 * 96 * 2);
+    v = fb[(y * 96 + x) * 2] << 8 | fb[(y * 96 + x) * 2 + 1];
+    qobject_unref(rsp);
+    return v;
+}
+
+/* MikroElektronika's oledc_default_cfg(), then red/green/blue/white 2x2 */
+static QTestState *oled_init(bool unlock)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext2=oledc ");
+    static const uint8_t px[] = { 0xF8, 0x00, 0x07, 0xE0, 0x00, 0x1F,
+                                  0xFF, 0xFF };
+
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16);
+    qtest_writel(qts, SERCOM1 + 0x00, 3 << 2 | 1 << 16 | 0x02);
+    qtest_writel(qts, PA + P_OUTSET, BIT(OLED_CS) | BIT(OLED_RST) |
+                                     BIT(OLED_EN));
+    qtest_writel(qts, PA + P_DIRSET, BIT(OLED_CS) | BIT(OLED_RST) |
+                                     BIT(OLED_EN));
+    qtest_writel(qts, PB + P_DIRSET, BIT(OLED_DC));
+    qtest_writel(qts, PA + P_OUTCLR, BIT(OLED_RST));
+    qtest_writel(qts, PA + P_OUTSET, BIT(OLED_RST));
+    oled_cmd(qts, 0xFD, (const uint8_t[]){ 0x12 }, 1);
+    if (unlock) {
+        oled_cmd(qts, 0xFD, (const uint8_t[]){ 0xB1 }, 1);
+    }
+    oled_cmd(qts, 0xAE, NULL, 0);
+    oled_cmd(qts, 0xA0, (const uint8_t[]){ 0x32 }, 1);
+    oled_cmd(qts, 0xCA, (const uint8_t[]){ 95 }, 1);
+    oled_cmd(qts, 0xA1, (const uint8_t[]){ 0x80 }, 1);
+    oled_cmd(qts, 0xA2, (const uint8_t[]){ 0x20 }, 1);
+    oled_cmd(qts, 0xB8, (const uint8_t[63]){ 0 }, 63);  /* grey table */
+    oled_cmd(qts, 0xC1, (const uint8_t[]){ 0x8A, 0x51, 0x8A }, 3);
+    oled_cmd(qts, 0xA6, NULL, 0);
+    oled_cmd(qts, 0xAF, NULL, 0);
+    oled_cmd(qts, 0x15, (const uint8_t[]){ 16, 17 }, 2);
+    oled_cmd(qts, 0x75, (const uint8_t[]){ 0, 1 }, 2);
+    oled_cmd(qts, 0x5C, NULL, 0);
+    oled_bytes(qts, true, px, sizeof(px));
+    return qts;
+}
+
+static void test_oledc(void)
+{
+    QTestState *qts = qtest_init("-M pic32cm-mc00-cpro,ext2=oledc ");
+    uint32_t gen;
+
+    g_assert_cmpint(qom_int(qts, CLICK2, "panel-width"), ==, 96);
+    g_assert_cmpint(qom_int(qts, CLICK2, "panel-height"), ==, 96);
+    g_assert_cmphex(oled_pixel(qts, 0, 0), ==, 0);
+    /* Pull resistors: CS and RES# high (R7, R8), EN low (R9) */
+    g_assert_true(pin_high(qts, PA, OLED_CS));
+    g_assert_true(pin_high(qts, PA, OLED_RST));
+    g_assert_false(pin_high(qts, PA, OLED_EN));
+    qtest_quit(qts);
+
+    qts = oled_init(true);
+    g_assert_cmphex(oled_pixel(qts, 0, 0), ==, 0xF800);
+    g_assert_cmphex(oled_pixel(qts, 1, 0), ==, 0x07E0);
+    g_assert_cmphex(oled_pixel(qts, 0, 1), ==, 0x001F);
+    g_assert_cmphex(oled_pixel(qts, 1, 1), ==, 0xFFFF);
+    g_assert_cmphex(oled_pixel(qts, 2, 0), ==, 0);
+    oled_cmd(qts, 0xA7, NULL, 0);                       /* inverse */
+    g_assert_cmphex(oled_pixel(qts, 0, 0), ==, 0x07FF);
+    oled_cmd(qts, 0xA5, NULL, 0);                       /* all on */
+    g_assert_cmphex(oled_pixel(qts, 50, 50), ==, 0xFFFF);
+    oled_cmd(qts, 0xA6, NULL, 0);
+    /* BGR order: the same bytes land in A and C swapped */
+    oled_cmd(qts, 0xA0, (const uint8_t[]){ 0x36 }, 1);
+    oled_cmd(qts, 0x15, (const uint8_t[]){ 16, 16 }, 2);
+    oled_cmd(qts, 0x75, (const uint8_t[]){ 0, 0 }, 2);
+    oled_cmd(qts, 0x5C, NULL, 0);
+    oled_bytes(qts, true, (const uint8_t[]){ 0xF8, 0x00 }, 2);
+    g_assert_cmphex(oled_pixel(qts, 0, 0), ==, 0x001F);
+    /* Locked: commands are ignored until FDh 12h */
+    gen = qom_int(qts, CLICK2, "frame-gen");
+    oled_cmd(qts, 0xFD, (const uint8_t[]){ 0x16 }, 1);
+    oled_cmd(qts, 0xAE, NULL, 0);
+    g_assert_cmphex(oled_pixel(qts, 0, 0), ==, 0x001F);
+    oled_cmd(qts, 0xFD, (const uint8_t[]){ 0x12 }, 1);
+    oled_cmd(qts, 0xAE, NULL, 0);                       /* sleep */
+    g_assert_cmphex(oled_pixel(qts, 0, 0), ==, 0);
+    g_assert_cmpint(qom_int(qts, CLICK2, "frame-gen"), >, gen);
+    oled_cmd(qts, 0xAF, NULL, 0);
+    /* The 15 V supply (EN on INT) off: dark, RAM kept */
+    qtest_writel(qts, PA + P_OUTCLR, BIT(OLED_EN));
+    g_assert_cmphex(oled_pixel(qts, 0, 0), ==, 0);
+    qtest_writel(qts, PA + P_OUTSET, BIT(OLED_EN));
+    g_assert_cmphex(oled_pixel(qts, 1, 1), ==, 0xFFFF);
+    /* RES# low: registers to reset values (display off) */
+    qtest_writel(qts, PA + P_OUTCLR, BIT(OLED_RST));
+    qtest_writel(qts, PA + P_OUTSET, BIT(OLED_RST));
+    g_assert_cmphex(oled_pixel(qts, 1, 1), ==, 0);
+    qtest_quit(qts);
+
+    /* Without FDh B1h the display offset (A2h) stays 60h after reset */
+    qts = oled_init(false);
+    g_assert_cmphex(oled_pixel(qts, 0, 0), !=, 0xF800);
+    qtest_quit(qts);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
@@ -412,6 +549,7 @@ int main(int argc, char **argv)
     qtest_add_func("pic32cm-click/relay", test_relay);
     qtest_add_func("pic32cm-click/buzz", test_buzz);
     qtest_add_func("pic32cm-click/two-spi", test_two_spi);
+    qtest_add_func("pic32cm-click/oledc", test_oledc);
     qtest_add_func("pic32cm-click/thermo8-identity", test_identity);
     qtest_add_func("pic32cm-click/not-fitted", test_not_fitted);
