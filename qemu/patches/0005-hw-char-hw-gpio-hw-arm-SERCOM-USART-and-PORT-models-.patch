diff --git a/tests/qtest/pic32cm-jh-port-test.c b/tests/qtest/pic32cm-jh-port-test.c
new file mode 100644
index 0000000..83964b8
--- /dev/null
+++ b/tests/qtest/pic32cm-jh-port-test.c
@@ -0,0 +1,241 @@
+/*
+ * QTest for the PORT of the PIC32CM JH01 (pic32cm-jh01-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Addresses and values come from DS60001632H chapter 27, not from the
+ * generated tables, so the test checks them.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qobject/qdict.h"
+
+#define MACHINE         "-M pic32cm-jh01-cpro "
+
+#define PORT            0x41000000
+#define PORT_IOBUS      0x60000000
+#define GROUP(g)        (PORT + (g) * 0x80)
+#define PA              GROUP(0)
+#define PB              GROUP(1)
+#define PC              GROUP(2)
+
+#define P_DIR           0x00
+#define P_DIRCLR        0x04
+#define P_DIRSET        0x08
+#define P_DIRTGL        0x0C
+#define P_OUT           0x10
+#define P_OUTCLR        0x14
+#define P_OUTSET        0x18
+#define P_OUTTGL        0x1C
+#define P_IN            0x20
+#define P_WRCONFIG      0x28
+#define P_PMUX          0x30
+#define P_PINCFG        0x40
+
+#define PINCFG_PMUXEN   0x01
+#define PINCFG_INEN     0x02
+#define PINCFG_PULLEN   0x04
+
+#define SW0_PIN         19      /* PB19 */
+#define LED0_PIN        5       /* PC05 */
+
+static uint32_t port_prop(QTestState *qts, const char *name)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments':"
+                           " { 'path': '/machine/soc/port',"
+                           " 'property': %s } }", name);
+    uint32_t value;
+
+    g_assert(qdict_haskey(rsp, "return"));
+    value = qdict_get_int(rsp, "return");
+    qobject_unref(rsp);
+    return value;
+}
+
+static void port_set(QTestState *qts, const char *name, uint32_t value)
+{
+    QDict *rsp = qtest_qmp(qts, "{ 'execute': 'qom-set', 'arguments':"
+                           " { 'path': '/machine/soc/port',"
+                           " 'property': %s, 'value': %u } }", name, value);
+
+    g_assert(qdict_haskey(rsp, "return"));
+    qobject_unref(rsp);
+}
+
+static void test_reset_values(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    for (unsigned g = 0; g < 3; g++) {
+        g_assert_cmphex(qtest_readl(qts, GROUP(g) + P_DIR), ==, 0);
+        g_assert_cmphex(qtest_readl(qts, GROUP(g) + P_OUT), ==, 0);
+        g_assert_cmphex(qtest_readl(qts, GROUP(g) + P_IN), ==, 0);
+        g_assert_cmphex(qtest_readl(qts, GROUP(g) + P_PINCFG), ==, 0);
+    }
+    /* PA30 (SWCLK) starts on function G (DS 27.7.13) */
+    g_assert_cmphex(qtest_readb(qts, PA + P_PMUX + 15), ==, 0x06);
+    qtest_quit(qts);
+}
+
+static void test_set_clr_tgl(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, PC + P_DIRSET, 0x00000021);
+    g_assert_cmphex(qtest_readl(qts, PC + P_DIR), ==, 0x00000021);
+    g_assert_cmphex(qtest_readl(qts, PC + P_DIRSET), ==, 0x00000021);
+    qtest_writel(qts, PC + P_DIRCLR, 0x00000001);
+    g_assert_cmphex(qtest_readl(qts, PC + P_DIR), ==, 0x00000020);
+    qtest_writel(qts, PC + P_DIRTGL, 0x00000030);
+    g_assert_cmphex(qtest_readl(qts, PC + P_DIR), ==, 0x00000010);
+
+    qtest_writel(qts, PC + P_OUTSET, 0x80000003);
+    g_assert_cmphex(qtest_readl(qts, PC + P_OUT), ==, 0x80000003);
+    qtest_writel(qts, PC + P_OUTCLR, 0x00000001);
+    g_assert_cmphex(qtest_readl(qts, PC + P_OUT), ==, 0x80000002);
+    qtest_writel(qts, PC + P_OUTTGL, 0x80000004);
+    g_assert_cmphex(qtest_readl(qts, PC + P_OUT), ==, 0x00000006);
+
+    /* The other groups are untouched */
+    g_assert_cmphex(qtest_readl(qts, PB + P_DIR), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, PB + P_OUT), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_pincfg_pmux(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* PB10/PB11 to SERCOM4 (function D), as Harmony does */
+    qtest_writeb(qts, PB + P_PINCFG + 10, PINCFG_PMUXEN);
+    qtest_writeb(qts, PB + P_PINCFG + 11, PINCFG_PMUXEN | PINCFG_INEN);
+    qtest_writeb(qts, PB + P_PMUX + 5, 0x33);
+    g_assert_cmphex(qtest_readb(qts, PB + P_PINCFG + 10), ==, PINCFG_PMUXEN);
+    g_assert_cmphex(qtest_readb(qts, PB + P_PINCFG + 11), ==,
+                    PINCFG_PMUXEN | PINCFG_INEN);
+    g_assert_cmphex(qtest_readl(qts, PB + P_PINCFG + 8), ==, 0x03010000);
+    g_assert_cmphex(qtest_readb(qts, PB + P_PMUX + 5), ==, 0x33);
+
+    /*
+     * P_WRCONFIG: PINMASK PB16/PB17 (HWSEL), WRPMUX + WRPINCFG, P_PMUX 2,
+     * PMUXEN + INEN
+     */
+    qtest_writel(qts, PB + P_WRCONFIG,
+                 BIT(31) | BIT(30) | BIT(28) | (2 << 24) | (0x03 << 16) |
+                 0x0003);
+    g_assert_cmphex(qtest_readb(qts, PB + P_PINCFG + 16), ==,
+                    PINCFG_PMUXEN | PINCFG_INEN);
+    g_assert_cmphex(qtest_readb(qts, PB + P_PINCFG + 17), ==,
+                    PINCFG_PMUXEN | PINCFG_INEN);
+    g_assert_cmphex(qtest_readb(qts, PB + P_PINCFG + 18), ==, 0);
+    g_assert_cmphex(qtest_readb(qts, PB + P_PMUX + 8), ==, 0x22);
+    /* P_WRCONFIG reads as 0 */
+    g_assert_cmphex(qtest_readl(qts, PB + P_WRCONFIG), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_iobus_alias(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, PORT_IOBUS + 0x80 + P_DIRSET, BIT(7));
+    g_assert_cmphex(qtest_readl(qts, PB + P_DIR), ==, BIT(7));
+    qtest_writel(qts, PB + P_OUTSET, BIT(7));
+    g_assert_cmphex(qtest_readl(qts, PORT_IOBUS + 0x80 + P_OUT), ==, BIT(7));
+    qtest_quit(qts);
+}
+
+static void test_in(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    /* An output reads back through P_IN only with the input buffer on */
+    qtest_writel(qts, PA + P_DIRSET, BIT(3));
+    qtest_writel(qts, PA + P_OUTSET, BIT(3));
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN), ==, 0);
+    qtest_writeb(qts, PA + P_PINCFG + 3, PINCFG_INEN);
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN), ==, BIT(3));
+
+    /* A floating input with a pull-up (P_OUT = 1) reads 1, pull-down 0 */
+    qtest_writeb(qts, PA + P_PINCFG + 4, PINCFG_INEN | PINCFG_PULLEN);
+    qtest_writel(qts, PA + P_OUTSET, BIT(4));
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(4), ==, BIT(4));
+    qtest_writel(qts, PA + P_OUTCLR, BIT(4));
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(4), ==, 0);
+
+    /* External drivers through QOM win over the pull */
+    qtest_writel(qts, PA + P_OUTSET, BIT(4));
+    port_set(qts, "pa-in", 0);
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(4), ==, 0);
+    g_assert_cmphex(port_prop(qts, "pa-in-mask"), ==, 0xFFFFFFFF);
+    port_set(qts, "pa-in-mask", 0);
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(4), ==, BIT(4));
+
+    /* The PORT's own output beats the external driver */
+    port_set(qts, "pa-in", 0);
+    g_assert_cmphex(qtest_readl(qts, PA + P_IN) & BIT(3), ==, BIT(3));
+    qtest_quit(qts);
+}
+
+static void test_sw0(void)
+{
+    QTestState *qts = qtest_init(MACHINE "-machine sw0-pressed=on");
+
+    /* SW0 pulls PB19 to ground; Harmony enables INEN and the pull-up */
+    qtest_writeb(qts, PB + P_PINCFG + SW0_PIN, PINCFG_INEN | PINCFG_PULLEN);
+    qtest_writel(qts, PB + P_OUTSET, BIT(SW0_PIN));
+    g_assert_cmphex(qtest_readl(qts, PB + P_IN) & BIT(SW0_PIN), ==, 0);
+
+    qtest_qom_set_bool(qts, "/machine", "sw0-pressed", false);
+    g_assert_cmphex(qtest_readl(qts, PB + P_IN) & BIT(SW0_PIN), ==,
+                    BIT(SW0_PIN));
+    qtest_qom_set_bool(qts, "/machine", "sw0-pressed", true);
+    g_assert_cmphex(qtest_readl(qts, PB + P_IN) & BIT(SW0_PIN), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_gpio_out(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+    unsigned led = 2 * 32 + LED0_PIN;
+
+    qtest_irq_intercept_out_named(qts, "/machine/soc/port", "port-out");
+
+    /* PC05 as an output, high: LED0 off */
+    qtest_writel(qts, PC + P_OUTSET, BIT(LED0_PIN));
+    g_assert_cmphex(port_prop(qts, "pc-out-mask"), ==, 0);
+    qtest_writel(qts, PC + P_DIRSET, BIT(LED0_PIN));
+    g_assert_cmphex(port_prop(qts, "pc-out-mask"), ==, BIT(LED0_PIN));
+    g_assert_cmphex(port_prop(qts, "pc-out"), ==, BIT(LED0_PIN));
+    g_assert_true(qtest_get_irq(qts, led));
+
+    /* Low: LED0 on */
+    qtest_writel(qts, PC + P_OUTTGL, BIT(LED0_PIN));
+    g_assert_cmphex(port_prop(qts, "pc-out"), ==, 0);
+    g_assert_false(qtest_get_irq(qts, led));
+
+    /* Handing the pin to a peripheral releases the pad */
+    qtest_writeb(qts, PC + P_PINCFG + LED0_PIN, PINCFG_PMUXEN);
+    g_assert_cmphex(port_prop(qts, "pc-out-mask"), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-jh/port/reset-values", test_reset_values);
+    qtest_add_func("pic32cm-jh/port/set-clr-tgl", test_set_clr_tgl);
+    qtest_add_func("pic32cm-jh/port/pincfg-pmux", test_pincfg_pmux);
+    qtest_add_func("pic32cm-jh/port/iobus-alias", test_iobus_alias);
+    qtest_add_func("pic32cm-jh/port/in", test_in);
+    qtest_add_func("pic32cm-jh/port/sw0", test_sw0);
+    qtest_add_func("pic32cm-jh/port/gpio-out", test_gpio_out);
+
+    return g_test_run();
+}
diff --git a/tests/qtest/pic32cm-jh-sercom-test.c b/tests/qtest/pic32cm-jh-sercom-test.c
new file mode 100644
index 0000000..73b1188
--- /dev/null
+++ b/tests/qtest/pic32cm-jh-sercom-test.c
@@ -0,0 +1,239 @@
+/*
+ * QTest for the SERCOM USART of the PIC32CM JH01 (pic32cm-jh01-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Addresses and values come from DS60001632H chapter 30, not from the
+ * generated tables, so the test checks them. SERCOM4 is the EDBG virtual
+ * COM port, the first -serial of the board.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+#include "qemu/sockets.h"
+
+#define MACHINE         "-M pic32cm-jh01-cpro "
+
+#define SERCOM4         0x42001400
+#define SERCOM4_IRQ     13
+
+#define U_CTRLA         0x00
+#define U_CTRLB         0x04
+#define U_BAUD          0x0C
+#define U_INTENCLR      0x14
+#define U_INTENSET      0x16
+#define U_INTFLAG       0x18
+#define U_STATUS        0x1A
+#define U_SYNCBUSY      0x1C
+#define U_DATA          0x28
+
+#define INT_DRE         0x01
+#define INT_TXC         0x02
+#define INT_RXC         0x04
+
+/* USART_INT, LSB first, RXPO 3, TXPO 1, as Harmony sets it for the VCOM */
+#define U_CTRLA_VCOM    0x40310004
+#define U_CTRLA_ENABLE  0x00000002
+#define U_CTRLB_TXEN    0x00010000
+#define U_CTRLB_RXEN    0x00020000
+#define U_BAUD_115200   63019
+
+#define NVIC_ISPR       0xE000E200
+#define NVIC_ICPR       0xE000E280
+
+static uint32_t sercom_readb(QTestState *qts, uint32_t reg)
+{
+    return qtest_readb(qts, SERCOM4 + reg);
+}
+
+static bool irq_pending(QTestState *qts)
+{
+    return qtest_readl(qts, NVIC_ISPR) & BIT(SERCOM4_IRQ);
+}
+
+static void irq_clear(QTestState *qts)
+{
+    qtest_writel(qts, NVIC_ICPR, BIT(SERCOM4_IRQ));
+}
+
+/* Program the VCOM settings and enable the USART */
+static void usart_enable(QTestState *qts, uint32_t ctrlb)
+{
+    qtest_writel(qts, SERCOM4 + U_CTRLA, U_CTRLA_VCOM);
+    qtest_writew(qts, SERCOM4 + U_BAUD, U_BAUD_115200);
+    qtest_writel(qts, SERCOM4 + U_CTRLB, ctrlb);
+    qtest_writel(qts, SERCOM4 + U_CTRLA, U_CTRLA_VCOM | U_CTRLA_ENABLE);
+}
+
+static void wait_for_flag(QTestState *qts, uint32_t flag)
+{
+    for (int i = 0; i < 5000; i++) {
+        if (sercom_readb(qts, U_INTFLAG) & flag) {
+            return;
+        }
+        g_usleep(1000);
+    }
+    g_assert_not_reached();
+}
+
+static void test_reset_values(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    g_assert_cmphex(qtest_readl(qts, SERCOM4 + U_CTRLA), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, SERCOM4 + U_CTRLB), ==, 0);
+    g_assert_cmphex(qtest_readw(qts, SERCOM4 + U_BAUD), ==, 0);
+    g_assert_cmphex(sercom_readb(qts, U_INTENSET), ==, 0);
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG), ==, 0);
+    g_assert_cmphex(qtest_readw(qts, SERCOM4 + U_STATUS), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, SERCOM4 + U_SYNCBUSY), ==, 0);
+    g_assert_cmphex(qtest_readw(qts, SERCOM4 + U_DATA), ==, 0);
+
+    /* DRE needs the transmitter: enabled USART and U_CTRLB.TXEN */
+    qtest_writel(qts, SERCOM4 + U_CTRLA, U_CTRLA_VCOM | U_CTRLA_ENABLE);
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_tx(void)
+{
+    int sock;
+    QTestState *qts = qtest_init_with_serial(MACHINE, &sock);
+    char c;
+
+    usart_enable(qts, U_CTRLB_TXEN | U_CTRLB_RXEN);
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG), ==, INT_DRE);
+
+    qtest_writew(qts, SERCOM4 + U_DATA, 'P');
+    g_assert_cmpint(recv(sock, &c, 1, 0), ==, 1);
+    g_assert_cmpint(c, ==, 'P');
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG), ==, INT_DRE | INT_TXC);
+
+    /* W1C clears TXC; DRE and RXC follow the buffers only */
+    qtest_writeb(qts, SERCOM4 + U_INTFLAG, 0xFF);
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG), ==, INT_DRE);
+
+    /* Writing U_DATA clears TXC too, until the frame is out */
+    qtest_writew(qts, SERCOM4 + U_DATA, 'X');
+    g_assert_cmpint(recv(sock, &c, 1, 0), ==, 1);
+    g_assert_cmpint(c, ==, 'X');
+
+    closesocket(sock);
+    qtest_quit(qts);
+}
+
+static void test_intenset_alias(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    usart_enable(qts, U_CTRLB_TXEN);
+    g_assert_false(irq_pending(qts));
+
+    qtest_writeb(qts, SERCOM4 + U_INTENSET, INT_DRE);
+    g_assert_cmphex(sercom_readb(qts, U_INTENSET), ==, INT_DRE);
+    g_assert_cmphex(sercom_readb(qts, U_INTENCLR), ==, INT_DRE);
+    g_assert_true(irq_pending(qts));
+
+    qtest_writeb(qts, SERCOM4 + U_INTENCLR, INT_DRE);
+    g_assert_cmphex(sercom_readb(qts, U_INTENSET), ==, 0);
+    irq_clear(qts);
+    g_assert_false(irq_pending(qts));
+    qtest_quit(qts);
+}
+
+static void test_rx(void)
+{
+    int sock;
+    QTestState *qts = qtest_init_with_serial(MACHINE, &sock);
+
+    usart_enable(qts, U_CTRLB_TXEN | U_CTRLB_RXEN);
+    qtest_writeb(qts, SERCOM4 + U_INTENSET, INT_RXC);
+    g_assert_false(irq_pending(qts));
+
+    g_assert_cmpint(send(sock, "ab", 2, 0), ==, 2);
+    wait_for_flag(qts, INT_RXC);
+    g_assert_true(irq_pending(qts));
+
+    /* A debugger read (gdbstub, monitor x) does not pop the receive buffer */
+    g_free(qtest_hmp(qts, "x /1hx 0x%x", SERCOM4 + U_DATA));
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG) & INT_RXC, ==, INT_RXC);
+
+    /* W1C does not clear RXC */
+    qtest_writeb(qts, SERCOM4 + U_INTFLAG, INT_RXC);
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG) & INT_RXC, ==, INT_RXC);
+
+    g_assert_cmphex(qtest_readw(qts, SERCOM4 + U_DATA), ==, 'a');
+    wait_for_flag(qts, INT_RXC);
+    g_assert_cmphex(qtest_readw(qts, SERCOM4 + U_DATA), ==, 'b');
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG) & INT_RXC, ==, 0);
+    irq_clear(qts);
+    g_assert_false(irq_pending(qts));
+
+    /* Disabling the receiver flushes it */
+    g_assert_cmpint(send(sock, "c", 1, 0), ==, 1);
+    wait_for_flag(qts, INT_RXC);
+    qtest_writel(qts, SERCOM4 + U_CTRLB, U_CTRLB_TXEN);
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG) & INT_RXC, ==, 0);
+
+    closesocket(sock);
+    qtest_quit(qts);
+}
+
+static void test_status_w1c(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    usart_enable(qts, U_CTRLB_TXEN | U_CTRLB_RXEN);
+    /* Writing 1 never sets a flag, and CTS is read-only */
+    qtest_writew(qts, SERCOM4 + U_STATUS, 0xFFFF);
+    g_assert_cmphex(qtest_readw(qts, SERCOM4 + U_STATUS), ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_enable_protect(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    usart_enable(qts, U_CTRLB_TXEN | U_CTRLB_RXEN);
+
+    /* U_BAUD and U_CTRLA (but ENABLE and SWRST) are enable-protected */
+    qtest_writew(qts, SERCOM4 + U_BAUD, 0x1234);
+    g_assert_cmphex(qtest_readw(qts, SERCOM4 + U_BAUD), ==, U_BAUD_115200);
+    qtest_writel(qts, SERCOM4 + U_CTRLA, U_CTRLA_ENABLE);
+    g_assert_cmphex(qtest_readl(qts, SERCOM4 + U_CTRLA), ==,
+                    U_CTRLA_VCOM | U_CTRLA_ENABLE);
+
+    /* U_CTRLB: only RXEN and TXEN may change while enabled */
+    qtest_writel(qts, SERCOM4 + U_CTRLB, U_CTRLB_RXEN | 0x5);
+    g_assert_cmphex(qtest_readl(qts, SERCOM4 + U_CTRLB), ==, U_CTRLB_RXEN);
+    g_assert_cmphex(sercom_readb(qts, U_INTFLAG) & INT_DRE, ==, 0);
+
+    /* Once disabled, everything is writable again */
+    qtest_writel(qts, SERCOM4 + U_CTRLA, U_CTRLA_VCOM);
+    qtest_writew(qts, SERCOM4 + U_BAUD, 0x1234);
+    g_assert_cmphex(qtest_readw(qts, SERCOM4 + U_BAUD), ==, 0x1234);
+
+    /* SWRST returns every register to its reset value */
+    qtest_writel(qts, SERCOM4 + U_CTRLA, 0x1);
+    g_assert_cmphex(qtest_readl(qts, SERCOM4 + U_CTRLA), ==, 0);
+    g_assert_cmphex(qtest_readw(qts, SERCOM4 + U_BAUD), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-jh/sercom/reset-values", test_reset_values);
+    qtest_add_func("pic32cm-jh/sercom/tx", test_tx);
+    qtest_add_func("pic32cm-jh/sercom/intenset-alias", test_intenset_alias);
+    qtest_add_func("pic32cm-jh/sercom/rx", test_rx);
+    qtest_add_func("pic32cm-jh/sercom/status-w1c", test_status_w1c);
+    qtest_add_func("pic32cm-jh/sercom/enable-protect", test_enable_protect);
+
+    return g_test_run();
+}
