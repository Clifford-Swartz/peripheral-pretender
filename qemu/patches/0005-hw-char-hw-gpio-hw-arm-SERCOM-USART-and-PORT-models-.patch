new file mode 100644
index 0000000..1a2897f
--- /dev/null
+++ b/include/hw/char/mchp_sercom.h
@@ -0,0 +1,30 @@
+/*
+ * Microchip SAM/PIC32CM SERCOM (U2201) serial communication interface
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A TYPE_MCHP_REGBLOCK subclass configured with mchp_regblock_set_info()
+ * from a generated SoC instance table; CTRLA.MODE selects the register
+ * view. In the USART modes characters go to and come from the chardev;
+ * the SPI and I2C modes only store their registers (LOG_UNIMP).
+ *
+ * Properties:
+ *   "chardev"  the USART's serial backend
+ *   "pace-tx"  bool, default off: keep the transmit shift register busy
+ *              for one frame at the baud rate set by BAUD and the "gclk"
+ *              clock, instead of sending each character at once
+ * Buses "<instance>.i2c" (I2C) and "<instance>.spi" (SSI), for example
+ * "sercom4.i2c", let board devices attach; v0 does not drive them.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_CHAR_MCHP_SERCOM_H
+#define HW_CHAR_MCHP_SERCOM_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_SERCOM "mchp-sercom"
+
+#endif /* HW_CHAR_MCHP_SERCOM_H */
diff --git a/include/hw/gpio/mchp_port.h b/include/hw/gpio/mchp_port.h
new file mode 100644
index 0000000..44e7062
--- /dev/null
+++ b/include/hw/gpio/mchp_port.h
@@ -0,0 +1,46 @@
+/*
+ * Microchip SAM/PIC32CM PORT (U2210) I/O pin controller
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A TYPE_MCHP_REGBLOCK subclass configured with mchp_regblock_set_info()
+ * from a generated SoC instance table: the pin groups at a 0x80 stride and
+ * their IOBUS view (sysbus MMIO 1). Pins are numbered group * 32 + pin,
+ * with PA = group 0, PB = 1 and PC = 2 (see MCHP_PORT_PIN()).
+ *
+ * Each pad is driven by the PORT, by something outside, or by nobody. The
+ * GPIO lines use the level -1 for "not driven", as nrf51_gpio does:
+ *   "port-out"[n]  the PORT's drive on pad n: the OUT bit while the pin
+ *                  is a GPIO output (DIR = 1, PINCFG.PMUXEN = 0), else -1
+ *   "port-in"[n]   an external driver on pad n: 0 or 1, or -1 to release
+ *                  the pad
+ * IN reads the pad of each pin whose input buffer is on (PINCFG.INEN): the
+ * PORT's own drive, else the external driver, else the pull resistor
+ * (PINCFG.PULLEN, towards OUT), else 0 for a floating pad.
+ *
+ * QOM properties per group, here for PA ("pb-..." and "pc-..." likewise):
+ *   "pa-in"        uint32: levels of the external drivers; writing it
+ *                  drives all 32 pads
+ *   "pa-in-mask"   uint32: pads that have an external driver (default 0)
+ *   "pa-out"       uint32, read-only: levels the PORT drives (0 where it
+ *                  does not drive)
+ *   "pa-out-mask"  uint32, read-only: pads the PORT drives
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_GPIO_MCHP_PORT_H
+#define HW_GPIO_MCHP_PORT_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_PORT "mchp-port"
+
+#define MCHP_PORT_OUT "port-out"
+#define MCHP_PORT_IN "port-in"
+
+/* GPIO line of pin P<group><pin>, for example MCHP_PORT_PIN('C', 5) */
+#define MCHP_PORT_PIN(group, pin) (((group) - 'A') * 32 + (pin))
+
+#endif /* HW_GPIO_MCHP_PORT_H */
