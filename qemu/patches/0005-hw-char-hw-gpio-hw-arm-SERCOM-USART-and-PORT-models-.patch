diff --git a/hw/gpio/mchp_port.c b/hw/gpio/mchp_port.c
new file mode 100644
index 0000000..78ebce5
--- /dev/null
+++ b/hw/gpio/mchp_port.c
@@ -0,0 +1,343 @@
+/*
+ * Microchip SAM/PIC32CM PORT (U2210) I/O pin controller
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Pin configuration follows DS60001632H chapter 27 ("I/O Pin
+ * Configuration"). The register file stores DIR, OUT, PINCFG and PMUX, and
+ * the generated tables give the SET/CLR/TGL aliases; this model derives
+ * the pads from them. Not modelled: event inputs (EVCTRL) and the input
+ * sampling mode (CTRL.SAMPLING), since IN always shows the current pads.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/gpio/mchp_port.h"
+#include "hw/mchp/gen/port_u2210.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+#define MCHP_PORT_GROUP_PINS    32
+#define MCHP_PORT_NUM_PINS      (MCHP_PORT_GROUP_COUNT * MCHP_PORT_GROUP_PINS)
+
+/* WRCONFIG holds the PINCFG fields 16 bits up (DS 27.7.11). */
+#define MCHP_PORT_WRCONFIG_PINCFG_SHIFT R_MCHP_PORT_GROUP_WRCONFIG_PMUXEN_SHIFT
+#define MCHP_PORT_PINCFG_FIELDS \
+    (R_MCHP_PORT_GROUP_PINCFG_PMUXEN_MASK | \
+     R_MCHP_PORT_GROUP_PINCFG_INEN_MASK | \
+     R_MCHP_PORT_GROUP_PINCFG_PULLEN_MASK | \
+     R_MCHP_PORT_GROUP_PINCFG_DRVSTR_MASK)
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpPortState, MCHP_PORT)
+
+struct MchpPortState {
+    MchpRegBlock parent_obj;
+
+    qemu_irq out[MCHP_PORT_NUM_PINS];
+    /* External drivers, per group: the pads they drive and the levels */
+    uint32_t ext_mask[MCHP_PORT_GROUP_COUNT];
+    uint32_t ext_level[MCHP_PORT_GROUP_COUNT];
+    /* The PORT's own drive, as last signalled on "port-out" */
+    uint32_t drive_mask[MCHP_PORT_GROUP_COUNT];
+    uint32_t drive_level[MCHP_PORT_GROUP_COUNT];
+};
+
+static MchpRegFile *mchp_port_rf(MchpPortState *s)
+{
+    return &MCHP_REGBLOCK(s)->rf;
+}
+
+/* Byte offset of register @reg of group @g */
+static hwaddr mchp_port_offset(unsigned g, hwaddr reg)
+{
+    return MCHP_PORT_GROUP_OFFSET + g * MCHP_PORT_GROUP_STRIDE + reg;
+}
+
+/* The group of register @ri, and the offset of @ri inside its group */
+static unsigned mchp_port_group(const MchpRegInfo *ri)
+{
+    return (ri->offset - MCHP_PORT_GROUP_OFFSET) / MCHP_PORT_GROUP_STRIDE;
+}
+
+static hwaddr mchp_port_group_reg(const MchpRegInfo *ri)
+{
+    return (ri->offset - MCHP_PORT_GROUP_OFFSET) % MCHP_PORT_GROUP_STRIDE;
+}
+
+static uint32_t mchp_port_reg(MchpPortState *s, unsigned g, hwaddr reg)
+{
+    return mchp_regfile_peek(mchp_port_rf(s), mchp_port_offset(g, reg), 4);
+}
+
+/* Pins of group @g whose PINCFG has any of @bits set */
+static uint32_t mchp_port_pincfg(MchpPortState *s, unsigned g, uint8_t bits)
+{
+    uint32_t pins = 0;
+
+    for (unsigned pin = 0; pin < MCHP_PORT_GROUP_PINS; pin++) {
+        hwaddr offset = mchp_port_offset(g, A_MCHP_PORT_GROUP_PINCFG + pin);
+
+        if (mchp_regfile_peek(mchp_port_rf(s), offset, 1) & bits) {
+            pins |= BIT(pin);
+        }
+    }
+    return pins;
+}
+
+/* Pads the PORT drives: GPIO outputs not handed over to a peripheral */
+static uint32_t mchp_port_drive_mask(MchpPortState *s, unsigned g)
+{
+    return mchp_port_reg(s, g, A_MCHP_PORT_GROUP_DIR) &
+           ~mchp_port_pincfg(s, g, R_MCHP_PORT_GROUP_PINCFG_PMUXEN_MASK);
+}
+
+/*
+ * Level of every pad of group @g (DS 27.6.3.2): the PORT's output, else an
+ * external driver, else the pull resistor of an input (towards OUT), else
+ * 0 for a floating pad.
+ */
+static uint32_t mchp_port_pads(MchpPortState *s, unsigned g)
+{
+    uint32_t out = mchp_port_reg(s, g, A_MCHP_PORT_GROUP_OUT);
+    uint32_t drive = mchp_port_drive_mask(s, g);
+    uint32_t ext = s->ext_mask[g] & ~drive;
+    uint32_t pull = mchp_port_pincfg(s, g,
+                                     R_MCHP_PORT_GROUP_PINCFG_PULLEN_MASK) &
+                    ~mchp_port_reg(s, g, A_MCHP_PORT_GROUP_DIR) & ~ext;
+
+    return (out & drive) | (s->ext_level[g] & ext) | (out & pull);
+}
+
+/* IN shows the pads whose input buffer is enabled; the others read 0. */
+static uint32_t mchp_port_in(MchpPortState *s, unsigned g)
+{
+    return mchp_port_pads(s, g) &
+           mchp_port_pincfg(s, g, R_MCHP_PORT_GROUP_PINCFG_INEN_MASK);
+}
+
+/* Signal the pads of group @g whose drive changed on "port-out". */
+static void mchp_port_update(MchpPortState *s, unsigned g)
+{
+    uint32_t mask = mchp_port_drive_mask(s, g);
+    uint32_t level = mchp_port_reg(s, g, A_MCHP_PORT_GROUP_OUT) & mask;
+    uint32_t changed = (mask ^ s->drive_mask[g]) |
+                       (level ^ s->drive_level[g]);
+
+    s->drive_mask[g] = mask;
+    s->drive_level[g] = level;
+    for (unsigned pin = 0; pin < MCHP_PORT_GROUP_PINS; pin++) {
+        int value = extract32(mask, pin, 1) ? extract32(level, pin, 1) : -1;
+
+        if (extract32(changed, pin, 1)) {
+            trace_mchp_port_out('A' + g, pin, value);
+            qemu_set_irq(s->out[g * MCHP_PORT_GROUP_PINS + pin], value);
+        }
+    }
+}
+
+/* WRCONFIG: PINCFG and PMUX of up to 16 pins in one write (DS 27.7.11) */
+static void mchp_port_wrconfig(MchpPortState *s, unsigned g, uint32_t val)
+{
+    MchpRegFile *rf = mchp_port_rf(s);
+    unsigned first = FIELD_EX32(val, MCHP_PORT_GROUP_WRCONFIG, HWSEL) ? 16 : 0;
+    uint32_t pins = FIELD_EX32(val, MCHP_PORT_GROUP_WRCONFIG, PINMASK);
+    uint32_t pincfg = (val >> MCHP_PORT_WRCONFIG_PINCFG_SHIFT) &
+                      MCHP_PORT_PINCFG_FIELDS;
+    uint32_t pmux = FIELD_EX32(val, MCHP_PORT_GROUP_WRCONFIG, PMUX);
+
+    for (unsigned i = 0; i < 16; i++) {
+        unsigned pin = first + i;
+        hwaddr pincfg_offset = mchp_port_offset(g, A_MCHP_PORT_GROUP_PINCFG +
+                                                   pin);
+        hwaddr pmux_offset = mchp_port_offset(g, A_MCHP_PORT_GROUP_PMUX +
+                                                 pin / 2);
+
+        if (!extract32(pins, i, 1)) {
+            continue;
+        }
+        if (FIELD_EX32(val, MCHP_PORT_GROUP_WRCONFIG, WRPINCFG)) {
+            mchp_regfile_poke(rf, pincfg_offset, 1, pincfg);
+        }
+        if (FIELD_EX32(val, MCHP_PORT_GROUP_WRCONFIG, WRPMUX)) {
+            /* PMUXE holds the even pin, PMUXO the odd one */
+            mchp_regfile_poke(rf, pmux_offset, 1,
+                              deposit32(mchp_regfile_peek(rf, pmux_offset, 1),
+                                        (pin & 1) * 4, 4, pmux));
+        }
+    }
+}
+
+static uint32_t mchp_port_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                   unsigned idx, uint32_t stored,
+                                   bool side_effects)
+{
+    if (mchp_port_group_reg(ri) == A_MCHP_PORT_GROUP_IN) {
+        return mchp_port_in(MCHP_PORT(rf->opaque), mchp_port_group(ri));
+    }
+    return stored;
+}
+
+/* DIR and OUT (also through their aliases), PINCFG and WRCONFIG */
+static void mchp_port_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                 unsigned idx, uint32_t old,
+                                 uint32_t written, uint32_t we)
+{
+    MchpPortState *s = MCHP_PORT(rf->opaque);
+    unsigned g = mchp_port_group(ri);
+
+    if (mchp_port_group_reg(ri) == A_MCHP_PORT_GROUP_WRCONFIG) {
+        mchp_port_wrconfig(s, g, written & we);
+    }
+    mchp_port_update(s, g);
+}
+
+/* "port-in": level 0 or 1 drives the pad, a negative level releases it */
+static void mchp_port_set_input(void *opaque, int n, int level)
+{
+    MchpPortState *s = opaque;
+    unsigned g = n / MCHP_PORT_GROUP_PINS, pin = n % MCHP_PORT_GROUP_PINS;
+
+    trace_mchp_port_in('A' + g, pin, level);
+    s->ext_mask[g] = deposit32(s->ext_mask[g], pin, 1, level >= 0);
+    s->ext_level[g] = deposit32(s->ext_level[g], pin, 1, level > 0);
+}
+
+static void mchp_port_get_in(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    MchpPortState *s = MCHP_PORT(obj);
+    unsigned g = GPOINTER_TO_UINT(opaque);
+    uint32_t value = s->ext_level[g] & s->ext_mask[g];
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void mchp_port_set_in(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    MchpPortState *s = MCHP_PORT(obj);
+    unsigned g = GPOINTER_TO_UINT(opaque);
+    uint32_t value;
+
+    if (visit_type_uint32(v, name, &value, errp)) {
+        s->ext_level[g] = value;
+        s->ext_mask[g] = UINT32_MAX;
+    }
+}
+
+static void mchp_port_get_in_mask(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    MchpPortState *s = MCHP_PORT(obj);
+    uint32_t value = s->ext_mask[GPOINTER_TO_UINT(opaque)];
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void mchp_port_set_in_mask(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    MchpPortState *s = MCHP_PORT(obj);
+    uint32_t value;
+
+    if (visit_type_uint32(v, name, &value, errp)) {
+        s->ext_mask[GPOINTER_TO_UINT(opaque)] = value;
+    }
+}
+
+static void mchp_port_get_out(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    MchpPortState *s = MCHP_PORT(obj);
+    uint32_t value = s->drive_level[GPOINTER_TO_UINT(opaque)];
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void mchp_port_get_out_mask(Object *obj, Visitor *v, const char *name,
+                                   void *opaque, Error **errp)
+{
+    MchpPortState *s = MCHP_PORT(obj);
+    uint32_t value = s->drive_mask[GPOINTER_TO_UINT(opaque)];
+
+    visit_type_uint32(v, name, &value, errp);
+}
+
+/* After a reset every pin is an input again: release the pads. */
+static void mchp_port_reset_exit(MchpRegBlock *rb)
+{
+    for (unsigned g = 0; g < MCHP_PORT_GROUP_COUNT; g++) {
+        mchp_port_update(MCHP_PORT(rb), g);
+    }
+}
+
+static void mchp_port_init(Object *obj)
+{
+    MchpPortState *s = MCHP_PORT(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), s->out, MCHP_PORT_OUT,
+                             MCHP_PORT_NUM_PINS);
+    qdev_init_gpio_in_named(DEVICE(obj), mchp_port_set_input, MCHP_PORT_IN,
+                            MCHP_PORT_NUM_PINS);
+
+    for (unsigned g = 0; g < MCHP_PORT_GROUP_COUNT; g++) {
+        void *group = GUINT_TO_POINTER(g);
+        char p = 'a' + g;
+        g_autofree char *in = g_strdup_printf("p%c-in", p);
+        g_autofree char *in_mask = g_strdup_printf("p%c-in-mask", p);
+        g_autofree char *out = g_strdup_printf("p%c-out", p);
+        g_autofree char *out_mask = g_strdup_printf("p%c-out-mask", p);
+
+        object_property_add(obj, in, "uint32", mchp_port_get_in,
+                            mchp_port_set_in, NULL, group);
+        object_property_add(obj, in_mask, "uint32", mchp_port_get_in_mask,
+                            mchp_port_set_in_mask, NULL, group);
+        object_property_add(obj, out, "uint32", mchp_port_get_out, NULL,
+                            NULL, group);
+        object_property_add(obj, out_mask, "uint32", mchp_port_get_out_mask,
+                            NULL, NULL, group);
+    }
+}
+
+static const VMStateDescription vmstate_mchp_port = {
+    .name = TYPE_MCHP_PORT,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpPortState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_UINT32_ARRAY(ext_mask, MchpPortState, MCHP_PORT_GROUP_COUNT),
+        VMSTATE_UINT32_ARRAY(ext_level, MchpPortState, MCHP_PORT_GROUP_COUNT),
+        VMSTATE_UINT32_ARRAY(drive_mask, MchpPortState, MCHP_PORT_GROUP_COUNT),
+        VMSTATE_UINT32_ARRAY(drive_level, MchpPortState,
+                             MCHP_PORT_GROUP_COUNT),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_port_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_port;
+    c->pre_read = mchp_port_pre_read;
+    c->post_write = mchp_port_post_write;
+    c->reset_exit = mchp_port_reset_exit;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_port_types[] = {
+    {
+        .name = TYPE_MCHP_PORT,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpPortState),
+        .instance_init = mchp_port_init,
+        .class_init = mchp_port_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_port_types)
