+/* "pa-short": "<mask> <level>" in hex, pads shorted to VDD or GND */
+static void avr8x_port_get_short(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    Avr8xPortState *s = AVR8X_PORT(obj);
+    Avr8xPortGroup *g = &s->g[GPOINTER_TO_UINT(opaque)];
+    g_autofree char *val = g_strdup_printf("%x %x", g->short_mask,
+                                           g->short_level);
+
+    visit_type_str(v, name, &val, errp);
+}
+
+static void avr8x_port_set_short(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    Avr8xPortState *s = AVR8X_PORT(obj);
+    unsigned grp = GPOINTER_TO_UINT(opaque);
+    Avr8xPortGroup *g = &s->g[grp];
+    g_autofree char *val = NULL;
+    unsigned mask, level;
+
+    if (!visit_type_str(v, name, &val, errp)) {
+        return;
+    }
+    if (sscanf(val, "%x %x", &mask, &level) != 2 || mask > 0xff) {
+        error_setg(errp, "%s must be \"<mask> <level>\" in hex", name);
+        return;
+    }
+    g->short_mask = mask;
+    g->short_level = level & mask;
+    avr8x_port_update(s, grp);
+}
+
 /* "pa-pull": "<mask> <up>" in hex, the pads with a pull resistor on */
