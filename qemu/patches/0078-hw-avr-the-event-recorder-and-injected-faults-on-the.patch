+/* Every pad's level, a group a word (the event recorder's pad source) */
+static unsigned avr8x_port_trace_levels(void *opaque, uint32_t *levels,
+                                        unsigned max)
+{
+    Avr8xPortState *s = AVR8X_PORT(opaque);
+    unsigned n = MIN(s->ngroups, max);
+
+    for (unsigned g = 0; g < n; g++) {
+        levels[g] = avr8x_port_pads(&s->g[g]);
+    }
+    return n;
+}
+
+void avr8x_port_trace(DeviceState *port)
+{
+    pp_trace_pads(avr8x_port_trace_levels, port, AVR8X_PORT_PINS);
+}
