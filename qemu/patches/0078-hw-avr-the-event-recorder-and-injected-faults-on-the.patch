+/*
+ * Injected faults: a short over the PORT's own drive, a stuck MISO, an
+ * I2C address that NACKs; characters into USART1's receiver (rx-inject),
+ * as many as it takes, the rest when it has room
+ */
+static void test_faults(const void *fw)
+{
+    QTestState *qts = qtest_initf("-M avr64ea48-cnano,mb1=thermo8 -kernel %s",
+                                  (const char *)fw);
+    g_autofree char *waiting = NULL;
+    uint8_t d[2];
+
+    /* LED0's pad driven low, shorted to VDD: the pad and IN read high */
+    qtest_writeb(qts, PORTB + P_DIRSET, LED0);
+    qtest_writeb(qts, PORTB + P_OUTCLR, LED0);
+    qom_set_str(qts, "/machine/soc/port", "pb-short", "8 8");
+    g_assert_cmphex(qom_uint(qts, "/machine/soc/port", "pb-levels") & LED0,
+                    ==, LED0);
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_IN) & LED0, ==, LED0);
+    qom_set_str(qts, "/machine/soc/port", "pb-short", "0 0");
+    g_assert_cmphex(qtest_readb(qts, PORTB + P_IN) & LED0, ==, 0);
+
+    /* SPI0 reads the stuck value whatever the bus returns */
+    qtest_writeb(qts, SPI0 + 0, 0x21);                  /* MASTER, ENABLE */
+    qom_set_str(qts, "/machine/soc/spi0", "fault-miso", "a5");
+    qtest_writeb(qts, SPI0 + 4, 0x00);
+    g_assert_cmphex(qtest_readb(qts, SPI0 + 3) & 0x80, ==, 0x80);  /* IF */
+    g_assert_cmphex(qtest_readb(qts, SPI0 + 4), ==, 0xa5);
+    qom_set_str(qts, "/machine/soc/spi0", "fault-miso", "");
+    qtest_writeb(qts, SPI0 + 4, 0x00);
+    g_assert_cmphex(qtest_readb(qts, SPI0 + 3) & 0x80, ==, 0x80);
+    g_assert_cmphex(qtest_readb(qts, SPI0 + 4), ==, 0x00);  /* no client */
+
+    /* The Thermo 8 (0x18) NACKs while the fault is on */
+    qtest_writeb(qts, TWI0 + T_MCTRLA, 0x03);
+    qtest_writeb(qts, TWI0 + T_MSTATUS, 0x01);
+    qom_set_str(qts, "/machine/soc/twi0", "fault-nack", "18");
+    qtest_writeb(qts, TWI0 + T_MADDR, 0x18 << 1);
+    g_assert_cmphex(qtest_readb(qts, TWI0 + T_MSTATUS) & (T_WIF | T_RXACK),
+                    ==, T_WIF | T_RXACK);
+    qtest_writeb(qts, TWI0 + T_MCTRLB, 0x03);
+    qom_set_str(qts, "/machine/soc/twi0", "fault-nack", "");
+    twi_read(qts, 0x18, 0x06, d, 2);
+    g_assert_cmphex(d[0] << 8 | d[1], ==, 0x0054);
+
+    /* "hi!": two fit the receive buffer once RXEN is set, then the third */
+    qom_set_str(qts, "/machine/soc/usart1", "rx-inject", "686921");
+    qtest_writeb(qts, USART1 + 6, 0x80);                        /* RXEN */
+    waiting = qom_str(qts, "/machine/soc/usart1", "rx-inject");
+    g_assert_cmpstr(waiting, ==, "21");
+    g_assert_cmphex(qtest_readb(qts, USART1 + 4) & 0x80, ==, 0x80); /* RXC */
+    g_assert_cmphex(qtest_readb(qts, USART1 + 0), ==, 'h');
+    g_assert_cmphex(qtest_readb(qts, USART1 + 0), ==, 'i');
+    g_assert_cmphex(qtest_readb(qts, USART1 + 0), ==, '!');
+    g_assert_cmphex(qtest_readb(qts, USART1 + 4) & 0x80, ==, 0);
