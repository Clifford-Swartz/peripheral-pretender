diff --git a/tests/qtest/pic32cm-tc-test.c b/tests/qtest/pic32cm-tc-test.c
new file mode 100644
index 0000000..9ff2b52
--- /dev/null
+++ b/tests/qtest/pic32cm-tc-test.c
@@ -0,0 +1,259 @@
+/*
+ * QTest for the TC of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * GCLK0 runs at 4 MHz out of reset (OSC48M / 12); with the /1024
+ * prescaler a TC tick is 256 us. Virtual time is stepped explicitly, so
+ * flag timing is checked exactly. Behaviour the data sheet leaves open
+ * follows PIC32CM MC00 silicon (firmware/hello/tests/tcprobe.c).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro "
+
+#define GCLK            0x40001C00
+#define TC0             0x42003000
+#define TC1             0x42003400
+#define NVIC_ISPR       0xE000E200
+
+#define T_CTRLA         0x00
+#define T_CTRLBCLR      0x04
+#define T_CTRLBSET      0x05
+#define T_INTENSET      0x09
+#define T_INTFLAG       0x0A
+#define T_STATUS        0x0B
+#define T_WAVE          0x0C
+#define T_SYNCBUSY      0x10
+#define T_COUNT         0x14
+#define T_PER           0x1B
+#define T_CC0           0x1C
+#define T_PERBUF        0x2F
+#define T_CCBUF0        0x30
+
+#define CTRLA_ENABLE    0x02
+#define MODE_COUNT8     (1 << 2)
+#define MODE_COUNT32    (2 << 2)
+#define DIV1024         (7 << 8)
+#define CMD_RETRIGGER   (1 << 5)
+#define CMD_STOP        (2 << 5)
+#define CMD_UPDATE      (3 << 5)
+#define CMD_READSYNC    (4 << 5)
+#define CTRLB_DIR       0x01
+#define CTRLB_LUPD      0x02
+#define CTRLB_ONESHOT   0x04
+
+#define OVF             0x01
+#define MC0             0x10
+#define MC1             0x20
+#define STOP            0x01
+#define SLAVE           0x02
+#define PERBUFV         0x08
+#define CCBUFV0         0x10
+
+#define TICK_NS         256000  /* 4 MHz / 1024 */
+#define TC0_GCLK_ID     25
+#define TC0_IRQ         16
+
+static QTestState *tc_init(uint32_t ctrla, uint8_t per)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK + 0x80 + 4 * TC0_GCLK_ID, 0x40);    /* GCLK0 */
+    qtest_writel(qts, TC0 + T_CTRLA, ctrla);
+    qtest_writeb(qts, TC0 + T_PER, per);
+    return qts;
+}
+
+static uint32_t readsync8(QTestState *qts)
+{
+    qtest_writeb(qts, TC0 + T_CTRLBSET, CMD_READSYNC);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_CTRLBSET) & 0xE0, ==, 0);
+    return qtest_readb(qts, TC0 + T_COUNT);
+}
+
+static void test_reset_values(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    g_assert_cmphex(qtest_readl(qts, TC0 + T_CTRLA), ==, 0);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_STATUS), ==, STOP);
+    g_assert_cmphex(qtest_readl(qts, TC0 + T_SYNCBUSY), ==, 0);
+    qtest_quit(qts);
+}
+
+/* 100 ticks to the overflow (PER 99), MC0 at CC0 = 10 */
+static void test_count8_timing(void)
+{
+    QTestState *qts = tc_init(MODE_COUNT8 | DIV1024, 99);
+
+    qtest_writeb(qts, TC0 + T_CC0, 10);
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | DIV1024 | CTRLA_ENABLE);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_STATUS) & STOP, ==, 0);
+    qtest_clock_step(qts, 9 * TICK_NS + TICK_NS / 2);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG), ==, 0);
+    qtest_clock_step(qts, TICK_NS);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG), ==, MC0);
+    qtest_clock_step(qts, 89 * TICK_NS);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG), ==, MC0);
+    qtest_clock_step(qts, TICK_NS);
+    /* CC1 (0) matches as COUNT wraps to ZERO */
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG), ==, MC0 | MC1 | OVF);
+    qtest_quit(qts);
+}
+
+/* COUNT shows the last synchronized value; READSYNC refreshes it */
+static void test_readsync(void)
+{
+    QTestState *qts = tc_init(MODE_COUNT8 | DIV1024, 99);
+
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | DIV1024 | CTRLA_ENABLE);
+    qtest_clock_step(qts, 20 * TICK_NS + TICK_NS / 2);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_COUNT), ==, 0);
+    g_assert_cmphex(readsync8(qts), ==, 20);
+    qtest_clock_step(qts, 5 * TICK_NS);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_COUNT), ==, 20);
+    g_assert_cmphex(readsync8(qts), ==, 25);
+
+    /* A written COUNT reads back without READSYNC */
+    qtest_writeb(qts, TC0 + T_COUNT, 42);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_COUNT), ==, 42);
+    qtest_quit(qts);
+}
+
+static void test_commands(void)
+{
+    QTestState *qts = tc_init(MODE_COUNT8 | DIV1024, 99);
+
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | DIV1024 | CTRLA_ENABLE);
+    qtest_clock_step(qts, 30 * TICK_NS);
+    qtest_writeb(qts, TC0 + T_CTRLBSET, CMD_STOP);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_STATUS) & STOP, ==, STOP);
+    g_assert_cmphex(readsync8(qts), ==, 0);
+    qtest_clock_step(qts, 30 * TICK_NS);
+    g_assert_cmphex(readsync8(qts), ==, 0);
+    qtest_writeb(qts, TC0 + T_CTRLBSET, CMD_RETRIGGER);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_STATUS) & STOP, ==, 0);
+    qtest_clock_step(qts, 7 * TICK_NS + TICK_NS / 2);
+    g_assert_cmphex(readsync8(qts), ==, 7);
+    qtest_quit(qts);
+}
+
+static void test_oneshot(void)
+{
+    QTestState *qts = tc_init(MODE_COUNT8 | DIV1024, 9);
+
+    qtest_writeb(qts, TC0 + T_CTRLBSET, CTRLB_ONESHOT);
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | DIV1024 | CTRLA_ENABLE);
+    qtest_clock_step(qts, 10 * TICK_NS + TICK_NS / 2);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & OVF, ==, OVF);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_STATUS) & STOP, ==, STOP);
+    qtest_writeb(qts, TC0 + T_INTFLAG, OVF);
+    qtest_clock_step(qts, 50 * TICK_NS);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & OVF, ==, 0);
+    g_assert_cmphex(readsync8(qts), ==, 0);
+    qtest_quit(qts);
+}
+
+/* Counting down from COUNT = 0 underflows to TOP on the first tick */
+static void test_down(void)
+{
+    QTestState *qts = tc_init(MODE_COUNT8 | DIV1024, 99);
+
+    qtest_writeb(qts, TC0 + T_CTRLBSET, CTRLB_DIR);
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | DIV1024 | CTRLA_ENABLE);
+    g_assert_cmphex(readsync8(qts), ==, 0);
+    qtest_clock_step(qts, TICK_NS + TICK_NS / 2);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & OVF, ==, OVF);
+    g_assert_cmphex(readsync8(qts), ==, 99);
+    qtest_quit(qts);
+}
+
+/* PER/CCx reads show the buffers while valid; TOP changes at the update */
+static void test_buffers(void)
+{
+    QTestState *qts = tc_init(MODE_COUNT8 | DIV1024, 99);
+
+    qtest_writeb(qts, TC0 + T_CTRLBSET, CTRLB_LUPD);
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | DIV1024 | CTRLA_ENABLE);
+    qtest_writeb(qts, TC0 + T_PERBUF, 19);
+    qtest_writeb(qts, TC0 + T_CCBUF0, 7);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_STATUS) & (PERBUFV | CCBUFV0),
+                    ==, PERBUFV | CCBUFV0);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_PER), ==, 19);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_CC0), ==, 7);
+    /* Locked: TOP is still 99 */
+    qtest_clock_step(qts, 20 * TICK_NS + TICK_NS / 2);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & OVF, ==, 0);
+    qtest_clock_step(qts, 80 * TICK_NS);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & OVF, ==, OVF);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_STATUS) & PERBUFV, ==, PERBUFV);
+    /* UPDATE copies them; unlocked overflows then use TOP 19 */
+    qtest_writeb(qts, TC0 + T_CTRLBSET, CMD_UPDATE);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_STATUS) & (PERBUFV | CCBUFV0),
+                    ==, 0);
+    qtest_writeb(qts, TC0 + T_CTRLBCLR, CTRLB_LUPD);
+    qtest_writeb(qts, TC0 + T_INTFLAG, 0xFF);
+    qtest_clock_step(qts, 20 * TICK_NS);
+    g_assert_cmphex(qtest_readb(qts, TC0 + T_INTFLAG) & OVF, ==, OVF);
+    qtest_quit(qts);
+}
+
+static void test_count32_pair(void)
+{
+    QTestState *qts = tc_init(MODE_COUNT32 | DIV1024, 0);
+
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT32 | DIV1024 | CTRLA_ENABLE);
+    g_assert_cmphex(qtest_readb(qts, TC1 + T_STATUS) & SLAVE, ==, SLAVE);
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT32 | DIV1024);
+    g_assert_cmphex(qtest_readb(qts, TC1 + T_STATUS) & SLAVE, ==, 0);
+    qtest_quit(qts);
+}
+
+static void test_irq(void)
+{
+    QTestState *qts = tc_init(MODE_COUNT8 | DIV1024, 9);
+
+    qtest_writeb(qts, TC0 + T_INTENSET, OVF);
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | DIV1024 | CTRLA_ENABLE);
+    g_assert_false(qtest_readl(qts, NVIC_ISPR) & BIT(TC0_IRQ));
+    qtest_clock_step(qts, 10 * TICK_NS + TICK_NS / 2);
+    g_assert_true(qtest_readl(qts, NVIC_ISPR) & BIT(TC0_IRQ));
+    qtest_quit(qts);
+}
+
+/* Synchronized writes without GCLK_TC keep SYNCBUSY set (silicon) */
+static void test_noclock(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | DIV1024 | CTRLA_ENABLE);
+    g_assert_cmphex(qtest_readl(qts, TC0 + T_SYNCBUSY), ==, 0x2);
+    qtest_writel(qts, GCLK + 0x80 + 4 * TC0_GCLK_ID, 0x40);
+    g_assert_cmphex(qtest_readl(qts, TC0 + T_SYNCBUSY), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-tc/reset-values", test_reset_values);
+    qtest_add_func("pic32cm-tc/count8-timing", test_count8_timing);
+    qtest_add_func("pic32cm-tc/readsync", test_readsync);
+    qtest_add_func("pic32cm-tc/commands", test_commands);
+    qtest_add_func("pic32cm-tc/oneshot", test_oneshot);
+    qtest_add_func("pic32cm-tc/down", test_down);
+    qtest_add_func("pic32cm-tc/buffers", test_buffers);
