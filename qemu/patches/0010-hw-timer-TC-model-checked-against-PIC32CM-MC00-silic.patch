new file mode 100644
index 0000000..ad4411d
--- /dev/null
+++ b/include/hw/timer/mchp_tc.h
@@ -0,0 +1,27 @@
+/*
+ * Microchip SAM/PIC32CM Timer/Counter (TC U2249)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A TYPE_MCHP_REGBLOCK subclass configured with mchp_regblock_set_info();
+ * CTRLA.MODE selects the COUNT8/16/32 register view.
+ * Link property "client": the odd TC of a COUNT32 pair (set on the even
+ * one); it reports STATUS.SLAVE while the pair counts 32 bits.
+ * GPIO outputs "ovf-event" and "mc-event"[2]: a pulse per overflow and
+ * compare match with EVCTRL.OVFEO/MCEOx set.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_TIMER_MCHP_TC_H
+#define HW_TIMER_MCHP_TC_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_TC "mchp-tc"
+
+#define MCHP_TC_OVF_EVENT "ovf-event"
+#define MCHP_TC_MC_EVENT "mc-event"
+
+#endif /* HW_TIMER_MCHP_TC_H */
