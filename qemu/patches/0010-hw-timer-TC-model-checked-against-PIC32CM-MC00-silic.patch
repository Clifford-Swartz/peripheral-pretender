diff --git a/hw/timer/mchp_tc.c b/hw/timer/mchp_tc.c
new file mode 100644
index 0000000..19d0a46
--- /dev/null
+++ b/hw/timer/mchp_tc.c
@@ -0,0 +1,668 @@
+/*
+ * Microchip SAM/PIC32CM Timer/Counter (TC U2249)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Follows DS60001638E chapter 33 (PIC32CM MC00) and DS60001632H chapter 41
+ * (PIC32CM JH01): 8, 16 and 32-bit counting from GCLK_TC through the
+ * prescaler, up or down, TOP from PER (COUNT8), MAX or CC0 according to
+ * WAVE.WAVEGEN, overflow/underflow and compare-match flags, one-shot, the
+ * RETRIGGER/STOP/UPDATE/READSYNC commands, double buffering of PER and CCx,
+ * and COUNT32 pairing (the odd TC of a pair reports STATUS.SLAVE).
+ * COUNT reads return the last synchronized value: firmware must issue
+ * READSYNC first, as on silicon. Not modelled: capture, event actions,
+ * waveform outputs on pins, prescaler synchronization, sleep.
+ *
+ * Behaviour the data sheet leaves open follows PIC32CM MC00 silicon
+ * (firmware/hello/tests/tcprobe.c): enabling counts on from COUNT in either
+ * direction (counting down from 0 underflows to TOP on the first tick);
+ * starting is an UPDATE condition for the buffers; a PER read while
+ * STATUS.PERBUFV is set returns PERBUF, though TOP stays the old PER (CCx
+ * and CCBUFVx alike); synchronized
+ * writes made without GCLK_TC keep their SYNCBUSY bits set until it runs.
+ *
+ * Counting is event driven on QEMU_CLOCK_VIRTUAL: the timer fires at the
+ * next overflow or compare match only while that changes something (a flag
+ * not yet set, one-shot, a pending buffer, an event output).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/host-utils.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/clock.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/timer/mchp_tc.h"
+#include "hw/mchp/gen/tc_u2249.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+/* Offsets and fields are the same in the three counter modes */
+#define A_CTRLA         A_MCHP_TC_COUNT16_CTRLA
+#define A_CTRLBSET      A_MCHP_TC_COUNT16_CTRLBSET
+#define A_CTRLBCLR      A_MCHP_TC_COUNT16_CTRLBCLR
+#define A_EVCTRL        A_MCHP_TC_COUNT16_EVCTRL
+#define A_INTFLAG       A_MCHP_TC_COUNT16_INTFLAG
+#define A_STATUS        A_MCHP_TC_COUNT16_STATUS
+#define A_WAVE          A_MCHP_TC_COUNT16_WAVE
+#define A_SYNCBUSY      A_MCHP_TC_COUNT16_SYNCBUSY
+#define A_COUNT         A_MCHP_TC_COUNT16_COUNT
+#define A_PER           A_MCHP_TC_COUNT8_PER
+#define A_CC            A_MCHP_TC_COUNT16_CC
+#define A_PERBUF        A_MCHP_TC_COUNT8_PERBUF
+#define A_CCBUF         A_MCHP_TC_COUNT16_CCBUF
+
+#define F(reg, field)   R_MCHP_TC_COUNT16_##reg##_##field##_MASK
+
+#define MCHP_TC_CHANNELS    2
+/* Periods skipped at once when the timer fires late */
+#define MCHP_TC_MAX_STEPS   64
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpTcState, MCHP_TC)
+
+struct MchpTcState {
+    MchpRegBlock parent_obj;
+
+    QEMUTimer *timer;
+    qemu_irq ovf_event;
+    qemu_irq mc_event[MCHP_TC_CHANNELS];
+    MchpTcState *client;        /* odd partner for COUNT32 (even TCs) */
+
+    bool running;               /* counting (enabled, not stopped) */
+    uint32_t sync_pending;      /* SYNCBUSY bits waiting for GCLK_TC */
+    uint32_t count;             /* counter value at t_base */
+    int64_t t_base;             /* QEMU_CLOCK_VIRTUAL ns */
+};
+
+static const uint16_t mchp_tc_prescale[] = { 1, 2, 4, 8, 16, 64, 256, 1024 };
+
+static uint32_t mchp_tc_reg(MchpTcState *s, hwaddr offset, unsigned size)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, offset, size);
+}
+
+static void mchp_tc_set_reg(MchpTcState *s, hwaddr offset, unsigned size,
+                            uint32_t val)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, offset, size, val);
+}
+
+static void mchp_tc_mod_reg(MchpTcState *s, hwaddr offset, unsigned size,
+                            uint32_t clear, uint32_t set)
+{
+    mchp_tc_set_reg(s, offset, size,
+                    (mchp_tc_reg(s, offset, size) & ~clear) | set);
+}
+
+static unsigned mchp_tc_mode(MchpTcState *s)
+{
+    return FIELD_EX32(mchp_tc_reg(s, A_CTRLA, 4), MCHP_TC_COUNT16_CTRLA, MODE);
+}
+
+/* Register size of COUNT/CCx/CCBUFx in the current mode */
+static unsigned mchp_tc_size(MchpTcState *s)
+{
+    switch (mchp_tc_mode(s)) {
+    case MCHP_TC_MODE_COUNT8:
+        return 1;
+    case MCHP_TC_MODE_COUNT32:
+        return 4;
+    default:
+        return 2;
+    }
+}
+
+static uint32_t mchp_tc_max(MchpTcState *s)
+{
+    return MAKE_64BIT_MASK(0, 8 * mchp_tc_size(s));
+}
+
+static uint32_t mchp_tc_cc(MchpTcState *s, unsigned ch)
+{
+    unsigned size = mchp_tc_size(s);
+
+    return mchp_tc_reg(s, A_CC + ch * size, size);
+}
+
+static unsigned mchp_tc_wavegen(MchpTcState *s)
+{
+    return FIELD_EX32(mchp_tc_reg(s, A_WAVE, 1), MCHP_TC_COUNT16_WAVE,
+                      WAVEGEN);
+}
+
+/* TOP per WAVE.WAVEGEN (DS Table 33-3) */
+static uint32_t mchp_tc_top(MchpTcState *s)
+{
+    switch (mchp_tc_wavegen(s)) {
+    case MCHP_TC_COUNT16_WAVE_WAVEGEN_MFRQ:
+    case MCHP_TC_COUNT16_WAVE_WAVEGEN_MPWM:
+        return mchp_tc_cc(s, 0);
+    default:
+        return mchp_tc_mode(s) == MCHP_TC_MODE_COUNT8 ?
+               mchp_tc_reg(s, A_PER, 1) : mchp_tc_max(s);
+    }
+}
+
+static bool mchp_tc_down(MchpTcState *s)
+{
+    return mchp_tc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, DIR);
+}
+
+static bool mchp_tc_capture(MchpTcState *s, unsigned ch)
+{
+    return extract32(mchp_tc_reg(s, A_CTRLA, 4),
+                     R_MCHP_TC_COUNT16_CTRLA_CAPTEN0_SHIFT + ch, 1);
+}
+
+/* Counter clock (GCLK_TC / prescaler) as ns per tick, numerator/hz */
+static uint64_t mchp_tc_prescaler(MchpTcState *s)
+{
+    return mchp_tc_prescale[FIELD_EX32(mchp_tc_reg(s, A_CTRLA, 4),
+                                       MCHP_TC_COUNT16_CTRLA, PRESCALER)];
+}
+
+static uint64_t mchp_tc_hz(MchpTcState *s)
+{
+    return clock_get_hz(MCHP_REGBLOCK(s)->gclk);
+}
+
+/* Whole counter ticks between t_base and @now */
+static uint64_t mchp_tc_ticks(MchpTcState *s, int64_t now)
+{
+    Clock *clk = MCHP_REGBLOCK(s)->gclk;
+
+    if (!s->running || !mchp_tc_hz(s) || now <= s->t_base) {
+        return 0;
+    }
+    return clock_ns_to_ticks(clk, now - s->t_base) / mchp_tc_prescaler(s);
+}
+
+/* A time by which tick @n after t_base has happened */
+static int64_t mchp_tc_tick_time(MchpTcState *s, uint64_t n)
+{
+    Clock *clk = MCHP_REGBLOCK(s)->gclk;
+
+    if (!n) {
+        return s->t_base;
+    }
+    return s->t_base + clock_ticks_to_ns(clk, n * mchp_tc_prescaler(s)) + 1;
+}
+
+/*
+ * Ticks until the next overflow/underflow (*ovf) and until each compare
+ * match (match[ch], 0: none) from the current count.
+ */
+static void mchp_tc_next(MchpTcState *s, uint64_t *ovf,
+                         uint64_t match[MCHP_TC_CHANNELS])
+{
+    uint32_t top = mchp_tc_top(s), count = s->count;
+    bool down = mchp_tc_down(s);
+
+    if (down) {
+        *ovf = (uint64_t)count + 1;
+    } else {
+        /* Above a lowered TOP the counter wraps at MAX (DS 33.6.2.7) */
+        *ovf = (uint64_t)(count > top ? mchp_tc_max(s) : top) - count + 1;
+    }
+    for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+        uint32_t cc = mchp_tc_cc(s, ch);
+
+        match[ch] = 0;
+        if (mchp_tc_capture(s, ch)) {
+            continue;
+        }
+        if (!down && cc > count && (uint64_t)cc - count < *ovf) {
+            match[ch] = cc - count;
+        } else if (!down && cc == 0) {
+            match[ch] = *ovf;               /* at the wrap to ZERO */
+        } else if (down && cc < count) {
+            match[ch] = count - cc;
+        } else if (down && cc == top) {
+            match[ch] = *ovf;               /* at the reload of TOP */
+        }
+    }
+}
+
+/* Copy the valid buffers into PER/CCx (UPDATE condition or command) */
+static void mchp_tc_update_buffers(MchpTcState *s)
+{
+    uint32_t status = mchp_tc_reg(s, A_STATUS, 1);
+    unsigned size = mchp_tc_size(s);
+
+    if (status & F(STATUS, PERBUFV)) {
+        mchp_tc_set_reg(s, A_PER, 1, mchp_tc_reg(s, A_PERBUF, 1));
+    }
+    for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+        if (status & (F(STATUS, CCBUFV0) << ch)) {
+            mchp_tc_set_reg(s, A_CC + ch * size, size,
+                            mchp_tc_reg(s, A_CCBUF + ch * size, size));
+        }
+    }
+    mchp_tc_mod_reg(s, A_STATUS, 1, F(STATUS, PERBUFV) | F(STATUS, CCBUFV0) |
+                    F(STATUS, CCBUFV1), 0);
+}
+
+/* Starting value: ZERO up, TOP down (DS 33.6.2.5) */
+static uint32_t mchp_tc_start_value(MchpTcState *s)
+{
+    return mchp_tc_down(s) ? mchp_tc_top(s) : 0;
+}
+
+static void mchp_tc_stop(MchpTcState *s, uint32_t count)
+{
+    s->running = false;
+    s->count = count;
+    mchp_tc_mod_reg(s, A_STATUS, 1, 0, F(STATUS, STOP));
+}
+
+/* Apply the events @n ticks after t_base */
+static void mchp_tc_step(MchpTcState *s, uint64_t n, bool ovf,
+                         const bool match[MCHP_TC_CHANNELS])
+{
+    uint32_t flags = 0, evctrl = mchp_tc_reg(s, A_EVCTRL, 2);
+    bool down = mchp_tc_down(s);
+
+    s->t_base = mchp_tc_tick_time(s, n);
+    if (ovf) {
+        s->count = down ? mchp_tc_top(s) : 0;
+    } else {
+        s->count = down ? s->count - n : s->count + n;
+    }
+    for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+        if (match[ch]) {
+            flags |= R_MCHP_TC_COUNT16_INTFLAG_MC0_MASK << ch;
+            if (evctrl & (F(EVCTRL, MCEO0) << ch)) {
+                qemu_irq_pulse(s->mc_event[ch]);
+            }
+        }
+    }
+    if (ovf) {
+        flags |= F(INTFLAG, OVF);
+        if (evctrl & F(EVCTRL, OVFEO)) {
+            qemu_irq_pulse(s->ovf_event);
+        }
+        if (!(mchp_tc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, LUPD))) {
+            mchp_tc_update_buffers(s);
+        }
+        if (mchp_tc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, ONESHOT)) {
+            mchp_tc_stop(s, s->count);
+        }
+    }
+    trace_mchp_tc_event(MCHP_REGBLOCK(s)->name, s->count, flags);
+    mchp_tc_mod_reg(s, A_INTFLAG, 1, 0, flags);
+}
+
+/*
+ * Firing the timer changes nothing: every flag it would set is set, and
+ * there is no one-shot, pending buffer or event output to serve.
+ */
+static bool mchp_tc_quiet(MchpTcState *s, const uint64_t match[])
+{
+    uint32_t flags = mchp_tc_reg(s, A_INTFLAG, 1);
+    uint32_t want = F(INTFLAG, OVF);
+
+    for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+        if (match[ch]) {
+            want |= R_MCHP_TC_COUNT16_INTFLAG_MC0_MASK << ch;
+        }
+    }
+    return (flags & want) == want &&
+           !(mchp_tc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, ONESHOT)) &&
+           !(mchp_tc_reg(s, A_STATUS, 1) &
+             (F(STATUS, PERBUFV) | F(STATUS, CCBUFV0) | F(STATUS, CCBUFV1))) &&
+           !(mchp_tc_reg(s, A_EVCTRL, 2) &
+             (F(EVCTRL, OVFEO) | F(EVCTRL, MCEO0) | F(EVCTRL, MCEO1)));
+}
+
+/* The counter value at t_base + @ticks, without events (closed form) */
+static uint32_t mchp_tc_value(MchpTcState *s, uint64_t ticks)
+{
+    uint64_t top = mchp_tc_top(s), period = top + 1;
+
+    if (!ticks) {
+        return s->count;
+    }
+    if (mchp_tc_down(s)) {
+        if (ticks <= s->count) {
+            return s->count - ticks;
+        }
+        return top - (ticks - s->count - 1) % period;
+    }
+    if (s->count > top) {
+        uint64_t wrap = (uint64_t)mchp_tc_max(s) - s->count + 1;
+
+        if (ticks < wrap) {
+            return s->count + ticks;
+        }
+        return (ticks - wrap) % period;
+    }
+    return (s->count + ticks) % period;
+}
+
+/* Bring the counter up to @now and schedule the next event that matters */
+static void mchp_tc_advance(MchpTcState *s, int64_t now)
+{
+    for (unsigned steps = 0; s->running && mchp_tc_hz(s); steps++) {
+        uint64_t ovf, match[MCHP_TC_CHANNELS], next;
+        bool at[MCHP_TC_CHANNELS];
+
+        mchp_tc_next(s, &ovf, match);
+        if (mchp_tc_quiet(s, match) || steps >= MCHP_TC_MAX_STEPS) {
+            /* Nothing to do on the way: jump to now */
+            uint64_t ticks = mchp_tc_ticks(s, now);
+
+            s->count = mchp_tc_value(s, ticks);
+            s->t_base = mchp_tc_tick_time(s, ticks);
+            if (steps >= MCHP_TC_MAX_STEPS) {
+                /* Flags that a long gap set at least once */
+                mchp_tc_mod_reg(s, A_INTFLAG, 1, 0, F(INTFLAG, OVF));
+            }
+            timer_del(s->timer);
+            return;
+        }
+        next = ovf;
+        for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+            if (match[ch] && match[ch] < next) {
+                next = match[ch];
+            }
+        }
+        if (mchp_tc_tick_time(s, next) > now) {
+            timer_mod(s->timer, mchp_tc_tick_time(s, next));
+            return;
+        }
+        for (unsigned ch = 0; ch < MCHP_TC_CHANNELS; ch++) {
+            at[ch] = match[ch] == next;
+        }
+        mchp_tc_step(s, next, next == ovf, at);
+    }
+    timer_del(s->timer);
+}
+
+static void mchp_tc_sync(MchpTcState *s)
+{
+    mchp_tc_advance(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void mchp_tc_tick(void *opaque)
+{
+    mchp_tc_sync(opaque);
+}
+
+/* Restart the time base at @count from now */
+static void mchp_tc_load(MchpTcState *s, uint32_t count)
+{
+    s->count = count & mchp_tc_max(s);
+    s->t_base = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+/* Count on from the current value; starting is an UPDATE condition */
+static void mchp_tc_start(MchpTcState *s)
+{
+    mchp_tc_mod_reg(s, A_STATUS, 1, F(STATUS, STOP), 0);
+    if (!(mchp_tc_reg(s, A_CTRLBSET, 1) & F(CTRLBSET, LUPD))) {
+        mchp_tc_update_buffers(s);
+    }
+    s->running = true;
+    s->t_base = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+/* The odd TC of a COUNT32 pair reports STATUS.SLAVE (DS 33.6.2.4) */
+static void mchp_tc_update_client(MchpTcState *s)
+{
+    uint32_t ctrla = mchp_tc_reg(s, A_CTRLA, 4);
+    bool paired = FIELD_EX32(ctrla, MCHP_TC_COUNT16_CTRLA, ENABLE) &&
+                  mchp_tc_mode(s) == MCHP_TC_MODE_COUNT32;
+
+    if (s->client) {
+        mchp_tc_mod_reg(s->client, A_STATUS, 1, F(STATUS, SLAVE),
+                        paired ? F(STATUS, SLAVE) : 0);
+    }
+}
+
+static void mchp_tc_report_unimp(MchpTcState *s)
+{
+    MchpRegBlock *rb = MCHP_REGBLOCK(s);
+    uint32_t ctrla = mchp_tc_reg(s, A_CTRLA, 4);
+    unsigned evact = FIELD_EX32(mchp_tc_reg(s, A_EVCTRL, 2),
+                                MCHP_TC_COUNT16_EVCTRL, EVACT);
+
+    if (ctrla & (F(CTRLA, CAPTEN0) | F(CTRLA, CAPTEN1))) {
+        qemu_log_mask(LOG_UNIMP, "%s.CTRLA: capture not modelled\n",
+                      rb->name);
+    }
+    if (evact || (mchp_tc_reg(s, A_EVCTRL, 2) & F(EVCTRL, TCEI))) {
+        qemu_log_mask(LOG_UNIMP, "%s.EVCTRL: event action %u not modelled\n",
+                      rb->name, evact);
+    }
+}
+
+static void mchp_tc_command(MchpTcState *s, unsigned cmd)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    unsigned size = mchp_tc_size(s);
+
+    if (!FIELD_EX32(mchp_tc_reg(s, A_CTRLA, 4), MCHP_TC_COUNT16_CTRLA,
+                    ENABLE)) {
+        return;                 /* commands need the TC enabled */
+    }
+    mchp_tc_advance(s, now);
+    switch (cmd) {
+    case MCHP_TC_COUNT16_CTRLBSET_CMD_RETRIGGER:
+        if (s->running) {
+            mchp_tc_load(s, mchp_tc_start_value(s));
+        } else {
+            mchp_tc_start(s);   /* resume from COUNT */
+        }
+        break;
+    case MCHP_TC_COUNT16_CTRLBSET_CMD_STOP:
+        if (s->running) {
+            mchp_tc_stop(s, mchp_tc_start_value(s));
+        }
+        break;
+    case MCHP_TC_COUNT16_CTRLBSET_CMD_UPDATE:
+        mchp_tc_update_buffers(s);
+        break;
+    case MCHP_TC_COUNT16_CTRLBSET_CMD_READSYNC:
+        mchp_tc_set_reg(s, A_COUNT, size,
+                        mchp_tc_value(s, mchp_tc_ticks(s, now)));
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "%s.CTRLBSET: command %u not modelled\n",
+                      MCHP_REGBLOCK(s)->name, cmd);
+        break;
+    }
+}
+
+static uint32_t mchp_tc_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                 unsigned idx, uint32_t stored,
+                                 bool side_effects)
+{
+    MchpTcState *s = MCHP_TC(rf->opaque);
+
+    if (side_effects) {
+        mchp_tc_sync(s);        /* flags due by now */
+    }
+    switch (ri->offset) {
+    case A_COUNT:
+        return stored;          /* the last synchronized value */
+    case A_PER:
+        /* While PERBUFV is set, PER reads show PERBUF (silicon) */
+        if (mchp_tc_reg(s, A_STATUS, 1) & F(STATUS, PERBUFV)) {
+            return mchp_tc_reg(s, A_PERBUF, 1);
+        }
+        return stored;
+    case A_CC:
+        /* Likewise CCx while CCBUFVx is set */
+        if (mchp_tc_reg(s, A_STATUS, 1) & (F(STATUS, CCBUFV0) << idx)) {
+            unsigned size = mchp_tc_size(s);
+
+            return mchp_tc_reg(s, A_CCBUF + idx * size, size);
+        }
+        return stored;
+    case A_SYNCBUSY:
+        /* Synchronization is instant once GCLK_TC runs */
+        if (mchp_tc_hz(s)) {
+            s->sync_pending = 0;
+        }
+        return s->sync_pending;
+    default:
+        return stored;
+    }
+}
+
+static void mchp_tc_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                               unsigned idx, uint32_t old, uint32_t written,
+                               uint32_t we)
+{
+    MchpTcState *s = MCHP_TC(rf->opaque);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint32_t val = mchp_regfile_get(rf, ri, idx);
+
+    if (ri->syncbusy && !mchp_tc_hz(s)) {
+        /* CTRLA.SWRST/ENABLE sit at their SYNCBUSY bits; only written ones */
+        s->sync_pending |= ri->offset == A_CTRLA ?
+                           written & we & ri->syncbusy :
+                           ri->syncbusy << (ri->count > 1 ? idx : 0);
+    }
+    switch (ri->offset) {
+    case A_CTRLA:
+        if (written & we & F(CTRLA, SWRST)) {
+            return;             /* mchp-regblock resets the TC next */
+        }
+        if (val & ~old & F(CTRLA, ENABLE)) {
+            unsigned evact = FIELD_EX32(mchp_tc_reg(s, A_EVCTRL, 2),
+                                        MCHP_TC_COUNT16_EVCTRL, EVACT);
+
+            mchp_tc_report_unimp(s);
+            /* RETRIGGER/START event actions wait for an event */
+            if (evact != MCHP_TC_COUNT16_EVCTRL_EVACT_RETRIGGER &&
+                evact != MCHP_TC_COUNT16_EVCTRL_EVACT_START) {
+                mchp_tc_start(s);
+            }
+        } else if (old & ~val & F(CTRLA, ENABLE)) {
+            mchp_tc_advance(s, now);
+            s->running = false;
+            timer_del(s->timer);
+        }
+        mchp_tc_update_client(s);
+        break;
+    case A_CTRLBSET: {
+        unsigned cmd = FIELD_EX32(val, MCHP_TC_COUNT16_CTRLBSET, CMD);
+
+        mchp_tc_advance(s, now);
+        mchp_tc_mod_reg(s, A_CTRLBSET, 1, F(CTRLBSET, CMD), 0);
+        if (cmd) {
+            mchp_tc_command(s, cmd);
+        }
+        break;
+    }
+    case A_CTRLBCLR:
+        mchp_tc_advance(s, now);
+        break;
+    case A_COUNT:
+        mchp_tc_load(s, val);
+        break;
+    case A_PERBUF:
+        mchp_tc_mod_reg(s, A_STATUS, 1, 0, F(STATUS, PERBUFV));
+        break;
+    default:
+        if (ri->offset == A_CCBUF) {
+            mchp_tc_mod_reg(s, A_STATUS, 1, 0, F(STATUS, CCBUFV0) << idx);
+        }
+        break;
+    }
+    mchp_tc_advance(s, now);
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+static void mchp_tc_gclk_update(MchpRegBlock *rb, ClockEvent event)
+{
+    MchpTcState *s = MCHP_TC(rb);
+
+    /* Count at the old rate up to now, then reschedule at the new one */
+    mchp_tc_advance(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+}
+
+static void mchp_tc_reset_hold(MchpRegBlock *rb)
+{
+    MchpTcState *s = MCHP_TC(rb);
+
+    timer_del(s->timer);
+    s->running = false;
+    s->sync_pending = 0;
+    s->count = 0;
+    mchp_tc_update_client(s);
+}
+
+static bool mchp_tc_realize(MchpRegBlock *rb, Error **errp)
+{
+    MchpTcState *s = MCHP_TC(rb);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, mchp_tc_tick, s);
+    return true;
+}
+
+static void mchp_tc_init(Object *obj)
+{
+    MchpTcState *s = MCHP_TC(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), &s->ovf_event, MCHP_TC_OVF_EVENT, 1);
+    qdev_init_gpio_out_named(DEVICE(obj), s->mc_event, MCHP_TC_MC_EVENT,
+                             MCHP_TC_CHANNELS);
+    object_property_add_link(obj, "client", TYPE_MCHP_TC,
+                             (Object **)&s->client,
+                             object_property_allow_set_link,
+                             OBJ_PROP_LINK_STRONG);
+}
+
+static void mchp_tc_finalize(Object *obj)
+{
+    timer_free(MCHP_TC(obj)->timer);
+}
+
+static const VMStateDescription vmstate_mchp_tc = {
+    .name = TYPE_MCHP_TC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpTcState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_TIMER_PTR(timer, MchpTcState),
+        VMSTATE_BOOL(running, MchpTcState),
+        VMSTATE_UINT32(count, MchpTcState),
+        VMSTATE_INT64(t_base, MchpTcState),
+        VMSTATE_UINT32(sync_pending, MchpTcState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_tc_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_tc;
+    c->realize = mchp_tc_realize;
+    c->pre_read = mchp_tc_pre_read;
+    c->post_write = mchp_tc_post_write;
+    c->reset_hold = mchp_tc_reset_hold;
+    c->gclk_update = mchp_tc_gclk_update;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_tc_types[] = {
+    {
+        .name = TYPE_MCHP_TC,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpTcState),
+        .instance_init = mchp_tc_init,
+        .instance_finalize = mchp_tc_finalize,
+        .class_init = mchp_tc_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_tc_types)
