+/*
+ * COUNT32 pairs: the TC with MASTER_SLAVE_MODE 1 drives the next instance
+ * (MASTER_SLAVE_MODE 2) as its client. The parameter is not in the
+ * generated instance table, so pairs follow the data sheet: TC0+TC1,
+ * TC2+TC3 (an even TC and the next one, when both exist).
+ */
+static void pic32cm_link_tc_pairs(Pic32cmSocState *s)
+{
+    for (unsigned n = 0; n < 8; n += 2) {
+        g_autofree char *even = g_strdup_printf("TC%u", n);
+        g_autofree char *odd = g_strdup_printf("TC%u", n + 1);
+        DeviceState *master = pic32cm_soc_periph(s, even);
+        DeviceState *client = pic32cm_soc_periph(s, odd);
+
+        if (master && client) {
+            object_property_set_link(OBJECT(master), "client", OBJECT(client),
+                                     &error_abort);
+        }
+    }
+}
+
 static bool pic32cm_realize_periph(Pic32cmSocState *s, uint8_t rev,
                                    Error **errp)
 {
+    pic32cm_link_tc_pairs(s);
     for (unsigned i = 0; i < s->dev->ninstances; i++) {
         const MchpInstanceInfo *info = &s->dev->instances[i];
         DeviceState *dev = s->periph[i];
