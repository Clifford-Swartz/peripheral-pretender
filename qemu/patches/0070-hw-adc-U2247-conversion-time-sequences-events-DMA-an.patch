diff --git a/hw/adc/mchp_adc_u2247.c b/hw/adc/mchp_adc_u2247.c
index 5b99364..bd974db 100644
--- a/hw/adc/mchp_adc_u2247.c
+++ b/hw/adc/mchp_adc_u2247.c
@@ -5,16 +5,15 @@
  * not for submission to upstream QEMU.
  *
  * Conversions as in the PIC32CM MC00 data sheet ("Low-Power, 32-bit
- * Cortex-M0+ MCU with Advanced Analog and PWM", ADC chapter), completed at
- * once: a start (SWTRIG.START, a CTRLC write with FREERUN, or each RESULT
- * read in free-running mode) converts INPUTCTRL.MUXPOS (minus MUXNEG in
- * differential mode) against REFCTRL.REFSEL into RESULT with the
- * resolution of CTRLC.RESSEL, the accumulation and right shift of AVGCTRL
- * (16-bit mode), offset and gain correction (CTRLC.CORREN: (code -
- * OFFSETCORR) * GAINCORR / 2048) and CTRLC.LEFTADJ, then compares it with
- * the window (CTRLC.WINMODE: INTFLAG.WINMON) and sets INTFLAG.RESRDY
- * (cleared by reading RESULT; OVERRUN when a result replaces an unread
- * one). Inputs:
+ * Cortex-M0+ MCU with Advanced Analog and PWM", ADC chapter): a start
+ * (SWTRIG.START, the START event, the enable or a CTRLC write with
+ * FREERUN) converts INPUTCTRL.MUXPOS (minus MUXNEG in differential mode)
+ * against REFCTRL.REFSEL into RESULT with the resolution of CTRLC.RESSEL,
+ * the accumulation and right shift of AVGCTRL (16-bit mode), offset and
+ * gain correction (CTRLC.CORREN: (code - OFFSETCORR) * GAINCORR / 2048)
+ * and CTRLC.LEFTADJ, then compares it with the window (CTRLC.WINMODE:
+ * INTFLAG.WINMON) and sets INTFLAG.RESRDY (cleared by reading RESULT;
+ * OVERRUN when a result replaces an unread one). Inputs:
  *
  * - AIN0..AIN11: VDDANA or 0 while the PORT drives the pad (a GPIO output;
  *   silicon, APP=acprobe: 0xFFA), else the "ain" property
@@ -34,9 +33,28 @@
  * INTREF 1.024 V, INTVCC0 VDDANA / 1.6 (the data sheet's table says
  * 1 / 1.48; the DFP and silicon say 1 / 1.6), VDDCORE 1.2 V, the INTREF
  * stall without VREFOE, and REFCTRL ignoring writes while enabled (the
- * overlay makes it enable-protected). Not modelled: sequencing
- * (SEQCTRL, logged), the master/slave pair (CTRLA.SLAVEEN), event inputs,
- * the conversion time.
+ * overlay makes it enable-protected).
+ *
+ * Timing as on a PIC32CM MC00 (firmware/hello APP=adcprobe..adcprobe4):
+ * CLK_ADC is GCLK_ADC / 2^(1 + CTRLB.PRESCALER). A conversion takes
+ * (SAMPCTRL.SAMPLEN + 1, or 4 with OFFCOMP) + the resolution's bits
+ * CLK_ADC cycles, 2^SAMPLENUM times when averaging; a start adds 36
+ * GCLK_ADC cycles and one CLK_ADC, and none starts before 10 us after the
+ * enable (the analog start-up). SWTRIG.START reads 1 until the conversion
+ * starts. Free
+ * running and sequences convert back to back. A sequence (SEQCTRL)
+ * converts the enabled inputs from the lowest, SEQSTATUS showing SEQBUSY
+ * and the last input converted; with FREERUN it repeats. The START and
+ * SYNC (flush) event inputs act on their rising edge (falling with
+ * STARTINV/FLUSHINV); a flush aborts the conversion in progress and, free
+ * running or in a sequence, starts it again. RESRDY and WINMON pulse
+ * their event outputs (RESRDYEO, WINMONEO); RESRDY is the DMA request
+ * (wired by the SoC as a level trigger on INTFLAG). ADC1 with
+ * CTRLA.SLAVEEN is ADC0's client: ADC0's enable, starts and prescaler
+ * drive it, both converting at once (CTRLC.DUALSEL BOTH) or in turn
+ * (INTERLEAVE). Registers act at once, not at the next conversion. Not
+ * modelled: the analog clock limits (silicon reads 0 with CLK_ADC above
+ * 16 MHz), sleep.
  *
  * SPDX-License-Identifier: GPL-2.0-or-later
  */
@@ -46,7 +64,11 @@
 #include "qapi/visitor.h"
 #include "qemu/cutils.h"
 #include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/clock.h"
+#include "hw/core/irq.h"
 #include "hw/adc/mchp_adc.h"
+#include "hw/dma/mchp_dmac.h"
 #include "hw/gpio/mchp_port.h"
 #include "hw/misc/mchp_sysctrl.h"
 #include "hw/misc/mchp_dac.h"
@@ -61,6 +83,13 @@
 #define SUPC_VREF_VREFOE    (1U << 2)
 #define SUPC_VREF_SEL(v)    extract32(v, 16, 4)
 
+/*
+ * Silicon's start: synchronization, then one CLK_ADC; ready 10 us after
+ * the enable
+ */
+#define ADC_START_GCLK      36
+#define ADC_STARTUP_NS      10000
+
 OBJECT_DECLARE_SIMPLE_TYPE(MchpAdcU2247State, MCHP_ADC_U2247)
 
 struct MchpAdcU2247State {
@@ -76,6 +105,22 @@ struct MchpAdcU2247State {
     MchpRegBlock *supc;         /* the SUPC, for VREF (found on first use) */
     DeviceState *dac;           /* the DAC: VOUT on ADC0 AIN0, DAC ref */
     bool dac_looked;
+
+    QEMUTimer *timer;           /* the conversion in progress ends */
+    bool converting;
+    int64_t start_clear_at;     /* SWTRIG.START reads 0 from, ns */
+    int64_t ready_at;           /* the analog start-up ends, ns */
+    unsigned mux;               /* the input being converted */
+    uint32_t seq_left;          /* inputs of the sequence still to convert */
+    bool ev_level[2];           /* START, SYNC (flush) event inputs */
+    bool turn_client;           /* INTERLEAVE: the client's start next */
+    qemu_irq resrdy_event;
+    qemu_irq winmon_event;
+    MchpAdcU2247State *host;    /* ADC0, for ADC1 (found on first use) */
+    MchpAdcU2247State *client;  /* ADC1, for ADC0 */
+    bool peers_looked;
+    DeviceState *dmac;          /* to kick at RESRDY (found on first use) */
+    bool dmac_looked;
 };
 
 static uint32_t adc_reg(MchpAdcU2247State *s, hwaddr off, unsigned size)
@@ -95,6 +140,72 @@ static void adc_flag(MchpAdcU2247State *s, uint8_t mask)
             mask);
 }
 
+static bool adc_enabled(MchpAdcU2247State *s)
+{
+    return FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLA, 1), MCHP_ADC_CTRLA,
+                      ENABLE);
+}
+
+static bool adc_is_client(MchpAdcU2247State *s)
+{
+    return FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLA, 1), MCHP_ADC_CTRLA,
+                      SLAVEEN);
+}
+
+static bool adc_freerun(MchpAdcU2247State *s)
+{
+    return FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLC, 2), MCHP_ADC_CTRLC,
+                      FREERUN);
+}
+
+static int adc_peer_cb(Object *child, void *opaque)
+{
+    MchpAdcU2247State **found = opaque;
+
+    if (object_dynamic_cast(child, TYPE_MCHP_ADC_U2247)) {
+        const char *name = MCHP_REGBLOCK(child)->name;
+
+        if (!strcmp(name, "adc0")) {
+            found[0] = MCHP_ADC_U2247(child);
+        } else if (!strcmp(name, "adc1")) {
+            found[1] = MCHP_ADC_U2247(child);
+        }
+    }
+    return 0;
+}
+
+/* ADC0 and ADC1, the host and its client: siblings named adc0 and adc1 */
+static void adc_find_peers(MchpAdcU2247State *s)
+{
+    MchpAdcU2247State *found[2] = { NULL, NULL };
+    Object *parent = OBJECT(s)->parent;
+
+    if (s->peers_looked || !parent) {
+        return;
+    }
+    s->peers_looked = true;
+    object_child_foreach(parent, adc_peer_cb, found);
+    if (found[0] == s) {
+        s->client = found[1];
+    } else if (found[1] == s) {
+        s->host = found[0];
+    }
+}
+
+/* The ADC whose enable, prescaler and starts drive this one */
+static MchpAdcU2247State *adc_driver(MchpAdcU2247State *s)
+{
+    adc_find_peers(s);
+    return adc_is_client(s) && s->host ? s->host : s;
+}
+
+/* ADC0's client, when ADC1 has SLAVEEN set */
+static MchpAdcU2247State *adc_client(MchpAdcU2247State *s)
+{
+    adc_find_peers(s);
+    return s->client && adc_is_client(s->client) ? s->client : NULL;
+}
+
 /* The SUPC's VREF register (0 when there is no SUPC: VREF at reset) */
 static uint32_t adc_supc_vref(MchpAdcU2247State *s)
 {
@@ -203,13 +314,12 @@ static int64_t adc_ref_uv(MchpAdcU2247State *s)
 }
 
 /* INTFLAG.WINMON: RESULT against WINLT/WINUT as CTRLC.WINMODE says */
-static void adc_window(MchpAdcU2247State *s, int32_t code, bool diff)
+static bool adc_window(MchpAdcU2247State *s, int32_t code, bool diff)
 {
     unsigned mode = FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLC, 2),
                                MCHP_ADC_CTRLC, WINMODE);
     int32_t lt = adc_reg(s, A_MCHP_ADC_WINLT, 2);
     int32_t ut = adc_reg(s, A_MCHP_ADC_WINUT, 2);
-    bool hit;
 
     if (diff) {
         lt = (int16_t)lt;
@@ -217,54 +327,42 @@ static void adc_window(MchpAdcU2247State *s, int32_t code, bool diff)
     }
     switch (mode) {
     case 1:
-        hit = code > lt;
-        break;
+        return code > lt;
     case 2:
-        hit = code < ut;
-        break;
+        return code < ut;
     case 3:
-        hit = code > lt && code < ut;
-        break;
+        return code > lt && code < ut;
     case 4:
-        hit = !(code >= lt && code <= ut);
-        break;
+        return !(code >= lt && code <= ut);
     default:
-        return;
-    }
-    if (hit) {
-        adc_flag(s, R_MCHP_ADC_INTFLAG_WINMON_MASK);
+        return false;
     }
 }
 
-/* Convert; false when the conversion cannot complete (see INTREF) */
-static bool adc_convert(MchpAdcU2247State *s)
+/* INTREF is not routed to the input without VREF.VREFOE: no conversion */
+static bool adc_can_convert(MchpAdcU2247State *s, unsigned mux)
+{
+    return mux != MCHP_ADC_INPUTCTRL_MUXPOS_INTREF ||
+           (adc_supc_vref(s) & SUPC_VREF_VREFOE);
+}
+
+/* The result of converting @mux: RESULT, RESRDY, OVERRUN, WINMON, events */
+static void adc_result(MchpAdcU2247State *s, unsigned mux)
 {
     MchpRegBlock *rb = MCHP_REGBLOCK(s);
     uint32_t in = adc_reg(s, A_MCHP_ADC_INPUTCTRL, 2);
     uint32_t ctrlc = adc_reg(s, A_MCHP_ADC_CTRLC, 2);
     uint32_t avg = adc_reg(s, A_MCHP_ADC_AVGCTRL, 1);
+    uint32_t ev = adc_reg(s, A_MCHP_ADC_EVCTRL, 1);
     unsigned res = FIELD_EX32(ctrlc, MCHP_ADC_CTRLC, RESSEL);
     unsigned bits = res == 2 ? 10 : res == 3 ? 8 : 12;
     unsigned n = FIELD_EX32(avg, MCHP_ADC_AVGCTRL, SAMPLENUM);
     unsigned adj = FIELD_EX32(avg, MCHP_ADC_AVGCTRL, ADJRES);
-    bool diff = FIELD_EX32(ctrlc, MCHP_ADC_CTRLC, DIFFMODE);
+    bool diff = FIELD_EX32(ctrlc, MCHP_ADC_CTRLC, DIFFMODE), win;
     int64_t full = (1 << bits) - 1, vref = adc_ref_uv(s);
-    int64_t uv = adc_input_mv(s, FIELD_EX32(in, MCHP_ADC_INPUTCTRL,
-                                            MUXPOS)) * 1000LL;
+    int64_t uv = adc_input_mv(s, mux) * 1000LL;
     int64_t code;
 
-    if (!FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLA, 1), MCHP_ADC_CTRLA,
-                    ENABLE)) {
-        return true;
-    }
-    if (FIELD_EX32(in, MCHP_ADC_INPUTCTRL, MUXPOS) ==
-        MCHP_ADC_INPUTCTRL_MUXPOS_INTREF &&
-        !(adc_supc_vref(s) & SUPC_VREF_VREFOE)) {
-        return false;           /* INTREF is not routed to the input */
-    }
-    if (adc_reg(s, A_MCHP_ADC_SEQCTRL, 4)) {
-        qemu_log_mask(LOG_UNIMP, "%s: sequencing not modelled\n", rb->name);
-    }
     if (diff) {
         unsigned neg = FIELD_EX32(in, MCHP_ADC_INPUTCTRL, MUXNEG);
 
@@ -286,7 +384,10 @@ static bool adc_convert(MchpAdcU2247State *s)
         code = diff ? MIN(MAX(code, -32768), 32767) : MIN(MAX(code, 0),
                                                           65535);
     }
-    adc_window(s, code, diff);
+    win = adc_window(s, code, diff);
+    if (win) {
+        adc_flag(s, R_MCHP_ADC_INTFLAG_WINMON_MASK);
+    }
     if (FIELD_EX32(ctrlc, MCHP_ADC_CTRLC, LEFTADJ)) {
         code <<= 16 - (res == 1 ? 16 : bits);
     }
@@ -296,24 +397,199 @@ static bool adc_convert(MchpAdcU2247State *s)
     adc_set(s, A_MCHP_ADC_RESULT, 2, (uint16_t)code);
     adc_flag(s, R_MCHP_ADC_INTFLAG_RESRDY_MASK);
     s->unread = true;
+    /* RESRDY is a DMA request: let a waiting channel see it now */
+    if (!s->dmac_looked) {
+        Object *o = object_resolve_path_type("", TYPE_MCHP_DMAC_U2223, NULL);
+
+        s->dmac = o ? DEVICE(o) : NULL;
+        s->dmac_looked = true;
+    }
+    if (s->dmac) {
+        mchp_dmac_kick(s->dmac);
+    }
+    if (ev & R_MCHP_ADC_EVCTRL_RESRDYEO_MASK) {
+        qemu_irq_pulse(s->resrdy_event);
+    }
+    if (win && (ev & R_MCHP_ADC_EVCTRL_WINMONEO_MASK)) {
+        qemu_irq_pulse(s->winmon_event);
+    }
     mchp_regblock_update_irq(rb);
-    return true;
+}
+
+/* The driving ADC's clocks: GCLK_ADC (Hz) and the CLK_ADC divider */
+static Clock *adc_gclk(MchpAdcU2247State *s)
+{
+    return MCHP_REGBLOCK(adc_driver(s))->gclk;
+}
+
+static uint64_t adc_div(MchpAdcU2247State *s)
+{
+    return 2ULL << FIELD_EX32(adc_reg(adc_driver(s), A_MCHP_ADC_CTRLB, 1),
+                              MCHP_ADC_CTRLB, PRESCALER);
+}
+
+/* CLK_ADC cycles of one conversion: sampling and bits, times averaging */
+static uint64_t adc_conv_clocks(MchpAdcU2247State *s)
+{
+    uint32_t samp = adc_reg(s, A_MCHP_ADC_SAMPCTRL, 1);
+    unsigned res = FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLC, 2),
+                              MCHP_ADC_CTRLC, RESSEL);
+    unsigned bits = res == 2 ? 10 : res == 3 ? 8 : 12;
+    unsigned n = res == 1 ? FIELD_EX32(adc_reg(s, A_MCHP_ADC_AVGCTRL, 1),
+                                       MCHP_ADC_AVGCTRL, SAMPLENUM) : 0;
+    unsigned sampling = FIELD_EX32(samp, MCHP_ADC_SAMPCTRL, OFFCOMP) ? 4 :
+                        FIELD_EX32(samp, MCHP_ADC_SAMPCTRL, SAMPLEN) + 1;
+
+    return (uint64_t)(sampling + bits) << MIN(n, 10);
+}
+
+/* The input to convert next: MUXPOS, or the sequence's lowest left */
+static unsigned adc_next_mux(MchpAdcU2247State *s)
+{
+    return s->seq_left ? ctz32(s->seq_left) :
+           FIELD_EX32(adc_reg(s, A_MCHP_ADC_INPUTCTRL, 2), MCHP_ADC_INPUTCTRL,
+                      MUXPOS);
+}
+
+/* Convert @mux, ending @clocks CLK_ADC cycles after @t (ns) */
+static void adc_schedule(MchpAdcU2247State *s, int64_t t, uint64_t clocks)
+{
+    Clock *gclk = adc_gclk(s);
+
+    s->mux = adc_next_mux(s);
+    if (!adc_can_convert(s, s->mux) || !clock_is_enabled(gclk)) {
+        /* Never starts: START stays set (silicon) */
+        s->converting = false;
+        s->start_clear_at = INT64_MAX;
+        return;
+    }
+    s->converting = true;
+    timer_mod(s->timer, t + clock_ticks_to_ns(gclk, clocks * adc_div(s)));
+}
+
+/* A start at @now (SWTRIG.START, an event, free running's first) */
+static void adc_start_one(MchpAdcU2247State *s, int64_t now)
+{
+    Clock *gclk = adc_gclk(s);
+    int64_t t;
+
+    if (s->converting || !adc_enabled(adc_driver(s))) {
+        return;                 /* START while converting: no effect */
+    }
+    if (!s->seq_left) {
+        s->seq_left = adc_reg(s, A_MCHP_ADC_SEQCTRL, 4);
+    }
+    t = MAX(now + (int64_t)clock_ticks_to_ns(gclk, ADC_START_GCLK),
+            adc_driver(s)->ready_at);
+    s->start_clear_at = t + clock_ticks_to_ns(gclk, adc_div(s));
+    if (s->seq_left) {
+        adc_set(s, A_MCHP_ADC_SEQSTATUS, 1,
+                (adc_reg(s, A_MCHP_ADC_SEQSTATUS, 1) &
+                 R_MCHP_ADC_SEQSTATUS_SEQSTATE_MASK) |
+                R_MCHP_ADC_SEQSTATUS_SEQBUSY_MASK);
+    }
+    adc_schedule(s, t, 1 + adc_conv_clocks(s));
+}
+
+/* A start of the host: itself and its client (BOTH) or in turn */
+static void adc_start(MchpAdcU2247State *s, int64_t now)
+{
+    MchpAdcU2247State *client = adc_client(s);
+
+    if (adc_is_client(s)) {
+        return;                 /* the host starts a client */
+    }
+    if (client && FIELD_EX32(adc_reg(s, A_MCHP_ADC_CTRLC, 2),
+                             MCHP_ADC_CTRLC, DUALSEL) ==
+                  MCHP_ADC_CTRLC_DUALSEL_INTERLEAVE) {
+        if (s->turn_client) {
+            adc_start_one(client, now);
