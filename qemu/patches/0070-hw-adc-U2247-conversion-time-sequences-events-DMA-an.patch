diff --git a/tests/qtest/pic32cm-adc-test.c b/tests/qtest/pic32cm-adc-test.c
new file mode 100644
index 0000000..3958a9b
--- /dev/null
+++ b/tests/qtest/pic32cm-adc-test.c
@@ -0,0 +1,274 @@
+/*
+ * QTest for the ADC of the PIC32CM MC00 (pic32cm-mc00-cpro, ADC U2247)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * GCLK0 runs at 4 MHz out of reset; PRESCALER DIV2 makes CLK_ADC 2 MHz.
+ * A 12-bit conversion with SAMPLEN 0 takes 14 CLK_ADC cycles (7 us) after
+ * a start's 36 GCLK cycles (9 us), and none starts within 10 us of the
+ * enable, as on PIC32CM MC00 silicon (firmware/hello/tests/adcprobe.c to
+ * adcprobe4.c, checked by adcseq.c). Virtual time is stepped explicitly.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro "
+
+#define GCLK_PCHCTRL    0x40001C80
+#define ADC0            0x42004400
+#define ADC1            0x42004800
+#define ADC0_GCLK_ID    28
+#define ADC1_GCLK_ID    29
+#define ADC0_PATH       "/machine/soc/adc0"
+
+#define R_CTRLA         0x00
+#define R_CTRLB         0x01
+#define R_REFCTRL       0x02
+#define R_EVCTRL        0x03
+#define R_INTFLAG       0x06
+#define R_SEQSTATUS     0x07
+#define R_INPUTCTRL     0x08
+#define R_CTRLC         0x0A
+#define R_AVGCTRL       0x0C
+#define R_SWTRIG        0x18
+#define R_RESULT        0x24
+#define R_SEQCTRL       0x28
+
+#define ENABLE          BIT(1)
+#define SLAVEEN         BIT(5)
+#define INTVCC2         5
+#define FLUSHEI         BIT(0)
+#define STARTEI         BIT(1)
+#define STARTINV        BIT(3)
+#define RESRDY          BIT(0)
+#define OVERRUN         BIT(1)
+#define SEQBUSY         BIT(7)
+#define FREERUN         BIT(2)
+#define RESSEL_16BIT    (1 << 4)
+#define DUALSEL_INTERLEAVE (1 << 12)
+#define SAMPLENUM_16    4
+#define FLUSH           BIT(0)
+#define START           BIT(1)
+#define CORE            0x1A        /* SCALEDVDDCORE: 300 mV */
+#define ANA             0x1B        /* SCALEDVDDANA */
+
+#define US              1000
+
+static int64_t now_ns;
+
+/* Step to @us microseconds after the enable */
+static void at_us(QTestState *qts, double us)
+{
+    int64_t t = (int64_t)(us * US);
+
+    g_assert_cmpint(t, >, now_ns);
+    qtest_clock_step(qts, t - now_ns);
+    now_ns = t;
+}
+
+static QTestState *adc_init(uint8_t ctrlc_lo, uint32_t seq, uint8_t evctrl)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * ADC0_GCLK_ID, 0x40);
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * ADC1_GCLK_ID, 0x40);
+    qtest_writeb(qts, ADC0 + R_CTRLB, 0);               /* DIV2 */
+    qtest_writeb(qts, ADC0 + R_REFCTRL, INTVCC2);
+    qtest_writew(qts, ADC0 + R_INPUTCTRL, CORE);
+    qtest_writel(qts, ADC0 + R_SEQCTRL, seq);
+    qtest_writeb(qts, ADC0 + R_EVCTRL, evctrl);
+    qtest_writew(qts, ADC0 + R_CTRLC, ctrlc_lo);
+    qtest_writeb(qts, ADC0 + R_CTRLA, ENABLE);
+    now_ns = 0;
+    return qts;
+}
+
+static bool resrdy(QTestState *qts, uint32_t adc)
+{
+    return qtest_readb(qts, adc + R_INTFLAG) & RESRDY;
+}
+
+/*
+ * A start at 20 us (past the start-up): SWTRIG.START reads 1 until the
+ * conversion starts at 29 us, RESRDY at 36 us
+ */
+static void test_timing(void)
+{
+    QTestState *qts = adc_init(0, 0, 0);
+
+    at_us(qts, 20);
+    qtest_writeb(qts, ADC0 + R_SWTRIG, START);
+    at_us(qts, 29);
+    g_assert_cmphex(qtest_readb(qts, ADC0 + R_SWTRIG), ==, START);
+    at_us(qts, 30);
+    g_assert_cmphex(qtest_readb(qts, ADC0 + R_SWTRIG), ==, 0);
+    at_us(qts, 35.9);
+    g_assert_false(resrdy(qts, ADC0));
+    at_us(qts, 36.1);
+    g_assert_true(resrdy(qts, ADC0));
+    g_assert_cmpuint(qtest_readw(qts, ADC0 + R_RESULT), ==, 372);
+    g_assert_false(resrdy(qts, ADC0));          /* reading cleared it */
+    qtest_quit(qts);
+
+    /* Right after the enable: no start before 10 us, RESRDY at 17 us */
+    qts = adc_init(0, 0, 0);
+    qtest_writeb(qts, ADC0 + R_SWTRIG, START);
+    at_us(qts, 16.9);
+    g_assert_false(resrdy(qts, ADC0));
+    at_us(qts, 17.1);
+    g_assert_true(resrdy(qts, ADC0));
+    qtest_quit(qts);
+
+    /* 16 samples averaged: 16 x 13 + 1 CLK_ADC cycles */
+    qts = adc_init(RESSEL_16BIT, 0, 0);
+    qtest_writeb(qts, ADC0 + R_AVGCTRL, SAMPLENUM_16);
+    at_us(qts, 20);
+    qtest_writeb(qts, ADC0 + R_SWTRIG, START);
+    at_us(qts, 20 + 9 + 104.4);
+    g_assert_false(resrdy(qts, ADC0));
+    at_us(qts, 20 + 9 + 104.6);
+    g_assert_true(resrdy(qts, ADC0));
+    qtest_quit(qts);
+}
+
+/* Free running: back to back every 13 CLK_ADC cycles, OVERRUN unread */
+static void test_freerun(void)
+{
+    QTestState *qts = adc_init(FREERUN, 0, 0);
+
+    at_us(qts, 17.1);                           /* started at the enable */
+    g_assert_true(resrdy(qts, ADC0));
+    qtest_readw(qts, ADC0 + R_RESULT);
+    at_us(qts, 23.4);
+    g_assert_false(resrdy(qts, ADC0));
+    at_us(qts, 23.6);
+    g_assert_true(resrdy(qts, ADC0));
+    at_us(qts, 30.2);                           /* not read */
+    g_assert_cmphex(qtest_readb(qts, ADC0 + R_INTFLAG) & OVERRUN, ==,
+                    OVERRUN);
+    qtest_quit(qts);
+}
+
+/* A sequence of 0x1A and 0x1B: SEQSTATUS busy then the last input */
+static void test_sequence(void)
+{
+    QTestState *qts = adc_init(0, BIT(CORE) | BIT(ANA), 0);
+
+    at_us(qts, 20);
+    qtest_writeb(qts, ADC0 + R_SWTRIG, START);
+    g_assert_cmphex(qtest_readb(qts, ADC0 + R_SEQSTATUS) & SEQBUSY, ==,
+                    SEQBUSY);
+    at_us(qts, 36.1);
+    g_assert_cmphex(qtest_readb(qts, ADC0 + R_SEQSTATUS), ==, SEQBUSY | CORE);
+    g_assert_cmpuint(qtest_readw(qts, ADC0 + R_RESULT), ==, 372);
+    at_us(qts, 42.6);
+    g_assert_cmphex(qtest_readb(qts, ADC0 + R_SEQSTATUS), ==, ANA);
+    g_assert_cmpuint(qtest_readw(qts, ADC0 + R_RESULT), ==, 1024);
+    at_us(qts, 60);
+    g_assert_false(resrdy(qts, ADC0));          /* the sequence ended */
+    qtest_quit(qts);
+
+    /* With FREERUN it repeats, SEQBUSY staying set */
+    qts = adc_init(FREERUN, BIT(CORE) | BIT(ANA), 0);
+    at_us(qts, 23.6);
+    g_assert_cmphex(qtest_readb(qts, ADC0 + R_SEQSTATUS), ==, SEQBUSY | ANA);
+    at_us(qts, 30.1);
+    g_assert_cmphex(qtest_readb(qts, ADC0 + R_SEQSTATUS), ==,
+                    SEQBUSY | CORE);
+    qtest_quit(qts);
+}
+
+/*
+ * The START event's rising edge starts (its falling edge with STARTINV);
+ * the SYNC event flushes a free-running conversion, which starts again
+ */
+static void test_events(void)
+{
+    QTestState *qts = adc_init(0, 0, STARTEI);
+
+    at_us(qts, 20);
+    qtest_set_irq_in(qts, ADC0_PATH, "start-event-in", 0, 1);
+    at_us(qts, 36.1);
+    g_assert_true(resrdy(qts, ADC0));
+    qtest_quit(qts);
+
+    qts = adc_init(0, 0, STARTEI | STARTINV);
+    at_us(qts, 20);
+    qtest_set_irq_in(qts, ADC0_PATH, "start-event-in", 0, 1);
+    at_us(qts, 40);
+    g_assert_false(resrdy(qts, ADC0));
+    qtest_set_irq_in(qts, ADC0_PATH, "start-event-in", 0, 0);
+    at_us(qts, 56.1);
+    g_assert_true(resrdy(qts, ADC0));
+    qtest_quit(qts);
+
+    /* Flushed at 20 us, 3 us into a conversion: the next ends at 36 us */
+    qts = adc_init(FREERUN, 0, FLUSHEI);
+    at_us(qts, 17.1);
+    qtest_readw(qts, ADC0 + R_RESULT);
+    at_us(qts, 20);
+    qtest_set_irq_in(qts, ADC0_PATH, "sync-event-in", 0, 1);
+    at_us(qts, 35.9);
+    g_assert_false(resrdy(qts, ADC0));
+    at_us(qts, 36.1);
+    g_assert_true(resrdy(qts, ADC0));
+    qtest_quit(qts);
+}
+
+/* ADC1 as ADC0's client: both convert at once, or in turn (INTERLEAVE) */
+static void test_dual(void)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * ADC0_GCLK_ID, 0x40);
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * ADC1_GCLK_ID, 0x40);
+    qtest_writeb(qts, ADC1 + R_REFCTRL, INTVCC2);
+    qtest_writew(qts, ADC1 + R_INPUTCTRL, ANA);
+    qtest_writeb(qts, ADC1 + R_CTRLA, SLAVEEN);
+    qtest_writeb(qts, ADC0 + R_REFCTRL, INTVCC2);
+    qtest_writew(qts, ADC0 + R_INPUTCTRL, CORE);
+    qtest_writeb(qts, ADC0 + R_CTRLA, ENABLE);
+    now_ns = 0;
+    at_us(qts, 20);
+    qtest_writeb(qts, ADC1 + R_SWTRIG, START);  /* a client's: nothing */
+    at_us(qts, 40);
+    g_assert_false(resrdy(qts, ADC1));
+    qtest_writeb(qts, ADC0 + R_SWTRIG, START);
+    at_us(qts, 60);
+    g_assert_true(resrdy(qts, ADC0));
+    g_assert_true(resrdy(qts, ADC1));
+    g_assert_cmpuint(qtest_readw(qts, ADC1 + R_RESULT), ==, 1024);
+    qtest_readw(qts, ADC0 + R_RESULT);
+
+    qtest_writeb(qts, ADC0 + R_CTRLA, 0);
+    qtest_writew(qts, ADC0 + R_CTRLC, DUALSEL_INTERLEAVE);
+    qtest_writeb(qts, ADC0 + R_CTRLA, ENABLE);
+    for (unsigned k = 0; k < 4; k++) {
+        at_us(qts, 100 + 40 * k);
+        qtest_writeb(qts, ADC0 + R_SWTRIG, START);
+        at_us(qts, 130 + 40 * k);
+        g_assert_cmpint(resrdy(qts, ADC0), ==, !(k & 1));
+        g_assert_cmpint(resrdy(qts, ADC1), ==, k & 1);
+        qtest_readw(qts, ADC0 + R_RESULT);
+        qtest_readw(qts, ADC1 + R_RESULT);
+    }
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-adc/timing", test_timing);
+    qtest_add_func("pic32cm-adc/freerun", test_freerun);
+    qtest_add_func("pic32cm-adc/sequence", test_sequence);
+    qtest_add_func("pic32cm-adc/events", test_events);
+    qtest_add_func("pic32cm-adc/dual", test_dual);
+
+    return g_test_run();
+}
