diff --git a/hw/misc/mchp_evsys.c b/hw/misc/mchp_evsys.c
new file mode 100644
index 0000000..6b93fae
--- /dev/null
+++ b/hw/misc/mchp_evsys.c
@@ -0,0 +1,408 @@
+/*
+ * Microchip SAM/PIC32CM Event System (EVSYS U2256)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Follows DS60001638E chapter 27 (PIC32CM MC00) and DS60001632H chapter 28
+ * (PIC32CM JH01): channels route a generator (CHANNEL.EVGEN) or a
+ * software event (SWEVT) to the users that select them (USER.CHANNEL).
+ *
+ * Behaviour the data sheet leaves open follows PIC32CM MC00 silicon
+ * (firmware/hello/tests/evprobe.c):
+ *  - The synchronous and resynchronized paths need the channel's generic
+ *    clock (CHANNEL.ONDEMAND does not request it); without it events are
+ *    lost without a flag. Channels without a generic clock (9-11 on the
+ *    MC00) only work asynchronously.
+ *  - On those paths an event selected by EDGSEL sets EVD. It reaches the
+ *    users when all are ready; with a user not ready it sets OVR and is
+ *    lost; with no user at all it sets OVR and keeps CHBUSY set until a
+ *    user selects the channel or the channel is written. CHBUSY also
+ *    reads 1 while a configured channel (EVGEN or EDGSEL not 0) has no
+ *    user. On silicon CHSTATUS shows a CHANNEL write a few clock cycles
+ *    late; the model shows it at once.
+ *  - A software event is a generator pulse: it goes through EDGSEL.
+ *  - A pulse seen with EDGSEL BOTH_EDGES makes one event and sets OVR
+ *    (its second edge finds the channel busy). Silicon loses some pulses
+ *    with FALLING_EDGE; the model delivers every one.
+ *  - The asynchronous path (PATH 2, and the reserved 3) passes the
+ *    generator level to the users whatever EDGSEL says, sets no flags and
+ *    reads USRRDY 0.
+ *  - USER.CHANNEL keeps 4 bits, not the 5 of the ATDF.
+ * Not modelled: RUNSTDBY and sleep, event latency.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/core/clock.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/misc/mchp_evsys.h"
+#include "hw/mchp/gen/evsys_u2256.h"
+#include "migration/vmstate.h"
+#include "trace.h"
+
+/* CHANNEL.PATH and CHANNEL.EDGSEL */
+enum {
+    MCHP_EVSYS_PATH_SYNC,
+    MCHP_EVSYS_PATH_RESYNC,
+    MCHP_EVSYS_PATH_ASYNC,
+};
+
+enum {
+    MCHP_EVSYS_EDGE_NONE,
+    MCHP_EVSYS_EDGE_RISING,
+    MCHP_EVSYS_EDGE_FALLING,
+    MCHP_EVSYS_EDGE_BOTH,
+};
+
+#define MCHP_EVSYS_USER_CHANNEL_MASK    0xF     /* silicon: 4 bits */
+#define F_OVR(ch)       BIT(ch)
+#define F_EVD(ch)       BIT((ch) + 16)
+/* A channel without users reads CHBUSY once one of these is set */
+#define F_CONFIG        (R_MCHP_EVSYS_CHANNEL_EVGEN_MASK | \
+                         R_MCHP_EVSYS_CHANNEL_EDGSEL_MASK)
+
+OBJECT_DECLARE_SIMPLE_TYPE(MchpEvsysState, MCHP_EVSYS)
+
+struct MchpEvsysState {
+    MchpRegBlock parent_obj;
+
+    Clock *chclk[MCHP_EVSYS_MAX_CHANNELS];
+    qemu_irq user[MCHP_EVSYS_MAX_USERS];
+    unsigned nchannels;
+    unsigned nusers;
+
+    uint64_t gen_level[MCHP_EVSYS_MAX_GENERATORS / 64];
+    uint64_t user_busy;         /* "user-busy" inputs */
+    uint64_t user_level;        /* "user" outputs */
+    uint32_t pending;           /* an event no user took yet */
+    int64_t last_event[MCHP_EVSYS_MAX_CHANNELS];
+};
+
+static uint32_t mchp_evsys_reg(MchpEvsysState *s, hwaddr offset)
+{
+    return mchp_regfile_peek(&MCHP_REGBLOCK(s)->rf, offset, 4);
+}
+
+static uint32_t mchp_evsys_channel(MchpEvsysState *s, unsigned ch)
+{
+    return mchp_evsys_reg(s, A_MCHP_EVSYS_CHANNEL + 4 * ch);
+}
+
+static unsigned mchp_evsys_evgen(MchpEvsysState *s, unsigned ch)
+{
+    return FIELD_EX32(mchp_evsys_channel(s, ch), MCHP_EVSYS_CHANNEL, EVGEN);
+}
+
+static bool mchp_evsys_async(MchpEvsysState *s, unsigned ch)
+{
+    return FIELD_EX32(mchp_evsys_channel(s, ch), MCHP_EVSYS_CHANNEL, PATH) >=
+           MCHP_EVSYS_PATH_ASYNC;
+}
+
+static bool mchp_evsys_clocked(MchpEvsysState *s, unsigned ch)
+{
+    return clock_get_hz(s->chclk[ch]) != 0;
+}
+
+static bool mchp_evsys_gen_level(MchpEvsysState *s, unsigned gen)
+{
+    return gen && extract64(s->gen_level[gen / 64], gen % 64, 1);
+}
+
+/* The users selecting channel @ch */
+static uint64_t mchp_evsys_users(MchpEvsysState *s, unsigned ch)
+{
+    uint64_t users = 0;
+
+    for (unsigned u = 0; u < s->nusers; u++) {
+        if (mchp_evsys_reg(s, A_MCHP_EVSYS_USER + 4 * u) == ch + 1) {
+            users |= BIT_ULL(u);
+        }
+    }
+    return users;
+}
+
+static void mchp_evsys_set_user(MchpEvsysState *s, unsigned u, bool level)
+{
+    if (extract64(s->user_level, u, 1) != level) {
+        s->user_level = deposit64(s->user_level, u, 1, level);
+        qemu_set_irq(s->user[u], level);
+    }
+}
+
+/* Users of asynchronous channels follow the generator; others idle at 0 */
+static void mchp_evsys_update_users(MchpEvsysState *s)
+{
+    for (unsigned u = 0; u < s->nusers; u++) {
+        uint32_t sel = mchp_evsys_reg(s, A_MCHP_EVSYS_USER + 4 * u);
+        unsigned ch = sel - 1;
+
+        mchp_evsys_set_user(s, u, sel && ch < s->nchannels &&
+                            mchp_evsys_async(s, ch) &&
+                            mchp_evsys_gen_level(s, mchp_evsys_evgen(s, ch)));
+    }
+}
+
+static void mchp_evsys_flag(MchpEvsysState *s, uint32_t flags)
+{
+    mchp_regfile_poke(&MCHP_REGBLOCK(s)->rf, A_MCHP_EVSYS_INTFLAG, 4,
+                      mchp_evsys_reg(s, A_MCHP_EVSYS_INTFLAG) | flags);
+    mchp_regblock_update_irq(MCHP_REGBLOCK(s));
+}
+
+/* An event detected on synchronous/resynchronized channel @ch */
+static void mchp_evsys_event(MchpEvsysState *s, unsigned ch)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint64_t users = mchp_evsys_users(s, ch);
+    uint32_t flags = F_EVD(ch);
+
+    if (s->last_event[ch] == now) {
+        flags |= F_OVR(ch);     /* the channel is still busy */
+    } else if (!users) {
+        flags |= F_OVR(ch);
+        s->pending |= BIT(ch);
+    } else if (users & s->user_busy) {
+        flags |= F_OVR(ch);
+    } else {
+        for (unsigned u = 0; u < s->nusers; u++) {
+            if (users & BIT_ULL(u)) {
+                qemu_irq_pulse(s->user[u]);
+            }
+        }
+    }
+    s->last_event[ch] = now;
+    trace_mchp_evsys_event(ch, flags);
+    mchp_evsys_flag(s, flags);
+}
+
+/* The input of channel @ch rose (@rising) or fell */
+static void mchp_evsys_edge(MchpEvsysState *s, unsigned ch, bool rising)
+{
+    unsigned edge = FIELD_EX32(mchp_evsys_channel(s, ch), MCHP_EVSYS_CHANNEL,
+                               EDGSEL);
+
+    if (mchp_evsys_async(s, ch) || !mchp_evsys_clocked(s, ch)) {
+        return;
+    }
+    if (edge == MCHP_EVSYS_EDGE_BOTH ||
+        edge == (rising ? MCHP_EVSYS_EDGE_RISING : MCHP_EVSYS_EDGE_FALLING)) {
+        mchp_evsys_event(s, ch);
+    }
+}
+
+static void mchp_evsys_set_generator(void *opaque, int gen, int level)
+{
+    MchpEvsysState *s = opaque;
+    bool old = mchp_evsys_gen_level(s, gen);
+
+    if (!gen || old == (level > 0)) {
+        return;
+    }
+    s->gen_level[gen / 64] = deposit64(s->gen_level[gen / 64], gen % 64, 1,
+                                       level > 0);
+    for (unsigned ch = 0; ch < s->nchannels; ch++) {
+        if (mchp_evsys_evgen(s, ch) == gen) {
+            mchp_evsys_edge(s, ch, level > 0);
+        }
+    }
+    mchp_evsys_update_users(s);
+}
+
+static void mchp_evsys_set_user_busy(void *opaque, int u, int level)
+{
+    MchpEvsysState *s = opaque;
+
+    s->user_busy = deposit64(s->user_busy, u, 1, level > 0);
+}
+
+static void mchp_evsys_swevt(MchpEvsysState *s, uint32_t channels)
+{
+    for (unsigned ch = 0; ch < s->nchannels; ch++) {
+        if (!(channels & BIT(ch))) {
+            continue;
+        }
+        if (mchp_evsys_async(s, ch)) {
+            uint64_t users = mchp_evsys_users(s, ch);
+
+            for (unsigned u = 0; u < s->nusers; u++) {
+                if (users & BIT_ULL(u)) {
+                    qemu_irq_pulse(s->user[u]);
+                }
+            }
+            continue;
+        }
+        mchp_evsys_edge(s, ch, true);
+        mchp_evsys_edge(s, ch, false);
+    }
+}
+
+static uint32_t mchp_evsys_chstatus(MchpEvsysState *s)
+{
+    uint32_t val = 0;
+
+    for (unsigned ch = 0; ch < s->nchannels; ch++) {
+        uint64_t users = mchp_evsys_users(s, ch);
+
+        if (mchp_evsys_async(s, ch)) {
+            continue;
+        }
+        if (!(users & s->user_busy)) {
+            val |= R_MCHP_EVSYS_CHSTATUS_USRRDY0_MASK << ch;
+        }
+        if (!users && mchp_evsys_clocked(s, ch) &&
+            ((s->pending & BIT(ch)) ||
+             (mchp_evsys_channel(s, ch) & F_CONFIG))) {
+            val |= R_MCHP_EVSYS_CHSTATUS_CHBUSY0_MASK << ch;
+        }
+    }
+    return val;
+}
+
+static uint32_t mchp_evsys_pre_read(MchpRegFile *rf, const MchpRegInfo *ri,
+                                    unsigned idx, uint32_t stored,
+                                    bool side_effects)
+{
+    MchpEvsysState *s = MCHP_EVSYS(rf->opaque);
+
+    if (ri->offset == A_MCHP_EVSYS_CHSTATUS) {
+        return mchp_evsys_chstatus(s);
+    }
+    return stored;
+}
+
+static void mchp_evsys_post_write(MchpRegFile *rf, const MchpRegInfo *ri,
+                                  unsigned idx, uint32_t old, uint32_t written,
+                                  uint32_t we)
+{
+    MchpEvsysState *s = MCHP_EVSYS(rf->opaque);
+    uint32_t val = mchp_regfile_get(rf, ri, idx);
+
+    switch (ri->offset) {
+    case A_MCHP_EVSYS_SWEVT:
+        mchp_evsys_swevt(s, written & we);
+        mchp_regfile_set(rf, ri, idx, 0);
+        break;
+    case A_MCHP_EVSYS_CHANNEL:
+        s->pending &= ~BIT(idx);
+        mchp_evsys_update_users(s);
+        break;
+    case A_MCHP_EVSYS_USER:
+        val &= MCHP_EVSYS_USER_CHANNEL_MASK;
+        mchp_regfile_set(rf, ri, idx, val);
+        if (val && val - 1 < MCHP_EVSYS_MAX_CHANNELS) {
+            s->pending &= ~BIT(val - 1);
+        }
+        mchp_evsys_update_users(s);
+        break;
+    }
+}
+
+static void mchp_evsys_reset_hold(MchpRegBlock *rb)
+{
+    MchpEvsysState *s = MCHP_EVSYS(rb);
+
+    s->pending = 0;
+    for (unsigned ch = 0; ch < MCHP_EVSYS_MAX_CHANNELS; ch++) {
+        s->last_event[ch] = INT64_MIN;
+    }
+}
+
+static void mchp_evsys_reset_exit(MchpRegBlock *rb)
+{
+    mchp_evsys_update_users(MCHP_EVSYS(rb));
+}
+
+/* Number of elements of register array @name in the instance table */
+static unsigned mchp_evsys_count(MchpRegBlock *rb, const char *name)
+{
+    for (unsigned i = 0; i < rb->info->nregs; i++) {
+        if (!strcmp(rb->info->regs[i].name, name)) {
+            return rb->info->regs[i].count;
+        }
+    }
+    return 0;
+}
+
+static bool mchp_evsys_realize(MchpRegBlock *rb, Error **errp)
+{
+    MchpEvsysState *s = MCHP_EVSYS(rb);
+
+    s->nchannels = mchp_evsys_count(rb, "CHANNEL");
+    s->nusers = mchp_evsys_count(rb, "USER");
+    if (s->nchannels > MCHP_EVSYS_MAX_CHANNELS ||
+        s->nusers > MCHP_EVSYS_MAX_USERS) {
+        error_setg(errp, "%s: %u channels, %u users: too many", rb->name,
+                   s->nchannels, s->nusers);
+        return false;
+    }
+    return true;
+}
+
+static void mchp_evsys_init(Object *obj)
+{
+    MchpEvsysState *s = MCHP_EVSYS(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    qdev_init_gpio_in_named(dev, mchp_evsys_set_generator,
+                            MCHP_EVSYS_GENERATOR, MCHP_EVSYS_MAX_GENERATORS);
+    qdev_init_gpio_in_named(dev, mchp_evsys_set_user_busy,
+                            MCHP_EVSYS_USER_BUSY, MCHP_EVSYS_MAX_USERS);
+    qdev_init_gpio_out_named(dev, s->user, MCHP_EVSYS_USER,
+                             MCHP_EVSYS_MAX_USERS);
+    for (unsigned ch = 0; ch < MCHP_EVSYS_MAX_CHANNELS; ch++) {
+        g_autofree char *name = g_strdup_printf("channel-clock[%u]", ch);
+
+        s->chclk[ch] = qdev_init_clock_in(dev, name, NULL, NULL, 0);
+    }
+}
+
+static const VMStateDescription vmstate_mchp_evsys = {
+    .name = TYPE_MCHP_EVSYS,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(parent_obj, MchpEvsysState, 1, vmstate_mchp_regblock,
+                       MchpRegBlock),
+        VMSTATE_UINT64_ARRAY(gen_level, MchpEvsysState,
+                             MCHP_EVSYS_MAX_GENERATORS / 64),
+        VMSTATE_UINT64(user_busy, MchpEvsysState),
+        VMSTATE_UINT64(user_level, MchpEvsysState),
+        VMSTATE_UINT32(pending, MchpEvsysState),
+        VMSTATE_INT64_ARRAY(last_event, MchpEvsysState,
+                            MCHP_EVSYS_MAX_CHANNELS),
+        VMSTATE_ARRAY_CLOCK(chclk, MchpEvsysState, MCHP_EVSYS_MAX_CHANNELS),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mchp_evsys_class_init(ObjectClass *klass, const void *data)
+{
+    MchpRegBlockClass *c = MCHP_REGBLOCK_CLASS(klass);
+
+    DEVICE_CLASS(klass)->vmsd = &vmstate_mchp_evsys;
+    c->realize = mchp_evsys_realize;
+    c->pre_read = mchp_evsys_pre_read;
+    c->post_write = mchp_evsys_post_write;
+    c->reset_hold = mchp_evsys_reset_hold;
+    c->reset_exit = mchp_evsys_reset_exit;
+    c->log_writes = false;
+}
+
+static const TypeInfo mchp_evsys_types[] = {
+    {
+        .name = TYPE_MCHP_EVSYS,
+        .parent = TYPE_MCHP_REGBLOCK,
+        .instance_size = sizeof(MchpEvsysState),
+        .instance_init = mchp_evsys_init,
+        .class_init = mchp_evsys_class_init,
+    },
+};
+
+DEFINE_TYPES(mchp_evsys_types)
