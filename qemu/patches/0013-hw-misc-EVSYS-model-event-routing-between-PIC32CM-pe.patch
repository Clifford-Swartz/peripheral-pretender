diff --git a/tests/qtest/pic32cm-evsys-test.c b/tests/qtest/pic32cm-evsys-test.c
new file mode 100644
index 0000000..0b026ae
--- /dev/null
+++ b/tests/qtest/pic32cm-evsys-test.c
@@ -0,0 +1,289 @@
+/*
+ * QTest for the EVSYS of the PIC32CM MC00 (pic32cm-mc00-cpro)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * Channel 0 runs on GCLK_EVSYS_CHANNEL_0 (GCLK channel 6) from GCLK0
+ * (4 MHz out of reset). The event user is TC1 counting events; TC0
+ * overflows are the generator. Expected behaviour from DS60001638E
+ * chapter 27 and PIC32CM MC00 silicon (firmware/hello/tests/evprobe.c).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+#define MACHINE         "-M pic32cm-mc00-cpro "
+
+#define GCLK_PCHCTRL    0x40001C80
+#define EVSYS           0x42000000
+#define TC0             0x42003000
+#define TC1             0x42003400
+#define PORT            0x41000000
+#define NVIC_ISPR       0xE000E200
+
+#define E_CHSTATUS      0x0C
+#define E_INTENSET      0x14
+#define E_INTFLAG       0x18
+#define E_SWEVT         0x1C
+#define E_CHANNEL(n)    (0x20 + 4 * (n))
+#define E_USER(n)       (0x80 + 4 * (n))
+
+#define SYNC            (0 << 8)
+#define RESYNC          (1 << 8)
+#define ASYNC           (2 << 8)
+#define RISING          (1 << 10)
+#define BOTH            (3 << 10)
+
+#define OVR0            BIT(0)
+#define EVD0            BIT(16)
+#define USRRDY0         BIT(0)
+#define CHBUSY0         BIT(16)
+
+#define GEN_TC0_OVF     52
+#define USER_PORT_EV0   1
+#define USER_TC1        24
+#define EVSYS_GCLK_ID0  6
+#define TC_GCLK_ID      25
+#define EVSYS_IRQ       8
+
+#define T_CTRLA         0x00
+#define T_CTRLBSET      0x05
+#define T_EVCTRL        0x06
+#define T_INTFLAG       0x0A
+#define T_COUNT         0x14
+#define T_PER           0x1B
+#define MODE_COUNT8     (1 << 2)
+#define CTRLA_ENABLE    0x02
+#define CMD_READSYNC    (4 << 5)
+#define EVACT_RETRIGGER 1
+#define EVACT_COUNT     2
+#define EVACT_START     3
+#define TCEI            BIT(5)
+#define OVFEO           BIT(8)
+
+#define P_DIRSET        0x08
+#define P_OUT           0x10
+#define P_OUTSET        0x18
+#define P_EVCTRL        0x2C
+#define LED_PIN         24
+#define EVACT_OUT       0
+#define EVACT_TGL       3
+
+#define US              1000
+
+static QTestState *ev_init(bool clock)
+{
+    QTestState *qts = qtest_init(MACHINE);
+
+    qtest_writel(qts, GCLK_PCHCTRL + 4 * TC_GCLK_ID, 0x40);
+    if (clock) {
+        qtest_writel(qts, GCLK_PCHCTRL + 4 * EVSYS_GCLK_ID0, 0x40);
+    }
+    return qts;
+}
+
+/* TC1 (COUNT16) enabled with event action @evact */
+static void tc1_setup(QTestState *qts, unsigned evact)
+{
+    qtest_writew(qts, TC1 + T_EVCTRL, evact | TCEI);
+    qtest_writel(qts, TC1 + T_CTRLA, CTRLA_ENABLE);
+}
+
+static uint32_t tc1_count(QTestState *qts)
+{
+    qtest_writeb(qts, TC1 + T_CTRLBSET, CMD_READSYNC);
+    return qtest_readw(qts, TC1 + T_COUNT);
+}
+
+static void route(QTestState *qts, uint32_t channel)
+{
+    qtest_writel(qts, EVSYS + E_CHANNEL(0), channel);
+    qtest_writel(qts, EVSYS + E_USER(USER_TC1), 1);
+}
+
+static void swevt(QTestState *qts, unsigned times)
+{
+    for (unsigned i = 0; i < times; i++) {
+        qtest_writel(qts, EVSYS + E_SWEVT, BIT(0));
+        qtest_clock_step(qts, 20 * US);
+    }
+}
+
+static uint32_t flags(QTestState *qts)
+{
+    uint32_t f = qtest_readl(qts, EVSYS + E_INTFLAG);
+
+    qtest_writel(qts, EVSYS + E_INTFLAG, f);
+    return f;
+}
+
+static void test_reset(void)
+{
+    QTestState *qts = ev_init(false);
+
+    g_assert_cmphex(qtest_readl(qts, EVSYS + E_CHANNEL(0)), ==, 0x8000);
+    g_assert_cmphex(qtest_readl(qts, EVSYS + E_CHSTATUS), ==, 0xFFF);
+    g_assert_cmphex(qtest_readl(qts, EVSYS + E_INTFLAG), ==, 0);
+    /* USER.CHANNEL keeps 4 bits, CHANNEL its documented fields */
+    qtest_writel(qts, EVSYS + E_USER(0), 0xFFFFFFFF);
+    qtest_writel(qts, EVSYS + E_CHANNEL(1), 0xFFFFFFFF);
+    g_assert_cmphex(qtest_readl(qts, EVSYS + E_USER(0)), ==, 0xF);
+    g_assert_cmphex(qtest_readl(qts, EVSYS + E_CHANNEL(1)), ==, 0xCF7F);
+    qtest_quit(qts);
+}
+
+/* Software events: EVD on the clocked paths, none asynchronously */
+static void test_software(void)
+{
+    static const uint32_t paths[] = { SYNC, RESYNC, ASYNC };
+
+    for (unsigned i = 0; i < ARRAY_SIZE(paths); i++) {
+        QTestState *qts = ev_init(true);
+
+        tc1_setup(qts, EVACT_COUNT);
+        route(qts, paths[i] | RISING);
+        swevt(qts, 5);
+        g_assert_cmpuint(tc1_count(qts), ==, 5);
+        g_assert_cmphex(flags(qts), ==, paths[i] == ASYNC ? 0 : EVD0);
+        g_assert_cmphex(qtest_readl(qts, EVSYS + E_CHSTATUS) & USRRDY0, ==,
+                        paths[i] == ASYNC ? 0 : USRRDY0);
+        qtest_quit(qts);
+    }
+}
+
+/* Without the channel clock only the asynchronous path carries events */
+static void test_noclock(void)
+{
+    QTestState *qts = ev_init(false);
+
+    tc1_setup(qts, EVACT_COUNT);
+    route(qts, SYNC | RISING);
+    swevt(qts, 3);
+    g_assert_cmpuint(tc1_count(qts), ==, 0);
+    g_assert_cmphex(flags(qts), ==, 0);
+    route(qts, ASYNC | RISING);
+    swevt(qts, 3);
+    g_assert_cmpuint(tc1_count(qts), ==, 3);
+    qtest_quit(qts);
+}
+
+/* TC0 overflows (pulses): BOTH_EDGES gives one event each and OVR */
+static void test_generator(void)
+{
+    QTestState *qts = ev_init(true);
+
+    tc1_setup(qts, EVACT_COUNT);
+    route(qts, GEN_TC0_OVF | RESYNC | BOTH);
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8);
+    qtest_writew(qts, TC0 + T_EVCTRL, OVFEO);
+    qtest_writeb(qts, TC0 + T_PER, 9);
+    qtest_writel(qts, TC0 + T_CTRLA, MODE_COUNT8 | CTRLA_ENABLE);
+    qtest_clock_step(qts, 10 * 4 * 250 + 125);      /* 4 periods of 10 */
+    g_assert_cmpuint(tc1_count(qts), ==, 4);
+    g_assert_cmphex(flags(qts), ==, EVD0 | OVR0);
+    qtest_quit(qts);
+}
+
+/* CHBUSY/OVR without users, and with a user that is not ready */
+static void test_users(void)
+{
+    QTestState *qts = ev_init(true);
+
+    qtest_writel(qts, EVSYS + E_CHANNEL(0), SYNC | RISING);
+    g_assert_cmphex(qtest_readl(qts, EVSYS + E_CHSTATUS) & 0x10001, ==,
+                    CHBUSY0 | USRRDY0);
+    swevt(qts, 1);
+    g_assert_cmphex(flags(qts), ==, EVD0 | OVR0);
+
+    qtest_writel(qts, EVSYS + E_USER(USER_TC1), 1);  /* TC1 disabled */
+    g_assert_cmphex(qtest_readl(qts, EVSYS + E_CHSTATUS) & 0x10001, ==, 0);
+    swevt(qts, 1);
+    g_assert_cmphex(flags(qts), ==, EVD0 | OVR0);
+
+    qtest_writel(qts, TC1 + T_CTRLA, CTRLA_ENABLE);   /* ready, no TCEI */
+    g_assert_cmphex(qtest_readl(qts, EVSYS + E_CHSTATUS) & USRRDY0, ==,
+                    USRRDY0);
+    swevt(qts, 1);
+    g_assert_cmphex(flags(qts), ==, EVD0);
+    qtest_quit(qts);
+}
+
+/* RETRIGGER restarts a running TC1; START starts a waiting one */
+static void test_tc_actions(void)
+{
+    QTestState *qts = ev_init(true);
+
+    route(qts, SYNC | RISING);
+    tc1_setup(qts, EVACT_START);
+    qtest_clock_step(qts, 1000 * US);
+    g_assert_cmpuint(tc1_count(qts), ==, 0);
+    swevt(qts, 1);
+    qtest_clock_step(qts, 1000 * US);
+    g_assert_cmpuint(tc1_count(qts), >=, 3000);
+    qtest_quit(qts);
+
+    qts = ev_init(true);
+    route(qts, SYNC | RISING);
+    qtest_writew(qts, TC1 + T_EVCTRL, EVACT_RETRIGGER | TCEI);
+    qtest_writel(qts, TC1 + T_CTRLA, CTRLA_ENABLE);
+    swevt(qts, 1);                                  /* starts it */
+    qtest_clock_step(qts, 1000 * US);
+    g_assert_cmpuint(tc1_count(qts), >=, 3000);
+    swevt(qts, 1);
+    g_assert_cmpuint(tc1_count(qts), <, 200);
+    qtest_quit(qts);
+}
+
+/* PORT EV_0 on PA24: TGL toggles; OUT with a pulse leaves OUT alone */
+static void test_port(void)
+{
+    QTestState *qts = ev_init(true);
+
+    qtest_writel(qts, PORT + P_DIRSET, BIT(LED_PIN));
+    qtest_writel(qts, PORT + P_OUTSET, BIT(LED_PIN));
+    qtest_writel(qts, EVSYS + E_CHANNEL(0), SYNC | RISING);
+    qtest_writel(qts, EVSYS + E_USER(USER_PORT_EV0), 1);
+    qtest_writel(qts, PORT + P_EVCTRL, LED_PIN | EVACT_TGL << 5 | BIT(7));
+    swevt(qts, 1);
+    g_assert_cmphex(qtest_readl(qts, PORT + P_OUT) & BIT(LED_PIN), ==, 0);
+    swevt(qts, 1);
+    g_assert_cmphex(qtest_readl(qts, PORT + P_OUT) & BIT(LED_PIN), ==,
+                    BIT(LED_PIN));
+    qtest_writel(qts, PORT + P_EVCTRL, LED_PIN | EVACT_OUT << 5 | BIT(7));
+    swevt(qts, 1);
+    g_assert_cmphex(qtest_readl(qts, PORT + P_OUT) & BIT(LED_PIN), ==,
+                    BIT(LED_PIN));
+    qtest_quit(qts);
+}
+
+static void test_irq(void)
+{
+    QTestState *qts = ev_init(true);
+
+    qtest_writel(qts, EVSYS + E_CHANNEL(0), SYNC | RISING);
+    qtest_writel(qts, EVSYS + E_INTENSET, EVD0);
+    g_assert_false(qtest_readl(qts, NVIC_ISPR) & BIT(EVSYS_IRQ));
+    swevt(qts, 1);
+    g_assert_true(qtest_readl(qts, NVIC_ISPR) & BIT(EVSYS_IRQ));
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("pic32cm-evsys/reset", test_reset);
+    qtest_add_func("pic32cm-evsys/software", test_software);
+    qtest_add_func("pic32cm-evsys/noclock", test_noclock);
+    qtest_add_func("pic32cm-evsys/generator", test_generator);
+    qtest_add_func("pic32cm-evsys/users", test_users);
+    qtest_add_func("pic32cm-evsys/tc-actions", test_tc_actions);
+    qtest_add_func("pic32cm-evsys/port", test_port);
+    qtest_add_func("pic32cm-evsys/irq", test_irq);
+
+    return g_test_run();
+}
-- 
