@@ -0,0 +1,37 @@
+/*
+ * Microchip SAM/PIC32CM Event System (EVSYS U2256)
+ *
+ * Peripheral Pretender: a personal project. AI-assisted code;
+ * not for submission to upstream QEMU.
+ *
+ * A TYPE_MCHP_REGBLOCK subclass configured with mchp_regblock_set_info().
+ * GPIO lines:
+ *   "generator"[128]   in: level of event generator n (CHANNEL.EVGEN n);
+ *                      generators that pulse raise and lower it at once
+ *   "user"[64]         out: event to user n (USER n): a pulse per event of
+ *                      a synchronous or resynchronized channel, the
+ *                      generator level through an asynchronous one
+ *   "user-busy"[64]    in: 1 while user n cannot take events (USRRDY)
+ * Clock inputs "channel-clock[n]": GCLK_EVSYS_CHANNEL_n; channels without
+ * one carry events only on the asynchronous path.
+ * sysbus IRQ 0 is the EVSYS interrupt (INTFLAG & INTENSET).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_MCHP_EVSYS_H
+#define HW_MISC_MCHP_EVSYS_H
+
+#include "hw/misc/mchp_regblock.h"
+
+#define TYPE_MCHP_EVSYS "mchp-evsys"
+
+#define MCHP_EVSYS_GENERATOR "generator"
+#define MCHP_EVSYS_USER "user"
+#define MCHP_EVSYS_USER_BUSY "user-busy"
+
+#define MCHP_EVSYS_MAX_CHANNELS 12
+#define MCHP_EVSYS_MAX_GENERATORS 128
+#define MCHP_EVSYS_MAX_USERS 64
+
+#endif /* HW_MISC_MCHP_EVSYS_H */
