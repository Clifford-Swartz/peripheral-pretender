-        .wmask = 0x000000FF, .flags = MCHP_F_PAC,
+        .wmask = 0x000000FF, .flags = MCHP_F_PAC | MCHP_F_HOOK_POST_WRITE,
     },
 };
 #define PIC32CM5164JH01100_EVSYS_NREGS 8
