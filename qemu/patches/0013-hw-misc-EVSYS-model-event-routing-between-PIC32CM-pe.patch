+/* Whether @dev has named GPIO line @n of @name, as an input or an output */
+static bool pic32cm_has_gpio(DeviceState *dev, const char *name, bool in,
+                             int n)
+{
+    NamedGPIOList *list;
+
+    QLIST_FOREACH(list, &dev->gpios, node) {
+        if (!g_strcmp0(list->name, name)) {
+            return n < (in ? list->num_in : list->num_out);
+        }
+    }
+    return false;
+}
+
+/*
+ * EVSYS generators and users (MchpDeviceInfo.events) to the models that
+ * have them: event SIG[n] of an instance is its GPIO output "sig-event"[n]
+ * (generators) or input "sig-event-in"[n] (users), lower case; a user that
+ * can be unready also has the output "sig-event-busy"[n]. Events of
+ * instances without a model, or of models without the line, stay open.
+ */
+static void pic32cm_connect_events(Pic32cmSocState *s)
+{
+    DeviceState *evsys = pic32cm_soc_periph(s, "EVSYS");
+
+    if (!evsys || !object_dynamic_cast(OBJECT(evsys), TYPE_MCHP_EVSYS)) {
+        return;
+    }
+    for (unsigned i = 0; i < s->dev->nevents; i++) {
+        const MchpEventInfo *ev = &s->dev->events[i];
+        DeviceState *dev = pic32cm_soc_periph(s, ev->instance);
+        g_autofree char *sig = g_ascii_strdown(ev->signal, -1);
+        g_autofree char *name = NULL;
+        int n = MAX(ev->index, 0);
+
+        if (!dev) {
+            continue;
+        }
+        if (!ev->user) {
+            name = g_strdup_printf("%s-event", sig);
+            if (pic32cm_has_gpio(dev, name, false, n) &&
+                ev->id < MCHP_EVSYS_MAX_GENERATORS) {
+                qdev_connect_gpio_out_named(dev, name, n,
+                    qdev_get_gpio_in_named(evsys, MCHP_EVSYS_GENERATOR,
+                                           ev->id));
+            }
+            continue;
+        }
+        if (ev->id >= MCHP_EVSYS_MAX_USERS) {
+            continue;
+        }
+        name = g_strdup_printf("%s-event-in", sig);
+        if (pic32cm_has_gpio(dev, name, true, n)) {
+            qdev_connect_gpio_out_named(evsys, MCHP_EVSYS_USER, ev->id,
+                                        qdev_get_gpio_in_named(dev, name, n));
+        }
+        g_free(name);
+        name = g_strdup_printf("%s-event-busy", sig);
+        if (pic32cm_has_gpio(dev, name, false, n)) {
+            qdev_connect_gpio_out_named(dev, name, n,
+                qdev_get_gpio_in_named(evsys, MCHP_EVSYS_USER_BUSY, ev->id));
+        }
+    }
+}
