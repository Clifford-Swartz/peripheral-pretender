+/* "ev-event-in": event input @n acts on the pin each group's EVCTRL names */
+static void mchp_port_set_event(void *opaque, int n, int level)
+{
+    MchpPortState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    bool rising = level > 0;
+
+    if (extract32(s->ev_level, n, 1) == rising) {
+        return;
+    }
+    s->ev_level = deposit32(s->ev_level, n, 1, rising);
+    for (unsigned g = 0; g < s->ngroups; g++) {
+        uint32_t ev = extract32(mchp_port_reg(s, g, A_MCHP_PORT_GROUP_EVCTRL),
+                                8 * n, 8);
+        uint32_t out = mchp_port_reg(s, g, A_MCHP_PORT_GROUP_OUT);
+        unsigned pin = FIELD_EX32(ev, MCHP_PORT_GROUP_EVCTRL, PID0);
+        bool bit = extract32(out, pin, 1);
+
+        if (!FIELD_EX32(ev, MCHP_PORT_GROUP_EVCTRL, PORTEI0)) {
+            continue;
+        }
+        switch (FIELD_EX32(ev, MCHP_PORT_GROUP_EVCTRL, EVACT0)) {
+        case MCHP_PORT_GROUP_EVCTRL_EVACT0_OUT:
+            if (rising) {
+                s->ev_saved[n] = deposit32(s->ev_saved[n], g, 1, bit);
+                bit = true;
+            } else {
+                /* A pulse leaves OUT unchanged (silicon) */
+                bit = s->ev_rise[n] == now && extract32(s->ev_saved[n], g, 1);
+            }
+            break;
+        case MCHP_PORT_GROUP_EVCTRL_EVACT0_SET:
+            bit |= rising;
+            break;
+        case MCHP_PORT_GROUP_EVCTRL_EVACT0_CLR:
+            bit &= !rising;
+            break;
+        case MCHP_PORT_GROUP_EVCTRL_EVACT0_TGL:
+            bit ^= rising;
+            break;
+        }
+        mchp_regfile_poke(mchp_port_rf(s),
+                          mchp_port_offset(g, A_MCHP_PORT_GROUP_OUT), 4,
+                          deposit32(out, pin, 1, bit));
+        mchp_port_update(s, g);
+    }
+    if (rising) {
+        s->ev_rise[n] = now;
+    }
+}
+
