{
  "name": "peripheral-pretender",
  "displayName": "Peripheral Pretender",
  "description": "Run firmware on a digital twin of Microchip boards: the board, its LEDs, buttons, console, Click boards and a parts bench, live in VS Code.",
  "version": "0.2.1",
  "publisher": "cliffordswartz",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Other"
  ],
  "keywords": [
    "microchip",
    "qemu",
    "simulator",
    "embedded",
    "digital twin"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebugDynamicConfigurations:twin",
    "onDebugInitialConfigurations",
    "onDebugResolve:twin",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "peripheralPretender.open",
        "title": "Open Board",
        "category": "Twin"
      },
      {
        "command": "peripheralPretender.switchBoard",
        "title": "Switch Board",
        "category": "Twin",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "peripheralPretender.runElf",
        "title": "Run on Twin",
        "category": "Twin",
        "icon": "$(file-binary)"
      },
      {
        "command": "peripheralPretender.stop",
        "title": "Stop",
        "category": "Twin",
        "icon": "$(debug-stop)"
      },
      {
        "command": "peripheralPretender.showLog",
        "title": "Show Engine Log",
        "category": "Twin",
        "icon": "$(output)"
      },
      {
        "command": "peripheralPretender.debug",
        "title": "Debug on the Twin",
        "category": "Twin",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "peripheralPretender.runElf",
          "when": "resourceExtname == .elf",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "peripheralPretender.debug",
          "when": "view == peripheralPretender.boards",
          "group": "navigation@1"
        },
        {
          "command": "peripheralPretender.runElf",
          "when": "view == peripheralPretender.boards",
          "group": "navigation@2"
        },
        {
          "command": "peripheralPretender.stop",
          "when": "view == peripheralPretender.boards",
          "group": "navigation@3"
        },
        {
          "command": "peripheralPretender.showLog",
          "when": "view == peripheralPretender.boards",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Peripheral Pretender",
      "properties": {
        "peripheralPretender.board": {
          "type": "string",
          "default": "",
          "description": "Board to open (board id, e.g. ev15n46a). Empty: ask."
        },
        "peripheralPretender.watch": {
          "type": "boolean",
          "default": true,
          "description": "Run each new build of the workspace (out/**/*.elf from MPLAB for VS Code, dist/**/*.elf from MPLAB X) on the twin."
        },
        "peripheralPretender.engineRoot": {
          "type": "string",
          "default": "",
          "description": "Development: a Peripheral Pretender checkout to run instead of the bundled engine."
        },
        "peripheralPretender.python": {
          "type": "string",
          "default": "",
          "description": "Development: the Python to run engineRoot with (default: py on Windows, python3 elsewhere)."
        },
        "peripheralPretender.gdbPath": {
          "type": "string",
          "default": "",
          "description": "The gdb to debug with (default: the bundled gdb-multiarch)."
        }
      }
    },
    "debuggers": [
      {
        "type": "twin",
        "label": "Peripheral Pretender Twin",
        "languages": [
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "The firmware ELF to debug. Default: the workspace's newest out/**/*.elf or dist/**/*.elf."
              },
              "board": {
                "type": "string",
                "description": "Board id (ev15n46a, ev81x90a, ev66e56a, pykit). Default: the board showing, if the ELF fits it, else ask."
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": true,
                "description": "Stop at main."
              },
              "gdbPath": {
                "type": "string",
                "description": "A gdb for the ELF's architecture. Default: the bundled gdb-multiarch."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "twin",
            "request": "launch",
            "name": "Debug on the twin",
            "program": "${workspaceFolder}/out/${workspaceFolderBasename}/default.elf"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Peripheral Pretender: Debug on the twin",
            "description": "Run the firmware on the board's twin under the debugger",
            "body": {
              "type": "twin",
              "request": "launch",
              "name": "Debug on the twin",
              "program": "^\"\\${workspaceFolder}/out/\\${workspaceFolderBasename}/default.elf\""
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "peripheralPretender",
          "title": "Peripheral Pretender",
          "icon": "media/twin.svg"
        }
      ]
    },
    "views": {
      "peripheralPretender": [
        {
          "id": "peripheralPretender.boards",
          "name": "Boards",
          "icon": "media/twin.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package --target win32-x64 --skip-license",
    "test": "node test/run.js"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.6.3"
  }
}
